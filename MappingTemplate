#!/usr/bin/env python3
import os, base64

DIRS = ['.claude', '.claude/skills', '.claude/skills/bpmn-generator-dbs', '.claude/skills/gap-analysis-dbs', '.claude/skills/interview-prep-dbs', '.claude/skills/process-doc-generator-dbs', '.claude/skills/process-summariser-dbs', 'examples', 'examples/capital-reporting', 'examples/capital-reporting/transcripts']

FILES = {
    '.claude/skills/bpmn-generator-dbs/SKILL.md': '',
    '.claude/skills/gap-analysis-dbs/README.md': '',
    '.claude/skills/gap-analysis-dbs/SKILL.md': '',
    '.claude/skills/interview-prep-dbs/SKILL.md': '',
    '.claude/skills/process-doc-generator-dbs/SKILL.md': '',
    '.claude/skills/process-summariser-dbs/SKILL.md': '',
    'CLAUDE.md': '',
    'PLAYBOOK.md': '',
    'examples/capital-reporting/2026-03-31_capital-reporting_gaps.md': '',
    'examples/capital-reporting/2026-03-31_capital-reporting_summary.md': '',
    'examples/capital-reporting/capital-reporting-bd0.bpmn': '',
    'examples/capital-reporting/capital-reporting-dq.bpmn': '',
    'examples/capital-reporting/capital-reporting-old.bpmn': '',
    'examples/capital-reporting/transcripts/2026-03-31-capital_reporting-transcript.md': '',
    'process-mapping-workflow.bpmn': '',
}

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
