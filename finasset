<body>
<main>
  <div class="topbar">
    <div class="eyebrow">B1.4 Basic financial assets <a class="xlink" href="liabilities-borrowing.html">the mirror: financial liabilities →</a></div>
    <div class="mode" id="mode" role="group" aria-label="Example">Example
      <button data-m="bond">a bond (debt): ,327, 6%</button><button data-m="shares">shares (equity): Acorn, practice Q31–34</button></div>
  </div>
  <div class="fl-box" id="chart"></div>
  <div class="note" id="note" aria-live="polite"></div>
</main>
<script>
// Worked examples behind every number (the study app's numbers, apps/study/content/financial-assets.js):
// - the bond: 3 years, face $100,000, 5% coupon paid yearly, market (effective) rate 6%, so it costs $97,327; fair value $99,000 at the end of year 1;
//   "on sale": sold at the start of year 2 for $99,000.
// - the shares: the official practice paper's Acorn case (Q31–34). 250,000 Oak shares at $1.25 + $2,350 brokerage; dividend $5,500;
//   $1.35 at the year end; 100,000 sold at $1.20 three months later; dividend $3,150; $1.05 at the next year end.
// The switch picks the example. Tracks the example cannot use are dimmed (shares fail SPPI; a bond cannot be elected into FVOCI equity).
const f1 = (n) => `${n < -0.5 ? '−' : ''}$${Math.abs(Math.round(n)).toLocaleString('en-US')}`;
const n0 = (n) => `${n < -0.5 ? '−' : ''}${Math.abs(Math.round(n)).toLocaleString('en-US')}`;
const nb = (s) => s.replace(/ /g, ' ');
const BOND = (() => {
  const face = 100000, c = 0.05, r = 0.06, n = 3, fv1 = 99000, sale = 99000, r0 = Math.round;
  const cost = r0([1, 2, 3].reduce((a, t) => a + face * c / (1 + r) ** t, 0) + face / (1 + r) ** n);
  const rows = [];
  let b = cost;
  for (let t = 1; t <= n; t++) { const i = t === n ? face + face * c - b : r0(b * r); rows.push({ t, open: b, i, coupon: face * c, close: b + i - face * c }); b += i - face * c; }
  const ac1 = rows[0].close, i1 = rows[0].i, coupon = face * c;
  const B = { face, c, r, n, fv1, sale, cost, rows, ac1, i1, coupon, oci1: fv1 - ac1, fvGain: fv1 - cost, gainAC: sale - ac1 };
  B.tpl1 = coupon + B.fvGain;
  if (cost !== 97327 || i1 !== 5840 || ac1 !== 98167 || B.oci1 !== 833 || B.tpl1 !== 6673) throw new Error('bond numbers changed');
  if (i1 + B.gainAC !== B.tpl1) throw new Error('bond: lifetime profit should match across categories');
  return B;
})();
const SH = (() => {
  const A = { qty: 250000, p0: 1.25, broker: 2350, div1: 5500, p1: 1.35, sold: 100000, pSale: 1.2, div2: 3150, p2: 1.05 }, r0 = Math.round;
  A.cost = r0(A.qty * A.p0); A.paid = A.cost + A.broker; A.fv1 = r0(A.qty * A.p1);
  A.gain1 = A.fv1 - A.cost; A.oci1 = A.fv1 - A.paid;
  A.saleCA = r0(A.sold * A.p1); A.proceeds = r0(A.sold * A.pSale); A.saleLoss = A.saleCA - A.proceeds;
  A.left = A.qty - A.sold; A.loss2 = r0(A.left * (A.p1 - A.p2)); A.ca2 = r0(A.left * A.p2);
  A.tpl1 = A.div1 + A.gain1 - A.broker; // FVTPL profit, year 1
  A.soldCost = r0(A.paid * A.sold / A.qty); A.toRE = A.proceeds - A.soldCost; // FVOCI equity: cumulative OCI on the shares sold, may move to retained earnings
  if (A.paid !== 314850 || A.gain1 !== 25000 || A.saleLoss !== 15000 || A.loss2 !== 45000) throw new Error('Acorn numbers changed');
  return A;
})();

// Lanes, top to bottom. `ok` = which example can use the lane.
const LANES = [
  { k: 'L1', t: 'Amortised cost', sub: ['debt only'], ok: ['bond'] },
  { k: 'L2', t: 'FVOCI (debt)', sub: ['OCI, recycled'], ok: ['bond'] },
  { k: 'L3', t: 'FVTPL', sub: ['all through P&L'], ok: ['bond', 'shares'] },
  { k: 'L4', t: 'FVOCI (equity)', sub: ['OCI, never recycled'], ok: ['shares'] },
];
const LY = [30, 152, 274, 396], LH = 112; // lane tops and box height
const NA = { bond: 'n/a for the bond: switch to shares', shares: 'n/a: shares fail the SPPI test' };

// Section 1, drawn at LEFT.scale. Exits sit on the four lanes (lane centres in these units: 53, 195, 337, 479).
const LEFT = {
  at: [6, 40], scale: 0.86,
  nodes: [
    { id: 'debt', x: 8, y: 8, w: 170, h: 38, k: 'q', t: 'A debt instrument', sub: ['a bond, a loan, a receivable'] },
    { id: 'sppi', x: 8, y: 76, w: 170, h: 44, k: 'q', t: 'SPPI test', sub: ['cash flows only principal + interest?'] },
