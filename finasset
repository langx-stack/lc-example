  s1: (S) => ({ h: 'On sale: amortised cost', what: 'Derecognise the asset at its amortised cost; the difference from the proceeds is a gain or loss in P&L.',
    ex: S.ex === 'bond' ? ['The bond is sold at the start of year 2 for $99,000:', { calc: [{ t: 'proceeds', v: BOND.sale, link: '0.0' }, { op: '−', t: 'amortised cost', v: BOND.ac1, link: '0.1' }, { op: '=', t: '{i|gain on sale}', v: BOND.gainAC, link: '0.2' }] }, `Profit over the bond’s life: interest ${f1(BOND.i1)} + gain ${f1(BOND.gainAC)} = ${f1(BOND.i1 + BOND.gainAC)}, the same in all three debt tracks.`] : ['Shares only reach FVTPL or FVOCI (equity). Switch to the bond.'],
    je: ['… start of year 2', `Dr {a|Cash} :: ${f1(BOND.sale)}`, `Cr {a|Investment in bonds} :: ${f1(BOND.ac1)}`, `Cr {i|Gain on sale} :: ${f1(BOND.gainAC)}`] }),
  s2: (S) => ({ h: 'On sale: FVOCI (debt) recycles', what: 'Derecognise the asset at its fair value. The fair value reserve built up in OCI is **reclassified (recycled)** to P&L. So the total profit is exactly the same as under amortised cost.',
    ex: S.ex === 'bond' ? [{ calc: [{ t: 'proceeds', v: BOND.sale, link: '0.0' }, { op: '−', t: 'carrying amount (fair value)', v: BOND.fv1, link: '0.1' }, { op: '=', t: 'difference at sale', v: 0 }] }, { calc: [{ t: '{e|reserve} recycled to P&L', v: BOND.oci1, link: 1 }] }, 'P&L: interest $5,840 + recycled $833 = $6,673, as amortised cost.'] : ['Switch to the bond.'],
    traps: ['Leaving the reserve in equity: for **debt** at FVOCI it is recycled.'],
    je: ['… start of year 2: the sale', `Dr {a|Cash} :: ${f1(BOND.sale)}`, `Cr {a|Investment in bonds} :: ${f1(BOND.fv1)}`, '… recycle the reserve', `Dr {e|OCI: fair value reserve} :: ${f1(BOND.oci1)}`, `Cr {i|Gain on sale (P&L)} :: ${f1(BOND.oci1)}`] }),
  s3: (S) => (S.ex === 'bond'
    ? { h: 'On sale: FVTPL (the bond)', what: 'The carrying amount is the last fair value, so only the change since the last year end is a gain or loss. Here the bond is sold at its year-end fair value: nothing more to recognise.',
      ex: [{ calc: [{ t: 'proceeds', v: BOND.sale }, { op: '−', t: 'last fair value', v: BOND.fv1 }, { op: '=', t: 'gain at sale', v: 0 }] }, 'Profit over its life: $6,673 in year 1, the same total as the other tracks.'],
      je: ['… start of year 2', `Dr {a|Cash} :: ${f1(BOND.sale)}`, `Cr {a|Investment in bonds} :: ${f1(BOND.fv1)}`] }
    : { h: 'On sale: FVTPL (Acorn, practice Q33)', what: 'Derecognise the shares sold at their carrying amount, which is the **last fair value** ($1.35), not their cost. The difference from the proceeds goes to P&L.',
      ex: [{ calc: [{ t: 'proceeds: 100,000 × $1.20', v: SH.proceeds, link: '0.0' }, { op: '−', t: 'carrying amount: 100,000 × $1.35', v: SH.saleCA, link: '0.2' }, { op: '=', t: '{x|fair value loss} (P&L)', v: -SH.saleLoss, link: '0.1' }] }],
      traps: ['Using the original cost ($1.25) as the carrying amount: that gives the wrong $5,000 loss option.'],
      je: ['… 30 June 20X5', `Dr {a|Cash} :: ${f1(SH.proceeds)}`, `Dr {x|Fair value loss (P&L)} :: ${f1(SH.saleLoss)}`, `Cr {a|Investment in Oak} :: ${f1(SH.saleCA)}`] }),
  s4: (S) => ({ h: 'On sale: FVOCI (equity) never recycles', what: 'Remeasure to the sale price (the change goes to OCI), then derecognise. The cumulative gain or loss stays in equity: it is **never** recycled to P&L. The entity may transfer it within equity, from the fair value reserve to retained earnings.',
    ex: S.ex === 'shares' ? ['If Acorn had elected FVOCI, the sale on 30 June 20X5:', { calc: [{ t: 'proceeds: 100,000 × $1.20', v: SH.proceeds, link: '0.0' }, { op: '−', t: 'carrying amount: 100,000 × $1.35', v: SH.saleCA, link: '0.2' }, { op: '=', t: '{e|loss in OCI}', v: -SH.saleLoss, link: '0.1' }] },
      { calc: [{ t: 'proceeds', v: SH.proceeds }, { op: '−', t: 'cost incl. brokerage: $314,850 × 100/250', v: SH.soldCost }, { op: '=', t: 'cumulative loss that may move to retained earnings', v: SH.toRE, link: 1 }] }] : ['Shares only. Switch to shares.'],
    traps: ['Recycling equity FVOCI gains to P&L: only **debt** FVOCI is recycled.'],
    je: ['… 30 June 20X5', `Dr {a|Cash} :: ${f1(SH.proceeds)}`, `Dr {e|OCI: fair value reserve} :: ${f1(SH.saleLoss)}`, `Cr {a|Investment in Oak} :: ${f1(SH.saleCA)}`, '… optional transfer within equity', `Dr {e|Retained earnings} :: ${f1(-SH.toRE)}`, `Cr {e|Fair value reserve} :: ${f1(-SH.toRE)}`] }),
};
const cmpNote = (i) => (S) => {
  const y = year1(S.ex)[i], L = LANES[i];
  if (!y) return { h: `Year 1: ${L.t}`, what: NA[S.ex] + '.' };
  return { h: `Year 1 compared: ${L.t}`, what: S.ex === 'bond'
    ? 'Same bond, three tracks. Amortised cost and FVOCI give the **same profit**; FVOCI and FVTPL give the **same carrying amount** and the same total comprehensive income. Only the split between P&L and OCI differs.'
    : 'Same shares, two tracks. Both carry the shares at fair value; FVTPL puts the brokerage and the fair value gain in P&L, FVOCI puts the gain in OCI. Dividends go to P&L in both.',
    ex: [{ calc: [{ t: 'profit or loss', v: y.pl }, { op: '+', t: 'other comprehensive income', v: y.oci }, { op: '=', t: 'total comprehensive income', v: y.pl + y.oci }] }, { calc: [{ t: 'carrying amount, year end', v: y.ca }] }] };
};
[0, 1, 2, 3].forEach((i) => { NOTES[`p${i + 1}`] = cmpNote(i); });
const ALL = { h: 'Tap any box', what: 'Each box opens here with what it is, why, a worked example and the journal entries. Switch the example between the bond and the Acorn shares above the chart.' };

(function () {
  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  // {a|ROU asset} → coloured term, **bold**
  const md = (t) => esc(t).replace(/\{([a-z])\|([^}]+)\}/g, '<span class="el el-$1">$2</span>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\bExample\b/g, '<em>Example</em>'); // the word Example is always italic
  const tsp = (s) => esc(s).replace(/\{([a-z])\|([^}]+)\}/g, '<tspan class="el-$1">$2</tspan>').replace(/\*\*([^*]+)\*\*/g, '<tspan font-weight="700">$1</tspan>');

  // Text is measured with the real fonts, so lines wrap to their box and entries can be centred.
  const ctx = document.createElement('canvas').getContext('2d');
  const FONTS = { 'fl-t': '650 10px Inter', 'fl-s': '400 8.2px Inter', 'fl-je': '500 7.8px "IBM Plex Mono"' };
  const plain = (s) => s.replace(/\{[a-z]\|([^}]+)\}/g, '$1').replace(/\*\*/g, '');
  const width = (s, c) => { ctx.font = FONTS[c]; return ctx.measureText(plain(s)).width; };
  const wrap = (s, c, max) => {
    const words = s.match(/\{[a-z]\|[^}]+\}\S*|\S+/g) || [];
    const out = [];
    let cur = '';
    words.forEach((w) => { const t = cur ? `${cur} ${w}` : w; if (cur && width(t, c) > max) { out.push(cur); cur = w; } else cur = t; });
    if (cur) out.push(cur);
    return out;
  };
  const node = (n) => {
    const cx = n.x + n.w / 2, max = n.w - 14;
    let o = `<g class="fl-n fl-${n.k}${n.dash ? ' fl-dash' : ''}" data-id="${n.id}" tabindex="0" role="button"><rect x="${n.x}" y="${n.y}" width="${n.w}" height="${n.h}" rx="8"/>`;
    if (n.list) { // left-aligned bullets, centred as a block
      const items = n.sub.map((s) => wrap(s, 'fl-s', max - 22));
      const rows = items.reduce((a, l) => a + l.length, 0);
      let y = n.top ? n.y + 16 : n.y + n.h / 2 - (14 + rows * 11.5) / 2 + 9;
      o += `<text class="fl-t" x="${cx}" y="${y}" text-anchor="middle">${tsp(n.t)}</text>`;
      y += 5;
      items.forEach((lines) => lines.forEach((l, i) => { y += 11.5; o += `${i ? '' : `<text class="fl-s" x="${n.x + 12}" y="${y}">•</text>`}<text class="fl-s fl-li" x="${n.x + 21}" y="${y}">${tsp(l)}</text>`; }));
      if (n.chartAt) o += `<line class="fl-hr" x1="${n.x + 10}" x2="${n.x + n.w - 10}" y1="${n.y + n.chartAt}" y2="${n.y + n.chartAt}"/>`;
      return o + '</g>';
    }
    const subs = (n.sub || []).flatMap((s) => wrap(s, 'fl-s', max));
    if (n.h > 60) { // big box: top-aligned title and subs, then the entry centred in the space under the rule
      let y = n.je || n.k === 'chart' || n.chart ? n.y + 16 : n.y + n.h / 2 - (12 + subs.length * 11) / 2 + 9; // no entry: centre the text
      o += `<text class="fl-t" x="${cx}" y="${y}" text-anchor="middle">${tsp(n.t)}</text>`;
      if (n.bullets) n.sub.forEach((s) => wrap(s, 'fl-s', max - 22).forEach((l, i) => { y += 11; o += `${i ? '' : `<text class="fl-s" x="${n.x + 12}" y="${y}">•</text>`}<text class="fl-s fl-li" x="${n.x + 21}" y="${y}">${tsp(l)}</text>`; }));
      else subs.forEach((s) => { y += 11; o += `<text class="fl-s" x="${cx}" y="${y}" text-anchor="middle">${tsp(s)}</text>`; });
      if (n.je) {
        y += 9; o += `<line class="fl-hr" x1="${n.x + 10}" x2="${n.x + n.w - 10}" y1="${y}" y2="${y}"/>`;
        const ind = (l) => (l.startsWith('Cr') ? 13 : 0);
        const lw = Math.max(...n.je.filter(Boolean).map((l) => ind(l) + width(l, 'fl-je')));
        // tags: several entries in one box get a number on the left and a label on the right
        const numW = n.tags ? 13 : 0, tagW = n.tags ? 8 + Math.max(...n.tags.map((t) => width(t, 'fl-s'))) : 0;
        const bw = numW + lw + tagW;
        const bh = n.je.reduce((a, l) => a + (l ? 10.5 : 4), 0);
        const x0 = cx - bw / 2;
        const after = (n.after || []).flatMap((s) => wrap(s, 'fl-s', max));
        const bottom = n.y + n.h - (after.length ? after.length * 11 + 10 : 0);
        if (after.length) o += `<line class="fl-hr" x1="${n.x + 10}" x2="${n.x + n.w - 10}" y1="${bottom}" y2="${bottom}"/>`; // closing lines get their own rule
        after.forEach((s, i) => { o += `<text class="fl-s" x="${cx}" y="${bottom + (i + 1) * 11 + 1}" text-anchor="middle">${tsp(s)}</text>`; });
        let ly = y + (bottom - y - bh) / 2 + 8; // baseline of the first line
        let gi = 0, first = true;
        n.je.forEach((l) => {
          if (!l) { ly += 4; first = true; return; }
          if (n.tags && first) {
            o += `<circle class="fl-num" cx="${x0 + 4.5}" cy="${ly - 2.8}" r="4.6"/><text class="fl-numt" x="${x0 + 4.5}" y="${ly - 0.4}" text-anchor="middle">${gi + 1}</text>
              <text class="fl-tag" x="${x0 + numW + lw + 8}" y="${ly}">${esc(n.tags[gi])}</text>`;
            gi++;
          }
          first = false;
          o += `<text class="fl-je" x="${x0 + numW + ind(l)}" y="${ly}">${tsp(l)}</text>`; ly += 10.5;
        });
      }
    } else {
      const lines = [...wrap(n.t, 'fl-t', max).map((t) => ({ t, c: 'fl-t', h: 12 })), ...subs.map((t) => ({ t, c: 'fl-s', h: 10.5 }))];
      let y = n.y + n.h / 2 - lines.reduce((a, l) => a + l.h, 0) / 2 + 8.5;
      lines.forEach((l) => { o += `<text class="${l.c}" x="${cx}" y="${y}" text-anchor="middle">${tsp(l.t)}</text>`; y += l.h; });
    }
    return o + '</g>';
  };
  const edge = (e) => `<g class="fl-e ${e.cls || ''}"><path d="${e.d}" marker-end="url(#fa)"/>${e.lab ? `<text x="${e.lx}" y="${e.ly}" text-anchor="${e.anchor || 'start'}">${esc(e.lab)}</text>` : ''}</g>`;
  const join = (j) => `<g class="fl-j"><circle cx="${j.cx}" cy="${j.cy}" r="11"/><text x="${j.cx}" y="${j.cy + 3.5}" text-anchor="middle">${esc(j.t)}</text></g>`;
  const draw = (part) => `${part.edges.map(edge).join('')}${(part.joins || []).map(join).join('')}${part.nodes.map(node).join('')}`;
  let ex = 'bond';
  let S = { ex }, RIGHT = right(S);
  const box = (id) => RIGHT.nodes.find((n) => n.id === id);
  // Year 1 compared: in each lane, a P&L bar and an OCI bar (one scale for all lanes) and the carrying amount.
  const cmpCharts = () => {
    const Y = year1(S.ex), mx = Math.max(...Y.filter(Boolean).flatMap((y) => [y.pl, y.oci])) || 1;
    return Y.map((y, i) => {
      const b = box(`p${i + 1}`), x0 = b.x + 70, wmax = b.w - 128;
      if (!y) return `<text class="mc-lbl m" x="${b.x + b.w / 2}" y="${b.y + 62}" text-anchor="middle">${esc(NA[S.ex])}</text>`;
      const row = (yy, label, v, cls, lcls) => `<text class="mc-lbl m" x="${b.x + 12}" y="${yy + 7}">${label}</text>
        ${v ? `<rect class="${cls}" x="${x0}" y="${yy}" width="${Math.max(2, (v / mx) * wmax)}" height="9" rx="1.5"/>` : `<line class="mc-ax" x1="${x0}" x2="${x0}" y1="${yy - 1}" y2="${yy + 10}"/>`}
        <text class="mc-lbl ${lcls}" x="${x0 + Math.max(2, (v / mx) * wmax) + 5}" y="${yy + 7.5}">${n0(v)}</text>`;
      return row(b.y + 34, 'profit or loss', y.pl, 'mc-pl', 'i') + row(b.y + 52, 'OCI', y.oci, 'mc-oci', 'e')
        + `<line class="fl-hr" x1="${b.x + 10}" x2="${b.x + b.w - 10}" y1="${b.y + 72}" y2="${b.y + 72}"/>
        <text class="mc-lbl m" x="${b.x + 12}" y="${b.y + 88}">carrying amount</text><text class="mc-lbl a" x="${x0}" y="${b.y + 88}">${n0(y.ca)}</text>
        <text class="mc-lbl m" x="${b.x + 12}" y="${b.y + 102}">total comprehensive income</text><text class="mc-lbl x" x="${b.x + b.w - 12}" y="${b.y + 102}" text-anchor="end">${n0(y.pl + y.oci)}</text>`;
    }).join('');
  };
  const sec = (s) => `<g class="sec ${s.cls}"><rect x="${s.x}" y="0" width="${s.w}" height="${H}" rx="10"/><text x="${s.x + 12}" y="19">${esc(s.t)}</text></g>`;
  let cur = '';
  const render = () => { S = { ex }; RIGHT = right(S); document.getElementById('chart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" style="width:${Math.round(W * 1.34)}px" role="img" aria-label="Financial assets: classify, then four tracks (amortised cost, FVOCI debt, FVTPL, FVOCI equity) through day 1, each year, sale and year 1 compared">
    <defs><marker id="fa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 1.2 L10 5 L0 8.8 L2.2 5 Z" class="fl-ah"/></marker></defs>
    ${SECTIONS.map(sec).join('')}
    <g transform="translate(${LEFT.at[0]},${LEFT.at[1]}) scale(${LEFT.scale})">${draw(LEFT)}</g>
    ${draw(RIGHT)}<g class="mc">${cmpCharts()}</g></svg>`; show(cur); };

  // Journal entries in the note: one green box per entry. A '…' line labels the next entry; a Dr after a Cr starts a new one.
  const jeHtml = (lines) => {
    const groups = [];
    let g = null, label = '';
    lines.forEach((l) => {
      if (l.startsWith('…')) { label = l.slice(1).trim(); g = null; return; }
      if (!g || (l.startsWith('Dr') && g.lines.length && g.lines[g.lines.length - 1].startsWith('Cr'))) { g = { label, lines: [] }; groups.push(g); label = ''; }
      g.lines.push(l);
    });
    const line = (l) => { const [acc, amt] = l.split(' :: '); return `<span class="jl${l.startsWith('Cr') ? ' cr' : ''}"><span>${md(acc)}</span>${amt ? `<span class="amt">${amt}</span>` : ''}</span>`; };
    return `<div class="jes">${groups.map((x, gi) => `<div class="je" data-g="${gi}">${x.label ? `<span class="jn">${md(x.label)}</span>` : ''}${x.lines.map(line).join('')}</div>`).join('')}</div>`;
  };
  // Note text: lines starting "- " become a bulleted list.
  const blocks = (t) => {
    const out = [];
    let ul = null;
    t.split('\n').forEach((line) => {
      if (line.startsWith('- ')) { if (!ul) out.push((ul = [])); ul.push(line.slice(2)); } else { ul = null; out.push(line); }
    });
    const lines = (p) => p.split(/(?<=[.!?:])\s+(?=[A-Z(])/).map(md).join('<br>'); // one sentence per line
    // a list of + / − / = steps is a sum: the signs already act as bullets, so no dots
    const sum = (b) => b.length > 1 && b.slice(1).every((i) => /^[+−=-] /.test(i));
    return out.map((b) => (Array.isArray(b) ? `<ul${sum(b) ? ' class="ops"' : ''}>${b.map((i) => `<li>${md(i)}</li>`).join('')}</ul>` : `<p>${lines(b)}</p>`)).join('');
  };
  // Example box: lines of text and calc tables (one named step per row). Amounts with a link get a dotted curve to their entry.
  const exHtml = (items) => `<div class="ex"><b><em>Example</em></b>${items.map((it) => (typeof it === 'string' ? `<p>${md(it)}</p>`
    : `<table class="calc">${it.calc.map((r) => `<tr class="${r.op === '=' ? 'tot' : ''}"><td class="op">${r.op || ''}</td><td>${md(r.t)}</td><td class="amt"${r.link != null ? ` data-link="${r.link}"` : ''}>${r.vt || f1(r.v)}</td></tr>`).join('')}</table>`)).join('')}</div>`;
  // Dotted curves from an amount in the example to the entry box that uses it (drawn over the note).
  const drawLinks = () => {
    note.querySelectorAll('svg.links').forEach((x) => x.remove());
    const box = note.getBoundingClientRect();
    let paths = '';
    note.querySelectorAll('[data-link]').forEach((el) => {
      const [gi, li] = String(el.dataset.link).split('.'); // 'entry' or 'entry.line'
      const g = note.querySelector(`.je[data-g="${gi}"]`);
      if (!g) return;
      const a = el.getBoundingClientRect(), t = (g.querySelectorAll('.jl')[+li || 0] || g).getBoundingClientRect();
      const x1 = a.right - box.left + 6, y1 = a.top + a.height / 2 - box.top, x2 = t.left - box.left - 8, y2 = t.top + t.height / 2 - box.top;
      if (x2 < x1 + 30) return; // entries stacked below the text: no room for a curve
      const dx = Math.min(140, (x2 - x1) / 2);
      paths += `<path d="M${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}"/><circle cx="${x2}" cy="${y2}" r="2"/>`;
    });
    if (paths) note.insertAdjacentHTML('beforeend', `<svg class="links" width="${box.width}" height="${box.height}">${paths}</svg>`);
  };
  window.addEventListener('resize', () => drawLinks());
  const note = document.getElementById('note');
  function show(id) {
    cur = id;
    document.querySelectorAll('.fl-n').forEach((g) => g.classList.toggle('tapped', g.dataset.id === id));
    document.querySelectorAll('.mc-bar').forEach((g) => g.classList.toggle('sel', id === g.dataset.note));
    let n = id && id.startsWith('yr:') ? yearNote(+id.slice(3)) : (id && NOTES[id]) || ALL;
    if (typeof n === 'function') n = n(S);
    note.classList.toggle('has-je', !!n.je);
    note.innerHTML = `<div class="txt"><h3>${md(n.h)}</h3>${blocks(n.what)}${n.ex ? exHtml(n.ex) : ''}${n.why ? `<div class="why"><b>Why</b>${blocks(n.why)}</div>` : ''}${n.traps ? `<div class="traps"><b>Traps</b><ul>${n.traps.map((t) => `<li>${md(t)}</li>`).join('')}</ul></div>` : ''}</div>${n.je ? jeHtml(n.je) : ''}`;
    drawLinks();
  }
  const chart = document.getElementById('chart');
  chart.addEventListener('click', (e) => {
    const bar = e.target.closest('[data-note]');
    if (bar) return show(bar.dataset.note);
    const n = e.target.closest('.fl-n');
    if (n) show(n.dataset.id);
  });
  chart.addEventListener('keydown', (e) => { const n = e.target.closest('.fl-n'); if (n && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); show(n.dataset.id); } });
  const modeBar = document.getElementById('mode');
  const setMode = (m) => { ex = m; modeBar.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.m === m)); render(); };
  modeBar.addEventListener('click', (e) => { const b = e.target.closest('[data-m]'); if (b) setMode(b.dataset.m); });
  setMode('bond');
  if (document.fonts) document.fonts.ready.then(render);
})();
</script>
