      + txt((c[0] + c[1]) / 2, wb + 10, `{l|**(a)** rate changed? ${S.cut ? 'yes' : 'no'}}`, 'm')
      + (S.cut ? txt((c[0] + c[1]) / 2, wb + 20, 'opening gap 10,000 × (15% − 17%)', 'm') + txt((c[0] + c[1]) / 2, wb + 30, `= {i|**${n0(F.remeasure)} credit**}`, 'm')
        : txt((c[0] + c[1]) / 2, wb + 20, 'opening stays 1,700', 'm') + txt((c[0] + c[1]) / 2, wb + 30, '= 0', 'm')));
    if (S.cut) o += `<rect class="mc-rel" x="${c[1] - bw / 2}" y="${wb - s(F.open)}" width="${bw}" height="${s(F.remeasure)}"/>`;
    o += tap('c-close', bar(c[2], F.dtl, 'mc-lb') + txt(c[2], wb + 10, 'closing', 'm'));
    o += `<rect class="mc-def" x="${c[2] - bw / 2}" y="${wb - s(F.dtl)}" width="${bw}" height="${s(F.growth)}"/>`;
    o += tap('c-move', txt((c[1] + c[2]) / 2, wb + 10, '{x|**(b)** the year’s new gap}', 'm') + txt((c[1] + c[2]) / 2, wb + 20, `10,000 × ${pc(F.rd)}`, 'm') + txt((c[1] + c[2]) / 2, wb + 30, `= {x|**${n0(F.growth)} charge**}`, 'm'));
    // step 3 the movement and step 4 its check, side by side under the waterfall
    const y3 = b.y + 280, w3 = (b.w - 34) / 2;
    o += stepAt('c-move', b.x + 12 + w3 / 2, y3, w3, 70, 'x', ['calculate the **deferred tax expense**', ['the movement: closing − opening', 'lab'], [`${n0(F.dtl)} − ${n0(F.open)}`, 'calc'], [`= ${n0(F.move)}`, 'res'], ['never the closing balance · → 5B', 'tip']], 3);
    o += stepAt('c-check', b.x + 22 + w3 * 1.5, y3, w3, 70, 'x', ['check **the movement**', ['(a) rate effect + (b) the year’s new gap', 'lab'], [`${S.cut ? `−${n0(F.remeasure)}` : '0'} + ${n0(F.growth)} = ${n0(F.move)} ✓`, 'calc'], ['a check only: still one entry (5B)', 'tip'], [S.cut ? '(a) is disclosed in the tax note' : 'with a rate change, (a) is disclosed in the tax note', 'tip']], 4);
    // 5A and 5B: badges on the two entry boxes
    const pill = (id, t) => { const n = box(id); return `<rect class="cl-bd x" x="${n.x + 9}" y="${n.y + 7}" width="17" height="11" rx="5.5"/><text class="cl-bdt" x="${n.x + 17.5}" y="${n.y + 15}" text-anchor="middle">${t}</text>`; };
    o += pill('now', '5A') + pill('later', '5B');
    return o;
  };

  // Section 5: the DTL balance at each year end.
  // Section 5, top of each column: a statement extract for year 2. Rows: h = heading, li = line item with amount,
  // tip = the rule that goes with it, tot = a total under a rule.
  const extract = (id, rows) => {
    const b = box(id), x1 = b.x + 12, x2 = b.x + b.w - 12;
    let y = b.y + 30, o = '';
    rows.forEach(([k, t, v, c = 'x']) => {
      if (k === 'h') { y += y > b.y + 30 ? 15 : 11; o += `<text class="pt-h" x="${x1}" y="${y}">${esc(t)}</text>`; }
      if (k === 'li' || k === 'tot') {
        y += k === 'tot' ? 13 : 11;
        if (k === 'tot') o += `<line class="mc-ax" x1="${x1}" x2="${x2}" y1="${y - 8.5}" y2="${y - 8.5}"/>`;
        o += txt(x1, y, t, k === 'tot' ? 'pt-tot' : 'pt-li', 'start') + (v != null ? txt(x2, y, v, `pt-amt ${c}`, 'end') : '');
      }
      if (k === 'tip') { y += 9.5; o += txt(x1 + 6, y, t, 'cl-tip pt-tip', 'start'); }
    });
    return o;
  };
  const presentTop = () => { const F = S.F;
    return extract('bs', [['h', 'Non-current liabilities'], ['li', '{l|Deferred tax liability}', n0(F.dtl), 'l'], ['tip', 'always non-current · never discounted'],
      ['h', 'Current liabilities'], ['li', '{l|Current tax payable}', n0(F.current), 'l'], ['tip', 'paid too much? → current tax asset'],
      ['h', 'Offset a DTA against a DTL?'], ['tip', 'only with a legal right to offset,'], ['tip', 'for the same tax authority']])
    + extract('pl', [['li', 'Profit before tax', n0(EX.profit), 'm'], ['li', '{x|Tax expense}', `(${n0(F.total)})`], ['tip', `current ${n0(F.current)} + deferred ${n0(F.move)}`],
      ['tot', 'Profit for the year', n0(EX.profit - F.total), 'm'], ['h', 'Other comprehensive income'], ['li', 'Revaluation gain, net of tax'],
      ['tip', 'tax on an OCI item stays in OCI:'], ['tip', 'e.g. gain 50,000 − DTL 8,500 = 41,500']])
    + extract('note', [['h', 'Components of tax expense'], ['li', '{x|Current tax}', n0(F.current)], ['li', '{x|Deferred tax}', n0(F.move)],
      ['tip', S.cut ? `of which rate change: (${n0(F.remeasure)}) credit` : 'of which rate change: 0'],
      ['h', 'Also disclosed'], ['tip', 'reconciliation: profit × rate → tax (below)'], ['tip', 'unused losses with no DTA'], ['tip', 'evidence for a DTA after recent losses']]);
  };

  const dtlChart = () => {
    const b = region('bs'), yt = b.y + 56, yb = b.y + b.h - 18, max = 5100 * 1.1, s = (v) => (v / max) * (yb - yt);
    let o = head(b, 'Lim’s DTL at each year end', 'builds, then is released', 18) + key(b.x + 12, b.y + 44, [['mc-lb', 'deferred tax liability', 'l']]);
    o += `<line class="mc-ax" x1="${b.x + 10}" x2="${b.x + b.w - 10}" y1="${yb}" y2="${yb}"/>`;
    o += groups(b, yrIds(), yt, yb, (k, gx, gw) => { const y = S.Y[k], bw = 20, x = gx + gw / 2 - bw / 2;
      return `${y.dtl ? `<rect class="mc-lb" x="${x}" width="${bw}" y="${yb - s(y.dtl)}" height="${s(y.dtl)}"/>` : ''}<text class="mc-lbl l" x="${x + bw / 2}" y="${yb - s(y.dtl) - 3}" text-anchor="middle">${n0(y.dtl)}</text>
        <text class="mc-lbl m" x="${x + bw / 2}" y="${yb + 11}" text-anchor="middle">yr ${k + 1}</text>`; });
    return o;
  };

  // Section 5: tax expense = current + deferred. A release (year 4) is the hatched top of the current tax bar.
  const plChart = () => {
    const b = region('pl'), yt = b.y + 66, yb = b.y + b.h - 18, max = 42000, s = (v) => (v / max) * (yb - yt);
    let o = head(b, 'Tax expense each year', 'current + deferred', 18) + key(b.x + 12, b.y + 44, [['mc-cur', 'current tax', 'x'], ['mc-def', 'deferred tax added', 'x'], ['mc-rel', 'deferred tax released', 'x']]);
    o += `<line class="mc-ax" x1="${b.x + 10}" x2="${b.x + b.w - 10}" y1="${yb}" y2="${yb}"/>`;
    o += groups(b, yrIds(), yt, yb, (k, gx, gw) => { const y = S.Y[k], bw = 20, x = gx + gw / 2 - bw / 2;
      const base = y.move >= 0 ? y.current : y.total;
      let g = `<rect class="mc-cur" x="${x}" width="${bw}" y="${yb - s(base)}" height="${s(base)}"/>`;
      g += y.move >= 0 ? `<rect class="mc-def" x="${x}" width="${bw}" y="${yb - s(y.total)}" height="${s(y.move)}"/>`
        : `<rect class="mc-rel" x="${x}" width="${bw}" y="${yb - s(y.current)}" height="${s(-y.move)}"/>`;
      return g + `<line class="mc-rent" x1="${x - 5}" x2="${x + bw + 5}" y1="${yb - s(fair(y))}" y2="${yb - s(fair(y))}"/>
        <text class="mc-lbl x" x="${x + bw / 2}" y="${yb - s(Math.max(y.current, y.total)) - 3}" text-anchor="middle">${n0(y.total)}</text>
        <text class="mc-lbl m" x="${x + bw / 2}" y="${yb + 11}" text-anchor="middle">yr ${k + 1}</text>`; });
    return o;
  };

  // Section 5: the reconciliation for year 2, as a small calc.
  const reconChart = () => {
    const b = region('note'), F = S.F, x1 = b.x + 14, x2 = b.x + b.w - 14;
    const rows = [[`profit × ${pc(F.rc)}`, F.recon], [`+ entertainment × ${pc(F.rc)}`, F.entFx], ...(F.rateFx ? [['− rate cut on deferred tax', -F.rateFx]] : [['± rate change', 0]]), ['± losses with no DTA', 0]];
    let y = b.y + 50, o = head(b, 'Reconciliation, year 2', 'why tax ≠ profit × rate', 18);
    rows.forEach(([t, v]) => { y += 15; o += `<text class="mc-lbl m" x="${x1}" y="${y}">${t}</text><text class="mc-lbl x" x="${x2}" y="${y}" text-anchor="end">${n0(v)}</text>`; });
    y += 6; o += `<line class="mc-ax" x1="${x1}" x2="${x2}" y1="${y}" y2="${y}"/>`; y += 12;
    o += `<text class="mc-lbl x" x="${x1}" y="${y}">= tax expense</text><text class="mc-lbl x" x="${x2}" y="${y}" text-anchor="end">${n0(F.total)}</text>`;
    y += 22; o += `<text class="mc-lbl m" x="${x1}" y="${y}">not in it: capital allowances (temporary)</text>`;
    const saved = Math.round((F.a - S.dep) * F.rc);
    y += 11; o += `<text class="mc-lbl m" x="${x1}" y="${y}">they cut current tax by ${n0(saved)};</text>`;
    y += 11; o += `<text class="mc-lbl m" x="${x1}" y="${y}">${F.move === saved ? 'deferred tax adds it back: they cancel' : `deferred adds back ${n0(F.move)}: the ${n0(saved - F.move)}`}</text>`;
    if (F.move !== saved) { y += 11; o += `<text class="mc-lbl m" x="${x1}" y="${y}">left over is the rate cut</text>`; }
    return o;
  };

  // A year in full, for a tapped bar.
  const yearNote = (k) => {
    const y = S.Y[k], prev = k ? S.Y[k - 1] : null, mv = y.move;
    const je = [`… year ${k + 1}: current tax`, `Dr {x|Current tax expense} :: ${f1(y.current)}`, `Cr {l|Current tax payable} :: ${f1(y.current)}`,
      mv >= 0 ? `… year ${k + 1}: deferred tax` : `… year ${k + 1}: the DTL is released`,
      ...(mv >= 0 ? [`Dr {x|Deferred tax expense} :: ${f1(mv)}`, `Cr {l|Deferred tax liability} :: ${f1(mv)}`] : [`Dr {l|Deferred tax liability} :: ${f1(-mv)}`, `Cr {i|Deferred tax income} :: ${f1(-mv)}`])];
    const moveRows = y.remeasure
      ? [{ t: 'opening DTL', v: y.open }, { op: '−', t: `(a) rate cut on the opening gap: ${n0(prev.td)} × 2% (credit)`, v: y.remeasure }, { op: '+', t: `(b) the year’s new gap: ${n0(y.td - prev.td)} × ${pc(y.rd)} (charge)`, v: y.growth }, { op: '=', t: `closing DTL: ${n0(y.td)} × ${pc(y.rd)}`, v: y.dtl }]
      : [{ t: `closing DTL: ${n0(y.td)} × ${pc(y.rd)}`, v: y.dtl }, { op: '−', t: 'opening DTL', v: y.open }, { op: '=', t: mv >= 0 ? '{x|deferred tax expense}' : '{i|deferred tax income} (a release)', v: Math.abs(mv), link: 1 }];
    return { h: `Year ${k + 1} in full${S.cut ? ' (rate cut to 15% from year 3)' : ''}`,
      what: k < 3 ? `Tax law gives a $40,000 allowance against $30,000 of depreciation, so the joy gap grows by $10,000 and so does the deferred tax.${y.remeasure ? ' This year a 15% rate is enacted for later years, so the opening DTL is restated first.' : ''}` : 'What goes up must come down: tax law has no allowance left, but the books still charge $30,000 of depreciation. Taxable profit is higher, and the DTL built up in years 1–3 is released.',
      ex: ['**Current tax**', { calc: [{ t: 'accounting profit', v: EX.profit }, { op: '+', t: '{x|depreciation expense}', v: S.dep }, { op: '−', t: 'capital allowance', v: y.a }, { op: '+', t: 'non-deductible {x|entertainment expense}', v: EX.ent }, { op: '=', t: 'taxable profit', v: y.taxable }, { op: '×', t: 'rate for this year', vt: pc(y.rc) }, { op: '=', t: '{x|current tax}', v: y.current, link: 0 }] },
        '**Carrying amount vs tax base**', { calc: [{ t: '{a|carrying amount}: $120,000 − depreciation to date', v: y.cv }, { op: '−', t: 'tax base: $120,000 − allowances to date', v: y.tb }, { op: '=', t: 'gap (joy)', v: y.td }] },
        '**Deferred tax**', { calc: moveRows },
        ...(y.remeasure ? [{ calc: [{ op: '=', t: '{x|deferred tax expense}: closing − opening', v: mv, link: 1 }] }] : []),
        '**Profit or loss**', { calc: [{ t: '{x|current tax}', v: y.current }, { op: mv >= 0 ? '+' : '−', t: '{x|deferred tax}', v: Math.abs(mv) }, { op: '=', t: 'tax expense', v: y.total }] }],
      je };
  };

  const sec = (s) => `<g class="sec ${s.cls}"><rect x="${s.x}" y="0" width="${s.w}" height="${H}" rx="10"/><text x="${s.x + 12}" y="19">${esc(s.t)}</text></g>`;
  let cur = '';
  const render = () => { S = schedule(mode); RIGHT = right(S); document.getElementById('chart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" style="width:${Math.round(W * 1.3)}px" role="img" aria-label="Income tax: two worlds and two profits, the gap (joy or gloom), what to calculate at each year end, the two bills, and presentation">
    <defs><marker id="fa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 1.2 L10 5 L0 8.8 L2.2 5 Z" class="fl-ah"/></marker>
    <pattern id="hatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="4" class="mc-hl"/></pattern></defs>
    ${SECTIONS.map(sec).join('')}
    ${draw(RIGHT)}<g class="mc">${worldChart()}${gapChart()}${calcChart()}${presentTop()}${dtlChart()}${plChart()}${reconChart()}</g></svg>`; show(cur); };

  // Journal entries in the note: one green box per entry. A '…' line labels the next entry; a Dr after a Cr starts a new one.
  const jeHtml = (lines) => {
    const groups = [];
    let g = null, label = '';
    lines.forEach((l) => {
      if (l.startsWith('…')) { label = l.slice(1).trim(); g = null; return; }
      if (!g || (l.startsWith('Dr') && g.lines.length && g.lines[g.lines.length - 1].startsWith('Cr'))) { g = { label, lines: [] }; groups.push(g); label = ''; }
      g.lines.push(l);
    });
    const line = (l) => { const [acc, amt] = l.split(' :: '); return `<span class="jl${l.startsWith('Cr') ? ' cr' : ''}"><span>${md(acc)}</span>${amt ? `<span class="amt">${amt}</span>` : ''}</span>`; };
    return `<div class="jes">${groups.map((x, gi) => `<div class="je" data-g="${gi}">${x.label ? `<span class="jn">${md(x.label)}</span>` : ''}${x.lines.map(line).join('')}</div>`).join('')}</div>`;
  };
  // Note text: lines starting "- " become a bulleted list.
  const blocks = (t) => {
    const out = [];
    let ul = null;
    t.split('\n').forEach((line) => {
      if (line.startsWith('- ')) { if (!ul) out.push((ul = [])); ul.push(line.slice(2)); } else { ul = null; out.push(line); }
    });
    const lines = (p) => p.split(/(?<=[.!?:])\s+(?=[A-Z(])/).map(md).join('<br>'); // one sentence per line
    // a list of + / − / = steps is a sum: the signs already act as bullets, so no dots
    const sum = (b) => b.length > 1 && b.slice(1).every((i) => /^[+−=-] /.test(i));
    return out.map((b) => (Array.isArray(b) ? `<ul${sum(b) ? ' class="ops"' : ''}>${b.map((i) => `<li>${md(i)}</li>`).join('')}</ul>` : `<p>${lines(b)}</p>`)).join('');
  };
  // Example box: lines of text and calc tables (one named step per row). Amounts with a link get a dotted curve to their entry.
  const exHtml = (items) => `<div class="ex"><b><em>Example</em></b>${items.map((it) => (typeof it === 'string' ? `<p>${md(it)}</p>`
    : `<table class="calc">${it.calc.map((r) => `<tr class="${r.op === '=' ? 'tot' : ''}"><td class="op">${r.op || ''}</td><td>${md(r.t)}</td><td class="amt"${r.link != null ? ` data-link="${r.link}"` : ''}>${r.vt || f1(r.v)}</td></tr>`).join('')}</table>`)).join('')}</div>`;
  // Dotted curves from an amount in the example to the entry box that uses it (drawn over the note).
  const drawLinks = () => {
    note.querySelectorAll('svg.links').forEach((x) => x.remove());
    const box = note.getBoundingClientRect();
    let paths = '';
    note.querySelectorAll('[data-link]').forEach((el) => {
      const [gi, li] = String(el.dataset.link).split('.'); // 'entry' or 'entry.line'
      const g = note.querySelector(`.je[data-g="${gi}"]`);
      if (!g) return;
      const a = el.getBoundingClientRect(), t = (g.querySelectorAll('.jl')[+li || 0] || g).getBoundingClientRect();
      const x1 = a.right - box.left + 6, y1 = a.top + a.height / 2 - box.top, x2 = t.left - box.left - 8, y2 = t.top + t.height / 2 - box.top;
      if (x2 < x1 + 30) return; // entries stacked below the text: no room for a curve
      const dx = Math.min(140, (x2 - x1) / 2);
      paths += `<path d="M${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}"/><circle cx="${x2}" cy="${y2}" r="2"/>`;
    });
    if (paths) note.insertAdjacentHTML('beforeend', `<svg class="links" width="${box.width}" height="${box.height}">${paths}</svg>`);
  };
  window.addEventListener('resize', () => drawLinks());
  const note = document.getElementById('note');
  function show(id) {
    cur = id;
    document.querySelectorAll('.fl-n').forEach((g) => g.classList.toggle('tapped', g.dataset.id === id));
    document.querySelectorAll('.mc-bar').forEach((g) => g.classList.toggle('sel', id === g.dataset.note));
    let n = id && id.startsWith('yr:') ? yearNote(+id.slice(3)) : (id && NOTES[id]) || ALL;
    if (typeof n === 'function') n = n(S);
    note.classList.toggle('has-je', !!n.je);
    note.innerHTML = `<div class="txt"><h3>${md(n.h)}</h3>${blocks(n.what)}${n.ex ? exHtml(n.ex) : ''}${n.why ? `<div class="why"><b>Why</b>${blocks(n.why)}</div>` : ''}${n.traps ? `<div class="traps"><b>Traps</b><ul>${n.traps.map((t) => `<li>${md(t)}</li>`).join('')}</ul></div>` : ''}</div>${n.je ? jeHtml(n.je) : ''}`;
    drawLinks();
  }
  const chart = document.getElementById('chart');
  chart.addEventListener('click', (e) => {
    const bar = e.target.closest('[data-note]');
    if (bar) return show(bar.dataset.note);
    const n = e.target.closest('.fl-n');
    if (n) show(n.dataset.id);
  });
  chart.addEventListener('keydown', (e) => { const n = e.target.closest('.fl-n'); if (n && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); show(n.dataset.id); } });
  const modeBar = document.getElementById('mode');
  const setMode = (m) => { mode = m; modeBar.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.m === m)); render(); };
  modeBar.addEventListener('click', (e) => { const b = e.target.closest('[data-m]'); if (b) setMode(b.dataset.m); });
  setMode('base');
  if (document.fonts) document.fonts.ready.then(render);
})();
</script>
</body>
</html>
