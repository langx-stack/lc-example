    if (n.h > 60) { // big box: top-aligned title and subs, then the entry centred in the space under the rule
      let y = n.je || n.k === 'chart' ? n.y + 16 : n.y + n.h / 2 - (12 + subs.length * 11) / 2 + 9; // no entry: centre the text
      o += `<text class="fl-t" x="${cx}" y="${y}" text-anchor="middle">${tsp(n.t)}</text>`;
      if (n.bullets) n.sub.forEach((s) => wrap(s, 'fl-s', max - 22).forEach((l, i) => { y += 11; o += `${i ? '' : `<text class="fl-s" x="${n.x + 12}" y="${y}">•</text>`}<text class="fl-s fl-li" x="${n.x + 21}" y="${y}">${tsp(l)}</text>`; }));
      else subs.forEach((s) => { y += 11; o += `<text class="fl-s" x="${cx}" y="${y}" text-anchor="middle">${tsp(s)}</text>`; });
      if (n.je) {
        y += 9; o += `<line class="fl-hr" x1="${n.x + 10}" x2="${n.x + n.w - 10}" y1="${y}" y2="${y}"/>`;
        const ind = (l) => (l.startsWith('Cr') ? 13 : 0);
        const lw = Math.max(...n.je.filter(Boolean).map((l) => ind(l) + width(l, 'fl-je')));
        // tags: several entries in one box get a number on the left and a label on the right
        const numW = n.tags ? 13 : 0, tagW = n.tags ? 8 + Math.max(...n.tags.map((t) => width(t, 'fl-s'))) : 0;
        const bw = numW + lw + tagW;
        const bh = n.je.reduce((a, l) => a + (l ? 10.5 : 4), 0);
        const x0 = cx - bw / 2;
        const after = (n.after || []).flatMap((s) => wrap(s, 'fl-s', max));
        const bottom = n.y + n.h - (after.length ? after.length * 11 + 10 : 0);
        if (after.length) o += `<line class="fl-hr" x1="${n.x + 10}" x2="${n.x + n.w - 10}" y1="${bottom}" y2="${bottom}"/>`; // closing lines get their own rule
        after.forEach((s, i) => { o += `<text class="fl-s" x="${cx}" y="${bottom + (i + 1) * 11 + 1}" text-anchor="middle">${tsp(s)}</text>`; });
        let ly = y + (bottom - y - bh) / 2 + 8; // baseline of the first line
        let gi = 0, first = true;
        n.je.forEach((l) => {
          if (!l) { ly += 4; first = true; return; }
          if (n.tags && first) {
            o += `<circle class="fl-num" cx="${x0 + 4.5}" cy="${ly - 2.8}" r="4.6"/><text class="fl-numt" x="${x0 + 4.5}" y="${ly - 0.4}" text-anchor="middle">${gi + 1}</text>
              <text class="fl-tag" x="${x0 + numW + lw + 8}" y="${ly}">${esc(n.tags[gi])}</text>`;
            gi++;
          }
          first = false;
          o += `<text class="fl-je" x="${x0 + numW + ind(l)}" y="${ly}">${tsp(l)}</text>`; ly += 10.5;
        });
      }
    } else {
      const lines = [...wrap(n.t, 'fl-t', max).map((t) => ({ t, c: 'fl-t', h: 12 })), ...subs.map((t) => ({ t, c: 'fl-s', h: 10.5 }))];
      let y = n.y + n.h / 2 - lines.reduce((a, l) => a + l.h, 0) / 2 + 8.5;
      lines.forEach((l) => { o += `<text class="${l.c}" x="${cx}" y="${y}" text-anchor="middle">${tsp(l.t)}</text>`; y += l.h; });
    }
    return o + '</g>';
  };
  const edge = (e) => `<g class="fl-e ${e.cls || ''}"><path d="${e.d}" marker-end="url(#fa)"/>${e.lab ? `<text x="${e.lx}" y="${e.ly}" text-anchor="${e.anchor || 'start'}">${esc(e.lab)}</text>` : ''}</g>`;
  const join = (j) => `<g class="fl-j"><circle cx="${j.cx}" cy="${j.cy}" r="11"/><text x="${j.cx}" y="${j.cy + 3.5}" text-anchor="middle">${esc(j.t)}</text></g>`;
  const draw = (part) => `${part.edges.map(edge).join('')}${(part.joins || []).map(join).join('')}${part.nodes.map(node).join('')}`;
  let mode = 'base';
  let S = schedule(mode), RIGHT = right(S);
  const box = (id) => RIGHT.nodes.find((n) => n.id === id);
  const head = (b, t1, t2, y = 17) => `<text class="mc-h" x="${b.x + b.w / 2}" y="${b.y + y}" text-anchor="middle">${t1}</text><text class="mc-h2" x="${b.x + b.w / 2}" y="${b.y + y + 11}" text-anchor="middle">${t2}</text>`;
  const key = (kx, ky, rows) => rows.map(([cls, label, lcls], i) => (cls === 'dash'
    ? `<line class="mc-rent" x1="${kx}" x2="${kx + 8}" y1="${ky + i * 10 - 3}" y2="${ky + i * 10 - 3}"/>`
    : `<rect class="${cls}" x="${kx}" y="${ky + i * 10 - 7}" width="8" height="8" rx="1.5"/>`) + `<text class="mc-lbl ${lcls}" x="${kx + 12}" y="${ky + i * 10}">${label}</text>`).join('');
  const region = (id) => { const n = box(id); return { x: n.x, y: n.y + n.chartAt, w: n.w, h: n.h - n.chartAt }; };
  // Groups of bars, one per year (or yr 0 = day 1), each tappable.
  const groups = (b, ids, yt, yb, draw) => {
    const m = ids.length, gw = (b.w - 20) / m;
    return ids.map((id, k) => { const gx = b.x + 10 + k * gw;
      return `<g class="mc-bar${cur === id ? ' sel' : ''}" data-note="${id}"><rect class="mc-hit" x="${gx + 1}" y="${yt - 8}" width="${gw - 2}" height="${yb - yt + 20}" rx="4"/>${draw(k, gx, gw)}</g>`; }).join('');
  };
  const yrIds = () => S.Y.map((y) => `yr:${y.k}`);
  const fair = (y) => y.recon + y.entFx; // the tax the profit should carry: profit × rate + entertainment × rate

  // Section 2: tax expense each year, current tax only vs current + deferred, against what the profit should carry.
  const whyChart = () => {
    const b = box('why'), yt = b.y + 58, yb = b.y + b.h - 16, max = 42000, s = (v) => (v / max) * (yb - yt);
    let o = `<text class="mc-h2" x="${b.x + b.w / 2}" y="${b.y + 28}" text-anchor="middle">same profit every year, so the tax expense should be the same</text>`;
    o += key(b.x + 14, b.y + 40, [['mc-cur', 'current tax only: low, then a jump in year 4', 'x']]) + key(b.x + 200, b.y + 40, [['mc-tot', 'current + deferred: follows the profit', 'x']]) + key(b.x + 14, b.y + 50, [['dash', 'profit × rate + entertainment × rate', 'm']]);
    o += `<line class="mc-ax" x1="${b.x + 10}" x2="${b.x + b.w - 10}" y1="${yb}" y2="${yb}"/>`;
    o += groups(b, yrIds(), yt, yb, (k, gx, gw) => {
      const y = S.Y[k], bw = 30, x1 = gx + gw / 2 - bw - 2, x2 = gx + gw / 2 + 2;
      return `<rect class="mc-cur" x="${x1}" width="${bw}" y="${yb - s(y.current)}" height="${s(y.current)}"/><text class="mc-lbl${y.current > fair(y) ? ' x' : ''}" x="${x1 + bw / 2}" y="${y.current > fair(y) ? yb - s(y.current) - 3 : yb - s(y.current) + 11}" text-anchor="middle">${n0(y.current)}</text>
        <rect class="mc-tot" x="${x2}" width="${bw}" y="${yb - s(y.total)}" height="${s(y.total)}"/><text class="mc-lbl in" x="${x2 + bw / 2}" y="${yb - s(y.total) + 11}" text-anchor="middle">${n0(y.total)}</text>
        <line class="mc-rent" x1="${x1 - 4}" x2="${x2 + bw + 4}" y1="${yb - s(fair(y))}" y2="${yb - s(fair(y))}"/>
        <text class="mc-lbl m" x="${gx + gw / 2}" y="${yb + 10}" text-anchor="middle">yr ${k + 1}</text>`;
    });
    return o;
  };

  // Section 3: the machine's carrying amount and tax base at day 1 and each year end; the gap shaded above the shorter bar.
  const gapChart = () => {
    const b = box('gapc'), yt = b.y + 58, yb = b.y + b.h - 26, s = (v) => (v / EX.cost) * (yb - yt);
    let o = `<text class="mc-h2" x="${b.x + b.w / 2}" y="${b.y + 28}" text-anchor="middle">the gap opens, then closes</text>`;
    o += key(b.x + 12, b.y + 44, [['mc-ab', 'carrying amount (books)', 'a']]) + key(b.x + 118, b.y + 44, [['mc-tbk', 'tax base (tax law)', 'm']]) + key(b.x + 206, b.y + 44, [['mc-gp', 'gap → DTL', 'l']]);
    o += `<line class="mc-ax" x1="${b.x + 10}" x2="${b.x + b.w - 10}" y1="${yb}" y2="${yb}"/>`;
    const pts = [{ cv: EX.cost, tb: EX.cost, td: 0, dtl: 0 }, ...S.Y];
    o += groups(b, ['tb', ...yrIds()], yt, yb + 8, (k, gx, gw) => {
      const p = pts[k], bw = 14, x1 = gx + gw / 2 - bw - 1, x2 = gx + gw / 2 + 1, hi = Math.max(p.cv, p.tb);
      return `${p.cv ? `<rect class="mc-ab" x="${x1}" width="${bw}" y="${yb - s(p.cv)}" height="${s(p.cv)}"/>` : ''}
        ${p.tb ? `<rect class="mc-tbb" x="${x2}" width="${bw}" y="${yb - s(p.tb)}" height="${s(p.tb)}"/>` : ''}
        ${p.td ? `<rect class="mc-gp" x="${x2}" width="${bw}" y="${yb - s(hi)}" height="${s(p.td)}"/><text class="mc-lbl l" x="${gx + gw / 2}" y="${yb - s(hi) - 3}" text-anchor="middle">${n0(p.td)}</text>` : ''}
        <text class="mc-lbl m" x="${gx + gw / 2}" y="${yb + 10}" text-anchor="middle">yr ${k}</text>
        <text class="mc-lbl ${p.dtl ? 'l' : 'm'}" x="${gx + gw / 2}" y="${yb + 20}" text-anchor="middle">${p.dtl ? `DTL ${n0(p.dtl)}` : 'no gap'}</text>`;
    });
    return o;
  };

  // Section 3: the 2×2 grid, each cell with a small pair of bars (carrying amount, tax base) and what the gap creates.
  const gridChart = () => {
    const b = box('grid'), c0 = b.x + 62, cw = (b.w - 70) / 2, r0 = b.y + 40, rh = 38;
    let o = `<text class="mc-lbl m" x="${c0 + cw / 2}" y="${b.y + 32}" text-anchor="middle">carrying amount ABOVE tax base</text><text class="mc-lbl m" x="${c0 + cw * 1.5}" y="${b.y + 32}" text-anchor="middle">carrying amount BELOW tax base</text>`;
    const cell = (row, col, el, ca, tb, res, ex) => {
      const x = c0 + col * cw, y = r0 + row * rh, bh = (v) => v * 26, base = y + 32, gEl = res === 'DTL' ? 'l' : 'a';
      return `<rect class="mc-cell" x="${x + 2}" y="${y}" width="${cw - 4}" height="${rh - 3}" rx="4"/>
        <rect class="mc-${el}b" x="${x + 8}" width="8" y="${base - bh(ca)}" height="${bh(ca)}"/><rect class="mc-tbb" x="${x + 17}" width="8" y="${base - bh(tb)}" height="${bh(tb)}"/>
        <rect class="mc-gp${gEl === 'a' ? ' a' : ''}" x="${ca > tb ? x + 17 : x + 8}" width="8" y="${base - bh(Math.max(ca, tb))}" height="${bh(Math.abs(ca - tb))}"/>
        <text class="mc-lbl ${gEl}" x="${x + 32}" y="${y + 15}">${res === 'DTL' ? 'taxable → DTL' : 'deductible → DTA'}</text>
        <text class="mc-lbl m" x="${x + 32}" y="${y + 26}">${ex}</text>`;
    };
    o += `<text class="mc-lbl a" x="${b.x + 12}" y="${r0 + 21}">Asset</text><text class="mc-lbl l" x="${b.x + 12}" y="${r0 + rh + 21}">Liability</text>`;
    o += cell(0, 0, 'a', 1, 0.6, 'DTL', 'Lim’s machine') + cell(0, 1, 'a', 0.6, 1, 'DTA', 'slow allowances')
      + cell(1, 0, 'l', 1, 0.6, 'DTA', 'warranty provision') + cell(1, 1, 'l', 0.6, 1, 'DTL', 'rare');
    return o;
  };

  // Section 5: the DTL balance at each year end.
  const dtlChart = () => {
    const b = region('bs'), yt = b.y + 56, yb = b.y + b.h - 18, max = 5100 * 1.1, s = (v) => (v / max) * (yb - yt);
    let o = head(b, 'Lim’s DTL at each year end', 'builds, then is released', 18) + key(b.x + 12, b.y + 44, [['mc-lb', 'deferred tax liability', 'l']]);
    o += `<line class="mc-ax" x1="${b.x + 10}" x2="${b.x + b.w - 10}" y1="${yb}" y2="${yb}"/>`;
    o += groups(b, yrIds(), yt, yb, (k, gx, gw) => { const y = S.Y[k], bw = 20, x = gx + gw / 2 - bw / 2;
      return `${y.dtl ? `<rect class="mc-lb" x="${x}" width="${bw}" y="${yb - s(y.dtl)}" height="${s(y.dtl)}"/>` : ''}<text class="mc-lbl l" x="${x + bw / 2}" y="${yb - s(y.dtl) - 3}" text-anchor="middle">${n0(y.dtl)}</text>
        <text class="mc-lbl m" x="${x + bw / 2}" y="${yb + 11}" text-anchor="middle">yr ${k + 1}</text>`; });
    return o;
  };

  // Section 5: tax expense = current + deferred. A release (year 4) is the hatched top of the current tax bar.
  const plChart = () => {
    const b = region('pl'), yt = b.y + 66, yb = b.y + b.h - 18, max = 42000, s = (v) => (v / max) * (yb - yt);
    let o = head(b, 'Tax expense each year', 'current + deferred', 18) + key(b.x + 12, b.y + 44, [['mc-cur', 'current tax', 'x'], ['mc-def', 'deferred tax added', 'x'], ['mc-rel', 'deferred tax released', 'x']]);
    o += `<line class="mc-ax" x1="${b.x + 10}" x2="${b.x + b.w - 10}" y1="${yb}" y2="${yb}"/>`;
    o += groups(b, yrIds(), yt, yb, (k, gx, gw) => { const y = S.Y[k], bw = 20, x = gx + gw / 2 - bw / 2;
      const base = y.move >= 0 ? y.current : y.total;
      let g = `<rect class="mc-cur" x="${x}" width="${bw}" y="${yb - s(base)}" height="${s(base)}"/>`;
      g += y.move >= 0 ? `<rect class="mc-def" x="${x}" width="${bw}" y="${yb - s(y.total)}" height="${s(y.move)}"/>`
        : `<rect class="mc-rel" x="${x}" width="${bw}" y="${yb - s(y.current)}" height="${s(-y.move)}"/>`;
      return g + `<line class="mc-rent" x1="${x - 5}" x2="${x + bw + 5}" y1="${yb - s(fair(y))}" y2="${yb - s(fair(y))}"/>
        <text class="mc-lbl x" x="${x + bw / 2}" y="${yb - s(Math.max(y.current, y.total)) - 3}" text-anchor="middle">${n0(y.total)}</text>
        <text class="mc-lbl m" x="${x + bw / 2}" y="${yb + 11}" text-anchor="middle">yr ${k + 1}</text>`; });
    return o;
  };

  // Section 5: the reconciliation for the focus year, as a small calc.
  const reconChart = () => {
    const b = region('note'), F = S.F, x1 = b.x + 14, x2 = b.x + b.w - 14;
    const rows = [[`profit × ${pc(F.rc)}`, F.recon], [`+ entertainment × ${pc(F.rc)}`, F.entFx], ...(F.rateFx ? [['− rate cut on deferred tax', -F.rateFx]] : [['± rate change', 0]]), ['± losses with no DTA', 0]];
    let y = b.y + 50, o = head(b, `Reconciliation, year ${S.focus + 1}`, 'why tax ≠ profit × rate', 18);
    rows.forEach(([t, v]) => { y += 15; o += `<text class="mc-lbl m" x="${x1}" y="${y}">${t}</text><text class="mc-lbl x" x="${x2}" y="${y}" text-anchor="end">${n0(v)}</text>`; });
    y += 6; o += `<line class="mc-ax" x1="${x1}" x2="${x2}" y1="${y}" y2="${y}"/>`; y += 12;
    o += `<text class="mc-lbl x" x="${x1}" y="${y}">= tax expense</text><text class="mc-lbl x" x="${x2}" y="${y}" text-anchor="end">${n0(F.total)}</text>`;
    y += 22; o += `<text class="mc-lbl m" x="${x1}" y="${y}">not in it: capital allowances (temporary)</text>`;
    const saved = Math.round((F.a - S.dep) * F.rc);
    y += 11; o += `<text class="mc-lbl m" x="${x1}" y="${y}">they cut current tax by ${n0(saved)};</text>`;
    y += 11; o += `<text class="mc-lbl m" x="${x1}" y="${y}">${F.move === saved ? 'deferred tax adds it back: they cancel' : `deferred adds back ${n0(F.move)}: the ${n0(saved - F.move)}`}</text>`;
    if (F.move !== saved) { y += 11; o += `<text class="mc-lbl m" x="${x1}" y="${y}">left over is the rate cut</text>`; }
    return o;
  };

  // A year in full, for a tapped bar.
  const yearNote = (k) => {
    const y = S.Y[k], prev = k ? S.Y[k - 1] : null, mv = y.move;
    const je = [`… year ${k + 1}: current tax`, `Dr {x|Current tax expense} :: ${f1(y.current)}`, `Cr {l|Current tax payable} :: ${f1(y.current)}`,
