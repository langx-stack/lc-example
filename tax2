        // tags: several entries in one box get a number on the left and a label on the right
        const numW = n.tags ? 13 : 0, tagW = n.tags ? 8 + Math.max(...n.tags.map((t) => width(t, 'fl-s'))) : 0;
        const bw = numW + lw + tagW;
        const bh = n.je.reduce((a, l) => a + (l ? 10.5 : 4), 0);
