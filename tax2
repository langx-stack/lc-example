  };
  const yrIds = () => S.Y.map((y) => `yr:${y.k}`);
  const fair = (y) => y.recon + y.entFx; // the tax the profit should carry: profit × rate + entertainment × rate
  const tap = (id, inner) => `<g class="mc-bar${cur === id ? ' sel' : ''}" data-note="${id}">${inner}</g>`;
  const txt = (x, y, s, cls = 'm', anchor = 'middle') => `<text class="mc-lbl ${cls}" x="${x}" y="${y}" text-anchor="${anchor}">${tsp(s)}</text>`;

  // Section 1: each world as a bar of income next to a bar of expenses + profit. To scale ($1,000 = 1px), except that
