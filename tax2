<body>
<main>
  <div class="topbar">
    <div class="eyebrow">B2.2 Income tax</div>
    <div class="mode" id="mode" role="group" aria-label="Tax rate">Tax rate
      <button data-m="base">17% throughout</button><button data-m="cut">cut to 15% from year 3 (enacted in year 2)</button></div>
  </div>
  <div class="fl-box" id="chart"></div>
  <div class="note" id="note" aria-live="polite"></div>
</main>
<script>
// Worked example behind every number, chart and year note: the study app's Lim Trading (apps/study/content/income-tax.js).
// One machine, cost $120,000: the books depreciate it over 4 years, tax law gives capital allowances over 3 years.
// Accounting profit $200,000 every year: sales $500,000 − salaries $264,000 − depreciation $30,000 − a non-deductible
// entertainment expense of $6,000. Whole dollars. The switch changes only the tax rate: 17% throughout, or cut to 15%
// from year 3 (enacted during year 2). The year-end panels quote year 2, the first year with an opening balance.
const EX = { cost: 120000, life: 4, caYears: 3, profit: 200000, ent: 6000, sales: 500000, sal: 264000,
  what: 'Lim Trading buys a machine for $120,000. The books depreciate it over 4 years ($30,000 a year); tax law gives capital allowances over 3 years ($40,000 a year). Sales are $500,000 and salaries $264,000 every year, and there is a $6,000 entertainment expense that tax law never allows, so accounting profit is $200,000 every year.' };
const f1 = (n) => `${n < -0.5 ? '−' : ''}$${Math.abs(Math.round(n)).toLocaleString('en-US')}`; // money, whole dollars
const n0 = (n) => `${n < -0.5 ? '−' : ''}${Math.abs(Math.round(n)).toLocaleString('en-US')}`;
const nb = (s) => s.replace(/ /g, ' '); // keeps spacing in SVG text
const pc = (r) => `${Math.round(r * 100)}%`;
// An entry line with its amount right-aligned in the box (mono font: pad on the plain text; a Cr line is indented 13px ≈ 3 chars)
const jl = (acc, v) => { const p = acc.replace(/\{[a-z]\|([^}]+)\}/g, '$1'), w = acc.startsWith('Cr') ? 31 : 34;
  return nb(`${acc}${' '.repeat(Math.max(2, w - p.length - n0(v).length))}${n0(v)}`); };
function schedule(mode) {
  const cut = mode === 'cut';
  const curRate = (k) => (cut && k >= 2 ? 0.15 : 0.17); // current tax: the rate for that year's profit
  const dtRate = (k) => (cut && k >= 1 ? 0.15 : 0.17); // deferred tax at the end of year k: the rate enacted for the reversal
  const r0 = Math.round, dep = EX.cost / EX.life, ca = EX.cost / EX.caYears;
  const Y = [];
  let tb = EX.cost, open = 0, tdPrev = 0;
  for (let k = 0; k < EX.life; k++) {
    const a = k < EX.caYears ? ca : 0;
    tb -= a;
    const cv = EX.cost - dep * (k + 1), td = cv - tb, rc = curRate(k), rd = dtRate(k);
    const taxable = EX.profit + dep - a + EX.ent, current = r0(taxable * rc), dtl = r0(td * rd), move = dtl - open;
    const recon = r0(EX.profit * rc), entFx = r0(EX.ent * rc), total = current + move;
    const remeasure = open - r0(tdPrev * rd); // (a) the opening gap at the new rate (0 when the rate is unchanged)
    Y.push({ k, a, cv, tb, td, tdPrev, rc, rd, taxable, current, open, dtl, move, total, recon, entFx, rateFx: total - recon - entFx, remeasure, growth: move + remeasure });
    open = dtl; tdPrev = td;
  }
  if (EX.sales - EX.sal - dep - EX.ent !== EX.profit || EX.sales - EX.sal - ca !== Y[0].taxable) throw new Error('Lim: the bars do not add up');
  if (!cut && Y.some((y) => y.total !== 35020)) throw new Error('Lim: total tax expense should be 35,020 every year');
  if (cut && (Y[1].rateFx !== -400 || Y[1].remeasure !== 200 || Y[1].growth !== 1500 || Y[1].total !== 34620 || Y[2].rateFx || Y[3].rateFx)) throw new Error('Lim: rate-cut numbers do not tie');
  const focus = 1; // the year-end panels quote year 2
  return { mode, cut, dep, ca, Y, focus, F: Y[focus] };
}

