<body>
<main>
  <div class="topbar">
    <div class="eyebrow">B2.2 Income tax</div>
    <div class="mode" id="mode" role="group" aria-label="Tax rate">Tax rate
      <button data-m="base">17% throughout</button><button data-m="cut">cut to 15% from year 3 (enacted in year 2)</button></div>
  </div>
  <div class="fl-box" id="chart"></div>
  <div class="note" id="note" aria-live="polite"></div>
</main>
<script>
// Worked example behind every number, chart and year note: the study app's Lim Trading (apps/study/content/income-tax.js).
// One machine, cost $120,000: the books depreciate it over 4 years, tax law gives capital allowances over 3 years.
// Accounting profit $200,000 every year, after a non-deductible entertainment expense of $6,000. Whole dollars.
// The switch changes only the tax rate: 17% throughout, or cut to 15% from year 3 (enacted during year 2).
const EX = { cost: 120000, life: 4, caYears: 3, profit: 200000, ent: 6000,
  what: 'Lim Trading buys a machine for $120,000. The books depreciate it over 4 years ($30,000 a year); tax law gives capital allowances over 3 years ($40,000 a year). Accounting profit is $200,000 every year, after a $6,000 entertainment expense that tax law never allows.' };
const f1 = (n) => `${n < -0.5 ? '−' : ''}$${Math.abs(Math.round(n)).toLocaleString('en-US')}`; // money, whole dollars
const n0 = (n) => `${n < -0.5 ? '−' : ''}${Math.abs(Math.round(n)).toLocaleString('en-US')}`;
const nb = (s) => s.replace(/ /g, '\u00a0'); // keeps spacing in SVG text
const pc = (r) => `${Math.round(r * 100)}%`;
function schedule(mode) {
  const cut = mode === 'cut';
  const curRate = (k) => (cut && k >= 2 ? 0.15 : 0.17); // current tax: the rate for that year's profit
  const dtRate = (k) => (cut && k >= 1 ? 0.15 : 0.17); // deferred tax at the end of year k: the rate enacted for the reversal
  const r0 = Math.round, dep = EX.cost / EX.life, ca = EX.cost / EX.caYears;
  const Y = [];
  let tb = EX.cost, open = 0, tdPrev = 0;
  for (let k = 0; k < EX.life; k++) {
    const a = k < EX.caYears ? ca : 0;
    tb -= a;
    const cv = EX.cost - dep * (k + 1), td = cv - tb, rc = curRate(k), rd = dtRate(k);
    const taxable = EX.profit + dep - a + EX.ent, current = r0(taxable * rc), dtl = r0(td * rd), move = dtl - open;
    const recon = r0(EX.profit * rc), entFx = r0(EX.ent * rc), total = current + move;
    const remeasure = open - r0(tdPrev * rd); // the opening difference at the new rate (0 when the rate is unchanged)
    Y.push({ k, a, cv, tb, td, rc, rd, taxable, current, open, dtl, move, total, recon, entFx, rateFx: total - recon - entFx, remeasure, growth: move + remeasure });
    open = dtl; tdPrev = td;
  }
  if (!cut && Y.some((y) => y.total !== 35020)) throw new Error('Lim: total tax expense should be 35,020 every year');
  if (cut && (Y[1].rateFx !== -400 || Y[2].rateFx || Y[3].rateFx)) throw new Error('Lim: rate-cut reconciliation does not tie');
  const focus = cut ? 1 : 0; // the year the boxes quote
  return { mode, cut, dep, ca, Y, focus, F: Y[focus] };
}

// Section 1 is drawn at LEFT.scale, so its type comes out smaller. Boxes: x, y, w, h; arrows: SVG paths ending at the tip.
const LEFT = {
  at: [6, 40], scale: 0.86,
  nodes: [
    { id: 'item', x: 8, y: 8, w: 172, h: 38, k: 'q', t: 'An item in the accounts', sub: ['income or expense, under SFRS(I)'] },
    { id: 'q1', x: 8, y: 70, w: 172, h: 38, k: 'q', t: 'Does tax law count it?', sub: ['in taxable profit (Income Tax Act)'] },
    { id: 'same', x: 214, y: 8, w: 150, h: 40, k: 'yes', t: 'Same year, same amount', sub: ['no difference (sales, salaries)'] },
    { id: 'perm', x: 214, y: 70, w: 150, h: 52, k: 'no', t: 'Permanent difference', sub: ['never counted: a fine,', 'entertainment, exempt dividend'] },
    { id: 'permx', x: 214, y: 134, w: 150, h: 44, k: 'exit', t: 'No deferred tax', sub: ['only the effective rate moves', '→ the tax reconciliation'] },
    { id: 'temp', x: 8, y: 190, w: 172, h: 44, k: 'yes', t: 'Temporary difference', sub: ['counted in full, in another year'] },
    { id: 'two', x: 380, y: 190, w: 100, h: 44, k: 'gold', t: 'Book two taxes', sub: ['current + deferred'] },
    { id: 'vocab', x: 8, y: 254, w: 346, h: 96, k: 'info1', t: 'The words: what each one describes', list: true,
      sub: ['**taxable income** → tax law counts it (sales)', '**exempt income** → never counted (one-tier dividend)', '**deductible expense** → tax law subtracts it (salaries)', '**non-deductible expense** → never subtracted (fine, entertainment)', '**capital allowance** → tax law’s depreciation, on its own schedule'] },
  ],
  joins: [],
  edges: [
    { d: 'M94 46 V69' },
    { d: 'M180 80 C 197 80, 197 28, 213 28', lab: 'same year', lx: 201, ly: 58 },
    { d: 'M180 96 H213', lab: 'never', lx: 197, ly: 92, anchor: 'middle' },
    { d: 'M289 122 V133' },
    { d: 'M94 108 V189', lab: 'yes, another year', lx: 99, ly: 150 },
    { d: 'M180 212 H379' },
  ],
};

// Sections 2–5, at full size. Top lane: this year's tax. Bottom lane: deferred tax.
const right = (S) => {
  const F = S.F, yr = `year ${S.focus + 1}`;
  return {
