issuance_id:
  title: Issuance ID
  type: integer
  primary_key: true
  required: true
  nullable: false
  index: true
  description: Primary key for issuances table.
creation_time:
  title: Creation Time
  type: datetime
  required: false
  nullable: false
  default: now
  timezone: Asia/Singapore
  auto_now_add: true
  description: Singapore time the record was created.
project_name:
  title: Project Name
  type: string
  required: false
  nullable: true
  max_length: 256
  default: null
  description: Project name or deal codename as shown on the term sheet.
mandate:
  title: Mandate
  type: string
  required: false
  nullable: true
  max_length: 512
  default: null
  description: Mandate details or appointment context for the issuance.
program:
  title: Program
  type: string
  required: false
  nullable: true
  max_length: 128
  default: null
  description: Program name if issued under a program (e.g., EMTN, MTN).
issuer:
  title: Issuer
  type: string
  required: false
  nullable: true
  max_length: 256
  default: null
  description: Issuer entity name (may come from headers).
private_or_public:
  title: Private or Public
  type: string
  enum:
  - Private
  - Public
  required: false
  nullable: true
  default: null
  description: Whether the issuance is a private placement (offered to a limited group
    of investors) or a public offering (registered and offered broadly).
instrument_type:
  title: Instrument Type
  type: string
  enum:
  - Bond
  - Note
  - Bill
  - Certificate
  - Debenture
  required: false
  nullable: true
  default: null
  description: The category of security being issued. Bonds typically have longer
    maturities; notes are shorter- to medium-term; bills are short-term; certificates
    and debentures reflect different legal forms and seniority.
issuance_type:
  title: Issuance Type
  type: string
  enum:
  - Standalone
  - Program
  - Shelf
  required: false
  nullable: true
  default: null
  description: High-level issuance framework. Standalone is a one-off deal; Program
    indicates issuance under a documented platform (e.g., EMTN); Shelf indicates pre-registered
    securities offered over time.
currency:
  title: Currency
  type: string
  enum:
  - USD
  - EUR
  - SGD
  - JPY
  - CNY
  - GBP
  - AUD
  - CAD
  required: false
  nullable: true
  default: null
  description: Base currency context for the issuance record. This may differ from
    the denomination currency of the notes (see issuance_currency).
name_of_issuer:
  title: Name of Issuer
  type: string
  required: false
  nullable: true
  max_length: 256
  default: null
  description: Full legal name of the issuer as shown on the notes and legal docs.
status_of_notes:
  title: Status of Notes
  type: string
  enum:
  - Senior
  - Subordinated
  - Hybrid
  required: false
  nullable: true
  default: null
  description: Capital structure position of the notes. Senior ranks ahead of subordinated
    debt in liquidation; hybrid may have equity-like loss-absorption features.
form_of_note:
  title: Form of Note
  type: string
  enum:
  - Bearer
  - Registered
  - Book Entry
  required: false
  nullable: true
  default: null
  description: Legal form of the securities. Bearer instruments confer rights to the
    holder; registered are recorded to an owner; book-entry exists as electronic records
    with a depository.
issuance_type_detail:
  title: Issuance Type Detail
  type: string
  enum:
  - Standalone
  - Program
  - Shelf
  required: false
  nullable: true
  default: null
  description: More granular issuance type aligned to disclosure. Often mirrors Issuance
    Type unless additional sub-categories are required by the program or regulator.
method_of_distribution:
  title: Method of Distribution
  type: string
  enum:
  - Private Placement
  - Public Offering
  - Syndicated
  - Direct
  required: false
  nullable: true
  default: null
  description: Distribution approach/channels. Direct indicates issuer sells without
    intermediaries; syndicated involves a group of banks arranging and placing the
    securities.
name_of_dealers:
  title: Name of Dealers
  type: string
  required: false
  nullable: true
  max_length: 512
  default: null
  description: Names of dealer(s), placement agents, or underwriters participating
    in the offering.
lead_managers:
  title: Lead Managers
  type: string
  required: false
  nullable: true
  max_length: 512
  default: null
  description: Names of the lead manager(s) or lead underwriters coordinating the
    transaction and bookbuilding.
stabilizing_managers:
  title: Stabilizing Managers
  type: string
  required: false
  nullable: true
  max_length: 512
  default: null
  description: Parties appointed (if any) to conduct post-issuance price stabilization
    within regulatory limits.
related_party_list:
  title: Related Party List
  type: string
  required: false
  nullable: true
  max_length: 1024
  default: null
  description: Disclosures of any related parties involved (e.g., affiliates, directors)
    as required by regulation or internal policy.
issuance_amount:
  title: Issuance Amount
  type: number
  format: float
  required: false
  nullable: true
  default: null
  minimum: 0.0
  description: Aggregate principal amount (notional) of the issuance expressed in
    the denomination currency. Excludes fees and accrued amounts.
issuance_currency:
  title: Issuance Currency
  type: string
  enum:
  - USD
  - EUR
  - SGD
  - JPY
  - CNY
  - GBP
  - AUD
  - CAD
  required: false
  nullable: true
  default: null
  description: Currency in which the notes are denominated for purposes of principal
    and coupon calculations.
specified_denomination:
  title: Specified Denomination
  type: number
  format: float
  required: false
  nullable: true
  default: null
  minimum: 0.0
  description: Face value per security (par value) as specified in the terms (e.g.,
    200,000). Determines minimum holding amount.
integral_multiples:
  title: Integral Multiples
  type: number
  format: float
  required: false
  nullable: true
  default: null
  minimum: 0.0
  description: Minimum tradable increment above the specified denomination (e.g.,
    in multiples of 1,000). Used for settlement and transfers.
calculation_amount:
  title: Calculation Amount
  type: number
  format: float
  required: false
  nullable: true
  default: null
  minimum: 0.0
  description: Notional used to compute coupon amounts where specified (per calculation
    period). Defaults to the specified denomination if not otherwise defined.
coupon_type:
  title: Coupon Type
  type: string
  enum:
  - Fixed
  - Floating
  - Zero Coupon
  required: false
  nullable: true
  default: null
  description: Coupon structure. Fixed has a constant rate; Floating references an
    index plus/minus a margin; Zero Coupon is issued at a discount and accrues no
    periodic interest.
interest_rate_reference:
  title: Interest Rate Reference
  type: string
  required: false
  nullable: true
  max_length: 128
  default: null
  description: For floating-rate notes, the reference index/base rate (e.g., SOFR,
    SORA).
floating_margin:
  title: Floating Margin
  type: number
  format: float
  required: false
  nullable: true
  default: null
  description: Margin/spread (in percentage points) added to the reference rate for
    floating coupons. May be negative for inverse spread structures.
fixed_rate:
  title: Fixed Rate (%)
  type: number
  format: float
  required: false
  nullable: true
  default: null
  minimum: 0.0
  maximum: 100.0
  description: Annualized fixed coupon rate expressed as a percentage (0–100). Applied
    to the relevant notional basis per the terms.
listing:
  title: Listing
  type: string
  required: false
  nullable: true
  max_length: 256
  default: null
  description: Intended or actual listing venue/details (e.g., SGX, LSE) or "Unlisted"
    where applicable.
ratings:
  title: Ratings
  type: string
  enum:
  - AAA
  - AA
  - A
  - BBB
  - BB
  - B
  - Below B
  required: false
  nullable: true
  default: null
  description: Credit rating bucket applicable to the issuer or the specific notes,
    normalized to a standard scale for comparison.
issuance_mapping_type:
  title: Issuance Mapping Type
  type: string
  enum:
  - A
  - B
  - C
  - D
  - E
  - F
  - G
  - H
  - I
  - J
  - K
  - L
  - M
  - N
  - O
  required: false
  nullable: true
  default: null
  description: Derived workflow mapping type used to initialize and track activity
    checklists across the deal lifecycle.
