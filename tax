#!/usr/bin/env python3
import os, base64

DIRS = ['data', 'data/audio', 'processes', 'processes/cit-schedule-preparation']

FILES = {
    'data/audio/2026-05-13.txt': '',
    'processes/cit-schedule-preparation/dummy.md': '',
    'processes/cit-schedule-preparation/gaps.md': '',
    'processes/cit-schedule-preparation/summary.md': '',
}

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
