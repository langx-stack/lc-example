#!/usr/bin/env python3
import os, base64

DIRS = ['meeting', 'meeting/transcript', 'processes', 'processes/cit-schedule-preparation']

FILES = {
    'make_summary_docx.py': '',
    'meeting/2026-05-28__Business-Audrey__tax-adjustments__summary.docx': '',
    'meeting/2026-05-28__Business-Audrey__tax-adjustments__summary.md': '',
    'meeting/transcript/2026-05-13__Business-Audrey__CIT-schedule-overview.txt': '',
    'meeting/transcript/2026-05-28__Business-Audrey__tax-adjustments.txt': '',
    'processes/cit-schedule-preparation/dummy.md': '',
    'processes/cit-schedule-preparation/gaps.md': '',
    'processes/cit-schedule-preparation/summary.md': '',
}

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
