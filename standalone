y=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">can each be used\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"259.65\" y=\"-175.22\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">on its own?\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>done&#45;&gt;parts\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M161.77,-276.42C185.37,-260.36 217.47,-238.51 243.26,-220.96\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"244.31,-222.78 248.09,-217.67 241.95,-219.31 244.31,-222.78\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"245.15\" y=\"-246.56\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> yes, or a part is \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>each\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M249.67,-111.28C249.67,-111.28 160.39,-111.28 160.39,-111.28 154.39,-111.28 148.39,-105.28 148.39,-99.28 148.39,-99.28 148.39,-85.64 148.39,-85.64 148.39,-79.64 154.39,-73.64 160.39,-73.64 160.39,-73.64 249.67,-73.64 249.67,-73.64 255.67,-73.64 261.67,-79.64 261.67,-85.64 261.67,-85.64 261.67,-99.28 261.67,-99.28 261.67,-105.28 255.67,-111.28 249.67,-111.28\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"157.03\" y=\"-97.51\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Cease part by part\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"175.4\" y=\"-88.41\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">business park:\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"157.4\" y=\"-79.41\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">each block as it is done\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>parts&#45;&gt;each\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M260.86,-158.62C249.4,-145.25 236.15,-129.78 225.43,-117.28\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"227.19,-116.1 221.69,-112.9 224,-118.83 227.19,-116.1\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"249.56\" y=\"-126.03\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> yes \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>whole\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M395.42,-111.28C395.42,-111.28 298.64,-111.28 298.64,-111.28 292.64,-111.28 286.64,-105.28 286.64,-99.28 286.64,-99.28 286.64,-85.64 286.64,-85.64 286.64,-79.64 292.64,-73.64 298.64,-73.64 298.64,-73.64 395.42,-73.64 395.42,-73.64 401.42,-73.64 407.42,-79.64 407.42,-85.64 407.42,-85.64 407.42,-99.28 407.42,-99.28 407.42,-105.28 401.42,-111.28 395.42,-111.28\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"295.28\" y=\"-97.51\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Cease for the whole\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"303.15\" y=\"-88.41\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">steel mill: when every\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"301.28\" y=\"-79.41\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">linked process is done\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>parts&#45;&gt;whole\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M307.51,-156.5C315.42,-143.89 324.31,-129.71 331.65,-118\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"333.34,-119.25 334.75,-113.05 329.78,-117.02 333.34,-119.25\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"335.87\" y=\"-126.03\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> no \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>after\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M335.42,-46.64C335.42,-46.64 214.64,-46.64 214.64,-46.64 208.64,-46.64 202.64,-40.64 202.64,-34.64 202.64,-34.64 202.64,-12 202.64,-12 202.64,-6 208.64,0 214.64,0 214.64,0 335.42,0 335.42,0 341.42,0 347.42,-6 347.42,-12 347.42,-12 347.42,-34.64 347.42,-34.64 347.42,-40.64 341.42,-46.64 335.42,-46.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"235.28\" y=\"-32.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">After cessation\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"233.78\" y=\"-23.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">new interest → P&amp;L;\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"211.28\" y=\"-14.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">capitalised interest depreciated\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"247.28\" y=\"-5.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">with the asset\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>each&#45;&gt;after\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M224.16,-73.11C230.93,-66.62 238.72,-59.15 246.12,-52.05\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"247.2,-53.92 250.08,-48.25 244.3,-50.89 247.2,-53.92\"/>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>whole&#45;&gt;after\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M327.36,-73.11C320.39,-66.62 312.38,-59.15 304.76,-52.05\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"306.5,-50.79 300.68,-48.24 303.63,-53.86 306.5,-50.79\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"derecognise","lo":44,"title":"After cessation: the interest comes back","html":"\u003cp>What happens to capitalised interest once the asset is ready? It stays in \u003cspan class=\"el el-a\">cost\u003c/span> and is depreciated with everything else. Two panels, the same building: on the left its interest is capitalised while it is built; on the right the interest is expensed instead. Watch the extra layer, then the bigger \u003cspan class=\"el el-x\">depreciation\u003c/span>.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"bd-c2\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;Qualifying: capitalise&quot;,&quot;sub&quot;:&quot;interest joins the cost&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Building&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;Two years to build, so the building is a qualifying asset.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;construction&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:3000000,&quot;cap&quot;:&quot;20X1: contractors paid {a|3,000,000}, so {a|3,000,000}.&quot;},{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:400000,&quot;cap&quot;:&quot;5,000,000 × 8% = {x|400,000} of interest is capitalised: {a|3,400,000}.&quot;}],&quot;hold&quot;:&quot;&quot;},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;construction&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:3000000,&quot;cap&quot;:&quot;20X2: contractors paid {a|3,000,000}, so {a|6,400,000}.&quot;},{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:400000,&quot;cap&quot;:&quot;5,000,000 × 8% = {x|400,000} of interest is capitalised: {a|6,800,000}.&quot;}],&quot;hold&quot;:&quot;&quot;},{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-680000,&quot;cap&quot;:&quot;20X3: in use. {x|Depreciation} = {a|6,800,000} ÷ 10 = {x|680,000}, so {a|6,120,000}.&quot;}]},{&quot;label&quot;:&quot;20X4&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-680000,&quot;cap&quot;:&quot;20X4: in use. {x|Depreciation} = {a|6,800,000} ÷ 10 = {x|680,000}, so {a|5,440,000}.&quot;}]}]},{&quot;title&quot;:&quot;If it were expensed&quot;,&quot;sub&quot;:&quot;interest straight to P&amp;L&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Building&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;The same building, if its interest were simply expensed.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;construction&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:3000000,&quot;cap&quot;:&quot;20X1: contractors paid {a|3,000,000}, so {a|3,000,000}.&quot;}],&quot;hold&quot;:&quot;20X1: the {x|400,000} interest went to {x|Interest expense}, so nothing joins the {a|building}.&quot;},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;construction&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:3000000,&quot;cap&quot;:&quot;20X2: contractors paid {a|3,000,000}, so {a|6,000,000}.&quot;}],&quot;hold&quot;:&quot;20X2: the {x|400,000} interest went to {x|Interest expense}, so nothing joins the {a|building}.&quot;},{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-600000,&quot;cap&quot;:&quot;20X3: in use. {x|Depreciation} = {a|6,000,000} ÷ 10 = {x|600,000}, so {a|5,400,000}.&quot;}]},{&quot;label&quot;:&quot;20X4&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-600000,&quot;cap&quot;:&quot;20X4: in use. {x|Depreciation} = {a|6,000,000} ÷ 10 = {x|600,000}, so {a|4,800,000}.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;A $5,000,000 {l|loan} at 8% funds a building that takes two years; it is ready on 31 Dec 20X2 and has a 10-year life. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Construction spending builds up the {a|building} in both panels.&quot;,&quot;Interest: added to the cost on the left only.&quot;],&quot;end&quot;:&quot;**Capitalised interest isn’t free, just delayed.** The left building costs {a|6,800,000}, not {a|6,000,000}. The 800,000 of interest reaches P&amp;L later, as an extra {x|80,000} of depreciation every year for 10 years.&quot;}}\">\u003c/div>","id":"visual-5ieytj","sect":4,"part":"Derecognise / transfer"},{"id":"je-z27z37","type":"je","bucket":"derecognise","lo":44,"q":"Harbourfront Mall Pte Ltd builds a shopping mall with {l|general borrowings}, which cost $900,000 in 20X3, all debited to {x|Interest expense} when paid. Capitalisation rate 6%. $12,000,000 of spending on the mall was outstanding from 1 January until the mall was substantially complete on 30 September. Record the year-end entry.","accounts":["Building under construction","Asset under construction","Cash","Bank loan","Interest payable","Interest expense","Investment income","Depreciation expense","Retained earnings"],"lines":[{"side":"Dr","account":"Building under construction","amount":540000},{"side":"Cr","account":"Interest expense","amount":540000}],"why":"Weighted spend = 12,000,000 × 9/12 = 9,000,000; × 6% = 540,000. Only 9 months count: capitalisation ceased on 30 September. A full year would give 720,000.","sect":4,"part":"Derecognise / transfer"},{"type":"mcq","bucket":"derecognise","lo":44,"q":"A developer builds a business park of three office blocks with borrowed funds. Block A is finished on 30 April and tenants move in, while Blocks B and C are still being built. What happens to borrowing costs?","options":[{"t":"Keep capitalising for all three blocks until the whole park is finished","why":"Block A can be used on its own, so its capitalisation stops when it is complete."},{"t":"Stop capitalising for Block A from 30 April; continue for B and C","ok":true,"why":"Each block can be used while the others are built, so capitalisation ceases part by part."},{"t":"Stop capitalising for all three from 30 April","why":"B and C are still under active development, so their borrowing costs are still capitalised."},{"t":"Expense everything from the start, because the park is built in parts","why":"Each block is still a qualifying asset. Building in parts only changes when capitalisation ceases."}],"id":"mcq-wuif9k","sect":4,"part":"Derecognise / transfer"},{"type":"map","id":"map-5-present","bucket":"present","sect":5,"part":"Present & disclose"},{"id":"think-pmxw2h","type":"think","bucket":"present","lo":44,"scenario":"An analyst compares two Singapore developers. Both report modest {x|finance costs}, but one has been building a huge project with borrowed money for three years.","prompt":"Where has its interest gone, and what would the analyst want the notes to say?","answer":["Much of it is sitting in the {a|project’s **cost**} on the balance sheet, not in profit or loss. It will reach P&L later, through {x|depreciation} (or {x|cost of sales}, for {a|inventory}).","So the analyst wants to know **how much** interest was capitalised this year, and at **what rate**. The notes must say both."],"sect":5,"part":"Present & disclose"},{"type":"rule","bucket":"present","lo":44,"title":"Presentation and disclosure","body":["Capitalised interest is hidden inside an asset’s cost, which makes {x|finance costs} look smaller. Disclosure exists so readers can see how much was moved and at what rate.","- **Balance sheet:** capitalised interest is not a separate asset. It is part of the cost of the qualifying asset ({a|PPE}, {a|investment property}, {a|intangibles} or {a|inventory}).","- **Profit or loss:** borrowing costs that are not capitalised are shown in {x|finance costs}.","Disclose:","1. the **amount of borrowing costs capitalised** during the period","2. the **capitalisation rate** used to work out the amount eligible for capitalisation"],"id":"rule-7bdyl1","sect":5,"part":"Present & disclose"},{"type":"mcq","bucket":"present","lo":44,"q":"An entity capitalised borrowing costs on a factory under construction this year. Which disclosure does SFRS(I) 1-23 require?","options":[{"t":"The interest rate on every loan the entity holds","why":"Not required by SFRS(I) 1-23. It asks for the capitalisation rate, not every loan’s rate."},{"t":"The amount capitalised in the period and the capitalisation rate used","ok":true,"why":"Exactly the two disclosures the standard asks for."},{"t":"The {x|finance cost} the entity would have reported had it expensed everything","why":"A hypothetical figure the standard doesn’t ask for."},{"t":"Nothing, because capitalised interest is part of the {a|factory’s cost}","why":"It is part of cost, but users still need the amount and the rate to understand it."}],"id":"mcq-6glwyi","sect":5,"part":"Present & disclose"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":6,"part":"Wrap-up"},{"type":"summary","lo":44,"title":"Borrowing costs on one page","rows":[["Qualifying asset?","Necessarily takes a substantial period of time to get ready for use or sale. Not ready-to-use assets, {a|financial assets}, or quick or mass-produced {a|inventory}."],["Borrowing costs?","Interest (effective interest method), interest on {l|lease liabilities}, FX differences that adjust interest. Not the cost of {e|equity}."],["Capitalise or expense?","Directly attributable costs on a qualifying asset **must** be capitalised. All others are expensed. No policy choice."],["Start?","When expenditure, borrowing costs and activities are **all** under way."],["Suspend?","Extended periods with no active development. Not for normal or necessary delays."],["Stop?","When substantially all the work is complete (part by part if parts are usable on their own)."],["Specific loan?","Actual borrowing costs − {i|investment income} on the unspent funds."],["General loans?","Weighted-average rate × time-weighted spend, capped at actual costs."],["Afterwards?","Capitalised interest is part of {a|cost}, depreciated with the asset. New interest → {x|Interest expense}."],["Disclose?","Amount capitalised in the period and the capitalisation rate."]],"id":"summary-o5h452","bucket":"wrap","sect":6,"part":"Wrap-up"}],"quiz":{"cases":{"ruby":{"name":"Ruby Enterprises","source":"Official practice paper (Q16–20 case, vault loan paragraph only)","text":["Ruby Enterprises Pte Ltd (Ruby) is a jewellery wholesaler based in Orchard Towers. Ruby has a financial year ending 31 December 20X7.","On 1 January 20X7, Ruby took up a bank loan for $275,000 to pay for the construction of a high security vault to store its inventory. Construction began immediately and took 9 months with the vault ready for use on 30 September 20X7. Interest on the loan is 5.5% per annum, payable annually."]},"marina":{"name":"Marina Shipworks","text":["Marina Shipworks Pte Ltd (Marina) has a 31 December year end. On 1 January 20X5 it starts building a ferry for its own passenger service. The build is expected to take 18 months.","Marina has no loan specifically for the ferry. Its general borrowings, outstanding all year, are a {l|bank loan} of $8,000,000 at 6% and {l|bonds} of $12,000,000 with an effective interest rate of 4%.","Spending on the ferry in 20X5: $5,000,000 on 1 January, $6,000,000 on 1 May and $8,000,000 on 1 October. Work is active throughout the year."]}},"questions":[{"id":"q1","case":"ruby","lo":44,"type":"period","source":"Official practice paper Q16","q":"With reference to SFRS(I)1-23, Borrowing Costs, identify how Ruby should account for borrowing costs as at 31 December 20X7?","options":[{"t":"Ruby should capitalise $15,125 of borrowing costs as at 31 December 20X7","pit":"whole-year","why":"275,000 × 5.5% = 15,125 is the whole year’s interest. The vault was ready on 30 September, so capitalisation ceased then."},{"t":"Ruby should expense $15,125 of borrowing costs as at 31 December 20X7","pit":"expense-all","why":"The vault took 9 months to build, so it is a qualifying asset. Its directly attributable interest during construction must be capitalised."},{"t":"Ruby should capitalise $11,344 of borrowing costs and expense the remaining $3,781 as at 31 December 20X7","ok":true,"why":"Capitalise the 9 months of construction: 15,125 × 9/12 = 11,344. The last 3 months, after the vault was ready, are expensed: {x|3,781}. (\"As at 31 December\" just means \"for the year ended\".)"},{"t":"Ruby should only capitalise borrowing costs once the loan has been fully repaid","why":"Repayment has nothing to do with it. Capitalisation runs from commencement to when the asset is substantially complete."}]},{"id":"q2","case":"ruby","lo":43,"type":"qualifying","q":"Why is Ruby’s vault a qualifying asset?","options":[{"t":"Because it was paid for with a {l|bank loan}","why":"Any asset can be bought with borrowed money. What matters is whether it takes a substantial period to get ready."},{"t":"Because it necessarily took a substantial period (9 months) to build before it was ready for use","ok":true,"why":"That is the definition of a qualifying asset."},{"t":"Because it is used to store {a|inventory}","pit":"not-qualifying","why":"Its purpose doesn’t decide it. The time needed to get it ready does."},{"t":"Because its cost is more than $250,000","why":"There is no size test. A cheap asset that takes a long time to build can still qualify."}]},{"id":"q3","case":"ruby","lo":44,"type":"period","q":"Ruby pays the year’s interest on 31 December 20X7. Which journal entry records it?","options":[{"je":[{"side":"Dr","account":"Vault (PPE)","amount":15125,"el":"a"},{"side":"Cr","account":"Cash","amount":15125,"el":"a"}],"pit":"whole-year","why":"Capitalises the whole year, including the 3 months after the vault was ready."},{"je":[{"side":"Dr","account":"Vault (PPE)","amount":11344,"el":"a"},{"side":"Dr","account":"Interest expense","amount":3781,"el":"x"},{"side":"Cr","account":"Cash","amount":15125,"el":"a"}],"ok":true,"why":"11,344 for January to September goes into the {a|vault’s cost}; 3,781 for October to December is an {x|expense}."},{"je":[{"side":"Dr","account":"Interest expense","amount":15125,"el":"x"},{"side":"Cr","account":"Cash","amount":15125,"el":"a"}],"pit":"expense-all","why":"The vault is a qualifying asset, so its construction-period interest must be capitalised."},{"je":[{"side":"Dr","account":"Vault (PPE)","amount":3781,"el":"a"},{"side":"Dr","account":"Interest expense","amount":11344,"el":"x"},{"side":"Cr","account":"Cash","amount":15125,"el":"a"}],"why":"The right amounts on the wrong lines: the 9 construction months go to the asset, the 3 later months to expense."}]},{"id":"q4","case":"ruby","lo":44,"type":"specific","q":"Suppose Ruby kept part of the {l|loan} on {a|deposit} until each contractor invoice fell due, earning $1,200 of {i|interest} during construction. How much should Ruby capitalise for 20X7?","options":[{"t":"$11,344","pit":"no-income-deduct","why":"Ignores the {i|deposit income}. For a specific loan, {i|investment income} on unspent funds is deducted."},{"t":"$10,144","ok":true,"why":"11,344 − 1,200 = 10,144. The loan was taken specifically for the vault, so the {i|income} earned on its unspent funds reduces the amount capitalised."},{"t":"$12,544","why":"The {i|deposit income} reduces the cost of borrowing; it is not added to it."},{"t":"$13,925","pit":"whole-year","why":"Nets the income off correctly, but against the whole year’s interest. Capitalisation ceased on 30 September."}]},{"id":"q5","case":"ruby","lo":44,"type":"suspension","q":"Suppose work on the vault had stopped for 2 months in April and May 20X7 because of a dispute with the contractor, and the vault was still ready on 30 September. How much interest would Ruby capitalise for 20X7?","options":[{"t":"$11,344","pit":"no-suspend","why":"An extended halt caused by a dispute is not a necessary part of building: those 2 months are suspended."},{"t":"$8,823","ok":true,"why":"9 months less 2 suspended = 7 months. 15,125 × 7/12 = 8,823; the other 6,302 is expensed."},{"t":"$15,125","pit":"whole-year","why":"Capitalises the whole year, ignoring both the suspension and the cessation on 30 September."},{"t":"Nil: the dispute means the vault is no longer a qualifying asset","why":"A halt suspends capitalisation for that period only. The vault is still a qualifying asset."}]},{"id":"q6","case":"marina","lo":44,"type":"general","q":"What capitalisation rate should Marina use for 20X5?","options":[{"t":"5%","pit":"simple-avg-rate","why":"A simple average of 6% and 4%. The rate must be weighted by the size of each borrowing."},{"t":"4.8%","ok":true,"why":"(480,000 + 480,000) ÷ 20,000,000 = 4.8%."},{"t":"6%","why":"Uses only the {l|bank loan}’s rate. The ferry is funded from the whole general pool."},{"t":"4%","why":"Uses only the {l|bonds}’ rate. The ferry is funded from the whole general pool."}]},{"id":"q7","case":"marina","lo":44,"type":"general","q":"How much borrowing cost should Marina capitalise into the ferry for 20X5?","options":[{"t":"$912,000","pit":"no-time-weight","why":"19,000,000 × 4.8%: treats every dollar as spent on 1 January. Weight each amount by the months it was outstanding."},{"t":"$550,000","pit":"simple-avg-rate","why":"Right weighted spend, but a simple-average rate."},{"t":"$528,000","ok":true,"why":"Weighted spend = 5,000,000 + 6,000,000 × 8/12 + 8,000,000 × 3/12 = 11,000,000. × 4.8% = 528,000, below the actual 960,000, so no cap."},{"t":"$960,000","pit":"capitalise-all","why":"That is all the interest on the {l|general pool}. Only the part attributable to the ferry’s spending is capitalised."}]},{"id":"q8","case":"marina","lo":44,"type":"general","q":"What {x|finance cost} does Marina show in profit or loss for 20X5?","options":[{"t":"$960,000","pit":"expense-all","why":"Expenses everything, ignoring the amount capitalised into the ferry."},{"t":"$432,000","ok":true,"why":"960,000 − 528,000 capitalised = {x|432,000}."},{"t":"Nil","pit":"capitalise-all","why":"Only the part of the pool’s cost attributable to the ferry is capitalised; the rest is an {x|expense}."},{"t":"$48,000","pit":"no-time-weight","why":"Built on a capitalised amount that ignores when the money was spent."}]},{"id":"q9","case":"marina","lo":44,"type":"cessation","q":"The ferry passes its sea trials and is substantially complete on 30 June 20X6. A few cabin fittings are finished in July, and it carries its first paying passengers on 1 September 20X6. When does Marina stop capitalising borrowing costs?","options":[{"t":"30 June 20X6","ok":true,"why":"Capitalisation ceases when substantially all the work to get the asset ready is complete. Minor finishing doesn’t extend it."},{"t":"When the cabin fittings are finished in July 20X6","why":"Minor modifications don’t keep the window open."},{"t":"1 September 20X6, when the ferry enters service","pit":"wait-for-use","why":"Ready, not in use, is the test."},{"t":"When the {l|general borrowings} are repaid","why":"The {l|loans’} repayment dates have nothing to do with when the asset is ready."}]},{"id":"q10","case":"marina","lo":43,"type":"qualifying","q":"In 20X5 Marina also uses its general borrowings to buy ready-to-use forklifts for the shipyard. How are the borrowing costs on that spending treated?","options":[{"t":"Capitalised into the forklifts at the capitalisation rate","pit":"not-qualifying","why":"The forklifts are ready for use when bought: not a qualifying asset."},{"t":"Expensed as incurred, because the forklifts are not a qualifying asset","ok":true,"why":"No substantial period to get them ready, so there is nothing to capitalise."},{"t":"Capitalised into the ferry instead, since they come from the same pool","why":"Only spending on the ferry is weighted into its capitalised amount."},{"t":"Capitalised only if Marina’s accounting policy allows it","pit":"optional","why":"SFRS(I) 1-23 offers no policy choice, and these aren’t qualifying assets anyway."}]},{"id":"q11","lo":43,"type":"core-principle","source":"Official practice paper Q9","q":"SFRS(I) 1-23, Borrowing Costs, sets out the treatment of borrowing costs. Identify which of the following statements best describes the requirements of the standard?","options":[{"t":"Borrowing costs directly attributable to the acquisition, construction or production of a qualifying asset must be capitalised.","ok":true,"why":"That is the core principle. All other borrowing costs are expensed."},{"t":"Borrowing costs related to the acquisition, construction or production of a qualifying asset must be expensed as and when they occur.","pit":"expense-all","why":"The opposite of the rule: directly attributable costs on a qualifying asset are capitalised."},{"t":"Borrowing costs directly attributable to the acquisition, construction or production of a qualifying asset should only be capitalised if this is in line with the company’s accounting policies.","pit":"optional","why":"Capitalisation is required. There is no policy choice."},{"t":"All borrowing costs should be capitalised regardless of what they relate to.","pit":"capitalise-all","why":"Only those directly attributable to a qualifying asset. Everything else is expensed."}]},{"id":"q12","lo":43,"type":"qualifying","q":"Which of these is a qualifying asset?","options":[{"t":"Canned drinks produced in large quantities every day","pit":"not-qualifying","why":"{a|Inventory} made in large quantities on a repetitive basis: the standard need not be applied."},{"t":"An office block being built over two years, to be leased out as {a|investment property}","ok":true,"why":"{a|Investment property} under construction necessarily takes a substantial period to get ready."},{"t":"A portfolio of {a|listed shares} bought with a {l|bank loan}","pit":"not-qualifying","why":"{a|Financial assets} are never qualifying assets."},{"t":"A delivery van bought ready to drive","pit":"not-qualifying","why":"Ready for use when acquired."}]},{"id":"q13","lo":43,"type":"what-is-bc","q":"Which of the following is NOT a borrowing cost under SFRS(I) 1-23?","options":[{"t":"Interest on a {l|bank loan}, worked out with the effective interest method","why":"A borrowing cost."},{"t":"Interest on {l|lease liabilities}","why":"A borrowing cost."},{"t":"Exchange differences on a foreign-currency {l|loan}, to the extent they adjust the interest cost","why":"A borrowing cost, to that extent."},{"t":"{e|Dividends} paid on ordinary shares","ok":true,"why":"A distribution to owners, not a cost of borrowing funds."}]},{"id":"q14","lo":44,"type":"suspension","q":"A company is building a factory with a specific loan. Which situation requires it to suspend capitalisation?","options":[{"t":"Work pauses for two weeks while the floor slab cures, as planned","pit":"suspend-normal","why":"A necessary part of the process: carry on capitalising."},{"t":"Engineers are busy obtaining fire-safety approvals while no physical building takes place","pit":"suspend-normal","why":"Substantial technical and administrative work counts as active development."},{"t":"Construction stops for four months while the company hunts for a new contractor after the first one went bust","ok":true,"why":"An extended period with no active development: suspend, and expense the interest for those months."},{"t":"The project runs two weeks behind schedule because of a late steel delivery, with work continuing on other parts","why":"Work is still active, so there is nothing to suspend."}]},{"id":"q15","lo":44,"type":"period","q":"Bukit Homes draws a {l|loan} on 1 February to build a condominium for sale. It buys the {a|land} on 1 March, starts design and permit work on 1 April, and breaks ground on 1 June. From what date does capitalisation commence?","options":[{"t":"1 February, when the {l|loan} is drawn","pit":"whole-year","why":"Borrowing costs alone don’t start the clock: expenditure and activities are needed too."},{"t":"1 March, when the {a|land} is bought","why":"Merely holding {a|land}, with no development activity, does not start capitalisation."},{"t":"1 April, when design and permit work begins","ok":true,"why":"By then all three conditions are met: expenditure (the {a|land}), borrowing costs (the {l|loan}) and activities (technical and administrative work before construction)."},{"t":"1 June, when construction starts on site","why":"Activities include technical and administrative work before physical construction, such as obtaining permits."}]}]},"exam":{"cases":{"helix":{"name":"Helix Bio","source":"Official practice paper (Q46–50 case)","text":["Helix Bio Pte Ltd (Helix) is a biotechnology company that specialises in developing gene therapies for genetic blood disorders such as sickle cell anaemia and haemophilia. Helix has developed a gene therapy which is due to enter the final stage of clinical trials. The final stage is required before the therapy is approved for public use. To fund the purchase of specialised, ready-to-use lab equipment needed for the final stage of the trial, Helix issued a bond for S$6 million. The details of the bond issue are:","• $6,000,000 of 12% bonds","• Issued on 1 January 20X5","• Interest is payable twice a year on 30 June and 31 December","• Maturity date is 31 December 20X8","• Market yield for bonds of similar risk and maturity is 10%"]},"jurong":{"name":"Jurong Precision","text":["Jurong Precision Pte Ltd (Jurong) has a 31 December year end. On 1 January 20X3 it starts building a new factory, a qualifying asset. Work is active throughout 20X3.","On 1 January 20X3 Jurong took out a $10,000,000 {l|loan} at 6%, specifically for the factory. Until each invoice fell due, the unspent loan funds were held on {a|deposit}, earning $120,000 in 20X3. All interest was debited to {x|Interest expense} when paid, and the deposit income was credited to {i|Investment income}.","Jurong’s {l|general borrowings}, outstanding all year, are $15,000,000 at 5% and $5,000,000 at 9%. Once the specific loan was used up, Jurong spent a further $4,000,000 from its general funds on the factory on 1 July 20X3.","In 20X4, work paused for 3 weeks in February while the floor slab cured, as planned in the build schedule. The factory was substantially complete on 31 March 20X4 and started production on 1 June 20X4. The specific loan was still outstanding at 31 December 20X4."]}},"questions":[{"id":"x1","case":"helix","lo":44,"type":"qualifying","source":"Official practice paper Q49","q":"With reference to SFRS(I)1-23, Borrowing Costs, identify how Helix should treat the bond issue costs in their financial statements?","options":[{"t":"The bond issue costs should be capitalised as part of the cost of the lab equipment and depreciated over the useful life of the equipment","pit":"not-qualifying","why":"The lab equipment is ready to use when bought, so it is not a qualifying asset. Nothing is capitalised into it under SFRS(I) 1-23."},{"t":"The bond issue costs should be expensed to the Statement of profit or loss in the period in which they are incurred","ok":true,"why":"The best of the four. With no qualifying asset, the bond’s borrowing costs (issue costs included) are not capitalised: they end up in profit or loss. Strictly, under SFRS(I) 9 the issue costs are deducted from the {l|bond liability} and reach P&L through the effective interest over the bond’s life, but none of the options says that."},{"t":"The bond issue costs should be capitalised and amortised over the length of the final stage of the clinical trial","why":"There is no asset to capitalise them into: a clinical trial is not a qualifying asset, and the equipment is ready to use."},{"t":"The bond issue costs should only be recognised at the end of the trial","why":"There is no basis for deferring them to the end of the trial."}]},{"id":"x2","case":"helix","lo":43,"type":"qualifying","q":"Why does SFRS(I) 1-23 not allow Helix to capitalise any of the bond’s interest into the lab equipment?","options":[{"t":"Because the {l|bond} was issued at a premium","why":"Premium or discount changes the effective interest, not whether it can be capitalised."},{"t":"Because the equipment is ready for use when acquired, so it is not a qualifying asset","ok":true,"why":"No substantial period to get it ready, so its borrowing costs are expensed."},{"t":"Because Helix chose to expense borrowing costs as its accounting policy","pit":"optional","why":"There is no policy choice under SFRS(I) 1-23."},{"t":"Because the {l|bond} is payable in instalments of interest twice a year","why":"Payment frequency is irrelevant."}]},{"id":"x3","case":"helix","lo":44,"type":"what-is-bc","q":"Suppose instead that the bond had funded a manufacturing plant that was under active construction for the whole of the first half of 20X5. Ignoring issue costs, the bond’s initial {l|carrying amount} is its present value at the 10% market yield, $6,387,793. How much borrowing cost is capitalised for the six months to 30 June 20X5?","options":[{"t":"$360,000","pit":"coupon-not-eir","why":"That is the coupon {a|cash} (6,000,000 × 12% × 6/12). Borrowing costs are measured with the effective interest method."},{"t":"$319,390","ok":true,"why":"Effective interest = 6,387,793 × 10% × 6/12 = 319,390. The premium amortisation reduces the cost below the coupon."},{"t":"$300,000","why":"Applies the market yield to the face value. Effective interest is charged on the {l|carrying amount}."},{"t":"$383,268","pit":"coupon-not-eir","why":"Applies the coupon rate to the {l|carrying amount}. Use the effective rate."}]},{"id":"x4","case":"helix","lo":44,"type":"suspension","q":"Suppose instead that the bond had funded a manufacturing plant that takes several years to build (a qualifying asset). In 20X6 construction stops for five months because Helix runs short of {a|cash} to pay the contractor. How are the bond’s borrowing costs for those five months treated?","options":[{"t":"Capitalised as normal: the plant is still a qualifying asset","pit":"no-suspend","why":"An extended halt in active development suspends capitalisation."},{"t":"Expensed: capitalisation is suspended during the extended halt, and resumes when active work restarts","ok":true,"why":"A {a|cash} shortage is not a necessary part of building the plant. Suspend for the five months."},{"t":"Expensed, and the interest capitalised before the halt is reversed to profit or loss","why":"Suspension only affects the halt period. Amounts already capitalised stay in {a|cost}."},{"t":"Capitalised, but disclosed separately as \"idle-period interest\"","why":"There is no such category. Interest in an extended halt is expensed."}]},{"id":"x5","case":"helix","lo":44,"type":"disclosure","q":"Suppose instead that the bond had funded a manufacturing plant under construction (a qualifying asset), and Helix had capitalised borrowing costs on it. What would SFRS(I) 1-23 require it to disclose?","options":[{"t":"The amount of borrowing costs capitalised in the period and the capitalisation rate used","ok":true,"why":"The two disclosures the standard requires."},{"t":"The coupon rate and the market yield on the bond only","why":"Those are bond terms, not the borrowing-cost disclosures."},{"t":"Nothing, because capitalised interest is part of the {a|plant’s cost}","pit":"no-disclose","why":"Users still need the amount capitalised and the rate."},{"t":"The profit Helix would have reported had it expensed all borrowing costs","why":"A hypothetical figure the standard doesn’t ask for."}]},{"id":"x6","case":"jurong","lo":44,"type":"specific","q":"How much should Jurong capitalise for 20X3 in respect of the specific loan?","options":[{"t":"$600,000","pit":"no-income-deduct","why":"Ignores the {i|deposit income} on the unspent funds."},{"t":"$480,000","ok":true,"why":"10,000,000 × 6% = 600,000, less {i|investment income} 120,000 = 480,000."},{"t":"$720,000","why":"{i|Investment income} reduces the amount capitalised; it isn’t added."},{"t":"$300,000","why":"Half a year’s interest, as if only the spent half of the {l|loan} counted. The whole loan’s interest in the window counts; the unspent funds are dealt with by deducting what they earned."}]},{"id":"x7","case":"jurong","lo":44,"type":"general","q":"How much should Jurong capitalise for 20X3 in respect of its general borrowings?","options":[{"t":"$240,000","pit":"no-time-weight","why":"4,000,000 × 6% treats the spend as outstanding all year. It was spent on 1 July: weight it 6/12."},{"t":"$140,000","pit":"simple-avg-rate","why":"Uses a simple average rate of 7%. Weight by the size of each loan."},{"t":"$120,000","ok":true,"why":"Rate = 1,200,000 ÷ 20,000,000 = 6%. Weighted spend = 4,000,000 × 6/12 = 2,000,000. × 6% = 120,000."},{"t":"Nil: the factory already has a specific loan","why":"Spending beyond the specific loan is funded from the {l|general pool}, so that part gets the general-borrowings treatment."}]},{"id":"x8","case":"jurong","lo":44,"type":"general","q":"What is Jurong’s {x|finance cost} in profit or loss for 20X3, after all capitalisation entries?","options":[{"t":"$1,800,000","pit":"expense-all","why":"All interest on both the specific and the general {l|loans}, with nothing capitalised."},{"t":"$1,200,000","why":"Capitalises the specific loan but forgets the general-borrowings amount."},{"t":"$1,080,000","ok":true,"why":"Total interest 1,800,000 − specific 600,000 − general 120,000 = 1,080,000. The {i|deposit income} is netted into the {a|asset}, not set against {x|finance costs}."},{"t":"$960,000","why":"Deducts the 120,000 {i|deposit income} again. It has already been moved into the {a|factory’s cost}."}]},{"id":"x9","case":"jurong","lo":44,"type":"cessation","q":"Which entry records the 20X4 interest on the specific loan, paid on 31 December 20X4? (No deposit income arose in 20X4.)","options":[{"je":[{"side":"Dr","account":"Factory under construction","amount":600000,"el":"a"},{"side":"Cr","account":"Cash","amount":600000,"el":"a"}],"pit":"whole-year","why":"Capitalises the whole year. Capitalisation ceased when the factory was substantially complete on 31 March."},{"je":[{"side":"Dr","account":"Factory under construction","amount":112500,"el":"a"},{"side":"Dr","account":"Interest expense","amount":487500,"el":"x"},{"side":"Cr","account":"Cash","amount":600000,"el":"a"}],"pit":"suspend-normal","why":"Suspends for the 3 weeks of curing. That was a planned, necessary part of the build, so there is no suspension."},{"je":[{"side":"Dr","account":"Factory under construction","amount":150000,"el":"a"},{"side":"Dr","account":"Interest expense","amount":450000,"el":"x"},{"side":"Cr","account":"Cash","amount":600000,"el":"a"}],"ok":true,"why":"Capitalise January to March: 600,000 × 3/12 = 150,000. The curing pause doesn’t suspend. From 1 April the interest is an {x|expense}: 450,000."},{"je":[{"side":"Dr","account":"Factory under construction","amount":250000,"el":"a"},{"side":"Dr","account":"Interest expense","amount":350000,"el":"x"},{"side":"Cr","account":"Cash","amount":600000,"el":"a"}],"pit":"wait-for-use","why":"Capitalises until production starts on 1 June. The test is substantially complete (31 March), not first use."}]},{"id":"x10","case":"jurong","lo":44,"type":"cessation","q":"How are the borrowing costs already capitalised into the factory treated after 31 March 20X4?","options":[{"t":"Amortised to profit or loss over the remaining term of the specific loan","why":"They are part of the {a|factory’s cost}, not a separate loan-related asset."},{"t":"Reversed to profit or loss when the specific loan is repaid","why":"Repayment of the {l|loan} doesn’t affect the cost of the factory."},{"t":"Kept as part of the {a|factory’s cost} and depreciated with it over its useful life","ok":true,"why":"Capitalised interest becomes part of the {a|asset’s cost}, so it is depreciated along with the rest from when the factory is available for use."},{"t":"Shown as a separate {a|intangible asset}, \"capitalised interest\"","why":"Not a separate asset: it sits inside the {a|factory’s cost}."}]},{"id":"x11","lo":44,"type":"general","q":"An entity’s {l|general borrowings} are $5,000,000 at 4% and $3,000,000 at 7%, both outstanding all year. It builds a qualifying asset funded partly by a {e|share issue}; the time-weighted expenditure for the year is $9,000,000. How much is capitalised?","options":[{"t":"$461,250","pit":"no-cap","why":"9,000,000 × 5.125% = 461,250, more than the 410,000 actually incurred. Apply the cap."},{"t":"$495,000","pit":"simple-avg-rate","why":"A simple average of the two rates, and no cap."},{"t":"$410,000","ok":true,"why":"Rate = 410,000 ÷ 8,000,000 = 5.125%. × 9,000,000 = 461,250, capped at the actual borrowing costs of 410,000."},{"t":"$360,000","why":"Uses only the cheapest loan’s rate."}]},{"id":"x12","lo":44,"type":"cessation","q":"A company builds a steel mill with borrowed funds. The blast furnace is finished on 31 May, but it cannot operate until the linked rolling lines are finished on 30 November. When does capitalisation cease?","options":[{"t":"31 May for the furnace, and 30 November for the rolling lines","why":"Cease part by part only when each part can be used while the others are built. The furnace can’t run without the rolling lines."},{"t":"30 November, for the whole mill","ok":true,"why":"The parts only work together, so capitalisation runs until the whole mill is substantially complete."},{"t":"31 May, for the whole mill","why":"Most of the mill is still being built after 31 May."},{"t":"When the mill produces its first saleable steel","pit":"wait-for-use","why":"The test is substantially complete, not first output."}]}]},"prepared":true},{"id":"equity-oci","code":"C3","title":"Equity and Other Comprehensive Income","subtitle":"SFRS(I) 1-1 · SFRS(I) 1-32 · owners, OCI and the SOCE","los":{"45":"Equity and OCI: accounting, disclosure and presentation"},"accounts":[{"name":"Cash","el":"a"},{"name":"Share capital","el":"e"},{"name":"Share premium","el":"e"},{"name":"Treasury shares","el":"e"},{"name":"Capital reserve","el":"e"},{"name":"Retained earnings","el":"e"},{"name":"Revaluation surplus (OCI)","el":"e"},{"name":"FVOCI reserve","el":"e"},{"name":"Dividend payable","el":"l"},{"name":"Building (PPE)","el":"a"},{"name":"Accumulated depreciation: building","el":"a"},{"name":"Share issue expense","el":"x"},{"name":"Gain on treasury shares","el":"i"},{"name":"Revaluation gain (P&L)","el":"i"},{"name":"Dividend expense","el":"x"},{"name":"Gain on disposal of investment","el":"i"}],"steps":[{"id":"what","name":"What equity is","short":"Equity"},{"id":"owners","name":"Transactions with owners","short":"Owners"},{"id":"oci","name":"OCI: what goes there","short":"OCI"},{"id":"recycle","name":"Recycle or not","short":"Recycling"},{"id":"soce","name":"Statement of changes in equity","short":"SOCE"}],"map":{"what":{"label":"TCI or owners: the only two ways"},"owners":{"label":"Shares, treasury shares, dividends","star":"Owner deals never go through P&L: no {i|income}, no {x|expense}"},"oci":{"label":"{e|Revaluation surplus}, FVOCI, own credit"},"recycle":{"label":"Two OCI groups; transfers to {e|RE}","star":"{e|Revaluation surplus} is never recycled; only FVOCI {a|debt} is"},"soce":{"label":"Column per component; disclosures"}},"preamble":["Welcome to the owners’ corner. Every other chapter so far has been about one {a|asset} or {l|liability}; this one is about **{e|equity}**, the bit left over for the shareholders, and its odd sidekick **other comprehensive income**. No backbone today: this chapter has its own route.","Here is the route, with ★ on the parts that trip people up:","1. **What equity is**, and the one rule that runs the chapter: {e|total equity} only moves through **total comprehensive income** or **transactions with owners**.","2. **Transactions with owners**: share issues and their costs, {e|treasury shares}, dividends, bonus issues. ★ None of them ever touch profit or loss.","3. **OCI**: which gains and losses skip profit and wait in equity instead.","4. **Recycle or not**: which OCI amounts later pass through P&L (only FVOCI {a|debt}), and which just move to {e|retained earnings}. ★ special","5. **The statement of changes in equity**, where it all gets reconciled, column by column, plus the disclosures.","+ The big idea: **“TCI or owners.”** A transfer between {e|reserves} changes no totals. Remember that and the favourite SOCE question (practice Q13) answers itself."],"intros":{"what":"First stop: what equity actually is, and the single rule that runs the whole chapter. {e|Equity} is the residual, {a|assets} minus {l|liabilities}, and its total moves in only two ways: **performance** (profit plus OCI) or **dealings with owners**. Everything else is shuffling money between pockets.","owners":"Now we know what moves equity, let’s meet the owners. Shares go out, {a|cash} comes in; shares come back, cash goes out; dividends leave. ★ The special part: none of this is performance, so **nothing touches profit or loss**: no {i|income} on a share issue, no {x|expense} for issue costs or dividends, no {i|gain} on {e|treasury shares}. And Singapore has no par value, even when exam questions pretend it does.","oci":"Owners done. Back to performance, but the awkward kind: {i|gains} and {x|losses} a standard says should **not** sit in profit. Mostly familiar faces from PPE and financial assets: {e|revaluation surpluses} and FVOCI. The rule of thumb: profit or loss is the default, OCI only by invitation.","recycle":"We know what goes into OCI; now, what comes out, and where to? ★ This is the special part: OCI is split into two groups. Only **FVOCI {a|debt}** gets recycled into P&L later. The {e|revaluation surplus} and FVOCI equity never do; they may just slip quietly into {e|retained earnings}, within equity.","soce":"Last stop: the statement that ties it all together. One column per component, one row per kind of movement, and a total column that only moves for TCI and owners. Then a short list of disclosures, including the classic “are these preference shares really equity?”."},"pitfalls":{"reserve-transfer-total":"Counting a transfer between {e|reserves} as a change in {e|total equity}.","par-not-cash":"Recording a share issue at par value instead of the full cash received (or using par in Singapore).","expense-issue-costs":"Expensing share issue costs, or forgetting to deduct them from {e|equity}.","treasury-gain-pl":"Reporting a {i|gain} or {x|loss} on {e|treasury shares} in profit or loss.","treasury-asset":"Treating {e|treasury shares} as an {a|asset} instead of a deduction from {e|equity}.","div-after-ye-liability":"Recognising a {l|liability} for a dividend declared after the reporting date.","div-expense":"Treating a dividend as an {x|expense} in profit or loss.","bonus-raises-equity":"Thinking a bonus issue increases {e|total equity}.","reval-to-pl":"Putting a {e|revaluation surplus} in profit or loss.","reval-to-re":"Crediting a {e|revaluation surplus} straight to {e|retained earnings} (or forgetting OCI entirely).","recycle-reval":"Recycling the {e|revaluation surplus} or FVOCI equity gains to profit or loss.","no-recycle-debt":"Forgetting to recycle FVOCI debt gains to profit or loss on sale.","excess-dep-pl":"Running the excess depreciation transfer through P&L or OCI, or transferring the whole charge."},"examTypes":[{"id":"closing-equity","title":"What is the closing equity balance? (practice Q13)","pitfall":"Counting a transfer between {e|reserves}, or recording a share issue at par instead of {a|cash received}.","see":"soce"},{"id":"reval-where","title":"How should the revaluation surplus be accounted for? (practice Q29)","pitfall":"Putting it in profit or loss, or straight into {e|retained earnings}.","see":"oci"},{"id":"owner-txn","title":"How are share issues, issue costs, treasury shares and bonus issues recorded?","pitfall":"Expensing issue costs, or reporting a treasury-share {i|gain} as {i|income}.","see":"owners"},{"id":"dividends","title":"How is a dividend declared before / after year end treated?","pitfall":"Recognising a {l|liability} for a dividend declared after year end, or expensing it.","see":"owners"},{"id":"recycle","title":"Which OCI items will be reclassified to profit or loss?","pitfall":"Saying the {e|revaluation surplus} is recycled.","see":"recycle"},{"id":"reserve-transfer","title":"How much is transferred from the revaluation surplus, and where?","pitfall":"Sending the excess depreciation through P&L or OCI.","see":"recycle"},{"id":"disclosure","title":"Which equity disclosures are required?","pitfall":"Calling redeemable preference shares {e|equity} because of their name.","see":"soce"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":45,"title":"Equity and OCI, the Socratic way","body":["This chapter is about the bottom half of the balance sheet: what belongs to the owners, how it moves, and the strange half-income called **other comprehensive income**.","Each idea starts with a question. Think it through, then reveal the answer. The rule comes after, once you have half-worked it out.","Account names are coloured by element. Tap **Legend** at the top any time. At the end: a chapter quiz in exam style, then a harder exam."],"id":"intro-ghcls0","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-what","bucket":"what","sect":1,"part":"What equity is"},{"id":"think-1e2ckf","type":"think","bucket":"what","lo":45,"scenario":"Jurong Widgets Pte Ltd had {e|total equity} of $900,000 at the start of the year. During the year it made a profit of $120,000, paid dividends of $40,000, issued new shares for $60,000 {a|cash}, and moved $15,000 from its {e|revaluation surplus} to {e|retained earnings}.","prompt":"Which of these four things changed total equity, and which only shuffled it around?","answer":["Profit (+120,000) came from **performance**. The dividend (−40,000) and the share issue (+60,000) are deals with the **owners**. All three change the {e|total}.","The 15,000 transfer just moves money from one {e|equity} pocket to another. Same trousers, different pocket: {e|total equity} doesn’t move.","{e|Closing equity} = 900,000 + 120,000 − 40,000 + 60,000 = **$1,040,000**."],"sect":1,"part":"What equity is"},{"type":"rule","bucket":"what","lo":45,"title":"Equity changes in only two ways","body":["The Jurong think page had four movements, but only three changed the total. This is the rule behind that, and the idea the whole chapter hangs on.","{e|Equity} is the residual: {a|assets} minus {l|liabilities}. It is what the owners would have left if everything else were settled.","{e|Total equity} changes in only **two** ways:","1. **Total comprehensive income (TCI)** = profit or loss + other comprehensive income. This is performance.","2. **Transactions with owners** acting as owners: share issues, buy-backs, dividends. These are contributions and distributions.","- A **transfer between reserves** (e.g. {e|Revaluation surplus (OCI)} → {e|Retained earnings}) changes no totals.","+ Memory hook: **“TCI or owners.”** Anything else is just moving money between pockets."],"id":"rule-rl37gi","sect":1,"part":"What equity is"},{"type":"diagram","bucket":"what","lo":45,"title":"Where each change in equity is recorded","intro":"This is the chart from your notes, and the map for the whole chapter. Every change in {e|equity} starts at the top and ends in the statement of changes in equity.","notes":{"t":"Any movement in a component of {e|equity}: {e|share capital}, {e|reserves}, {e|retained earnings}.","q":"The first fork: is the owner acting **as an owner** (putting money in, taking it out), or is this just a reserve transfer?","eq":"These go **straight to {e|equity}**. They never touch profit or loss or OCI.","ie":"Everything else is performance: an {i|income} or an {x|expense}.","pl":"The **default** home for {i|income} and {x|expenses}. OCI only when a standard says so.","oy":"OCI that will be **recycled** into P&L later. In this syllabus: FVOCI {a|debt instruments}.","on":"OCI that **never** goes to P&L. {e|Revaluation surplus}, FVOCI {a|equity investments}, own credit risk.","soce":"All roads end here: each column is reconciled from {e|opening} to {e|closing}."},"walk":[{"nodes":["t","q"],"text":"Start at the top: is this a deal with the owners, or a reserve transfer?"},{"nodes":["eq"],"text":"**Yes** → directly in equity: share issues (net of costs), dividends, {e|treasury shares}, bonus issues, reserve transfers."},{"nodes":["ie","pl"],"text":"**No** → it is {i|income} or an {x|expense}. By default it goes to **profit or loss**."},{"nodes":["oy","on"],"text":"Unless a standard sends it to **OCI**, in one of two groups: may be recycled, or never."},{"nodes":["soce"],"text":"Everything lands in the **statement of changes in equity**. P&L + OCI is shown as total comprehensive income."}],"caption":"Owners → {e|equity}. Performance → P&L or OCI. All of it → the SOCE.","id":"diagram-wc9leg","sect":1,"part":"What equity is","svg":"\u003csvg width=\"100%\" style=\"min-width:591px\" role=\"img\"\n viewBox=\"0.00 0.00 537.00 386.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 371.56)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-371.56 522.5,-371.56 522.5,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>t\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M200.1,-357.16C200.1,-357.16 105.75,-357.16 105.75,-357.16 99.75,-357.16 93.75,-351.16 93.75,-345.16 93.75,-345.16 93.75,-333.16 93.75,-333.16 93.75,-327.16 99.75,-321.16 105.75,-321.16 105.75,-321.16 200.1,-321.16 200.1,-321.16 206.1,-321.16 212.1,-327.16 212.1,-333.16 212.1,-333.16 212.1,-345.16 212.1,-345.16 212.1,-351.16 