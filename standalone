<title>ISCA Socratic Study</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%231a222b%22%2F%3E%3Cpath%20d%3D%22M12%2019h40M32%2019v33%22%20stroke%3D%22%23f5f6f2%22%20stroke-width%3D%225%22%20stroke-linecap%3D%22round%22%2F%3E%3Crect%20x%3D%2215%22%20y%3D%2227%22%20width%3D%2212%22%20height%3D%225%22%20rx%3D%222.5%22%20fill%3D%22%235cc488%22%2F%3E%3Crect%20x%3D%2215%22%20y%3D%2237%22%20width%3D%228%22%20height%3D%225%22%20rx%3D%222.5%22%20fill%3D%22%235cc488%22%2F%3E%3Crect%20x%3D%2237%22%20y%3D%2227%22%20width%3D%2212%22%20height%3D%225%22%20rx%3D%222.5%22%20fill%3D%22%23f2786d%22%2F%3E%3Crect%20x%3D%2237%22%20y%3D%2237%22%20width%3D%2212%22%20height%3D%225%22%20rx%3D%222.5%22%20fill%3D%22%23f2786d%22%2F%3E%3Crect%20x%3D%2237%22%20y%3D%2245%22%20width%3D%226%22%20height%3D%225%22%20rx%3D%222.5%22%20fill%3D%22%23f2786d%22%2F%3E%3C%2Fsvg%3E">
