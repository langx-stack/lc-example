<script>
// Interactive charts. A page's html holds <div class="wg" data-wg="name" data-key="…" data-cfg="{json}">
// (build it with lib/widgets.js); app.js mounts them when they appear. Pure SVG + CSS transitions.
(function () {
  const C = window.StudyCore;
  const md = C.renderInline;
  const fmt = (n) => Number(n).toLocaleString('en-US');
  const state = {}; // step per widget key, so a re-render keeps your place
  let uid = 0;

  // ── roll: a balance rolled forward year by year, one animated step per movement. One panel, or two side by side.
  // cfg: {
  //   panels: [{ title, sub?, el: 'a'|'l'|'e', bal: 'Carrying amount', start, startCap?,
  //              years: [{ label: '20X1', parts: [{ name: 'interest', el: 'i', v: +5840, cap? }] }] }],
  //   target?: { v, label },                  dashed line the balance heads for (e.g. face value)
  //   notes?: { start, parts: [per part], end }  shared line under the panels (md)
  // }
  // Every panel has the same years. A panel may have fewer parts in a year than another (e.g. amortised cost vs
  // fair value, where only one panel has the fair value layer); on a step it lacks, it holds still and shows yr.hold.
  // A negative part is hatched: it leaves the balance.
  function roll(el, cfg) {
    const id = ++uid;
    const P = cfg.panels;
    const two = P.length > 1;
    const key = el.dataset.key || `roll${id}`;
    const W = two ? 200 : 340, H = 226, top = 24, bot = 200;
    const tag = (e, s) => `{${e}|${s}}`;

    // Steps: 0 = start, then one per part, using the panel with the most parts in each year.
    const steps = [{ y: -1, j: -1 }];
    const widest = (yi) => P.reduce((w, p) => (p.years[yi].parts.length > w.years[yi].parts.length ? p : w), P[0]);
    P[0].years.forEach((_, yi) => widest(yi).years[yi].parts.forEach((pt, j) => steps.push({ y: yi, j, name: pt.name })));
    const stepOf = (yi, j) => steps.findIndex((x) => x.y === yi && x.j === j);
    const last = steps.length - 1;

    // Running balance per panel: run[p][yi][j] = balance after part j of year yi.
    const run = P.map((p) => { let b = p.start; return p.years.map((yr) => yr.parts.map((pt) => (b += pt.v))); });
    const vals = P.flatMap((p, i) => [p.start, ...run[i].flat()]).concat(cfg.target ? [cfg.target.v] : []);
    const mn = Math.min(...vals), mx = Math.max(...vals), span = mx - mn || mx || 1;
    const unit = Math.pow(10, Math.floor(Math.log10(span / 4)));
    let lo = Math.floor((mn - span * 0.12) / unit) * unit;
    if (lo <= 0 || mn < mx * 0.4) lo = 0; // near zero: keep the honest zero baseline
    const hi = Math.ceil((mx + span * 0.1) / unit) * unit;
    const y = (v) => top + ((hi - v) / (hi - lo)) * (bot - top);
    const n = P[0].years.length;
    const sw = (W - 30) / n;
    const slot = (k) => 24 + sw * (k - 0.5); // centre of year k (1..n); the start dot sits at x = 12

    const panel = (p, pi) => {
      const pats = [...new Set(p.years.flatMap((yr) => yr.parts.filter((pt) => pt.v < 0).map((pt) => pt.el)))];
      let s = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${C.escapeHtml(p.title.replace(/\{[aleixn]\|([^}]*)\}/g, "$1"))}: ${C.escapeHtml(p.bal)} rolled forward">
        <defs>${pats.map((e) => `<pattern id="h${id}${pi}${e}" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="4" height="4" class="hbg"/><line x1="0" y1="0" x2="0" y2="4" class="hln hl-${e}"/></pattern>`).join('')}</defs>`;
      // the target's label sits in the footer, where it can't collide with the data labels
      if (cfg.target) s += `<line class="face" x1="4" x2="${W - 2}" y1="${y(cfg.target.v)}" y2="${y(cfg.target.v)}"/>`;
      const foot = [cfg.target ? `- - ${cfg.target.label}` : '', lo > 0 ? `axis from ${fmt(lo)}` : ''].filter(Boolean).join(' · ');
      s += `<text class="lbl muted ax" x="4" y="${H - 4}">${C.escapeHtml(foot)}</text>`;
      let px = 12, py = y(p.start), st = 0;
      p.years.forEach((yr, yi) => {
        const k = yi + 1, c = slot(k), m = yr.parts.length;
        const bw = Math.min(10, (sw - 8) / m - 3), total = m * bw + (m - 1) * 3, x0 = c - total / 2;
        const edge = (x, w) => (k === n ? `x="${x + w}" text-anchor="end"` : `x="${x + w / 2}" text-anchor="middle"`);
        let prevX = px, from = yi ? run[pi][yi - 1][run[pi][yi - 1].length - 1] : p.start;
        s += `<text class="lbl muted yl" x="${c}" y="${top - 10}" text-anchor="middle">${C.escapeHtml(yr.label)}</text>`;
        yr.parts.forEach((pt, j) => {
          st = stepOf(yi, j);
          const to = run[pi][yi][j], bx = x0 + j * (bw + 3), up = pt.v >= 0;
          const yt = y(Math.max(from, to)), hgt = Math.max(1, Math.abs(y(from) - y(to)));
          if (!pt.v) { prevX = bx + bw / 2; return; } // a zero movement draws nothing; the panel holds still
          s += `<line class="conn st${st}" x1="${prevX}" x2="${bx + bw / 2}" y1="${y(from)}" y2="${y(from)}"/>
            <rect class="seg-b ${up ? `grow-up fill-${pt.el}` : `grow-down edge-${pt.el}`} st${st}" x="${bx}" width="${bw}" y="${yt}" height="${hgt}"${up ? '' : ` fill="url(#h${id}${pi}${pt.el})"`}/>
            <text class="lbl el-${pt.el} st${st} act-only" ${edge(bx, bw)} y="${yt - 4}">${up ? '+' : '−'}${fmt(Math.abs(pt.v))}</text>`;
          prevX = bx + bw / 2; from = to;
        });
        const dx = x0 + (m - 1) * (bw + 3) + bw / 2, close = run[pi][yi][m - 1];
        s += `<line class="path draw st${st} stroke-${p.el}" pathLength="1" x1="${px}" y1="${py}" x2="${dx}" y2="${y(close)}"/>
          <circle class="dot st${st} fill-${p.el}" cx="${dx}" cy="${y(close)}" r="3.6"/>
          ${close === (yi ? run[pi][yi - 1][run[pi][yi - 1].length - 1] : p.start) ? '' /* unchanged: the previous label already says it */ : `<text class="lbl el-${p.el} st${st}" ${k === n ? `x="${dx + 5}" text-anchor="end"` : `x="${dx}" text-anchor="middle"`} y="${yr.parts[m - 1].v > 0 ? y(close) - 17 : Math.min(y(close) + 14, H - 14)}">${fmt(close)}</text>`}`; // clear of the last bar
        px = dx; py = y(close);
      });
      s += `<circle class="dot st0 fill-${p.el}" cx="12" cy="${y(p.start)}" r="3.6"/>
        <text class="lbl el-${p.el} st0" x="6" y="${Math.max(y(p.start) - 8, 10)}">${fmt(p.start)}</text></svg>`; // above, clear of year 1's label
      return `<div class="par-p"><div class="par-h"><b>${md(p.title)}</b>${p.sub ? `<span class="muted">${md(p.sub)}</span>` : ''}</div>${s}<p class="par-cap" aria-live="polite"></p></div>`;
    };

    const caption = (p, pi, sti) => {
      const { y: yi, j } = steps[sti];
      if (yi < 0) return md(p.startCap || `Start: ${tag(p.el, `${p.bal.toLowerCase()} ${fmt(p.start)}`)}.`);
      const yr = p.years[yi], pt = yr.parts[j], after = run[pi][yi][j], end = j === yr.parts.length - 1;
      if (!pt) return md(yr.hold || `${yr.label}: no change here. The balance stays at ${tag(p.el, fmt(run[pi][yi][yr.parts.length - 1]))}.`);
      if (pt.cap) return md(pt.cap);
      return md(`${yr.label}: ${pt.v >= 0 ? '+' : '−'} ${tag(pt.el, `${pt.name} ${fmt(Math.abs(pt.v))}`)} → ${tag(p.el, fmt(after))}${end ? `, the ${tag(p.el, 'closing balance')}` : ''}.`);
    };
    const note = (sti) => {
      const N = cfg.notes || {};
      const { j } = steps[sti];
      return md(sti === 0 ? N.start || '' : sti === last && N.end ? N.end : (N.parts || [])[j] || '');
    };
    const stepName = (sti) => { const { y: yi, name } = steps[sti]; return yi < 0 ? 'Start' : `${P[0].years[yi].label} ${name}`; };
    const keyParts = [];
    P.flatMap((p) => p.years.flatMap((yr) => yr.parts)).forEach((pt) => { if (pt.v && !keyParts.some((k) => k.name === pt.name)) keyParts.push(pt); });
    const keyHtml = keyParts.map((pt) => `<span><i class="seg ${pt.v >= 0 ? pt.el : `out out-${pt.el}`}"></i>${md(pt.v >= 0 ? tag(pt.el, pt.name) : `${tag(pt.el, pt.name)} (leaves the balance)`)}</span>`).join('')
      + `<span><i class="pdot fill-${P[0].el}"></i>${md(tag(P[0].el, P[0].bal))}</span>`;

    el.innerHTML = `<div class="par-grid ${two ? '' : 'one'}">${P.map(panel).join('')}</div>
      <div class="par-key">${keyHtml}</div>
      <p class="par-note"></p>
      <div class="par-ctl">
        <button class="btn ghost" data-w="back" aria-label="Previous step">‹</button>
        <button class="btn" data-w="play">Play</button>
        <button class="btn ghost" data-w="next" aria-label="Next step">›</button>
        <input type="range" min="0" max="${last}" step="1" aria-label="Step">
        <span class="par-step muted"></span>
      </div>`;

    const range = el.querySelector('input');
    const playBtn = el.querySelector('[data-w="play"]');
    let timer = null;
    const set = (sti) => {
      sti = Math.max(0, Math.min(last, sti));
      state[key] = sti;
      el.querySelectorAll('svg [class*="st"]').forEach((node) => {
        const m = node.getAttribute('class').match(/\bst(\d+)\b/);
        if (!m) return;
        const k = Number(m[1]);
        node.classList.toggle('on', k <= sti);
        node.classList.toggle('past', k < sti && node.classList.contains('act-only'));
        node.classList.toggle('cur', k === sti);
      });
      el.querySelectorAll('.par-p').forEach((p, i) => { p.querySelector('.par-cap').innerHTML = caption(P[i], i, sti); });
      el.querySelector('.par-note').innerHTML = note(sti);
      el.querySelector('.par-step').textContent = `${sti + 1}/${last + 1} · ${stepName(sti)}`;
      range.value = sti;
      el.querySelector('[data-w="back"]').disabled = sti === 0;
      el.querySelector('[data-w="next"]').disabled = sti === last;
    };
    const stop = () => { clearInterval(timer); timer = null; playBtn.textContent = 'Play'; };
    const play = () => {
      if (state[key] >= last) set(0);
      playBtn.textContent = 'Pause';
      timer = setInterval(() => { if (!el.isConnected || state[key] >= last) return stop(); set(state[key] + 1); }, 1500);
    };
    el.addEventListener('click', (e) => {
      const b = e.target.closest('[data-w]');
      if (!b) return;
      if (b.dataset.w === 'play') return timer ? stop() : play();
      stop();
      set(state[key] + (b.dataset.w === 'next' ? 1 : -1));
    });
    range.addEventListener('input', () => { stop(); set(Number(range.value)); });
    // first paint without transitions, then animate from there
    el.classList.add('still');
    set(state[key] || 0);
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('still')));
  }

  // ── flow: a hand-placed flowchart. Chips pick an example; its route stays lit and the rest fades. Tap a box for its note.
  // cfg: {
  //   w, h,                                        viewBox size (draw it phone-narrow, ~380 wide)
  //   nodes: [{ id, x, y, w, h, t, sub?: [lines], k: 'q'|'out-x'|'neutral'|'bs', dash? }]   sub lines take {a|…} tags
  //   joins?: [{ id, cx, cy, t }],                 small circles such as an "and" junction
  //   edges: [{ id, d, lab?, lx?, ly?, anchor? }], d = SVG path ending at the arrow tip
  //   scenarios: [{ id, label, lit: [node and edge ids], text }], all: text when nothing is picked, notes?: { nodeId: md }
  // }
  function flow(el, cfg) {
    const id = ++uid;
    const key = el.dataset.key || `flow${id}`;
    const tsp = (s) => C.escapeHtml(s).replace(/\{([a-z])\|([^}]+)\}/g, '<tspan class="el-$1">$2</tspan>');
    const node = (n) => {
      const lines = [{ t: n.t, cls: 'fl-t' }, ...(n.sub || []).map((t) => ({ t, cls: 'fl-s' }))];
      const lh = (c) => (c === 'fl-t' ? 15 : 13);
      const tot = lines.reduce((a, l) => a + lh(l.cls), 0);
      let ty = n.y + n.h / 2 - tot / 2 + 11;
      const txt = lines.map((l) => { const out = `<text class="${l.cls}" x="${n.x + n.w / 2}" y="${ty}" text-anchor="middle">${tsp(l.t)}</text>`; ty += lh(l.cls); return out; }).join('');
      return `<g class="fl-n fl-${n.k}${n.dash ? ' fl-dash' : ''}" data-id="${n.id}" tabindex="0" role="button"><rect x="${n.x}" y="${n.y}" width="${n.w}" height="${n.h}" rx="9"/>${txt}</g>`;
    };
    const edge = (e) => `<g class="fl-e" data-id="${e.id}"><path d="${e.d}" marker-end="url(#fa${id})"/>${e.lab ? `<text x="${e.lx}" y="${e.ly}" text-anchor="${e.anchor || 'start'}">${C.escapeHtml(e.lab)}</text>` : ''}</g>`;
    const join = (j) => `<g class="fl-j" data-id="${j.id}"><circle cx="${j.cx}" cy="${j.cy}" r="13"/><text x="${j.cx}" y="${j.cy + 4}" text-anchor="middle">${C.escapeHtml(j.t)}</text></g>`;
    el.innerHTML = `<div class="chips fl-chips">${cfg.scenarios.map((s) => `<button class="chipbtn" data-f="${s.id}">${C.escapeHtml(s.label)}</button>`).join('')}<button class="chipbtn" data-f="">Show all</button></div>
      <div class="fl-box"><svg viewBox="0 0 ${cfg.w} ${cfg.h}" role="img" aria-label="Flowchart">
        <defs><marker id="fa${id}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M1 1 9 5 1 9" class="fl-ah"/></marker></defs>
        ${cfg.edges.map(edge).join('')}${(cfg.joins || []).map(join).join('')}${cfg.nodes.map(node).join('')}</svg></div>
      <p class="fl-cap" aria-live="polite"></p>`;
    const cap = el.querySelector('.fl-cap');
    const set = (sid, tap) => {
      state[key] = sid;
      const sc = cfg.scenarios.find((s) => s.id === sid);
      el.querySelector('svg').classList.toggle('fl-pick', !!sc);
      el.querySelectorAll('[data-id]').forEach((g) => g.classList.toggle('lit', !!sc && sc.lit.includes(g.dataset.id)));
      el.querySelectorAll('[data-f]').forEach((b) => b.classList.toggle('on', b.dataset.f === (sid || '')));
      el.querySelectorAll('.fl-n').forEach((g) => g.classList.toggle('tapped', g.dataset.id === tap));
      const note = tap && (cfg.notes || {})[tap];
      cap.innerHTML = md(note || (sc ? sc.text : cfg.all));
    };
    el.addEventListener('click', (e) => {
      const b = e.target.closest('[data-f]');
      if (b) return set(b.dataset.f);
      const n = e.target.closest('.fl-n');
      if (n) set(state[key], n.dataset.id);
    });
    el.addEventListener('keydown', (e) => { const n = e.target.closest('.fl-n'); if (n && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); set(state[key], n.dataset.id); } });
    set(state[key] || '');
  }

  const REG = { roll, flow };
  window.StudyWidgets = {
    mount(root) {
      root.querySelectorAll('.wg:not([data-ready])').forEach((el) => {
        el.dataset.ready = '1';
        const f = REG[el.dataset.wg];
        if (f) f(el, JSON.parse(el.dataset.cfg || '{}'));
      });
    },
  };
})();

</script>
<script>
// Browser UI. Reads window.STUDY_DATA (built from content/*.js + the schedule) and uses window.StudyCore.
(function () {
  const C = window.StudyCore;
  const DATA = window.STUDY_DATA;
  const md = C.renderInline;
  const esc = C.escapeHtml;
  const $app = document.getElementById('app');
  const fmt = (n) => Number(n).toLocaleString('en-US');
  const today = () => C.dayKey(new Date());

  let storage = null;
  try { storage = window.localStorage; } catch (e) { storage = null; }
  const stores = {};
  // Fresh start on 2026-10-24 once all 19 chapters were in: progress lives under v3, old v1 keys are cleared.
  try { if (storage) Object.keys(storage).filter((k) => k.startsWith('isca-study:v1:')).forEach((k) => storage.removeItem(k)); } catch (e) { /* storage unavailable */ }
  const st = (id) => (stores[id] = stores[id] || C.store(storage, `isca-study:v3:${id}`));
  const loadProg = (id) => C.migrate(st(id).load(), DATA.legacy[id], id);

  const ui = { view: 'home', topic: null, legend: false, side: false, confirmSubmit: false, qIndex: 0, preMode: 'quiz' };
  let prog = {};
  let G = st('_global').load();
  const save = () => st(ui.topic.id).save(prog);
  const saveG = () => st('_global').save(G);
  const topicById = (id) => DATA.topics.find((t) => t.id === id);
  const topicByCode = (code) => DATA.topics.find((t) => t.code === code);

  // Every question in the app, by key "topic:set:id", with its case.
  const QINDEX = {};
  for (const t of DATA.topics) {
    for (const set of ['quiz', 'exam']) {
      if (!t[set]) continue;
      for (const q of t[set].questions) QINDEX[C.qkey(t.id, set, q.id)] = { t, set, q, c: q.case ? t[set].cases[q.case] : null };
    }
  }
  const allKeys = (t, set) => (t[set] ? t[set].questions.map((q) => C.qkey(t.id, set, q.id)) : []);
  // One chapter quiz: the quiz set, then the harder 'exam' set (flagged ▲ Hard on each question).
  const quizKeys = (t) => [...allKeys(t, 'quiz'), ...allKeys(t, 'exam')];
  const hardTag = (set) => (set === 'exam' ? '<span class="badge hard" title="Harder, multi-step question">▲ Hard</span>' : '');

  // Stable shuffle per attempt so answer positions don't form a pattern. Official questions keep their printed order.
  function shuffled(n, seed) {
    const idx = [...Array(n).keys()];
    let s = seed || 1;
    for (let i = n - 1; i > 0; i--) {
      s = (s * 9301 + 49297) % 233280;
      const j = Math.floor((s / 233280) * (i + 1));
      [idx[i], idx[j]] = [idx[j], idx[i]];
    }
    return idx;
  }
  const isOfficial = (q) => /^Official/.test(q.source || '');

  // ── Shared bits
  const legendHtml = () => Object.entries(C.ELEMENTS)
    .map(([k, v]) => `<span class="el el-${k}"><span class="dot"></span>${v}</span>`).join('');

  // Page types fall into five kinds, each with one colour (kept apart from the element colours).
  const KIND = {
    map: 'map', think: 'think',
    intro: 'learn', rule: 'learn', visual: 'learn', diagram: 'learn', summary: 'learn', worked: 'learn', tree: 'learn', compare: 'learn',
    mcq: 'check', je: 'check', calc: 'check',
    examtypes: 'quiz', quiz: 'quiz',
  };
  const KIND_LEGEND = [['map', 'Map'], ['think', 'Think'], ['learn', 'Learn'], ['check', 'Check'], ['quiz', 'Quiz']];
  const kindOf = (type) => KIND[type] || 'learn';

  const plain = (x) => String(x || '').replace(/\{[a-z]\|([^}]+)\}/g, '$1').replace(/\*+/g, '');
  function stopLabel(p) {
    if (p.type === 'map') return p.bucket ? 'Map' : 'Map · overview';
    if (p.type === 'compare') return 'Compare across assets';
    if (p.type === 'examtypes') return 'Exam question types';
    if (p.type === 'tree') return `Tree: ${plain(p.title)}`;
    if (p.type === 'diagram') return `Chart: ${plain(p.title)}`;
    if (p.title && !['think', 'mcq', 'je', 'calc'].includes(p.type)) return plain(p.title);
    return plain(p.prompt || p.q) || p.type;
  }

  function header(title, pct, opts = {}) {
    return `<header class="top">
      <div class="wrap">
        ${opts.side ? `<button class="chipbtn sidebtn" data-act="side" aria-expanded="${ui.side}" aria-label="Show or hide the chapter stops">☰</button>` : ''}
        <button class="chipbtn" data-act="home" aria-label="Back to home">Home</button>
        <div class="title">${title}</div>
        <button class="chipbtn" data-act="legend" aria-expanded="${ui.legend}">Legend</button>
      </div>
      ${pct === undefined ? '' : `<div class="progress"><i style="width:${pct}%"></i></div>`}
      ${ui.legend ? `<div class="legend"><div class="wrap">${legendHtml()}<span class="muted">Contra accounts take the colour of the element they reduce.</span></div></div>` : ''}
    </header>`;
  }

  const jeTable = (lines) => `<table class="jet">${lines.map((l) => {
    const acc = l.el ? `<span class="el el-${l.el}">${esc(l.account)}</span>` : md(l.account);
    return `<tr class="${l.side === 'Cr' ? 'cr' : ''}"><td class="acc">${l.side} ${acc}</td><td class="amt">${fmt(l.amount)}</td></tr>`;
  }).join('')}</table>`;

  function bodyLines(lines) {
    const out = [];
    let list = [];
    let kind = 'ul';
    const flush = () => { if (list.length) { out.push(`<${kind} class="body">${list.join('')}</${kind}>`); list = []; } };
    for (const s of lines || []) {
      // "- " is a bullet; "1. ", "2. " … is a numbered item. A switch between the two starts a new list.
      const num = s.match(/^\d+\. /);
      if (s.startsWith('- ') || num) {
        const k = num ? 'ol' : 'ul';
        if (k !== kind) { flush(); kind = k; }
        list.push(`<li>${md(s.slice(num ? num[0].length : 2))}</li>`);
        continue;
      }
      flush();
      if (s.startsWith('> ')) out.push(`<div class="formula">${md(s.slice(2))}</div>`);
      else if (s.startsWith('! ')) out.push(`<p class="trap">${md(s.slice(2))}</p>`);
      else if (s.startsWith('+ ')) out.push(`<p class="key">${md(s.slice(2))}</p>`);
      else out.push(`<p>${md(s)}</p>`);
    }
    flush();
    return out.join('');
  }

  const seenPct = (t, p) => {
    const s = new Set(p.seen || []);
    return Math.round((t.pages.filter((x) => s.has(x.id)).length / t.pages.length) * 100);
  };
  // A best from before the quiz grew (e.g. 1/17 when the quiz is now 32) no longer counts.
  const bestTxt = (b, n) => (b && b.total === n ? `${b.correct}/${b.total}` : '—');

  const AREA = { A: 'Framework', B: 'Assets & liabilities', C: 'Revenue, borrowing costs & equity', D: 'Preparing the statements', E: 'Policies, events & foreign currency' };
  // ── Home: countdown, today's plan, practice, chapters, the whole schedule
  function renderHome() {
    const S = DATA.schedule;
    const now = today();
    const daysLeft = Math.round((new Date(`${S.examDate}T00:00:00`) - new Date(`${now}T00:00:00`)) / 86400000);
    const di = S.days.findIndex((d) => d.date === now);
    const due = C.dueReviews(G.review, now, (k) => !!QINDEX[k]);
    const pits = C.topPitfalls(G.pits, 3).map(({ id, count }) => {
      const [tid, pid] = id.split(':');
      const t = topicById(tid);
      return t && t.pitfalls && t.pitfalls[pid] ? `<li><span class="src">${esc(t.code)}</span> ${md(t.pitfalls[pid])} <span class="muted mono">×${count}</span></li>` : '';
    }).join('');

    const noteChip = (n) => {
      const t = topicByCode(n.code);
      if (!t) return `<span class="chip">${esc(n.code)}${n.part ? ` ${esc(n.part)}` : ''}</span>`;
      return `<button class="chip link" data-act="lesson" data-topic="${t.id}">${esc(n.code)} · ${seenPct(t, loadProg(t.id))}%</button>`;
    };
    const dayRow = (d, i) => {
      const ms = S.milestones.filter(([n]) => n === i + 1).map(([, txt]) => `<p class="ms">◆ ${esc(txt)}</p>`).join('');
      const date = new Date(`${d.date}T00:00:00`).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
      return `<li class="day k-${esc(d.kind)} ${d.date === now ? 'today' : ''} ${d.date < now ? 'past' : ''}" ${d.date === now ? 'id="today"' : ''}>
        <div class="dhead"><span class="mono">${date}</span><span class="kind">${esc(d.kind)}</span></div>
        <div class="dtitle">${esc(d.title)}</div>
        ${d.notes.length ? `<div class="chips">${d.notes.map(noteChip).join('')}</div>` : ''}${ms}</li>`;
    };
    const weeks = [];
    for (let w = 0; w * 7 < S.days.length; w++) {
      const days = S.days.slice(w * 7, w * 7 + 7);
      const open = days.some((d) => d.date === now) || (di < 0 && w === 0 && now < S.days[0].date);
      weeks.push(`<details class="week" ${open ? 'open' : ''}><summary>Week ${w + 1} · ${esc(new Date(`${days[0].date}T00:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }))}</summary>
        <ol class="days">${days.map((d, j) => dayRow(d, w * 7 + j)).join('')}</ol></details>`);
    }
    const td = di >= 0 ? S.days[di] : null;
    const todayCard = td ? `<article class="card stack today-card" style="gap:10px">
        <span class="eyebrow">Today · day ${di + 1} of ${S.days.length} · ${esc(td.kind)}</span>
        <h2>${esc(td.title)}</h2>
        ${td.focus.length ? `<ul class="body">${td.focus.map((f) => `<li>${esc(f)}</li>`).join('')}</ul>` : ''}
        ${td.pp ? `<p class="muted" style="font-size:.9rem">Practice paper: ${esc(td.pp)}</p>` : ''}
        ${td.notes.length ? `<div class="chips">${td.notes.map(noteChip).join('')}</div>` : ''}
      </article>` : '';

    const card = (t) => {
      const p = loadProg(t.id);
      const pct = seenPct(t, p);
      return `<article class="card topic">
        <div class="stack" style="gap:2px"><span class="eyebrow">${esc(t.code)}</span><h3>${esc(t.title)}</h3><p class="muted" style="font-size:.9rem">${esc(t.subtitle)}</p></div>
        <div class="stack" style="gap:6px">
          <div class="meta"><span>${t.pages.length} pages · ${pct}% seen</span><span>Quiz ${bestTxt(p.quizBest, quizKeys(t).length)}</span></div>
          <div class="bar"><i style="width:${pct}%"></i></div>
        </div>
        <div class="row">
          <button class="btn" data-act="lesson" data-topic="${t.id}">${p.pageId ? 'Continue' : 'Start'}</button>
          <button class="btn ghost" data-act="quiz-start" data-topic="${t.id}" data-mode="quiz">Quiz</button>
        </div>
      </article>`;
    };
    // Chapters grouped by syllabus area; an area opens when today's plan or a started chapter is in it.
    const todayCodes = new Set(td ? td.notes.map((n) => n.code) : []);
    const areas = [];
    DATA.topics.forEach((t) => {
      const k = t.code[0];
      let a = areas.find((x) => x.k === k);
      if (!a) areas.push(a = { k, topics: [] });
      a.topics.push(t);
    });
    const anyToday = areas.some((a) => a.topics.some((t) => todayCodes.has(t.code)));
    const isOpen = (a) => {
      const started = a.topics.filter((t) => seenPct(t, loadProg(t.id)) > 0).length;
      return a.topics.some((t) => todayCodes.has(t.code)) || (!anyToday && started > 0 && started < a.topics.length);
    };
    const firstOpen = areas.findIndex(isOpen);
    const cards = areas.map((a, ai) => {
      const started = a.topics.filter((t) => seenPct(t, loadProg(t.id)) > 0).length;
      const open = isOpen(a) || (firstOpen < 0 && ai === 0);
      return `<details class="area" ${open ? 'open' : ''}><summary><b>${esc(a.k)}</b> ${esc(AREA[a.k] || '')}
          <span class="muted">${a.topics.length} chapter${a.topics.length === 1 ? '' : 's'} · ${started} started</span></summary>
        <div class="stack" style="gap:12px">${a.topics.map(card).join('')}</div></details>`;
    }).join('');

    $app.innerHTML = `<header class="top"><div class="wrap"><div class="title"><b>ISCA PFF</b> · Socratic study</div>
        <button class="chipbtn" data-act="legend" aria-expanded="${ui.legend}">Legend</button></div>
        ${ui.legend ? `<div class="legend"><div class="wrap">${legendHtml()}</div></div>` : ''}</header>
      <main class="wrap stack" style="gap:20px">
        <section class="hero">
          <span class="eyebrow">${daysLeft > 0 ? `${daysLeft} day${daysLeft === 1 ? '' : 's'} to the exam` : daysLeft === 0 ? 'Exam day' : 'Exam done'} · ${esc(S.exam)}</span>
          <h1>${td ? 'Today’s plan' : 'Your study plan'}</h1>
        </section>
        ${todayCard}
        <section class="stack" style="gap:10px">
          <h2>Practice</h2>
          <div class="row">
            <button class="btn" data-act="review-start" ${due.length ? '' : 'disabled'}>Due today: ${due.length}</button>
            <button class="btn ghost" data-act="drill-start">Mixed drill · 10</button>
          </div>
          <p class="muted" style="font-size:.9rem">${due.length ? 'Questions you missed or guessed, coming back on schedule.' : 'Questions you miss or guess come back here after 1, 3 and 7 days.'} The drill mixes every chapter, like the real paper.</p>
          ${pits ? `<div class="card stack" style="gap:8px"><span class="eyebrow">Your top traps</span><ul class="body pits">${pits}</ul></div>` : ''}
        </section>
        <section class="stack" style="gap:12px"><h2>Chapters</h2>${cards}</section>
        <section class="stack" style="gap:10px"><h2>The ${S.days.length}-day schedule</h2>${weeks.join('')}</section>
        <p class="muted" style="font-size:.85rem">Progress is saved on this device only.</p>
      </main>`;
  }

  // ── Map: the shared backbone, this chapter's labels and specials, the current section
  function renderMap(p, t) {
    const m = t.map || {};
    const secs = C.sections(t);
    const seen = new Set(prog.seen || []);
    const bucketDone = (b) => secs.filter((s) => s.bucket === b).every((s) => t.pages.slice(s.start, s.end + 1).every((x) => seen.has(x.id)));
    const nodes = C.stepsOf(t).map((b, j) => {
      const e = m[b.id] || {};
      const cur = p.bucket === b.id;
      const has = secs.some((s) => s.bucket === b.id);
      return `<li class="mnode ${cur ? 'cur' : ''} ${e.off ? 'off' : ''} ${e.star ? 'star' : ''}">
        <button class="mbtn" data-act="goto-bucket" data-b="${b.id}" ${has ? '' : 'disabled'}>
          <span class="mnum">${j + 1}</span>
          <span class="mtx"><b>${esc(b.name)}${e.star ? ' <span class="gold">★</span>' : ''}</b>${cur && p.blabel ? ` <span class="muted">· ${esc(p.blabel)}</span>` : ''}
            ${e.label ? `<span>${md(e.label)}</span>` : ''}
            ${e.star ? `<span class="mstar"><span class="gold">★</span> ${md(e.star)}</span>` : ''}</span>
          <span class="mstate">${cur ? 'You are here' : has && bucketDone(b.id) ? '<span class="tick">✓</span>' : ''}</span>
        </button></li>`;
    }).join('');
    const others = p.bucket && !t.steps ? DATA.topics.filter((o) => o.id !== t.id && !o.steps && o.map && o.map[p.bucket]).map((o) =>
      `<li><span class="src">${esc(o.code)}</span> ${md(o.map[p.bucket].label || '')}${o.map[p.bucket].star ? ' <span class="gold">★</span>' : ''}</li>`).join('') : '';
    const sIntro = p.bucket && t.intros ? (t.intros[`${p.bucket}|${p.blabel || ''}`] || t.intros[p.bucket]) : null;
    const intro = p.bucket
      ? `<span class="eyebrow">Where you are</span><h2>${esc(C.bucketName(p.bucket, t))}${p.blabel ? ` · ${esc(p.blabel)}` : ''}</h2>
         ${sIntro ? `<div class="preamble">${bodyLines([].concat(sIntro))}</div>` : ''}`
      : `<span class="eyebrow">${esc(t.code)} · the map</span><h1>${esc(t.title)}</h1>
         ${t.preamble ? `<div class="preamble"><span class="eyebrow">In this chapter</span>${bodyLines(t.preamble)}</div>` : ''}
         <p class="muted">${t.steps ? `This chapter isn't an asset or a liability, so it has its own ${t.steps.length}-step route instead of the common six.` : 'Every asset standard runs through the same six steps.'} <span class="gold">★</span> in a gold frame marks what is special about this chapter; faded steps barely apply. Tap a step to jump to it.</p>`;
    return `${intro}<ol class="mapchain">${nodes}</ol>
      <p class="mapkey"><span><i class="kh"></i>You are here</span><span><span class="gold">★</span> Special to this chapter</span><span><span class="tick">✓</span> Step done</span></p>
      ${others ? `<div class="card stack" style="gap:8px"><span class="eyebrow">Same step in other chapters</span><ul class="body others">${others}</ul></div>` : ''}`;
  }

  function renderCompare(p, t) {
    const cmp = (DATA.shared.compare || {})[p.bucket];
    if (!cmp) return `<h2>Compare</h2><p class="muted">No comparison table yet.</p>`;
    // This chapter first, then only its comparable peers.
    const codes = [t.code, ...(p.peers || (DATA.shared.peers || {})[t.code] || [])];
    const picked = codes.map((c) => cmp.rows.find((r) => r.code === c)).filter(Boolean);
    const withWhy = picked.some((r) => r.why);
    const rows = picked.map((r) => `<tr class="${r.code === t.code ? 'me' : ''}"><th scope="row"><span class="src">${esc(r.code)}</span><br>${esc(r.name)}</th>${r.cells.map((c) => `<td>${md(c)}</td>`).join('')}${withWhy ? `<td class="why">${md(r.why || '')}</td>` : ''}</tr>`).join('');
    return `<span class="eyebrow">Compare with its cousins · ${esc(C.bucketName(p.bucket, t))}</span><h2>${esc(cmp.title)}</h2>
      ${p.preamble ? `<p class="lead">${md(p.preamble)}</p>` : ''}
      ${cmp.question ? `<div class="scenario">${md(cmp.question)}</div>` : ''}
      <div class="tbl-wrap"><table class="tbl cmp reveal-rows"><thead><tr><th></th>${cmp.cols.map((c) => `<th>${esc(c)}</th>`).join('')}${withWhy ? '<th>Why</th>' : ''}</tr></thead><tbody>${rows}</tbody></table></div>
      <div class="row"><button class="btn ghost" data-act="row-next">Next row</button><button class="btn ghost" data-act="row-all">Show all</button></div>
      <div class="after-rows stack" hidden>${cmp.pattern ? `<p class="key">${md(cmp.pattern)}</p>` : ''}
      ${p.special ? `<div class="answer"><span class="eyebrow">What’s special in ${esc(t.code)}</span><p>${md(p.special)}</p></div>` : ''}</div>`;
  }

  function examTypesHtml(t, p) {
    const done = new Set(p.typesDone || []);
    const secs = C.sections(t);
    const items = (t.examTypes || []).map((x) => {
      const target = x.see ? secs.find((s) => s.bucket === x.see) : null;
      return `<li class="etype ${done.has(x.id) ? 'done' : ''}">
        <span class="emk" aria-label="${done.has(x.id) ? 'Done before' : 'Not done yet'}">${done.has(x.id) ? '✓' : ''}</span>
        <span class="stack" style="gap:4px"><span>${md(x.title)}</span>
          ${x.pitfall ? `<span class="epit">Pitfall · ${md(x.pitfall)}</span>` : ''}
          ${target ? `<button class="linkbtn" data-act="goto" data-topic="${t.id}" data-pid="${t.pages[target.start].id}">Revisit ${esc(C.bucketName(x.see, t))} →</button>` : ''}</span></li>`;
    }).join('');
    const n = (t.examTypes || []).filter((x) => done.has(x.id)).length;
    return `<span class="eyebrow">Common exam questions · ${n}/${(t.examTypes || []).length} done</span>
      <h2>What the exam asks in ${esc(t.code)}</h2>
      <p class="muted">✓ means you have answered this type in a quiz before.</p>
      <ul class="etypes">${items}</ul>`;
  }

  function renderTree(p, i) {
    prog.tree = prog.tree || {};
    const path = prog.tree[i] || [];
    let nodeId = p.start;
    const steps = path.map((o) => {
      const n = p.nodes[nodeId];
      const opt = n.opts[o];
      const html = `<li><span class="muted">${md(n.q)}</span><b>→ ${md(opt.t)}</b></li>`;
      nodeId = opt.to;
      return html;
    }).join('');
    const n = p.nodes[nodeId];
    let cur;
    if (n.result !== undefined) {
      const verdict = p.expect ? (nodeId === p.expect ? '<span class="badge ok">✓ Right call</span>'
        : `<span class="badge no">✗ Not quite</span> <span class="muted">The scenario lands on: <b>${md(p.nodes[p.expect].result)}</b></span>`) : '';
      cur = `<div class="answer"><span class="eyebrow">Result</span><p class="key">${md(n.result)}</p>${bodyLines(n.body)}</div>
        ${verdict ? `<div>${verdict}</div>` : ''}
        <div><button class="btn ghost" data-act="tree-reset" data-i="${i}">Start again</button></div>`;
    } else {
      cur = `<div class="card stack" style="gap:10px"><p class="prompt">${md(n.q)}</p>${n.why ? `<p class="muted" style="font-size:.9rem">Why it matters: ${md(n.why)}</p>` : ''}
        <div class="opts">${n.opts.map((o, j) => `<button class="opt" data-act="tree-pick" data-i="${i}" data-o="${j}"><span class="mk">${String.fromCharCode(65 + j)}.</span><span class="tx"><span>${md(o.t)}</span></span></button>`).join('')}</div></div>
        ${path.length ? `<div><button class="btn ghost" data-act="tree-back" data-i="${i}">Back one step</button></div>` : ''}`;
    }
    // Light up the route taken so far on the drawn tree.
    let walkId = p.start;
    const lit = [p.start];
    path.forEach((o) => { walkId = p.nodes[walkId].opts[o].to; lit.push(walkId); });
    const whole = p.svg ? `<details class="whole" ${n.result !== undefined || ui.treeOpen ? 'open' : ''}><summary>See the whole tree${path.length ? ' (your route lit up)' : ''}</summary>${diagramBox(p.svg, lit)}</details>` : '';
    return `<span class="eyebrow">Decision tree</span><h2>${esc(p.title)}</h2>
      ${p.scenario ? `<div class="scenario">${md(p.scenario)}</div>` : '<p class="muted">Explore freely: tap through the questions.</p>'}
      ${steps ? `<ol class="treepath">${steps}</ol>` : ''}${cur}${whole}`;
  }

  // A drawn chart (SVG from Graphviz). Tap a box for its note; the walkthrough lights up one part at a time.
  function diagramBox(svg, hl, extra = '') {
    return `<div class="diagram-wrap"><div class="diagram ${hl.length ? 'lit' : ''}" data-hl="${esc(hl.join('|'))}" ${extra}>${svg}</div></div>`;
  }
  function renderDiagram(p, i) {
    prog.walk = prog.walk || {};
    const w = prog.walk[i];
    const walk = p.walk || [];
    const step = w !== undefined && walk[w] ? walk[w] : null;
    const sel = ui.diagSel && ui.diagSel.pid === i ? ui.diagSel.node : null;
    const hl = step ? step.nodes : sel ? [sel] : [];
    const note = sel && p.notes && p.notes[sel];
    return `<span class="eyebrow">Picture it</span><h2>${esc(p.title)}</h2>
      ${p.intro ? bodyLines([].concat(p.intro)) : ''}
      ${diagramBox(p.svg, hl, `data-pid="${esc(i)}"`)}
      ${p.notes ? '<p class="muted" style="font-size:.85rem">Tap any box for what it means.</p>' : ''}
      ${note ? `<div class="answer"><span class="eyebrow">${esc(sel)}</span>${bodyLines([].concat(note))}</div>` : ''}
      ${walk.length ? `<div class="card stack walk" style="gap:10px">
        <span class="eyebrow">Walkthrough${step ? ` · ${w + 1} of ${walk.length}` : ''}</span>
        ${step ? bodyLines([].concat(step.text)) : '<p class="muted">Step through the chart one part at a time.</p>'}
        <div class="row">${step && w > 0 ? `<button class="btn ghost" data-act="walk" data-i="${esc(i)}" data-d="-1">Back</button>` : ''}
          ${!step || w < walk.length - 1 ? `<button class="btn" data-act="walk" data-i="${esc(i)}" data-d="1">${step ? 'Next' : 'Start the walkthrough'}</button>` : `<button class="btn ghost" data-act="walk-reset" data-i="${esc(i)}">Done · show it all</button>`}</div></div>` : ''}
      ${p.caption ? `<p class="cap">${md(p.caption)}</p>` : ''}`;
  }

  function renderWorked(p, i) {
    prog.worked = prog.worked || {};
    const shown = prog.worked[i] || 0;
    // A step is a line, or { h: named step, t: line(s), je, after: line(s) after the entry }.
    const lines = (x) => (x ? bodyLines([].concat(x)) : '');
    const step = (s, k) => (typeof s === 'string' ? bodyLines([s])
      : `${s.h ? `<div class="wh"><span class="wn">Step ${k + 1}</span><span>${md(s.h)}</span></div>` : ''}${lines(s.t)}${s.je ? jeTable(s.je.map((l) => ({ ...l, el: elOf(l.account) }))) : ''}${lines(s.after)}`);
    const named = p.steps.some((s) => s.h);
    return `<span class="eyebrow">Worked example</span><h2>${esc(p.title)}</h2>
      <div class="scenario">${md(p.q)}</div>
      ${p.intro ? `<div class="wintro">${bodyLines([].concat(p.intro))}</div>` : ''}
      <ol class="wsteps ${named ? 'named' : ''}">${p.steps.slice(0, shown).map((s, k) => `<li>${step(s, k)}</li>`).join('')}</ol>
      ${shown < p.steps.length ? `<div class="row"><button class="btn" data-act="worked-next" data-i="${i}">Show step ${shown + 1} of ${p.steps.length}</button>${shown ? '' : `<button class="btn ghost" data-act="worked-all" data-i="${i}">Show all</button>`}</div>`
        : '<p class="muted">Next: the same kind of problem, partly done for you.</p>'}`;
  }

  const elOf = (name) => (ui.topic.accounts.find((a) => a.name === name) || {}).el;

  // ── Lesson pages
  // Optional fold-out background on any page (p.more: { title?, body }). On a think page it waits for the reveal.
  function moreHtml(p) {
    if (!p.more) return '';
    if (p.type === 'think' && !(prog.revealed && prog.revealed[p.id])) return '';
    return `<details class="more"><summary>${esc(p.more.title || 'Additional notes')}</summary><div class="stack">${bodyLines(p.more.body)}</div></details>`;
  }
  function renderPage(p) {
    const s = prog;
    const i = p.id;
    const t = ui.topic;
    switch (p.type) {
      case 'map': return renderMap(p, t);
      case 'compare': return renderCompare(p, t);
      case 'examtypes': return `${examTypesHtml(t, prog)}<div class="row"><button class="btn" data-act="quiz-start" data-topic="${t.id}" data-mode="quiz">Start the quiz</button></div>`;
      case 'tree': return renderTree(p, i);
      case 'worked': return renderWorked(p, i);
      case 'diagram': return renderDiagram(p, i);
      case 'intro':
        return `<span class="eyebrow">Start here</span><h1>${esc(p.title)}</h1>${bodyLines(p.body)}
          <div class="card stack" style="gap:8px"><span class="eyebrow">Colour code</span><div class="row" style="gap:6px 16px">${legendHtml()}</div></div>`;
      case 'think': {
        const revealed = s.revealed && s.revealed[i];
        return `<span class="eyebrow think">Think first</span>
          <div class="scenario">${md(p.scenario)}</div>
          <p class="prompt">${md(p.prompt)}</p>
          <label class="muted" for="think-${i}" style="font-size:.85rem">Your thinking (not marked)</label>
          <textarea id="think-${i}" data-think="${i}" placeholder="Jot a line or two…">${esc((s.think && s.think[i]) || '')}</textarea>
          ${revealed ? `<div class="answer"><span class="eyebrow">Model answer</span>${bodyLines(p.answer)}</div>`
            : `<div><button class="btn" data-act="reveal" data-i="${i}">Reveal answer</button></div>`}`;
      }
      case 'rule':
        return `<span class="eyebrow">The rule</span><h2>${esc(p.title)}</h2>${bodyLines(p.body)}`;
      case 'visual':
        return `<span class="eyebrow">Picture it</span><h2>${esc(p.title)}</h2>${p.html}${
          p.html.includes('reveal-rows') ? `<div class="row"><button class="btn ghost" data-act="row-next">Next row</button><button class="btn ghost" data-act="row-all">Show all</button></div>` : ''}`;
      case 'mcq': {
        const chosen = s.mcq ? s.mcq[i] : undefined;
        const answered = chosen !== undefined;
        const order = shuffled(p.options.length, t.pages.indexOf(p) + 7);
        const opts = order.map((oi, pos) => {
          const o = p.options[oi];
          let cls = '';
          let mk = `${String.fromCharCode(65 + pos)}.`;
          if (answered && o.ok) { cls = 'right'; mk = '✓'; } else if (answered && oi === chosen) { cls = 'wrong'; mk = '✗'; }
          return `<button class="opt ${cls}" data-act="mcq" data-i="${i}" data-o="${oi}" ${answered ? 'disabled' : ''}>
            <span class="mk">${mk}</span><span class="tx"><span>${md(o.t)}</span>${answered ? `<span class="why">${md(o.why)}</span>` : ''}</span></button>`;
        }).join('');
        const verdict = answered ? (p.options[chosen].ok ? '<span class="badge ok">✓ Correct</span>' : '<span class="badge no">✗ Not quite</span>') : '';
        return `<span class="eyebrow">Quick check</span><p class="prompt">${md(p.q)}</p><div class="opts">${opts}</div>${verdict ? `<div>${verdict}</div>` : ''}`;
      }
      case 'je': return renderJE(p, i);
      case 'calc': {
        const c = (s.calc && s.calc[i]) || {};
        const verdict = c.checked ? (C.gradeNumber(p.answer, c.value) ? '<span class="badge ok">✓ Correct</span>' : '<span class="badge no">✗ Not quite</span>') : '';
        const given = p.given ? `<div class="answer given"><span class="eyebrow">Started for you</span>${p.working.slice(0, p.given).map((w) => `<p>${md(w)}</p>`).join('')}<p class="muted">Finish it.</p></div>` : '';
        return `<span class="eyebrow">Work it out</span><p class="prompt">${md(p.q)}</p>${given}
          <div class="row" style="flex-wrap:nowrap"><span class="mono">${esc(p.unit || '')}</span>
            <input id="calc-${i}" data-calc="${i}" inputmode="decimal" autocomplete="off" class="mono" value="${esc(c.value || '')}" placeholder="0" style="max-width:12em">
            <button class="btn" data-act="calc-check" data-i="${i}">Check</button></div>
          ${verdict ? `<div>${verdict}</div>` : ''}
          ${c.checked || c.shown ? `<div class="answer"><span class="eyebrow">Working · answer ${esc(p.unit || '')}${fmt(p.answer)}</span>${p.working.map((w) => `<p>${md(w)}</p>`).join('')}</div>`
            : `<div><button class="btn ghost" data-act="calc-show" data-i="${i}">Show working</button></div>`}`;
      }
      case 'summary':
        return `<span class="eyebrow">Wrap-up</span><h2>${esc(p.title)}</h2>
          <div class="tbl-wrap"><table class="tbl"><tbody>${p.rows.map(([q, a]) => `<tr><th scope="row" style="text-transform:none;letter-spacing:0;font-size:.88rem;color:var(--ink)">${md(q)}</th><td>${md(a)}</td></tr>`).join('')}</tbody></table></div>
          <div class="card stack"><p class="prompt">Ready for the exam-style questions?</p>
          <p class="muted">Quiz: ${quizKeys(t).length} four-option MCQs, mostly in case sets like the real PFF paper.${t.exam ? ` The last ${t.exam.questions.length} are harder, multi-step ones, marked ▲ Hard.` : ''}</p>
          <div class="row"><button class="btn" data-act="quiz-start" data-topic="${t.id}" data-mode="quiz">Start the quiz</button></div></div>`;
      default: return '';
    }
  }

  function renderJE(p, i) {
    const s = prog;
    s.je = s.je || {};
    const given = (p.given || []).map((g) => ({ ...p.lines[g], amount: String(p.lines[g].amount), locked: true }));
    const state = s.je[i] || { rows: [...given, { side: 'Dr', account: '', amount: '' }, { side: 'Cr', account: '', amount: '' }].slice(0, Math.max(2, given.length + 1)) };
    s.je[i] = state;
    const accs = p.accounts.map((n) => ui.topic.accounts.find((a) => a.name === n)).filter(Boolean);
    const graded = state.checked ? C.gradeJE(p.lines, state.rows.map((r) => ({ ...r, amount: C.parseAmount(r.amount) }))) : null;
    let gi = 0;
    const rows = state.rows.map((r, ri) => {
      const blank = !r.account && !r.amount;
      const mark = graded && !blank ? (graded.lines[gi++].ok ? 'ok' : 'no') : '';
      const el = elOf(r.account);
      const dis = r.locked ? 'disabled' : '';
      return `<div class="jeline ${mark} ${r.locked ? 'locked' : ''}">
        <select data-je="${i}" data-r="${ri}" data-f="side" aria-label="Debit or credit" ${dis}><option ${r.side === 'Dr' ? 'selected' : ''}>Dr</option><option ${r.side === 'Cr' ? 'selected' : ''}>Cr</option></select>
        <select data-je="${i}" data-r="${ri}" data-f="account" aria-label="Account" ${dis}><option value="">Account…</option>${accs.map((a) => `<option ${a.name === r.account ? 'selected' : ''}>${esc(a.name)}</option>`).join('')}</select>
        <input data-je="${i}" data-r="${ri}" data-f="amount" inputmode="decimal" autocomplete="off" aria-label="Amount" value="${esc(r.amount)}" placeholder="0" ${dis}>
        ${r.locked ? '<span class="lock" title="Given">given</span>' : `<button class="x" data-act="je-del" data-i="${i}" data-r="${ri}" aria-label="Remove line">×</button>`}
        ${el ? `<span class="acc-el el el-${el}"><span class="dot"></span>${C.ELEMENTS[el]}</span>` : ''}
      </div>`;
    }).join('');
    let verdict = '';
    if (graded) {
      const right = graded.lines.filter((l) => l.ok).length;
      verdict = graded.correct ? '<span class="badge ok">✓ Correct entry</span>'
        : `<span class="badge no">✗ ${right} line${right === 1 ? '' : 's'} right${graded.missing ? ` · ${graded.missing} expected line${graded.missing === 1 ? '' : 's'} missing or wrong` : ''}</span>`;
    }
    const answer = state.shown || (graded && graded.correct)
      ? `<div class="answer"><span class="eyebrow">Model entry</span>${jeTable(p.lines.map((l) => ({ ...l, el: elOf(l.account) })))}<p class="muted">${md(p.why || '')}</p>${p.alt ? `<p class="muted">${md(p.alt)}</p>` : ''}</div>` : '';
    return `<span class="eyebrow">Journal entry${given.length ? ' · partly done for you' : ''}</span><p class="prompt">${md(p.q)}</p>
      <div class="jeb">${rows}</div>
      <div class="row"><button class="btn ghost" data-act="je-add" data-i="${i}">+ Add line</button>
        <button class="btn" data-act="je-check" data-i="${i}">Check entry</button>
        ${answer ? '' : `<button class="btn ghost" data-act="je-show" data-i="${i}">Show answer</button>`}</div>
      ${verdict ? `<div>${verdict}</div>` : ''}${answer}`;
  }

  // ── Sidebar: every stop in the chapter, grouped by section, plus the quiz and the exam
  const SHORT = { classify: 'Classify', recognise: 'Recognise', initial: 'Initial', subsequent: 'Subsequent', derecognise: 'Derecognise', present: 'Present' };
  function sidebar(t, curIdx) {
    const seen = new Set(prog.seen || []);
    const groups = C.sections(t).map((s, si) => {
      const steps = C.stepsOf(t);
      const step = steps.findIndex((x) => x.id === s.bucket) + 1;
      const b = steps[step - 1] || {};
      const head = s.bucket === null ? 'Start' : s.bucket === 'wrap' ? 'Wrap-up' : `${b.short || SHORT[s.bucket] || b.name}${s.blabel ? ` · ${s.blabel}` : ''}`;
      const star = t.map && s.bucket && t.map[s.bucket] && t.map[s.bucket].star ? ' <span class="gold">★</span>' : '';
      const pages = t.pages.slice(s.start, s.end + 1);
      const done = pages.filter((p) => seen.has(p.id)).length;
      const here = curIdx >= s.start && curIdx <= s.end;
      const open = here || (ui.openSects && ui.openSects.has(`${t.id}:${si}`));
      const stops = pages.map((p, j) => {
        const idx = s.start + j;
        return `<li><button class="stop ${idx === curIdx ? 'cur' : ''} ${seen.has(p.id) ? 'seen' : ''}" data-act="goto" data-pid="${p.id}" ${idx === curIdx ? 'aria-current="page"' : ''}>
          <span class="pn pk-${kindOf(p.type)}">${idx + 1}</span><span class="sl">${esc(stopLabel(p))}</span></button></li>`;
      }).join('');
      return `<li class="sgroup ${here ? 'here' : ''}"><details data-sect="${t.id}:${si}" ${open ? 'open' : ''}>
        <summary class="sh"><span class="snum">${step > 0 ? step : ''}</span><span class="stitle">${esc(head)}${star}</span><span class="scount ${done === pages.length ? 'full' : ''}">${done === pages.length ? '✓' : `${done}/${pages.length}`}</span></summary>
        <ol>${stops}</ol></details></li>`;
    }).join('');
    const pq = prog;
    const qs = `<li class="sgroup"><div class="sh"><span class="snum"></span><span class="stitle">Practice</span></div><ol>
      <li><button class="stop ${curIdx < 0 ? 'cur' : ''}" data-act="quiz-start" data-topic="${t.id}" data-mode="quiz"><span class="pn pk-quiz">Q</span><span class="sl">Quiz · ${quizKeys(t).length} Qs · best ${bestTxt(pq.quizBest, quizKeys(t).length)}</span></button></li>
    </ol></li>`;
    return `<aside class="side ${ui.side ? 'open' : ''}" aria-label="Chapter stops">
      <div class="sidehead"><b><span class="scode">${esc(t.code)}</span> ${esc(t.title)}</b><span class="mono muted">${curIdx < 0 ? 'Quiz' : `${curIdx + 1}/${t.pages.length}`}</span>
        <button class="chipbtn sideclose" data-act="side" aria-label="Close">✕</button></div>
      <div class="pklegend">${KIND_LEGEND.map(([k, l]) => `<span class="pk-${k}"><span class="pdot"></span>${l}</span>`).join('')}</div>
      <ol class="stops">${groups}${qs}</ol></aside>
      <div class="scrim ${ui.side ? 'open' : ''}" data-act="side"></div>`;
  }

  function pageIndex() {
    const t = ui.topic;
    const i = t.pages.findIndex((p) => p.id === prog.pageId);
    return i < 0 ? 0 : i;
  }

  function renderLesson() {
    const t = ui.topic;
    const i = pageIndex();
    const p = t.pages[i];
    const pct = ((i + 1) / t.pages.length) * 100;
    const last = i === t.pages.length - 1;
    $app.innerHTML = `<div class="shell ${G.sideHidden ? 'collapsed' : ''}">${sidebar(t, i)}<div class="content">
      ${header(`<b>${esc(t.code)} ${esc(t.title)}</b> · ${esc(p.part || '')} · ${i + 1}/${t.pages.length}`, pct, { side: true })}
      <main class="wrap stack" data-kind="${kindOf(p.type)}">${renderPage(p)}${moreHtml(p)}</main>
      <nav class="nav"><div class="wrap">
        <button class="btn ghost" data-act="prev" ${i === 0 ? 'disabled' : ''}>Back</button>
        ${last ? `<button class="btn" data-act="quiz-start" data-topic="${t.id}" data-mode="quiz">Quiz</button>` : '<button class="btn" data-act="next">Next</button>'}
      </div></nav></div></div>`;
    const cur = $app.querySelector('.side .stop.cur');
    if (cur) cur.scrollIntoView({ block: 'center' });
    window.scrollTo(0, 0);
  }

  // ── Attempts: quiz | exam (per chapter), review | drill (across chapters)
  const MODE = { quiz: 'Quiz', exam: 'Quiz', review: 'Due review', drill: 'Mixed drill' };
  function curAttempt() {
    if (ui.mode === 'quiz' || ui.mode === 'exam') return (prog.attempts || {})[ui.mode];
    return G.attempt;
  }
  function saveAttempt() { if (ui.mode === 'quiz' || ui.mode === 'exam') save(); else saveG(); }
  const attemptQs = (a) => a.refs.filter((k) => QINDEX[k]).map((k) => ({ key: k, ...QINDEX[k] }));

  function newAttempt(mode, refs) {
    const a = { mode, refs, answers: {}, conf: {}, seed: Math.floor(Math.random() * 100000) + 1, submitted: false };
    if (mode === 'quiz' || mode === 'exam') { prog.attempts = prog.attempts || {}; prog.attempts[mode] = a; save(); } else { G.attempt = a; saveG(); }
    ui.mode = mode;
    ui.qIndex = 0;
    ui.confirmSubmit = false;
  }

  // Chapter quiz screens sit in the lesson shell, so the sidebar (☰) leads back to any page.
  const chapterMode = () => ui.mode === 'quiz' || ui.mode === 'exam';
  const shell = (inner) => (chapterMode() && ui.topic
    ? `<div class="shell ${G.sideHidden ? 'collapsed' : ''}">${sidebar(ui.topic, -1)}<div class="content">${inner}</div></div>`
    : inner);

  const optOrder = (q, k, seed) => (isOfficial(q) ? [0, 1, 2, 3] : shuffled(4, seed + k * 31));
  const optBody = (o) => (o.je ? jeTable(o.je) : `<span>${md(o.t)}</span>`);

  function renderPre() {
    const t = ui.topic;
    const mode = ui.preMode;
    const set = t[mode];
    $app.innerHTML = shell(`${header(`<b>${esc(t.code)} ${esc(MODE[mode])}</b> · before you start`, undefined, { side: true })}
      <main class="wrap stack">${examTypesHtml(t, prog)}
        <div class="card stack"><p class="prompt">${esc(MODE[mode])}: ${quizKeys(t).length} questions</p>
          <p class="muted">${t.exam ? `The last ${t.exam.questions.length} are harder, multi-step ones, marked ▲ Hard. ` : ''}Not timed. Four-option MCQs, mostly in case sets. Move between questions freely. Tap Check answer to see the answer and explanations straight away (your answer then locks), or wait for the full feedback when you submit. Tap how sure you are under each answer: a lucky guess still comes back for review.</p>
          <div class="row"><button class="btn" data-act="attempt-begin">Start</button><button class="btn ghost" data-act="lesson" data-topic="${t.id}">Back to lesson</button></div></div>
      </main>`);
  }

  function renderAttempt() {
    const a = curAttempt();
    const qs = attemptQs(a);
    const k = Math.min(ui.qIndex, qs.length - 1);
    const { key, q, c, t, set } = qs[k];
    const ans = a.answers;
    const answeredCount = qs.filter((x) => ans[x.key] !== undefined).length;
    // Checked early: the answer locks and every option shows its explanation, as on the results page.
    const shown = !!(a.checked && a.checked[key]);
    const ci = C.correctIndex(q);
    const mark = (oi) => (!shown ? (ans[key] === oi ? 'sel' : '') : oi === ci ? 'right' : oi === ans[key] ? 'wrong' : '');
    const opts = optOrder(q, k, a.seed).map((oi, pos) => `<button class="opt ${mark(oi)}" data-act="qpick" data-q="${esc(key)}" data-o="${oi}" ${shown ? 'disabled' : ''}>
        <span class="mk">${shown && oi === ci ? '✓' : shown && oi === ans[key] ? '✗' : `${String.fromCharCode(65 + pos)}.`}</span><span class="tx">${optBody(q.options[oi])}${shown ? `<span class="why">${md(q.options[oi].why)}</span>` : ''}</span></button>`).join('');
    const mine = ans[key];
    const pit = shown && mine !== undefined && mine !== ci && q.options[mine].pit && t.pitfalls ? t.pitfalls[q.options[mine].pit] : '';
    const check = shown
      ? `<div class="row">${mine === ci ? '<span class="badge ok">✓ Right</span>' : `<span class="badge no">✗ ${mine === undefined ? 'Not answered' : 'Not quite'}</span>`}<span class="muted" style="font-size:.85rem">Answer locked; it counts when you submit.</span></div>${pit ? `<p class="trap">${md(pit)}</p>` : ''}`
      : `<div><button class="btn ghost" data-act="qcheck" data-q="${esc(key)}">${mine === undefined ? 'Show answer' : 'Check answer'}</button>${mine === undefined ? ' <span class="muted" style="font-size:.85rem">counts as wrong</span>' : ''}</div>`;
    const conf = a.conf[key];
    const unanswered = qs.length - answeredCount;
    // Cases start open; one the reader closed stays closed when a tap (pick, check, submit) re-renders the page.
    const caseOpen = !(ui.caseOpen && ui.caseOpen[key] === false);
    const title = ui.mode === 'quiz' || ui.mode === 'exam' ? `${esc(ui.topic.code)} ${MODE[ui.mode]}` : MODE[ui.mode];
    $app.innerHTML = shell(`${header(`<b>${title}</b> · Question ${k + 1} of ${qs.length}`, (answeredCount / qs.length) * 100, { side: chapterMode() })}
      <main class="wrap stack">
        ${ui.mode === 'review' || ui.mode === 'drill' ? `<span class="src">${esc(t.code)} ${esc(t.title)}</span>` : ''}
        ${c ? `<details class="case" data-qk="${esc(key)}" ${caseOpen ? 'open' : ''}><summary>Case: ${esc(c.name)}</summary>
          <div class="stack">${c.source ? `<span class="src">${esc(c.source)}</span>` : ''}${c.text.map((x) => `<p>${md(x)}</p>`).join('')}</div></details>` : ''}
        ${q.source || set === 'exam' ? `<div class="row" style="gap:8px">${hardTag(set)}${q.source ? `<span class="src">${esc(q.source)}</span>` : ''}</div>` : ''}
        <p class="prompt">${md(q.q)}</p>
        <div class="opts" role="radiogroup">${opts}</div>
        ${check}
        <div class="conf" role="group" aria-label="How sure are you?"><span class="muted">How sure?</span>
          ${['sure', 'unsure', 'guess'].map((v) => `<button class="chipbtn ${conf === v ? 'on' : ''}" data-act="qconf" data-q="${esc(key)}" data-v="${v}" aria-pressed="${conf === v}">${v[0].toUpperCase() + v.slice(1)}</button>`).join('')}</div>
        <div class="qdots" aria-label="Jump to question">${qs.map((x, j) => `<button class="${ans[x.key] !== undefined ? 'done' : ''} ${j === k ? 'cur' : ''}" data-act="qgo" data-k="${j}" aria-label="Question ${j + 1}">${j + 1}</button>`).join('')}</div>
        ${ui.confirmSubmit ? `<div class="confirm stack"><p>${unanswered ? `${unanswered} question${unanswered === 1 ? ' is' : 's are'} unanswered and will be marked wrong.` : 'All questions answered.'} Submit now?</p>
          <div class="row"><button class="btn" data-act="qsubmit-yes">Submit</button><button class="btn ghost" data-act="qsubmit-no">Keep going</button></div></div>`
          : '<div><button class="btn ghost" data-act="qsubmit">Submit</button></div>'}
      </main>
      <nav class="nav"><div class="wrap">
        <button class="btn ghost" data-act="qprev" ${k === 0 ? 'disabled' : ''}>Back</button>
        ${k === qs.length - 1 ? '<button class="btn" data-act="qsubmit">Submit</button>' : '<button class="btn" data-act="qnext">Next</button>'}
      </div></nav>`);
  }

  function submitAttempt() {
    const a = curAttempt();
    a.submitted = true;
    const now = today();
    G.review = G.review || {};
    G.pits = G.pits || {};
    const typesByTopic = {};
    for (const { key, q, t, set } of attemptQs(a)) {
      const mine = a.answers[key];
      const correct = mine === C.correctIndex(q);
      G.review = C.reviewUpdate(G.review, key, { correct, conf: a.conf[key] }, now);
      const pit = mine !== undefined && q.options[mine].pit;
      if (!correct && pit) G.pits[`${t.id}:${pit}`] = (G.pits[`${t.id}:${pit}`] || 0) + 1;
      if (q.type && (set === 'quiz' || set === 'exam')) (typesByTopic[t.id] = typesByTopic[t.id] || new Set()).add(q.type);
    }
    // Exam-type ticks belong to each chapter's own progress.
    for (const [tid, types] of Object.entries(typesByTopic)) {
      const p = tid === (ui.topic && ui.topic.id) ? prog : loadProg(tid);
      p.typesDone = [...new Set([...(p.typesDone || []), ...types])];
      if (p !== prog) st(tid).save(p);
    }
    if (ui.mode === 'quiz' || ui.mode === 'exam') {
      const qs = attemptQs(a);
      const s = C.scoreQuiz(qs.map((x) => ({ ...x.q, id: x.key })), a.answers);
      const bk = ui.mode === 'quiz' ? 'quizBest' : 'examBest';
      if (qs.length === quizKeys(ui.topic).length && (!prog[bk] || prog[bk].total !== s.total || s.correct > prog[bk].correct)) prog[bk] = { correct: s.correct, total: s.total };
      save();
    }
    saveG();
  }

  function renderResults() {
    const a = curAttempt();
    const qs = attemptQs(a);
    const ans = a.answers;
    const s = C.scoreQuiz(qs.map((x) => ({ ...x.q, id: x.key, lo: ui.mode === 'review' || ui.mode === 'drill' ? x.t.code : x.q.lo })), ans);
    const perTopic = ui.mode === 'review' || ui.mode === 'drill';
    const los = Object.entries(s.byLO).map(([lo, v]) => {
      const label = perTopic ? `${lo} ${esc((topicByCode(lo) || {}).title || '')}` : `LO ${lo} · ${esc(ui.topic.los[lo])}`;
      return `<div class="lorow"><span>${label}</span><span class="mono" style="text-align:right">${v.correct}/${v.total}</span><div class="bar"><i style="width:${(v.correct / v.total) * 100}%"></i></div></div>`;
    }).join('');
    let guessedRight = 0;
    let sureWrong = 0;
    for (const x of qs) {
      const ok = ans[x.key] === C.correctIndex(x.q);
      if (ok && a.conf[x.key] === 'guess') guessedRight++;
      if (!ok && a.conf[x.key] === 'sure') sureWrong++;
    }
    const review = qs.map((x, j) => {
      const { q, t, c, set } = x;
      const ci = C.correctIndex(q);
      const mine = ans[x.key];
      const ok = mine === ci;
      const pit = !ok && mine !== undefined && q.options[mine].pit && t.pitfalls ? t.pitfalls[q.options[mine].pit] : '';
      const cf = a.conf[x.key];
      return `<article class="card stack" style="gap:10px">
        <div class="row" style="justify-content:space-between"><span class="src">Q${j + 1} · ${perTopic ? esc(t.code) : `LO ${q.lo}`}${c ? ` · ${esc(c.name)}` : ''}${cf ? ` · you said ${cf}` : ''}</span><span class="row" style="gap:6px">${hardTag(set)}${ok ? '<span class="badge ok">✓</span>' : '<span class="badge no">✗</span>'}</span></div>
        <p style="font-weight:600">${md(q.q)}</p>
        ${!ok ? `<div class="opt wrong" style="cursor:default"><span class="mk">✗</span><span class="tx"><span class="muted" style="font-size:.8rem">Your answer</span>${mine === undefined ? '<span>Not answered</span>' : `${optBody(q.options[mine])}<span class="why">${md(q.options[mine].why)}</span>`}</span></div>` : ''}
        ${pit ? `<p class="trap">${md(pit)}</p>` : ''}
        <div class="opt right" style="cursor:default"><span class="mk">✓</span><span class="tx"><span class="muted" style="font-size:.8rem">Correct answer</span>${optBody(q.options[ci])}<span class="why">${md(q.options[ci].why)}</span></span></div>
      </article>`;
    }).join('');
    const title = perTopic ? MODE[ui.mode] : `${esc(ui.topic.code)} ${MODE[ui.mode]}`;
    const again = perTopic ? (ui.mode === 'drill' ? '<button class="btn ghost" data-act="drill-start">New drill</button>' : '')
      : `<button class="btn ghost" data-act="quiz-start" data-topic="${ui.topic.id}" data-mode="${ui.mode}" data-fresh="1">Retake full quiz</button>
         <button class="btn ghost" data-act="lesson" data-topic="${ui.topic.id}">Back to lesson</button>`;
    $app.innerHTML = shell(`${header(`<b>${title}</b> · Results`, undefined, { side: chapterMode() })}
      <main class="wrap stack" style="gap:18px">
        <div class="row" style="align-items:baseline;gap:14px"><span class="score">${s.correct}/${s.total}</span><span class="muted">${Math.round((s.correct / s.total) * 100)}%</span></div>
        ${guessedRight || sureWrong ? `<div class="card stack" style="gap:6px"><span class="eyebrow">How sure were you?</span>
          ${guessedRight ? `<p>Right but guessed: <b>${guessedRight}</b>. They come back tomorrow, so the knowledge sticks.</p>` : ''}
          ${sureWrong ? `<p>Wrong but sure: <b>${sureWrong}</b>. These are the dangerous ones; read their explanations twice.</p>` : ''}</div>` : ''}
        <div class="stack" style="gap:10px">${los}</div>
        <div class="row">
          ${s.missed.length ? `<button class="btn" data-act="quiz-retry">Retry the ${s.missed.length} I missed</button>` : ''}
          ${again}<button class="btn ghost" data-act="home">Home</button>
        </div>
        <h2>Review</h2>
        ${review}
      </main>`);
  }

  function render() {
    if (ui.view === 'home') renderHome();
    else if (ui.view === 'lesson') renderLesson();
    else if (ui.view === 'pre') renderPre();
    else if (ui.view === 'attempt') renderAttempt();
    else if (ui.view === 'results') renderResults();
    lightDiagrams();
  }

  function lightDiagrams() {
    // Charts wider than the screen scroll sideways; say so.
    document.querySelectorAll('.diagram-wrap').forEach((w) => w.classList.toggle('scrolls', w.scrollWidth > w.clientWidth + 4));
    document.querySelectorAll('.diagram').forEach((d) => {
      const hl = new Set((d.dataset.hl || '').split('|').filter(Boolean));
      d.querySelectorAll('g.node').forEach((g) => {
        const id = (g.querySelector('title') || {}).textContent;
        g.classList.toggle('hl', hl.has(id));
        const p = ui.topic && d.dataset.pid ? ui.topic.pages.find((x) => x.id === d.dataset.pid) : null;
        g.classList.toggle('tap', !!(p && p.notes && p.notes[id]));
      });
    });
  }

  function go(view, scrollTop = true) {
    ui.view = view;
    render();
    if (scrollTop) window.scrollTo(0, 0);
  }

  function openTopic(id) {
    ui.topic = topicById(id);
    prog = loadProg(id);
  }

  function gotoPage(pid) {
    prog.pageId = pid;
    prog.seen = [...new Set([...(prog.seen || []), pid])];
    save();
    ui.side = false;
    go('lesson');
  }

  // ── Events
  $app.addEventListener('click', (e) => {
    // Tapping a box in a chart shows its note.
    const g = e.target.closest('.diagram[data-pid] g.node');
    if (g) {
      const pid = g.closest('.diagram').dataset.pid;
      const node = (g.querySelector('title') || {}).textContent;
      const p = ui.topic.pages.find((x) => x.id === pid);
      if (p && p.notes && p.notes[node]) { ui.diagSel = ui.diagSel && ui.diagSel.node === node ? null : { pid, node }; if (prog.walk) delete prog.walk[pid]; return render(); }
    }
    const b = e.target.closest('[data-act]');
    if (!b) return;
    const act = b.dataset.act;
    const i = b.dataset.i;
    if (act === 'home') { ui.legend = false; ui.side = false; return go('home'); }
    if (act === 'legend') { ui.legend = !ui.legend; return render(); }
    if (act === 'side') {
      // Wide screens: the sidebar is a column that can be hidden. Phones: it is a drawer.
      if (window.matchMedia('(min-width: 900px)').matches) { G.sideHidden = !G.sideHidden; saveG(); $app.querySelector('.shell').classList.toggle('collapsed', G.sideHidden); return; }
      ui.side = !ui.side; $app.querySelector('.side').classList.toggle('open', ui.side); $app.querySelector('.scrim').classList.toggle('open', ui.side); return;
    }
    if (act === 'lesson') {
      openTopic(b.dataset.topic);
      return gotoPage(ui.topic.pages[pageIndex()].id);
    }
    if (act === 'goto') {
      if (b.dataset.topic && (!ui.topic || ui.topic.id !== b.dataset.topic)) openTopic(b.dataset.topic);
      return gotoPage(b.dataset.pid);
    }
    if (act === 'goto-bucket') {
      const s = C.sections(ui.topic).find((x) => x.bucket === b.dataset.b);
      if (s) return gotoPage(ui.topic.pages[s.start].id);
      return;
    }
    if (act === 'next' || act === 'prev') {
      const j = Math.max(0, Math.min(ui.topic.pages.length - 1, pageIndex() + (act === 'next' ? 1 : -1)));
      return gotoPage(ui.topic.pages[j].id);
    }
    if (act === 'reveal') { prog.revealed = { ...(prog.revealed || {}), [i]: true }; save(); return render(); }
    if (act === 'mcq') { prog.mcq = { ...(prog.mcq || {}), [i]: Number(b.dataset.o) }; save(); return render(); }
    if (act === 'calc-check' || act === 'calc-show') {
      prog.calc = prog.calc || {};
      const c = prog.calc[i] || {};
      if (act === 'calc-check') { c.value = document.getElementById(`calc-${i}`).value; c.checked = true; } else c.shown = true;
      prog.calc[i] = c; save(); return render();
    }
    if (act === 'je-add') { prog.je[i].rows.push({ side: 'Cr', account: '', amount: '' }); prog.je[i].checked = false; save(); return render(); }
    if (act === 'je-del') { prog.je[i].rows.splice(Number(b.dataset.r), 1); prog.je[i].checked = false; save(); return render(); }
    if (act === 'je-check') { prog.je[i].checked = true; save(); return render(); }
    if (act === 'je-show') { prog.je[i].shown = true; save(); return render(); }
    if (act === 'tree-pick') { prog.tree = prog.tree || {}; prog.tree[i] = [...(prog.tree[i] || []), Number(b.dataset.o)]; save(); return render(); }
    if (act === 'tree-back') { prog.tree[i] = (prog.tree[i] || []).slice(0, -1); save(); return render(); }
    if (act === 'tree-reset') { prog.tree[i] = []; save(); return render(); }
    if (act === 'walk') { prog.walk = prog.walk || {}; const w = prog.walk[i]; prog.walk[i] = w === undefined ? 0 : w + Number(b.dataset.d); ui.diagSel = null; save(); return render(); }
    if (act === 'walk-reset') { delete prog.walk[i]; save(); return render(); }
    if (act === 'worked-next') { prog.worked = prog.worked || {}; prog.worked[i] = (prog.worked[i] || 0) + 1; save(); return render(); }
    if (act === 'worked-all') { const p = ui.topic.pages.find((x) => x.id === i); prog.worked = prog.worked || {}; prog.worked[i] = p.steps.length; save(); return render(); }
    if (act === 'row-next' || act === 'row-all') {
      const hidden = [...document.querySelectorAll('table.reveal-rows tr.hide')];
      (act === 'row-all' ? hidden : hidden.slice(0, 1)).forEach((r) => r.classList.remove('hide'));
      // The takeaway under a comparison waits until every row is out, so it doesn't give the answer away.
      if (!document.querySelector('table.reveal-rows tr.hide')) document.querySelectorAll('.after-rows').forEach((el) => { el.hidden = false; });
      return;
    }
    if (act === 'quiz-start') {
      openTopic(b.dataset.topic || ui.topic.id);
      const mode = b.dataset.mode || 'quiz';
      ui.mode = mode;
      const a = (prog.attempts || {})[mode];
      const full = quizKeys(ui.topic);
      const resuming = !b.dataset.fresh && a && !a.submitted && a.refs.length === full.length;
      ui.side = false;
      if (resuming) { ui.qIndex = Math.max(0, attemptQs(a).findIndex((x) => a.answers[x.key] === undefined)); ui.confirmSubmit = false; return go('attempt'); }
      ui.preMode = mode;
      return go('pre');
    }
    if (act === 'attempt-begin') { newAttempt(ui.preMode, quizKeys(ui.topic)); return go('attempt'); }
    if (act === 'review-start') {
      const due = C.dueReviews(G.review, today(), (k) => !!QINDEX[k]);
      if (!due.length) return;
      newAttempt('review', due); return go('attempt');
    }
    if (act === 'drill-start') { newAttempt('drill', C.pickDrill(Object.keys(QINDEX), 10)); return go('attempt'); }
    if (act === 'quiz-retry') {
      const a = curAttempt();
      const missed = attemptQs(a).filter((x) => a.answers[x.key] !== C.correctIndex(x.q)).map((x) => x.key);
      newAttempt(ui.mode, missed); return go('attempt');
    }
    if (act === 'qpick') { const a = curAttempt(); if (a.checked && a.checked[b.dataset.q]) return; a.answers[b.dataset.q] = Number(b.dataset.o); saveAttempt(); return go('attempt', false); }
    if (act === 'qcheck') { const a = curAttempt(); a.checked = a.checked || {}; a.checked[b.dataset.q] = true; saveAttempt(); return go('attempt', false); }
    if (act === 'qconf') {
      const a = curAttempt();
      a.conf[b.dataset.q] = a.conf[b.dataset.q] === b.dataset.v ? undefined : b.dataset.v;
      saveAttempt(); return go('attempt', false);
    }
    if (act === 'qgo') { ui.qIndex = Number(b.dataset.k); ui.confirmSubmit = false; return go('attempt'); }
    if (act === 'qnext') { ui.qIndex++; ui.confirmSubmit = false; return go('attempt'); }
    if (act === 'qprev') { ui.qIndex--; ui.confirmSubmit = false; return go('attempt'); }
    if (act === 'qsubmit') { ui.confirmSubmit = true; render(); const el = document.querySelector('.confirm'); if (el) el.scrollIntoView({ block: 'center' }); return; }
    if (act === 'qsubmit-no') { ui.confirmSubmit = false; return render(); }
    if (act === 'qsubmit-yes') { submitAttempt(); ui.confirmSubmit = false; return go('results'); }
  });

  $app.addEventListener('scroll', (e) => {
    const w = e.target;
    if (w.classList && w.classList.contains('diagram-wrap')) w.classList.toggle('atend', w.scrollLeft + w.clientWidth >= w.scrollWidth - 4);
  }, true);
  $app.addEventListener('toggle', (e) => {
    const d = e.target;
    if (d.classList && d.classList.contains('whole')) { ui.treeOpen = d.open; return; }
    if (d.classList && d.classList.contains('case')) { ui.caseOpen = { ...(ui.caseOpen || {}), [d.dataset.qk]: d.open }; return; }
    if (!d.dataset || !d.dataset.sect) return;
    ui.openSects = ui.openSects || new Set();
    if (d.open) ui.openSects.add(d.dataset.sect); else ui.openSects.delete(d.dataset.sect);
  }, true);

  // Typing: keep state without re-rendering (so the keyboard stays open).
  $app.addEventListener('input', (e) => {
    const el = e.target;
    if (el.dataset.think !== undefined) { prog.think = { ...(prog.think || {}), [el.dataset.think]: el.value }; save(); }
    if (el.dataset.calc !== undefined) { prog.calc = prog.calc || {}; prog.calc[el.dataset.calc] = { ...(prog.calc[el.dataset.calc] || {}), value: el.value }; save(); }
    if (el.dataset.je !== undefined && el.dataset.f === 'amount') { const s = prog.je[el.dataset.je]; s.rows[el.dataset.r].amount = el.value; s.checked = false; save(); }
  });
  $app.addEventListener('change', (e) => {
    const el = e.target;
    if (el.dataset.je !== undefined && el.dataset.f !== 'amount') {
      const s = prog.je[el.dataset.je]; s.rows[el.dataset.r][el.dataset.f] = el.value; s.checked = false; save(); render();
    }
  });

  // Hide table rows after the first, so tables fill in row by row.
  const observer = new MutationObserver(() => {
    document.querySelectorAll('table.reveal-rows:not([data-ready])').forEach((tb) => {
      tb.dataset.ready = '1';
      tb.querySelectorAll('tbody tr').forEach((r, j) => { if (j > 0) r.classList.add('hide'); });
    });
    if (window.StudyWidgets) window.StudyWidgets.mount($app);
  });
  observer.observe($app, { childList: true, subtree: true });

  render();
})();

</script>
