7\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"87.62,-44.1 85.52,-38.1 83.42,-44.1 87.62,-44.1\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"116.27\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> next opening \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"visual-li59wn","type":"visual","bucket":"subsequent","lo":36,"title":"The premium bond at amortised cost, year by year","html":"\u003cp>The diagram did one year; this table runs the same engine for all 3 years of the premium bond (face 1,000,000, coupon 8%, effective 6%). Each row’s \u003cspan class=\"el el-l\">closing\u003c/span> is the next row’s \u003cspan class=\"el el-l\">opening\u003c/span>.\u003c/p>\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num reveal-rows\">\u003cthead>\u003ctr>\u003cth>Year\u003c/th>\u003cth>\u003cspan class=\"el el-l\">Opening\u003c/span>\u003c/th>\u003cth>\u003cspan class=\"el el-x\">Interest expense\u003c/span> (6%)\u003c/th>\u003cth>\u003cspan class=\"el el-a\">Cash paid\u003c/span> (8%)\u003c/th>\u003cth>\u003cspan class=\"el el-l\">Premium amortised\u003c/span>\u003c/th>\u003cth>\u003cspan class=\"el el-l\">Closing\u003c/span>\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\u003ctr>\u003ctd>20X1\u003c/td>\u003ctd>1,053,460\u003c/td>\u003ctd>63,208\u003c/td>\u003ctd>80,000\u003c/td>\u003ctd>16,792\u003c/td>\u003ctd>1,036,668\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X2\u003c/td>\u003ctd>1,036,668\u003c/td>\u003ctd>62,200\u003c/td>\u003ctd>80,000\u003c/td>\u003ctd>17,800\u003c/td>\u003ctd>1,018,868\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X3\u003c/td>\u003ctd>1,018,868\u003c/td>\u003ctd>61,132\u003c/td>\u003ctd>80,000\u003c/td>\u003ctd>18,868\u003c/td>\u003ctd>1,000,000\u003c/td>\u003c/tr>\u003c/tbody>\u003c/table>\u003c/div>\u003cp class=\"cap\">\u003cspan class=\"el el-x\">Total interest\u003c/span> is $186,540: \u003cspan class=\"el el-a\">three coupons\u003c/span> of 80,000 \u003cstrong>less\u003c/strong> the 53,460 \u003cspan class=\"el el-l\">premium\u003c/span>. The \u003cspan class=\"el el-x\">expense\u003c/span> falls each year because the \u003cspan class=\"el el-l\">carrying amount\u003c/span> does. The final year is rounded so the bond ends at exactly 1,000,000.\u003c/p>","sect":4,"part":"Subsequent measurement"},{"type":"worked","bucket":"subsequent","lo":36,"title":"Worked: years 1 and 2 at amortised cost","q":"Bond issued on 1 Jan 20X1 for $1,053,460; face $1,000,000; coupon 8% paid each 31 Dec; effective rate 6%. Record the interest entries for 20X1 and 20X2.","intro":["A typical exam question: you get the issue price, the coupon and the effective rate, and must give the interest entries or a carrying amount. Remember two things:","- {x|Interest expense} = **effective rate × {l|opening carrying amount}**, never face × coupon.","- The coupon is just the {a|cash paid}. The gap between the two comes off (premium) or is added to (discount) the {l|liability}.","Then follow the same steps every year: interest → coupon → difference → entry → closing."],"steps":[{"h":"Calculate the 20X1 interest expense.","t":"{x|Interest expense} = {l|opening 1,053,460} × 6% = **{x|63,208}**"},{"h":"Work out the coupon cash paid.","t":"{a|Cash paid} = face 1,000,000 × coupon 8% = **{a|80,000}**"},{"h":"Find the difference: the premium amortised.","t":"80,000 − 63,208 = **16,792**. The {a|cash} exceeds the {x|expense}, so the excess repays part of the {l|premium} and reduces {l|Bonds payable}."},{"h":"Record the 31 Dec 20X1 entry.","je":[{"side":"Dr","account":"Interest expense","amount":63208},{"side":"Dr","account":"Bonds payable","amount":16792},{"side":"Cr","account":"Cash","amount":80000}]},{"h":"Roll forward to the closing carrying amount.","t":"{l|Closing 20X1} = {l|1,053,460} + {x|63,208} − {a|80,000} = **{l|1,036,668}**. This is 20X2’s opening."},{"h":"Repeat steps 1–3 for 20X2, from the new opening.","t":["{x|Interest expense} = {l|1,036,668} × 6% = **{x|62,200}**","{a|Cash paid} = **{a|80,000}** (the same every year)","{l|Premium} amortised = 80,000 − 62,200 = **17,800**"]},{"h":"Record the 31 Dec 20X2 entry and the closing amount.","je":[{"side":"Dr","account":"Interest expense","amount":62200},{"side":"Dr","account":"Bonds payable","amount":17800},{"side":"Cr","account":"Cash","amount":80000}],"after":"{l|Closing 20X2} = {l|1,036,668} + {x|62,200} − {a|80,000} = **{l|1,018,868}**. Fair value changes are ignored under amortised cost."}],"id":"worked-6mzmwn","sect":4,"part":"Subsequent measurement"},{"id":"je-16029a","type":"je","bucket":"subsequent","lo":36,"q":"Your turn, with the {a|cash} line filled in. A 3-year bond issued at a premium on 1 Jan 20X1 (face $1,000,000, coupon 8% paid each 31 Dec, effective rate 6%) is in its final year. Record the 20X3 interest ({l|opening carrying amount} $1,018,868; {x|interest expense} is rounded to $61,132 so the bond ends at face value).","accounts":["Bonds payable","Cash","Interest expense","Premium on bonds payable","Discount on bonds payable","Interest payable","Interest income","Prepaid issue costs"],"given":[2],"lines":[{"side":"Dr","account":"Interest expense","amount":61132},{"side":"Dr","account":"Bonds payable","amount":18868},{"side":"Cr","account":"Cash","amount":80000}],"why":"{l|Opening} 1,018,868 + {x|interest} 61,132 − {a|cash} 80,000 = {l|closing} 1,000,000. On maturity: Dr {l|Bonds payable} 1,000,000, Cr {a|Cash} 1,000,000.","sect":4,"part":"Subsequent measurement"},{"type":"je","bucket":"subsequent","lo":36,"q":"A new bond, on your own. On 1 Jan 20X1 a company issues a 3-year bond for $473,270: face $500,000, coupon 4% paid each 31 Dec, effective rate 6%. Record the 31 Dec 20X1 interest entry.","accounts":["Bonds payable","Cash","Interest expense","Premium on bonds payable","Discount on bonds payable","Interest payable","Interest income","Prepaid issue costs"],"lines":[{"side":"Dr","account":"Interest expense","amount":28396},{"side":"Cr","account":"Cash","amount":20000},{"side":"Cr","account":"Bonds payable","amount":8396}],"why":"A **{l|discount}** bond (coupon 4% below the 6% market). {x|Expense} = 473,270 × 6% = 28,396, more than the 20,000 {a|cash}, so the 8,396 difference is added to the {l|liability} as it climbs towards 500,000.","id":"je-tlt626","sect":4,"part":"Subsequent measurement"},{"id":"diagram-i4g771","type":"visual","bucket":"subsequent","lo":36,"title":"Every road leads to face value","html":"\u003cp>Two bonds issued on the same day: same face $1,000,000, same 3 years, same 6% market rate. The notes bond pays 8% (issued at a \u003cspan class=\"el el-l\">premium\u003c/span>); its twin pays 4% (issued at a \u003cspan class=\"el el-l\">discount\u003c/span>). Step through the years and watch both \u003cspan class=\"el el-l\">carrying amounts\u003c/span> get pulled to face.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"par-b24\" data-cfg=\"{&quot;target&quot;:{&quot;v&quot;:1000000,&quot;label&quot;:&quot;face 1,000,000&quot;},&quot;panels&quot;:[{&quot;title&quot;:&quot;Premium bond&quot;,&quot;sub&quot;:&quot;coupon 8% · market 6%&quot;,&quot;el&quot;:&quot;l&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:1053460,&quot;startCap&quot;:&quot;Issued for {l|1,053,460}: above face, a **{l|premium}** of 53,460, because the coupon is more than the market rate.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:63208,&quot;cap&quot;:&quot;20X1: {x|interest expense} = {l|opening 1,053,460} × 6% = {x|63,208}. It adds to what is owed.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-80000,&quot;cap&quot;:&quot;{a|Coupon cash} 80,000 is paid, so {l|closing} = {l|1,036,668}. The coupon beat {x|interest} by 16,792: the {l|liability} **falls**.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:62200,&quot;cap&quot;:&quot;20X2: {x|interest expense} = {l|opening 1,036,668} × 6% = {x|62,200}. It adds to what is owed.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-80000,&quot;cap&quot;:&quot;{a|Coupon cash} 80,000 is paid, so {l|closing} = {l|1,018,868}. The coupon beat {x|interest} by 17,800: the {l|liability} **falls**.&quot;}]},{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:61132,&quot;cap&quot;:&quot;20X3: {x|interest expense} = {l|opening 1,018,868} × 6% = {x|61,132}. It adds to what is owed.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-80000,&quot;cap&quot;:&quot;{a|Coupon cash} 80,000 is paid, so {l|closing} = {l|1,000,000}. The coupon beat {x|interest} by 18,868: the {l|liability} **falls**. It lands on face value, ready to be repaid.&quot;}]}]},{&quot;title&quot;:&quot;Discount bond&quot;,&quot;sub&quot;:&quot;coupon 4% · market 6%&quot;,&quot;el&quot;:&quot;l&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:946540,&quot;startCap&quot;:&quot;Issued for {l|946,540}: below face, a **{l|discount}** of 53,460, because the coupon is less than the market rate.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:56792,&quot;cap&quot;:&quot;20X1: {x|interest expense} = {l|opening 946,540} × 6% = {x|56,792}. It adds to what is owed.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-40000,&quot;cap&quot;:&quot;{a|Coupon cash} 40,000 is paid, so {l|closing} = {l|963,332}. {x|Interest} beat the coupon by 16,792: the {l|liability} **climbs**.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:57800,&quot;cap&quot;:&quot;20X2: {x|interest expense} = {l|opening 963,332} × 6% = {x|57,800}. It adds to what is owed.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-40000,&quot;cap&quot;:&quot;{a|Coupon cash} 40,000 is paid, so {l|closing} = {l|981,132}. {x|Interest} beat the coupon by 17,800: the {l|liability} **climbs**.&quot;}]},{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:58868,&quot;cap&quot;:&quot;20X3: {x|interest expense} = {l|opening 981,132} × 6% = {x|58,868}. It adds to what is owed.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-40000,&quot;cap&quot;:&quot;{a|Coupon cash} 40,000 is paid, so {l|closing} = {l|1,000,000}. {x|Interest} beat the coupon by 18,868: the {l|liability} **climbs**. It lands on face value, ready to be repaid.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Same face, same 3 years, same 6% market rate. Only the coupon differs. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Step 1 each year: {x|interest expense} is always the **effective rate × {l|opening carrying amount}**.&quot;,&quot;Step 2: the coupon is {a|cash} paid, so it comes off the {l|liability}. What is left is next year’s {l|opening}.&quot;],&quot;end&quot;:&quot;**Mirror images.** The premium bond falls by 16,792, 17,800, 18,868; the discount bond climbs by the same amounts. So {x|interest expense} falls for one (63,208 → 61,132) and rises for the other (56,792 → 58,868). Both end at face: exactly what must be repaid.&quot;}}\">\u003c/div>","sect":4,"part":"Subsequent measurement"},{"type":"mcq","bucket":"subsequent","lo":36,"q":"A company issued bonds at a premium and measures them at amortised cost. How does the premium affect its financial statements over the bond’s term?","options":[{"t":"It is income in profit or loss on the issue date","why":"Receiving more {a|cash} on issue is not a {i|gain}: the company owes it back through higher coupons."},{"t":"It is amortised over the term and reduces interest expense each period","ok":true,"why":"{x|Interest expense} = {l|carrying amount} × effective rate, which is below the {a|coupon}. The difference amortises the {l|premium}."},{"t":"It stays in the liability until maturity, then is released to profit","why":"Amortised cost unwinds it every period, not in one go at the end."},{"t":"It increases interest expense over the term","why":"That is a {l|discount}. A {l|premium} reduces the {x|expense}."}],"id":"mcq-1lk0re","sect":4,"part":"Subsequent measurement"},{"id":"think-1ds1en","type":"think","bucket":"subsequent","lo":36,"scenario":"A company borrows $500,000 for 2 years. The bank deducts a $10,000 arrangement fee, so the loan (at amortised cost) starts at $490,000. The bank charges 5% ($25,000 a year) and gets $500,000 back after 2 years.","prompt":"What effective rate takes $490,000 back up to $500,000? What will total interest expense be over the 2 years?","answer":["The effective rate is the one that discounts the payments (25,000, then 525,000) to 490,000: about **6.0923%**. In the exam it is given, or you can price it from the factors.","{x|Total expense} = {a|cash interest} 50,000 + the fee 10,000 = **$60,000**. The fee reaches P&L after all, just spread over the life rather than dumped on day one."],"sect":4,"part":"Subsequent measurement"},{"id":"visual-1psv14","type":"visual","bucket":"subsequent","lo":36,"title":"The loan at amortised cost","html":"\u003cp>The same engine, now for the loan with the fee: it starts at \u003cspan class=\"el el-l\">490,000\u003c/span> and the effective rate (6.0923%) is above the 5% cash rate, so the \u003cspan class=\"el el-l\">loan\u003c/span> climbs to face like a discount bond.\u003c/p>\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num reveal-rows\">\u003cthead>\u003ctr>\u003cth>Year\u003c/th>\u003cth>\u003cspan class=\"el el-l\">Opening\u003c/span>\u003c/th>\u003cth>\u003cspan class=\"el el-x\">Interest expense\u003c/span> (6.0923%)\u003c/th>\u003cth>\u003cspan class=\"el el-a\">Cash paid\u003c/span> (5%)\u003c/th>\u003cth>\u003cspan class=\"el el-l\">Discount / costs unwound\u003c/span>\u003c/th>\u003cth>\u003cspan class=\"el el-l\">Closing\u003c/span>\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\u003ctr>\u003ctd>20X1\u003c/td>\u003ctd>490,000\u003c/td>\u003ctd>29,852\u003c/td>\u003ctd>25,000\u003c/td>\u003ctd>4,852\u003c/td>\u003ctd>494,852\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X2\u003c/td>\u003ctd>494,852\u003c/td>\u003ctd>30,148\u003c/td>\u003ctd>25,000\u003c/td>\u003ctd>5,148\u003c/td>\u003ctd>500,000\u003c/td>\u003c/tr>\u003c/tbody>\u003c/table>\u003c/div>\u003cp class=\"cap\">Year 1 \u003cspan class=\"el el-x\">interest\u003c/span>: \u003cspan class=\"el el-l\">opening\u003c/span> 490,000 × 6.0923% = 29,852. Year 2 is rounded to 30,148 so the \u003cspan class=\"el el-l\">loan\u003c/span> reaches exactly 500,000 before it is repaid. \u003cspan class=\"el el-x\">Total interest\u003c/span> 60,000 = 50,000 \u003cspan class=\"el el-a\">cash interest\u003c/span> + 10,000 fee.\u003c/p>","sect":4,"part":"Subsequent measurement"},{"type":"visual","bucket":"subsequent","lo":36,"title":"The fee, spread as interest, step by step","html":"\u003cp>The same 500,000 loan twice: once with the 10,000 fee deducted, once without. Step through both years and watch where the fee goes.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"loan-b24\" data-cfg=\"{&quot;target&quot;:{&quot;v&quot;:500000,&quot;label&quot;:&quot;face 500,000&quot;},&quot;panels&quot;:[{&quot;title&quot;:&quot;Loan with a fee&quot;,&quot;sub&quot;:&quot;effective 6.0923%&quot;,&quot;el&quot;:&quot;l&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:490000,&quot;startCap&quot;:&quot;Only {a|490,000} arrived (the bank kept 10,000), so the {l|loan} starts at {l|490,000}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;Year 1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:29852,&quot;cap&quot;:&quot;Year 1: {x|interest expense} = {l|opening 490,000} × 6.0923% = {x|29,852}, of which 4,852 is fee being spread.&quot;},{&quot;name&quot;:&quot;cash&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-25000,&quot;cap&quot;:&quot;{a|Cash interest} 25,000 is paid, so {l|closing} = {l|494,852}: the {l|loan} **climbs** towards face.&quot;}]},{&quot;label&quot;:&quot;Year 2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:30148,&quot;cap&quot;:&quot;Year 2: {x|interest expense} = {l|opening 494,852} × 6.0923% = {x|30,148} (rounded so the loan lands on face), of which 5,148 is fee being spread.&quot;},{&quot;name&quot;:&quot;cash&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-25000,&quot;cap&quot;:&quot;{a|Cash interest} 25,000 is paid, so {l|closing} = {l|500,000}: the {l|loan} **climbs** towards face.&quot;}]}]},{&quot;title&quot;:&quot;Same loan, no fee&quot;,&quot;sub&quot;:&quot;effective 5%&quot;,&quot;el&quot;:&quot;l&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:500000,&quot;startCap&quot;:&quot;All {a|500,000} arrived, so the {l|loan} starts at face, {l|500,000}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;Year 1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:25000,&quot;cap&quot;:&quot;Year 1: {x|interest expense} = {l|500,000} × 5% = {x|25,000}, the same as the cash.&quot;},{&quot;name&quot;:&quot;cash&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-25000,&quot;cap&quot;:&quot;{a|Cash interest} 25,000 is paid, so {l|closing} = {l|500,000}: **flat** all the way.&quot;}]},{&quot;label&quot;:&quot;Year 2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:25000,&quot;cap&quot;:&quot;Year 2: {x|interest expense} = {l|500,000} × 5% = {x|25,000}, the same as the cash.&quot;},{&quot;name&quot;:&quot;cash&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-25000,&quot;cap&quot;:&quot;{a|Cash interest} 25,000 is paid, so {l|closing} = {l|500,000}: **flat** all the way.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;The same 500,000 loan at 5% for 2 years, with and without the 10,000 arrangement fee. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Step 1 each year: {x|interest expense} = **effective rate × {l|opening carrying amount}**.&quot;,&quot;Step 2: the {a|cash interest} is paid and comes off the {l|loan}.&quot;],&quot;end&quot;:&quot;The fee never hit P&amp;L on day one. It came through as **extra {x|interest}**: 4,852 + 5,148 = 10,000, which is why the {l|loan} climbs from 490,000 to face. {x|Total interest} 60,000 vs 50,000.&quot;}}\">\u003c/div>","id":"visual-103fox","sect":4,"part":"Subsequent measurement"},{"id":"calc-13x0na","type":"calc","bucket":"subsequent","lo":36,"q":"On 1 January 20X1 a company borrows $500,000 for 2 years at 5% interest, paid each 31 December. The bank deducts a $10,000 arrangement fee, so the {l|loan} starts at $490,000; the effective rate is 6.0923%. What is the {l|carrying amount} of the loan at 31 December 20X1, after the first $25,000 {a|interest payment}?","answer":494852,"unit":"$","working":["{x|Interest expense} = 490,000 × 6.0923% = 29,852","{l|Closing} = {l|opening} 490,000 + {x|interest} 29,852 − {a|cash} 25,000 = **$494,852**","Still below 500,000: the rest of the fee unwinds in year 2."],"sect":4,"part":"Subsequent measurement"},{"type":"rule","bucket":"subsequent","lo":36,"title":"The same entries in “gross” form","body":["Up to now we kept the bond in one net {l|Bonds payable} figure. The exam often shows the same numbers split into two accounts, so here is the translation.","Some textbooks (and the exam) keep the face value in {l|Bonds payable} and hold the {l|premium} or {l|discount} in a separate account. The totals are identical; only the labels change.","1. **Issue at a premium:** Dr {a|Cash} 1,053,460; Cr {l|Bonds payable} 1,000,000; Cr {l|Premium on bonds payable} 53,460.","2. **Each interest date:** Dr {x|Interest expense} (effective); Dr {l|Premium on bonds payable} (the amortisation); Cr {a|Cash} (coupon paid).","3. **Discount:** Dr {l|Discount on bonds payable} on issue; each period Cr {l|Discount on bonds payable} for the unwinding.","+ {l|Net carrying amount} = {l|Bonds payable} + {l|unamortised premium} (or − {l|unamortised discount}).","! In a journal-entry question, the **{a|cash}** line is the coupon paid. An option that credits the {l|liability} for the coupon has not paid anyone."],"id":"rule-1ww5pz","sect":4,"part":"Subsequent measurement"},{"id":"je-17rxkd","type":"je","bucket":"subsequent","lo":36,"q":"A 3-year bond (face $1,000,000, coupon 8% paid each 31 Dec, effective rate 6%) was issued on 1 Jan 20X1 for $1,053,460. Record its 31 Dec 20X1 interest in **gross** form: face in {l|Bonds payable}, {l|premium} of $53,460 in {l|Premium on bonds payable}.","accounts":["Bonds payable","Cash","Interest expense","Premium on bonds payable","Discount on bonds payable","Interest payable","Interest income","Prepaid issue costs"],"lines":[{"side":"Dr","account":"Interest expense","amount":63208},{"side":"Dr","account":"Premium on bonds payable","amount":16792},{"side":"Cr","account":"Cash","amount":80000}],"why":"Same numbers as the net entry: {x|expense} 63,208, {a|cash} 80,000, and the 16,792 difference comes off the {l|premium}. {l|Bonds payable} stays at 1,000,000.","sect":4,"part":"Subsequent measurement"},{"type":"visual","bucket":"subsequent","lo":36,"title":"Gross form as layers","html":"\u003cp>The same bond in gross form, drawn to scale from zero. Each bar has two layers: the face value in \u003cspan class=\"el el-l\">Bonds payable\u003c/span>, which never moves, and the \u003cspan class=\"el el-l\">unamortised premium\u003c/span> (hatched), which shrinks by the amortisation each year. Together they are the \u003cspan class=\"el el-l\">net carrying amount\u003c/span> from the net method.\u003c/p>\u003cdiv class=\"cbars\">\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">1 Jan 20X1 (issue): \u003cspan class=\"el el-l\">1,000,000\u003c/span> + \u003cspan class=\"el el-l\">premium 53,460\u003c/span> = \u003cspan class=\"el el-l\">1,053,460\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg l\" style=\"width:94.93%\">\u003c/i>\u003ci class=\"seg out-l\" style=\"width:5.07%\">\u003c/i>\u003c/div>\u003c/div>\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">31 Dec 20X1: \u003cspan class=\"el el-l\">1,000,000\u003c/span> + \u003cspan class=\"el el-l\">premium 36,668\u003c/span> = \u003cspan class=\"el el-l\">1,036,668\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg l\" style=\"width:94.93%\">\u003c/i>\u003ci class=\"seg out-l\" style=\"width:3.48%\">\u003c/i>\u003c/div>\u003c/div>\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">31 Dec 20X2: \u003cspan class=\"el el-l\">1,000,000\u003c/span> + \u003cspan class=\"el el-l\">premium 18,868\u003c/span> = \u003cspan class=\"el el-l\">1,018,868\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg l\" style=\"width:94.93%\">\u003c/i>\u003ci class=\"seg out-l\" style=\"width:1.79%\">\u003c/i>\u003c/div>\u003c/div>\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">31 Dec 20X3 (before repayment): \u003cspan class=\"el el-l\">1,000,000\u003c/span> + \u003cspan class=\"el el-l\">premium 0\u003c/span> = \u003cspan class=\"el el-l\">1,000,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg l\" style=\"width:94.93%\">\u003c/i>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003ci class=\"seg l\">\u003c/i>\u003cspan class=\"el el-l\">Bonds payable\u003c/span> (face, never moves)\u003c/span>\u003cspan>\u003ci class=\"seg out-l\">\u003c/i>\u003cspan class=\"el el-l\">Premium on bonds payable\u003c/span> (melts away)\u003c/span>\u003c/div>\u003c/div>","id":"visual-1nafmb","sect":4,"part":"Subsequent measurement"},{"id":"think-16n4av","type":"think","bucket":"subsequent","lo":36,"scenario":"A bank designated a $2,000,000 note it issued at FVTPL on day one. During the year its **own** credit rating is downgraded. Investors now see its notes as riskier, so their fair value **falls**.","prompt":"A {l|liability} whose value falls produces a {i|gain}. Should the bank report a profit because it became a worse credit risk?","answer":["That would be absurd: the worse the bank’s credit, the better its {i|profit} would look. Bad news dressed up as good news.","So for liabilities **designated** at FVTPL, the part of the fair value change caused by the entity’s **own credit risk** goes to **OCI**, not P&L. The rest of the change (for example from market interest rates) still goes to P&L."],"sect":4,"part":"Subsequent measurement"},{"type":"rule","bucket":"subsequent","lo":36,"title":"FVTPL liabilities","body":["So far everything sat at amortised cost, the default. Now for the exception: {l|liabilities} at fair value through P&L, and the one twist (own credit) that stops a downgrade looking like a {i|profit}.","1. **Held for trading** (e.g. {l|derivatives}): remeasure to fair value; **all** changes ({i|gains} and {x|losses}) to P&L.","2. **Designated at FVTPL:** remeasure to fair value; the change from **own credit risk** → {e|Own credit reserve (OCI)}; the rest → P&L.","- {x|Interest} on FVTPL {l|liabilities} goes to P&L.","> Designated: total fair value change = own credit part (OCI) + everything else (P&L)","! The own-credit split applies only to **designated** liabilities, not to {l|derivatives} held for trading."],"id":"rule-etvvmw","sect":4,"part":"Subsequent measurement"},{"type":"diagram","bucket":"subsequent","lo":36,"title":"Designated at FVTPL: splitting the fair value change","intro":"A note issued at par for $2,000,000, designated at FVTPL. At year end its {l|fair value} is $2,060,000.","notes":{"open":"Issued for {a|cash} of 2,000,000: fair value on day one. Any {x|issue costs} were expensed (FVTPL).","close":"{l|Year-end fair value} 2,060,000: the bank now owes something worth 60,000 more.","split":"The standard asks you to separate the part caused by changes in the **entity’s own credit risk**. In the exam that figure is given.","mkt":"Market interest rates fell, which makes fixed payments worth more: {l|liability} +90,000.","own":"The bank’s own credit got worse, which makes its promise worth less: {l|liability} −30,000.","pl":"Dr {x|Fair value loss (P&L)} 90,000.","oci":"Cr {e|Own credit reserve (OCI)} 30,000. Keeps a credit downgrade from showing up as {i|profit}."},"walk":[{"nodes":["open","close"],"text":"The {l|liability} goes from 2,000,000 to 2,060,000: up 60,000 overall."},{"nodes":["close","split","mkt","own"],"text":"Split the change: +90,000 from market rates, −30,000 from the bank’s own credit."},{"nodes":["mkt","pl"],"text":"The market-rate part goes to P&L: a {x|loss} of 90,000."},{"nodes":["own","oci"],"text":"The own-credit part goes to OCI: a {i|gain} of 30,000. Net effect: {l|liability} +60,000 = 90,000 − 30,000."}],"caption":"Designated FVTPL: own credit → OCI; the rest → P&L.","id":"diagram-1wyns6","sect":4,"part":"Subsequent measurement","svg":"\u003csvg width=\"100%\" style=\"min-width:309px\" role=\"img\"\n viewBox=\"0.00 0.00 281.00 326.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 311.15)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-311.15 266.31,-311.15 266.31,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>open\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M164.15,-296.75C164.15,-296.75 74.12,-296.75 74.12,-296.75 68.12,-296.7