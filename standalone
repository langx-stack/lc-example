ace=\"preserve\" text-anchor=\"middle\" x=\"186.44\" y=\"-179.83\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> yes\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>kept\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M216.98,-99C216.98,-99 88.88,-99 88.88,-99 82.88,-99 76.88,-93 76.88,-87 76.88,-87 76.88,-75 76.88,-75 76.88,-69 82.88,-63 88.88,-63 88.88,-63 216.98,-63 216.98,-63 222.98,-63 228.98,-69 228.98,-75 228.98,-75 228.98,-87 228.98,-87 228.98,-93 222.98,-99 216.98,-99\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"112.8\" y=\"-81.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Rights retained\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"87.68\" y=\"-72.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">PV of leaseback 200,000 = 40%\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>fv&#45;&gt;kept\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M221.21,-126.95C210.39,-119.83 197.79,-111.53 186.37,-104.02\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"187.9,-102.09 180.7,-100.29 185.2,-106.18 187.9,-102.09\"/>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>tr\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M356.73,-99C356.73,-99 263.12,-99 263.12,-99 257.12,-99 251.12,-93 251.12,-87 251.12,-87 251.12,-75 251.12,-75 251.12,-69 257.12,-63 263.12,-63 263.12,-63 356.73,-63 356.73,-63 362.73,-63 368.73,-69 368.73,-75 368.73,-75 368.73,-87 368.73,-87 368.73,-93 362.73,-99 356.73,-99\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"261.93\" y=\"-81.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Rights transferred\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"278.8\" y=\"-72.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">300,000 = 60%\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>fv&#45;&gt;tr\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M265.2,-127.12C271.91,-120.34 279.71,-112.48 286.89,-105.23\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"288.49,-107.1 291.68,-100.4 285.01,-103.65 288.49,-107.1\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>rou\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M204.6,-36C204.6,-36 101.25,-36 101.25,-36 95.25,-36 89.25,-30 89.25,-24 89.25,-24 89.25,-12 89.25,-12 89.25,-6 95.25,0 101.25,0 101.25,0 204.6,0 204.6,0 210.6,0 216.6,-6 216.6,-12 216.6,-12 216.6,-24 216.6,-24 216.6,-30 210.6,-36 204.6,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"125.18\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">ROU asset\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"100.05\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">400,000 × 40% = 160,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>kept&#45;&gt;rou\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M152.93,-62.68C152.93,-57.19 152.93,-51 152.93,-45.03\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"155.38,-45.09 152.93,-38.09 150.48,-45.09 155.38,-45.09\"/>\n\u003c/g>\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>gain\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"2\" d=\"M358.98,-36C358.98,-36 260.88,-36 260.88,-36 254.88,-36 248.88,-30 248.88,-24 248.88,-24 248.88,-12 248.88,-12 248.88,-6 254.88,0 260.88,0 260.88,0 358.98,0 358.98,0 364.98,0 370.98,-6 370.98,-12 370.98,-12 370.98,-24 370.98,-24 370.98,-30 364.98,-36 358.98,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"278.8\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Gain in P&amp;L\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"259.68\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">100,000 × 60% = 60,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>tr&#45;&gt;gain\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M309.93,-62.68C309.93,-57.29 309.93,-51.21 309.93,-45.34\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"312.38,-45.51 309.93,-38.51 307.48,-45.51 312.38,-45.51\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"derecognise","blabel":"sale & leaseback","lo":24,"title":"Kept vs sold, in bars","html":"\u003cp>The same sale and leaseback (building \u003cspan class=\"el el-a\">carrying amount\u003c/span> $400,000, sold at fair value $500,000, PV of leaseback $200,000), as three bars on one scale. One split, 40% kept and 60% sold, is applied three times: to the fair value, to the \u003cspan class=\"el el-a\">old carrying amount\u003c/span> (giving the \u003cspan class=\"el el-a\">ROU asset\u003c/span>), and to the \u003cspan class=\"el el-i\">gain\u003c/span>. Solid is kept or recognised; hatched is sold or never recognised.\u003c/p>\u003cdiv class=\"cbars\">\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003ci class=\"seg a\">\u003c/i>\u003cspan class=\"el el-a\">kept (ROU asset)\u003c/span>\u003c/span>\u003cspan>\u003ci class=\"seg out out-a\">\u003c/i>\u003cspan class=\"el el-a\">sold\u003c/span>\u003c/span>\u003cspan>\u003ci class=\"seg i\">\u003c/i>\u003cspan class=\"el el-i\">gain recognised\u003c/span>\u003c/span>\u003cspan>\u003ci class=\"seg out out-i\">\u003c/i>\u003cspan class=\"el el-i\">gain not recognised\u003c/span>\u003c/span>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Fair value 500,000: PV of leaseback 200,000 kept (40%), 300,000 sold (60%)\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg a\" style=\"flex:200000 0 0\">\u003c/i>\u003ci class=\"seg out out-a\" style=\"flex:300000 0 0\">\u003c/i>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">\u003cspan class=\"el el-a\">Old carrying amount\u003c/span> 400,000: \u003cspan class=\"el el-a\">ROU asset\u003c/span> 160,000 kept, 240,000 derecognised\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg a\" style=\"flex:160000 0 0\">\u003c/i>\u003ci class=\"seg out out-a\" style=\"flex:240000 0 0\">\u003c/i>\u003ci class=\"seg\" style=\"flex:100000 0 0;background:transparent\">\u003c/i>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Total \u003cspan class=\"el el-i\">gain\u003c/span> 100,000: \u003cspan class=\"el el-i\">60,000\u003c/span> recognised, 40,000 never recognised\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg i\" style=\"flex:60000 0 0\">\u003c/i>\u003ci class=\"seg out out-i\" style=\"flex:40000 0 0\">\u003c/i>\u003ci class=\"seg\" style=\"flex:400000 0 0;background:transparent\">\u003c/i>\u003c/div>\u003c/div>\n  \u003c/div>","id":"visual-r2u7a2","sect":9,"part":"Derecognise / transfer · sale & leaseback"},{"id":"mcq-1le65j","type":"mcq","bucket":"derecognise","blabel":"sale & leaseback","lo":24,"q":"In a sale and leaseback, control of the asset does **not** pass to the buyer. How does the seller account for the {a|cash} received?","options":[{"t":"Derecognise the {a|asset} and recognise the full {i|gain}","why":"No sale means no derecognition and no {i|gain}."},{"t":"Derecognise the {a|asset} and recognise an {a|ROU asset}","why":"That is the treatment when it *is* a sale."},{"t":"Keep the {a|asset} and recognise a {l|financial liability} for the {a|cash}","ok":true,"why":"It is, in substance, a secured loan."},{"t":"Keep the {a|asset} and recognise the {a|cash} as {i|income}","why":"The {a|cash} must be repaid through the leaseback payments. It is a {l|liability}, not {i|income}."}],"sect":9,"part":"Derecognise / transfer · sale & leaseback"},{"type":"compare","id":"compare-derecognise","bucket":"derecognise","blabel":"sale & leaseback","lo":24,"special":"A sale and leaseback derecognises the asset only if control passes under SFRS(I) 15, and even then the {i|gain} is limited to the rights transferred. No sale means no derecognition: the {a|cash} is a {l|financial liability}.","sect":9,"part":"Derecognise / transfer · sale & leaseback"},{"type":"map","id":"map-10-present","bucket":"present","sect":10,"part":"Present & disclose"},{"id":"think-2uyovk","type":"think","bucket":"present","lo":25,"scenario":"Kopi Co leases a coffee roaster from RoastPro and has recognised a {l|lease liability}. Its first annual payment, $10,000 on 31 Dec 20X1, is part {x|interest} ($2,650) and part repayment of the {l|liability} ($7,350).","prompt":"Where in the statement of cash flows does the repayment part belong? Think about what a {l|lease liability} really is.","answer":["It is repaying borrowing, so it goes under **financing** activities.","{x|Interest} follows the entity’s policy for {x|interest} paid. Payments for short-term, low-value and variable leases are **operating**."],"sect":10,"part":"Present & disclose"},{"type":"rule","bucket":"present","lo":25,"title":"Where it all shows up","body":["Last stop: presentation. The {l|lease liability} is a borrowing in disguise, so it is presented like one, and the notes tell readers what the leases cost and when the cash goes out.","- **Balance sheet:** {a|Right-of-use asset} and {l|Lease liability} shown separately, or inside other lines with those lines disclosed.","- **Profit or loss:** {x|Interest expense} on the {l|lease liability} (a finance cost) and {x|Depreciation expense} on the {a|ROU asset}, shown separately.","- **Cash flows:** principal → financing; interest → per policy; short-term, low-value and variable payments → operating.","- **Lessee notes:** {x|ROU depreciation} by class, {x|interest expense}, short-term and low-value {x|lease expense}, variable payments, total cash outflow, additions to {a|ROU assets}, {a|ROU carrying amount} by class, sale-and-leaseback {i|gains}, maturity analysis of {l|lease liabilities}.","- **Lessor notes:** {i|finance income} or {i|lease income}, {i|selling profit}, and a maturity analysis of undiscounted receipts for each of the next 5 years plus the total after.","+ Lessee notes = what it cost, what it paid, what it added, and when it’s due."],"id":"rule-10oyq2","sect":10,"part":"Present & disclose"},{"type":"mcq","bucket":"present","lo":25,"q":"Where does a lessee present the principal portion of its lease payments in the statement of cash flows?","options":[{"t":"Operating activities","why":"Operating is for short-term, low-value and variable lease payments."},{"t":"Investing activities","why":"The lessee is not buying an asset with cash; it is repaying a {l|liability}."},{"t":"Financing activities","ok":true,"why":"Repaying the {l|lease liability} is like repaying a loan."},{"t":"Not shown; it is a non-cash transaction","why":"The payment is real {a|cash}. Only the initial recognition of the {a|ROU asset} is non-cash."}],"id":"mcq-1oqkl3","sect":10,"part":"Present & disclose"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":11,"part":"Wrap-up"},{"type":"summary","lo":25,"title":"Leases on one page","rows":[["What is a lease?","Right to control the use of an identified asset for a period, for consideration."],["Lessee model?","Single model: {a|Right-of-use asset} + {l|Lease liability}, except short-term (≤ 12 months, no purchase option) and low-value."],["Lease liability?","{l|Lease liability} = PV of unpaid lease payments at the implicit rate, else the incremental borrowing rate."],["ROU asset?","{a|ROU asset} = {l|Liability} + payments at or before day 1 + initial direct costs + restoration − incentives."],["After day 1?","{l|Liability}: + {x|interest} − {a|payments}. {a|ROU asset}: {x|depreciation} over the shorter of lease term and useful life."],["Lessor?","Finance ({a|Lease receivable}, {i|Finance income}) vs operating (keep the {a|asset}, straight-line {i|Lease income})."],["Sale and leaseback?","If a sale: {a|ROU} = {a|CA} × PV/FV, {i|gain} only on rights transferred. If not: {l|financial liability}."],["Cash flows?","Principal = financing. Short-term, low-value and variable = operating."]],"id":"summary-bc09z6","bucket":"wrap","sect":11,"part":"Wrap-up"}],"quiz":{"cases":{"ruby":{"name":"Ruby Enterprises","source":"Official practice paper (Q16–20 case, lease paragraph only)","text":["Ruby Enterprises Pte Ltd (Ruby) is a jewellery wholesaler based in Orchard Towers. Ruby has a financial year ending 31 December 20X7.","On 1 October 20X7, Ruby entered into a 5-year lease agreement to lease additional office space from a financial institution. Lease payments of $15,000 are due annually with the first payment due on 1 October 20X8. The effective rate of interest implicit in the lease is 7.5%. Ruby incurred $3,500 in legal costs to obtain the lease in October 20X7."]},"harbour":{"name":"Harbour Cranes","text":["Harbour Cranes Pte Ltd (Harbour) leases a tower crane to Bay Builders on 1 January 20X5. The lease runs for 5 years with payments of $20,000 due each 31 December. The crane’s economic life is 6 years.","Harbour expects the crane to be worth $5,000 when it is returned; Bay Builders does not guarantee this amount. The rate implicit in the lease is 10%. The crane’s fair value and {a|carrying amount} on 1 January 20X5 are both $78,920. Title stays with Harbour."]}},"questions":[{"id":"ruby-17","type":"initial","case":"ruby","lo":23,"source":"Official practice paper Q17","q":"With reference to SFRS(I) 16, Leases, identify which of the following journal entries Ruby should post in October 20X7 to account for the initial recognition of the lease?","options":[{"je":[{"side":"Dr","account":"Right of use asset","amount":64188,"el":"a"},{"side":"Cr","account":"Lease liability","amount":60688,"el":"l"},{"side":"Cr","account":"Bank","amount":3500,"el":"a"}],"ok":true,"why":"PV = 15,000 × 4.0459 = 60,688 (payments in arrears: the first is a year after commencement). Legal costs are initial direct costs: {a|ROU asset} = 60,688 + 3,500 = 64,188."},{"pit":"undiscounted","je":[{"side":"Dr","account":"Right of use asset","amount":78500,"el":"a"},{"side":"Cr","account":"Lease liability","amount":78500,"el":"l"}],"why":"Uses the undiscounted payments (5 × 15,000) plus legal costs. The {l|liability} is a present value, and the legal costs were paid in {a|cash}."},{"pit":"expensed-rent","je":[{"side":"Dr","account":"Statement of profit or loss – lease expense","amount":18500,"el":"x"},{"side":"Cr","account":"Bank","amount":18500,"el":"a"}],"why":"Treats it as a {x|lease expense}. It is not short-term or low-value, so it goes on the balance sheet. No payment was due in October either."},{"pit":"idc-expensed","je":[{"side":"Dr","account":"Statement of profit or loss – interest costs","amount":5625,"el":"x"},{"side":"Dr","account":"Statement of profit or loss – legal fees","amount":3500,"el":"x"},{"side":"Cr","account":"Bank","amount":9125,"el":"a"}],"why":"Expenses everything and recognises no {a|ROU asset} or {l|liability}. Initial direct costs are capitalised."}]},{"id":"ruby-18","type":"after-day1","case":"ruby","lo":23,"source":"Official practice paper Q18","q":"With reference to SFRS(I) 16, Leases, identify which of the following journal entries Ruby should record on 31 December 20X7 to account for the interest due on the lease?","options":[{"pit":"interest-account","je":[{"side":"Dr","account":"Lease liability","amount":282,"el":"l"},{"side":"Cr","account":"Right of use asset","amount":282,"el":"a"}],"why":"{x|Interest} is an {x|expense} in profit or loss. It never reduces the {a|ROU asset}."},{"pit":"interest-account","je":[{"side":"Dr","account":"Statement of profit or loss – interest expense","amount":1125,"el":"x"},{"side":"Cr","account":"Accruals","amount":1125,"el":"l"}],"why":"{x|Interest} accrues on the {l|lease liability} itself, not a separate {l|accrual}. And 1,125 is 15,000 × 7.5%: a full year on one payment, not 3 months on the {l|liability}."},{"je":[{"side":"Dr","account":"Statement of profit or loss – interest expense","amount":1138,"el":"x"},{"side":"Cr","account":"Lease liability","amount":1138,"el":"l"}],"ok":true,"why":"60,688 × 7.5% × 3/12 = 1,138 for October to December, added to the {l|lease liability}."},{"pit":"undiscounted","je":[{"side":"Dr","account":"Statement of profit or loss – interest expense","amount":5625,"el":"x"},{"side":"Cr","account":"Right of use asset","amount":5625,"el":"a"}],"why":"5,625 is 75,000 × 7.5%: a full year on the undiscounted payments. And {x|interest} increases the {l|lease liability}; it does not reduce the {a|ROU asset}."}]},{"id":"ruby-dep","type":"after-day1","case":"ruby","lo":23,"source":"Practice question based on the Ruby case","q":"Ruby depreciates the {a|right-of-use asset} straight-line over the lease term. What {x|depreciation} should Ruby charge for the year ended 31 December 20X7?","options":[{"pit":"idc-expensed","t":"$3,034","why":"Excludes the legal costs, which are part of the {a|ROU asset}’s cost."},{"t":"$3,209","ok":true,"why":"64,188 ÷ 5 × 3/12 = 3,209. Only three months of use in 20X7."},{"pit":"full-year","t":"$12,838","why":"A full year’s {x|depreciation}, but the lease started on 1 October."},{"t":"$0","why":"{x|Depreciation} starts when the {a|asset} is available for use: 1 October 20X7."}]},{"id":"ruby-liab","type":"after-day1","case":"ruby","lo":23,"source":"Practice question based on the Ruby case","q":"What is the {l|carrying amount} of Ruby’s {l|lease liability} at 31 December 20X7?","options":[{"t":"$60,688","why":"Ignores the {x|interest} accrued since 1 October."},{"t":"$61,826","ok":true,"why":"60,688 + {x|interest} 1,138 = 61,826. No payment has been made yet (first due 1 Oct 20X8)."},{"t":"$46,826","why":"Deducts a payment that isn’t due until 1 October 20X8."},{"pit":"undiscounted","t":"$75,000","why":"The undiscounted total of payments, which is not how the {l|liability} is measured."}]},{"id":"ruby-pl","type":"after-day1","case":"ruby","lo":23,"source":"Practice question based on the Ruby case","q":"What total {x|expense} does the lease add to Ruby’s profit or loss for 20X7?","options":[{"t":"$1,138","why":"Only the {x|interest}. {x|Depreciation} on the {a|ROU asset} is also an {x|expense}."},{"t":"$4,347","ok":true,"why":"{x|Interest} 1,138 + {x|depreciation} 3,209 = 4,347."},{"pit":"idc-expensed","t":"$7,847","why":"Expenses the legal costs too, but they were capitalised into the {a|ROU asset}."},{"pit":"expensed-rent","t":"$3,750","why":"That is three months of the cash payment (15,000 × 3/12). Under SFRS(I) 16 the lessee recognises {x|interest} and {x|depreciation}, not a {x|rent expense}."}]},{"id":"harb-class","type":"lessor-class","case":"harbour","lo":23,"q":"How should Harbour classify the lease of the crane?","options":[{"t":"Operating lease, because title stays with Harbour","why":"Title transfer is only one indicator. The others point strongly to finance."},{"t":"Operating lease, because the residual value is unguaranteed","why":"An unguaranteed residual does not make it operating. Substantially all the risks and rewards still pass."},{"t":"Finance lease","ok":true,"why":"The term (5 of 6 years) is the major part of the economic life, and the PV of payments ($75,816) is substantially all of the fair value ($78,920)."},{"pit":"lessee-lessor-mixup","t":"Harbour does not classify; Bay Builders decides","why":"It is the other way round: lessors classify, and lessees use a single model."}]},{"id":"harb-ni","type":"lessor-finance","case":"harbour","lo":23,"q":"What is Harbour’s net investment in the lease ({a|lease receivable}) on 1 January 20X5?","options":[{"pit":"residual-omitted","t":"$75,816","why":"Leaves out the PV of the unguaranteed residual value, which is part of the net investment."},{"t":"$78,920","ok":true,"why":"PV of payments 75,816 + PV of unguaranteed residual 3,104 = 78,920."},{"pit":"undiscounted","t":"$100,000","why":"Undiscounted payments. The net investment is a present value."},{"pit":"undiscounted","t":"$105,000","why":"Undiscounted payments plus residual. This is the gross investment, not the net."}]},{"id":"harb-inc","type":"lessor-finance","case":"harbour","lo":23,"q":"What {i|finance income} does Harbour recognise for the year ended 31 December 20X5?","options":[{"t":"$20,000","why":"That is the {a|cash} received. Most of it reduces the {a|receivable}."},{"t":"$7,892","ok":true,"why":"78,920 × 10% = 7,892: a constant rate on the {a|net investment}."},{"pit":"residual-omitted","t":"$7,582","why":"Applies 10% to the PV of payments only, leaving out the residual."},{"pit":"straight-line-finance","t":"$5,216","why":"Spreads total {i|income} straight-line. {i|Finance income} follows the effective interest method."}]},{"id":"harb-je","type":"lessor-finance","case":"harbour","lo":23,"q":"Which journal entry should Harbour record when it receives the first payment on 31 December 20X5?","options":[{"pit":"lessor-keeps-asset","je":[{"side":"Dr","account":"Cash","amount":20000,"el":"a"},{"side":"Cr","account":"Lease income","amount":20000,"el":"i"}],"why":"Operating-lease treatment. Under a finance lease, the receipt is split between {i|finance income} and the {a|receivable}."},{"je":[{"side":"Dr","account":"Cash","amount":20000,"el":"a"},{"side":"Cr","account":"Lease receivable","amount":20000,"el":"a"}],"why":"Ignores the {i|finance income} earned during the year."},{"je":[{"side":"Dr","account":"Cash","amount":20000,"el":"a"},{"side":"Cr","account":"Finance income","amount":7892,"el":"i"},{"side":"Cr","account":"Lease receivable","amount":12108,"el":"a"}],"ok":true,"why":"{i|Finance income} 7,892; the remaining 12,108 reduces the {a|receivable}."},{"pit":"lessor-keeps-asset","je":[{"side":"Dr","account":"Depreciation expense","amount":14784,"el":"x"},{"side":"Cr","account":"Accumulated depreciation – crane","amount":14784,"el":"a"}],"why":"Harbour derecognised the crane at commencement, so it has nothing to depreciate."}]},{"id":"harb-op","type":"lessor-finance","case":"harbour","lo":23,"q":"Suppose instead the lease ran for only 2 years and no finance-lease indicator applied. How would Harbour account for it?","options":[{"t":"Recognise a {a|lease receivable} and derecognise the crane","why":"That is finance-lease accounting."},{"t":"Keep the crane, depreciate it, and recognise {i|lease income} straight-line","ok":true,"why":"Operating lease: the lessor keeps the {a|asset} and recognises {i|income} on a straight-line basis."},{"t":"Recognise a {a|right-of-use asset} for the crane","why":"{a|ROU assets} are a lessee concept."},{"t":"Recognise all {i|lease income} up front on 1 January 20X5","why":"{i|Income} is spread over the lease term."}]},{"id":"s-ident","type":"is-lease","lo":22,"q":"A customer contracts for the use of \"a delivery truck\" for 3 years. The supplier can substitute any truck from its fleet at any time at negligible cost and benefits from doing so. Which statement is correct?","options":[{"pit":"substitution","t":"The contract contains a lease, because the term exceeds 12 months","why":"Term length doesn’t create a lease; there must be an identified asset."},{"t":"The contract does not contain a lease, because there is no identified asset","ok":true,"why":"A substantive substitution right means the customer does not control a specific asset."},{"t":"The contract contains a lease, but the low-value exemption applies","why":"A truck is not low-value, and there is no lease to begin with."},{"t":"The contract contains a lease for the supplier only","why":"Lease identification is assessed for the contract as a whole."}]},{"id":"s-short","type":"exemption","lo":22,"q":"Which lease qualifies for the short-term lease exemption?","options":[{"pit":"short-term-option","t":"A 12-month equipment lease with an option to purchase at the end","why":"A purchase option disqualifies the exemption."},{"t":"An 18-month lease of a photocopier","why":"Over 12 months."},{"t":"A 9-month lease of a warehouse with no purchase option","ok":true,"why":"12 months or less, with no purchase option."},{"t":"A 5-year lease of a laptop","why":"This may qualify as **low-value**, but it is not short-term."}]},{"id":"s-rate","type":"initial","lo":23,"q":"A lessee cannot readily determine the interest rate implicit in a lease. Which rate should it use to measure the {l|lease liability}?","options":[{"t":"The lessor’s weighted average cost of capital","why":"The lessee uses its own borrowing rate, not the lessor’s cost of capital."},{"t":"The lessee’s incremental borrowing rate","ok":true,"why":"This is the fallback when the implicit rate is not readily determinable."},{"t":"The central bank policy rate","why":"Not specific to the lessee or the asset."},{"t":"Zero: the {l|liability} is measured at the undiscounted payments","why":"The {l|liability} is always discounted."}]},{"id":"s-var","type":"initial","lo":23,"q":"A store lease has fixed rent of $50,000 a year plus 3% of the store’s annual sales. How is the 3% treated?","options":[{"pit":"variable-sales","t":"Included in the {l|lease liability}, based on forecast sales","why":"Sales-linked variable payments are not lease payments."},{"t":"Added to the {a|ROU asset} when paid","why":"They are not capitalised."},{"t":"Recognised in profit or loss when the sales occur","ok":true,"why":"Variable payments that depend on sales or usage are an {x|expense} when incurred."},{"t":"Disclosed only, with no {x|expense} recognised","why":"They are a real {x|expense}."}]},{"id":"s-adv","type":"advance","lo":23,"q":"A lessee agrees to 4 annual payments of $12,000, **in advance**, starting on the commencement date. The rate implicit in the lease is 6%. What is the {l|lease liability} immediately after the first payment?","options":[{"pit":"advance-first-payment","t":"$44,076","why":"The PV of all four payments, before the first payment is made on day 1."},{"t":"$32,076","ok":true,"why":"PV of the 3 remaining payments: 12,000 × 2.6730 = 32,076."},{"t":"$41,581","why":"Treats the payments as in arrears."},{"pit":"undiscounted","t":"$36,000","why":"Undiscounted remaining payments."}]},{"id":"s-dep","type":"after-day1","lo":23,"q":"A lessee leases a machine for 5 years (useful life 8 years) and is reasonably certain to exercise a purchase option at the end. Over what period should the {a|ROU asset} be depreciated?","options":[{"pit":"dep-period","t":"5 years, the lease term","why":"That would be right without the purchase option."},{"t":"8 years, the useful life","ok":true,"why":"With ownership expected to pass, the lessee will use the asset for its whole useful life."},{"t":"3 years, the remaining life after the lease","why":"No basis for this."},{"t":"Not depreciated until the option is exercised","why":"{x|Depreciation} starts at commencement."}]},{"id":"s-slb","type":"slb","lo":24,"q":"An entity sells a building ({a|carrying amount} $900,000) at its fair value of $1,500,000 and leases it back. The transfer is a sale. PV of leaseback payments is $600,000. What {i|gain} does the seller-lessee recognise?","options":[{"pit":"full-gain","t":"$600,000","why":"The full {i|gain}. Only the portion relating to rights transferred is recognised."},{"t":"$360,000","ok":true,"why":"600,000 × (1,500,000 − 600,000) ÷ 1,500,000 = 360,000."},{"t":"$240,000","why":"That is the portion relating to the rights retained."},{"t":"$0","why":"Since it is a genuine sale, the {i|gain} on rights transferred is recognised."}]},{"id":"s-nosale","type":"slb","lo":24,"q":"In a sale and leaseback, the seller has a repurchase option that means control does not pass to the buyer. How does the seller-lessee account for the proceeds?","options":[{"t":"As {i|revenue}","why":"There is no sale."},{"t":"As a {l|financial liability}, keeping the {a|asset} on its books","ok":true,"why":"Not a sale: the {a|asset} stays, and the {a|cash} is a {l|financial liability}."},{"t":"As a {l|deferred gain}, released over the lease term","why":"That was old-standard treatment, not SFRS(I) 16."},{"t":"As a reduction of the asset’s {a|carrying amount}","why":"The {a|asset} is not derecognised or written down."}]},{"id":"s-cf","type":"present","lo":25,"q":"How should a lessee present payments for short-term leases that it expenses under the exemption in its statement of cash flows?","options":[{"t":"Operating activities","ok":true,"why":"Short-term, low-value and variable lease payments are operating cash flows."},{"t":"Investing activities","why":"No asset is acquired."},{"t":"Financing activities","why":"Financing is for the principal of recognised {l|lease liabilities}."},{"t":"Excluded from the statement of cash flows","why":"They are cash payments."}]},{"id":"s-disc","type":"present","lo":25,"q":"Which of the following must a lessee disclose in the notes?","options":[{"t":"The fair value of each {a|right-of-use asset}","why":"Not required. {a|ROU assets} are disclosed at {a|carrying amount} by class."},{"t":"The {x|expense} relating to short-term leases accounted for under the exemption","ok":true,"why":"Required, so users can see lease costs that aren’t on the balance sheet."},{"t":"The lessor’s profit margin on the lease","why":"The lessee wouldn’t know this, and it isn’t required."},{"t":"A forecast of next year’s sales-based variable payments","why":"Variable lease payments expensed in the period are disclosed, but not forecasts."}]}]},"exam":{"cases":{"lionCity":{"name":"Lion City Clinics","text":["Lion City Clinics Pte Ltd (LCC) runs medical clinics and has a 31 December year end.","On 1 January 20X3, LCC leased diagnostic imaging equipment for 5 years. Annual payments of $50,000 are due **in advance** on 1 January each year, the first on 1 January 20X3. The rate implicit in the lease is 6%. LCC paid $4,000 of legal fees in {a|cash} to arrange the lease.","The equipment has a useful life of 8 years. Ownership does not pass to LCC and there is no purchase option. LCC depreciates {a|right-of-use assets} straight-line with no residual value.","Annuity factors at 6%: 4 years 3.4651; 5 years 4.2124."]},"straits":{"name":"Straits Leasing","text":["Straits Leasing Pte Ltd (Straits) is a finance company with a 31 December year end.","On 1 January 20X5 Straits bought a {a|printing press} for $220,779, its fair value, and immediately leased it to Merlion Print for 4 years. Merlion Print pays $60,000 on 31 December each year. The press has an economic life of 5 years, and title stays with Straits.","Straits expects the press to be worth $30,000 when it is returned on 31 December 20X8. Merlion Print does not guarantee this amount. The rate implicit in the lease is 8%.","At 8%: 4-year annuity factor 3.3121; 4-year discount factor 0.7350."]},"orchard":{"name":"Orchard Logistics","text":["Orchard Logistics Pte Ltd (Orchard) has a 31 December year end. It classifies {x|interest} paid as an operating cash flow.","On 1 January 20X6 Orchard sold its warehouse to a REIT for $4,000,000, its fair value. The warehouse’s {a|carrying amount} was $2,400,000. Control passed to the REIT, so the transfer is a sale under SFRS(I) 15. Orchard leased the warehouse back for 10 years at $300,000 a year, paid each 31 December. The implicit rate is not readily determinable; at Orchard’s incremental borrowing rate of 5%, the PV of the leaseback payments is $2,316,520.","Also in 20X6, Orchard rented a forklift for 6 months (1 March to 31 August) at $1,500 a month with no purchase option; leased 30 laptops for 3 years at $400 a year each (each laptop costs about $1,200 new); and leased a delivery van for 12 months with an option to buy it at the end. Orchard uses the short-term and low-value exemptions wherever it can."]}},"questions":[{"id":"x1","case":"lionCity","lo":23,"type":"advance","q":"Which journal entry should LCC record on 1 January 20X3?","options":[{"pit":"advance-first-payment","je":[{"side":"Dr","account":"Right-of-use asset","amount":227255,"el":"a"},{"side":"Cr","account":"Lease liability","amount":223255,"el":"l"},{"side":"Cr","account":"Cash","amount":4000,"el":"a"}],"why":"Leaves the 1 January 20X3 payment in the {l|liability} as if it were still owed. It was paid in {a|cash} on day 1, so the {l|liability} is only the PV of the 4 unpaid payments."},{"je":[{"side":"Dr","account":"Right-of-use asset","amount":227255,"el":"a"},{"side":"Cr","account":"Lease liability","amount":173255,"el":"l"},{"side":"Cr","account":"Cash","amount":54000,"el":"a"}],"ok":true,"why":"{l|Liability} = 50,000 × 3.4651 = 173,255 (the 4 unpaid payments). {a|ROU asset} = 173,255 + payment at commencement 50,000 + legal fees 4,000 = 227,255. {a|Cash} = 50,000 + 4,000."},{"pit":"idc-expensed","je":[{"side":"Dr","account":"Right-of-use asset","amount":223255,"el":"a"},{"side":"Dr","account":"Legal fees expense","amount":4000,"el":"x"},{"side":"Cr","account":"Lease liability","amount":173255,"el":"l"},{"side":"Cr","account":"Cash","amount":54000,"el":"a"}],"why":"The {l|liability} is right, but the legal fees are initial direct costs. They are added to the {a|ROU asset}, not expensed."},{"pit":"undiscounted","je":[{"side":"Dr","account":"Right-of-use asset","amount":254000,"el":"a"},{"side":"Cr","account":"Lease liability","amount":200000,"el":"l"},{"side":"Cr","account":"Cash","amount":54000,"el":"a"}],"why":"Measures the {l|liability} at the undiscounted 4 × 50,000. The {l|liability} is a present value."}]},{"id":"x2","case":"lionCity","lo":23,"type":"after-day1","q":"What {x|depreciation} should LCC charge on the {a|right-of-use asset} for the year ended 31 December 20X3?","options":[{"pit":"dep-period","t":"$28,407","why":"Uses the 8-year useful life. With no ownership transfer and no purchase option, LCC can use the equipment only for the 5-year lease term, the shorter period."},{"pit":"idc-expensed","t":"$44,651","why":"Leaves the legal fees out of the {a|ROU asset}’s cost."},{"t":"$45,451","ok":true,"why":"{a|ROU asset} 227,255 ÷ 5 years (shorter of the 5-year lease term and 8-year life) = 45,451."},{"t":"$56,814","why":"Spreads the {a|asset} over the 4 payments still owed. {x|Depreciation} runs over the 5-year period of use, starting on 1 January 20X3."}]},{"id":"x3","case":"lionCity","lo":23,"type":"after-day1","q":"What {x|interest expense} on the lease should LCC recognise for 20X3?","options":[{"t":"$10,395","ok":true,"why":"173,255 × 6% = 10,395. {x|Interest} runs on the {l|liability} after the day-1 payment."},{"pit":"advance-first-payment","t":"$13,395","why":"Charges {x|interest} on 223,255, which includes the 50,000 already paid on day 1."},{"pit":"undiscounted","t":"$15,000","why":"6% of the undiscounted total of 250,000."},{"t":"$0","why":"Paying in advance does not remove the {x|interest}. The 4 later payments are still financed, so the {l|liability} accrues {x|interest}."}]},{"id":"x4","case":"lionCity","lo":23,"type":"after-day1","q":"What is the {l|carrying amount} of LCC’s {l|lease liability} at 31 December 20X3?","options":[{"t":"$173,255","why":"Ignores the {x|interest} accrued during 20X3."},{"t":"$133,650","why":"Deducts the 1 January 20X4 payment, which has not been made yet at 31 December 20X3."},{"pit":"advance-first-payment","t":"$236,650","why":"Grows 223,255 by 6%, but that figure still includes the day-1 payment."},{"t":"$183,650","ok":true,"why":"173,255 + {x|interest} 10,395 = 183,650. The next payment falls due the following day."}]},{"id":"x5","case":"lionCity","lo":23,"type":"after-day1","q":"At 31 December 20X4 LCC’s {l|lease liability} is $141,669. How should it be split between current and non-current {l|liabilities}?","options":[{"pit":"current-split","t":"Current $44,500; non-current $97,169","why":"Deducts 20X5 {x|interest} (5,500) from the next payment, which is the method for payments in **arrears**. Here the next 50,000 is paid on 1 January 20X5, before any 20X5 {x|interest} accrues, so all of it reduces {l|today’s balance}."},{"t":"Current $50,000; non-current $91,669","ok":true,"why":"The 20X4 {x|interest} is already in the {l|141,669}. The whole 1 January 20X5 payment of 50,000 settles part of that {l|balance} within 12 months, so it is current. Non-current = 141,669 − 50,000 = 91,669."},{"t":"Current $0; non-current $141,669","why":"Part of the {l|liability} is settled within 12 months, so that part is current, even though the lease runs beyond 12 months."},{"pit":"undiscounted","t":"Current $50,000; non-current $100,000","why":"Uses the undiscounted later payments for the non-current part. The two parts must add up to the {l|carrying amount}."}]},{"id":"x6","case":"straits","lo":23,"type":"lessor-finance","q":"Which journal entry should Straits record on 1 January 20X5, when the lease starts?","options":[{"pit":"lessor-keeps-asset","t":"No entry: the press stays in property, plant and equipment and Straits depreciates it","why":"That is operating-lease accounting. The lease covers 4 of 5 years and the PV of payments (198,728) is substantially all of the fair value, so it is a finance lease and the {a|press} is derecognised."},{"pit":"lessee-lessor-mixup","je":[{"side":"Dr","account":"Right-of-use asset","amount":220779,"el":"a"},{"side":"Cr","account":"Lease liability","amount":220779,"el":"l"}],"why":"That is the lessee’s model. Straits is the lessor."},{"je":[{"side":"Dr","account":"Lease receivable","amount":220779,"el":"a"},{"side":"Cr","account":"Printing press","amount":220779,"el":"a"}],"ok":true,"why":"Finance lease. Net investment ({a|lease receivable}) = PV of payments 198,728 + PV of unguaranteed residual 22,051 = 220,779, equal to the press’s {a|carrying amount}, so there is no selling profit."},{"pit":"residual-omitted","je":[{"side":"Dr","account":"Lease receivable","amount":198728,"el":"a"},{"side":"Dr","account":"Loss on lease","amount":22051,"el":"x"},{"side":"Cr","account":"Printing press","amount":220779,"el":"a"}],"why":"Leaves the PV of the unguaranteed residual out of the {a|receivable} and books it as a {x|loss}. Straits still expects to recover the residual, so it is part of the net investment."}]},{"id":"x7","case":"straits","lo":23,"type":"lessor-finance","q":"What {i|finance income} should Straits recognise for the year ended 31 December 20X6 (the second year)?","options":[{"t":"$17,662","why":"That is the 20X5 {i|income}, on the {a|opening net investment}. The {a|receivable} has since fallen."},{"t":"$14,275","ok":true,"why":"{a|Receivable} at 31 Dec 20X5 = 220,779 + 17,662 − 60,000 = 178,441. 20X6 {i|income} = 178,441 × 8% = 14,275."},{"pit":"residual-omitted","t":"$12,370","why":"Runs the schedule on the PV of the payments only, leaving out the unguaranteed residual."},{"pit":"straight-line-finance","t":"$12,305","why":"Spreads total {i|income} (270,000 − 220,779) evenly over 4 years. {i|Finance income} is at a constant rate on the {a|receivable}, so it falls each year."}]},{"id":"x8","case":"straits","lo":23,"type":"lessor-finance","q":"What is the {a|carrying amount} of Straits’ {a|lease receivable} at 31 December 20X6?","options":[{"pit":"residual-omitted","t":"$106,996","why":"Runs the schedule without the unguaranteed residual."},{"pit":"undiscounted","t":"$150,000","why":"The undiscounted amounts still to come (2 × 60,000 + 30,000). The {a|receivable} is measured at amortised cost."},{"t":"$100,779","why":"Deducts both receipts in full without adding the {i|finance income} earned."},{"t":"$132,716","ok":true,"why":"178,441 + 20X6 {i|income} 14,275 − 60,000 = 132,716."}]},{"id":"x9","case":"straits","lo":23,"type":"lessor-finance","q":"Which journal entry records Straits’ receipt on 31 December 20X6?","options":[{"je":[{"side":"Dr","account":"Cash","amount":60000,"el":"a"},{"side":"Cr","account":"Finance income","amount":14275,"el":"i"},{"side":"Cr","account":"Lease receivable","amount":45725,"el":"a"}],"ok":true,"why":"{i|Finance income} 14,275 at 8% on the {a|opening receivable}; the remaining 45,725 reduces it."},{"pit":"lessor-keeps-asset","je":[{"side":"Dr","account":"Cash","amount":60000,"el":"a"},{"side":"Cr","account":"Lease income","amount":60000,"el":"i"}],"why":"Operating-lease treatment. Under a finance lease the receipt is split between {i|finance income} and the {a|receivable}."},{"je":[{"side":"Dr","account":"Cash","amount":60000,"el":"a"},{"side":"Cr","account":"Finance income","amount":17662,"el":"i"},{"side":"Cr","account":"Lease receivable","amount":42338,"el":"a"}],"why":"Uses the 20X5 split. {i|Income} must be recalculated on the {a|lower opening balance} for 20X6."},{"je":[{"side":"Dr","account":"Cash","amount":60000,"el":"a"},{"side":"Cr","account":"Lease receivable","amount":60000,"el":"a"}],"why":"Ignores the {i|finance income} earned in 20X6."}]},{"id":"x10","case":"straits","lo":23,"type":"lessor-finance","q":"Suppose instead Merlion Print had guaranteed the $30,000 residual value. What would Straits’ {a|lease receivable} be on 1 January 20X5?","options":[{"pit":"undiscounted","t":"$250,779","why":"Adds the residual a second time, and undiscounted. It is already in the {a|receivable} at its present value."},{"pit":"residual-omitted","t":"$198,728","why":"A guaranteed residual is a lease payment, so it stays in the {a|receivable} at its PV."},{"t":"$220,779, unchanged","ok":true,"why":"The net investment is the PV of lease payments plus the PV of any unguaranteed residual. The guarantee moves the residual from one category to the other, so the total stays 220,779. What changes is who bears the residual risk."},{"t":"Nil: the guarantee makes it an operating lease","why":"A guarantee moves more risk to the lessee, which points even more strongly to a finance lease."}]},{"id":"x11","case":"orchard","lo":24,"type":"slb","q":"At what amount should Orchard measure the {a|right-of-use asset} on 1 January 20X6?","options":[{"t":"$2,316,520","why":"Measures it like a new lease, at the PV of the payments. In a sale and leaseback the {a|ROU asset} is the share of the old {a|carrying amount} that Orchard keeps."},{"t":"$1,389,912","ok":true,"why":"2,400,000 × 2,316,520 ÷ 4,000,000 = 1,389,912."},{"t":"$1,010,088","why":"Uses the share transferred to the REIT, (FV − PV) ÷ FV. The {a|ROU asset} is the share retained, PV ÷ FV."},{"t":"$2,400,000","why":"The whole {a|carrying amount}. Orchard kept only the right to use the warehouse for 10 years, not the whole asset."}]},{"id":"x12","case":"orchard","lo":24,"type":"slb","q":"What {i|gain} should Orchard recognise on the sale on 1 January 20X6?","options":[{"pit":"full-gain","t":"$1,600,000","why":"The whole {i|gain}. Only the part relating to the rights transferred to the REIT is recognised."},{"t":"$926,608","why":"That is the part relating to the rights Orchard kept, which is not recognised."},{"t":"$673,392","ok":true,"why":"Total {i|gain} 1,600,000 × rights transferred (4,000,000 − 2,316,520) ÷ 4,000,000 (42.09%) = 673,392."},{"t":"$0, deferred over the leaseback","why":"Deferring the {i|gain} was the old-standard approach. It is a genuine sale, so the {i|gain} on rights transferred is recognised now."}]},{"id":"x13","case":"orchard","lo":24,"type":"slb","q":"Which journal entry should Orchard record on 1 January 20X6?","options":[{"je":[{"side":"Dr","account":"Cash","amount":4000000,"el":"a"},{"side":"Cr","account":"Financial liability","amount":4000000,"el":"l"}],"why":"That is the treatment when the transfer is **not** a sale. Here control passed to the REIT."},{"pit":"full-gain","je":[{"side":"Dr","account":"Cash","amount":4000000,"el":"a"},{"side":"Dr","account":"Right-of-use asset","amount":2316520,"el":"a"},{"side":"Cr","account":"Warehouse","amount":2400000,"el":"a"},{"side":"Cr","account":"Lease liability","amount":2316520,"el":"l"},{"side":"Cr","account":"Gain on sale","amount":1600000,"el":"i"}],"why":"Measures the {a|ROU asset} at the PV of the payments, which lets the whole {i|gain} through."},{"je":[{"side":"Dr","account":"Cash","amount":4000000,"el":"a"},{"side":"Dr","account":"Right-of-use asset","amount":1389912,"el":"a"},{"side":"Cr","account":"Warehouse","amount":2400000,"el":"a"},{"side":"Cr","account":"Lease liability","amount":2316520,"el":"l"},{"side":"Cr","account":"Gain on rights transferred","amount":673392,"el":"i"}],"ok":true,"why":"{a|ROU asset} 1,389,912 ({a|CA} × PV/FV); {l|lease liability} 2,316,520; {i|gain} only on the rights transferred, 673,392."},{"pit":"full-gain","je":[{"side":"Dr","account":"Cash","amount":4000000,"el":"a"},{"side":"Cr","account":"Warehouse","amount":2400000,"el":"a"},{"side":"Cr","account":"Gain on sale","amount":1600000,"el":"i"}],"why":"Treats it as an outright sale and ignores the leaseback, which must be recognised as an {a|ROU asset} and {l|lease liability}."}]},{"id":"x14","case":"orchard","lo":22,"type":"exemption","q":"Which of Orchard’s other three leases must it recognise on its balance sheet?","options":[{"pit":"short-term-option","t":"None of them: all three are short-term or low-value","why":"The 12-month van lease has a purchase option, so it is not short-term, and a van is not low-value."},{"pit":"low-value-size","t":"The laptops and the van","why":"Low-value is judged per asset, when new: each laptop is about $1,200. The $36,000 total doesn’t matter."},{"t":"Only the van","ok":true,"why":"The forklift is short-term (6 months, no purchase option) and the laptops are low-value assets. The van lease has a purchase option, so it is not short-term, and a van is not low-value."},{"t":"All three","why":"Orchard elects the exemptions, so the forklift and laptops are a {x|lease expense} straight-line."}]},{"id":"x15","case":"orchard","lo":25,"type":"present","q":"In its 20X6 statement of cash flows, what does Orchard show in financing activities for the warehouse leaseback payment on 31 December 20X6?","options":[{"t":"Outflow of $300,000","why":"Includes the {x|interest} of 115,826, which Orchard’s policy puts in operating activities."},{"t":"Outflow of $184,174","ok":true,"why":"{x|Interest} = 2,316,520 × 5% = 115,826 (operating, per Orchard’s policy). Principal = 300,000 − 115,826 = 184,174, in financing."},{"pit":"principal-operating","t":"Nothing: the whole payment is an operating cash flow","why":"Only short-term, low-value and variable lease payments are operating. Principal on a recognised {l|lease liability} is financing."},{"t":"Outflow of $115,826","why":"That is the {x|interest}, which Orchard classifies as operating. Financing shows the principal."}]},{"id":"x16","lo":23,"type":"after-day1","q":"A lessee pays $25,000 a year in arrears for 5 years; the rate implicit in the lease is 7% and the {l|initial liability} was $102,505. At the end of year 2 the {l|liability} is $65,608, just after that year’s payment. How should it be split between current and non-current?","options":[{"pit":"current-split","t":"Current $25,000; non-current $40,608","why":"The year-3 payment includes 4,593 of {x|interest} that has not accrued yet, so it doesn’t settle any of {l|today’s balance}."},{"t":"Current $20,407; non-current $45,201","ok":true,"why":"Year-3 {x|interest} = 65,608 × 7% = 4,593. Only 25,000 − 4,593 = 20,407 of the next payment reduces {l|today’s balance}, so that is current. Non-current = 65,608 − 20,407 = 45,201."},{"t":"Current $0; non-current $65,608","why":"The part repaid within 12 months is current."},{"pit":"undiscounted","t":"Current $25,000; non-current $50,000","why":"Uses undiscounted payments. The split must add up to the {l|carrying amount}."}]},{"id":"x17","lo":22,"type":"is-lease","q":"A mining company contracts for the use of a specified ship for 5 years. The ship owner cannot substitute another ship. The owner’s crew operates and maintains the ship, but the mining company decides what cargo it carries and when and where it sails throughout the 5 years. Which statement is correct?","options":[{"t":"No lease, because the owner’s crew operates the ship","why":"Operating the asset is not the same as directing its use. The mining company makes the decisions about how and for what purpose the ship is used."},{"t":"No lease, because legal title stays with the owner","why":"A lease never transfers title. The test is control of the use of an identified asset."},{"pit":"low-value-size","t":"A lease, but the mining company can expense it as low-value because the ship is small relative to its fleet","why":"Low-value is judged on the asset’s value when new, not relative to the lessee. A ship is not low-value."},{"t":"The contract contains a lease","ok":true,"why":"Identified asset (specified, no substitution), substantially all the benefits for 5 years, and the mining company directs how and for what purpose the ship is used. All three tests pass."}]}]},"prepared":true},{"id":"income-tax","title":"Income Tax","subtitle":"SFRS(I) 1-12 · current and deferred tax","code":"B2.2","los":{"26":"Concept and purpose of deferred tax","27":"Permanent and temporary differences","28":"Current and deferred tax balances","29":"Balance sheet liability approach","30":"Unused tax losses","31":"Presentation and disclosure"},"accounts":[{"name":"Current tax expense","el":"x"},{"name":"Current tax payable","el":"l"},{"name":"Deferred tax expense","el":"x"},{"name":"Deferred tax income","el":"i"},{"name":"Deferred tax liability","el":"l"},{"name":"Deferred tax asset","el":"a"},{"name":"Revaluation surplus (OCI)","el":"e"},{"name":"Property, plant and equipment","el":"a"},{"name":"Cash","el":"a"},{"name":"Retained earnings","el":"e"},{"name":"Accruals","el":"l"}],"map":{"classify":{"label":"Permanent vs temporary; taxable vs deductible","star":"Tax fits the backbone loosely: you classify differences, not the asset"},"recognise":{"label":"{l|DTL} always; {a|DTA} only if profit probable","star":"A {a|DTA}, including on unused losses, needs probable future taxable profit"},"initial":{"label":"{x|Current tax}; difference × enacted rate"},"subsequent":{"label":"Recompute yearly; movement to P&L or OCI"},"derecognise":{"label":"Balance unwinds as differences reverse"},"present":{"label":"Non-current, offset rules, tax reconciliation"}},"preamble":["Welcome to income tax, the chapter where the taxman gets a seat at every table. You learn how a company accounts for the tax it owes for this year, and for the future tax that this year’s events have already set in motion.","1. First, **why deferred tax exists**: accounting and tax law keep different books. Then sort each difference: **permanent** (gone for good, ignore it) or **temporary** (just “see you later”), by comparing carrying amount with **tax base**.","2. **{x|Current tax}**: this year’s bill. Adjust accounting profit to taxable profit, then × 17%. Plain vanilla.","3. **Deferred tax**: the IOU for timing differences, the taxman’s (a {l|DTL}) or yours (a {a|DTA}). Temporary difference × enacted rate. A {l|DTL} goes on the books almost always; a {a|DTA} only if future taxable profit is probable.","4. **Movements** to P&L or OCI, **rate changes**, differences reversing to nil, and **unused tax losses**.","5. **Presentation**: non-current, strict offset rules, and the tax reconciliation that explains why tax isn’t simply profit × 17%.","★ What is special: tax fits the six-step backbone only loosely, so squint a little at the map. You classify **differences** (permanent or temporary, taxable or deductible), not an asset, and the balance is recomputed from scratch at every year end rather than depreciated or revalued."],"intros":{"classify|why deferred tax":"First stop: why isn’t {x|tax expense} just profit × 17%? Because accounting and tax law keep different books, and the gaps between them don’t all vanish. Deferred tax is the IOU for the timing gaps: the taxman’s (a {l|DTL}) or yours (a {a|DTA}). ★ Fair warning: tax fits our six-step map only loosely, so this “classify” step classifies something unusual.","classify|permanent vs temporary":"Now that we know why deferred tax exists, we sort the gaps between accounting profit and taxable profit. ★ Here’s the twist: tax classifies **differences**, not an asset. Permanent ones (that late-filing fine) are gone for good, so no deferred tax; temporary ones are just “see you later”, and they get it.","classify|tax base":"We can spot a temporary difference; next we work out which way it points. ★ This is the core skill of the chapter: compare each item’s carrying amount with its **tax base**, tax’s own view of the same item. Get the direction right (taxable → {l|DTL}, deductible → {a|DTA}) and most of what follows is arithmetic.","initial|current tax":"Classification done, so time to put numbers on the page: our loose version of “initial measurement”. First up is {x|current tax}, this year’s bill. Totally vanilla: adjust accounting profit to taxable profit, × 17%, and whatever’s unpaid sits in {l|current liabilities}. No stars here.","initial|deferred tax":"This year’s bill is sorted; now we measure the IOU. Deferred tax = temporary difference × enacted rate, and {x|tax expense} = {x|current} + {x|deferred}. Mostly mechanical, but remember the {x|P&L charge} is the *movement* in the {l|balance} (in year 1, from zero, that happens to be the whole thing).","recognise":"We’ve measured both pieces, and now the map’s “recognise” question turns up a bit late (tax likes doing things its own way). ★ Special: the two sides play by different rules. A {l|DTL} goes on the books almost always, no questions asked; a {a|DTA} has to show proof of future taxable profit before it gets in.","subsequent|P&L or OCI":"Tax is booked, but where does it land? Short and mostly vanilla: deferred tax follows the item like a shadow. A revaluation in OCI drags its tax into OCI too, and P&L never sees it.","subsequent|movement":"On to “subsequent measurement”, and ★ it looks nothing like PPE: no fair value, no amortisation. Each year end you recompute the balance from scratch (difference × enacted rate) and book {l|closing} − {l|opening}. A rate change remeasures the {l|opening balance} too, which is where the exam likes to hide its traps.","derecognise|reversal":"We’ve watched the {l|DTL} build up; now we watch it wind down. This is “derecognise”, tax style: no sale, no write-off ceremony. The difference simply reverses and the {l|balance} melts back to nil through P&L. Pleasantly vanilla.","recognise|tax losses":"A detour back to recognition, because losses deserve their own stop. ★ Special: an unused tax loss is a {a|DTA} only to the extent future taxable profit is probable to use it, and the test is rerun every year end. A string of recent losses makes that a very hard sell.","present":"Last stop on the map: showing it all off. Mostly routine housekeeping: deferred tax is non-current, and {a|DTAs} and {l|DTLs} are offset only with a legal right and the same tax authority. The star turn is the tax reconciliation, which explains why {x|tax expense} isn’t profit × 17%, bringing us full circle to where we started."},"pitfalls":{"temp-as-perm":"Calling a timing item (accelerated allowances, a {l|provision}, accrued {a|interest}) a permanent difference.","wrong-direction":"Getting {a|DTA} and {l|DTL} the wrong way round (asset CA > TB is a {l|DTL}; liabilities flip).","tb-cost":"Using cost or {a|carrying amount} as the tax base instead of cost less allowances claimed.","profit-x-rate":"Taking accounting profit × 17% as {x|current tax} instead of taxable profit × 17%.","old-rate":"Using the old rate (or a merely proposed one) instead of the enacted or substantively enacted rate, or not remeasuring the {l|opening balance}.","rate-wrong-year":"Applying a newly enacted future rate to this year’s {x|current tax}.","closing-as-expense":"Treating the {l|closing deferred tax balance} as the year’s {x|expense} instead of the movement.","dta-sign":"Adding a {a|DTA} (or its increase) to {x|tax expense} instead of deducting it.","reval-to-pl":"Sending deferred tax on a revaluation to P&L instead of OCI.","full-loss-dta":"Recognising (or keeping) a {a|DTA} on the full tax loss without probable future taxable profit.","recon-temp":"Putting temporary differences in the tax reconciliation.","dt-current":"Classifying deferred tax as current, or splitting it by reversal date.","offset":"Getting offsetting wrong: netting without a legal right and the same tax authority, or not netting when both hold.","discount":"Discounting deferred tax to present value."},"examTypes":[{"id":"perm-diff","title":"Permanent or temporary? Taxable or deductible?","pitfall":"Calling a {l|provision} or accelerated allowances permanent, or flipping {a|DTA} and {l|DTL}","see":"classify"},{"id":"tax-base","title":"What is the tax base of this asset or liability?","pitfall":"Using cost instead of cost less allowances claimed","see":"classify"},{"id":"current-tax","title":"What is current tax for the year?","pitfall":"Accounting profit × 17% instead of taxable profit × 17%","see":"initial"},{"id":"dt-balance","title":"What is the deferred tax liability (or asset) at year end?","pitfall":"Using the old rate after a new rate is enacted","see":"initial"},{"id":"tax-expense","title":"What is total tax expense for the year?","pitfall":"Adding the {l|closing DTL} instead of the movement","see":"subsequent"},{"id":"reval-oci","title":"Where is deferred tax on a revaluation recognised?","pitfall":"Answering P&L instead of OCI","see":"subsequent"},{"id":"loss-dta","title":"How much DTA should be recognised for the tax losses?","pitfall":"Recognising a {a|DTA} on the full loss","see":"recognise"},{"id":"recon","title":"Which item appears in the tax reconciliation, and what is disclosed?","pitfall":"Including temporary differences","see":"present"},{"id":"present-offset","title":"How are tax balances presented, and when are they offset?","pitfall":"Calling deferred tax current, or offsetting without a legal right and the same tax authority","see":"present"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":26,"title":"Income tax, the Socratic way","body":["Each idea starts with a question for you. Think it through, then reveal the answer. The rule comes after.","Examples use Singapore’s corporate tax rate of **17%**. Account names are coloured by element. Tap **Legend** any time.","At the end there is an exam-style quiz: four-option MCQs, mostly in case sets. Income tax didn’t appear in the practice paper, but it has six LOs (two at cognitive level 3), so expect it in the real exam."],"id":"intro-aagx29","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-classify","bucket":"classify","blabel":"why deferred tax","sect":1,"part":"Classify · why deferred tax"},{"type":"think","bucket":"classify","blabel":"why deferred tax","lo":26,"scenario":"Lim Trading made an accounting profit of $200,000. At 17% you might expect a tax bill of $34,000. But IRAS assesses only $30,770.","prompt":"How can the tax bill differ from profit × rate? What might cause the gap?","answer":["**Accounting profit** follows SFRS(I). **Taxable profit** follows tax law, and the two don’t always agree.","Some items are **never** taxable or deductible (a {x|fine}, non-deductible {x|entertainment}). Others are only **timing**: {x|depreciation} in the accounts vs capital allowances for tax, or a {l|provision} that is deductible only when paid."],"id":"think-1fq46d","sect":1,"part":"Classify · why deferred tax"},{"id":"think-19d99l","type":"think","bucket":"classify","blabel":"why deferred tax","lo":26,"scenario":"Lim Trading claimed $50,000 of capital allowances on a new machine this year, but only charged $25,000 of {x|depreciation}. Over the machine’s life both will total the same $100,000. The tax rate is 17%.","prompt":"Lim paid less tax this year. Has that saving gone for good, or does Lim owe something back?","answer":["It owes it back. Bigger allowances now mean **smaller allowances later**, so later tax bills will be higher.","That future tax already exists today because of this year’s events. Ignoring it would understate {l|liabilities}. That is **deferred tax**: 25,000 × 17% = $4,250.","Think of it as buy now, pay later: the taxman has a long memory, and the bill is already in the post."],"sect":1,"part":"Classify · why deferred tax"},{"type":"rule","bucket":"classify","blabel":"why deferred tax","lo":26,"title":"The objective of deferred tax","body":["You’ve just seen the problem: Lim’s tax bill this year is too low, because some of the tax is only postponed. Deferred tax exists so the accounts show that postponed tax now, alongside the profit that caused it.","Account for the **current and future tax consequences** of transactions in the **same period** and the **same place** (P&L, OCI or equity) as the transactions themselves.","- **Balance sheet liability approach:** compare each {a|asset’s} and {l|liability’s} **carrying amount** with its **tax base**. The gap is a **temporary difference**.","> Deferred tax ({l|DTL} or {a|DTA}) = temporary difference × tax rate","+ Deferred tax = tax that belongs to this year’s accounts but is paid (or saved) in a later year."],"id":"rule-1ldzxf","sect":1,"part":"Classify · why deferred tax"},{"type":"map","id":"map-2-classify","bucket":"classify","blabel":"permanent vs temporary","sect":2,"part":"Classify · permanent vs temporary"},{"id":"think-10vq03","type":"think","bucket":"classify","blabel":"permanent vs temporary","lo":27,"scenario":"Lim Trading paid a $2,000 {x|fine} for a late filing, and made a $20,000 {l|warranty provision} that IRAS will let it deduct only when claims are actually paid.","prompt":"For each item: will it **ever** affect tax? If yes, when?","answer":["The **{x|fine}** is never deductible. That is a **permanent difference**: no deferred tax. It just pushes up the effective tax rate.","The **{l|warranty provision}** will be deductible later, when paid. That is a **temporary difference**, so deferred tax applies (here, a future tax saving)."],"sect":2,"part":"Classify · permanent vs temporary"},{"type":"rule","bucket":"classify","blabel":"permanent vs temporary","lo":27,"title":"Two kinds of difference","body":["The {x|fine} and the {l|warranty provision} behaved differently: one never touches tax, the other only arrives late. That split is the first sort you make on every item, because only the late arrivals get deferred tax.","- **Permanent:** never taxable or deductible → **no deferred tax**. {x|Fines and penalties}, non-deductible {x|entertainment}, {i|exempt dividends}.","- **Taxable temporary:** will **increase** future taxable profit → {l|Deferred tax liability}. Allowances faster than {x|depreciation}, {e|revaluation surplus}, {a|interest receivable} taxed when received.","- **Deductible temporary:** will **reduce** future taxable profit → {a|Deferred tax asset}. {l|Provisions} deductible when paid, {x|depreciation} faster than allowances, unused tax losses.","! A permanent difference changes the **effective tax rate**, not deferred tax.","+ Permanent = “goodbye forever”. Temporary = “see you later”. Only the see-you-laters get deferred tax."],"id":"rule-1ue2id","sect":2,"part":"Classify · permanent vs temporary"},{"type":"mcq","bucket":"classify","blabel":"permanent vs temporary","lo":27,"q":"Which item is a **permanent** difference?","options":[{"t":"Capital allowances claimed faster than {x|depreciation}","why":"Timing only: over the asset’s life both total the same. Taxable temporary difference."},{"t":"A {x|penalty} for breaching environmental regulations","ok":true,"why":"Never deductible, so it never reverses."},{"t":"A {l|restructuring provision} deductible when paid","why":"Deductible later, so it is a deductible temporary difference."},{"t":"{a|Interest receivable} that is taxed when received","why":"Taxable later, so it is a taxable temporary difference."}],"id":"mcq-zlk2c3","sect":2,"part":"Classify · permanent vs temporary"},{"type":"map","id":"map-3-classify","bucket":"classify","blabel":"tax base","sect":3,"part":"Classify · tax base"},{"type":"think","bucket":"classify","blabel":"tax base","lo":27,"scenario":"A machine cost $80,000. Lim has already claimed $60,000 of capital allowances on it.","prompt":"If Lim recovered the machine’s value (by using or selling it), how much more could it still deduct for tax?","answer":["Only $20,000: the cost not yet claimed. That remaining deduction is the machine’s **tax base**."],"id":"think-1fgou8","sect":3,"part":"Classify · tax base"},{"type":"rule","bucket":"classify","blabel":"tax base","lo":27,"title":"Tax base","body":["To measure a temporary difference you need two numbers for each item: what the books say (the {a|carrying amount}) and what tax still recognises. The machine’s unclaimed cost was the second number. It has a name: the tax base.","- **{a|Asset}:** the amount that will be **deductible** for tax when you recover its {a|carrying amount}. Usually cost less allowances claimed.","- **{l|Liability}:** {l|carrying amount} **minus** any amount that will be **deductible** in future.","- **{l|Revenue received in advance}:** {l|carrying amount} minus any part that won’t be taxable in future.","> Temporary difference = carrying amount − tax base"],"id":"rule-1gkqy3","sect":3,"part":"Classify · tax base"},{"id":"think-1b3ch6","type":"think","bucket":"classify","blabel":"tax base","lo":27,"scenario":"Lim’s balance sheet shows a {l|warranty provision} of $20,000. The whole amount will be deductible when the claims are paid. The tax rate is 17%.","prompt":"Using the liability rule ({l|carrying amount} minus future deductions), what is its tax base?","answer":["$20,000 − $20,000 = **$0**.","{l|Carrying amount} 20,000 vs tax base 0: a 20,000 **deductible** difference, so {a|Deferred tax asset} = 20,000 × 17% = $3,400."],"sect":3,"part":"Classify · tax base"},{"id":"calc-1xk3tb","type":"calc","bucket":"classify","blabel":"tax base","lo":27,"q":"A {a|delivery van} cost $120,000. Capital allowances of $90,000 have been claimed. Its {a|carrying amount} is $80,000. What is its tax base?","answer":30000,"unit":"$","working":["Tax base = cost − allowances claimed = 120,000 − 90,000 = $30,000.","The {a|carrying amount} (80,000) doesn’t affect the tax base. It gives the temporary difference: 80,000 − 30,000 = 50,000 taxable."],"sect":3,"part":"Classify · tax base"},{"id":"visual-13r6mf","type":"visual","bucket":"classify","blabel":"tax base","lo":27,"title":"Which way does the difference go?","html":"\u003cp>Once you have a carrying amount and a tax base, one question is left: does the gap mean tax \u003cstrong>later\u003c/strong> or tax \u003cstrong>saved\u003c/strong>? It depends on which is bigger, and whether the item is an \u003cspan class=\"el el-a\">asset\u003c/span> or a \u003cspan class=\"el el-l\">liability\u003c/span>.\u003c/p>\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl\">\u003cthead>\u003ctr>\u003cth>\u003c/th>\u003cth>Carrying amount &gt; tax base\u003c/th>\u003cth>Carrying amount &lt; tax base\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003cth scope=\"row\">\u003cspan class=\"el el-a\">Asset\u003c/span>\u003c/th>\u003ctd>Taxable → \u003cspan class=\"el el-l\">Deferred tax liability\u003c/span>\u003c/td>\u003ctd>Deductible → \u003cspan class=\"el el-a\">Deferred tax asset\u003c/span>\u003c/td>\u003c/tr>\n      \u003ctr>\u003cth scope=\"row\">\u003cspan class=\"el el-l\">Liability\u003c/span>\u003c/th>\u003ctd>Deductible → \u003cspan class=\"el el-a\">Deferred tax asset\u003c/span>\u003c/td>\u003ctd>Taxable → \u003cspan class=\"el el-l\">Deferred tax liability\u003c/span>\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"key\">\u003cspan class=\"el el-a\">Assets\u003c/span>: bigger in the books = tax to pay later. \u003cspan class=\"el el-l\">Liabilities\u003c/span>: flip it.\u003c/p>","sect":3,"part":"Classify · tax base"},{"type":"diagram","bucket":"classify","blabel":"tax base","lo":27,"title":"Carrying amount vs tax base: DTL or DTA?","intro":"The same table as a chart. Follow an item down to see which way its difference goes.","notes":{"item":"Start with one balance-sheet item. Compare its carrying amount (CA, in the books) with its tax base (TB, what tax still recognises).","asset":"For an {a|asset}, the tax base is what you can still deduct when you recover it: usually cost less allowances claimed.","liab":"For a {l|liability}, the tax base is the {l|carrying amount} less anything deductible later. A {l|provision} deductible when paid has a tax base of 0.","aGt":"You will recover more than you can deduct, so the excess is taxed later. Example: allowances claimed faster than {x|depreciation}.","aLt":"You can deduct more than the {a|asset} is carried at, so tax is saved later. Example: {x|depreciation} faster than allowances.","lLt":"Rare in practice. The {l|liability} gives less deduction than its tax base implies, so tax is payable later.","lGt":"Paying it will be deductible later, so tax is saved. Example: a {l|warranty provision} of 20,000 with tax base 0.","tx":"Taxable temporary difference: future taxable profit will be higher.","dd":"Deductible temporary difference: future taxable profit will be lower. Unused tax losses work the same way.","dtl":"Recognise a {l|DTL} for (almost) every taxable difference. No probability test.","dta":"Recognise a {a|DTA} only to the extent future taxable profit is probable to use it."},"walk":[{"nodes":["item","asset","liab"],"text":"First ask: is the item an asset or a liability? The rule flips between them."},{"nodes":["asset","aGt","aLt"],"text":"{a|Asset}: {a|carrying amount} above tax base means tax to pay later; below means tax saved later."},{"nodes":["liab","lGt","lLt"],"text":"{l|Liability}: the reverse. A {l|provision} carried above its tax base gives a deduction when paid."},{"nodes":["aGt","lLt","tx","dtl"],"text":"Taxable differences become a {l|DTL}: difference × enacted rate."},{"nodes":["aLt","lGt","dd","dta"],"text":"Deductible differences become a {a|DTA}, but only if future taxable profit is probable."}],"caption":"{a|Assets}: bigger in the books = tax later. {l|Liabilities}: flip it.","id":"diagram-11luip","sect":3,"part":"Classify · tax base","svg":"\u003csvg width=\"100%\" style=\"min-width:483px\" role=\"img\"\n viewBox=\"0.00 0.00 439.00 309.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 294.4)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-294.4 424.25,-294.4 424.25,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>item\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M250.98,-280C250.98,-280 146.88,-280 146.88,-280 140.88,-280 134.88,-274 134.88,-268 134.88,-268 134.88,-256 134.88,-256 134.88,-250 140.88,-244 146.88,-244 146.88,-244 250.98,-244 250.98,-244 256.98,-244 262.98,-250 262.98,-256 262.98,-256 262.98,-268 262.98,-268 262.98,-274 256.98,-280 250.98,-280\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"153.18\" y=\"-262.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Asset or liability?\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"145.68\" y=\"-253.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">compare CA with tax base\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>asset\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M170.93,-219C170.93,-219 140.93,-219 140.93,-219 134.9