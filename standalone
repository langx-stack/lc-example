lvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Present\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"95.93\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">SFP · SPLOCI · SOCE · notes\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge7\" class=\"edge\">\n\u003ctitle>pl&#45;&gt;fs\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M100.16,-60.62C108.18,-54.55 117.29,-47.65 125.76,-41.25\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"126.78,-43.55 130.88,-37.38 123.82,-39.64 126.78,-43.55\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>cls\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M279.85,-97C279.85,-97 188.5,-97 188.5,-97 182.5,-97 176.5,-91 176.5,-85 176.5,-85 176.5,-73 176.5,-73 176.5,-67 182.5,-61 188.5,-61 188.5,-61 279.85,-61 279.85,-61 285.85,-61 291.85,-67 291.85,-73 291.85,-73 291.85,-85 291.85,-85 291.85,-91 285.85,-97 279.85,-97\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"213.18\" y=\"-79.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Classify\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"187.3\" y=\"-70.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">current or non&#45;current?\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>bal&#45;&gt;cls\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M222.89,-121.62C224.24,-116.62 225.75,-111.06 227.21,-105.68\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"229.58,-106.32 229.04,-98.92 224.85,-105.04 229.58,-106.32\"/>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>cls&#45;&gt;fs\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M210.9,-60.62C202.86,-54.61 193.72,-47.79 185.21,-41.43\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"186.84,-39.59 179.77,-37.37 183.91,-43.52 186.84,-39.59\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"je-x1o22i","type":"je","bucket":"adjust","lo":46,"q":"($’000) Lion City Venture (LCV), year end 31 December 20X5: its unadjusted {l|salary payable} of 4,000 doesn’t include 500 owed to employees for work done in December 20X5. Record the adjustment.","accounts":["Salary expense","Salary payable","Rent expense","Prepaid rent","Deferred revenue","Revenue","Impairment loss on receivables","Allowance for uncollectible accounts","Interest expense","Interest payable","Share capital","Tax payable","Inventory","Cost of sales","Investment property","Fair value gain on investment property","Depreciation expense","Accumulated depreciation","Retained earnings","Cash"],"lines":[{"side":"Dr","account":"Salary expense","amount":500},{"side":"Cr","account":"Salary payable","amount":500}],"why":"The work was done in 20X5, so the {x|expense} belongs in 20X5. {l|Salary payable} becomes 4,500, a {l|current liability}.","sect":2,"part":"Trial balance to adjusted figures"},{"id":"je-1khdmj","type":"je","bucket":"adjust","lo":46,"q":"($’000) Lion City Venture (LCV), year end 31 December 20X5: its {l|deferred revenue} was 3,500 in the unadjusted trial balance; at 31 December 20X5 it should be 2,750. Record the adjustment.","accounts":["Salary expense","Salary payable","Rent expense","Prepaid rent","Deferred revenue","Revenue","Impairment loss on receivables","Allowance for uncollectible accounts","Interest expense","Interest payable","Share capital","Tax payable","Inventory","Cost of sales","Investment property","Fair value gain on investment property","Depreciation expense","Accumulated depreciation","Retained earnings","Cash"],"lines":[{"side":"Dr","account":"Deferred revenue","amount":750},{"side":"Cr","account":"Revenue","amount":750}],"why":"3,500 − 2,750 = 750 has now been earned, so it moves from the {l|liability} into {i|revenue}. {i|Revenue} rises to 125,750.","sect":2,"part":"Trial balance to adjusted figures"},{"id":"je-1jol0c","type":"je","bucket":"adjust","lo":46,"q":"($’000) Lion City Venture (LCV), year end 31 December 20X5: its {a|allowance for uncollectible accounts} is 5,750 in the unadjusted trial balance and should be 6,200 at 31 December 20X5. Record the adjustment.","accounts":["Salary expense","Salary payable","Rent expense","Prepaid rent","Deferred revenue","Revenue","Impairment loss on receivables","Allowance for uncollectible accounts","Interest expense","Interest payable","Share capital","Tax payable","Inventory","Cost of sales","Investment property","Fair value gain on investment property","Depreciation expense","Accumulated depreciation","Retained earnings","Cash"],"lines":[{"side":"Dr","account":"Impairment loss on receivables","amount":450},{"side":"Cr","account":"Allowance for uncollectible accounts","amount":450}],"why":"Only the **increase** (6,200 − 5,750 = 450) is the {x|expense}. The full {a|allowance} of 6,200 is deducted from {a|receivables} in the statement of financial position.","sect":2,"part":"Trial balance to adjusted figures"},{"type":"visual","bucket":"adjust","lo":46,"title":"Receivables: gross less the allowance","html":"\u003cp>The \u003cspan class=\"el el-a\">allowance for uncollectible accounts\u003c/span> is a \u003cstrong>contra asset account\u003c/strong>: it never appears on its own, it is deducted from \u003cspan class=\"el el-a\">gross receivables\u003c/span>. The bar shows the two layers: the part expected to be collected, and the part the allowance takes off.\u003c/p>\u003cdiv class=\"cbars\">\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003ci class=\"seg a\">\u003c/i>\u003cspan class=\"el el-a\">Net receivables\u003c/span>\u003c/span>\u003cspan>\u003ci class=\"seg out-a\">\u003c/i>\u003cspan class=\"el el-a\">Allowance\u003c/span> (contra, deducted)\u003c/span>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">\u003cspan class=\"el el-a\">Gross receivables\u003c/span> 21,250\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg a\" style=\"width:70.82%\">\u003c/i>\u003ci class=\"seg out-a\" style=\"width:29.18%\">\u003c/i>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">\u003cspan class=\"el el-a\">Net receivables in the SFP\u003c/span> 15,050\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg a\" style=\"width:70.82%\">\u003c/i>\u003c/div>\u003c/div>\n  \u003c/div>\n  \u003cp class=\"cap\">\u003cspan class=\"el el-a\">Gross\u003c/span> 21,250 − \u003cspan class=\"el el-a\">allowance\u003c/span> 6,200 = \u003cstrong>\u003cspan class=\"el el-a\">15,050\u003c/span>\u003c/strong> ($’000). The \u003cspan class=\"el el-x\">expense\u003c/span> is only this year’s increase in the allowance, 450; the whole 6,200 is deducted.\u003c/p>","id":"visual-1qrgbn","sect":2,"part":"Trial balance to adjusted figures"},{"id":"think-1kbu29","type":"think","bucket":"adjust","lo":46,"scenario":"Lion City Venture (LCV), year end 31 December 20X5, uses the periodic method. {a|Opening inventory} was 31,250k and {x|purchases} 100,000k. {a|Closing inventory} at cost is 39,850k, but some lines must be written down by 6,800k to net realisable value.","prompt":"Where does the write-down go, and what {a|closing inventory} figure goes in the statement of financial position?","answer":["{a|Closing inventory} goes in at **33,050k** (39,850 − 6,800), the lower of cost and NRV.","Because {x|cost of sales} = {a|opening} + {x|purchases} − {a|closing}, a lower {a|closing} figure makes {x|cost of sales} **higher** by the write-down. No separate entry needed: the write-down hides inside {x|Cost of sales}."],"sect":2,"part":"Trial balance to adjusted figures"},{"type":"visual","bucket":"adjust","lo":46,"title":"Where the inventory write-down goes","html":"\u003cp>Two versions of LCV’s \u003cspan class=\"el el-a\">inventory\u003c/span> for 20X5 ($’000). Left: closing stock left at cost. Right: written down to NRV. Each roll-forward has the same layers: \u003cspan class=\"el el-a\">opening\u003c/span>, + \u003cspan class=\"el el-x\">purchases\u003c/span>, − what is charged to \u003cspan class=\"el el-x\">cost of sales\u003c/span>. The right panel has one extra layer, the write-down.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"inv-d1\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;At cost&quot;,&quot;sub&quot;:&quot;no write-down (wrong)&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Inventory&quot;,&quot;start&quot;:31250,&quot;startCap&quot;:&quot;{a|Opening inventory} {a|31,250}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X5&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;purchases&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:100000,&quot;cap&quot;:&quot;{a|Opening} 31,250 + {x|purchases} 100,000 = {a|131,250} available for sale.&quot;},{&quot;name&quot;:&quot;sold at cost&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-91400,&quot;cap&quot;:&quot;Goods sold at cost: 131,250 − {a|closing at cost} 39,850 = {x|91,400} to {x|cost of sales}. {a|Closing inventory} stays at {a|39,850}.&quot;}],&quot;hold&quot;:&quot;No write-down: {a|inventory} stays overstated at {a|39,850}, and {x|cost of sales} is only {x|91,400}.&quot;}]},{&quot;title&quot;:&quot;At lower of cost and NRV&quot;,&quot;sub&quot;:&quot;write-down recorded&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Inventory&quot;,&quot;start&quot;:31250,&quot;startCap&quot;:&quot;{a|Opening inventory} {a|31,250}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X5&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;purchases&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:100000,&quot;cap&quot;:&quot;{a|Opening} 31,250 + {x|purchases} 100,000 = {a|131,250} available for sale.&quot;},{&quot;name&quot;:&quot;sold at cost&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-91400,&quot;cap&quot;:&quot;Goods sold at cost: 131,250 − {a|closing at cost} 39,850 = {x|91,400} to {x|cost of sales}.&quot;},{&quot;name&quot;:&quot;NRV write-down&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-6800,&quot;cap&quot;:&quot;Write down 6,800 to NRV: {a|closing} = {a|33,050}, and {x|cost of sales} becomes 91,400 + 6,800 = **{x|98,200}**.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Same opening stock, same purchases. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Purchases add to the goods available for sale.&quot;,&quot;Whatever is not in {a|closing inventory} was sold: it goes to {x|cost of sales}.&quot;,&quot;The NRV write-down lowers {a|closing inventory}, and the cost of sales formula picks it up automatically.&quot;],&quot;end&quot;:&quot;**The write-down hides inside {x|cost of sales}.** 39,850 − 6,800 = {a|33,050} in the SFP, and {x|cost of sales} 98,200 instead of 91,400, so gross profit falls by 6,800. Miss it and both the SFP and gross profit are overstated.&quot;}}\">\u003c/div>","id":"visual-9aed3p","sect":2,"part":"Trial balance to adjusted figures"},{"id":"visual-1botvw","type":"visual","bucket":"adjust","lo":46,"title":"Lion City Venture: the adjustments ($’000)","html":"\u003cp>Every adjustment from the case in one table, the way you should lay it out before answering anything. The pattern: the trial balance figure, what changes, and the adjusted figure that goes into the statements.\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num reveal-rows\">\u003cthead>\u003ctr>\u003cth>Item\u003c/th>\u003cth>Trial balance\u003c/th>\u003cth>Adjustment\u003c/th>\u003cth>Adjusted\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-i\">Revenue\u003c/span> (sales)\u003c/td>\u003ctd>125,000\u003c/td>\u003ctd>+750 earned\u003c/td>\u003ctd>125,750\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Inventory\u003c/span> (closing)\u003c/td>\u003ctd>—\u003c/td>\u003ctd>39,850 − 6,800 NRV\u003c/td>\u003ctd>33,050\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Investment property\u003c/span>\u003c/td>\u003ctd>35,000\u003c/td>\u003ctd>+2,500 \u003cspan class=\"el el-i\">FV gain\u003c/span> to P&amp;L\u003c/td>\u003ctd>37,500\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Marketable securities\u003c/span> (FVTPL)\u003c/td>\u003ctd>10,000\u003c/td>\u003ctd>+1,250 \u003cspan class=\"el el-i\">FV gain\u003c/span> to P&amp;L\u003c/td>\u003ctd>11,250\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Prepaid rent\u003c/span>\u003c/td>\u003ctd>3,000\u003c/td>\u003ctd>−250 to \u003cspan class=\"el el-x\">rent expense\u003c/span>\u003c/td>\u003ctd>2,750\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Allowance for uncollectible accounts\u003c/span>\u003c/td>\u003ctd>(5,750)\u003c/td>\u003ctd>−450 to P&L\u003c/td>\u003ctd>(6,200)\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-l\">Salary payable\u003c/span>\u003c/td>\u003ctd>4,000\u003c/td>\u003ctd>+500 accrual\u003c/td>\u003ctd>4,500\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-l\">Interest payable\u003c/span> (bond)\u003c/td>\u003ctd>—\u003c/td>\u003ctd>17,500 × 8% × 9/12\u003c/td>\u003ctd>1,050\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-l\">Tax payable\u003c/span>\u003c/td>\u003ctd>2,250\u003c/td>\u003ctd>+550 error fixed\u003c/td>\u003ctd>2,800\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-l\">Deferred revenue\u003c/span>\u003c/td>\u003ctd>3,500\u003c/td>\u003ctd>−750 earned\u003c/td>\u003ctd>2,750\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">\u003cspan class=\"el el-x\">Depreciation\u003c/span> on the \u003cspan class=\"el el-a\">building\u003c/span> and \u003cspan class=\"el el-a\">machinery\u003c/span> is the other adjustment: you get to compute that one yourself in the quiz.\u003c/p>","sect":2,"part":"Trial balance to adjusted figures"},{"id":"je-3eib2d","type":"je","bucket":"adjust","lo":46,"q":"($’000) Lion City Venture (LCV), year end 31 December 20X5, has a 17,500 {l|bond} that pays an 8% coupon annually on 31 March. No {x|interest} has been accrued since the last payment. Record the accrual at 31 December 20X5.","accounts":["Salary expense","Salary payable","Rent expense","Prepaid rent","Deferred revenue","Revenue","Impairment loss on receivables","Allowance for uncollectible accounts","Interest expense","Interest payable","Share capital","Tax payable","Inventory","Cost of sales","Investment property","Fair value gain on investment property","Depreciation expense","Accumulated depreciation","Retained earnings","Cash"],"lines":[{"side":"Dr","account":"Interest expense","amount":1050},{"side":"Cr","account":"Interest payable","amount":1050}],"why":"April to December is 9 months: 17,500 × 8% × 9/12 = 1,050. It is a {l|current liability}, payable on 31 March 20X6.","sect":2,"part":"Trial balance to adjusted figures"},{"id":"je-9bpexv","type":"je","bucket":"adjust","lo":46,"q":"($’000) On 15 January 20X6, before its 31 December 20X5 statements are issued, Lion City Venture (LCV) finds that a {l|tax payable} of 550 was posted to {e|share capital} by mistake. Correct it.","accounts":["Salary expense","Salary payable","Rent expense","Prepaid rent","Deferred revenue","Revenue","Impairment loss on receivables","Allowance for uncollectible accounts","Interest expense","Interest payable","Share capital","Tax payable","Inventory","Cost of sales","Investment property","Fair value gain on investment property","Depreciation expense","Accumulated depreciation","Retained earnings","Cash"],"lines":[{"side":"Dr","account":"Share capital","amount":550},{"side":"Cr","account":"Tax payable","amount":550}],"why":"{e|Share capital} was overstated and {l|tax payable} understated by 550. Fixing it before issue means the 20X5 statements show {l|Tax payable} of 2,800.","sect":2,"part":"Trial balance to adjusted figures"},{"id":"calc-1d1rvw","type":"calc","bucket":"adjust","lo":46,"q":"A {a|delivery van} cost $90,000. It is depreciated straight-line over 4 years to a residual value of $10,000. What is the annual {x|depreciation charge}?","answer":20000,"unit":"$","working":["(90,000 − 10,000) ÷ 4 = $20,000.","Residual value comes off first. Forgetting it is the classic depreciation trap."],"sect":2,"part":"Trial balance to adjusted figures"},{"type":"rule","bucket":"adjust","lo":46,"title":"Exam technique for a trial-balance case","body":["You have now seen each adjustment on its own. In the exam they arrive all at once, and one case set reuses them across five questions, so order matters.","1. Read every line of additional information and turn each into a journal entry or a working.","2. Put the adjusted figures in one table **before** answering any question.","3. Only then answer: gross profit, {x|depreciation}, totals for each class.","! The five practice-paper questions on Lion City Venture share the same adjustments. Miss one item ({x|bond interest}, say) and two answers break at once.","- {x|Depreciation} already recorded “to 31 Dec 20X5” (like LCV’s {x|patent amortisation}) is not charged again."],"id":"rule-94t6mj","sect":2,"part":"Trial balance to adjusted figures"},{"type":"map","id":"map-3-pl","bucket":"pl","sect":3,"part":"Profit or loss, OCI and equity"},{"id":"think-16qq3t","type":"think","bucket":"pl","lo":46,"scenario":"A furniture maker’s {x|depreciation} of $50,000 is on its {a|factory machines}, its {a|delivery lorries} and its {a|head-office computers}.","prompt":"If the P&L shows {x|expenses} **by function** ({x|cost of sales}, {x|distribution}, {x|admin}), where does that $50,000 go? And what if it shows them **by nature**?","answer":["**By function:** split it. {x|Factory depreciation} goes to {x|cost of sales}, lorries to {x|distribution}, computers to {x|admin}.","**By nature:** one line, “{x|depreciation}”. Then the reader can’t see gross profit, but sees the nature of every cost.","If you use by function, you also disclose {x|depreciation} and {x|employee costs} **by nature** in the notes."],"sect":3,"part":"Profit or loss, OCI and equity"},{"type":"rule","bucket":"pl","lo":46,"title":"The statement of profit or loss and OCI","body":["With the figures adjusted, the first statement to lay out is performance. The depreciation question was about the choice of format; here are the rest of the layout rules.","- **By nature** ({x|raw materials used}, {x|employee costs}, {x|depreciation}) **or by function** ({x|cost of sales}, {x|distribution}, {x|admin}). By function needs a note of {x|depreciation} and {x|employee costs} by nature.","- **One statement or two:** a single statement of P&L and OCI, or a P&L followed by a statement starting from profit.","- **No “extraordinary items”**, in P&L, OCI or the notes.","- **OCI in two groups:** items that **will not** be reclassified to P&L ({e|revaluation surplus}, FVOCI equity) and items that **may** be (FVOCI debt, cash flow hedges).","> Profit for the year + OCI = total comprehensive income"],"id":"rule-jyzflg","sect":3,"part":"Profit or loss, OCI and equity"},{"id":"visual-1eeb1s","type":"visual","bucket":"pl","lo":46,"title":"Model statement of P&L and OCI (by function)","html":"\u003cp>The rules above, laid out as a statement. Read it top to bottom: profit is built line by line, then OCI is added in its two groups.\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl reveal-rows\">\u003cthead>\u003ctr>\u003cth>Line\u003c/th>\u003cth>What goes in\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-i\">Revenue\u003c/span>\u003c/td>\u003ctd>SFRS(I) 15 revenue\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-x\">Cost of sales\u003c/span>\u003c/td>\u003ctd>\u003cspan class=\"el el-a\">Opening inventory\u003c/span> + \u003cspan class=\"el el-x\">purchases\u003c/span> − \u003cspan class=\"el el-a\">closing\u003c/span> (incl. write-downs); \u003cspan class=\"el el-x\">factory depreciation\u003c/span>\u003c/td>\u003c/tr>\n      \u003ctr>\u003cth scope=\"row\">Gross profit\u003c/th>\u003ctd>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-i\">Other income\u003c/span>\u003c/td>\u003ctd>\u003cspan class=\"el el-i\">IP and FVTPL fair value gains\u003c/span>, \u003cspan class=\"el el-i\">rent\u003c/span>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-x\">Distribution · administrative · other expenses\u003c/span>\u003c/td>\u003ctd>\u003cspan class=\"el el-x\">Depreciation\u003c/span> is spread across these functions\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-x\">Finance costs\u003c/span>\u003c/td>\u003ctd>\u003cspan class=\"el el-x\">Interest\u003c/span> on \u003cspan class=\"el el-l\">loans\u003c/span>, \u003cspan class=\"el el-l\">bonds\u003c/span>, \u003cspan class=\"el el-l\">leases\u003c/span>; unwinding of discounts\u003c/td>\u003c/tr>\n      \u003ctr>\u003cth scope=\"row\">Profit before tax\u003c/th>\u003ctd>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-x\">Income tax expense\u003c/span>\u003c/td>\u003ctd>Current + deferred\u003c/td>\u003c/tr>\n      \u003ctr>\u003cth scope=\"row\">Profit for the year\u003c/th>\u003ctd>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>OCI: will not be reclassified\u003c/td>\u003ctd>\u003cspan class=\"el el-e\">Revaluation surplus\u003c/span>; FVOCI equity\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>OCI: may be reclassified\u003c/td>\u003ctd>FVOCI debt; cash flow hedges\u003c/td>\u003c/tr>\n      \u003ctr>\u003cth scope=\"row\">Total comprehensive income\u003c/th>\u003ctd>\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>","sect":3,"part":"Profit or loss, OCI and equity"},{"type":"diagram","bucket":"pl","lo":46,"title":"P&L or OCI, and which OCI group?","intro":"Every {i|income} and {x|expense} item goes down this chart once.","notes":{"item":"Any {i|income} or {x|expense} for the period, after the year-end adjustments.","q1":"Only items a standard sends to OCI go there. Everything else is profit or loss: that is the default.","pl":"{i|Revenue}, {x|cost of sales}, {x|operating expenses}, {x|finance costs}, {x|tax}, and {i|gains} on {a|investment property} (fair value model) and {a|FVTPL assets}.","q2":"OCI items are grouped by whether they can later be “recycled” into profit or loss.","no":"{e|Revaluation surplus} on {a|PPE} and fair value changes on {a|FVOCI equity investments} never pass through P&L.","may":"Fair value changes on {a|FVOCI debt investments} are reclassified to P&L when the investment is sold (also cash flow hedges).","tci":"Profit + OCI = total comprehensive income, the bottom line of the statement.","soce":"In equity, profit goes to {e|retained earnings}; OCI goes to {e|its own reserve} (e.g. {e|revaluation surplus})."},"walk":[{"nodes":["item","q1","pl"],"text":"Default: profit or loss. OCI only if a standard says so."},{"nodes":["q2","no","may"],"text":"OCI items are split into two groups by whether they can be recycled."},{"nodes":["tci","soce"],"text":"Both feed total comprehensive income, and then the statement of changes in equity."}],"caption":"P&L by default; OCI by permission, in two groups.","id":"diagram-aht98v","sect":3,"part":"Profit or loss, OCI and equity","svg":"\u003csvg width=\"100%\" style=\"min-width:524px\" role=\"img\"\n viewBox=\"0.00 0.00 476.00 431.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 416.81)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-416.81 461.88,-416.81 461.88,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>item\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M166