:space=\"preserve\" text-anchor=\"start\" x=\"143.62\" y=\"-237.05\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"12.00\" fill=\"white\">Useful financial information\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>rel\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M207.93,-191.08C207.93,-191.08 64.07,-191.08 64.07,-191.08 58.07,-191.08 52.08,-185.08 52.08,-179.08 52.08,-179.08 52.08,-164 52.08,-164 52.08,-158 58.08,-152 64.08,-152 64.08,-152 207.93,-152 207.93,-152 213.93,-152 219.93,-158 219.93,-164 219.93,-164 219.93,-179.08 219.93,-179.08 219.93,-185.08 213.93,-191.08 207.93,-191.08\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"109\" y=\"-176.59\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Relevance\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"62.88\" y=\"-167.49\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">predictive value · confirmatory value\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"83.12\" y=\"-158.49\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">materiality (entity&#45;specific)\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge1\" class=\"edge\">\n\u003ctitle>useful&#45;&gt;rel\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M176.38,-222.81C176.38,-222.81 176.38,-198.91 176.38,-198.91\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"178.48,-198.91 176.38,-192.91 174.28,-198.91 178.48,-198.91\"/>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>fr\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M367.8,-191.08C367.8,-191.08 250.2,-191.08 250.2,-191.08 244.2,-191.08 238.2,-185.08 238.2,-179.08 238.2,-179.08 238.2,-164 238.2,-164 238.2,-158 244.2,-152 250.2,-152 250.2,-152 367.8,-152 367.8,-152 373.8,-152 379.8,-158 379.8,-164 379.8,-164 379.8,-179.08 379.8,-179.08 379.8,-185.08 373.8,-191.08 367.8,-191.08\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"249.38\" y=\"-176.59\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Faithful representation\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"249\" y=\"-167.49\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">complete · neutral (prudence)\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"280.12\" y=\"-158.49\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">free from error\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>useful&#45;&gt;fr\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M274.69,-222.81C274.69,-222.81 274.69,-198.91 274.69,-198.91\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"276.79,-198.91 274.69,-192.91 272.59,-198.91 276.79,-198.91\"/>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>c\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M91.8,-108C91.8,-108 28.2,-108 28.2,-108 22.2,-108 16.2,-102 16.2,-96 16.2,-96 16.2,-84 16.2,-84 16.2,-78 22.2,-72 28.2,-72 28.2,-72 91.8,-72 91.8,-72 97.8,-72 103.8,-78 103.8,-84 103.8,-84 103.8,-96 103.8,-96 103.8,-102 97.8,-108 91.8,-108\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"60\" y=\"-85.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">Comparability\u003c/text>\n\u003c/g>\n\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>u\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M214.43,-108C214.43,-108 133.57,-108 133.57,-108 127.58,-108 121.58,-102 121.58,-96 121.58,-96 121.58,-84 121.58,-84 121.58,-78 127.58,-72 133.57,-72 133.57,-72 214.43,-72 214.43,-72 220.43,-72 226.43,-78 226.43,-84 226.43,-84 226.43,-96 226.43,-96 226.43,-102 220.43,-108 214.43,-108\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"174\" y=\"-85.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">Understandability\u003c/text>\n\u003c/g>\n\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>t\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M305.3,-108C305.3,-108 256.7,-108 256.7,-108 250.7,-108 244.7,-102 244.7,-96 244.7,-96 244.7,-84 244.7,-84 244.7,-78 250.7,-72 256.7,-72 256.7,-72 305.3,-72 305.3,-72 311.3,-72 317.3,-78 317.3,-84 317.3,-84 317.3,-96 317.3,-96 317.3,-102 311.3,-108 305.3,-108\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"281\" y=\"-85.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">Timeliness\u003c/text>\n\u003c/g>\n\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>v\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M396.3,-108C396.3,-108 347.7,-108 347.7,-108 341.7,-108 335.7,-102 335.7,-96 335.7,-96 335.7,-84 335.7,-84 335.7,-78 341.7,-72 347.7,-72 347.7,-72 396.3,-72 396.3,-72 402.3,-72 408.3,-78 408.3,-84 408.3,-84 408.3,-96 408.3,-96 408.3,-102 402.3,-108 396.3,-108\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"372\" y=\"-85.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">Verifiability\u003c/text>\n\u003c/g>\n\n\n\u003cg id=\"node8\" class=\"node\">\n\u003ctitle>cost\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M277.18,-36C277.18,-36 176.82,-36 176.82,-36 170.82,-36 164.82,-30 164.82,-24 164.82,-24 164.82,-12 164.82,-12 164.82,-6 170.82,0 176.82,0 176.82,0 277.18,0 277.18,0 283.18,0 289.18,-6 289.18,-12 289.18,-12 289.18,-24 289.18,-24 289.18,-30 283.18,-36 277.18,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"184.62\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Constraint: cost\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"175.62\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">benefits must justify costs\u003c/text>\n\u003c/g>\n\n\n\u003c/g>\n\u003c/svg>\n"},{"id":"think-1d5tdk","type":"think","bucket":"fundamental","lo":4,"scenario":"A S$5,000 misstatement turns up in two sets of accounts: a neighbourhood hardware shop with profit of S$40,000, and a listed bank with profit of S$4 billion. Separately, the bank has made a S$5,000 {a|loan} to one of its directors.","prompt":"Is the S$5,000 “material” in each case? And is there a fixed percentage that decides?","answer":["For the **hardware shop**, S$5,000 is an eighth of profit: it could change a reader’s view, so it is **material**.","For the **bank’s** misstatement, almost certainly **not material** by size.","But the **{a|loan} to a director** may be material by its **nature**, whatever its size: users care about dealings with the people running the company.","There is **no fixed threshold**. Materiality is **entity-specific**: it depends on the item’s size and nature in that entity’s own context."],"sect":1,"part":"Fundamental characteristics"},{"type":"rule","bucket":"fundamental","lo":4,"title":"Materiality: the entity-specific side of relevance","body":["Relevance asks whether information could change a decision. Materiality asks the same question about one entity’s own numbers, which is why the same S$5,000 got two answers.","Information is **material** if **omitting, misstating or obscuring** it could reasonably be expected to influence users’ decisions.","- It is an **entity-specific aspect of relevance**, judged on the nature or size (or both) of the item.","- There is **no fixed threshold** in the Framework.","! Materiality is **not** a separate qualitative characteristic. It sits inside relevance."],"id":"rule-vrchp4","sect":1,"part":"Fundamental characteristics"},{"type":"mcq","bucket":"fundamental","lo":4,"q":"Which statement about materiality is correct?","options":[{"t":"An item is material if it exceeds 5% of profit before tax","why":"The Framework sets no fixed threshold."},{"t":"Materiality is a third fundamental qualitative characteristic","why":"The fundamental QCs are relevance and faithful representation only. Materiality is part of relevance."},{"t":"Information is material if omitting, misstating or obscuring it could reasonably be expected to influence users’ decisions","ok":true,"why":"The Framework’s definition. It is entity-specific."},{"t":"Materiality depends only on the size of an item, not its nature","why":"Nature matters too: a small {a|loan} to a director can be material."}],"id":"mcq-6mnhyz","sect":1,"part":"Fundamental characteristics"},{"id":"think-1uovef","type":"think","bucket":"fundamental","lo":4,"scenario":"Pulau Paints’ CFO, worried about a slow year ahead, wants to add a S$2 million “{l|provision} for hard times” and to write its {a|inventory} down by 20% “just to be safe”. She calls this being prudent.","prompt":"Does prudence allow that? Which part of faithful representation is she breaking?","answer":["No. **Prudence** means **caution when making judgements under uncertainty**. It does **not** allow deliberately understating {a|assets} or overstating {l|liabilities}.","A made-up {l|provision} and an arbitrary {x|write-down} are **bias**. They break **neutrality**, and with it faithful representation.","And the bias would reverse later, flattering a future year’s profit. A cushion today is a trampoline tomorrow."],"sect":1,"part":"Fundamental characteristics"},{"type":"rule","bucket":"fundamental","lo":4,"title":"Faithful representation: complete, neutral, free from error","body":["The CFO’s “prudent” cushions make the numbers look careful but tell the wrong story. Faithful representation is the test she fails, and it has three parts.","Faithful representation shows the **substance** of what happened, not just its legal form. Ideally it is:","1. **Complete:** everything a user needs to understand the item, including descriptions and explanations.","2. **Neutral:** no bias in selecting or presenting information. Supported by **prudence**: caution when judging under uncertainty.","3. **Free from error:** no errors or omissions in the description or the process. It does **not** mean perfectly accurate: an estimate is faithful if it is clearly described.","- **Measurement uncertainty** (estimates) can still give useful information, but very high uncertainty may make another measure more useful.","! Prudence does **not** allow deliberately understating {a|assets} or overstating {l|liabilities}. Prudence supports neutrality; it is not a QC itself."],"id":"rule-fyok1j","sect":1,"part":"Fundamental characteristics"},{"id":"mcq-pnyi41","type":"mcq","bucket":"fundamental","lo":4,"q":"A company estimates its {l|warranty provision} using past claims data and explains the method and key assumptions in the notes. The actual claims later differ from the estimate. Was the provision a faithful representation?","options":[{"t":"No, because faithful representation requires the amount to be perfectly accurate","why":"“Free from error” does not mean perfectly accurate."},{"t":"Yes: free from error means no errors in the description or process, and an estimate can be faithful if it is clearly described","ok":true,"why":"A clearly described estimate, properly made, can be faithful even if the outcome differs."},{"t":"No, because estimates should be left out of the financial statements","why":"Measurement uncertainty does not stop information being useful. Leaving the {l|provision} out would make the FS incomplete."},{"t":"Yes, because prudence is a fundamental characteristic and the provision was cautious","why":"Prudence is not a QC; it supports neutrality."}],"sect":1,"part":"Fundamental characteristics"},{"id":"think-okkpwr","type":"think","bucket":"fundamental","lo":4,"scenario":"A standard setter is deciding how a company should report its {a|factory}. Options: the original cost, today’s fair value, or a value-in-use model built on 30 years of cash-flow forecasts.","prompt":"In what order would you apply “relevant” and “faithfully represented” to choose between them?","answer":["Start with **what users need**: the economic phenomenon that would be useful to them (the {a|factory} and what it can earn).","Then find the **most relevant** information about it. Then ask whether that information can be **faithfully represented**.","If the most relevant measure is too uncertain to be faithful (that 30-year forecast, say), drop to the **next most relevant** type and test again."],"sect":1,"part":"Fundamental characteristics"},{"type":"diagram","bucket":"fundamental","lo":4,"title":"Applying the fundamental characteristics","intro":"Three steps, with a loop: relevance picks the candidate, faithful representation tests it.","notes":{"s1":"Start with users: which event or item would help their decisions?","s2":"Relevance first: what information about it would make the most difference?","s3":"Faithful representation as the test: complete, neutral, free from error, and not so uncertain that it misleads.","ok":"Both fundamentals met: the information is useful.","next":"Too uncertain or can’t be depicted faithfully? Take the next most relevant type and test that."},"walk":[{"nodes":["s1"],"text":"**Step 1:** identify the economic phenomenon that would be useful to users."},{"nodes":["s2"],"text":"**Step 2:** find the **most relevant** information about it."},{"nodes":["s3","ok"],"text":"**Step 3:** can it be **faithfully represented**? If yes, use it."},{"nodes":["next","s3"],"text":"If not, take the **next most relevant** type and test again."}],"caption":"Relevance proposes, faithful representation disposes.","id":"diagram-lvktrk","sect":1,"part":"Fundamental characteristics","svg":"\u003csvg width=\"100%\" style=\"min-width:332px\" role=\"img\"\n viewBox=\"0.00 0.00 302.00 286.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 275.33)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-275.33 291.6,-275.33 291.6,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>s1\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M233.15,-264.53C233.15,-264.53 82.37,-264.53 82.37,-264.53 76.38,-264.53 70.37,-258.53 70.37,-252.53 70.37,-252.53 70.37,-240.53 70.37,-240.53 70.37,-234.53 76.37,-228.53 82.37,-228.53 82.37,-228.53 233.15,-228.53 233.15,-228.53 239.15,-228.53 245.15,-234.53 245.15,-240.53 245.15,-240.53 245.15,-252.53 245.15,-252.53 245.15,-258.53 239.15,-264.53 233.15,-264.53\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"79.01\" y=\"-247.08\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">1. The economic phenomenon\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"99.64\" y=\"-237.98\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"white\">that would be useful to users\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>s2\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M227.53,-201.53C227.53,-201.53 88,-201.53 88,-201.53 82,-201.53 76,-195.53 76,-189.53 76,-189.53 76,-177.53 76,-177.53 76,-171.53 82,-165.53 88,-165.53 88,-165.53 227.53,-165.53 227.53,-165.53 233.53,-165.53 239.53,-171.53 239.53,-177.53 239.53,-177.53 239.53,-189.53 239.53,-189.53 239.53,-195.53 233.53,-201.53 227.53,-201.53\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"84.64\" y=\"-184.08\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">2. Most relevant information\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"142.76\" y=\"-174.98\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">about it\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge1\" class=\"edge\">\n\u003ctitle>s1&#45;&gt;s2\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M157.76,-228.21C157.76,-222.34 157.76,-215.66 157.76,-209.32\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"159.87,-209.62 157.77,-203.62 155.67,-209.62 159.87,-209.62\"/>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>s3\u003c/title>\n\u003cpolygon fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" points=\"157.76,-138.53 34.73,-105.89 157.76,-73.25 280.79,-105.89 157.76,-138.53\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"157.76\" y=\"-107.44\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">3. Can it be\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"157.76\" y=\"-95.44\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">faithfully represented?\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>s2&#45;&gt;s3\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M157.76,-164.99C157.76,-159.28 157.76,-152.7 157.76,-146.07\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"159.87,-146.4 157.77,-140.4 155.67,-146.4 159.87,-146.4\"/>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>ok\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M109.53,-36C109.53,-36 12,-36 12,-36 6,-36 0,-30 0,-24 0,-24 0,-12 0,-12 0,-6 6,0 12,0 12,0 109.53,0 109.53,0 115.53,0 121.53,-6 121.53,-12 121.53,-12 121.53,-24 121.53,-24 121.53,-30 115.53,-36 109.53,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"45.77\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Use it\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">relevant + faithful = useful\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>s3&#45;&gt;ok\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M129.97,-80.28C116.15,-68.05 99.58,-53.37 86.12,-41.45\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"87.57,-39.93 81.69,-37.53 84.79,-43.08 87.57,-39.93\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"117.23\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> yes \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>next\u003c/title>\n\u003cpath fill=\"#ffe4e6\" stroke=\"#be123c\" stroke-width=\"1.2\" d=\"M250.53,-36C250.53,-36 159,-36 159,-36 153,-36 147,-30 147,-24 147,-24 147,-12 147,-12 147,-6 153,0 159,0 159,0 250.53,0 250.53,0 256.53,0 262.53,-6 262.53,-12 262.53,-12 262.53,-24 262.53,-24 262.53,-30 256.53,-36 250.53,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"155.64\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Next most relevant\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"167.26\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">type of information\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>s3&#45;&gt;next\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M152.08,-74.22C151.89,-65.62 153.1,-56.56 157.26,-49 158.75,-46.31 160.59,-43.83 162.67,-41.54\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"163.91,-43.26 166.82,-37.6 161.02,-40.21 163.91,-43.26\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"165.51\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> no \u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>next&#45;&gt;s3\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M195.24,-36.41C189.89,-46.18 183.03,-58.72 176.64,-70.39\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"174.92,-69.17 173.88,-75.44 178.6,-71.18 174.92,-69.17\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"212.6\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> test again \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"map","id":"map-2-enhancing","bucket":"enhancing","sect":2,"part":"Enhancing characteristics and the cost constraint"},{"type":"think","bucket":"enhancing","lo":5,"scenario":"Pulau Paints changes its depreciation method every year: straight-line, then reducing balance, then back. Its rival, Merlion Coatings, uses straight-line every year. Each set of numbers is correct on its own terms.","prompt":"What problem does an analyst have, and which characteristic is being harmed?","answer":["She can’t tell whether Pulau’s profit moved because the business changed or because the method did, and she can’t line Pulau up against Merlion.","That harms **comparability**: users must be able to **identify and understand similarities and differences** among items, across entities and over time.","**Consistency** (using the same methods each period) is how you *achieve* comparability. It is not itself a qualitative characteristic."],"id":"think-6me24f","sect":2,"part":"Enhancing characteristics and the cost constraint"},{"id":"think-13srgq","type":"think","bucket":"enhancing","lo":5,"scenario":"Two auditors, working separately, recount Pulau Paints’ {a|cash} and recalculate its FIFO {a|inventory} from the purchase records. They reach the same view: both figures are a fair depiction.","prompt":"Which characteristic does their agreement demonstrate? Is there a difference between the {a|cash} check and the {a|inventory} check?","answer":["**Verifiability**: different **knowledgeable and independent observers** could reach **consensus**, though not necessarily complete agreement, that the information is a faithful representation.","Counting {a|cash} is **direct** verification. Rechecking the inputs and the method behind FIFO is **indirect** verification."],"sect":2,"part":"Enhancing characteristics and the cost constraint"},{"id":"visual-1t9ax6","type":"visual","bucket":"enhancing","lo":5,"title":"The four enhancing characteristics (CUT V)","html":"\u003cp>Once information is relevant and faithful, four more characteristics make it \u003cstrong>more\u003c/strong> useful. Each one, what it means, and what to watch out for.\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl reveal-rows\">\u003cthead>\u003ctr>\u003cth>Enhancing QC\u003c/th>\u003cth>Meaning\u003c/th>\u003cth>Watch out\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cstrong>Comparability\u003c/strong>\u003c/td>\u003ctd>Users can \u003cstrong>identify and understand similarities and differences\u003c/strong> among items, across entities and over time\u003c/td>\u003ctd>\u003cstrong>Consistency\u003c/strong> helps achieve it but isn’t the same. Comparability ≠ uniformity\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Understandability\u003c/strong>\u003c/td>\u003ctd>Information is \u003cstrong>classified, characterised and presented clearly and concisely\u003c/strong>\u003c/td>\u003ctd>Users have \u003cstrong>reasonable business knowledge\u003c/strong> and read diligently. Complex items are \u003cstrong>not\u003c/strong> left out for being hard\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Timeliness\u003c/strong>\u003c/td>\u003ctd>Available \u003cstrong>in time\u003c/strong> to influence decisions\u003c/td>\u003ctd>Older information is less useful, but some stays useful (trends)\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Verifiability\u003c/strong>\u003c/td>\u003ctd>\u003cstrong>Different knowledgeable and independent observers could reach consensus\u003c/strong>, though not necessarily complete agreement, that it is a faithful representation\u003c/td>\u003ctd>\u003cstrong>Direct\u003c/strong> (count the \u003cspan class=\"el el-a\">cash\u003c/span>) or \u003cstrong>indirect\u003c/strong> (recheck the inputs, e.g. FIFO)\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">Practice Q1 quotes the verifiability wording word for word. Learn the phrase “knowledgeable and independent observers… consensus”.\u003c/p>","sect":2,"part":"Enhancing characteristics and the cost constraint"},{"type":"mcq","bucket":"enhancing","lo":5,"q":"A bank has complex derivative contracts. Its finance director suggests leaving them out of the notes because “most readers won’t understand them anyway”. Which response is correct?","options":[{"t":"Agree: understandability requires leaving out complex information","why":"Complex items are not left out just because they are hard. That would make the FS incomplete."},{"t":"Disagree: users are assumed to have reasonable business knowledge and to read diligently, and leaving the items out would make the information incomplete","ok":true,"why":"Understandability is about clear, concise presentation, not dropping hard things."},{"t":"Agree, as long as the amounts are immaterial by size","why":"The argument offered is about complexity, not materiality, and complexity is no reason to omit."},{"t":"Disagree: understandability is a fundamental characteristic and overrides cost","why":"Understandability is an enhancing characteristic, not fundamental."}],"id":"mcq-1jxnb3","sect":2,"part":"Enhancing characteristics and the cost constraint"},{"type":"think","bucket":"enhancing","lo":5,"scenario":"A listed company could publish its results 3 weeks after year end with lighter checking, or 10 weeks after year end with every number fully verified. Separately, a junior accountant argues that very good comparability could make up for numbers that are not relevant.","prompt":"What is the trade-off in the first case? And is the junior right?","answer":["The first is a trade-off **between enhancing characteristics**: **timeliness** against **verifiability**. The Framework allows that balance to be struck.","The junior is wrong. Enhancing characteristics **cannot** make information useful if it is **irrelevant** or **not faithfully represented**. Perfectly comparable nonsense is still nonsense."],"id":"think-1dgxyk","sect":2,"part":"Enhancing characteristics and the cost constraint"},{"type":"rule","bucket":"enhancing","lo":5,"title":"How the enhancing characteristics work","body":["Fast-but-rough versus slow-but-checked, and the junior’s argument, both test one point: how the enhancing characteristics rank against the fundamental ones.","- They make useful information **more** useful. They **cannot** rescue information that is irrelevant or not faithfully represented.","- They can be **traded off** against each other, e.g. releasing information faster (timeliness) before it can be fully checked (verifiability).","+ Enhancing = **CUT V**: **C**omparability, **U**nderstandability, **T**imeliness, **V**erifiability.","! Faithful representation is **fundamental**, not enhancing. It turns up as a distractor in enhancing-QC questions."],"id":"rule-8nzr72","sect":2,"part":"Enhancing characteristics and the cost constraint"},{"id":"tree-1vjr1d","type":"tree","bucket":"enhancing","lo":5,"title":"Which characteristic is this about?","scenario":"Two valuers, working separately, both conclude that Pulau Paints’ {a|inventory} count and pricing are a fair depiction of the {a|inventory}. Which characteristic does this describe?","expect":"verif","start":"q1","nodes":{"q1":{"q":"What is the statement about?","why":"First sort fundamental, enhancing and the constraint. Then narrow down.","opts":[{"t":"Whether the information can make a difference to decisions","to":"rel"},{"t":"Whether it shows the substance: complete, unbiased, without error","to":"fr"},{"t":"Something that makes useful information better","to":"q2"},{"t":"Whether reporting it is worth what it costs","to":"cost"}]},"q2":{"q":"Which improvement?","why":"Each enhancing characteristic has its own key words. Match them.","opts":[{"t":"Comparing across entities or over time","to":"comp"},{"t":"Independent observers could agree it is faithful","to":"verif"},{"t":"Available in time to influence decisions","to":"time"},{"t":"Classified and presented clearly and concisely","to":"under"}]},"rel":{"result":"Relevance (fundamental)","body":["Predictive value, confirmatory value, or both. **Materiality** is its entity-specific side."]},"fr":{"result":"Faithful representation (fundamental)","body":["Complete, neutral (supported by prudence), free from error. Substance over form."]},"cost":{"result":"The cost constraint","body":["Not a qualitative characteristic. Benefits must justify the costs, judged for reporting in general."]},"comp":{"result":"Comparability (enhancing)","body":["Identify and understand similarities and differences. Consistency helps achieve it."]},"verif":{"result":"Verifiability (enhancing)","body":["Different **knowledgeable and independent observers** could reach **consensus** that the information is a faithful representation.","- Direct (count it) or indirect (recheck the inputs and method)."]},"time":{"result":"Timeliness (enhancing)","body":["Available in time to influence decisions."]},"under":{"result":"Understandability (enhancing)","body":["Classified, characterised and presented clearly and concisely, for users with reasonable business knowledge."]}},"sect":2,"part":"Enhancing characteristics and the cost constraint","svg":"\u003csvg width=\"100%\" style=\"min-width:640px\" role=\"img\"\n viewBox=\"0.00 0.00 818.00 283.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"g