73,0 372.73,-6 372.73,-12 372.73,-12 372.73,-24 372.73,-24 372.73,-30 366.73,-36 360.73,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"251.68\" y=\"-19.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">ROU asset 31 Dec X1\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"290.3\" y=\"-8.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">25,591\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>dep&#45;&gt;nbv\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M269.11,-126.83C274.26,-119.51 279.86,-110.69 283.8,-102.08 292.23,-83.65 298.18,-61.48 301.91,-44.67\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"304.29,-45.26 303.35,-37.9 299.5,-44.24 304.29,-45.26\"/>\n\u003c/g>\n\n\u003cg id=\"edge7\" class=\"edge\">\n\u003ctitle>dep&#45;&gt;pl\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M241.61,-126.61C237.2,-121.18 232.23,-115.07 227.43,-109.17\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"229.6,-107.95 223.28,-104.06 225.79,-111.03 229.6,-107.95\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"subsequent","blabel":"lessee","lo":23,"title":"Both balances over the lease, step by step","html":"\u003cp>The chart above showed one year. Here are all four: Kopi Co’s \u003cspan class=\"el el-l\">lease liability\u003c/span> ($33,121, 8%, payments of $10,000 each 31 Dec) on the left, its \u003cspan class=\"el el-a\">ROU asset\u003c/span> ($34,121, straight-line over 4 years) on the right. They start close together but move at different speeds.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"lease-two-balances\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;Lease liability&quot;,&quot;sub&quot;:&quot;4 × 10,000 in arrears · 8%&quot;,&quot;el&quot;:&quot;l&quot;,&quot;bal&quot;:&quot;Lease liability&quot;,&quot;start&quot;:33121,&quot;startCap&quot;:&quot;1 Jan 20X1: the PV of the 4 payments, {l|33,121}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:2650,&quot;cap&quot;:&quot;20X1: {x|interest} = {l|opening 33,121} × 8% = {x|2,650}.&quot;},{&quot;name&quot;:&quot;payment&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-10000,&quot;cap&quot;:&quot;{a|Payment 10,000} on 31 Dec leaves {l|25,771}.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:2062,&quot;cap&quot;:&quot;20X2: {x|interest} = {l|opening 25,771} × 8% = {x|2,062}.&quot;},{&quot;name&quot;:&quot;payment&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-10000,&quot;cap&quot;:&quot;{a|Payment 10,000} on 31 Dec leaves {l|17,833}.&quot;}]},{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:1427,&quot;cap&quot;:&quot;20X3: {x|interest} = {l|opening 17,833} × 8% = {x|1,427}.&quot;},{&quot;name&quot;:&quot;payment&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-10000,&quot;cap&quot;:&quot;{a|Payment 10,000} on 31 Dec leaves {l|9,260}.&quot;}]},{&quot;label&quot;:&quot;20X4&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:740,&quot;cap&quot;:&quot;20X4: {x|interest} = {l|opening 9,260} × 8% = {x|740}.&quot;},{&quot;name&quot;:&quot;payment&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-10000,&quot;cap&quot;:&quot;{a|Payment 10,000} on 31 Dec leaves {l|0}.&quot;}]}]},{&quot;title&quot;:&quot;Right-of-use asset&quot;,&quot;sub&quot;:&quot;straight-line over 4 years&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;ROU asset&quot;,&quot;start&quot;:34121,&quot;startCap&quot;:&quot;1 Jan 20X1: {l|liability 33,121} + legal fees 1,000 = {a|34,121}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;hold&quot;:&quot;20X1 P&amp;L: {x|interest 2,650} + {x|depreciation 8,530} = {x|11,180}, against {a|cash} of 10,000.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-8530,&quot;cap&quot;:&quot;20X1: {x|depreciation} 34,121 ÷ 4 = {x|8,530}, the same every year. {a|Carrying amount} {a|25,591}.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;hold&quot;:&quot;20X2 P&amp;L: {x|interest 2,062} + {x|depreciation 8,530} = {x|10,592}, against {a|cash} of 10,000.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-8530,&quot;cap&quot;:&quot;20X2: {x|depreciation} 34,121 ÷ 4 = {x|8,530}, the same every year. {a|Carrying amount} {a|17,061}.&quot;}]},{&quot;label&quot;:&quot;20X3&quot;,&quot;hold&quot;:&quot;20X3 P&amp;L: {x|interest 1,427} + {x|depreciation 8,530} = {x|9,957}, against {a|cash} of 10,000.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-8530,&quot;cap&quot;:&quot;20X3: {x|depreciation} 34,121 ÷ 4 = {x|8,530}, the same every year. {a|Carrying amount} {a|8,531}.&quot;}]},{&quot;label&quot;:&quot;20X4&quot;,&quot;hold&quot;:&quot;20X4 P&amp;L: {x|interest 740} + {x|depreciation 8,531} = {x|9,271}, against {a|cash} of 10,000.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-8531,&quot;cap&quot;:&quot;20X4: {x|depreciation} 34,121 ÷ 4 = {x|8,531} (rounded so the asset ends at 0). {a|Carrying amount} {a|0}.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Kopi Co’s lease, paid in arrears. Two balances, rolled forward separately. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Step 1: the {l|liability} grows by {x|interest}; the {a|ROU asset} falls by {x|depreciation}. Both are expenses.&quot;,&quot;Step 2: the {a|payment} reduces only the {l|liability}. It is not an expense.&quot;],&quot;end&quot;:&quot;**Front-loaded.** The {a|asset} falls by about 8,530 every year, but the {l|liability} falls slowly at first, because early {x|interest} is high. Total P&amp;L expense by year: 11,180 → 10,592 → 9,957 → 9,271, against 10,000 of {a|cash} each year. Both balances reach zero together.&quot;}}\">\u003c/div>","id":"visual-18xvmt","sect":4,"part":"Subsequent measurement · lessee"},{"type":"map","id":"map-5-initial","bucket":"initial","blabel":"lessee · in advance","sect":5,"part":"Initial measurement · lessee · in advance"},{"id":"think-nnhkef","type":"think","bucket":"initial","blabel":"lessee · in advance","lo":23,"scenario":"Kopi Co leases a coffee roaster from RoastPro from 1 Jan 20X1: 4 annual payments of $10,000, rate implicit in the lease 8%. Paid in arrears (each 31 Dec), the day-1 {l|liability} would be $33,121. Instead RoastPro wants each payment in **advance**, on 1 January, starting on day 1.","prompt":"Is the {l|liability} bigger or smaller than before? And what happens to the first payment?","answer":["The first payment is made immediately, so it is not discounted. The PV of all four payments is bigger: $35,771.","But that first $10,000 is paid on day 1, so it is **never in the {l|liability}**. It goes straight into the {a|ROU asset} (a payment at commencement): you can’t owe money that has already left your wallet. The {l|liability} is the PV of the 3 remaining payments: **$25,771**."],"sect":5,"part":"Initial measurement · lessee · in advance"},{"type":"diagram","bucket":"initial","blabel":"lessee · in advance","lo":23,"title":"Arrears vs advance: the timeline","intro":"Same four payments of $10,000. Only the timing differs, and so does the day-1 liability.","notes":{"a0":"Arrears: the first payment is a full period away, so day 1 has no {a|cash} out.","b0":"Advance: the first payment is made on day 1. It is never in the {l|liability}; it is part of the {a|ROU asset}’s cost.","a1":"Every arrears payment is discounted: an ordinary annuity.","b1":"The three later advance payments are discounted: they make up the {l|liability}.","a4":"The last arrears payment falls on the last day of the lease.","b4":"Advance: the last payment was a year earlier, on 1 Jan X4.","aL":"10,000 × 3.3121 = {l|33,121}.","bL":"10,000 × 2.5771 = {l|25,771}. The annuity due of all 4 is 35,771; less the day-1 payment."},"walk":[{"nodes":["ha","a0","a1","a2","a3","a4"],"text":"Arrears: four payments at the end of each year. All four are unpaid on day 1."},{"nodes":["aL"],"text":"So the {l|liability} is the PV of all four: 33,121."},{"nodes":["hb","b0"],"text":"Advance: the first payment is made on day 1, so it is already paid."},{"nodes":["b1","b2","b3","b4"],"text":"Only three payments remain unpaid, and nothing is paid at the very end."},{"nodes":["bL"],"text":"So the {l|liability} is the PV of three: 25,771. The day-1 payment goes into the {a|ROU asset}."}],"id":"diagram-8mwvsp","sect":5,"part":"Initial measurement · lessee · in advance","svg":"\u003csvg width=\"100%\" style=\"min-width:399px\" role=\"img\"\n viewBox=\"0.00 0.00 363.00 382.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 367.48)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-367.48 348.12,-367.48 348.12,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>ha\u003c/title>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"36.68\" y=\"-331.63\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Arrears\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>a0\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" d=\"M94.35,-301.08C94.35,-301.08 18.75,-301.08 18.75,-301.08 12.75,-301.08 6.75,-295.08 6.75,-289.08 6.75,-289.08 6.75,-2