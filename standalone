07.1 191.27,-101.1 189.17,-107.1 193.37,-107.1\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"199.52\" y=\"-113.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> no \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>re\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" d=\"M258.78,-36C258.78,-36 123.75,-36 123.75,-36 117.75,-36 111.75,-30 111.75,-24 111.75,-24 111.75,-12 111.75,-12 111.75,-6 117.75,0 123.75,0 123.75,0 258.78,0 258.78,0 264.78,0 270.78,-6 270.78,-12 270.78,-12 270.78,-24 270.78,-24 270.78,-30 264.78,-36 258.78,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"147.02\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Optional transfer\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"120.39\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">reserve → retained earnings 1,700\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>never&#45;&gt;re\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M191.27,-62.68C191.27,-56.81 191.27,-50.13 191.27,-43.79\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"193.37,-44.09 191.27,-38.09 189.17,-44.09 193.37,-44.09\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"mcq-8m2ehi","type":"mcq","bucket":"derecognise","lo":21,"q":"A company bought 10,000 shares at $2.00 plus $300 brokerage and elected FVOCI: initial amount $20,300 (brokerage capitalised). All 10,000 are sold at $2.20, which equals their carrying amount. What is the effect on profit or loss?","options":[{"t":"A gain of $1,700","why":"That is the cumulative OCI gain. Recycling it to P&L is not allowed for equity."},{"t":"A gain of $2,000","why":"Compares with the price before brokerage, and still puts an equity FVOCI gain into P&L."},{"t":"Nil","ok":true,"why":"Sold at {a|carrying amount}, and the 1,700 cumulative gain stays in equity (it may be moved to {e|retained earnings})."},{"t":"A loss of $400","why":"That was the FVTPL partial-sale loss on 4,000 shares carried at $2.30. Here the shares are sold at their carrying amount."}],"sect":5,"part":"Derecognise / transfer"},{"type":"compare","bucket":"derecognise","preamble":"The twist versus PPE: an FVOCI **debt** gain is recycled to P&L on sale, while a PPE revaluation surplus never is.","special":"On sale, FVOCI debt gains are recycled to P&L; FVOCI equity gains never are and may only move within equity.","id":"compare-1kumyt-4","sect":5,"part":"Derecognise / transfer"},{"type":"map","id":"map-6-present","bucket":"present","sect":6,"part":"Present & disclose"},{"id":"think-1pstw6","type":"think","bucket":"present","lo":21,"scenario":"Put it together. A bond (face $100,000, coupon 5% paid each 31 Dec, effective rate 6%) is bought on 1 Jan 20X1 for $97,327. 20X1 {i|interest income} at the effective rate is $5,840, taking {a|amortised cost} to $98,167; fair value at 31 Dec 20X1 is $99,000. Measure it under each of the three categories.","prompt":"Which category reports the highest profit for 20X1? Which reports the highest total comprehensive income?","answer":["**FVTPL** reports the highest profit ($6,673): {i|coupon income} of 5,000 plus the whole {i|fair value increase} of 1,673.","FVOCI and FVTPL tie on **total comprehensive income** ($6,673). Amortised cost and FVOCI tie on **profit** ($5,840)."],"sect":6,"part":"Present & disclose"},{"type":"visual","bucket":"present","lo":21,"title":"Same bond, three categories (20X1)","html":"\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num reveal-rows\">\u003cthead>\u003ctr>\u003cth>\u003c/th>\u003cth>Amortised cost\u003c/th>\u003cth>FVOCI (debt)\u003c/th>\u003cth>FVTPL\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Investment in bonds\u003c/span>\u003c/td>\u003ctd>98,167\u003c/td>\u003ctd>99,000\u003c/td>\u003ctd>99,000\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Profit or loss\u003c/td>\u003ctd>5,840\u003c/td>\u003ctd>5,840\u003c/td>\u003ctd>6,673\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>OCI\u003c/td>\u003ctd>–\u003c/td>\u003ctd>833\u003c/td>\u003ctd>–\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Total comprehensive income\u003c/td>\u003ctd>5,840\u003c/td>\u003ctd>6,673\u003c/td>\u003ctd>6,673\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">FVTPL profit = \u003cspan class=\"el el-i\">5,000 cash\u003c/span> + \u003cspan class=\"el el-i\">(99,000 − 97,327)\u003c/span> = 6,673. Only the \u003cstrong>split between P&amp;L and OCI\u003c/strong> differs between FVOCI and FVTPL.\u003c/p>","id":"visual-6nkcwd","sect":6,"part":"Present & disclose"},{"type":"rule","bucket":"present","lo":21,"title":"Where it all shows up","body":["1. **Statement of financial position:** amortised cost assets at {a|amortised cost} (net of the {a|loss allowance}); FVOCI and FVTPL assets at fair value. The {e|Fair value reserve (OCI)} sits in equity.","2. **Profit or loss:** {i|Interest income} under the effective interest method (shown separately), {i|Dividend income}, FVTPL {i|gains} and {x|losses}, {i|gains on derecognition} (including recycled FVOCI debt gains), and {x|impairment losses}.","3. **OCI** is split into items that **may be reclassified** to P&L (FVOCI debt) and items that **will not be** (FVOCI equity).","+ Category changes the P&L/OCI split and the {a|carrying amount}, not the {a|cash}."],"id":"rule-10oyq2","sect":6,"part":"Present & disclose"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":7,"part":"Wrap-up"},{"type":"summary","lo":21,"title":"Basic financial assets on one page","rows":[["Two classification tests?","Business model + SPPI (solely payments of principal and interest)."],["Debt, SPPI, hold to collect?","Amortised cost (effective interest)."],["Debt, SPPI, collect and sell?","FVOCI; {i|interest} as amortised cost; OCI **recycled** to P&L on sale."],["Debt failing SPPI, or trading?","FVTPL."],["Shares?","FVTPL, unless the irrevocable FVOCI election (not for trading). Never recycled; {i|dividends} to P&L."],["When recognised?","When the entity becomes a party to the contract."],["Transaction costs?","Added to the {a|asset}, except FVTPL ({x|expensed})."],["{i|Interest income}?","{a|Opening carrying amount} × effective rate, not the coupon."],["{i|Gain} on selling FVTPL shares?","{a|Proceeds} − {a|last fair value} of the shares sold, to P&L."],["Impairment (ECL)?","Amortised cost and FVOCI debt only."]],"id":"summary-doc49v","bucket":"wrap","sect":7,"part":"Wrap-up"}],"quiz":{"cases":{"acorn":{"name":"Acorn","source":"Official practice paper (Q31–35 case)","text":["Acorn Pte Ltd (Acorn) specialises in carbon capture, utilisation and storage from thermal power generation. Acorn holds several equity investments, and no election was made to measure them at FVOCI. Acorn has a financial year ending 31 March.","Over the past 2 financial years, there has been the following activity in Acorn’s equity investment portfolio:","• 4 April 20X4: Acorn purchased 250,000 shares in Oak Ltd (Oak) at a cost of $1.25 per share. A brokerage fee of $2,350 was incurred on this transaction.","• Dividend income of $5,500 was received on 30 September 20X4.","• 31 March 20X5: Oak’s price per share was $1.35.","• 30 June 20X5: Acorn sold 100,000 Oak shares at a price per share of $1.20.","• Dividend income of $3,150 was received on 30 September 20X5.","• 31 March 20X6: Oak’s price per share was $1.05.","On 31 May 20X6, Acorn’s board declared a dividend of $2.75 million relating to profits for the financial year ended 31 March 20X6. Acorn’s financial statements were authorised for issue on 30 June 20X6."]},"rambutan":{"name":"Rambutan Holdings","text":["Rambutan Holdings Pte Ltd (Rambutan) has a financial year ending 31 December. On 1 January 20X1 it bought a 4-year corporate bond with a face value of $200,000, paying a fixed coupon of 4% each 31 December, with the face value repaid at maturity. There were no transaction costs.","The market rate for similar bonds on 1 January 20X1 was 6%, and Rambutan paid the fair value of $186,140. This is also the effective interest rate.","Rambutan’s treasury policy is to hold such bonds until maturity to collect the contractual cash flows. Sales happen only if an issuer’s credit rating falls sharply."]}},"questions":[{"id":"q1","case":"acorn","lo":20,"type":"purchase-je","source":"Official practice paper Q31","q":"With reference to SFRS(I) 9, Financial Instruments, identify which of the following journal entries correctly accounts for the purchase of Oak’s shares on 4 April 20X4?","options":[{"je":[{"side":"Dr","account":"Investment in Oak Ltd","amount":314850,"el":"a"},{"side":"Cr","account":"Bank","amount":314850,"el":"a"}],"pit":"tc-fvtpl-capitalised","why":"Capitalises the 2,350 brokerage. No FVOCI election was made, so the shares are at FVTPL and transaction costs are expensed."},{"je":[{"side":"Dr","account":"Investment in Oak Ltd","amount":312500,"el":"a"},{"side":"Dr","account":"Statement of profit or loss – brokerage fees","amount":2350,"el":"x"},{"side":"Cr","account":"Bank","amount":314850,"el":"a"}],"ok":true,"why":"250,000 × $1.25 = 312,500 to the {a|investment}; the {x|2,350 brokerage} is expensed (FVTPL); 314,850 paid from the {a|bank}."},{"je":[{"side":"Dr","account":"Investment in Oak Ltd","amount":312500,"el":"a"},{"side":"Dr","account":"Statement of profit or loss – brokerage fees","amount":2350,"el":"x"},{"side":"Cr","account":"Bank","amount":312500,"el":"a"},{"side":"Cr","account":"Accruals","amount":2350,"el":"l"}],"why":"Right debits, but the brokerage was incurred and paid with the purchase; nothing suggests it is still owed as an accrual."},{"je":[{"side":"Dr","account":"Bank","amount":314850,"el":"a"},{"side":"Cr","account":"Investment in Oak Ltd","amount":314850,"el":"a"}],"why":"Reversed: buying shares increases the investment and reduces the bank balance."}]},{"id":"q2","case":"acorn","lo":20,"type":"fv-movement","source":"Official practice paper Q32","q":"With reference to SFRS(I) 9, Financial Instruments, identify which of the following journal entries correctly accounts for the movement in fair value 31 March 20X5?","options":[{"je":[{"side":"Dr","account":"Investment in Oak Ltd","amount":25000,"el":"a"},{"side":"Cr","account":"Statement of profit or loss – fair value gains","amount":25000,"el":"i"}],"ok":true,"why":"250,000 × (1.35 − 1.25) = 25,000. FVTPL, so the {i|gain} goes to profit or loss."},{"je":[{"side":"Dr","account":"Investment in Oak Ltd","amount":25000,"el":"a"},{"side":"Cr","account":"Equity – other comprehensive income","amount":25000,"el":"e"}],"pit":"fvtpl-to-oci","why":"OCI would be right only if Acorn had elected FVOCI. The case says no election was made."},{"je":[{"side":"Dr","account":"SPL – administration costs","amount":25000,"el":"x"},{"side":"Cr","account":"Investment in Oak Ltd","amount":25000,"el":"a"}],"why":"The price rose, so the investment increases. Administration costs have nothing to do with it."},{"je":[{"side":"Dr","account":"Equity – other comprehensive income","amount":25000,"el":"e"},{"side":"Cr","account":"Statement of profit or loss – fair value gains","amount":25000,"el":"i"}],"why":"Moves an amount between OCI and P&L without touching the investment, which must be remeasured to fair value."}]},{"id":"q3","case":"acorn","lo":20,"type":"partial-sale","source":"Official practice paper Q33","q":"With reference to SFRS(I) 9, Financial Instruments, identify which of the following journal entries correctly accounts for the partial sale of Oak’s shares on 30 June 20X5?","options":[{"je":[{"side":"Dr","account":"Equity – other comprehensive income","amount":120000,"el":"e"},{"side":"Cr","account":"Investment in Oak Ltd","amount":120000,"el":"a"}],"why":"No cash recorded, and FVTPL shares have nothing in OCI to use."},{"je":[{"side":"Dr","account":"Cash","amount":120000,"el":"a"},{"side":"Cr","account":"Investment in Oak Ltd","amount":120000,"el":"a"}],"why":"Takes out only 120,000, but the shares sold are carried at 135,000 (100,000 × 1.35). The {x|15,000 loss} is missing."},{"je":[{"side":"Dr","account":"Cash","amount":120000,"el":"a"},{"side":"Dr","account":"Statement of profit or loss – fair value loss","amount":15000,"el":"x"},{"side":"Cr","account":"Investment in Oak Ltd","amount":135000,"el":"a"}],"ok":true,"why":"{a|Carrying amount} out = 100,000 × 1.35 = 135,000; {a|proceeds} 100,000 × 1.20 = 120,000; {x|loss} 15,000 to P&L."},{"je":[{"side":"Dr","account":"Cash","amount":120000,"el":"a"},{"side":"Dr","account":"Statement of profit or loss – fair value loss","amount":5000,"el":"x"},{"side":"Cr","account":"Investment in Oak Ltd","amount":125000,"el":"a"}],"pit":"cost-not-last-fv","why":"Uses the original $1.25 cost (125,000). The shares were remeasured to $1.35 at 31 March 20X5, so that is their {a|carrying amount}."}]},{"id":"q4","case":"acorn","lo":20,"type":"remeasure-left","source":"Official practice paper Q34","q":"With reference to SFRS(I) 9, Financial Instruments, identify which of the following amounts Acorn should recognise in its financial statements to account for the fair value of shares on 31 March 20X6?","options":[{"t":"A loss of $75,000 should be recognised in the Statement of profit or loss","pit":"all-shares","why":"Uses all 250,000 shares. Only 150,000 are still held after the June sale."},{"t":"A loss of $22,500 should be recognised in the Statement of financial position","why":"Wrong amount (it measures from the $1.20 sale price) and a loss is not “recognised in” the statement of financial position; it goes to profit or loss."},{"t":"A loss of $45,000 should be recognised in the Statement of profit or loss","ok":true,"why":"150,000 × (1.35 − 1.05) = 45,000, from the last fair value, to profit or loss (FVTPL)."},{"t":"A loss of $22,500 should be recognised in Equity – other comprehensive income","pit":"fvtpl-to-oci","why":"Wrong amount, and OCI is only for an FVOCI election, which Acorn did not make."}]},{"id":"q5","case":"acorn","lo":21,"type":"fs-effects","q":"At what amount should the investment in Oak be carried in Acorn’s statement of financial position at 31 March 20X6?","options":[{"t":"$187,500","pit":"cost-not-last-fv","why":"150,000 × $1.25 cost. FVTPL shares are carried at fair value."},{"t":"$202,500","why":"Last year’s price of $1.35. The shares must be remeasured at 31 March 20X6."},{"t":"$157,500","ok":true,"why":"150,000 × $1.05 = 157,500, the fair value at the reporting date."},{"t":"$262,500","pit":"all-shares","why":"Includes the 100,000 shares sold in June 20X5."}]},{"id":"q6","case":"rambutan","lo":20,"type":"classify-bm","q":"How should Rambutan measure the bond after initial recognition?","options":[{"t":"Amortised cost","ok":true,"why":"Fixed coupon plus principal passes SPPI, and the model is hold to collect. Rare sales after a downgrade do not change that."},{"t":"Fair value through other comprehensive income","pit":"bm-collect-sell","why":"FVOCI needs a collect-and-sell model. Rambutan only sells on a sharp credit downgrade."},{"t":"Fair value through profit or loss","why":"The bond passes SPPI and is not held for trading."},{"t":"Historical cost, with the coupon as income","pit":"historical-cost","why":"Not an SFRS(I) 9 category, and income uses the effective rate, not the coupon."}]},{"id":"q7","case":"rambutan","lo":21,"type":"eir-interest","q":"What interest income should Rambutan recognise for 20X1?","options":[{"t":"$8,000","pit":"coupon-not-effective","why":"That is the {a|cash} coupon. {i|Income} is the effective rate on the {a|carrying amount}."},{"t":"$12,000","pit":"coupon-not-effective","why":"6% × face value. The effective rate applies to the {a|carrying amount} (186,140), not the face value."},{"t":"$11,168","ok":true,"why":"186,140 × 6% = 11,168."},{"t":"$13,860","why":"That is the whole discount, which is spread over the 4 years through the effective interest method."}]},{"id":"q8","case":"rambutan","lo":21,"type":"eir-interest","q":"Which journal entry records the interest on 31 December 20X1?","options":[{"je":[{"side":"Dr","account":"Cash","amount":8000,"el":"a"},{"side":"Cr","account":"Interest income","amount":8000,"el":"i"}],"pit":"coupon-not-effective","why":"Treats the coupon as the whole income. The discount must be unwound too."},{"je":[{"side":"Dr","account":"Cash","amount":8000,"el":"a"},{"side":"Dr","account":"Investment in bonds","amount":3168,"el":"a"},{"side":"Cr","account":"Interest income","amount":11168,"el":"i"}],"ok":true,"why":"{i|Income} 11,168; {a|cash} 8,000; the 3,168 difference is added to the {a|bond}."},{"je":[{"side":"Dr","account":"Cash","amount":8000,"el":"a"},{"side":"Cr","account":"Investment in bonds","amount":3168,"el":"a"},{"side":"Cr","account":"Interest income","amount":4832,"el":"i"}],"why":"Premium-bond logic. This bond was bought at a discount, so it grows towards face value."},{"je":[{"side":"Dr","account":"Cash","amount":8000,"el":"a"},{"side":"Dr","account":"Investment in bonds","amount":3168,"el":"a"},{"side":"Cr","account":"Fair value reserve (OCI)","amount":11168,"el":"e"}],"pit":"fvtpl-to-oci","why":"{i|Interest income} always goes to profit or loss, and amortised cost has no OCI."}]},{"id":"q9","case":"rambutan","lo":21,"type":"eir-interest","q":"What is the carrying amount of the bond at 31 December 20X2?","options":[{"t":"$189,308","why":"That is the 31 December 20X1 {a|balance}. Another year of discount unwinds in 20X2."},{"t":"$192,666","ok":true,"why":"{a|Opening 189,308} + 11,358 {i|interest} − 8,000 {a|cash} = {a|closing 192,666}."},{"t":"$200,000","why":"The bond only reaches face value at maturity in 20X4."},{"t":"$186,140","pit":"historical-cost","why":"Leaves the bond at its original cost. Under amortised cost the discount unwinds each year."}]},{"id":"q10","case":"rambutan","lo":21,"type":"fs-effects","q":"Rambutan’s 20X1 fair value for the bond turns out to be well above its amortised cost. What is the effect on its 20X1 financial statements?","options":[{"t":"A fair value gain in profit or loss","pit":"fvtpl-to-oci","why":"That would be FVTPL. Amortised cost ignores fair value changes."},{"t":"A fair value gain in OCI","why":"That would be FVOCI. Rambutan’s model is hold to collect."},{"t":"No effect on the measurement; fair value may be disclosed in the notes","ok":true,"why":"Under amortised cost the {a|carrying amount} follows the effective interest schedule, whatever the market price."},{"t":"The effective interest rate is reset to the new market rate","why":"The effective rate is fixed at initial recognition for a fixed-rate bond."}]},{"id":"q11","lo":20,"type":"classify-bm","source":"Official practice paper Q4","q":"A company holds debt securities to collect contractual cash flows but is also willing to sell should the right opportunity occur. With reference to SFRS(I) 9, Financial Instruments, identify how these debt securities should be measured?","options":[{"t":"Historical cost","pit":"historical-cost","why":"Not an SFRS(I) 9 measurement category for financial assets."},{"t":"Amortised cost","pit":"bm-collect-sell","why":"Amortised cost is for a hold-to-collect model only. Being willing to sell makes it collect and sell."},{"t":"Fair value through profit or loss (FVTPL)","why":"FVTPL is for debt that fails SPPI or sits in a trading or other model. These securities are held to collect as well."},{"t":"Fair value through other comprehensive income (FVOCI)","ok":true,"why":"Held to collect contractual cash flows **and** to sell: the “hold to collect and sell” model, so FVOCI."}]},{"id":"q12","lo":20,"type":"classify-bm","q":"An entity buys ordinary shares in a listed company and makes no election. How are the shares measured after initial recognition?","options":[{"t":"Amortised cost","pit":"shares-at-ac","why":"Shares fail SPPI: there is no principal or interest to amortise."},{"t":"FVOCI, because they are not held for trading","why":"FVOCI for equity requires an **election** at initial recognition; without it, the default applies."},{"t":"FVTPL","ok":true,"why":"The default for equity instruments is fair value through profit or loss."},{"t":"Cost less impairment","why":"Not an SFRS(I) 9 category for shares."}]},{"id":"q13","lo":20,"type":"purchase-je","q":"A company buys 20,000 shares at $3.00 each, paying brokerage of $450. It irrevocably elects FVOCI for this strategic holding. At what amount are the shares initially recognised?","options":[{"t":"$60,000","pit":"tc-expensed-ac","why":"Expenses the brokerage, which is correct only for FVTPL."},{"t":"$60,450","ok":true,"why":"Fair value 60,000 + transaction costs 450."},{"t":"$59,550","why":"Transaction costs are never deducted from the asset."},{"t":"$60,000, with $450 debited to OCI","why":"Transaction costs are not an OCI item; they form part of the initial amount."}]},{"id":"q14","lo":21,"type":"fv-movement","q":"An entity holds 5,000 shares at FVTPL, carried at $8.00 each. At year end the price is $7.40. Which entry is correct?","options":[{"je":[{"side":"Dr","account":"Fair value reserve (OCI)","amount":3000,"el":"e"},{"side":"Cr","account":"Investment in shares","amount":3000,"el":"a"}],"pit":"fvtpl-to-oci","why":"OCI is only for FVOCI. FVTPL changes go to profit or loss."},{"je":[{"side":"Dr","account":"Fair value loss (P&L)","amount":3000,"el":"x"},{"side":"Cr","account":"Investment in shares","amount":3000,"el":"a"}],"ok":true,"why":"5,000 × (8.00 − 7.40) = 3,000, to P&L."},{"je":[{"side":"Dr","account":"Investment in shares","amount":3000,"el":"a"},{"side":"Cr","account":"Fair value gain (P&L)","amount":3000,"el":"i"}],"why":"The price fell, so this is a loss, not a gain."},{"t":"No entry until the shares are sold","why":"FVTPL assets are remeasured at every reporting date."}]},{"id":"q15","lo":21,"type":"recycling","q":"An entity sells two investments it held at FVOCI: a corporate bond (debt) and shares under the irrevocable equity election. Both have gains in the fair value reserve. What happens to those gains?","options":[{"t":"Both are reclassified to profit or loss","pit":"recycle-equity","why":"Only the debt gain is recycled. Equity FVOCI gains never pass through P&L."},{"t":"The bond gain is reclassified to profit or loss; the share gain stays in equity and may be moved to retained earnings","ok":true,"why":"Debt FVOCI recycles; equity FVOCI does not."},{"t":"The share gain is reclassified to profit or loss; the bond gain stays in equity","why":"It is the other way round."},{"t":"Both stay in the fair value reserve permanently","pit":"no-recycle-debt","why":"The bond’s {e|OCI balance} must be recycled when it is derecognised."}]},{"id":"q16","lo":21,"type":"fs-effects","q":"An entity holds a bond at FVOCI. Compared with holding the same bond at amortised cost, which statement is correct?","options":[{"t":"Interest income is lower, because fair value changes absorb part of it","pit":"fvoci-interest","why":"{i|Interest income} is calculated exactly as under amortised cost."},{"t":"Profit is the same; the carrying amount and OCI differ","ok":true,"why":"FVOCI debt puts the same {i|effective interest} (and {x|ECL}) in P&L, carries the bond at fair value and holds the difference in OCI."},{"t":"Profit includes all fair value changes","pit":"fvtpl-to-oci","why":"That is FVTPL."},{"t":"No impairment (expected credit loss) is recognised","why":"ECL applies to FVOCI debt as well as amortised cost."}]},{"id":"q17","lo":21,"type":"fs-effects","q":"Which financial assets are subject to the expected credit loss (impairment) requirements?","options":[{"t":"All financial assets","why":"FVTPL assets and equity instruments are excluded: fair value already captures the losses."},{"t":"Debt at amortised cost and debt at FVOCI","ok":true,"why":"ECL applies to debt measured at amortised cost or FVOCI (and {a|trade receivables})."},{"t":"Equity instruments at FVOCI only","why":"Equity instruments have no impairment test under SFRS(I) 9."},{"t":"FVTPL assets only","why":"FVTPL assets are already at fair value; they are outside the ECL model."}]}]},"exam":{"cases":{"banyan":{"name":"Banyan Treasury","text":["Banyan Treasury Pte Ltd (Banyan) has a financial year ending 31 December. On 1 January 20X1 it bought a 3-year government bond with a face value of $500,000 and a fixed coupon of 4%, paid each 31 December. It paid $486,384, the fair value, which gives an effective interest rate of 5%. There were no transaction costs.","Banyan holds its bond portfolio to collect the coupons, but regularly sells bonds to meet liquidity needs and when prices are attractive.","At 31 December 20X1 the bond’s fair value was $495,000. On 31 December 20X2, immediately after receiving the coupon, Banyan sold the bond for $497,000 cash."]},"cempaka":{"name":"Cempaka Holdings","text":["Cempaka Holdings Pte Ltd (Cempaka) has a financial year ending 31 December. On 1 March 20X1 it bought 50,000 shares in a listed supplier at $4.00 each and paid brokerage of $1,000. The stake is a long-term strategic holding, and Cempaka irrevocably elected to present fair value changes in OCI.","On 30 September 20X1 Cempaka received a dividend of $6,000. At 31 December 20X1 the share price was $4.30.","On 30 June 20X2 Cempaka sold all the shares at $4.50 each, with no selling costs. Its policy is to transfer cumulative gains on such shares to retained earnings when they are sold."]}},"questions":[{"id":"x1","case":"banyan","lo":20,"type":"classify-bm","q":"How should Banyan classify the bond?","options":[{"t":"Amortised cost","pit":"bm-collect-sell","why":"Regular sales for liquidity and price make this collect and sell, not hold to collect."},{"t":"FVOCI (debt), with gains recycled on sale","ok":true,"why":"Fixed coupon and principal pass SPPI; the model is hold to collect and sell."},{"t":"FVTPL, because Banyan sells bonds","why":"Selling is part of the collect-and-sell model. FVTPL is for trading or other models, or SPPI failures."},{"t":"FVOCI (equity election), with no recycling","pit":"recycle-equity","why":"The equity election is only for shares. A bond is a debt instrument."}]},{"id":"x2","case":"banyan","lo":21,"type":"eir-interest","q":"What interest income should Banyan recognise in profit or loss for 20X1?","options":[{"t":"$20,000","pit":"coupon-not-effective","why":"The {a|cash} coupon. {i|Interest income} uses the effective rate."},{"t":"$24,319","ok":true,"why":"486,384 × 5% = 24,319, exactly as under amortised cost."},{"t":"$25,000","pit":"coupon-not-effective","why":"Applies the effective rate to face value instead of the {a|carrying amount}."},{"t":"$28,616","pit":"fvoci-interest","why":"Adds the fair value gain. Under FVOCI that goes to OCI, not {i|interest income}."}]},{"id":"x3","case":"banyan","lo":21,"type":"fv-movement","q":"What amount should Banyan recognise in other comprehensive income for 20X1?","options":[{"t":"$4,297 gain","ok":true,"why":"{a|Amortised cost} = {a|486,384} + {i|24,319} − {a|20,000} = {a|490,703}. OCI = {a|495,000} − {a|490,703} = 4,297."},{"t":"$8,616 gain","pit":"oci-vs-cost","why":"Compares fair value with the purchase price. Part of that increase is the discount unwinding, already in {i|interest income}."},{"t":"$5,000 loss","why":"Compares fair value with face value, which is irrelevant until maturity."},{"t":"Nil; the gain goes to profit or loss","pit":"fvtpl-to-oci","why":"That is FVTPL. Under FVOCI debt, the fair value gain above amortised cost goes to OCI."}]},{"id":"x4","case":"banyan","lo":21,"type":"fv-movement","q":"Which journal entry records the coupon, interest and remeasurement at 31 December 20X1?","options":[{"je":[{"side":"Dr","account":"Cash","amount":20000,"el":"a"},{"side":"Dr","account":"Investment in bonds","amount":8616,"el":"a"},{"side":"Cr","account":"Interest income","amount":24319,"el":"i"},{"side":"Cr","account":"Fair value reserve (OCI)","amount":4297,"el":"e"}],"ok":true,"why":"{i|Interest} 24,319 to P&L; the {a|bond} rises 8,616 to fair value 495,000; the 4,297 above {a|amortised cost} goes to OCI."},{"je":[{"side":"Dr","account":"Cash","amount":20000,"el":"a"},{"side":"Dr","account":"Investment in bonds","amount":8616,"el":"a"},{"side":"Cr","account":"Interest income","amount":20000,"el":"i"},{"side":"Cr","account":"Fair value reserve (OCI)","amount":8616,"el":"e"}],"pit":"coupon-not-effective","why":"Treats the coupon as the {i|income} and pushes the discount unwinding into OCI."},{"je":[{"side":"Dr","account":"Cash","amount":20000,"el":"a"},{"side":"Dr","account":"Investment in bonds","amount":8616,"el":"a"},{"side":"Cr","account":"Interest income","amount":24319,"el":"i"},{"side":"Cr","account":"Fair value gain (P&L)","amount":4297,"el":"i"}],"why":"FVTPL treatment of the remeasurement. Under FVOCI it goes to OCI."},{"je":[{"side":"Dr","account":"Cash","amount":20000,"el":"a"},{"side":"Dr","account":"Investment in bonds","amount":4319,"el":"a"},{"side":"Cr","account":"Interest income","amount":24319,"el":"i"}],"why":"Amortised cost only. The bond must also be remeasured to fair value."}]},{"id":"x5","case":"banyan","lo":21,"type":"recycling","q":"What gain on disposal should Banyan recognise in profit or loss when it sells the bond on 31 December 20X2?","options":[{"t":"$1,762","ok":true,"why":"{a|Amortised cost} at 31 Dec 20X2 = {a|490,703} + {i|24,535} − {a|20,000} = {a|495,238}. The bond is first remeasured to 497,000 (an OCI loss of 2,535), then the cumulative 1,762 in the {e|reserve} is recycled. Check: 497,000 − 495,238 = 1,762."},{"t":"$2,000","why":"Compares {a|proceeds} with last year’s fair value. The {a|carrying amount} also moved by the 20X2 discount unwinding, and the {e|reserve} must be recycled."},{"t":"$4,297","why":"Recycles only the 20X1 {e|OCI balance} and ignores the 20X2 OCI movement."},{"t":"Nil; the reserve stays in equity","pit":"no-recycle-debt","why":"That is the equity rule. FVOCI debt is recycled on derecognition."}]},{"id":"x6","case":"cempaka","lo":20,"type":"purchase-je","q":"Which journal entry records the purchase on 1 March 20X1?","options":[{"je":[{"side":"Dr","account":"Investment in shares","amount":200000,"el":"a"},{"side":"Dr","account":"Transaction costs expense","amount":1000,"el":"x"},{"side":"Cr","account":"Cash","amount":201000,"el":"a"}],"pit":"tc-expensed-ac","why":"Expensing the brokerage is the FVTPL rule. Under the FVOCI election it is capitalised."},{"je":[{"side":"Dr","account":"Investment in shares","amount":201000,"el":"a"},{"side":"Cr","account":"Cash","amount":201000,"el":"a"}],"ok":true,"why":"Fair value 200,000 + brokerage 1,000 = 201,000."},{"je":[{"side":"Dr","account":"Investment in shares","amount":200000,"el":"a"},{"side":"Dr","account":"Fair value reserve (OCI)","amount":1000,"el":"e"},{"side":"Cr","account":"Cash","amount":201000,"el":"a"}],"why":"Transaction costs are part of the {a|asset}, not an OCI item."},{"je":[{"side":"Dr","account":"Investment in shares","amount":200000,"el":"a"},{"side":"Cr","account":"Cash","amount":200000,"el":"a"}],"why":"Ignores the brokerage, which was paid in cash."}]},{"id":"x7","case":"cempaka","lo":21,"type":"fv-movement","q":"Which entry records the remeasurement at 31 December 20X1?","options":[{"je":[{"side":"Dr","account":"Investment in shares","amount":14000,"el":"a"},{"side":"Cr","account":"Fair value gain (P&L)","amount":14000,"el":"i"}],"pit":"fvoci-to-pl","why":"Under the equity election, fair value changes go to OCI, not P&L."},{"je":[{"side":"Dr","account":"Investment in shares","amount":15000,"el":"a"},{"side":"Cr","account":"Fair value reserve (OCI)","amount":15000,"el":"e"}],"pit":"tc-expensed-ac","why":"Measures from the 200,000 price before brokerage. The {a|carrying amount} is 201,000."},{"je":[{"side":"Dr","account":"Investment in shares","amount":14000,"el":"a"},{"side":"Cr","account":"Fair value reserve (OCI)","amount":14000,"el":"e"}],"ok":true,"why":"50,000 × 4.30 = 215,000; less {a|carrying amount} 201,000 = 14,000 to OCI."},{"t":"No entry: elected FVOCI shares are carried at cost","why":"FVOCI shares are remeasured to fair value at each reporting date; only the destination of the gain changes."}]},{"id":"x8","case":"cempaka","lo":21,"type":"fs-effects","q":"How should Cempaka recognise the $6,000 dividend received on 30 September 20X1?","options":[{"t":"Dividend income in profit or loss","ok":true,"why":"{i|Dividends} on FVOCI equity go to P&L unless they clearly represent a recovery of the investment’s cost."},{"t":"In OCI, consistent with the election","pit":"dividend-to-oci","why":"The election covers fair value changes only. Dividends still go to P&L."},{"t":"As a reduction of the investment’s carrying amount","why":"Only a dividend that is clearly a return of cost would do that. A normal dividend is income."},{"t":"Directly in retained earnings","why":"A dividend received is {i|income} of the investor, recognised in P&L."}]},{"id":"x9","case":"cempaka","lo":21,"type":"recycling","q":"What is the effect of the 30 June 20X2 sale on Cempaka’s profit or loss for 20X2?","options":[{"t":"A gain of $24,000","pit":"recycle-equity","why":"That is the cumulative OCI gain. Equity FVOCI gains are never recycled."},{"t":"A gain of $10,000","pit":"fvoci-to-pl","why":"The 20X2 increase to the sale price goes to OCI, not P&L."},{"t":"A gain of $25,000","pit":"recycle-equity","why":"Proceeds less the price before brokerage, and still puts an equity FVOCI gain in P&L."},{"t":"Nil","ok":true,"why":"The shares are remeasured to 225,000 through OCI (10,000) and derecognised at that amount. Nothing passes through profit or loss."}]},{"id":"x10","case":"cempaka","lo":21,"type":"recycling","q":"Which entry applies Cempaka’s policy for the fair value reserve after the sale?","options":[{"je":[{"side":"Dr","account":"Fair value reserve (OCI)","amount":24000,"el":"e"},{"side":"Cr","account":"Gain on disposal (P&L)","amount":24000,"el":"i"}],"pit":"recycle-equity","why":"Recycling to P&L is prohibited for equity FVOCI."},{"je":[{"side":"Dr","account":"Fair value reserve (OCI)","amount":24000,"el":"e"},{"side":"Cr","account":"Retained earnings","amount":24000,"el":"e"}],"ok":true,"why":"The cumulative gain 14,000 + 10,000 = 24,000 is transferred within equity."},{"je":[{"side":"Dr","account":"Fair value reserve (OCI)","amount":10000,"el":"e"},{"side":"Cr","account":"Retained earnings","amount":10000,"el":"e"}],"why":"Transfers only the 20X2 movement. The reserve holds 24,000 in total."},{"je":[{"side":"Dr","account":"Retained earnings","amount":24000,"el":"e"},{"side":"Cr","account":"Fair value reserve (OCI)","amount":24000,"el":"e"}],"why":"Reversed: the {e|reserve} is a credit balance, so it is debited to clear it."}]},{"id":"x11","lo":21,"type":"eir-interest","q":"On 1 January 20X1 an entity buys a 5-year bond, face value $300,000, coupon 6% paid each 31 December, for $276,044. The effective interest rate is 8%. The bond is held at amortised cost. What interest income is recognised for 20X2?","options":[{"t":"$22,084","why":"That is 20X1 income. In 20X2 the {a|carrying amount} is higher because the discount has started to unwind."},{"t":"$22,410","ok":true,"why":"{a|20X1 closing} = {a|276,044} + {i|22,084} − {a|18,000} = {a|280,128}; × 8% = 22,410."},{"t":"$18,000","pit":"coupon-not-effective","why":"The {a|cash} coupon, not the {i|income}."},{"t":"$24,000","pit":"coupon-not-effective","why":"Effective rate × face value. Use the {a|carrying amount}."}]},{"id":"x12","lo":21,"type":"eir-interest","q":"An entity buys a 4-year bond (face $100,000, coupon 6%) for $95,113 and pays transaction costs of $1,500. It is held at amortised cost. The effective interest rate, taking the transaction costs into account, is 7%. What interest income is recognised in year 1?","options":[{"t":"$6,658","pit":"tc-expensed-ac","why":"Applies the rate to the price only. The transaction costs are part of the {a|initial carrying amount}."},{"t":"$6,763","ok":true,"why":"{a|Initial amount} = 95,113 + 1,500 = 96,613; × 7% = 6,763."},{"t":"$6,000","pit":"coupon-not-effective","why":"The {a|cash} coupon, not the {i|income}."},{"t":"$5,263","pit":"tc-expensed-ac","why":"Nets the transaction costs off {i|income} in year 1. At amortised cost they are spread through the effective rate, not expensed."}]},{"id":"x13","lo":21,"type":"partial-sale","q":"An entity buys 40,000 shares at FVTPL on 1 March 20X1 at $3.00, paying brokerage of $600. The price is $3.25 at 31 December 20X1. On 15 April 20X2 it sells 10,000 shares at $3.40. The price is $3.10 at 31 December 20X2. What is the net effect of the shares on 20X2 profit or loss (ignore dividends)?","options":[{"t":"A net loss of $3,000","ok":true,"why":"{i|Sale gain} 10,000 × (3.40 − 3.25) = 1,500; {x|remeasurement loss} 30,000 × (3.25 − 3.10) = 4,500; {x|net loss} 3,000."},{"t":"A net loss of $4,500","why":"Ignores the gain on the shares sold in April."},{"t":"A net loss of $500","pit":"cost-not-last-fv","why":"Measures the sale gain from the $3.00 cost. The 20X1 gain was already recognised, so use $3.25."},{"t":"A gain of $1,500 in P&L and a loss of $4,500 in OCI","pit":"fvtpl-to-oci","why":"Every FVTPL change goes to profit or loss."}]},{"id":"x14","lo":21,"type":"fs-effects","q":"On 1 January 20X1 an entity buys a bond at its face value of $400,000 (coupon 5%, equal to the effective rate). At 31 December 20X1 its fair value is $390,000. Ignore expected credit losses. Which statement about 20X1 is correct?","options":[{"t":"Under FVOCI and FVTPL alike, profit is $10,000","pit":"fvoci-interest","why":"FVOCI profit is the 20,000 {i|interest}; the 10,000 fall goes to OCI."},{"t":"Under FVOCI profit is $20,000 with an OCI loss of $10,000; under FVTPL profit is $10,000","ok":true,"why":"FVOCI keeps amortised cost profit and puts the fair value fall in OCI; FVTPL puts it in profit. Total comprehensive income is the same."},{"t":"Under amortised cost the bond is carried at $390,000","why":"Amortised cost ignores fair value: the bond stays at 400,000."},{"t":"All three categories give total comprehensive income of $20,000","why":"Only amortised cost does. FVOCI and FVTPL both give 10,000."}]},{"id":"x15","lo":20,"type":"classify-bm","q":"An entity holds a portfolio of fixed-rate bonds in a hold-to-collect model. A related liability is measured at FVTPL, so amortised cost for the bonds would create an accounting mismatch. Which statement is correct?","options":[{"t":"The bonds must be at amortised cost; the business model decides","why":"The fair value option exists for exactly this case."},{"t":"At initial recognition the entity may irrevocably designate the bonds at FVTPL","ok":true,"why":"The fair value option is allowed when it eliminates or significantly reduces an accounting mismatch, and only on day one."},{"t":"The entity may elect FVOCI with no recycling","pit":"recycle-equity","why":"The no-recycling election is for equity instruments only."},{"t":"The entity may switch the bonds to FVTPL whenever the mismatch arises","why":"The designation is made only at initial recognition and is irrevocable."}]}]},"prepared":true},{"id":"leases","title":"Leases","subtitle":"SFRS(I) 16 · lessee and lessor","code":"B2.1","los":{"22":"Use of leases and the fundamentals of lease accounting","23":"Lessee and lessor accounting","24":"Sale and leaseback","25":"Presentation and disclosure"},"accounts":[{"name":"Right-of-use asset","el":"a"},{"name":"Lease liability","el":"l"},{"name":"Cash","el":"a"},{"name":"Prepaid lease payments","el":"a"},{"name":"Interest expense","el":"x"},{"name":"Depreciation expense","el":"x"},{"name":"Lease expense","el":"x"},{"name":"Legal fees expense","el":"x"},{"name":"Accumulated depreciation: ROU asset","el":"a"},{"name":"Accruals","el":"l"},{"name":"Provision for restoration","el":"l"},{"name":"Lease receivable","el":"a"},{"name":"Equipment","el":"a"},{"name":"Finance income","el":"i"},{"name":"Lease income","el":"i"},{"name":"Retained earnings","el":"e"}],"map":{"classify":{"label":"Is it a lease? Lessor: finance or operating","star":"Three tests decide if it is a lease; only the lessor then classifies finance vs operating"},"recognise":{"label":"Lessee: on balance sheet unless short-term or low-value"},"initial":{"label":"{l|Liability} = PV of payments; {a|ROU} built from it","star":"{a|ROU asset} = {l|liability} + day-1 payments + direct costs + restoration − incentives"},"subsequent":{"label":"{x|Interest} + {x|depreciation}; lessor {i|finance income}"},"derecognise":{"label":"Sale and leaseback: {i|gain} on rights transferred"},"present":{"label":"Principal → financing; maturity analyses"}},"preamble":["Welcome to leases: the chapter where you get to be both the tenant and the landlord. We follow one coffee roaster, leased by Kopi Co (the **lessee**, who uses it) from RoastPro (the **lessor**, who owns it), and account for it from both chairs.","1. **Lessee first:** is it a lease at all? Then put it on the balance sheet (unless short-term or low-value), measure the {l|Lease liability} and {a|Right-of-use asset} on day 1, and roll them forward with {x|interest} and {x|depreciation}. Then a quick rewind for payments in advance.","2. **Then swap chairs to the lessor:** classify each lease as finance or operating, and account for each.","3. **Last:** the sale-and-leaseback party trick, then where leases show up in the statements.","★ What is special: the lessee’s asset is a **right to use**, not the thing itself, and its cost is **built from a {l|liability}** (the PV of the payments). And the two sides don’t mirror: the lessee has one model, the lessor still has two. A lot of this will feel like PPE and a bank loan wearing one trench coat. That’s exactly the right instinct."],"intros":{"classify|is it a lease?":"Start line. Before we touch a single number, we ask the bouncer’s question: is this contract really a lease, or a service in disguise? Three tests decide it: an identified asset, substantially all the benefits, and the right to direct its use. ★ Special: other assets open with “why is it held?”; leases open with “is there a lease at all?”.","recognise|lessee":"It passed the three tests, so it’s a lease. Now we sit in the tenant’s chair and ask: does it go on the lessee’s balance sheet? Default answer: yes, every single one. The only escape hatches are two optional exemptions, short-term and low-value, and both have fine print that examiners love.","initial|lessee":"We know it goes on the balance sheet; time to put numbers on it. Day 1 is two moves: measure the {l|Lease liability} at the PV of the unpaid payments, then build the {a|Right-of-use asset} from it. Adding legal fees and restoration costs is vanilla PPE thinking: capitalise what it took to get the thing working. ★ Special: the {a|asset}’s cost starts from a {l|liability}, not from an invoice.","subsequent|lessee":"Day 1 is booked. Now we fast-forward a year and watch the two balances go their separate ways. The {l|liability} behaves like a loan ({x|interest} up, payments down); the {a|ROU asset} behaves like plain PPE, straight-line {x|depreciation} with nothing exotic. The only twists: depreciate over the shorter of lease term and useful life, and {x|interest} plus {x|depreciation} makes the {x|expense} front-loaded.","initial|lessee · in advance":"Quick rewind to day 1 for the exam’s favourite plot twist: same lease, but the cash goes out at the *start* of each year. Everything you just learned still holds; only the timing moves. ★ Watch the first payment: it’s paid on day 1, so it never enters the {l|liability} and lands straight in the {a|ROU asset}.","classify|lessor":"We’ve been the tenant so far; time to switch chairs and sit with the landlord, RoastPro. The lease test still applies, but now there’s a second question the lessee never asks. ★ Special: only the lessor classifies, finance or operating, by asking who really carries the risks and rewards.","initial|lessor":"Classification done; now day 1 from the landlord’s side. An operating lease is the quiet one: the {a|equipment} stays on the books and nothing new is recorded. A finance lease is where the action is: the {a|equipment} walks out and a {a|Lease receivable} walks in at the net investment. Don’t forget the unguaranteed residual, which sneaks into that number too.","subsequent|lessor":"The {a|receivable} is on the books; now let it earn its keep. Finance lease: the lessee’s schedule seen in a mirror, with {i|Finance income} at a constant rate on the {a|receivable}. Operating lease: straight-line {i|Lease income} plus {x|depreciation}, plain rental accounting, even when year 1 is rent-free.","derecognise|sale & leaseback":"Both sides of an ordinary lease are done. Now the party trick: sell your own asset and lease it straight back. Step one is the gatekeeper: is it really a sale under SFRS(I) 15? If yes, book the {i|gain} only on the slice you actually gave up; if no, it was a loan ({l|financial liability}) all along.","present":"Last stop. We’ve classified, measured and rolled everything forward; now we see where it all lands. Mostly routine: {a|ROU asset} and {l|liability} on the balance sheet, {x|interest} and {x|depreciation} in P&L, and the one that trips people up, principal repayments under **financing** in the cash flow statement."},"pitfalls":{"undiscounted":"Using the undiscounted payments instead of their present value.","idc-expensed":"Expensing initial direct costs (such as legal fees) instead of adding them to the {a|ROU asset}.","expensed-rent":"Expensing a lease as {x|rent} when no exemption applies. It belongs on the balance sheet.","interest-account":"Crediting lease {x|interest} to {l|accruals} or the {a|ROU asset} instead of the {l|lease liability}.","full-year":"Taking a full year of {x|interest} or {x|depreciation} for a lease that started part-way through the year.","advance-first-payment":"With payments in advance, leaving the day-1 payment in the {l|lease liability}.","dep-period":"Depreciating over the wrong period: useful life only if ownership passes or a purchase option is reasonably certain, otherwise the shorter of lease term and useful life.","current-split":"Splitting the {l|liability} wrongly: the current part is what the next 12 months’ payments repay of {l|today’s balance}, not counting {x|interest} that has not accrued yet.","variable-sales":"Putting sales- or usage-linked payments into the {l|lease liability}.","short-term-option":"Calling a lease with a purchase option short-term.","low-value-size":"Judging low-value on the lessee’s size or a batch total, not on each asset’s value when new.","substitution":"Missing a substantive substitution right, and so calling a service contract a lease.","lessee-lessor-mixup":"Mixing up the models: only the lessor classifies finance vs operating; the lessee always recognises an {a|ROU asset} and a {l|lease liability}.","residual-omitted":"Leaving the unguaranteed residual out of the lessor’s net investment.","straight-line-finance":"Spreading {i|finance income} straight-line instead of at a constant rate on the {a|receivable}.","lessor-keeps-asset":"Under a finance lease, the lessor keeping and depreciating the asset, or booking receipts as {i|lease income}.","full-gain":"Recognising the whole {i|gain} on a sale and leaseback instead of only the part for rights transferred.","principal-operating":"Putting the principal part of lease payments in operating cash flows. It is financing."},"examTypes":[{"id":"is-lease","title":"Does this contract contain a lease?","pitfall":"Missing a substitution right, or thinking the supplier operating the asset rules out a lease","see":"classify"},{"id":"exemption","title":"Can the lessee use the short-term or low-value exemption?","pitfall":"Calling a 12-month lease with a purchase option short-term","see":"recognise"},{"id":"initial","title":"Which entry records initial recognition of the lease? (practice Q17)","pitfall":"Using the undiscounted payments, or expensing the legal fees","see":"initial"},{"id":"advance","title":"Payments are in advance: what is the lease liability?","pitfall":"Discounting the first payment, or leaving it in the {l|liability}","see":"initial"},{"id":"after-day1","title":"Year-end interest, depreciation and the liability balance (practice Q18)","pitfall":"Taking a full year, or crediting {l|accruals} or the {a|ROU asset} with the {x|interest}","see":"subsequent"},{"id":"lessor-class","title":"How should the lessor classify this lease?","pitfall":"Thinking the lessee classifies, or ignoring “PV ≈ substantially all of fair value”","see":"classify"},{"id":"lessor-finance","title":"Lessor amounts: net investment, finance income, lease income","pitfall":"Leaving out the unguaranteed residual","see":"subsequent"},{"id":"slb","title":"What gain is recognised on the sale and leaseback?","pitfall":"Recognising the full {i|gain}","see":"derecognise"},{"id":"present","title":"Where is the principal repayment shown in the cash flow statement?","pitfall":"Putting principal in operating","see":"present"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":22,"title":"Leases, the Socratic way","body":["Each idea starts with a question for you. Think it through, jot a line if you like, then reveal the answer. The rule comes after, once you have already half-worked it out.","Account names are coloured by element, so you can see where each one lands in the financial statements at a glance. Tap **Legend** at the top any time.","At the end there is an exam-style quiz: four-option MCQs, mostly in case sets, just like the PFF paper."],"id":"intro-n6hhl4","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-classify","bucket":"classify","blabel":"is it a lease?","sect":1,"part":"Classify · is it a lease?"},{"type":"think","bucket":"classify","blabel":"is it a lease?","lo":22,"scenario":"Kopi Co runs a chain of cafés. It needs a coffee roasting machine that costs about $45,000 new. The supplier, RoastPro, offers to lease one for 4 years at $10,000 a year.","prompt":"Why might Kopi Co prefer to lease rather than buy?","answer":["No large cash outlay up front, which keeps cash for opening new outlets.","Flexibility: it can return or upgrade the machine at the end.","RoastPro may handle maintenance and disposal, and knows the equipment better.","Lease accounting exists because those economics look a lot like **borrowing to buy an asset**, even though legal ownership stays with the lessor. If it walks like a loan and quacks like a loan, SFRS(I) 16 books it like one."],"id":"think-xcq4aw","sect":1,"part":"Classify · is it a lease?"},{"type":"think","bucket":"classify","blabel":"is it a lease?","lo":22,"scenario":"A second contract: a coffee-bean supplier provides Kopi Co with \"a grinder\" for 3 years. The supplier can swap it for any other grinder in its warehouse whenever it likes, at no cost, and it regularly does so to rotate stock.","prompt":"Is Kopi Co leasing a grinder, or buying a grinding service?","answer":["A **service**. There is no **identified asset**: the supplier has a real (substantive) right to substitute the grinder and benefits from doing so.","If Kopi Co cannot point to *this* machine as the one it controls, it does not have a lease. It recognises the payments as an {x|expense} as incurred. No “that one, right there” means no lease."],"id":"think-jmq1yk","sect":1,"part":"Classify · is it a lease?"},{"type":"rule","bucket":"classify","blabel":"is it a lease?","lo":22,"title":"Definition: three tests","body":["The grinder failed because the supplier could swap it freely. That is one of three tests: before any lease accounting starts, you must know whether the contract contains a lease at all.","A lease is a contract that conveys the **right to control the use of an identified asset** for a period of time **in exchange for consideration**.","1. **Identified asset:** specified in the contract, and the supplier has no substantive right to swap it.","2. **Economic benefits:** the customer gets substantially all the economic benefits from using it during the period.","3. **Right to direct use:** the customer decides how and for what purpose the asset is used.","Fail any one test and it is a **service contract**, not a lease. Memory hook: *this one*, *all mine*, *my call*."],"id":"rule-mcen13","sect":1,"part":"Classify · is it a lease?"},{"id":"diagram-1bsszh","type":"visual","bucket":"classify","blabel":"is it a lease?","lo":22,"title":"Is it a lease? The chart","html":"\u003cp>Three yes answers make a lease. Then two exits can keep it off the balance sheet; only a “no” to \u003cstrong>both\u003c/strong> lands it there. Pick a contract to see its route, or tap any box for what it means.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"flow\" data-key=\"lease-test-b21\" data-cfg=\"{&quot;w&quot;:380,&quot;h&quot;:612,&quot;nodes&quot;:[{&quot;id&quot;:&quot;t1&quot;,&quot;x&quot;:14,&quot;y&quot;:8,&quot;w&quot;:210,&quot;h&quot;:48,&quot;k&quot;:&quot;q&quot;,&quot;t&quot;:&quot;Test 1: identified asset?&quot;,&quot;sub&quot;:[&quot;specified, no real right to swap it&quot;]},{&quot;id&quot;:&quot;t2&quot;,&quot;x&quot;:14,&quot;y&quot;:84,&quot;w&quot;:210,&quot;h&quot;:48,&quot;k&quot;:&quot;q&quot;,&quot;t&quot;:&quot;Test 2: economic benefits?&quot;,&quot;sub&quot;:[&quot;substantially all, whole period&quot;]},{&quot;id&quot;:&quot;t3&quot;,&quot;x&quot;:14,&quot;y&quot;:160,&quot;w&quot;:210,&quot;h&quot;:48,&quot;k&quot;:&quot;q&quot;,&quot;t&quot;:&quot;Test 3: right to direct use?&quot;,&quot;sub&quot;:[&quot;how and for what purpose&quot;]},{&quot;id&quot;:&quot;svc&quot;,&quot;x&quot;:244,&quot;y&quot;:74,&quot;w&quot;:122,&quot;h&quot;:74,&quot;k&quot;:&quot;no&quot;,&quot;t&quot;:&quot;Service contract&quot;,&quot;sub&quot;:[&quot;not a lease:&quot;,&quot;{x|expense} as incurred&quot;]},{&quot;id&quot;:&quot;lease&quot;,&quot;x&quot;:90,&quot;y&quot;:244,&quot;w&quot;:200,&quot;h&quot;:46,&quot;k&quot;:&quot;yes&quot;,&quot;t&quot;:&quot;It is a lease&quot;,&quot;sub&quot;:[&quot;default: on the balance sheet&quot;]},{&quot;id&quot;:&quot;exa&quot;,&quot;x&quot;:14,&quot;y&quot;:326,&quot;w&quot;:168,&quot;h&quot;:58,&quot;k&quot;:&quot;exit&quot;,&quot;t&quot;:&quot;Exit A: short-term?&quot;,&quot;sub&quot;:[&quot;12 months or less,&quot;,&quot;no purchase option&quot;]},{&quot;id&quot;:&quot;exb&quot;,&quot;x&quot;:198,&quot;y&quot;:326,&quot;w&quot;:168,&quot;h&quot;:58,&quot;k&quot;:&quot;exit&quot;,&quot;t&quot;:&quot;Exit B: low-value?&quot;,&quot;sub&quot;:[&quot;judged per asset when new&quot;,&quot;(about $5,000)&quot;]},{&quot;id&quot;:&quot;ex&quot;,&quot;x&quot;:90,&quot;y&quot;:420,&quot;w&quot;:200,&quot;h&quot;:50,&quot;k&quot;:&quot;gold&quot;,&quot;dash&quot;:true,&quot;t&quot;:&quot;Exempt lease&quot;,&quot;sub&quot;:[&quot;if chosen: {x|expense} straight-line&quot;]},{&quot;id&quot;:&quot;bs&quot;,&quot;x&quot;:90,&quot;y&quot;:548,&quot;w&quot;:200,&quot;h&quot;:56,&quot;k&quot;:&quot;gold&quot;,&quot;t&quot;:&quot;Lease on balance sheet&quot;,&quot;sub&quot;:[&quot;{a|ROU asset} + {l|lease liability}&quot;]}],&quot;joins&quot;:[{&quot;id&quot;:&quot;and&quot;,&quot;cx&quot;:190,&quot;cy&quot;:516,&quot;t&quot;:&quot;and&quot;}],&quot;edges&quot;:[{&quot;id&quot;:&quot;t1y&quot;,&quot;d&quot;:&quot;M119 56 V83&quot;,&quot;lab&quot;:&quot;yes&quot;,&quot;lx&quot;:128,&quot;ly&quot;:74},{&quot;id&quot;:&quot;t2y&quot;,&quot;d&quot;:&quot;M119 132 V159&quot;,&quot;lab&quot;:&quot;yes&quot;,&quot;lx&quot;:128,&quot;ly&quot;:150},{&quot;id&quot;:&quot;t1n&quot;,&quot;d&quot;:&quot;M224 32 C 290 32, 305 50, 305 73&quot;,&quot;lab&quot;:&quot;no&quot;,&quot;lx&quot;:262,&quot;ly&quot;:26},{&quot;id&quot;:&quot;t2n&quot;,&quot;d&quot;:&quot;M224 108 H243&quot;,&quot;lab&quot;:&quot;no&quot;,&quot;lx&quot;:234,&quot;ly&quot;:102,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;t3n&quot;,&quot;d&quot;:&quot;M224 184 C 290 184, 305 168, 305 149&quot;,&quot;lab&quot;:&quot;no&quot;,&quot;lx&quot;:262,&quot;ly&quot;:198},{&quot;id&quot;:&quot;t3y&quot;,&quot;d&quot;:&quot;M119 208 C 119 230, 190 222, 190 243&quot;,&quot;lab&quot;:&quot;yes&quot;,&quot;lx&quot;:100,&quot;ly&quot;:228},{&quot;id&quot;:&quot;la&quot;,&quot;d&quot;:&quot;M160 290 C 160 310, 98 304, 98 325&quot;},{&quot;id&quot;:&quot;lb&quot;,&quot;d&quot;:&quot;M220 290 C 220 310, 282 304, 282 325&quot;,&quot;lab&quot;:&quot;either one&quot;,&quot;lx&quot;:190,&quot;ly&quot;:315,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;ay&quot;,&quot;d&quot;:&quot;M110 384 C 110 404, 160 400, 160 419&quot;,&quot;lab&quot;:&quot;yes&quot;,&quot;lx&quot;:116,&quot;ly&quot;:408},{&quot;id&quot;:&quot;by&quot;,&quot;d&quot;:&quot;M270 384 C 270 404, 220 400, 220 419&quot;,&quot;lab&quot;:&quot;yes&quot;,&quot;lx&quot;:264,&quot;ly&quot;:408,&quot;anchor&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;an&quot;,&quot;d&quot;:&quot;M14 355 C 2 355, 2 516, 176 516&quot;,&quot;lab&quot;:&quot;no&quot;,&quot;lx&quot;:26,&quot;ly&quot;:418},{&quot;id&quot;:&quot;bn&quot;,&quot;d&quot;:&quot;M366 355 C 378 355, 378 516, 204 516&quot;,&quot;lab&quot;:&quot;no&quot;,&quot;lx&quot;:354,&quot;ly&quot;:418,&quot;anchor&quot;:&quot;end&quot;},{&quot;id&quot;:&quot;ab&quot;,&quot;d&quot;:&quot;M190 529 V547&quot;}],&quot;all&quot;:&quot;Pick a contract to see its route. Any “no” in tests 1 to 3 makes it a {x|service contract}. Pass all three and it is a lease; then **either** exit is enough to keep it off the balance sheet.&quot;,&quot;scenarios&quot;:[{&quot;id&quot;:&quot;clean&quot;,&quot;label&quot;:&quot;Office cleaning&quot;,&quot;lit&quot;:[&quot;t1&quot;,&quot;t1n&quot;,&quot;svc&quot;],&quot;text&quot;:&quot;Office cleaning, 2 years: the cleaner sends whichever staff and equipment it likes. There is no identified asset, so test 1 fails: a {x|service contract}, expensed as the cleaning is done.&quot;},{&quot;id&quot;:&quot;shared&quot;,&quot;label&quot;:&quot;Truck, shared with others&quot;,&quot;lit&quot;:[&quot;t1&quot;,&quot;t1y&quot;,&quot;t2&quot;,&quot;t2n&quot;,&quot;svc&quot;],&quot;text&quot;:&quot;A specified truck, but the logistics firm also uses it for other customers four days a week. Test 1 passes; test 2 fails, because Kopi Co does not get substantially all the benefits. A {x|service contract}.&quot;},{&quot;id&quot;:&quot;routes&quot;,&quot;label&quot;:&quot;Truck, supplier picks routes&quot;,&quot;lit&quot;:[&quot;t1&quot;,&quot;t1y&quot;,&quot;t2&quot;,&quot;t2y&quot;,&quot;t3&quot;,&quot;t3n&quot;,&quot;svc&quot;],&quot;text&quot;:&quot;A specified truck that only Kopi Co uses, but the logistics firm decides where and when it drives. Tests 1 and 2 pass; test 3 fails. A {x|service contract}.&quot;},{&quot;id&quot;:&quot;proj&quot;,&quot;label&quot;:&quot;Projector, 6 months&quot;,&quot;lit&quot;:[&quot;t1&quot;,&quot;t1y&quot;,&quot;t2&quot;,&quot;t2y&quot;,&quot;t3&quot;,&quot;t3y&quot;,&quot;lease&quot;,&quot;la&quot;,&quot;exa&quot;,&quot;ay&quot;,&quot;ex&quot;],&quot;text&quot;:&quot;Projector for 6 months, no purchase option: all three tests pass, so it is a lease. Exit A: 12 months or less → yes. If Kopi Co chooses the exemption, {x|lease expense} straight-line, nothing on the balance sheet.&quot;},{&quot;id&quot;:&quot;laptop&quot;,&quot;label&quot;:&quot;Laptop, 3 years&quot;,&quot;lit&quot;:[&quot;t1&quot;,&quot;t1y&quot;,&quot;t2&quot;,&quot;t2y&quot;,&quot;t3&quot;,&quot;t3y&quot;,&quot;lease&quot;,&quot;la&quot;,&quot;exa&quot;,&quot;lb&quot;,&quot;exb&quot;,&quot;by&quot;,&quot;ex&quot;],&quot;text&quot;:&quot;Laptop for 3 years: a lease. Exit A fails (over 12 months), but Exit B passes: a laptop is low-value when new. Either exit is enough, so it can be expensed straight-line.&quot;},{&quot;id&quot;:&quot;office&quot;,&quot;label&quot;:&quot;Branch office, 5 years&quot;,&quot;lit&quot;:[&quot;t1&quot;,&quot;t1y&quot;,&quot;t2&quot;,&quot;t2y&quot;,&quot;t3&quot;,&quot;t3y&quot;,&quot;lease&quot;,&quot;la&quot;,&quot;lb&quot;,&quot;exa&quot;,&quot;exb&quot;,&quot;an&quot;,&quot;bn&quot;,&quot;and&quot;,&quot;ab&quot;,&quot;bs&quot;],&quot;text&quot;:&quot;Branch office for 5 years: a lease. Exit A fails (5 years) and Exit B fails (an office is never low-value). Both no, so the {a|ROU asset} and {l|lease liability} go on the balance sheet.&quot;}],&quot;notes&quot;:{&quot;t1&quot;:&quot;Specified in the contract (explicitly or implicitly). A supplier’s right to swap only for repairs is not substantive.&quot;,&quot;t2&quot;:&quot;The customer, not the supplier or other users, gets the output of the asset for the whole period.&quot;,&quot;t3&quot;:&quot;Who decides what the asset does and when. Who operates or maintains it does not matter.&quot;,&quot;svc&quot;:&quot;Fail any test: a service contract. Payments are expensed as the service is received.&quot;,&quot;lease&quot;:&quot;Three yeses: the contract contains a lease. By default the lessee puts it on the balance sheet.&quot;,&quot;exa&quot;:&quot;Short-term = 12 months or less with **no purchase option**. A purchase option rules it out, whatever the term.&quot;,&quot;exb&quot;:&quot;Low-value = judged per asset, **when new**, whatever its age now (laptops, phones, small furniture). Never a building or a car.&quot;,&quot;ex&quot;:&quot;Lessee’s choice: {x|Lease expense} straight-line, nothing on the balance sheet.&quot;,&quot;bs&quot;:&quot;The lessee’s single model: {a|Right-of-use asset} + {l|Lease liability}. The lessor classifies separately.&quot;}}\">\u003c/div>","sect":1,"part":"Classify · is it a lease?"},{"type":"tree","bucket":"classify","blabel":"is it a lease?","lo":22,"title":"Lease test: tap your way down","scenario":"Kopi Co signs a 2-year contract with a logistics firm for a specified refrigerated truck (plate SGX 1234K). The firm may swap the truck only if it breaks down. Kopi Co is the only user and decides the delivery routes and times. The fee is $3,000 a month; a truck like this costs about $120,000 new.","expect":"bs","start":"n1","nodes":{"n1":{"q":"Is there an identified asset?","why":"Without a specific asset the customer controls nothing: it is buying capacity or a service.","opts":[{"t":"Yes: it is specified, and the supplier can swap it only in limited cases (such as repairs)","to":"n2"},{"t":"No: the supplier can swap it whenever it likes and benefits from doing so","to":"svcA"}]},"n2":{"q":"Does the customer get substantially all the economic benefits from using it, throughout the period?","why":"Control means the customer, not the supplier or other users, enjoys the output of the asset.","opts":[{"t":"Yes: it is the only user for the whole period","to":"n3"},{"t":"No: the supplier or other customers share the use","to":"svcB"}]},"n3":{"q":"Does the customer decide how and for what purpose the asset is used?","why":"Whoever decides what the asset does, and when, controls it. Who drives or maintains it does not matter.","opts":[{"t":"Yes: the customer makes those decisions","to":"n4"},{"t":"No: the supplier decides how and when it is used","to":"svcC"}]},"n4":{"q":"It is a lease. Is the lease term 12 months or less, with no purchase option?","why":"Short-term leases may stay off the balance sheet. A purchase option rules that out, whatever the term.","opts":[{"t":"Yes: 12 months or less, and no purchase option","to":"exS"},{"t":"No: longer than 12 months, or there is a purchase option","to":"n5"}]},"n5":{"q":"Is the underlying asset low-value when new?","why":"Judged on the asset itself when new, not on the lessee’s size or on how many it leases.","opts":[{"t":"Yes: a laptop, phone, tablet or small item of furniture","to":"exL"},{"t":"No","to":"bs"}]},"svcA":{"result":"Not a lease: a service contract","body":["No identified asset. The supplier has a **substantive** right to substitute: it can practically swap the asset and benefits from doing so.","- {x|Expense} the payments as the service is received.","+ A right to swap only for repairs or a breakdown is *not* substantive. The asset is still identified."]},"svcB":{"result":"Not a lease: a service contract","body":["The customer does not get substantially all the economic benefits from using the asset, for example because the supplier uses it for other customers at the same time.","- Expense the payments as the service is received."]},"svcC":{"result":"Not a lease: a service contract","body":["The supplier decides how and for what purpose the asset is used, so the customer is buying an output (a service), not control of the asset.","- Expense the payments as the service is received."]},"exS":{"result":"Lease, which may be expensed as short-term","body":["If the lessee chooses the exemption: {x|Lease expense} **straight-line** over the lease term, and nothing on the balance sheet.","- If it does not choose it, the lease goes on the balance sheet like any other.","! A 12-month lease *with* a purchase option is not short-term."]},"exL":{"result":"Lease, which may be expensed as low-value","body":["If the lessee chooses the exemption: {x|Lease expense} **straight-line** over the lease term, and nothing on the balance sheet.","- Low-value is judged per asset, when new: 30 laptops are still 30 low-value assets."]},"bs":{"result":"On the balance sheet: {a|right-of-use asset} + {l|lease liability}","body":["The lessee recognises a {a|Right-of-use asset} and a {l|Lease liability} at commencement. The next sections build both.","- In the truck case: the truck is specified and can be swapped only on breakdown (not substantive); Kopi Co is the only user and directs the routes and times; 2 years is not short-term; and a truck is not low-value.","+ The lessor, separately, classifies the same lease as finance or operating. The lessee never does."]}},"id":"tree-qhfnt4","sect":1,"part":"Classify · is it a lease?","svg":"\u003csvg width=\"100%\" style=\"min-width:640px\" role=\"img\"\n viewBox=\"0.00 0.00 612.00 639.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 628.36)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-628.36 601.19,-628.36 601.19,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>n1\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M494.4,-617.56C494.4,-617.56 404.38,-617.56 404.38,-617.56 398.38,-617.56 392.38,-611.56 392.38,-605.56 392.38,-605.56 392.38,-593.56 392.38,-593.56 392.38,-587.56 398.38,-581.56 404.38,-581.56 404.38,-581.56 494.4,-581.56 494.4,-581.56 500.4,-581.56 506.4,-587.56 506.4,-593.56 506.4,-593.56 506.4,-605.56 506.4,-605.56 506.4,-611.56 500.4,-617.56 494.4,-617.56\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"449.39\" y=\"-601.11\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">Is there an identified\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"449.39\" y=\"-589.11\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">asset?\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>n2\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M436.78,-488.06C436.78,-488.06 304,-488.06 304,-488.06 298,-488.06 292,-482.06 292,-476.06 292,-476.06 292,-443.42 292,-443.42 292,-437.42 298,-431.42 304,-431.42 304,-431.42 436.78,-431.42 436.78,-431.42 442.78,-431.42 448.78,-437.42 448.78,-443.42 448.78,-443.42 448.78,-476.06 448.78,-476.06 448.78,-482.06 442.78,-488.06 436.78,-488.06\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"370.39\" y=\"