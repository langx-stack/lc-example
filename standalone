.94,-12 334.94,-12 334.94,-27.64 334.94,-27.64 334.94,-33.64 328.94,-39.64 322.94,-39.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"228.05\" y=\"-25.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Most likely amount\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"260.67\" y=\"-14.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">50,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"232.92\" y=\"-5.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">best for two outcomes\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>ontime&#45;&gt;ml\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M88.27,-21.46C122.75,-21.16 172.23,-20.72 211.75,-20.38\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"211.52,-22.48 217.5,-20.33 211.48,-18.28 211.52,-22.48\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"151.16\" y=\"-22.98\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> highest probability \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>early\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M78.78,-156.82C78.78,-156.82 12,-156.82 12,-156.82 6,-156.82 0,-150.82 0,-144.82 0,-144.82 0,-132.82 0,-132.82 0,-126.82 6,-120.82 12,-120.82 12,-120.82 78.78,-120.82 78.78,-120.82 84.78,-120.82 90.78,-126.82 90.78,-132.82 90.78,-132.82 90.78,-144.82 90.78,-144.82 90.78,-150.82 84.78,-156.82 78.78,-156.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"31.89\" y=\"-140.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Early\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-129.37\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">100,000 × 20%\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>early&#45;&gt;ev\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M91.24,-127.69C123.2,-119.77 166.85,-108.94 203.71,-99.79\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"204.2,-101.84 209.52,-98.35 203.19,-97.76 204.2,-101.84\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>cons\u003c/title>\n\u003cpolygon fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" points=\"478.84,-87.46 379.81,-49.82 478.84,-12.18 577.87,-49.82 478.84,-87.46\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"451.09\" y=\"-54.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Constraint\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"440.59\" y=\"-45.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">highly probable no\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"437.97\" y=\"-36.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">significant reversal?\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>ev&#45;&gt;cons\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M343.27,-71.39C361.64,-68.44 381.8,-65.21 400.79,-62.17\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"400.92,-64.27 406.51,-61.25 400.26,-60.13 400.92,-64.27\"/>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>ml&#45;&gt;cons\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M335.39,-28.42C355.27,-31.4 377.92,-34.81 399.22,-38.01\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"398.65,-40.04 404.89,-38.86 399.27,-35.89 398.65,-40.04\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"calc-umk7v6","type":"calc","bucket":"price","lo":41,"q":"Sentosa Engineering’s contract is $1,000,000 fixed, plus a bonus of $50,000 if it finishes on time or $100,000 if it finishes early. Probabilities: 30% late (no bonus), 50% on time, 20% early. Sentosa uses the expected value method, and the constraint is met. What is the transaction price?","answer":1045000,"unit":"$","working":["Expected bonus = 0 × 30% + 50,000 × 50% + 100,000 × 20% = 45,000.","Transaction price = 1,000,000 + 45,000 = **$1,045,000**."],"sect":3,"part":"Transaction price"},{"type":"think","bucket":"price","lo":41,"scenario":"An asset manager earns a performance fee of 20% of any gain in a fund over the year. It is January; the fee depends entirely on stock markets over the next 12 months.","prompt":"Should the manager include an estimated performance fee in its transaction price in January?","answer":["No. The fee swings with the market, which the manager can’t control, and could easily end up at zero.","Including an estimate now risks a **significant reversal** of {i|revenue} later. So the **constraint** keeps it out until the uncertainty is largely resolved. {i|Revenue} isn’t a lottery ticket you cash in before the draw."],"id":"think-j9xyga","sect":3,"part":"Transaction price"},{"type":"rule","bucket":"price","lo":41,"title":"The constraint","body":["An estimate can be too hopeful, like the asset manager’s fee in January. The constraint is the brake that keeps shaky amounts out of {i|revenue} until they firm up.","Include variable consideration only to the extent it is **highly probable** that a **significant reversal** of {i|cumulative revenue} will **not** occur when the uncertainty is resolved.","Signs the constraint bites: the amount depends on things outside the entity’s control (markets, weather), little experience with similar contracts, a long time until it is resolved, or a wide range of outcomes.","- **Reassess** the estimate at each reporting date.","! Not the same as “wait for the cash” or “be prudent”. If the bonus is highly probable, it goes in **now**, even though nothing has been received."],"id":"rule-68lwd7","sect":3,"part":"Transaction price"},{"type":"mcq","bucket":"price","lo":41,"q":"Which situation is most likely to mean that variable consideration is constrained (excluded from the transaction price)?","options":[{"t":"A volume rebate, where years of data show customers almost always hit the threshold","why":"Plenty of experience and a predictable outcome: the estimate goes in."},{"t":"A bonus that depends on next year’s rainfall, with no history of similar contracts","ok":true,"why":"Outside the entity’s control and no experience to estimate from: a significant reversal is a real risk."},{"t":"A bonus for finishing on time, which the entity has achieved on 95% of similar contracts","why":"Highly probable: include it."},{"t":"A fixed fee payable in three instalments","why":"Fixed, not variable. Instalments alone don’t make the price variable."}],"id":"mcq-174c2g","sect":3,"part":"Transaction price"},{"id":"think-wba7x3","type":"think","bucket":"price","lo":41,"scenario":"Clementi Craft sells 100 kettles for $50 each in cash (cost $30 each). Customers may return them within 30 days for a full refund. From experience, about 5 will come back.","prompt":"Clementi has $5,000 in {a|cash}. How much of it is {i|revenue} today?","answer":["Only the part it expects to **keep**: 95 kettles × $50 = {i|$4,750}.","The $250 for the 5 kettles expected back is a {l|Refund liability}: Clementi expects to hand that {a|cash} back.","And the 5 kettles themselves? They are expected to come back, so instead of {x|Cost of sales} they become a {a|Right to recover returned goods} at their cost of $150."],"sect":3,"part":"Transaction price"},{"type":"rule","bucket":"price","lo":41,"title":"Right of return and volume rebates","body":["Clementi’s kettles are variable consideration in disguise: part of the sale is expected to come back. This rule says where the expected returns sit until they do.","A right of return is variable consideration. On sale:","1. {i|Revenue} only for the goods you **expect to keep sold**.","2. A {l|Refund liability} for the amount you expect to refund.","3. An {a|asset}, {a|Right to recover returned goods}, at the {a|former carrying amount} of the goods expected back, less any expected costs of recovery. {x|Cost of sales} covers only the goods expected to stay sold.","- **Volume rebates** work the same way: estimate the rebate customers will earn, reduce {i|Revenue} and recognise a {l|Refund liability}.","! Don’t book full {i|revenue} and wait for the returns to roll in. The expected refund is a {l|liability} from day 1."],"id":"rule-sjrm71","sect":3,"part":"Transaction price"},{"type":"diagram","bucket":"price","lo":41,"title":"Where the 100 kettles go","intro":"One sale, four homes. The kettles expected to stay sold go to P&L; the ones expected back stay on the balance sheet.","notes":{"sale":"100 × $50 = 5,000 {a|cash received}; the kettles cost 100 × $30 = 3,000.","keep":"The units the entity expects customers to keep, based on experience.","back":"Expected returns. Reassess the estimate at each reporting date.","rev":"95 × $50 = 4,750. Only what it expects to keep.","cogs":"95 × $30 = 2,850.","ref":"5 × $50 = 250: {a|cash} it expects to pay back.","rec":"5 × $30 = 150: the kettles it expects to get back (no recovery costs here)."},"walk":[{"nodes":["sale"],"text":"All 100 kettles leave and all the {a|cash} comes in."},{"nodes":["keep","rev","cogs"],"text":"The kettles expected to stay sold: {i|revenue} and {x|cost of sales}, as normal."},{"nodes":["back","ref"],"text":"The {a|cash} for expected returns is a **{l|refund liability}**, not {i|revenue}."},{"nodes":["back","rec"],"text":"The kettles expected back are an **{a|asset}** at cost, not {x|cost of sales}."}],"caption":"Profit on the sale: {i|4,750} − {x|2,850} = 1,900, only on goods expected to stay sold.","id":"diagram-1fhhi0","sect":3,"part":"Transaction price","svg":"\u003csvg width=\"100%\" style=\"min-width:466px\" role=\"img\"\n viewBox=\"0.