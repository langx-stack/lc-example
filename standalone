\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>ret&#45;&gt;pl\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M148,-71.54C174.53,-71.54 204.67,-71.54 229.7,-71.54\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"229.47,-73.99 236.47,-71.54 229.47,-69.09 229.47,-73.99\"/>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>fvp\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M148.73,-39.08C148.73,-39.08 12.37,-39.08 12.37,-39.08 6.38,-39.08 0.38,-33.08 0.38,-27.08 0.38,-27.08 0.38,-12 0.38,-12 0.38,-6 6.38,0 12.38,0 12.38,0 148.73,0 148.73,0 154.73,0 160.73,-6 160.73,-12 160.73,-12 160.73,-27.08 160.73,-27.08 160.73,-33.08 154.73,-39.08 148.73,-39.08\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"11.18\" y=\"-24.59\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Non&#45;monetary at fair value\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"13.43\" y=\"-15.49\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">gain in P&amp;L: investment property,\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"46.8\" y=\"-6.49\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">shares at FVTPL\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>fvp&#45;&gt;pl\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M159.35,-39.64C182.98,-45.75 208.39,-52.32 229.97,-57.89\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"229.19,-60.22 236.58,-59.6 230.42,-55.48 229.19,-60.22\"/>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>fvo\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M148.73,-189.54C148.73,-189.54 12.37,-189.54 12.37,-189.54 6.38,-189.54 0.38,-183.54 0.38,-177.54 0.38,-177.54 0.38,-165.54 0.38,-165.54 0.38,-159.54