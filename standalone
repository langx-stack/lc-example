62,-39.64 482.09,-39.64 482.09,-39.64 476.09,-39.64 470.09,-33.64 470.09,-27.64 470.09,-27.64 470.09,-12 470.09,-12 470.09,-6 476.09,0 482.09,0 482.09,0 555.62,0 555.62,0 561.62,0 567.62,-6 567.62,-12 567.62,-12 567.62,-27.64 567.62,-27.64 567.62,-33.64 561.62,-39.64 555.62,-39.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"493.73\" y=\"-25.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Provision\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"499.36\" y=\"-14.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">200,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"478.73\" y=\"-5.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">rest of the loss, now\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>y2&#45;&gt;prov\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#be123c\" d=\"M518.86,-82.95C518.86,-71.13 518.86,-59.3 518.86,-47.47\"/>\n\u003cpolygon fill=\"#be123c\" stroke=\"#be123c\" points=\"520.96,-47.61 518.86,-41.61 516.76,-47.61 520.96,-47.61\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>tot\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M850.68,-81.82C850.68,-81.82 777.9,-81.82 777.9,-81.82 771.9,-81.82 765.9,-75.82 765.9,-69.82 765.9,-69.82 765.9,-57.82 765.9,-57.82 765.9,-51.82 771.9,-45.82 777.9,-45.82 777.9,-45.82 850.68,-45.82 850.68,-45.82 856.68,-45.82 862.68,-51.82 862.68,-57.82 862.68,-57.82 862.68,-69.82 862.68,-69.82 862.68,-75.82 856.68,-81.82 850.68,-81.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"774.54\" y=\"-65.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Whole contract\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"780.17\" y=\"-54.37\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"white\">loss (500,000)\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>y3&#45;&gt;tot\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"1,5\" d=\"M735.41,-63.82C742.76,-63.82 750.43,-63.82 757.96,-63.82\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"757.91,-65.92 763.91,-63.82 757.91,-61.72 757.91,-65.92\"/>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>est&#45;&gt;y2\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M442.35,-107.82C449.91,-107.82 457.21,-107.82 464.08,-107.82\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"463.86,-109.92 469.86,-107.82 463.86,-105.72 463.86,-109.92\"/>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>prov&#45;&gt;y3\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M568.09,-32.55C588.32,-37.88 611.92,-44.11 632.71,-49.59\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"632.14,-51.61 638.48,-51.11 633.21,-47.55 632.14,-51.61\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"604\" y=\"-48.8\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> released \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"think","bucket":"recognise","blabel":"construction","lo":42,"scenario":"A builder’s manager says: “We’re losing money on this contract, but it’s only 60% done. Let’s show 60% of the loss this year and the rest next year, as we do the work.”","prompt":"Is that allowed?","answer":["No. Once the total costs are expected to **exceed** the contract price, the contract is **onerous**: the **whole** {x|expected loss} goes to P&L immediately.","Profit is spread with progress; {x|losses} are not. Bad news gets no instalment plan."],"id":"think-40vz17","sect":6,"part":"Recognise revenue · construction"},{"type":"rule","bucket":"recognise","blabel":"construction","lo":42,"title":"Onerous contracts and the cost-to-cost traps","body":["Bedok’s year 2 and the manager’s shortcut show where cost-to-cost goes wrong. Three rules keep it honest, and the third deals with bad news.","1. Measure progress with the **latest** estimate of total costs ({x|costs to date} + current estimate to complete), not the original budget.","2. {i|Revenue this year} = {i|cumulative revenue to date} − {i|revenue recognised in earlier years}.","3. If the estimated total cost **exceeds** the price, recognise the **whole** {x|expected loss} now: the part not already in {i|revenue} − {x|costs to date} goes to a {l|Provision for onerous contract} (SFRS(I) 1-37).","> {l|Provision} = {x|total expected loss} − ({x|costs to date} − {i|revenue to date})","! Don’t spread an {x|expected loss} over the remaining years, and don’t measure progress with last year’s cost estimate."],"id":"rule-sqnq4y","sect":6,"part":"Recognise revenue · construction"},{"type":"visual","bucket":"recognise","blabel":"construction","lo":42,"title":"Bedok’s loss, in bars","html":"\u003cp>Bedok at the end of year 2, as bars. First the whole contract: the latest total cost overshoots the price, and the overshoot is the \u003cspan class=\"el el-x\">expected loss\u003c/span>. Then that loss split in two layers: the part \u003cspan class=\"el el-i\">revenue to date\u003c/span> − \u003cspan class=\"el el-x\">costs to date\u003c/span> has already shown, and the rest, which the \u003cspan class=\"el el-l\">provision\u003c/span> must catch now.\u003c/p>\u003cdiv class=\"cbars\">\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003cspan class=\"seg i\">\u003c/span>\u003cspan class=\"el el-i\">price\u003c/span>\u003c/span>\u003cspan>\u003cspan class=\"seg x\">\u003c/span>\u003cspan class=\"el el-x\">total cost\u003c/span>\u003c/span>\u003cspan>\u003cspan class=\"seg out-x\">\u003c/span>\u003cspan class=\"el el-x\">expected loss\u003c/span>\u003c/span>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Price \u003cspan class=\"el el-i\">10,000,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg i\" style=\"flex:none;width:95.24%\">\u003c/span>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Latest total cost \u003cspan class=\"el el-x\">6,300,000\u003c/span> + 4,200,000 = \u003cspan class=\"el el-x\">10,500,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg x\" style=\"flex:none;width:95.24%\">\u003c/span>\u003cspan class=\"seg out-x\" style=\"flex:none;width:4.76%\">\u003c/span>\u003c/div>\u003c/div>\n  \u003c/div>\n  \u003cdiv class=\"cbars\" style=\"margin-top:14px\">\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003cspan class=\"seg x\">\u003c/span>\u003cspan class=\"el el-x\">already shown in P&amp;L\u003c/span>\u003c/span>\u003cspan>\u003cspan class=\"seg l\">\u003c/span>\u003cspan class=\"el el-l\">provision now\u003c/span>\u003c/span>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">\u003cspan class=\"el el-x\">Loss 500,000\u003c/span> = \u003cspan class=\"el el-x\">6,300,000 − 6,000,000\u003c/span> + \u003cspan class=\"el el-l\">200,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg x\" style=\"flex:none;width:60.00%\">\u003c/span>\u003cspan class=\"seg l\" style=\"flex:none;width:40.00%\">\u003c/span>\u003c/div>\u003c/div>\n  \u003c/div>\u003cp class=\"cap\">The second bar is drawn on its own, larger scale. \u003cspan class=\"el el-x\">Costs to date\u003c/span> 6,300,000 already exceed \u003cspan class=\"el el-i\">revenue to date\u003c/span> 6,000,000 by 300,000; the \u003cspan class=\"el el-l\">provision\u003c/span> adds the missing 200,000, so the \u003cstrong>whole\u003c/strong> 500,000 is in P&amp;L by the end of year 2.\u003c/p>","id":"visual-r635yk","sect":6,"part":"Recognise revenue · construction"},{"id":"calc-la5hdq","type":"calc","bucket":"recognise","blabel":"construction","lo":42,"given":2,"q":"Your turn, with the first lines filled in. Raffles Construct has a contract price of $12,000,000 and measures progress cost-to-cost. Year 1: costs $3,000,000, estimated costs to complete $6,000,000. End of year 2: costs to date $6,300,000, estimated costs to complete $2,700,000. What {i|revenue} is recognised in year 2?","answer":4400000,"unit":"$","working":["Year 1: progress 3,000,000 ÷ 9,000,000 = 33.33%; {i|revenue to date} 4,000,000.","Year 2: estimated total cost = 6,300,000 + 2,700,000 = 9,000,000; progress 70%.","{i|Revenue to date} = 12,000,000 × 70% = 8,400,000.","Year 2 {i|revenue} = 8,400,000 − 4,000,000 = **$4,400,000**."],"sect":6,"part":"Recognise revenue · construction"},{"id":"calc-1bhfsn","type":"calc","bucket":"recognise","blabel":"construction","lo":42,"q":"Now a blank one. Woodlands Works has a contract price of $5,000,000 and measures progress cost-to-cost. Year 1: costs $1,200,000, estimated costs to complete $2,800,000. End of year 2: costs to date $3,000,000, estimated costs to complete $1,000,000. What **profit** is recognised in year 2?","answer":450000,"unit":"$","working":["Year 1: progress 1,200,000 ÷ 4,000,000 = 30%; {i|revenue to date} 1,500,000.","Year 2: total cost 3,000,000 + 1,000,000 = 4,000,000 (still below the price, so no {l|onerous provision}); progress 75%; {i|revenue to date} 3,750,000.","Year 2 {i|revenue} = 3,750,000 − 1,500,000 = 2,250,000; year 2 {x|costs} = 3,000,000 − 1,200,000 = 1,800,000.","Year 2 profit = {i|2,250,000} − {x|1,800,000} = **$450,000**."],"sect":6,"part":"Recognise revenue · construction"},{"id":"mcq-18pcf9","type":"mcq","bucket":"recognise","blabel":"construction","lo":42,"q":"A contract has a price of $3,000,000. At the end of year 1, costs incurred are $1,000,000 and estimated costs to complete are $2,500,000. What {x|total loss} is recognised in year 1?","options":[{"t":"$142,857: the {x|loss} on the 28.57% of work done","why":"Spreads the {x|loss} with progress. An {x|expected loss} is recognised in full immediately."},{"t":"$500,000: the whole {x|expected loss}","ok":true,"why":"Total cost 3,500,000 − price 3,000,000 = 500,000. {i|Revenue} 857,143 − {x|costs} 1,000,000 − {x|provision charge} 357,143 = (500,000)."},{"t":"Nil: {x|losses} are recognised only when the contract is complete","why":"An onerous contract’s {x|loss} is recognised as soon as it is expected."},{"t":"$1,000,000: all {x|costs to date}, with no {i|revenue} until completion","why":"{i|Revenue} is still recognised on progress; it is the {x|expected loss} that matters."}],"sect":6,"part":"Recognise revenue · construction"},{"type":"map","id":"map-7-balances","bucket":"balances","sect":7,"part":"Contract balances and costs"},{"id":"think-dvfd44","type":"think","bucket":"balances","lo":40,"scenario":"Three situations at year end. (1) A customer paid in December for a January software subscription. (2) Tampines Tech delivered product A (allocated $300) but, under the contract, can bill nothing until product B is delivered too. (3) Tampines delivered goods and sent an invoice due in 30 days.","prompt":"Which is a {a|receivable}, which is a {a|contract asset}, and which is a {l|contract liability}?","answer":["**(1) {l|Contract liability}:** {a|cash} in before performance. Tampines owes the service.","**(2) {a|Contract asset}:** {i|revenue} of 300 is earned, but the right to payment is **conditional** on delivering B, not just on time passing.","**(3) {a|Receivable}:** the right to payment is **unconditional**: only the passage of time stands between Tampines and the {a|cash}."],"sect":7,"part":"Contract balances and costs"},{"type":"rule","bucket":"balances","lo":40,"title":"Receivable, contract asset or contract liability?","body":["{i|Revenue} and billing run on different clocks, so the balance sheet has to show the gap. The three year-end situations gave three different balances; this rule names them.","- {a|Accounts receivable}: a right to payment that is **unconditional**: only the passage of time is needed.","- {a|Contract asset}: a right to payment that is **conditional** on something other than time, usually **further performance**.","- {l|Contract liability}: the customer has **paid (or payment is due) before** the entity performs.","On a construction contract:","- {i|revenue to date} **more** than billings → {a|Contract asset}","- billings **more** than {i|revenue to date} → {l|Contract liability}","! Calling a conditional right a {a|receivable} is the classic slip. Ask: is time the only thing left?"],"id":"rule-mh5m48","sect":7,"part":"Contract balances and costs"},{"type":"diagram","bucket":"balances","lo":40,"title":"Which balance is it?","intro":"Two questions sort every contract balance: who moved first, and is anything other than time still needed?","notes":{"start":"Look at each contract on its own at the year end.","q1":"Compare what the customer has paid (or owes) with what the entity has delivered.","cl":"{a|Cash} ahead of performance: the entity owes goods or services. Becomes {i|revenue} as it performs.","q2":"Has the entity got an unconditional right to be paid, or does it have to do something more first?","ar":"Unconditional: just waiting for the due date. Usually after invoicing.","cas":"Earned but conditional, e.g. product A delivered (300) but payable only after product B."},"walk":[{"nodes":["start","q1"],"text":"First: who moved first, the customer (paying) or the entity (performing)?"},{"nodes":["cl"],"text":"Customer paid first → **{l|contract liability}**."},{"nodes":["q2","ar"],"text":"Entity performed and only time is left → **{a|receivable}**."},{"nodes":["q2","cas"],"text":"Entity performed but more work is needed before it can bill → **{a|contract asset}**."},{"nodes":["cas","ar"],"text":"Once the condition is met, the {a|contract asset} becomes a {a|receivable}."}],"caption":"Time only → {a|receivable}. More work needed → {a|contract asset}. Paid first → {l|contract liability}.","id":"diagram-92mr8v","sect":7,"part":"Contract balances and costs","svg":"\u003csvg width=\"100%\" style=\"min-width:495px\" role=\"img\"\n viewBox=\"0.00 0.00 450.00 366.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 354.83)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-354.83 439.34,-354.83 439.34,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>start\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M197.9,-344.03C197.9,-344.03 49.38,-344.03 49.38,-344.03 43.37,-344.03 37.37,-338.03 37.37,-332.03 37.37,-332.03 37.37,-320.03 37.37,-320.03 37.37,-314.03 43.37,-308.03 49.37,-308.03 49.37,-308.03 197.9,-308.03 197.9,-308.03 203.9,-308.03 209.9,-314.03 209.9,-320.03 209.9,-320.03 209.9,-332.03 209.9,-332.03 209.9,-338.03 203.9,-344.03 197.9,-344.03\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"46.01\" y=\"-322.58\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Contract at the reporting date\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>q1\u003c/title>\n\u003cpolygon fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" points=\"123.64,-281.03 28.46,-263.03 123.64,-245.03 218.82,-263.03 123.64,-281.03\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"77.14\" y=\"-259.58\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Who moved first?\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge1\" class=\"edge\">\n\u003ctitle>start&#45;&gt;q1\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M123.64,-307.71C123.64,-301.84 123.64,-295.16 123.64,-288.82\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"125.74,-289.12 123.64,-283.12 121.54,-289.12 125.74,-289.12\"/>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>cl\u003c/title>\n\u003cpath fill=\"#ffe4e6\" stroke=\"#be123c\" stroke-width=\"1.2\" d=\"M137.28,-195.14C137.28,-195.14 12,-195.14 12,-195.14 6,-195.14 0,-189.14 0,-183.14 0,-183.14 0,-171.14 0,-171.14 0,-165.14 6,-159.14 12,-159.14 12,-159.14 137.28,-159.14 137.28,-159.14 143.28,-159.14 149.28,-165.14 149.28,-171.14 149.28,-171.14 149.28,-183.14 149.28,-183.14 149.28,-189.14 143.28,-195.14 137.28,-195.14\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"31.51\" y=\"-177.69\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Contract liability\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-168.59\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">paid (or due) before you perform\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>q1&#45;&gt;cl\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M114.42,-246.25C107.12,-233.74 96.79,-216.05 88.48,-201.84\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"90.43,-201.01 85.59,-196.89 86.81,-203.13 90.43,-201.01\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"138.72\" y=\"-222.53\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> customer paid \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>q2\u003c/title>\n\u003cpolygon fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" points=\"279.64,-207.78 173.86,-177.14 279.64,-146.5 385.42,-177.14 279.64,-207.78\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"245.14\" y=\"-178.69\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Only time left\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"235.39\" y=\"-167.69\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">before payment?\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>q1&#45;&gt;q2\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M147.67,-249.11C171.35,-236.37 208.04,-216.64 236.73,-201.21\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"237.47,-203.2 241.76,-198.51 235.49,-199.5 237.47,-203.2\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"235.21\" y=\"-222.53\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> entity performed \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>ar\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M297.15,-36C297.15,-36 228.12,-36 228.12,-36 222.12,-36 216.12,-30 216.12,-24 216.12,-24 216.12,-12 216.12,-12 216.12,-6 222.12,0 228.12,0 228.12,0 297.15,0 297.15,0 303.15,0 309.15,-6 309.15,-12 309.15,-12 309.15,-24 309.15,-24 309.15,-30 303.15,-36 297.15,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"234.14\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Receivable\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"224.76\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">unconditional right\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>q2&#45;&gt;ar\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M266.92,-149.78C261.78,-137.73 256.46,-123.07 253.89,-109.25 249.81,-87.31 252.93,-62 256.53,-43.77\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"258.58,-44.21 257.77,-37.91 254.48,-43.34 258.58,-44.21\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"264.76\" y=\"-87.38\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> yes \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>cas\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M396.65,-109.25C396.65,-109.25 300.62,-109.25 300.62,-109.25 294.62,-109.25 288.62,-103.25 288.62,-97.25 288.62,-97.25 288.62,-85.25 288.62,-85.25 288.62,-79.25 294.62,-73.25 300.62,-73.25 300.62,-73.25 396.65,-73.25 396.65,-73.25 402.65,-73.25 408.65,-79.25 408.65,-85.25 408.65,-85.25 408.65,-97.25 408.65,-97.25 408.65,-103.25 402.65,-109.25 396.65,-109.25\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"310.39\" y=\"-91.8\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Contract asset\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"297.26\" y=\"-82.7\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">conditional on more work\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>q2&#45;&gt;cas\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M299.6,-151.88C309.02,-140.42 320.21,-126.81 329.53,-115.49\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"331.05,-116.94 333.24,-110.97 327.81,-114.27 331.05,-116.94\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"330.6\" y=\"-124\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> no \u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>cas&#45;&gt;ar\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M327.82,-73C316.27,-63.43 301.77,-51.42 289.39,-41.16\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"290.99,-39.76 285.03,-37.55 288.31,-42.99 290.99,-39.76\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"369.66\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> when the condition is met \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"balances","lo":42,"title":"A contract asset, year by year","html":"\u003cp>Back to Bedok’s 10,000,000 warehouse. \u003cspan class=\"el el-i\">Revenue\u003c/span> follows progress (2,500,000, 3,500,000, 4,000,000), while invoices follow the payment terms (2,000,000, 3,000,000, 5,000,000). The gap between them is the \u003cspan class=\"el el-a\">contract asset\u003c/span>. Step through it.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"ca-c1\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;Contract asset&quot;,&quot;sub&quot;:&quot;price 10,000,000 · 3 years&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Contract asset&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;Day 1: no work done, nothing billed. The {a|contract asset} is nil.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;Year 1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;revenue&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:2500000,&quot;cap&quot;:&quot;Year 1: {i|revenue} 2,500,000 is earned on progress, so the {a|contract asset} rises to {a|2,500,000}.&quot;},{&quot;name&quot;:&quot;billed&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-2000000,&quot;cap&quot;:&quot;2,000,000 is invoiced and moves to {a|receivables}: {a|closing contract asset} = {a|2,500,000} − 2,000,000 = {a|500,000}.&quot;}]},{&quot;label&quot;:&quot;Year 2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;revenue&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:3500000,&quot;cap&quot;:&quot;Year 2: {i|revenue} 3,500,000 is earned on progress, so the {a|contract asset} rises to {a|4,000,000}.&quot;},{&quot;name&quot;:&quot;billed&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-3000000,&quot;cap&quot;:&quot;3,000,000 is invoiced and moves to {a|receivables}: {a|closing contract asset} = {a|4,000,000} − 3,000,000 = {a|1,000,000}.&quot;}]},{&quot;label&quot;:&quot;Year 3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;revenue&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:4000000,&quot;cap&quot;:&quot;Year 3: {i|revenue} 4,000,000 is earned on progress, so the {a|contract asset} rises to {a|5,000,000}.&quot;},{&quot;name&quot;:&quot;billed&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000000,&quot;cap&quot;:&quot;5,000,000 is invoiced and moves to {a|receivables}: {a|closing contract asset} = {a|5,000,000} − 5,000,000 = {a|0}. Fully earned and fully billed: nothing left.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;{a|Contract asset} = {i|revenue to date} − amounts billed. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Step 1 each year: {i|revenue} earned on progress adds to the {a|contract asset}.&quot;,&quot;Step 2: invoicing makes the right unconditional, so that amount leaves for {a|receivables}.&quot;],&quot;end&quot;:&quot;**Just timing.** Billing lags progress, so a {a|contract asset} builds up (500,000, then 1,000,000) and falls to nil once the job is done and fully billed. Had Bedok billed **ahead** of progress, the same gap would be a {l|contract liability}. The {l|onerous provision} is a separate liability and is not netted here.&quot;}}\">\u003c/div>","id":"visual-i1tcux","sect":7,"part":"Contract balances and costs"},{"id":"je-a893o4","type":"je","bucket":"balances","lo":40,"q":"Tampines Tech sells products A (SSP $300) and B (SSP $700) for $1,000, payable only once both are delivered. A and B are separate performance obligations. Record the delivery of A (B not yet delivered).","accounts":["Cash","Accounts receivable","Contract asset","Contract liability","Revenue","Refund liability","Right to recover returned goods","Inventory","Cost of sales","Provision for onerous contract","Loss on onerous contract","Warranty provision","Warranty expense","Interest income","Marketing expense"],"lines":[{"side":"Dr","account":"Contract asset","amount":300,"el":"a"},{"side":"Cr","account":"Revenue","amount":300,"el":"i"}],"why":"A’s 300 is earned, but payment depends on delivering B as well: a conditional right, so a {a|contract asset}, not a {a|receivable}.","sect":7,"part":"Contract balances and costs"},{"id":"je-env7n2","type":"je","bucket":"balances","lo":40,"q":"Tampines Tech sells products A (SSP $300) and B (SSP $700) for $1,000, payable only once both are delivered. On delivering A it recorded a $300 {a|contract asset}. Now B is delivered and the full price becomes payable. Record it.","accounts":["Cash","Accounts receivable","Contract asset","Contract liability","Revenue","Refund liability","Right to recover returned goods","Inventory","Cost of sales","Provision for onerous contract","Loss on onerous contract","Warranty provision","Warranty expense","Interest income","Marketing expense"],"lines":[{"side":"Dr","account":"Accounts receivable","amount":1000,"el":"a"},{"side":"Cr","account":"Contract asset","amount":300,"el":"a"},{"side":"Cr","account":"Revenue","amount":700,"el":"i"}],"why":"The right to 1,000 is now unconditional: a {a|receivable}. The 300 {a|contract asset} is cleared and B’s 700 is {i|revenue}.","sect":7,"part":"Contract balances and costs"},{"id":"mcq-1tiu64","type":"mcq","bucket":"balances","lo":42,"q":"Bedok Builders is building a warehouse for a customer, recognising {i|revenue} over time. At the end of year 1 it has recognised {i|revenue to date} of $2,500,000 and billed the customer $2,000,000. What contract balance is shown?","options":[{"t":"{l|Contract liability} $500,000","why":"A {l|contract liability} arises when billings exceed {i|revenue}. Here {i|revenue} is higher."},{"t":"{a|Contract asset} $500,000","ok":true,"why":"{i|Revenue to date} 2,500,000 − billings 2,000,000 = 500,000 earned but not yet billed."},{"t":"{a|Receivable} $2,500,000","why":"Only the billed amount is a {a|receivable} (if unpaid). The unbilled part is a {a|contract asset}."},{"t":"No balance: revenue and billings are the same thing","why":"{i|Revenue} follows progress; billing follows the contract’s payment terms."}],"sect":7,"part":"Contract balances and costs"},{"type":"rule","bucket":"balances","lo":40,"title":"Contract costs, briefly","body":["One last balance-sheet item: what the entity pays to win or fulfil a contract. Most of it is simply {x|expense}, but a few costs become an {a|asset}.","- **Incremental costs of obtaining** a contract (a sales commission paid only if the contract is won) are capitalised as an {a|asset} if expected to be recovered, then amortised as the goods or services are transferred.","- Practical expedient: they may be **expensed** if the {a|asset} would be amortised over **one year or less**.","- **Costs of fulfilling** a contract are capitalised only if no other standard applies (inventory, PPE…) and they create a resource used to satisfy future obligations, and are expected to be recovered.","Example: a $12,000 commission for winning a 3-year service contract → capitalise as an {a|asset}, amortise {x|4,000} a year."],"id":"rule-1j6cxx","sect":7,"part":"Contract balances and costs"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":8,"part":"Wrap-up"},{"type":"summary","title":"Revenue on one page","rows":[["Core principle?","{i|Revenue} when (or as) control transfers, at the amount the entity expects to be entitled to."],["The five steps?","Contract → obligations → price → allocate → recognise (COPAR)."],["Contract criteria?","Approved and committed, rights identifiable, payment terms identifiable, commercial substance, collection probable. Not length or writing."],["Distinct means?","Can benefit on its own **and** separately identifiable in the contract."],["Principal or agent?","Controls the good before transfer → principal, gross. Otherwise agent, commission only."],["Warranties?","Assurance → SFRS(I) 1-37 {l|provision}. Service (extra cover) → separate obligation."],["Variable consideration?","Expected value (many outcomes) or most likely amount (two outcomes), limited by the “highly probable no significant reversal” constraint."],["Returns and rebates?","{i|Revenue} only for what you expect to keep; {l|Refund liability} for the rest, plus an {a|asset} for goods expected back."],["Other price adjustments?","Financing component (unless ≤ 1 year), non-cash at fair value, consideration payable to the customer reduces {i|revenue}."],["Allocation basis?","Relative stand-alone selling prices; discounts spread across all obligations."],["Over time if…","Customer consumes as you perform; customer controls the asset as built; or no alternative use + right to payment."],["Construction contract?","Cost-to-cost with the latest estimate; an {x|expected loss} is recognised in full immediately."],["Paid before you perform?","{l|Contract liability}. Performed but payment conditional → {a|Contract asset}. Unconditional → {a|receivable}."]],"id":"summary-1f45ng","bucket":"wrap","sect":8,"part":"Wrap-up"}],"quiz":{"cases":{"worksafe":{"name":"WorkSafe Hub","source":"Official practice paper (Q36–40 case)","text":["WorkSafe Hub Pte Ltd (WorkSafe) is an education technology company that sells accredited health and safety training packages to a range of manufacturing clients.","In January 20X2, WorkSafe entered into a contract for S$325,000 with Iron Edge Fabrication (Iron Edge) to provide the following services:","• A 12-month subscription to its online accredited health and safety training database.","• Custom onboarding and implementation of the WorkSafe training packages tailored to Iron Edge’s internal training system (estimated to take 2 months).","• 3 in-person training sessions for employees that can be scheduled any time during the 12 months.","Standalone selling prices (SSP) are as follows:","12-month subscription to health and safety training database: $225,000","Custom onboarding and implementation service: $56,250","3 in-person training sessions: $93,750","**Total**: $375,000","The contract was signed by both parties on 1 January 20X2 and payment terms were agreed being 50% upfront payment with a further 20% due on completion of the onboarding service and the remainder paid at the end of the 12-month period."]},"marina":{"name":"Marina Mobile","text":["Marina Mobile Pte Ltd (Marina) sells phones and airtime. Its financial year ends on 31 December 20X5.","On 1 January 20X5 Marina sells a bundle of a phone and a 24-month airtime plan for $1,000, paid in full that day. The phone is handed over immediately. The stand-alone selling prices are $750 for the phone and $500 for the plan.","Every phone comes with a 12-month manufacturer-standard warranty that it will work as specified. Customers cannot buy the phone without it.","Marina also sells 100 phone cases for $50 each in {a|cash} (cost $30 each), with a 30-day right of return. From experience, it expects 5 to be returned."]}},"questions":[{"id":"q1","case":"worksafe","lo":40,"type":"contract-criteria","source":"Official practice paper Q36","q":"With reference to SFRS(I) 15, Revenue from Contracts with Customers, identify which of the following is NOT a criterion for recognising a contract?","options":[{"t":"Both WorkSafe and Iron Edge have signed the contract","pit":"length-criterion","why":"Approval by both parties is a criterion; signing is one way to show it."},{"t":"The payment terms can be identified","why":"Identifiable payment terms are one of the five criteria."},{"t":"Collectability of the consideration is probable as Iron Edge have paid 50% upfront","why":"Collection being probable is a criterion; the 50% upfront payment supports it."},{"t":"WorkSafe expects to fulfil all elements of the contract with 12 months","ok":true,"why":"Finishing within 12 months is not a criterion. The contract’s length doesn’t matter."}]},{"id":"q2","case":"worksafe","lo":40,"type":"allocate","source":"Official practice paper Q37","q":"With reference to SFRS(I) 15, Revenue from Contracts with Customers, when allocating the transaction price of the contract, identify the amount WorkSafe should allocate for the in-person training sessions?","options":[{"t":"$27,083","why":"That is one session’s share (81,250 ÷ 3). The question asks for the allocation to all the training sessions."},{"t":"$31,250","pit":"ssp-not-allocated","why":"One session’s SSP. Allocate the transaction price, not the SSP, to all three sessions."},{"t":"$81,250","ok":true,"why":"325,000 × 93,750 ÷ 375,000 = 81,250. The 50,000 bundle discount is spread across all three obligations."},{"t":"$93,750","pit":"ssp-not-allocated","why":"That is the stand-alone selling price, before sharing out the bundle discount."}]},{"id":"q3","case":"worksafe","lo":40,"type":"revenue-to-date","source":"Official practice paper Q38","q":"On 31 March 20X2, WorkSafe had completed the custom onboarding and implementation service and had provided 1 in-person training session. With reference to SFRS(I) 15, Revenue from Contracts with Customers, identify how much revenue WorkSafe should recognise from Iron Edge’s contract in its accounts to date?","options":[{"t":"$81,250","pit":"upfront-all","why":"That is the whole training allocation, recognised as if all three sessions were done. Only 1 of 3 has been given, and the other obligations are ignored."},{"t":"$88,021","why":"Doesn’t match the obligations satisfied. Add onboarding (complete), one third of the training and three months of the subscription."},{"t":"$117,813","why":"Doesn’t match the obligations satisfied. Recheck each slice: onboarding in full, 1/3 of training, 3/12 of the subscription."},{"t":"$124,583","ok":true,"why":"Onboarding 48,750 (complete) + training 81,250 × 1/3 = 27,083 + subscription 195,000 × 3/12 = 48,750 → 124,583."}]},{"id":"q4","case":"worksafe","lo":40,"type":"balances","q":"On 1 January 20X2 Iron Edge pays the 50% upfront payment of $162,500. No services have yet been provided. How should WorkSafe record the receipt?","options":[{"je":[{"side":"Dr","account":"Cash","amount":162500,"el":"a"},{"side":"Cr","account":"Revenue","amount":162500,"el":"i"}],"pit":"cash-is-revenue","why":"Nothing has been delivered yet. {a|Cash received} before performance is not {i|revenue}."},{"je":[{"side":"Dr","account":"Cash","amount":162500,"el":"a"},{"side":"Cr","account":"Contract liability","amount":162500,"el":"l"}],"ok":true,"why":"WorkSafe has been paid before it performs: it owes services, so a {l|contract liability}."},{"je":[{"side":"Dr","account":"Contract asset","amount":162500,"el":"a"},{"side":"Cr","account":"Cash","amount":162500,"el":"a"}],"why":"WorkSafe receives {a|cash}; it doesn’t pay it."},{"je":[{"side":"Dr","account":"Cash","amount":162500,"el":"a"},{"side":"Cr","account":"Accounts receivable","amount":162500,"el":"a"}],"pit":"conditional-receivable","why":"There was no {a|receivable} to settle: no service had been delivered and nothing was billed for work done."}]},{"id":"q5","case":"worksafe","lo":40,"type":"timing","q":"How should WorkSafe recognise the {i|revenue} allocated to the 12-month subscription?","options":[{"t":"In full on 1 January 20X2, when the contract is signed","pit":"upfront-all","why":"Signing the contract transfers nothing. The service is given across the year."},{"t":"In full when the 12 months end and the final payment is received","pit":"wait-for-cash","why":"{i|Revenue} follows performance, not the payment schedule."},{"t":"Over the 12 months as access is provided, 16,250 a month","ok":true,"why":"Iron Edge receives and consumes the benefit as WorkSafe provides access: over time. 195,000 ÷ 12 = 16,250."},{"t":"In line with the cash: 50% now, 20% on onboarding, 30% at the end","pit":"cash-is-revenue","why":"Payment terms affect {a|contract assets} and {l|liabilities}, not when {i|revenue} is earned."}]},{"id":"q6","case":"marina","lo":40,"type":"allocate","q":"How much of the bundle price should Marina allocate to the phone?","options":[{"t":"$750","pit":"ssp-not-allocated","why":"That is the phone’s stand-alone selling price. The bundle price is lower, so the discount must be shared."},{"t":"$600","ok":true,"why":"1,000 × 750 ÷ 1,250 = 600."},{"t":"$500","why":"Equal shares ignore the stand-alone selling prices."},{"t":"$1,000","pit":"upfront-all","why":"Gives the phone the whole price and the plan nothing. The plan is a separate obligation with its own share."}]},{"id":"q7","case":"marina","lo":40,"type":"allocate","q":"Which journal entry records the bundle sale on 1 January 20X5?","options":[{"je":[{"side":"Dr","account":"Cash","amount":1000,"el":"a"},{"side":"Cr","account":"Revenue","amount":1000,"el":"i"}],"pit":"upfront-all","why":"The airtime hasn’t been provided yet. Its share is a {l|contract liability}."},{"je":[{"side":"Dr","account":"Cash","amount":1000,"el":"a"},{"side":"Cr","account":"Revenue","amount":750,"el":"i"},{"side":"Cr","account":"Contract liability","amount":250,"el":"l"}],"pit":"ssp-not-allocated","why":"Uses the phone’s SSP as its {i|revenue}, putting the whole discount on the plan."},{"je":[{"side":"Dr","account":"Cash","amount":1000,"el":"a"},{"side":"Cr","account":"Revenue","amount":600,"el":"i"},{"side":"Cr","account":"Contract liability","amount":400,"el":"l"}],"ok":true,"why":"Phone 600 is {i|revenue} on handover; plan 400 waits as a {l|contract liability}."},{"je":[{"side":"Dr","account":"Cash","amount":1000,"el":"a"},{"side":"Cr","account":"Contract liability","amount":1000,"el":"l"}],"why":"The phone was handed over, so its share is earned on day 1."}]},{"id":"q8","case":"marina","lo":40,"type":"revenue-to-date","q":"How much {i|revenue} does Marina recognise from the bundle in the year ended 31 December 20X5?","options":[{"t":"$1,000","pit":"upfront-all","why":"Recognises the whole plan upfront. Only 12 of 24 months have been provided."},{"t":"$800","ok":true,"why":"Phone 600 + plan 400 × 12/24 = 200 → 800."},{"t":"$600","why":"Leaves out the 12 months of airtime provided in 20X5."},{"t":"$950","pit":"ssp-not-allocated","why":"Uses the phone’s SSP instead of its allocated share of the price."}]},{"id":"q9","case":"marina","lo":40,"type":"warranty","q":"How should Marina account for the 12-month manufacturer-standard warranty?","options":[{"t":"As a separate performance obligation, with part of the bundle price allocated to it","pit":"assurance-po","why":"It only assures the phone works as specified and can’t be bought separately: an assurance warranty."},{"t":"As a {l|provision} for expected repair costs under SFRS(I) 1-37","ok":true,"why":"An assurance warranty is not a separate obligation; the expected cost is provided for."},{"t":"No accounting until a customer makes a claim","why":"{x|Expected warranty costs} are provided for at the time of sale."},{"t":"By deferring all the phone {i|revenue} until the warranty expires","why":"Control of the phone passed on day 1. The warranty doesn’t delay that."}]},{"id":"q10","case":"marina","lo":41,"type":"returns-rebates","q":"How much {i|revenue} should Marina recognise on the sale of the phone cases?","options":[{"t":"$5,000","pit":"returns-full","why":"Ignores the expected returns. Their price is a {l|refund liability}, not {i|revenue}."},{"t":"$4,750","ok":true,"why":"95 × $50 = 4,750; 250 {l|refund liability} for the 5 expected back."},{"t":"$1,900","why":"That is the profit on the cases, not {i|revenue}."},{"t":"Nil until the 30-day return period ends","pit":"wait-for-cash","why":"{i|Revenue} is recognised for the cases expected to be kept; the returns are estimated."}]},{"id":"q11","lo":41,"type":"variable","source":"Official practice paper Q8","q":"Vax Pte Ltd (Vax), a pharmaceutical company has been contracted to supply 150,000 units of a vaccine for a fixed price of $750,000. Vax will receive a bonus of $75,000 if all vaccines are supplied within a 3-month period. Vax uses the expected value method to measure the variable consideration and based on experience estimates that there is an 80% chance of meeting the 3-month target. With reference to SFRS(I) 15 Revenue from Contracts with Customers, identify which is the correct accounting treatment for the variable consideration of the contract?","options":[{"t":"Vax must act with prudence and only recognise the $75,000 bonus at the end of the 3-month period when the contract has been met.","pit":"wait-for-cash","why":"Prudence is not the test. Variable consideration is estimated and included now, subject to the constraint."},{"t":"Vax should recognise a transaction price of $825,000 on the contract and use this as a base to recognise revenue over the 3 months.","pit":"full-bonus-ev","why":"750,000 + the full 75,000 bonus is the most likely amount. The question says Vax uses the expected value method."},{"t":"Vax should recognise a transaction price of $810,000 on the contract and use this as a base to recognise revenue over the 3 months.","ok":true,"why":"Expected value: 80% × 75,000 = 60,000. Transaction price 750,000 + 60,000 = 810,000, recognised as the vaccines are supplied."},{"t":"Vax should only recognise the $75,000 bonus when the cash has been received in their bank account.","pit":"wait-for-cash","why":"{i|Revenue} doesn’t wait for the {a|cash}. The bonus is estimated into the price now."}]},{"id":"q12","lo":41,"type":"variable","q":"A contractor’s fixed fee is $1,000,000. It also earns a bonus: $0 if late (30% probability), $50,000 if on time (50%), $100,000 if early (20%). Using the expected value method, what is the transaction price?","options":[{"t":"$1,000,000","pit":"wait-for-cash","why":"Leaves the bonus out entirely. It is estimated and included now."},{"t":"$1,045,000","ok":true,"why":"Expected bonus 45,000; price 1,000,000 + 45,000 = 1,045,000."},{"t":"$1,050,000","why":"That is the most likely amount method, not expected value."},{"t":"$1,100,000","pit":"full-bonus-ev","why":"Takes the best case. Expected value weights every outcome."}]},{"id":"q13","lo":41,"type":"variable","q":"An entity estimates variable consideration for a contract. Which statement about the constraint is correct?","options":[{"t":"Variable consideration is included only once the {a|cash} is received","pit":"wait-for-cash","why":"{a|Cash} is not the test."},{"t":"Variable consideration is included to the extent it is highly probable that a significant reversal of {i|revenue} will not occur","ok":true,"why":"That is the constraint. Reassess it at each reporting date."},{"t":"Variable consideration is always included at its maximum possible amount","why":"Estimate it (expected value or most likely amount), then apply the constraint."},{"t":"Variable consideration is never included, for prudence","why":"Prudence isn’t the test; the constraint is."}]},{"id":"q14","lo":40,"type":"principal-agent","q":"An online platform sells concert tickets on behalf of promoters, who set the prices and run the concerts. The platform never holds unsold tickets. Customers paid $400,000 for tickets this month; the platform keeps 12%. What {i|revenue} does the platform recognise?","options":[{"t":"$400,000","pit":"gross-agent","why":"Gross {i|revenue} is for a principal. The platform never controls the tickets."},{"t":"$48,000","ok":true,"why":"Agent: {i|revenue} is its commission, 400,000 × 12% = 48,000."},{"t":"$352,000","why":"That is the amount passed to the promoters."},{"t":"Nil until the concerts take place","why":"The agent’s service, arranging the sale, is complete when the ticket is sold."}]},{"id":"q15","lo":40,"type":"distinct-po","q":"A software company sells a licence together with installation services. Which fact would mean the installation is **not** a separate performance obligation?","options":[{"t":"Other IT firms also offer the installation service","why":"That shows the customer could benefit from it with readily available resources: a sign it **is** distinct."},{"t":"The installation significantly customises and modifies the software","ok":true,"why":"Then licence and installation are highly interrelated: not separately identifiable, so they are combined."},{"t":"The installation is invoiced on a separate line","why":"Invoice presentation doesn’t decide it; the two-part distinct test does."},{"t":"The installation takes less than a week","why":"Duration is irrelevant."}]},{"id":"q16","lo":40,"type":"timing","q":"Which of the following is a criterion for recognising revenue **over time**?","options":[{"t":"The customer has paid a deposit before work starts","pit":"cash-is-revenue","why":"A deposit creates a {l|contract liability}; it says nothing about how control transfers."},{"t":"The contract lasts more than 12 months","pit":"length-criterion","why":"Length doesn’t decide it. A long contract for a standard machine delivered at the end is point in time."},{"t":"The entity’s work creates an asset with no alternative use, and it has an enforceable right to payment for work done to date","ok":true,"why":"One of the three over-time criteria (both halves needed)."},{"t":"The customer has legal title and physical possession of the asset","why":"Those are indicators that control has passed at a **point in time**."}]},{"id":"q17","lo":42,"type":"construction","q":"A contract has a price of $6,000,000. Year 1: costs $1,500,000, estimated costs to complete $3,500,000. Year 2: costs to date $3,600,000, estimated costs to complete $1,200,000. Using cost-to-cost, what {i|revenue} is recognised in year 2?","options":[{"t":"$4,500,000","why":"That is {i|cumulative revenue to date}. Deduct year 1’s {i|revenue}."},{"t":"$2,700,000","ok":true,"why":"Total cost 4,800,000; progress 75%; {i|revenue to date} 4,500,000 − year 1 1,800,000 = 2,700,000."},{"t":"$2,520,000","pit":"original-estimate","why":"Measures progress against the original total cost of 5,000,000. Use the latest estimate."},{"t":"$2,100,000","why":"That is year 2’s {x|costs}. {i|Revenue} is the price × progress, not {x|costs incurred}."}]},{"id":"q18","lo":42,"type":"onerous","q":"A contract has a price of $3,000,000. At the end of year 1, costs to date are $1,000,000 and estimated costs to complete are $2,500,000. What is the total effect on year 1 profit or loss?","options":[{"t":"A loss of $142,857","pit":"spread-loss","why":"Recognises only the share of the {x|loss} for work done. The whole {x|expected loss} is recognised now."},{"t":"A loss of $500,000","ok":true,"why":"Total cost 3,500,000 > price 3,000,000: recognise the whole 500,000 {x|loss} ({i|revenue} 857,143 − {x|costs} 1,000,000 − {x|provision charge} 357,143)."},{"t":"Nil, as the contract is incomplete","pit":"spread-loss","why":"An {x|expected loss} is recognised as soon as it is expected."},{"t":"A loss of $1,000,000","why":"Ignores the {i|revenue} earned on progress."}]},{"id":"q19","lo":40,"type":"balances","q":"An entity has delivered the first of two products under a contract. It is entitled to payment only when the second product is delivered. How is its right to consideration for the first product presented?","options":[{"t":"As a {a|trade receivable}","pit":"conditional-receivable","why":"The right is conditional on delivering the second product, not just on time passing."},{"t":"As a {a|contract asset}","ok":true,"why":"A conditional right to payment for performance already given."},{"t":"As a {l|contract liability}","why":"A {l|contract liability} arises when the customer pays before the entity performs."},{"t":"Not recognised until both products are delivered","why":"The first product’s {i|revenue} is earned when it is delivered; the right to payment is a {a|contract asset}."}]},{"id":"q20","lo":41,"type":"price-other","q":"A drinks maker sells $500,000 of products to a supermarket and pays the supermarket a $20,000 fee to stock them, receiving nothing distinct in return. What {i|revenue} does the drinks maker recognise?","options":[{"t":"$500,000, with a $20,000 {x|marketing expense}","pit":"payable-expense","why":"No distinct service is received, so the fee reduces the transaction price."},{"t":"$480,000","ok":true,"why":"Consideration payable to a customer reduces {i|revenue}: 500,000 − 20,000 = 480,000."},{"t":"$520,000","why":"The fee is paid by the drinks maker, not received."},{"t":"$500,000, with the fee capitalised as a {a|contract cost asset}","why":"It is not an incremental cost of obtaining a contract; it is a price reduction."}]}]},"exam":{"cases":{"changi":{"name":"Changi Build","text":["Changi Build Pte Ltd (Changi) has a 31 December year end. On 1 January 20X1 it signed a 3-year contract to build a logistics hub on the customer’s land for a fixed price of $20,000,000. Changi measures progress using costs incurred to date as a proportion of estimated total costs.","**20X1:** {x|costs incurred} $4,500,000; estimated costs to complete $13,500,000. Changi billed the customer $4,000,000 in 20X1.","**20X2:** {x|costs incurred in the year} $10,200,000. Because of a sharp rise in steel prices, the estimated costs to complete at 31 December 20X2 are $6,300,000. Cumulative billings at 31 December 20X2 are $15,000,000."]},"orchid":{"name":"Orchid Software","text":["Orchid Software Pte Ltd (Orchid) has a 31 December year end.","On 1 December 20X4 Orchid signed a contract with a hospital for a fixed fee of $480,000, plus a bonus of $60,000 if the system goes live by 31 March 20X5. The hospital paid 50% of the fixed fee on signing. Orchid will deliver:","(a) a software licence, delivered on 1 January 20X5 (stand-alone selling price $240,000);","(b) hosting and support for 2 years from 1 January 20X5 (stand-alone selling price $240,000);","(c) standard installation, which several other firms also offer and which does not modify the software, completed in February 20X5 (stand-alone selling price $120,000).","There are only two possible outcomes for the bonus. From its track record, Orchid assesses a 90% chance of going live on time and concludes that including the bonus is highly probable not to result in a significant reversal. The system went live on 15 March 20X5."]}},"questions":[{"id":"x1","case":"changi","lo":42,"type":"construction","q":"What {i|revenue} should Changi recognise for 20X1?","options":[{"t":"$4,000,000","pit":"cash-is-revenue","why":"That is the amount billed. {i|Revenue} follows progress, not billing."},{"t":"$4,500,000","why":"{i|Revenue} only equals {x|costs} when progress can’t be measured reasonably. Here it can."},{"t":"$5,000,000","ok":true,"why":"4,500,000 ÷ 18,000,000 = 25%; 20,000,000 × 25% = 5,000,000."},{"t":"$6,666,667","why":"Divides by the costs to complete instead of the estimated total costs."}]},{"id":"x2","case":"changi","lo":42,"type":"balances","q":"What contract balance does Changi present at 31 December 20X1?","options":[{"t":"{l|Contract liability} $1,000,000","why":"A {l|contract liability} arises when billings exceed {i|revenue}. Here {i|revenue} is higher."},{"t":"{a|Contract asset} $1,000,000","ok":true,"why":"{i|Revenue} 5,000,000 − billings 4,000,000 = 1,000,000: earned but not yet billed."},{"t":"{a|Receivable} $5,000,000","pit":"conditional-receivable","why":"Only billed amounts can be {a|receivables}. The unbilled part is a {a|contract asset}."},{"t":"{a|Contract asset} $500,000","why":"That is the profit for 20X1, not a contract balance."}]},{"id":"x3","case":"changi","lo":42,"type":"construction","q":"What {i|revenue} should Changi recognise for 20X2?","options":[{"t":"$14,000,000","why":"That is {i|cumulative revenue} to the end of 20X2. Deduct 20X1’s {i|revenue}."},{"t":"$9,000,000","ok":true,"why":"Total cost 14,700,000 + 6,300,000 = 21,000,000; progress 70%; {i|revenue to date} 14,000,000 − 5,000,000 = 9,000,000."},{"t":"$11,333,333","pit":"original-estimate","why":"Measures progress against the original 18,000,000 total. Use the latest estimate, 21,000,000."},{"t":"$11,000,000","pit":"cash-is-revenue","why":"That is 20X2 billing, not {i|revenue}."}]},{"id":"x4","case":"changi","lo":42,"type":"onerous","q":"What is the total effect of the contract on Changi’s profit or loss for 20X2?","options":[{"t":"A loss of $1,200,000","pit":"spread-loss","why":"{i|Revenue} − {x|costs} for the year only. The rest of the {x|expected loss} must be provided for now."},{"t":"A loss of $1,000,000","why":"That is the {x|loss} on the whole contract. 20X1 already booked a profit, which 20X2 must reverse too."},{"t":"A loss of $1,500,000","ok":true,"why":"{i|Revenue} 9,000,000 − {x|costs} 10,200,000 − {x|provision charge} 300,000 = (1,500,000). With 20X1’s 500,000 profit, the cumulative result is the whole (1,000,000) {x|loss}."},{"t":"A loss of $1,300,000","why":"Double counts the {l|provision} on top of the {x|total loss}."}]},{"id":"x5","case":"changi","lo":42,"type":"onerous","q":"Which journal entry records the {l|provision} for the remaining {x|loss} at 31 December 20X2?","options":[{"je":[{"side":"Dr","account":"Loss on onerous contract","amount":1000000,"el":"x"},{"side":"Cr","account":"Provision for onerous contract","amount":1000000,"el":"l"}],"why":"Provides the whole 1,000,000 {x|loss}, but 700,000 of it is already in {i|revenue} − {x|costs to date}."},{"je":[{"side":"Dr","account":"Loss on onerous contract","amount":300000,"el":"x"},{"side":"Cr","account":"Provision for onerous contract","amount":300000,"el":"l"}],"ok":true,"why":"1,000,000 − (14,700,000 − 14,000,000) = 300,000: the part of the {x|loss} on work still to be done."},{"je":[{"side":"Dr","account":"Revenue","amount":300000,"el":"i"},{"side":"Cr","account":"Contract asset","amount":300000,"el":"a"}],"why":"The {x|expected loss} is a {l|provision} under SFRS(I) 1-37, not a reduction of {i|revenue}."},{"t":"No entry: the {x|loss} is recognised as the remaining work is performed in 20X3","pit":"spread-loss","why":"An {x|expected loss} on an onerous contract is recognised in full immediately."}]},{"id":"x6","case":"orchid","lo":41,"type":"variable","q":"What is the transaction price of Orchid’s contract?","options":[{"t":"$480,000","pit":"wait-for-cash","why":"Leaves out the bonus, but including it is highly probable not to reverse."},{"t":"$534,000","pit":"full-bonus-ev","why":"Expected value (90% × 60,000). With only two outcomes, the most likely amount predicts better: a bonus of 54,000 can’t actually happen."},{"t":"$540,000","ok":true,"why":"Two outcomes → most likely amount: the full 60,000 bonus. 480,000 + 60,000 = 540,000."},{"t":"$600,000","pit":"ssp-not-allocated","why":"That is the total of the stand-alone selling prices, not the price the hospital pays."}]},{"id":"x7","case":"orchid","lo":40,"type":"allocate","q":"How much of the transaction price is allocated to the software licence?","options":[{"t":"$240,000","pit":"ssp-not-allocated","why":"That is the licence’s SSP. The contract is priced below the SSP total, so the discount is shared."},{"t":"$192,000","why":"Allocates only the fixed fee. The bonus is part of the transaction price too."},{"t":"$216,000","ok":true,"why":"540,000 × 240,000 ÷ 600,000 = 216,000."},{"t":"$180,000","why":"Equal thirds ignore the stand-alone selling prices."}]},{"id":"x8","case":"orchid","lo":40,"type":"revenue-to-date","q":"How much {i|revenue} should Orchid recognise in the year ended 31 December 20X5?","options":[{"t":"$540,000","pit":"upfront-all","why":"Recognises the second year of hosting and support early."},{"t":"$432,000","ok":true,"why":"Licence 216,000 + installation 108,000 + one year of support 216,000 ÷ 2 = 108,000 → 432,000."},{"t":"$324,000","why":"Leaves out the year of hosting and support already provided."},{"t":"$384,000","pit":"wait-for-cash","why":"Uses the fixed fee only, leaving the bonus out of the price."}]},{"id":"x9","case":"orchid","lo":40,"type":"balances","q":"How does Orchid present the hospital’s payment in its statement of financial position at 31 December 20X4?","options":[{"t":"{i|Revenue} of $240,000 in 20X4 profit or loss","pit":"cash-is-revenue","why":"Nothing was delivered in 20X4. {a|Cash received} before performance is not {i|revenue}."},{"t":"{l|Contract liability} of $240,000","ok":true,"why":"50% × 480,000 = 240,000 received before any performance: Orchid owes the goods and services."},{"t":"{a|Contract asset} of $240,000","why":"A {a|contract asset} is for performance given before payment. This is the reverse."},{"t":"{a|Receivable} of $240,000 and {l|contract liability} of $480,000","pit":"conditional-receivable","why":"The rest of the fee isn’t yet unconditionally due; no performance has happened."}]},{"id":"x10","case":"orchid","lo":41,"type":"variable","q":"Suppose instead that Orchid had assessed only a 40% chance of going live on time. What transaction price should it use at contract inception?","options":[{"t":"$480,000","ok":true,"why":"Two outcomes, and “no bonus” (60%) is the most likely. Including the bonus would not be highly probable to avoid a significant reversal."},{"t":"$504,000","pit":"full-bonus-ev","why":"Expected value suits many outcomes; with two outcomes use the most likely amount, and the constraint also bites."},{"t":"$540,000","why":"The bonus is now unlikely. Including it risks a significant reversal."},{"t":"Nil until the go-live date is known","why":"The fixed fee is certain. Only the bonus is excluded."}]},{"id":"x11","lo":40,"type":"principal-agent","q":"A travel agency sells airline tickets for $2,000,000 in a year. The airlines set the fares, operate the flights and deal with cancellations; the agency holds no tickets of its own and keeps a 8% commission. Which is correct for the agency?","options":[{"t":"{i|Revenue} $2,000,000; {x|cost of sales} $1,840,000","pit":"gross-agent","why":"Gross presentation is for a principal. The agency never controls the tickets."},{"t":"{i|Revenue} $160,000","ok":true,"why":"Agent: {i|revenue} is the commission, 2,000,000 × 8% = 160,000."},{"t":"{i|Revenue} $2,000,000; {x|commission expense} $160,000","pit":"gross-agent","why":"Treats the agency as principal and its own commission as a {x|cost}."},{"t":"{i|Revenue} recognised only when each flight departs","why":"The agency’s service (arranging the sale) is complete when the ticket is issued."}]},{"id":"x12","lo":41,"type":"price-other","q":"On 1 January 20X1 an entity sells equipment, with control passing that day. The customer will pay $1,210,000 on 31 December 20X2. The appropriate discount rate is 10%. What does the entity recognise in 20X1?","options":[{"t":"{i|Revenue} $1,210,000","pit":"ignore-financing","why":"Payment is two years after delivery: a significant financing component. {i|Revenue} is the cash price."},{"t":"{i|Revenue} $1,000,000 and {i|interest income} $100,000","ok":true,"why":"PV = 1,210,000 ÷ 1.1² = 1,000,000 {i|revenue} on delivery; {i|interest} 1,000,000 × 10% = 100,000 in 20X1."},{"t":"{i|Revenue} $1,000,000 only; {i|interest} recognised when the {a|cash} is received","why":"{i|Interest} accrues over time, so 20X1 has a year of it."},{"t":"Nothing until the {a|cash} is received in 20X2","pit":"wait-for-cash","why":"Control passed on 1 January 20X1, so {i|revenue} is recognised then."}]},{"id":"x13","lo":41,"type":"returns-rebates","q":"A retailer sells 200 units for $80 each (cost $50 each) with a right of return, and expects 6% to be returned. Which entry records the **cost** side of the sale?","options":[{"je":[{"side":"Dr","account":"Cost of sales","amount":10000,"el":"x"},{"side":"Cr","account":"Inventory","amount":10000,"el":"a"}],"pit":"returns-full","why":"Expenses the cost of all units as {x|cost of sales}, including those expected back."},{"je":[{"side":"Dr","account":"Cost of sales","amount":9400,"el":"x"},{"side":"Dr","account":"Right to recover returned goods","amount":600,"el":"a"},{"side":"Cr","account":"Inventory","amount":10000,"el":"a"}],"ok":true,"why":"188 × 50 = 9,400 {x|cost of sales}; 12 × 50 = 600 {a|asset} for the goods expected back."},{"je":[{"side":"Dr","account":"Cost of sales","amount":9400,"el":"x"},{"side":"Dr","account":"Refund liability","amount":600,"el":"l"},{"side":"Cr","account":"Inventory","amount":10000,"el":"a"}],"why":"The {l|refund liability} is for the {a|cash} to be refunded, at selling price; the goods expected back are an {a|asset}."},{"je":[{"side":"Dr","account":"Cost of sales","amount":9400,"el":"x"},{"side":"Cr","account":"Inventory","amount":9400,"el":"a"}],"why":"All the units left the shelves, so {a|inventory} falls by the cost of all of them."}]},{"id":"x14","lo":40,"type":"warranty","q":"A retailer sells a TV with a 3-year extended warranty for a total of $1,800. The extended warranty covers accidental damage and is also sold separately for $250; the TV alone sells for $1,750. How much {i|revenue} is recognised on the day of sale?","options":[{"t":"$1,800, with a {l|warranty provision} for expected claims","pit":"assurance-po","why":"Treats a service warranty as an assurance warranty. Extra cover sold separately is a performance obligation."},{"t":"$1,575","ok":true,"why":"Allocate by SSP: TV 1,800 × 1,750 ÷ 2,000 = 1,575 now; warranty 225 over 3 years."},{"t":"$1,550","pit":"discount-one-item","why":"Puts the whole bundle discount on the TV. Spread it by relative SSP."},{"t":"$1,750","pit":"ssp-not-allocated","why":"Uses the TV’s SSP, which leaves nothing for the warranty."}]},{"id":"x15","lo":41,"type":"returns-rebates","q":"A supplier gives a customer a 5% rebate on all purchases in the year if they exceed $1,000,000. It is highly probable the threshold will be met. First-quarter sales are $300,000 on credit. Which entry records them?","options":[{"je":[{"side":"Dr","account":"Accounts receivable","amount":300000,"el":"a"},{"side":"Cr","account":"Revenue","amount":300000,"el":"i"}],"pit":"returns-full","why":"Ignores the expected rebate. {i|Revenue} is what the supplier expects to keep."},{"je":[{"side":"Dr","account":"Accounts receivable","amount":300000,"el":"a"},{"side":"Cr","account":"Revenue","amount":285000,"el":"i"},{"side":"Cr","account":"Refund liability","amount":15000,"el":"l"}],"ok":true,"why":"5% × 300,000 = 15,000 expected rebate: a {l|refund liability}; {i|revenue} 285,000."},{"je":[{"side":"Dr","account":"Accounts receivable","amount":300000,"el":"a"},{"side":"Dr","account":"Marketing expense","amount":15000,"el":"x"},{"side":"Cr","account":"Revenue","amount":300000,"el":"i"},{"side":"Cr","account":"Refund liability","amount":15000,"el":"l"}],"pit":"payable-expense","why":"A rebate reduces {i|revenue}; it isn’t a {x|marketing expense}."},{"t":"Record full {i|revenue} now and reduce it at year end if the threshold is met","pit":"wait-for-cash","why":"The rebate is highly probable, so it is estimated now."}]}]},"prepared":true},{"id":"borrowing-costs","code":"C2","title":"Borrowing Costs","subtitle":"SFRS(I) 1-23 · interest on qualifying assets","los":{"43":"Qualifying assets","44":"Accounting for borrowing costs on qualifying assets"},"accounts":[{"name":"Building under construction","el":"a"},{"name":"Asset under construction","el":"a"},{"name":"Cash","el":"a"},{"name":"Bank loan","el":"l"},{"name":"Interest payable","el":"l"},{"name":"Interest expense","el":"x"},{"name":"Investment income","el":"i"},{"name":"Depreciation expense","el":"x"},{"name":"Retained earnings","el":"e"}],"map":{"classify":{"label":"Qualifying asset or not"},"recognise":{"label":"When capitalisation commences or is suspended","star":"Interest enters cost only inside the window: start, suspend, stop"},"initial":{"label":"Specific loan net of income; general pool × rate","star":"Specific: actual less investment income. General: weighted rate × weighted spend, capped"},"subsequent":{"label":"n/a: the asset’s own standard takes over","off":true},"derecognise":{"label":"Cease when substantially complete"},"present":{"label":"Disclose amount capitalised and the rate"}},"preamble":["Welcome to the shortest stop on the tour, and one with a single big idea: when a company borrows to **build** something that takes ages, the interest is part of what the thing **cost**. So it goes onto the balance sheet with the bricks, instead of into profit or loss.","This chapter isn’t really about a new kind of asset. It is a plug-in that bolts onto {a|PPE}, {a|investment property}, {a|intangibles} and {a|inventory}. We still follow our six-step map, just loosely:","1. **Classify**: is the asset a **qualifying asset** (takes a substantial period to get ready)? If not, the interest is just an {x|expense}, end of story.","2. **Recognise**: when does interest start flowing into the asset, and when does it pause? ★ special","3. **Initial measurement**: how much? A specific loan, or a share of a general pool at a weighted rate. ★ special","4. **Derecognise** (our loose name for the end of the line): when the asset is substantially complete, the tap turns off.","5. **Present**: the capitalised interest hides inside the asset’s cost, so the notes say how much and at what rate.","Subsequent measurement is greyed out: once the asset is ready, its own standard takes over and the capitalised interest is simply depreciated with everything else.","+ The big idea: for a qualifying asset, capitalisation is **required**, not a choice, and only for the time the asset is actually being got ready."],"intros":{"classify":"First stop: does this asset even qualify? Only a **qualifying asset**, one that necessarily takes a substantial period to get ready, gets interest in its cost. Ready-to-use kit, {a|financial assets} and mass-produced stock don’t. We also pin down what counts as a \"borrowing cost\" and the core rule: capitalise, no choice. Quick and painless.","recognise":"We know the asset qualifies; now *when* does interest flow into it? ★ This is the special part: capitalisation needs all three of spending, borrowing costs and actual work before it starts, and it pauses during long, unplanned halts. Borrowing early, or a site gone quiet over a dispute, means expense.","initial":"The window is open, so time to put a number on it. ★ Special again, and the one the exam loves to calculate: a **specific** {l|loan} gives its actual interest less what the idle {a|cash} earned; a **general** {l|pool} gives a weighted rate × time-weighted spending, capped at what was actually paid. Bring a calculator and a little patience.","derecognise":"We’ve filled the asset with interest; now we turn off the tap. Fairly vanilla: capitalisation **ceases** when substantially all the work is done, part by part if the parts can be used on their own. Not at the grand opening, and not when the {l|loan} is repaid.","present":"Last stop, and short. The capitalised interest is hiding inside the {a|asset’s cost}, so the notes give it away: how much was capitalised this year, and at what rate. That’s it. Go and celebrate the shortest chapter in the book."},"pitfalls":{"optional":"Treating capitalisation as an accounting-policy choice (it is required).","capitalise-all":"Capitalising all borrowing costs, or all of a general pool, whatever they relate to.","expense-all":"Expensing borrowing costs that are directly attributable to a qualifying asset.","not-qualifying":"Capitalising into an asset that is ready when bought, a {a|financial asset} or mass-produced {a|inventory}.","whole-year":"Capitalising for the whole year (or from the day the {l|loan} is drawn) when the window is shorter.","wait-for-use":"Capitalising until the asset is first used, instead of until it is substantially complete.","no-suspend":"Carrying on capitalising through an extended halt in active development.","suspend-normal":"Suspending for a normal or necessary delay, or while technical and administrative work goes on.","no-income-deduct":"Forgetting to deduct {i|investment income} earned on unspent specific-loan funds.","simple-avg-rate":"Using a simple average of interest rates instead of a weighted capitalisation rate.","no-time-weight":"Not weighting expenditure by the time it was outstanding.","no-cap":"Capitalising more than the borrowing costs actually incurred in the period.","coupon-not-eir":"Using coupon interest instead of effective interest as the borrowing cost.","no-disclose":"Forgetting that the amount capitalised and the capitalisation rate must be disclosed."},"examTypes":[{"id":"core-principle","title":"Which statement best describes SFRS(I) 1-23? (practice Q9)","pitfall":"Thinking capitalisation is optional, or applies to all borrowing costs.","see":"classify"},{"id":"qualifying","title":"Is this a qualifying asset? (practice Q49)","pitfall":"Capitalising into ready-to-use equipment, a {a|financial asset} or mass-produced stock.","see":"classify"},{"id":"what-is-bc","title":"What counts as a borrowing cost?","pitfall":"Using the coupon instead of effective interest; counting {e|dividends} on ordinary shares.","see":"classify"},{"id":"period","title":"How should borrowing costs for the year be accounted for? (practice Q16)","pitfall":"Capitalising the whole year when the asset was ready part-way through, or starting from the loan date.","see":"recognise"},{"id":"suspension","title":"Work stopped for a while. What happens?","pitfall":"Suspending for a normal or necessary delay, or not suspending for a long dispute.","see":"recognise"},{"id":"specific","title":"How much is capitalised on a specific loan?","pitfall":"Forgetting to deduct {i|investment income} on the unspent funds.","see":"initial"},{"id":"general","title":"What is the capitalisation rate, and how much is capitalised?","pitfall":"A simple average rate, no time-weighting, or no cap.","see":"initial"},{"id":"cessation","title":"When does capitalisation stop, and what happens after?","pitfall":"Waiting until the asset is first used, or the loan repaid.","see":"derecognise"},{"id":"disclosure","title":"What must be disclosed?","pitfall":"Forgetting the amount capitalised and the capitalisation rate.","see":"present"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":43,"title":"Borrowing costs, the Socratic way","body":["A short chapter with one big idea: when a company borrows to **build** something that takes a long time, the interest is part of what the thing **cost**.","Each idea starts with a question. Think it through, then reveal the answer. Account names are coloured by element; tap **Legend** at the top any time.","At the end: a chapter quiz in exam style (with official practice-paper questions), then a harder exam."],"id":"intro-e4gzk0","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-classify","bucket":"classify","sect":1,"part":"Classify"},{"type":"think","bucket":"classify","lo":43,"scenario":"Four companies each borrow money this year. (1) Jurong Steel borrows to build a new rolling mill that will take two years. (2) A lab borrows to buy ready-to-use testing equipment, plugged in the day it arrives. (3) A distillery borrows to fund whisky that must mature in casks for 10 years. (4) A drinks maker borrows to fund its working capital while it churns out millions of cans a week.","prompt":"In which of these would it be fair to say the interest is really part of what the asset **cost**?","answer":["Ask: does the money sit **tied up in the asset** for a long time before the asset can do its job?","- **(1) The mill: yes.** Two years of interest is part of the price of having a working mill, just like the steel and the labour.","- **(3) The whisky: yes.** {a|Inventory} that takes years to mature ties up the money too.","- **(2) The lab equipment: no.** It is ready the day it is bought, so there is no \"getting ready\" period to finance.","- **(4) The cans: no.** Made over a short period, in huge numbers, again and again.","Cases (1) and (3) are **{a|qualifying assets}**. Short version: if it takes *quite a while* to be ready, the interest moves into the cost."],"id":"think-m7aixq","sect":1,"part":"Classify"},{"type":"rule","bucket":"classify","lo":43,"title":"What is a qualifying asset?","body":["The think page sorted four assets by gut feel. Here is the definition behind it, because everything else in this chapter only applies to a qualifying asset.","A **qualifying asset** is an asset that **necessarily takes a substantial period of time** to get ready for its intended use or sale.","Usually qualifying:","- {a|buildings and plants under construction} (factories, power stations, a high-security vault)","- {a|investment property} being built","- {a|intangibles} that take a long time to develop","- {a|inventories} that take a long time to mature or build (whisky, ships built to order)","Not qualifying:","- assets **ready for use or sale when acquired** (ready-to-use lab equipment)","- **{a|financial assets}**","- {a|inventories} made over a **short period**","- {a|inventories} made in **large quantities on a repetitive basis**: the entity need not apply the standard to them","+ Memory hook: **Q for \"Quite a while\"**. If the asset isn’t ready for a substantial period, it qualifies."],"id":"rule-kdqryg","sect":1,"part":"Classify"},{"type":"diagram","bucket":"classify","lo":43,"title":"Is it a qualifying asset?","intro":"One question does most of the work: does getting the asset ready **necessarily** take a substantial period? Then a couple of carve-outs.","notes":{"start":"We only care about assets with borrowing behind them. No borrowing, no borrowing costs.","fin":"{a|Financial assets} (shares, bonds, receivables) are never qualifying assets.","sub":"The key word is **necessarily**: the asset by its nature takes a long time to get ready for use or sale.","rep":"{a|Inventory} churned out in large quantities, over and over: the standard lets the entity skip it.","no1":"Interest on money borrowed to buy {a|financial assets} is simply expensed.","no2":"Ready-to-use equipment, or {a|stock} made over a short period: nothing to \"get ready\", so expense the interest.","no3":"The entity **need not** apply SFRS(I) 1-23 to mass-produced {a|inventory}, even if it takes a while.","yes":"Directly attributable borrowing costs **must** be capitalised into its {a|cost}."},"walk":[{"nodes":["start","fin","no1"],"text":"Rule out {a|financial assets} first: they never qualify."},{"nodes":["sub","no2"],"text":"The big question: does it **necessarily take a substantial period** to get ready? Ready-to-use equipment fails here."},{"nodes":["rep","no3"],"text":"Long-to-make {a|inventory} qualifies, unless it is churned out in bulk on a repetitive basis."},{"nodes":["yes"],"text":"What is left is a **qualifying asset**: its borrowing costs go into its {a|cost}."}],"caption":"Q for \"Quite a while\".","id":"diagram-1norn5","sect":1,"part":"Classify","svg":"\u003csvg width=\"100%\" style=\"min-width:564px\" role=\"img\"\n viewBox=\"0.00 0.00 513.00 393.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 381.75)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-381.75 501.84,-381.75 501.84,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>start\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M408.42,-370.95C408.42,-370.95 272.64,-370.95 272.64,-370.95 266.64,-370.95 260.64,-364.95 260.64,-358.95 260.64,-358.95 260.64,-346.95 260.64,-346.95 260.64,-340.95 266.64,-334.95 272.64,-334.95 272.64,-334.95 408.42,-334.95 408.42,-334.95 414.42,-334.95 420.42,-340.95 420.42,-346.95 420.42,-346.95 420.42,-358.95 420.42,-358.95 420.42,-364.95 414.42,-370.95 408.42,-370.95\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"269.28\" y=\"-349.5\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Asset funded by borrowing\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>fin\u003c/title>\n\u003cpolygon fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" points=\"340.53,-307.95 252.47,-289.95 340.53,-271.95 428.59,-289.95 340.53,-307.95\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"298.15\" y=\"-286.5\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Financial asset?\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge1\" class=\"edge\">\n\u003ctitle>start&#45;&gt;fin\u003c/title>\n\u003c