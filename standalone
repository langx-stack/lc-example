=\"11.00\" fill=\"white\">Users\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"218.14\" y=\"-14.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"white\"> &#160;\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"224.14\" y=\"-14.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"white\">investors · lenders · other creditors decide\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>aud&#45;&gt;users\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M290.51,-58.59C290.51,-53.84 290.51,-48.6 290.51,-43.53\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"292.62,-43.82 290.52,-37.82 288.42,-43.82 292.62,-43.82\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>acra\u003c/title>\n\u003cpath fill=\"#ffe4e6\" stroke=\"#be123c\" stroke-width=\"1.2\" d=\"M93.03,-155.64C93.03,-155.64 12,-155.64 12,-155.64 6,-155.64 0,-149.64 0,-143.64 0,-143.64 0,-130 0,-130 0,-124 6,-118 12,-118 12,-118 93.03,-118 93.03,-118 99.03,-118 105.03,-124 105.03,-130 105.03,-130 105.03,-143.64 105.03,-143.64 105.03,-149.64 99.03,-155.64 93.03,-155.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"36.01\" y=\"-141.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">ACRA\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-132.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">(SGX / MAS for listed)\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"12.39\" y=\"-123.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">enforce compliance\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>acra&#45;&gt;dir\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#be123c\" stroke-dasharray=\"5,2\" d=\"M105.33,-136.82C128.59,-136.82 156.79,-136.82 184.1,-136.82\"/>\n\u003cpolygon fill=\"#be123c\" stroke=\"#be123c\" points=\"183.88,-138.92 189.88,-136.82 183.88,-134.72 183.88,-138.92\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"148.45\" y=\"-141.57\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> monitors \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"think","bucket":"roles","lo":3,"scenario":"An MCQ offers three bodies for “sets the accounting standards Singapore companies must follow”: the IASB, the ASC and ACRA.","prompt":"Which one, and what do the other two do?","answer":["The **ASC**. It **prescribes** the accounting standards for Singapore companies, charities, co-operative societies and societies.","The **IASB** writes IFRS, which the ASC then adopts as SFRS(I). The IASB has no legal power in Singapore by itself.","**ACRA**, as regulator, **enforces** compliance. Since April 2022 the ASC sits within ACRA, which is exactly why exam setters enjoy mixing them up."],"id":"think-6h56b2","sect":5,"part":"Who does what, and the ASC"},{"type":"rule","bucket":"roles","lo":3,"title":"The mandate of the ASC","body":["Of the three bodies, the ASC is the one that sets the standards Singapore companies follow. Here is what its mandate covers.","- Set up in **2007** under the **Accounting Standards Act**. Since **April 2022** it sits within **ACRA** as the **Accounting Standards Committee** (the study guide still says “Council”). Same body, same initials.","- **Mandate:** prescribe the accounting standards that **companies, charities, co-operative societies and societies** must follow in Singapore.","- **How:** adopts IFRS from the IASB, largely **word for word**, as **SFRS(I)**. Also issues **FRS** (non-listed companies), **SFRS for Small Entities** and the **Charities Accounting Standard**.","- Keeps Singapore standards **in line with international standards**, and takes part in IASB consultations (comment letters, Singapore feedback).","What it does **not** do:","1. set standards for **statutory boards** (SB-FRS, see ASSB)","2. **enforce** compliance (ACRA’s surveillance does)","3. set **auditing** standards","! ASC sets, ACRA enforces, IASB writes IFRS. An MCQ may offer all three."],"id":"rule-1iar7m","sect":5,"part":"Who does what, and the ASC"},{"type":"mcq","bucket":"roles","lo":3,"q":"Which of the following falls within the mandate of the Accounting Standards Committee (ASC) of Singapore?","options":[{"t":"Taking action against companies whose financial statements breach the standards","why":"Enforcement is ACRA’s financial reporting surveillance, not the ASC."},{"t":"Prescribing the accounting standards for companies, charities, co-operative societies and societies","ok":true,"why":"That is the ASC’s mandate under the Accounting Standards Act."},{"t":"Writing International Financial Reporting Standards","why":"The IASB writes IFRS. The ASC adopts them as SFRS(I)."},{"t":"Issuing the financial reporting standards for statutory boards","why":"Statutory boards use SB-FRS (see ASSB), not ASC standards."}],"id":"mcq-5akass","sect":5,"part":"Who does what, and the ASC"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":6,"part":"Wrap-up"},{"type":"summary","lo":3,"title":"A1 on one page","rows":[["Why prepare FS?","To give investors, lenders and other creditors information to decide about providing resources."],["Primary users?","Existing and potential investors, lenders and other creditors."],["What do they assess?","Future net {a|cash} inflows and management’s stewardship."],["Management? Regulators?","Not primary users. Management has internal information; regulators may find FS useful, but they aren’t written for them."],["Do FS show what the entity is worth?","No. They help users estimate it."],["Creditors decide…?","Whether to lend (or give credit), and on what terms."],["Statement of cash flows?","Liquidity and solvency."],["General vs special purpose?","General: users who can’t demand tailored reports. Special: one user or purpose sets the terms."],["Charities? Statutory boards?","Charities: CAS. Statutory boards: SB-FRS (ASSB)."],["ASC mandate?","Prescribe accounting standards for companies, charities, co-operatives and societies; adopt IFRS as SFRS(I)."],["Chain of roles?","IASB writes → ASC adopts → directors prepare → auditors check → ACRA enforces → users decide."]],"id":"summary-v96n67","bucket":"wrap","sect":6,"part":"Wrap-up"}],"quiz":{"cases":{"tembusu":{"name":"Tembusu Foods","text":["Tembusu Foods Ltd (Tembusu) is a food manufacturer listed on SGX. Its financial year ends on 31 December 20X5, and its directors are finalising the financial statements.","Tembusu has a S$5 million {l|bank loan}. Under the loan agreement, the bank also requires a quarterly report of covenant ratios in a format the bank has specified.","Tembusu’s largest raw-material supplier sells to it on 60-day credit. Several fund managers are considering buying Tembusu shares.","Tembusu’s financial statements are audited by Lim & Partners, a firm of public accountants."]}},"questions":[{"id":"q1","case":"tembusu","lo":1,"type":"primary-users","q":"Which of the following are the primary users of Tembusu’s general purpose financial statements?","options":[{"t":"Tembusu’s directors and management","pit":"mgmt-primary","why":"Management has internal information and prepares the FS. It is not a primary user."},{"t":"Tembusu’s shareholders, the fund managers considering buying shares, the bank and the supplier","ok":true,"why":"Existing and potential investors, a lender and another creditor: all primary users."},{"t":"SGX, MAS and ACRA","pit":"regulator-primary","why":"Regulators may find the FS useful, but the FS are not directed at them."},{"t":"Only Tembusu’s existing shareholders","why":"Too narrow. Potential investors (the fund managers), lenders and other creditors are primary users too."}]},{"id":"q2","case":"tembusu","lo":2,"type":"gp-sp","q":"How should the quarterly covenant report that Tembusu prepares for the bank be described?","options":[{"t":"A general purpose financial report, because the bank is a primary user","pit":"gp-simple","why":"The bank is a primary user of the annual FS, but this report is in the bank’s own format: special purpose."},{"t":"A special purpose financial report","ok":true,"why":"A specific user set the format and terms in the loan agreement."},{"t":"Part of the complete set of financial statements under SFRS(I) 1-1","why":"The complete set is the five statements and notes. A covenant report is not part of it."},{"t":"A not-for-profit report, because it is not published","why":"Not-for-profit reports are those of charities and similar bodies. Being unpublished doesn’t make it one."}]},{"id":"q3","case":"tembusu","lo":2,"type":"nfp-sb","q":"Which accounting standards must Tembusu apply in its annual financial statements?","options":[{"t":"FRS, because Tembusu is a Singapore company","why":"FRS is for non-listed companies. A listed company uses SFRS(I)."},{"t":"SFRS for Small Entities","why":"A listed manufacturer is not a small entity for this purpose."},{"t":"SFRS(I), which is identical to IFRS","ok":true,"why":"Listed companies in Singapore use SFRS(I)."},{"t":"SB-FRS","pit":"sfrs-everyone","why":"SB-FRS is for statutory boards, not companies."}]},{"id":"q4","case":"tembusu","lo":2,"type":"roles","q":"Who is responsible for preparing Tembusu’s financial statements?","options":[{"t":"Lim & Partners, the auditors","pit":"auditor-prepares","why":"Auditors give an opinion on whether the FS are true and fair. They don’t prepare them."},{"t":"Tembusu’s directors and management","ok":true,"why":"Preparers are responsible for the FS, as the Companies Act requires."},{"t":"The Accounting Standards Committee","pit":"asc-enforce","why":"The ASC prescribes the standards; it doesn’t prepare anyone’s FS."},{"t":"SGX, as Tembusu is listed","why":"SGX monitors listed companies; it doesn’t prepare their FS."}]},{"id":"q5","case":"tembusu","lo":1,"type":"user-decision","q":"Which decision is Tembusu’s raw-material supplier most likely to make using Tembusu’s financial statements?","options":[{"t":"Whether to buy Tembusu shares","pit":"wrong-user-decision","why":"That is an investor’s decision."},{"t":"Whether to continue selling to Tembusu on credit, and how much","ok":true,"why":"A trade creditor decides whether, and how much, credit to give. It looks at liquidity."},{"t":"Whether to vote for Tembusu’s directors","pit":"wrong-user-decision","why":"Only shareholders vote on directors."},{"t":"Whether Tembusu’s products are good value","pit":"wrong-user-decision","why":"That is a customer’s question, and not one financial statements answer."}]},{"id":"q6","lo":1,"type":"user-decision","source":"Official practice paper Q3","q":"The main function of financial accounting is to measure business activities of a company and then communicate those measurements to decision makers for them to make decisions about the company. Which of the following best describes the decisions made by the company’s creditors using the financial information?","options":[{"t":"Deciding whether to purchase products or services","pit":"wrong-user-decision","why":"That is a customer’s decision."},{"t":"Deciding on production and expansion","pit":"wrong-user-decision","why":"That is management’s decision, made with internal information."},{"t":"Deciding whether to lend money","ok":true,"why":"Creditors (lenders, suppliers) decide whether to lend or give credit, and on what terms."},{"t":"Deciding on market share and profitability","why":"That is a management or strategy concern, not a creditor’s decision."}]},{"id":"q7","lo":1,"type":"statement-role","source":"Official practice paper Q45","q":"Harvest’s board of directors are reviewing the financial statements prior to publication. Identify which of the following best describes the role of Harvest’s statement of cash flows in financial decision-making?","options":[{"t":"Allows decision-makers to assess the level of Harvest’s gearing","pit":"cf-profit","why":"Gearing ({l|debt} against {e|equity}) is read from the statement of financial position."},{"t":"Allows decision-makers to assess liquidity and solvency of Harvest","ok":true,"why":"The statement of cash flows shows where {a|cash} came from and went: liquidity and solvency."},{"t":"Allows decision-makers to assess the profitability of Harvest","pit":"cf-profit","why":"Profitability comes from the statement of profit or loss. Profit and {a|cash} are different things."},{"t":"Allows decision-makers to assess the quality of Harvest’s equity","why":"Not the role of the statement of cash flows. Movements in {e|equity} are in the statement of changes in equity."}]},{"id":"q8","lo":1,"type":"primary-users","q":"Which statement best describes the objective of general purpose financial reporting?","options":[{"t":"To help management run the business day to day","pit":"mgmt-primary","why":"Management uses internal reports. It is not a primary user."},{"t":"To provide information useful to existing and potential investors, lenders and other creditors in deciding about providing resources to the entity","ok":true,"why":"The Conceptual Framework’s objective, almost word for word."},{"t":"To show the market value of the entity","pit":"fs-value","why":"FS are not designed to show what the entity is worth. They help users estimate it."},{"t":"To provide IRAS with the information it needs to assess tax","pit":"regulator-primary","why":"IRAS gets a tax computation, a special purpose report. GPFS aren’t directed at regulators."}]},{"id":"q9","lo":1,"type":"primary-users","q":"Which of the following is a limitation of general purpose financial reports?","options":[{"t":"They are prepared only for existing shareholders","why":"Not true: they are for existing and potential investors, lenders and other creditors."},{"t":"They cannot include any estimates","why":"The opposite: they rely heavily on estimates and judgement. That reliance is the limitation."},{"t":"They do not show the value of the entity, and they do not provide all the information users need","ok":true,"why":"Users estimate value with the help of the FS, and also look at other sources."},{"t":"They cannot be used by employees or customers","why":"Anyone may use them; they just aren’t written primarily for those groups."}]},{"id":"q10","lo":3,"type":"asc-mandate","q":"Which of the following best describes the mandate of the Accounting Standards Committee (ASC) of Singapore?","options":[{"t":"To write International Financial Reporting Standards for adoption around the world","pit":"asc-enforce","why":"That is the IASB."},{"t":"To prescribe the accounting standards that companies, charities, co-operative societies and societies in Singapore must follow","ok":true,"why":"The ASC’s mandate under the Accounting Standards Act. It adopts IFRS as SFRS(I)."},{"t":"To review companies’ financial statements and take action on breaches of the standards","pit":"asc-enforce","why":"Enforcement is ACRA’s financial reporting surveillance."},{"t":"To issue auditing standards for public accountants","why":"The ASC sets accounting standards, not auditing standards."}]},{"id":"q11","lo":2,"type":"nfp-sb","q":"Which standards does a Singapore statutory board, such as HDB, apply in preparing its financial statements?","options":[{"t":"SFRS(I), like every Singapore reporting entity","pit":"sfrs-everyone","why":"Not every entity uses SFRS(I). Statutory boards have their own standards."},{"t":"The Charities Accounting Standard","why":"CAS is for charities."},{"t":"Statutory Board Financial Reporting Standards (SB-FRS)","ok":true,"why":"SB-FRS, based closely on SFRS(I). See the ASSB website."},{"t":"SFRS for Small Entities","why":"That is an option for small companies, not statutory boards."}]},{"id":"q12","lo":1,"type":"statement-role","q":"An investor wants to know how much profit was {e|retained} in the business after this year’s {e|dividend}, and whether new {e|shares} were issued. Which statement answers this most directly?","options":[{"t":"Statement of cash flows","pit":"cf-profit","why":"It shows dividends paid and share proceeds in {a|cash} terms, but not profit or the movements in each {e|equity component}."},{"t":"Statement of profit or loss and OCI","why":"Shows profit, but dividends and share issues are transactions with owners and don’t go through it."},{"t":"Statement of changes in equity","ok":true,"why":"Shows profit, dividends and share issues for each {e|equity component}."},{"t":"Statement of financial position","why":"Shows {e|closing balances}, not the movements."}]},{"id":"q13","lo":2,"type":"gp-sp","q":"What makes a set of financial statements “general purpose”?","options":[{"t":"It is prepared by a small company using simplified rules","pit":"gp-simple","why":"General purpose has nothing to do with size or simplicity."},{"t":"It is prepared for users who cannot demand reports tailored to their own needs","ok":true,"why":"That is the defining feature."},{"t":"It is prepared for a specific user under the terms of a contract","why":"That describes a special purpose report."},{"t":"It is prepared by a not-for-profit organisation","why":"NFP reports are a separate type in the syllabus."}]}]},"exam":{"cases":{"serangoon":{"name":"Serangoon Holdings","text":["Serangoon Holdings Ltd (Serangoon) is an SGX-listed healthcare group. It controls the Serangoon Foundation, a registered charity that funds community clinics.","In 20X6 Serangoon reported a record profit. However, it spent heavily on new clinics, and its operating cash flows were negative for the year.","Serangoon is negotiating a new S$30 million {l|loan} with a bank that has not lent to it before. A newspaper article valued the group at three times its reported {e|equity}.","ACRA’s financial reporting surveillance programme reviewed Serangoon’s 20X5 financial statements and found a breach of an SFRS(I) requirement. Serangoon’s CFO told the board that “the ASC will decide on any sanction, since it sets the standards”."]}},"questions":[{"id":"x1","case":"serangoon","lo":1,"type":"primary-users","q":"Is the bank that is negotiating the new S$30 million loan a primary user of Serangoon’s general purpose financial statements?","options":[{"t":"No, because it has not lent to Serangoon yet","why":"Potential lenders are primary users, not only existing ones."},{"t":"No, because a bank can demand its own special purpose reports","why":"A bank may also ask for tailored reports, but it is still a lender using the general purpose FS. It is a primary user."},{"t":"Yes, as a potential lender deciding whether to provide resources","ok":true,"why":"The objective covers existing and potential investors, lenders and other creditors."},{"t":"Yes, but only once the loan agreement is signed","why":"It is a primary user now: a potential lender deciding whether to lend."}]},{"id":"x2","case":"serangoon","lo":2,"type":"nfp-sb","q":"Which standard may the Serangoon Foundation use for its own annual financial statements?","options":[{"t":"SFRS(I), because its parent is listed","pit":"sfrs-everyone","why":"The parent’s listing doesn’t decide the charity’s own standards. Charities can use the CAS."},{"t":"The Charities Accounting Standard (CAS) issued by the ASC","ok":true,"why":"Charities can use the CAS, which focuses on accountability for funds (restricted vs unrestricted)."},{"t":"SB-FRS","why":"SB-FRS is for statutory boards, not charities."},{"t":"Any basis the Commissioner of Charities asks for, as its reports are special purpose","pit":"gp-simple","why":"Its annual FS are for donors, members and others who can’t demand tailored reports. They are not special purpose."}]},{"id":"x3","case":"serangoon","lo":1,"type":"statement-role","q":"Which part of Serangoon’s 20X6 financial statements would best alert the bank to the risk that Serangoon may struggle to meet its {l|obligations} as they fall due?","options":[{"t":"The statement of profit or loss, which shows a record profit","pit":"cf-profit","why":"Profit is not {a|cash}. The record profit is exactly what hides the problem."},{"t":"The statement of cash flows, which shows the negative operating cash flows","ok":true,"why":"It shows liquidity and solvency: where {a|cash} came from and went."},{"t":"The statement of changes in equity","why":"Shows movements in the {e|owners’ stake}, not the ability to pay {l|obligations}."},{"t":"The auditor’s report","pit":"auditor-prepares","why":"The auditor’s opinion is on whether the FS are true and fair, not on liquidity."}]},{"id":"x4","case":"serangoon","lo":1,"type":"primary-users","q":"How should the newspaper’s valuation of three times reported {e|equity} be understood?","options":[{"t":"The financial statements must be wrong, as they should show what the group is worth","pit":"fs-value","why":"FS are not designed to show the value of the entity."},{"t":"Serangoon should restate its {e|equity} to the newspaper’s valuation","pit":"fs-value","why":"{e|Equity} is {a|assets} minus {l|liabilities} as measured under the standards, not a market valuation."},{"t":"Financial statements are not designed to show the value of the entity; they provide information to help users estimate it","ok":true,"why":"One of the stated limits of general purpose financial reports."},{"t":"The difference proves the FS are special purpose","pit":"gp-simple","why":"Unrelated. Serangoon’s FS are general purpose."}]},{"id":"x5","case":"serangoon","lo":3,"type":"asc-mandate","q":"Which comment on the CFO’s statement to the board is correct?","options":[{"t":"The CFO is right: the ASC sets and enforces accounting standards","pit":"asc-enforce","why":"The ASC prescribes standards. It doesn’t enforce them."},{"t":"The CFO is wrong: enforcement is a matter for ACRA (and SGX and MAS for listed entities); the ASC prescribes the standards","ok":true,"why":"ASC sets, ACRA enforces."},{"t":"The CFO is wrong: the IASB decides on breaches of IFRS-based standards anywhere","pit":"asc-enforce","why":"The IASB writes IFRS. It has no enforcement role in Singapore."},{"t":"The CFO is wrong: the auditors decide on any sanction","pit":"auditor-prepares","why":"Auditors give an opinion; they don’t impose sanctions."}]},{"id":"x6","lo":3,"type":"asc-mandate","q":"Which of the following statements about the Accounting Standards Committee (ASC) is correct?","options":[{"t":"It was set up in 2022 to replace ACRA","why":"It was set up in 2007 under the Accounting Standards Act, and has sat within ACRA since April 2022."},{"t":"It writes its own standards independently of IFRS","why":"It adopts IFRS largely word for word as SFRS(I), to keep Singapore in line with international standards."},{"t":"It issues FRS, SFRS for Small Entities and the Charities Accounting Standard as well as SFRS(I)","ok":true,"why":"All four sit within the ASC’s remit."},{"t":"It sets the financial reporting standards for statutory boards","why":"Statutory boards use SB-FRS (see ASSB), not ASC standards."}]},{"id":"x7","lo":1,"type":"user-decision","q":"Which pairing of user and decision is correct?","options":[{"t":"Bondholder: whether to vote for the re-election of directors","pit":"wrong-user-decision","why":"Shareholders vote on directors. Bondholders are lenders."},{"t":"Trade supplier: whether to buy, hold or sell the entity’s shares","pit":"wrong-user-decision","why":"That is an investor’s decision. A supplier decides whether to give credit."},{"t":"Bank: whether to lend, at what rate, and whether loan covenants are met","ok":true,"why":"Lenders decide whether to lend and on what terms, and monitor covenants."},{"t":"Management: whether to rely on the published financial statements to run operations","pit":"mgmt-primary","why":"Management has internal information and doesn’t rely on the general purpose FS."}]},{"id":"x8","lo":1,"type":"primary-users","q":"According to the Conceptual Framework, primary users of general purpose financial reports assess which of the following when making their decisions?","options":[{"t":"The entity’s market value and share price","pit":"fs-value","why":"FS help users estimate value; the assessment the Framework names is of cash flows and stewardship."},{"t":"The prospects for future net cash inflows to the entity, and management’s stewardship of its resources","ok":true,"why":"Those are the two things users assess."},{"t":"Whether the entity complies with tax law","pit":"regulator-primary","why":"That is a regulator’s concern (IRAS), not the primary users’."},{"t":"The internal budgets prepared by management","pit":"mgmt-primary","why":"Internal budgets aren’t part of general purpose reports."}]},{"id":"x9","lo":2,"type":"roles","q":"Which of the following correctly matches a party in Singapore’s financial reporting process with its role?","options":[{"t":"Auditors: prepare the financial statements and are responsible for them","pit":"auditor-prepares","why":"Directors and management prepare the FS and are responsible for them."},{"t":"ASC: monitors whether listed companies comply with SFRS(I)","pit":"asc-enforce","why":"Monitoring compliance is ACRA (and SGX and MAS for listed entities)."},{"t":"Directors: prepare the financial statements and are responsible for them","ok":true,"why":"Preparers are responsible. Auditors only give an opinion."},{"t":"IASB: adopts IFRS as SFRS(I)","pit":"asc-enforce","why":"The IASB writes IFRS; the ASC adopts them as SFRS(I)."}]},{"id":"x10","lo":2,"type":"gp-sp","q":"Which of the following is a general purpose financial report?","options":[{"t":"A tax computation prepared for IRAS","why":"Prepared for one user under the law’s requirements: special purpose."},{"t":"A schedule prepared for a buyer under the terms of a sale-and-purchase agreement","why":"One user, terms set by the contract: special purpose."},{"t":"The annual financial statements of a private company with two shareholders, prepared under FRS","ok":true,"why":"Small and private, but its shareholders and lenders can’t demand tailored reports: general purpose."},{"t":"A regulatory return filed with MAS in MAS’s prescribed format","pit":"gp-simple","why":"Prepared to a regulator’s specification: special purpose."}]}]},"prepared":true},{"id":"conceptual-framework","code":"A2","title":"The Conceptual Framework","subtitle":"Qualitative characteristics, the cost constraint and the five elements","los":{"4":"Fundamental qualitative characteristics","5":"Enhancing qualitative characteristics","6":"The cost constraint","7":"The elements of financial statements"},"accounts":[{"name":"Cash","el":"a"},{"name":"Share capital","el":"e"},{"name":"Retained earnings","el":"e"},{"name":"Loan payable","el":"l"},{"name":"Service revenue","el":"i"},{"name":"Other income","el":"i"},{"name":"Salaries expense","el":"x"},{"name":"Dividend expense","el":"x"}],"steps":[{"id":"fundamental","name":"Fundamental characteristics","short":"Fundamental"},{"id":"enhancing","name":"Enhancing characteristics and the cost constraint","short":"Enhancing"},{"id":"position","name":"Assets, liabilities and equity","short":"A, L, E"},{"id":"performance","name":"Income and expenses","short":"Income/exp"}],"map":{"fundamental":{"label":"Relevance + faithful representation","star":"Both, always: R + F"},"enhancing":{"label":"CUT V, plus the cost constraint"},"position":{"label":"{a|Asset}, {l|liability}, {e|equity} definitions","star":"2018 words: right, potential, control, no practical ability to avoid"},"performance":{"label":"Changes in {e|equity} not from owners"}},"preamble":["Welcome to the rulebook behind the rulebooks. The Conceptual Framework doesn’t tell you how to account for a lease or a tax bill; it tells you what “good” financial information looks like and what the building blocks are. Every standard you meet later leans on it.","The route:","1. **Fundamental characteristics:** information must be **relevant** and **faithfully represented**. Both, always. ★ special (and core)","2. **Enhancing characteristics:** comparability, understandability, timeliness, verifiability (CUT V) make good information better, and **cost** decides what is worth reporting at all.","3. **{a|Assets}, {l|liabilities}, {e|equity}:** the 2018 definitions, word for word. ★ special","4. **{i|Income} and {x|expenses}:** changes in {e|equity} that don’t come from owners.","+ The exam tests the **exact wording**: verifiability is “knowledgeable and independent observers… consensus”; {e|equity} is the “residual interest”. Watch the imposters too: prudence, materiality and consistency are **not** qualitative characteristics.","One housekeeping note: the study guide says qualitative characteristics are in CF **Chapter 3**. In the 2018 Framework, which SFRS(I) uses, they are **Chapter 2**, and the elements are Chapter 4."],"intros":{"fundamental":"First stop, and the heart of the chapter. What makes information worth having? ★ Two things, both required: it must **matter** (relevance) and it must be **true to the substance** (faithful representation). Along the way we sort out two words that love to pose as characteristics: materiality (part of relevance) and prudence (supports neutrality).","enhancing":"Now we know the must-haves, meet the nice-to-haves. Four enhancing characteristics (CUT V) make useful information better, but can’t rescue information that fails the fundamentals. This is where the official paper quotes the Framework word for word, so learn the key phrases. Then the cost constraint asks the grown-up question: is it worth producing at all?","position":"Change of scene: from what makes information *good* to what financial statements are *made of*. Three elements describe position: {a|assets}, {l|liabilities} and {e|equity}. ★ The special part is the 2018 wording: a **right** with **potential**, **control**, an obligation with **no practical ability to avoid**. Older textbooks still say “probable”; the exam doesn’t.","performance":"Last stop: the two elements of performance. {i|Income} and {x|expenses} are just changes in {e|equity}, with one big exception: anything to do with **owners**. {e|Share issues} aren’t income, {e|dividends} aren’t expenses, and {l|loans} are neither. This is the one place in the chapter where journal entries help, so we’ll use a few."},"pitfalls":{"fr-enhancing":"Calling faithful representation an enhancing characteristic (it is fundamental).","enhancing-fundamental":"Mixing up the lists: putting relevance under enhancing, or timeliness / verifiability under fundamental.","prudence-qc":"Treating prudence as a qualitative characteristic (it supports neutrality).","materiality-qc":"Treating materiality as a separate qualitative characteristic (it is part of relevance).","consistency-qc":"Calling consistency a qualitative characteristic (it helps achieve comparability).","prudence-understate":"Thinking prudence allows deliberately understating {a|assets} or overstating {l|liabilities}.","error-free-exact":"Thinking “free from error” means perfectly accurate.","complex-omit":"Leaving out complex information to keep the statements understandable.","cost-qc":"Treating cost as a qualitative characteristic, or as a judgement each company makes alone.","wrong-element":"Picking another element’s definition (e.g. the income wording for equity).","old-definition":"Using pre-2018 definitions (“expected” future benefits, “probable” outflows).","owner-income":"Calling an {e|owner contribution} {i|income}, or a {e|dividend} an {x|expense}.","loan-income":"Calling a {l|loan} received {i|income}.","plan-liability":"Treating a plan or intention as an {a|asset} or a {l|liability} (no past event, no obligation)."},"examTypes":[{"id":"verifiability","title":"Which enhancing QC means independent observers would reach consensus? (practice Q1)","pitfall":"Choosing faithful representation, which is fundamental.","see":"enhancing"},{"id":"apply-qc","title":"Which fundamental QC does this treatment support or harm? (practice Q40)","pitfall":"Choosing prudence or materiality, which aren’t QCs.","see":"fundamental"},{"id":"element-def","title":"Which is the correct definition of equity / an asset / a liability? (practice Q2)","pitfall":"Picking another element’s definition, or old pre-2018 wording.","see":"position"},{"id":"classify-qc","title":"Fundamental or enhancing?","pitfall":"Putting comparability or verifiability under fundamental, or faithful representation under enhancing.","see":"enhancing"},{"id":"comparability","title":"The company keeps changing methods. Which QC is harmed?","pitfall":"Answering consistency, which is not itself a QC.","see":"enhancing"},{"id":"cost","title":"Which statement about the cost constraint is correct?","pitfall":"Treating cost as a QC, or as each company’s own call.","see":"enhancing"},{"id":"asset-liability","title":"Does this meet the definition of an asset or a liability?","pitfall":"Calling a skilled workforce an {a|asset}, or a plan a {l|liability}.","see":"position"},{"id":"income-or-not","title":"Is this transaction income? What is profit?","pitfall":"Calling a {e|share issue} or a {l|loan} {i|income}, or a {e|dividend} an {x|expense}.","see":"performance"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":4,"title":"What makes information useful?","body":["The Conceptual Framework is the rulebook behind the rulebooks. Standard setters use it to write standards, and you use it to answer “why is it done this way?”","This chapter has two halves: what makes financial information **useful** (the qualitative characteristics), and what the financial statements are **made of** (the five elements).","LO 4 and 5 are **core**. Expect at least one question quoting the Framework’s wording and asking you to name the characteristic."],"id":"intro-1ard26","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-fundamental","bucket":"fundamental","sect":1,"part":"Fundamental characteristics"},{"id":"think-qyi9q1","type":"think","bucket":"fundamental","lo":4,"scenario":"An analyst is deciding whether to invest in Pulau Paints. She is offered two pieces of information: (1) a perfectly accurate, audited record of what Pulau paid for its {a|land} in 1978; (2) a WhatsApp rumour that next year’s profit will double.","prompt":"Is either of these useful to her decision? What is each one missing?","answer":["The 1978 {a|land} cost is **true**, but it tells her almost nothing about Pulau’s future: it barely **makes a difference** to her decision.","The rumour would make a difference if it were true, but there is no reason to think it **represents** reality.","Useful information needs **both**: it must be **relevant** (it can change the decision) **and** a **faithful representation** (it shows what it claims to show). One without the other is useless. Accurate trivia and exciting fiction both fail."],"sect":1,"part":"Fundamental characteristics"},{"type":"rule","bucket":"fundamental","lo":4,"title":"The two fundamental qualitative characteristics","body":["The analyst’s two pieces of information each failed in a different way: one didn’t matter to her decision, the other couldn’t be trusted. The Framework names those two tests the fundamental qualitative characteristics.","Useful information must be **both**:","1. **Relevant:** it can **make a difference** to users’ decisions. It has **predictive value** (helps forecast), **confirmatory value** (confirms or corrects past expectations), or both.","2. **Faithfully represented:** it shows the **substance** of what happened, not just its legal form.","Neither alone is enough.","+ **R + F** = the two must-haves: **R**elevant (does it matter?) and **F**aithful (is it true to the substance?)."],"id":"rule-u8pwcw","sect":1,"part":"Fundamental characteristics"},{"type":"diagram","bucket":"fundamental","lo":4,"title":"The qualitative characteristics at a glance","intro":"The chart from your notes. Two must-haves on top, four improvers below, and one constraint over everything.","notes":{"useful":"The goal: information useful to investors, lenders and other creditors (A1).","rel":"**Relevance**: can make a difference. Predictive value, confirmatory value. **Materiality** is the entity-specific side of relevance.","fr":"**Faithful representation**: substance over form. Ideally complete, neutral (supported by prudence) and free from error.","c":"**Comparability**: spot similarities and differences across entities and over time.","u":"**Understandability**: classified, characterised and presented clearly and concisely.","t":"**Timeliness**: available in time to influence decisions.","v":"**Verifiability**: knowledgeable, independent observers could reach consensus.","cost":"**Cost** is a constraint, not a characteristic: benefits must justify the costs."},"walk":[{"nodes":["useful","rel","fr"],"text":"Useful information must be **relevant** and **faithfully represented**. Both, always."},{"nodes":["c","u","t","v"],"text":"Four **enhancing** characteristics make useful information better: **C**omparability, **U**nderstandability, **T**imeliness, **V**erifiability (CUT V)."},{"nodes":["cost"],"text":"And over it all, the **cost constraint**: is it worth reporting?"}],"caption":"Fundamental: R + F. Enhancing: CUT V. Constraint: cost.","id":"diagram-oncyy0","sect":1,"part":"Fundamental characteristics","svg":"\u003csvg width=\"100%\" style=\"min-width:498px\" role=\"img\"\n viewBox=\"0.00 0.00 453.00 288.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 273.48)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-273.48 438.4,-273.48 438.4,14.4 -14.4,14.4\"/>\n\u003cg id=\"clust1\" class=\"cluster\">\n\u003ctitle>cluster_f\u003c/title>\n\u003cpath fill=\"white\" stroke=\"#1f