0.00\" fill=\"#374151\"> ✗ \u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge9\" class=\"edge\">\n\u003ctitle>dep&#45;&gt;pl\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#b45309\" d=\"M297.71,-74.32C283.56,-64.23 265.62,-51.44 250.56,-40.69\"/>\n\u003cpolygon fill=\"#b45309\" stroke=\"#b45309\" points=\"252.06,-39.19 245.96,-37.41 249.62,-42.61 252.06,-39.19\"/>\n\u003c/g>\n\n\u003cg id=\"node10\" class=\"node\">\n\u003ctitle>notes\u003c/title>\n\u003cpath fill=\"#f3eeff\" stroke=\"#6d28d9\" stroke-width=\"1.2\" d=\"M456.03,-36C456.03,-36 404.25,-36 404.25,-36 398.25,-36 392.25,-30 392.25,-24 392.25,-24 392.25,-12 392.25,-12 392.25,-6 398.25,0 404.25,0 404.25,0 456.03,0 456.03,0 462.03,0 468.03,-6 468.03,-12 468.03,-12 468.03,-24 468.03,-24 468.03,-30 462.03,-36 456.03,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"414.76\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Notes\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"400.89\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">disclosed only\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge10\" class=\"edge\">\n\u003ctitle>fvnote&#45;&gt;notes\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6d28d9\" d=\"M430.14,-74.51C430.14,-65.33 430.14,-53.89 430.14,-43.78\"/>\n\u003cpolygon fill=\"#6d28d9\" stroke=\"#6d28d9\" points=\"432.24,-43.88 430.14,-37.88 428.04,-43.88 432.24,-43.88\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"think","bucket":"subsequent","lo":17,"scenario":"Bayfront buys a building to lease out on 1 Jan 20X1 for $2,000,000 plus $40,000 legal fees. It uses the **fair value model**. At 31 Dec 20X1 the building’s fair value is $2,100,000.","prompt":"What is the gain, and where does it go?","answer":["{a|Cost} = 2,000,000 + 40,000 = $2,040,000. {i|Gain} = 2,100,000 − 2,040,000 = **$60,000**.","It goes to **profit or loss**, as a {i|Fair value gain on investment property}. No {x|depreciation} is charged."],"id":"think-fi1qtg","sect":4,"part":"Subsequent measurement"},{"id":"je-tpyx1i","type":"je","bucket":"subsequent","lo":17,"q":"On 1 Jan 20X1 Bayfront bought a building to lease out for $2,000,000 plus $40,000 legal fees. It uses the fair value model. At 31 Dec 20X1 the building’s fair value is $2,100,000. Record the remeasurement at 31 Dec 20X1.","accounts":["Investment property","Building (PPE)","Accumulated depreciation: building","Inventory","Cash","Fair value gain on investment property","Fair value loss on investment property","Gain on transfer","Loss on transfer","Revaluation surplus (OCI)","Retained earnings","Depreciation expense","Rental income","Legal fees expense"],"lines":[{"side":"Dr","account":"Investment property","amount":60000},{"side":"Cr","account":"Fair value gain on investment property","amount":60000}],"why":"2,100,000 − 2,040,000 = {i|60,000 gain}, straight to profit or loss. No {x|depreciation} entry under the fair value model.","sect":4,"part":"Subsequent measurement"},{"id":"visual-14begi","type":"visual","bucket":"subsequent","lo":17,"title":"Same building, two models: 20X1","html":"\u003cp>What if Bayfront had picked the cost model instead? The same building, the same first year, side by side: the choice of model alone changes both profit and the balance sheet.\u003c/p>\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num\">\u003cthead>\u003ctr>\u003cth>20X1\u003c/th>\u003cth>Fair value model\u003c/th>\u003cth>Cost model\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>Profit or loss\u003c/td>\u003ctd>+60,000 \u003cspan class=\"el el-i\">fair value gain\u003c/span>\u003c/td>\u003ctd>(51,000) \u003cspan class=\"el el-x\">depreciation\u003c/span>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Investment property\u003c/span> at 31 Dec 20X1\u003c/td>\u003ctd>2,100,000\u003c/td>\u003ctd>1,989,000\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Fair value in the notes\u003c/td>\u003ctd>n/a\u003c/td>\u003ctd>2,100,000\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">Building only, 40-year life, no residual value. Cost-model \u003cspan class=\"el el-x\">depreciation\u003c/span> = \u003cspan class=\"el el-a\">cost\u003c/span> 2,040,000 ÷ 40 = 51,000. Same building, a 111,000 swing in profit.\u003c/p>","sect":4,"part":"Subsequent measurement"},{"id":"calc-1rpnj1","type":"calc","bucket":"subsequent","lo":17,"q":"On 1 Jan 20X1 Bayfront bought a building to lease out for $2,000,000 plus $40,000 legal fees ({a|cost} $2,040,000; building only, 40-year life, no residual value, straight-line). It uses the cost model. What is the building’s {a|carrying amount} at 31 Dec 20X2?","answer":1938000,"unit":"$","working":["{x|Depreciation} = 2,040,000 ÷ 40 = 51,000 a year.","{a|Carrying amount} = 2,040,000 − 2 × 51,000 = **$1,938,000**. The fair value is disclosed in the notes, not recognised."],"sect":4,"part":"Subsequent measurement"},{"id":"think-1ab4lb","type":"think","bucket":"subsequent","lo":17,"scenario":"Bayfront uses the fair value model for a building it leases out. The building ({a|cost} $2,040,000 on 1 Jan 20X1) was remeasured to $2,100,000 at 31 Dec 20X1, a {i|gain} of $60,000 in that year’s profit or loss. At 31 Dec 20X2 the property market dips and the building is valued at $2,030,000.","prompt":"Can Bayfront set the $70,000 fall against last year’s {i|gain} in some reserve, the way a PPE revaluation loss uses up the {e|revaluation surplus} first?","answer":["No. Last year’s {i|gain} went to profit or loss, so there is no reserve to use up. The 70,000 fall is a {x|Fair value loss on investment property} in 20X2 profit or loss.","Under the fair value model, **every** change in fair value goes to profit or loss, up or down. No cushion, no piggy bank: P&L takes the hit."],"sect":4,"part":"Subsequent measurement"},{"type":"rule","bucket":"subsequent","lo":17,"title":"Investment property is not a PPE revaluation","body":["Bayfront’s 20X2 fall shows the trap: the fair value model *looks* like a PPE revaluation, since both carry the asset at fair value. But the two send their changes to different places, and the exam tests exactly that difference.","- **PPE revaluation gain** → {e|Revaluation surplus (OCI)}. The asset is still {x|depreciated}.","- **{a|Investment property} {i|fair value gain}** → profit or loss. No {x|depreciation}, no {e|revaluation surplus}.","> Dr {a|Investment property} / Cr {i|Fair value gain on investment property} (or the reverse for a loss)","! Exam options love crediting **OCI**, a **{e|revaluation surplus}** or **{e|retained earnings}** with an investment property {i|gain}. Under the fair value model it is always **P&L**."],"id":"rule-1g2e61","sect":4,"part":"Subsequent measurement"},{"id":"mcq-1j0p3c","type":"mcq","bucket":"subsequent","lo":17,"q":"Bayfront carries its rented-out building under the fair value model. Its fair value falls from $2,100,000 at 31 Dec 20X1 to $2,030,000 at 31 Dec 20X2. What entry does Bayfront record at 31 Dec 20X2?","options":[{"t":"Dr Revaluation surplus (OCI) 70,000; Cr Investment property 70,000","why":"There is no {e|revaluation surplus} for investment property under the fair value model: last year’s {i|gain} went to P&L."},{"t":"Dr Fair value loss on investment property (P&L) 70,000; Cr Investment property 70,000","ok":true,"why":"The fall of 70,000 is a {x|loss} in profit or loss, just as the {i|gain} was income."},{"t":"Dr Depreciation expense 51,000; Cr Investment property 51,000","why":"No {x|depreciation} under the fair value model."},{"t":"No entry: the loss is only recognised when the building is sold","why":"Fair value changes are recognised every reporting date, whether gains or losses."}],"sect":4,"part":"Subsequent measurement"},{"type":"visual","bucket":"subsequent","lo":17,"title":"Fair value model vs cost model, step by step","html":"\u003cp>Bayfront’s building, both ways. It starts at \u003cspan class=\"el el-a\">cost 2,040,000\u003c/span> on 1 Jan 20X1 under either model. Step through 20X1 and 20X2 and watch one model follow the market while the other quietly wears the building down.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"models-b13\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;Fair value model&quot;,&quot;sub&quot;:&quot;no depreciation&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Investment property&quot;,&quot;start&quot;:2040000,&quot;startCap&quot;:&quot;1 Jan 20X1: {a|cost} = price 2,000,000 + legal fees 40,000 = {a|2,040,000}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;fair value gain&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:60000,&quot;cap&quot;:&quot;20X1: fair value 2,100,000 − {a|2,040,000} = {i|+60,000 gain} in P&amp;L. {a|Closing} = {a|2,100,000}.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;fair value loss&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-70000,&quot;cap&quot;:&quot;20X2: the market dips. 2,030,000 − {a|2,100,000} = {x|−70,000 loss} in P&amp;L, with no reserve to cushion it. {a|Closing} = {a|2,030,000}.&quot;}]}]},{&quot;title&quot;:&quot;Cost model&quot;,&quot;sub&quot;:&quot;40-year life&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Investment property&quot;,&quot;start&quot;:2040000,&quot;startCap&quot;:&quot;Same {a|cost 2,040,000}. Fair value will only be disclosed in the notes.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-51000,&quot;cap&quot;:&quot;20X1: {x|depreciation} = {a|2,040,000} ÷ 40 = {x|51,000}. {a|Closing} = {a|1,989,000} (fair value 2,100,000 in the notes).&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-51000,&quot;cap&quot;:&quot;20X2: the same {x|51,000} again, whatever the market did. {a|Closing} = {a|1,938,000} (fair value 2,030,000 in the notes).&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Same building, same day-1 {a|cost}. Only the model differs. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Each year end: the fair value model books the **whole change in fair value** in P&amp;L; the cost model books **{x|depreciation}**, and the fair value goes in the notes.&quot;],&quot;end&quot;:&quot;**Two very different stories.** P&amp;L under the fair value model: +60,000, then −70,000. Under the cost model: −51,000 each year, smooth and blind to the market. At 31 Dec 20X2 the balance sheet shows {a|2,030,000} vs {a|1,938,000}.&quot;}}\">\u003c/div>","id":"visual-595c49","sect":4,"part":"Subsequent measurement"},{"type":"compare","bucket":"subsequent","lo":17,"special":"Under the fair value model {a|investment property} is **not depreciated**, and every change in fair value goes straight to **profit or loss**, unlike a PPE revaluation, which goes to the {e|revaluation surplus} in OCI.","id":"compare-1kumyt-2","sect":4,"part":"Subsequent measurement"},{"type":"map","id":"map-5-derecognise","bucket":"derecognise","sect":5,"part":"Derecognise / transfer"},{"type":"think","bucket":"derecognise","lo":18,"scenario":"Lim Holdings has worked out of its own office building for years. (1) In March, the board minutes say it “intends to lease the building out at some point”. (2) In June, Lim moves its staff to a new site and signs a lease with a tenant.","prompt":"At which point, if any, does the building stop being PPE and become investment property?","answer":["In **June**. A transfer needs an actual **change in use**, backed by evidence: here the owner moved out and leased it out.","March is only a change in management’s **intention**. That alone is not enough, so nothing is transferred then. “At some point” in the minutes is a mood, not a move."],"id":"think-fihb8s","sect":5,"part":"Derecognise / transfer"},{"type":"rule","bucket":"derecognise","lo":18,"title":"Transfers need a change in use","body":["Properties change jobs: an owner moves out, a developer lets a flat instead of selling it. Because the job decides the standard, a change of job moves the property between standards, but only on hard evidence.","Transfer into or out of investment property **only when there is a change in use**: the property starts or stops meeting the definition, and there is evidence of it.","Evidence of a change in use:","- owner-occupation **ends** → {a|PPE} to {a|investment property}","- an **operating lease** to another party **starts** → {a|inventory} to {a|investment property}","- owner-occupation **starts** → {a|investment property} to {a|PPE}","- **development with a view to sale** starts → {a|investment property} to {a|inventory}","! A change in management’s intention, on its own, is **not** evidence of a change in use."],"id":"rule-12igiy","sect":5,"part":"Derecognise / transfer"},{"id":"visual-opi1jk","type":"visual","bucket":"derecognise","lo":18,"title":"Transfers under the fair value model","html":"\u003cp>A change in use moves the property between standards. Each direction has its own rule for the amount and for where any difference goes. Here are all four (plus the cost model) on one table.\u003c/p>\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl reveal-rows\">\u003cthead>\u003ctr>\u003cth>Transfer\u003c/th>\u003cth>Measure at\u003c/th>\u003cth>Difference goes to\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cstrong>PPE → IP\u003c/strong> (owner moves out)\u003c/td>\u003ctd>Fair value at the date of change\u003c/td>\u003ctd>As a PPE revaluation: increase → \u003cspan class=\"el el-e\">Revaluation surplus (OCI)\u003c/span>; decrease → \u003cspan class=\"el el-x\">loss\u003c/span> in P&amp;L\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Inventory → IP\u003c/strong> (operating lease starts)\u003c/td>\u003ctd>Fair value\u003c/td>\u003ctd>\u003cspan class=\"el el-i\">Gain\u003c/span> or \u003cspan class=\"el el-x\">loss\u003c/span> in \u003cstrong>profit or loss\u003c/strong>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>IP → PPE\u003c/strong> (owner moves in)\u003c/td>\u003ctd>Fair value becomes \u003cstrong>deemed cost\u003c/strong> of the \u003cspan class=\"el el-a\">PPE\u003c/span>\u003c/td>\u003ctd>Changes up to that date are already in P&L\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>IP → inventory\u003c/strong> (development for sale)\u003c/td>\u003ctd>Fair value becomes \u003cstrong>deemed cost\u003c/strong> of the \u003cspan class=\"el el-a\">inventory\u003c/span>\u003c/td>\u003ctd>As above\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Cost model\u003c/strong>, any direction\u003c/td>\u003ctd>\u003cstrong>\u003cspan class=\"el el-a\">Carrying amount\u003c/span>\u003c/strong>\u003c/td>\u003ctd>Nothing: no remeasurement\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">Why the difference? A gain on property the entity \u003cstrong>used\u003c/strong> is like a PPE revaluation: it was never trading stock. A \u003cspan class=\"el el-i\">gain\u003c/span> on former \u003cstrong>\u003cspan class=\"el el-a\">inventory\u003c/span>\u003c/strong> is the profit the entity would have made selling it.\u003c/p>","sect":5,"part":"Derecognise / transfer"},{"type":"diagram","bucket":"derecognise","lo":18,"title":"The transfer map","intro":"The chart from your notes. Solid arrows go **into** investment property and carry a gain somewhere; dashed arrows go **out**, and fair value becomes the new cost.","notes":{"ppe":"Owner-occupied property: {a|PPE}. Depreciated until the day the use changes.","ip":"{a|Investment property} under the fair value model. Once here, every change goes to P&L.","inv":"A developer’s stock, held for sale: {a|inventory}."},"walk":[{"nodes":["ppe","ip"],"text":"**PPE → IP** (owner moves out): an increase is treated as a PPE revaluation, so it goes to the {e|revaluation surplus} in **OCI**. A decrease is a {x|loss} in P&L."},{"nodes":["inv","ip"],"text":"**Inventory → IP** (operating lease starts): the difference is a {i|gain} in **P&L**. It is the profit it would have made selling."},{"nodes":["ip","ppe"],"text":"**IP → PPE** (owner moves in): fair value at that date becomes the {a|PPE}’s **deemed cost**."},{"nodes":["ip","inv"],"text":"**IP → inventory** (development for sale starts): fair value becomes the {a|inventory}’s **deemed cost**."},{"nodes":["ip"],"text":"Under the **cost model**, every arrow simply moves the {a|carrying amount}. Nothing is remeasured."}],"caption":"Green into IP: OCI. Amber into IP: P&L. Dashed out of IP: deemed cost.","id":"diagram-1ps63t","sect":5,"part":"Derecognise / transfer","svg":"\u003csvg width=\"100%\" style=\"min-width:447px\" role=\"img\"\n viewBox=\"0.00 0.00 406.00 193.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 182.33)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-182.33 394.86,-182.33 394.86,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>ppe\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M71.28,-156.44C71.28,-156.44 12,-156.44 12,-156.44 6,-156.44 0,-150.44 0,-144.44 0,-144.44 0,-132.44 0,-132.44 0,-126.44 6,-120.44 12,-120.44 12,-120.44 71.28,-120.44 71.28,-120.44 77.28,-120.44 83.28,-126.44 83.28,-132.44 83.28,-132.44 83.28,-144.44 83.28,-144.44 83.28,-150.44 77.28,-156.44 71.28,-156.44\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"30.39\" y=\"-138.99\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">PPE\u003c/text>\n\u003ctext xml:space=\"preserve\" te