6.89,-144.14\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"588.12\" y=\"-130.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#374151\">Owners\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"575.75\" y=\"-121.27\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#374151\">contributions in,\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"575.75\" y=\"-112.27\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#374151\">distributions out\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>own&#45;&gt;e\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M574.36,-106C568.99,-103.52 563.41,-101.18 558,-99.32 461.15,-65.98 342.29,-48.37 275.04,-40.43\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"275.61,-38.38 269.4,-39.77 275.12,-42.55 275.61,-38.38\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"549.69\" y=\"-81\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> not income\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"549.69\" y=\"-69.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> or expense \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"map","id":"map-4-performance","bucket":"performance","sect":4,"part":"Income and expenses"},{"id":"think-aur94p","type":"think","bucket":"performance","lo":7,"scenario":"Owner-founded Bayu Studio has a busy first week: the owner puts in S$50,000 for shares; it earns S$8,000 from a client; it borrows S$20,000 from a bank; and it pays the owner a S$3,000 dividend.","prompt":"{a|Cash} went up in three of these. Which ones are income? And is the dividend an expense?","answer":["Only the **{i|client fee}** of S$8,000 is {i|income}: {a|assets} up, {e|equity} up, and not from an owner.","The **{e|share issue}** raises {e|equity}, but it is a **contribution from an owner**, so not income.","The **{l|loan}** raises an {a|asset} and a {l|liability} equally: {e|equity} doesn’t move, so not income.","The **{e|dividend}** reduces {e|equity}, but it is a **distribution to an owner**, so not an expense."],"sect":4,"part":"Income and expenses"},{"type":"rule","bucket":"performance","lo":7,"title":"Income and expenses","body":["Bayu Studio’s {a|cash} went up three times, but only once from {i|income}. The definitions explain why: they are written in terms of {e|equity}, not cash.","1. **{i|Income}:** **increases in {a|assets}, or decreases in {l|liabilities}**, that result in increases in {e|equity}, **other than** contributions from holders of equity claims.","2. **{x|Expenses}:** **decreases in {a|assets}, or increases in {l|liabilities}**, that result in decreases in {e|equity}, **other than** distributions to holders of equity claims.","+ {i|Income} and {x|expenses} are simply the changes in {e|equity} that **don’t come from owners**.","! A {e|share issue} is not {i|income}. A {e|dividend} is not an {x|expense}. A {l|loan} is not {i|income}."],"id":"rule-1kg4qo","sect":4,"part":"Income and expenses"},{"type":"visual","bucket":"performance","lo":7,"title":"Cash vs equity, one transaction at a time","html":"\u003cp>Bayu Studio’s four transactions again, with two balances side by side: \u003cspan class=\"el el-a\">cash\u003c/span> on the left, \u003cspan class=\"el el-e\">equity\u003c/span> on the right. \u003cspan class=\"el el-i\">Income\u003c/span> is the part of the \u003cspan class=\"el el-e\">equity\u003c/span> rise that \u003cstrong>doesn’t\u003c/strong> come from an owner, so watch the right panel, not the left.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"bayu-a2\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;Cash&quot;,&quot;sub&quot;:&quot;what came in&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Cash&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;Day 0: no {a|cash} yet.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;Shares&quot;,&quot;hold&quot;:&quot;{e|Equity} up 50,000, but it came **from an owner**: a contribution, not {i|income}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;share issue&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:50000,&quot;cap&quot;:&quot;Owner pays in {a|50,000}: {a|cash} up.&quot;}]},{&quot;label&quot;:&quot;Fee&quot;,&quot;hold&quot;:&quot;{e|Equity} up 8,000, **not** from an owner: this is {i|income}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;client fee&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:8000,&quot;cap&quot;:&quot;Client pays {a|8,000}: {a|cash} up.&quot;}]},{&quot;label&quot;:&quot;Loan&quot;,&quot;hold&quot;:&quot;{e|Equity} doesn’t move: the {a|asset} and the {l|liability} cancel out. Not {i|income}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;bank loan&quot;,&quot;el&quot;:&quot;l&quot;,&quot;v&quot;:20000,&quot;cap&quot;:&quot;Bank lends {a|20,000}: {a|cash} up, and a {l|loan payable} of the same amount.&quot;}]},{&quot;label&quot;:&quot;Div.&quot;,&quot;hold&quot;:&quot;{e|Equity} down 3,000, but it went **to an owner**: a distribution, not an {x|expense}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;dividend&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:-3000,&quot;cap&quot;:&quot;Dividend paid: {a|cash} down 3,000.&quot;}]}]},{&quot;title&quot;:&quot;Equity&quot;,&quot;sub&quot;:&quot;what Bayu is worth to its owner&quot;,&quot;el&quot;:&quot;e&quot;,&quot;bal&quot;:&quot;Equity&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;Day 0: no {e|equity} yet.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;Shares&quot;,&quot;hold&quot;:&quot;{e|Equity} up 50,000, but it came **from an owner**: a contribution, not {i|income}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;share issue&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:50000,&quot;cap&quot;:&quot;{e|Equity} up 50,000, but it came **from an owner**: a contribution, not {i|income}.&quot;}]},{&quot;label&quot;:&quot;Fee&quot;,&quot;hold&quot;:&quot;{e|Equity} up 8,000, **not** from an owner: this is {i|income}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;client fee&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:8000,&quot;cap&quot;:&quot;{e|Equity} up 8,000, **not** from an owner: this is {i|income}.&quot;}]},{&quot;label&quot;:&quot;Loan&quot;,&quot;hold&quot;:&quot;{e|Equity} doesn’t move: the {a|asset} and the {l|liability} cancel out. Not {i|income}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;bank loan&quot;,&quot;el&quot;:&quot;l&quot;,&quot;v&quot;:0,&quot;cap&quot;:&quot;{e|Equity} doesn’t move: the {a|asset} and the {l|liability} cancel out. Not {i|income}.&quot;}]},{&quot;label&quot;:&quot;Div.&quot;,&quot;hold&quot;:&quot;{e|Equity} down 3,000, but it went **to an owner**: a distribution, not an {x|expense}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;dividend&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:-3000,&quot;cap&quot;:&quot;{e|Equity} down 3,000, but it went **to an owner**: a distribution, not an {x|expense}.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Bayu Studio’s first week, one transaction per step. Left: {a|cash}. Right: {e|equity}. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Ask each time: did {e|equity} move? And if it did, did the move come from an owner?&quot;],&quot;end&quot;:&quot;{a|Cash} ends at **{a|75,000}** and {e|equity} at **{e|55,000}**, yet {i|income} is only **{i|8,000}**. The rest of the {e|equity} change came from (or went to) the owner, and the {l|loan} never touched {e|equity} at all.&quot;}}\">\u003c/div>","id":"visual-hchkoc","sect":4,"part":"Income and expenses"},{"id":"worked-1iwhep","type":"worked","bucket":"performance","lo":7,"title":"Worked example: income or not?","q":"Owner-founded Bayu Studio’s first week: (1) the owner puts in S$50,000 {a|cash} for shares; (2) it earns S$8,000 {a|cash} from a client; (3) it borrows S$20,000 from a bank; (4) it pays the owner a S$3,000 dividend. Record the four transactions and decide, for each, whether it is income, an expense, or neither.","intro":["A typical exam question: a list of transactions, and you must say which are {i|income} or {x|expenses}. Remember two things:","- {i|Income} and {x|expenses} are changes in {e|equity}. If {e|equity} doesn’t move (a {l|loan}, an {a|asset} swap), it is neither.","- Changes that come from **owners** ({e|share issues} in, {e|dividends} out) are never {i|income} or {x|expenses}.","Then for each transaction: entry → did {e|equity} move? → did it come from an owner?"],"steps":[{"h":"Record the owner’s investment.","t":"{a|Cash} S$50,000 in. {e|Equity} goes up, but it is a **contribution from an equity holder**: not income.","je":[{"side":"Dr","account":"Cash","amount":50000,"el":"a"},{"side":"Cr","account":"Share capital","amount":50000,"el":"e"}]},{"h":"Record the client fee.","t":"{a|Cash} S$8,000 in: {a|asset} up, {e|equity} up, not from owners: **{i|income}**.","je":[{"side":"Dr","account":"Cash","amount":8000,"el":"a"},{"side":"Cr","account":"Service revenue","amount":8000,"el":"i"}]},{"h":"Record the bank loan.","t":"{a|Cash} and {l|Loan payable} both up S$20,000; {e|equity} unchanged: **not income**.","je":[{"side":"Dr","account":"Cash","amount":20000,"el":"a"},{"side":"Cr","account":"Loan payable","amount":20000,"el":"l"}]},{"h":"Record the dividend.","t":"{e|Equity} down S$3,000, but it is a **distribution to owners**: **not an expense**.","je":[{"side":"Dr","account":"Retained earnings","amount":3000,"el":"e"},{"side":"Cr","account":"Cash","amount":3000,"el":"a"}]},{"h":"Compare cash with income.","t":"{a|Cash} rose by {a|75,000}, but {i|income} for the week is only **{i|S$8,000}**. {a|Cash} in ≠ {i|income}."}],"sect":4,"part":"Income and expenses"},{"id":"je-110cw1","type":"je","bucket":"performance","lo":7,"q":"Bayu Studio pays staff salaries of S$4,000 in {a|cash}. The credit is filled in for you: complete the entry, and decide whether this is an expense.","accounts":["Cash","Share capital","Retained earnings","Loan payable","Service revenue","Other income","Salaries expense","Dividend expense"],"given":[1],"lines":[{"side":"Dr","account":"Salaries expense","amount":4000},{"side":"Cr","account":"Cash","amount":4000}],"why":"An {a|asset} goes down and {e|equity} goes down, and it is not a distribution to owners: an **{x|expense}**.","sect":4,"part":"Income and expenses"},{"id":"je-78ukel","type":"je","bucket":"performance","lo":7,"q":"Bayu Studio, which borrowed S$20,000 from a bank, repays S$5,000 of the {l|bank loan} in {a|cash}. Record it. Is there an expense?","accounts":["Cash","Share capital","Retained earnings","Loan payable","Service revenue","Other income","Salaries expense","Dividend expense"],"lines":[{"side":"Dr","account":"Loan payable","amount":5000},{"side":"Cr","account":"Cash","amount":5000}],"why":"An {a|asset} and a {l|liability} fall by the same amount, so {e|equity} doesn’t change: **no expense**. ({x|Interest} on the {l|loan} would be an {x|expense}; repaying the {l|principal} is not.)","sect":4,"part":"Income and expenses"},{"type":"tree","bucket":"performance","lo":7,"title":"Income, expense, or neither?","scenario":"Bayu Tech receives S$500,000 from a new investor in exchange for newly issued ordinary shares. How should the receipt be classified?","expect":"contrib","start":"i1","nodes":{"i1":{"q":"Does the transaction change {e|equity}?","why":"{i|Income} and {x|expenses} are defined as changes in {e|equity}. No change in {e|equity}, no {i|income} or {x|expense}.","opts":[{"t":"No: {a|assets} and {l|liabilities} move equally, or one {a|asset} swaps for another","to":"none"},{"t":"Yes, {e|equity} goes up","to":"i2"},{"t":"Yes, {e|equity} goes down","to":"i3"}]},"i2":{"q":"Is the increase a contribution from holders of equity claims (owners)?","why":"The definition of {i|income} excludes contributions from owners.","opts":[{"t":"Yes, e.g. a {e|share issue}","to":"contrib"},{"t":"No","to":"income"}]},"i3":{"q":"Is the decrease a distribution to holders of equity claims (owners)?","why":"The definition of {x|expenses} excludes distributions to owners.","opts":[{"t":"Yes, e.g. a {e|dividend}","to":"dist"},{"t":"No","to":"expense"}]},"none":{"result":"Neither income nor an expense","body":["Borrowing, repaying a {l|loan}, or buying {a|equipment} for {a|cash} leaves {e|equity} unchanged."]},"contrib":{"result":"Contribution from owners: not income","body":["Recorded directly in {e|equity} (e.g. {e|Share capital}).","! A {e|share issue} raises {a|cash} and {e|equity}, but it is never income."]},"income":{"result":"Income","body":["An increase in {a|assets} (or decrease in {l|liabilities}) that raises {e|equity} and doesn’t come from owners."]},"dist":{"result":"Distribution to owners: not an expense","body":["A {e|dividend} reduces {e|Retained earnings} directly. It never goes through profit or loss."]},"expense":{"result":"Expense","body":["A decrease in {a|assets} (or increase in {l|liabilities}) that lowers {e|equity} and isn’t a distribution to owners."]}},"id":"tree-7v3hdx","sect":4,"part":"Income and expenses","svg":"\u003csvg width=\"100%\" style=\"min-width:617px\" role=\"img\"\n viewBox=\"0.00 0.00 561.00 269.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 258.19)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-258.19 550.58,-258.19 550.58,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>i1\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M397.15,-247.39C397.15,-247.39 266.62,-247.39 266.62,-247.39 260.62,-247.39 254.62,-241.39 254.62,-235.39 254.62,-235.39 254.62,-223.39 254.62,-223.39 254.62,-217.39 260.62,-211.39 266.62,-211.39 266.62,-211.39 397.15,-