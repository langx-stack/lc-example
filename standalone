-64.82 2.62,-64.82 2.62,-49.18 2.62,-49.18 2.62,-43.18 8.62,-37.18 14.62,-37.18 14.62,-37.18 96.4,-37.18 96.4,-37.18 102.4,-37.18 108.4,-43.18 108.4,-49.18 108.4,-49.18 108.4,-64.82 108.4,-64.82 108.4,-70.82 102.4,-76.82 96.4,-76.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"11.26\" y=\"-63.05\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Carrying amount\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"31.51\" y=\"-52.05\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">2,100,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"24.76\" y=\"-42.95\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">latest fair value\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>ca&#45;&gt;gain\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M108.74,-66.63C133.7,-71.24 163.36,-76.71 187.7,-81.2\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"187.31,-83.26 193.59,-82.28 188.07,-79.13 187.31,-83.26\"/>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>pl\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M477.34,-102C477.34,-102 415.81,-102 415.81,-102 409.81,-102 403.81,-96 403.81,-90 403.81,-90 403.81,-78 403.81,-78 403.81,-72 409.81,-66 415.81,-66 415.81,-66 477.34,-66 477.34,-66 483.34,-66 489.34,-72 489.34,-78 489.34,-78 489.34,-90 489.34,-90 489.34,-96 483.34,-102 477.34,-102\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"412.45\" y=\"-80.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Profit or loss\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>gain&#45;&gt;pl\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#b45309\" d=\"M277.55,-88.84C311.45,-87.87 360.11,-86.46 396.35,-85.42\"/>\n\u003cpolygon fill=\"#b45309\" stroke=\"#b45309\" points=\"395.97,-87.53 401.91,-85.26 395.85,-83.33 395.97,-87.53\"/>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>rs\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M285.56,-42C285.56,-42 187.28,-42 187.28,-42 181.28,-42 175.28,-36 175.28,-30 175.28,-30 175.28,-18 175.28,-18 175.28,-12 181.28,-6 187.28,-6 187.28,-6 285.56,-6 285.56,-6 291.56,-6 297.56,-12 297.56,-18 297.56,-18 297.56,-30 297.56,-30 297.56,-36 291.56,-42 285.56,-42\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"183.92\" y=\"-24.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Revaluation surplus\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"188.42\" y=\"-15.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">only if it came from PPE\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>rs&#45;&gt;pl\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M297.91,-41.44C329.24,-50.47 367.02,-61.36 396.52,-69.86\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"395.64,-71.79 401.99,-71.44 396.8,-67.76 395.64,-71.79\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"343.93\" y=\"-66.13\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> ✗ never \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>re\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M490.84,-36C490.84,-36 402.31,-36 402.31,-36 396.31,-36 390.31,-30 390.31,-24 390.31,-24 390.31,-12 390.31,-12 390.31,-6 396.31,0 402.31,0 402.31,0 490.84,0 490.84,0 496.84,0 502.84,-6 502.84,-12 502.84,-12 502.84,-24 502.84,-24 502.84,-30 496.84,-36 490.84,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"398.95\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Retained earnings\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"407.57\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">direct, within equity\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>rs&#45;&gt;re\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#166534\" d=\"M298.06,-17.7C303.3,-17.32 308.52,-16.99 313.56,-16.75 340.53,-15.47 347.31,-16.51 374.31,-16.75 377.01,-16.77 379.76,-16.8 382.54,-16.83\"/>\n\u003cpolygon fill=\"#166534\" stroke=\"#166534\" points=\"382.4,-18.93 388.43,-16.91 382.46,-14.73 382.4,-18.93\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"343.93\" y=\"-18.5\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> may transfer \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"mcq-1yx8rx","type":"mcq","bucket":"derecognise","lo":18,"q":"Lim Holdings moved out of its office (PPE) and leased it out, so it became {a|investment property} (fair value model). The increase to fair value on that transfer, $150,000, went to the {e|revaluation surplus} (OCI). Later Lim sells the building for {a|net proceeds} of $1,030,000, when its {a|carrying amount} is $1,000,000. What happens to the $150,000 {e|revaluation surplus}?","options":[{"t":"It is added to the {i|gain on sale} in profit or loss, giving $180,000","why":"The {e|surplus} is never reclassified to profit or loss."},{"t":"It may be transferred directly to {e|retained earnings}, within equity","ok":true,"why":"The {i|gain} in P&L is only 30,000 (1,030,000 − 1,000,000). The surplus can move from {e|revaluation surplus} to {e|retained earnings} without passing through P&L."},{"t":"It must stay in the {e|revaluation surplus} for ever","why":"Once the property is gone, the surplus may be transferred to {e|retained earnings}."},{"t":"It is reversed against {a|investment property} before the sale","why":"The {e|surplus} belongs to equity; the property is already at fair value."}],"sect":5,"part":"Derecognise / transfer"},{"type":"compare","bucket":"derecognise","preamble":"Investment property is the cousin that can leave **without being sold**: a change in use transfers it to PPE or inventory (and back in the other way).","lo":18,"special":"{a|Investment property} has its own **transfer** rules: a change in use moves it in or out, and the gain on PPE → IP goes to the {e|revaluation surplus} (OCI) while inventory → IP is a {i|gain} in P&L.","id":"compare-1kumyt-3","sect":5,"part":"Derecognise / transfer"},{"type":"map","id":"map-6-present","bucket":"present","sect":6,"part":"Present & disclose"},{"type":"think","bucket":"present","lo":19,"scenario":"An analyst compares two Singapore property companies. Alpha uses the fair value model; Beta uses the cost model. Beta’s buildings look much cheaper on its balance sheet.","prompt":"What would the analyst need from Beta’s notes to compare the two fairly?","answer":["Beta’s **fair value**. Without it, the analyst cannot tell whether Beta’s {a|investment property} is really worth less or just carried at old cost.","So the cost model still requires fair value to be **disclosed**. The analyst also wants to know how the values were reached, by whom, and what {i|rent} the properties earn."],"id":"think-wxkwuo","sect":6,"part":"Present & disclose"},{"type":"rule","bucket":"present","lo":19,"title":"Presentation and disclosure","body":["Finally, what users get to see. The disclosures exist so that a fair value company and a cost model company can be compared, which is why fair value turns up even under the cost model.","- **Balance sheet:** {a|Investment property} is a separate line item.","- **Profit or loss:** {i|fair value gains} and {x|losses}, {i|Rental income} and {x|direct operating expenses}.","**All investment property:**","- which model is used (fair value or cost)","- the criteria used to tell investment property from owner-occupied property and inventory, where that is difficult","- how far fair value is based on an **independent, qualified valuer** with recent relevant experience","- {i|rental income} and {x|direct operating expenses}, split between properties that earned rent and those that did not","- restrictions on selling it or remitting income, and contractual obligations to buy, build, develop or repair it","**Fair value model:** a **reconciliation** of the {a|carrying amount} (additions, disposals, {i|fair value gains} and {x|losses}, transfers in and out).","**Cost model:** depreciation method, useful lives or rates, {a|gross carrying amount} and {a|accumulated depreciation}, a reconciliation, **and the fair value**.","! Under the cost model, fair value is **still disclosed**."],"id":"rule-7bdyl1","sect":6,"part":"Present & disclose"},{"type":"mcq","bucket":"present","lo":19,"q":"An entity uses the cost model for its investment property. Which of the following must it disclose?","options":[{"t":"Nothing about fair value, since the property is carried at cost","why":"Fair value must still be disclosed under the cost model."},{"t":"The fair value of its investment property","ok":true,"why":"Required, alongside depreciation methods, useful lives, {a|gross amount}, {a|accumulated depreciation} and a reconciliation."},{"t":"The fair value gains it would have recognised in profit or loss","why":"Not required. It discloses fair value, not a hypothetical P&L."},{"t":"Only the {x|depreciation} charge for the year","why":"Much more is required, including the fair value."}],"id":"mcq-i9jzn5","sect":6,"part":"Present & disclose"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":7,"part":"Wrap-up"},{"type":"summary","lo":19,"title":"Investment property on one page","rows":[["What is investment property?","Land or buildings held to earn rent or for capital appreciation, not for own use or for sale."],["Hotel? Office block with security?","Hotel → {a|PPE} (significant services). Office block → {a|investment property} (insignificant services)."],["Staff quarters? Developer’s units?","Staff quarters → {a|PPE} (owner-occupied). Units for sale → {a|inventory}."],["Initial measurement?","{a|Cost}, including transaction costs (legal fees, stamp duty). Start-up costs and early operating losses are {x|expenses}."],["Fair value model?","Fair value at each year end, changes to profit or loss ({i|gain} or {x|loss}), no {x|depreciation}."],["Cost model?","As the PPE cost model; fair value disclosed."],["When to transfer?","Only on a change in use, with evidence. Intention alone is not enough."],["PPE → IP at fair value?","Like a PPE revaluation: increase → {e|Revaluation surplus (OCI)}, decrease → {x|loss} in P&L."],["Inventory → IP?","Difference is a {i|gain} or {x|loss} in profit or loss."],["IP → PPE or inventory?","Fair value at the date of change becomes {a|deemed cost}."],["Sold?","{a|Net proceeds} − {a|carrying amount} → {i|gain} or {x|loss} in P&L. Any old {e|revaluation surplus} goes straight to {e|retained earnings}."]],"id":"summary-1t8dsf","bucket":"wrap","sect":7,"part":"Wrap-up"}],"quiz":{"cases":{"ruby":{"name":"Ruby Enterprises","source":"Official practice paper (Q16–20 case, investment property paragraph only)","text":["Ruby Enterprises Pte Ltd (Ruby) is a jewellery wholesaler based in Orchard Towers. Ruby has a financial year ending 31 December 20X7.","Ruby owns a freehold commercial property that is held to earn rental income under a lease agreement. At the end of the financial year, the property was revalued to $1,575,000. On 1 January 20X7, the fair value of the property was $1,350,000. Ruby applies a fair value model on investment property."]},"sentosa":{"name":"Sentosa Developments","text":["Sentosa Developments Pte Ltd (Sentosa) builds and sells condominiums. Its financial year ends on 31 December 20X3, and it uses the fair value model for investment property. At 31 December 20X3 it holds:","(a) 12 completed condominium units, being marketed to buyers.","(b) A commercial building bought on 1 March 20X3 for $5,400,000 and leased to tenants under operating leases. Sentosa paid legal fees of $45,000, stamp duty of $162,000, and $30,000 for a reception to welcome the tenants. Fair value at 31 December 20X3 is $5,800,000.","(c) A plot of land in Tuas bought in 20X1, with no decision yet on how it will be used.","(d) The building that houses Sentosa’s own head office."]}},"questions":[{"id":"q1","case":"ruby","lo":17,"type":"fv-entry","source":"Official practice paper Q20","q":"With reference to SFRS(I) 1-40, Investment Property, identify which of the following journal entries Ruby should record to account for the movement in the fair value of its investment property at 31 December 20X7?","options":[{"je":[{"side":"Dr","account":"Revaluation surplus","amount":225000,"el":"e"},{"side":"Cr","account":"Retained earnings","amount":225000,"el":"e"}],"pit":"fv-to-re","why":"This moves an amount between two {e|equity reserves} and never touches the property. Investment property gains are {i|income} in profit or loss."},{"je":[{"side":"Dr","account":"Investment property","amount":225000,"el":"a"},{"side":"Cr","account":"Other comprehensive income","amount":225000,"el":"e"}],"pit":"fv-to-oci","why":"That is PPE revaluation treatment. Under the fair value model for investment property, the {i|gain} goes to profit or loss."},{"je":[{"side":"Dr","account":"Retained earnings","amount":225000,"el":"e"},{"side":"Cr","account":"Investment property","amount":225000,"el":"a"}],"why":"Fair value went up, so the {a|property} increases (debit), and the gain is {i|income}, not a reduction of {e|retained earnings}."},{"je":[{"side":"Dr","account":"Investment property","amount":225000,"el":"a"},{"side":"Cr","account":"Statement of profit or loss – fair value gain","amount":225000,"el":"i"}],"ok":true,"why":"1,575,000 − 1,350,000 = 225,000. Under the fair value model the {a|property} goes up to fair value and the {i|gain} goes to profit or loss."}]},{"id":"q2","case":"ruby","lo":17,"type":"sfp-amount","q":"At what amount should Ruby present its investment property in the statement of financial position at 31 December 20X7?","options":[{"t":"$1,350,000","pit":"stale-ca","why":"That was fair value at the start of the year. Under the fair value model it is carried at fair value at the reporting date."},{"t":"$1,575,000","ok":true,"why":"Fair value at the reporting date. No {x|depreciation} under the fair value model."},{"t":"$1,575,000 less a year’s depreciation","pit":"depreciate-fv","why":"{a|Investment property} under the fair value model is not {x|depreciated}."},{"t":"$225,000","why":"That is the {i|gain} for the year, not the {a|carrying amount}."}]},{"id":"q3","case":"ruby","lo":17,"type":"classify-ip","q":"Why is Ruby’s freehold commercial property classified as investment property?","options":[{"t":"Because it is freehold rather than leasehold","why":"Tenure doesn’t decide it. Owned and leased property can both be investment property."},{"t":"Because it is held to earn rental income, not used in Ruby’s jewellery business or held for sale","ok":true,"why":"That is the definition: held for rent or capital appreciation, not own use or sale."},{"t":"Because Ruby chose to revalue it","why":"Classification comes first; the measurement model follows."},{"t":"Because it is commercial rather than residential property","why":"The type of building is irrelevant; the purpose of holding it decides."}]},{"id":"q4","case":"ruby","lo":17,"type":"fv-entry","q":"Suppose instead that the property’s fair value at 31 December 20X7 had been $1,290,000. Which entry should Ruby record?","options":[{"je":[{"side":"Dr","account":"Other comprehensive income","amount":60000,"el":"e"},{"side":"Cr","account":"Investment property","amount":60000,"el":"a"}],"pit":"fv-to-oci","why":"{x|Fair value losses} on investment property go to profit or loss, just as {i|gains} do."},{"je":[{"side":"Dr","account":"Statement of profit or loss – fair value loss","amount":60000,"el":"x"},{"side":"Cr","account":"Investment property","amount":60000,"el":"a"}],"ok":true,"why":"1,350,000 − 1,290,000 = 60,000 {x|loss} in profit or loss."},{"je":[{"side":"Dr","account":"Revaluation surplus","amount":60000,"el":"e"},{"side":"Cr","account":"Investment property","amount":60000,"el":"a"}],"pit":"fv-to-oci","why":"There is no {e|revaluation surplus} for investment property under the fair value model."},{"t":"No entry until the property is sold","why":"Fair value changes are recognised at every reporting date, losses included."}]},{"id":"q5","case":"ruby","lo":18,"type":"transfer-other","q":"On 1 January 20X8 Ruby moves its own showroom into the property. Fair value that day is still $1,575,000. At what amount is the property first recognised as {a|PPE}?","options":[{"t":"$1,350,000, its fair value on 1 January 20X7","pit":"deemed-cost-old","why":"{a|Deemed cost} is fair value at the date of change in use, not an earlier value."},{"t":"$1,575,000, its fair value at the date of change, as deemed cost","ok":true,"why":"On a transfer from {a|investment property} to {a|PPE}, fair value at the date of change becomes deemed cost. {x|Depreciation} starts from there."},{"t":"$1,575,000, with the 225,000 gain for 20X7 reclassified to OCI","pit":"fv-to-oci","why":"{i|Gains} already recognised in profit or loss stay there."},{"t":"Its original purchase cost, because PPE is measured at cost","pit":"deemed-cost-old","why":"The fair value at the date of change is the {a|deemed cost}."}]},{"id":"q6","case":"sentosa","lo":17,"type":"classify-ip","q":"Which of Sentosa’s properties are investment property?","options":[{"t":"(a) and (b)","pit":"misclassify-inv","why":"The units in (a) are held for sale in the ordinary course of business: {a|inventory}."},{"t":"(b) and (c)","ok":true,"why":"(b) earns {i|rent}; (c) is land held for an undetermined future use. (a) is {a|inventory} and (d) is owner-occupied {a|PPE}."},{"t":"(b), (c) and (d)","pit":"misclassify-ppe","why":"The head office is owner-occupied: {a|PPE}."},{"t":"(b) only","why":"Land held for a currently undetermined future use is also investment property."}]},{"id":"q7","case":"sentosa","lo":17,"type":"initial-cost","q":"At what amount should Sentosa initially recognise building (b)?","options":[{"t":"$5,400,000","pit":"expense-tc","why":"Legal fees and stamp duty are transaction costs and are part of the {a|cost}."},{"t":"$5,607,000","ok":true,"why":"5,400,000 + 45,000 + 162,000 = {a|5,607,000}. The reception is not part of cost: it is an {x|expense}."},{"t":"$5,637,000","why":"The tenants’ reception is a start-up cost: an {x|expense}."},{"t":"$5,445,000","pit":"expense-tc","why":"Stamp duty is a transaction cost and belongs in {a|cost}."}]},{"id":"q8","case":"sentosa","lo":17,"type":"fv-entry","q":"How should Sentosa account for the change in value of building (b) at 31 December 20X3?","options":[{"t":"A gain of $193,000 in profit or loss","ok":true,"why":"5,800,000 − {a|cost} 5,607,000 = {i|193,000 gain}, to profit or loss under the fair value model."},{"t":"A gain of $193,000 in other comprehensive income","pit":"fv-to-oci","why":"Investment property {i|gains} under the fair value model go to profit or loss."},{"t":"A gain of $400,000 in profit or loss","pit":"expense-tc","why":"Measures the {i|gain} from the purchase price, ignoring the transaction costs included in {a|cost}."},{"t":"No gain; the building is held at cost until it is sold","why":"Sentosa uses the fair value model, so it remeasures every reporting date."}]},{"id":"q9","case":"sentosa","lo":18,"type":"transfer-other","q":"On 1 November 20X3, Sentosa leases two of the units in (a) to a tenant for 2 years under an operating lease. Their {a|carrying amount} is $1,900,000 and fair value $2,150,000. How is the transfer accounted for?","options":[{"t":"Transfer to investment property at $2,150,000; 250,000 to profit or loss","ok":true,"why":"{a|Inventory} → {a|investment property}: the difference between fair value and {a|carrying amount} is a {i|gain} in profit or loss."},{"t":"Transfer to investment property at $2,150,000; 250,000 to the revaluation surplus (OCI)","pit":"inv-ip-to-oci","why":"The {e|revaluation surplus} (OCI) is for PPE → investment property. From {a|inventory}, the difference goes to P&L."},{"t":"Transfer to investment property at $1,900,000; no gain","why":"That is the cost-model treatment. Sentosa uses the fair value model."},{"t":"No transfer: the units stay inventory because Sentosa may sell them later","why":"The start of an operating lease is evidence of a change in use. They are now {a|investment property}."}]},{"id":"q10","case":"sentosa","lo":18,"type":"transfer-other","q":"On 15 December 20X3, Sentosa’s directors resolve to use land (c) as the site of a future head office. No plans have been drawn up and no work has started. How should (c) be treated at 31 December 20X3?","options":[{"t":"Transfer it to PPE at fair value","pit":"intention-transfer","why":"A change in intention is not a change in use. Nothing has started."},{"t":"Transfer it to PPE at cost","pit":"intention-transfer","why":"No transfer is allowed without a change in use."},{"t":"Keep it as investment property at fair value","ok":true,"why":"Only management’s intention has changed. Without evidence of a change in use, it stays {a|investment property}."},{"t":"Transfer it to inventory","why":"There is no development with a view to sale, and no change in use."}]},{"id":"q11","lo":17,"type":"classify-ip","q":"Which of the following is investment property of its owner?","options":[{"t":"A hotel owned and managed by the reporting entity","pit":"misclassify-ppe","why":"The owner provides significant services: owner-occupied {a|PPE}."},{"t":"A vacant building held to be leased out under operating leases","ok":true,"why":"A vacant building held to be leased out is {a|investment property}."},{"t":"A property bought exclusively with a view to resale in the near future","pit":"misclassify-inv","why":"Held for sale in the ordinary course of business: {a|inventory}."},{"t":"A building leased to another party under a finance lease","why":"The lessor derecognises it and recognises a {a|lease receivable}."}]},{"id":"q12","lo":17,"type":"model-effect","q":"An entity holds three investment properties. Which statement about measurement after recognition is correct?","options":[{"t":"It may use the fair value model for one property and the cost model for the others","why":"One model must be applied to all investment property."},{"t":"It chooses one model, fair value or cost, and applies it to all its investment property","ok":true,"why":"The choice is an accounting policy for all investment property."},{"t":"Under the fair value model it depreciates the buildings and revalues them each year","pit":"depreciate-fv","why":"No {x|depreciation} under the fair value model."},{"t":"Under the cost model it remeasures to fair value but sends changes to OCI","why":"The cost model doesn’t remeasure to fair value; it discloses fair value."}]},{"id":"q13","lo":17,"type":"sfp-amount","q":"A company’s trial balance at 31 December shows {a|investment property} at $12,400,000, its fair value at the previous year end. An independent valuer appraises it at $13,100,000 at 31 December. The company uses the fair value model. What amount appears in the statement of financial position?","options":[{"t":"$12,400,000","pit":"stale-ca","why":"The trial balance {a|carrying amount} is last year’s fair value. It must be updated to this year’s."},{"t":"$13,100,000","ok":true,"why":"Fair value at the reporting date. The 700,000 increase is a {i|gain} in profit or loss."},{"t":"$13,100,000 less depreciation for the year","pit":"depreciate-fv","why":"No {x|depreciation} under the fair value model."},{"t":"$12,400,000, with the 700,000 increase disclosed only","why":"Disclosing instead of recognising fair value is the cost model."}]},{"id":"q14","lo":18,"type":"transfer-ppe","q":"A company moves out of its own office ({a|cost} $800,000, {a|accumulated depreciation} $320,000) and leases it to a tenant. Fair value at the date of change is $700,000. It uses the fair value model. How is the difference treated?","options":[{"t":"$220,000 gain in profit or loss","pit":"ppe-ip-to-pl","why":"An increase on transfer from PPE is treated like a PPE revaluation: it goes to the {e|revaluation surplus} (OCI)."},{"t":"$220,000 to the revaluation surplus through OCI","ok":true,"why":"{a|Carrying amount} 480,000; fair value 700,000 → increase 220,000 to the {e|revaluation surplus} (OCI)."},{"t":"No difference: transferred at its {a|carrying amount} of $480,000","why":"That is cost-model treatment. Under the fair value model it comes in at fair value."},{"t":"$100,000 loss in profit or loss","why":"Compares fair value with {a|cost} instead of {a|carrying amount}."}]},{"id":"q15","lo":18,"type":"disposal","q":"An investment property carried at fair value of $3,600,000 is sold for $3,750,000, with agent’s fees of $45,000. What gain is recognised in profit or loss?","options":[{"t":"$150,000","why":"Ignores the selling costs. The {i|gain} uses {a|net disposal proceeds}."},{"t":"$105,000","ok":true,"why":"{a|Net proceeds} (3,750,000 − 45,000) − {a|carrying amount} 3,600,000 = {i|105,000 gain}."},{"t":"$3,750,000","why":"The whole proceeds are not a {i|gain}; the {a|carrying amount} is deducted."},{"t":"$105,000, recognised in OCI","pit":"fv-to-oci","why":"A {i|gain on disposal} goes to profit or loss."}]},{"id":"q16","lo":19,"type":"disclosure","q":"Which disclosure is required for an entity that uses the **cost model** for investment property?","options":[{"t":"None beyond those for PPE, because the property is at cost","pit":"cost-model-no-fv","why":"Investment property under the cost model must also disclose its fair value."},{"t":"The fair value of the investment property","ok":true,"why":"Fair value is disclosed even though it isn’t recognised."},{"t":"A revaluation surplus reconciliation","why":"There is no {e|revaluation surplus} under the cost model."},{"t":"Next year’s budgeted rental income","why":"Not required."}]},{"id":"q17","lo":19,"type":"disclosure","q":"Which disclosure is specifically required under the **fair value model**?","options":[{"t":"Depreciation methods and useful lives","why":"Those are cost-model disclosures; no {x|depreciation} under the fair value model."},{"t":"A reconciliation of the {a|carrying amount}, showing additions, disposals, {i|fair value gains} and {x|losses}, and transfers","ok":true,"why":"The reconciliation explains how the {a|carrying amount} moved during the year."},{"t":"The original cost of each property","why":"Not required."},{"t":"{a|Gross carrying amount} and {a|accumulated depreciation}","why":"Cost-model disclosures."}]},{"id":"q18","lo":17,"type":"model-effect","q":"On 1 January 20X1 Bayfront buys a building to lease out for $2,000,000 plus legal fees of $40,000 (building only, 40-year life, no residual value, straight-line). Its fair value at 31 December 20X1 is $2,100,000. What is the effect on 20X1 profit under the fair value model and under the cost model?","options":[{"t":"Fair value model +60,000; cost model −51,000","ok":true,"why":"{i|Fair value gain} 2,100,000 − 2,040,000 = 60,000; cost model {x|depreciation} 2,040,000 ÷ 40 = 51,000."},{"t":"Fair value model +9,000; cost model −51,000","pit":"depreciate-fv","why":"Depreciates under the fair value model too."},{"t":"Fair value model nil (gain to OCI); cost model −51,000","pit":"fv-to-oci","why":"The {i|fair value gain} goes to profit or loss."},{"t":"Fair value model +100,000; cost model −50,000","pit":"expense-tc","why":"Leaves the legal fees out of {a|cost}."}]}]},"exam":{"cases":{"kallang":{"name":"Kallang Logistics","text":["Kallang Logistics Pte Ltd (Kallang) has a 31 December year end and uses the fair value model for investment property. It depreciates buildings straight-line.","On 1 January 20X1 Kallang bought an office building for $4,000,000 (ignore land). Useful life 40 years, no residual value. It has never been revalued.","On 1 July 20X6 Kallang moved its staff out and leased the whole building to an unrelated tenant under an operating lease. Fair value on 1 July 20X6 was $4,200,000.","Fair value was $4,050,000 at 31 December 20X6 and $4,300,000 at 31 December 20X7.","On 31 March 20X8 Kallang sold the building for $4,400,000, paying agents’ fees of $60,000. It was not remeasured between 31 December 20X7 and the sale."]},"tampines":{"name":"Tampines Homes","text":["Tampines Homes Pte Ltd (Tampines) develops and sells residential property. Its year ends on 31 December 20X4 and it uses the fair value model for investment property.","**Block A:** a block of unsold flats carried in inventory at $2,600,000. On 1 April 20X4 Tampines leased all the flats to tenants under 3-year operating leases. Fair value was $3,050,000 on 1 April 20X4 and $3,180,000 on 31 December 20X4. The block’s remaining useful life is 50 years.","**Office tower:** held as investment property, fair value $5,000,000 at 31 December 20X3. On 1 July 20X4 Tampines moved its own head office into the whole tower. Fair value was $5,240,000 on 1 July 20X4 and $5,300,000 on 31 December 20X4. Remaining useful life from 1 July 20X4 is 40 years, no residual value (ignore land).","**Land:** held as investment property. On 1 October 20X4 the board decided to sell the land as it is, without any development, and appointed an agent."]}},"questions":[{"id":"x1","case":"kallang","lo":18,"type":"transfer-ppe","q":"What is the {a|carrying amount} of the building immediately before the transfer on 1 July 20X6?","options":[{"t":"$3,500,000","why":"Only 5 years’ {x|depreciation}. The building is depreciated up to the date of change, so 5.5 years."},{"t":"$3,450,000","ok":true,"why":"{a|Cost} 4,000,000 − {a|accumulated depreciation} (100,000 × 5.5) = {a|3,450,000}."},{"t":"$4,000,000","why":"{a|Cost}, ignoring {a|accumulated depreciation}."},{"t":"$4,200,000","why":"That is fair value at the date of change, not the {a|carrying amount} before it."}]},{"id":"x2","case":"kallang","lo":18,"type":"transfer-ppe","q":"Which journal entry records the transfer on 1 July 20X6?","options":[{"je":[{"side":"Dr","account":"Investment property","amount":4200000,"el":"a"},{"side":"Dr","account":"Accumulated depreciation","amount":550000,"el":"a"},{"side":"Cr","account":"Building (PPE)","amount":4000000,"el":"a"},{"side":"Cr","account":"Fair value gain (P&L)","amount":750000,"el":"i"}],"pit":"ppe-ip-to-pl","why":"An increase on transfer from PPE is treated like a PPE revaluation: {e|revaluation surplus} (OCI), not P&L."},{"je":[{"side":"Dr","account":"Investment property","amount":4200000,"el":"a"},{"side":"Dr","account":"Accumulated depreciation","amount":550000,"el":"a"},{"side":"Cr","account":"Building (PPE)","amount":4000000,"el":"a"},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":750000,"el":"e"}],"ok":true,"why":"{a|Carrying amount} 3,450,000; fair value 4,200,000; increase 750,000 to the {e|revaluation surplus}."},{"je":[{"side":"Dr","account":"Investment property","amount":4200000,"el":"a"},{"side":"Dr","account":"Accumulated depreciation","amount":500000,"el":"a"},{"side":"Cr","account":"Building (PPE)","amount":4000000,"el":"a"},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":700000,"el":"e"}],"why":"Leaves out the 6 months’ {x|depreciation} for 20X6 before the transfer."},{"je":[{"side":"Dr","account":"Investment property","amount":3450000,"el":"a"},{"side":"Dr","account":"Accumulated depreciation","amount":550000,"el":"a"},{"side":"Cr","account":"Building (PPE)","amount":4000000,"el":"a"}],"why":"Transfers at {a|carrying amount}, which is the cost-model treatment. Under the fair value model the property comes in at fair value."}]},{"id":"x3","case":"kallang","lo":17,"type":"fv-entry","q":"Which entry records the change in value at 31 December 20X6?","options":[{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":150000,"el":"e"},{"side":"Cr","account":"Investment property","amount":150000,"el":"a"}],"pit":"fv-to-oci","why":"The {e|surplus} arose while the building was {a|PPE}. Once it is {a|investment property}, all fair value changes go to profit or loss."},{"je":[{"side":"Dr","account":"Fair value loss (P&L)","amount":150000,"el":"x"},{"side":"Cr","account":"Investment property","amount":150000,"el":"a"}],"ok":true,"why":"4,200,000 − 4,050,000 = 150,000 {x|loss} to profit or loss. The 750,000 {e|surplus} is left alone."},{"je":[{"side":"Dr","account":"Depreciation expense","amount":50000,"el":"x"},{"side":"Dr","account":"Fair value loss (P&L)","amount":100000,"el":"x"},{"side":"Cr","account":"Investment property","amount":150000,"el":"a"}],"pit":"depreciate-fv","why":"No {x|depreciation} after the transfer: the fall is all a {x|fair value loss}."},{"t":"No entry: the fall is covered by the revaluation surplus","pit":"fv-to-oci","why":"Fair value changes must be recognised, and they go to P&L (here a {x|loss})."}]},{"id":"x4","case":"kallang","lo":17,"type":"model-effect","q":"Ignoring {i|rental income}, what is the total effect of the building on Kallang’s profit or loss for 20X6?","options":[{"t":"A profit of $550,000","pit":"ppe-ip-to-pl","why":"Treats the transfer increase as P&L {i|income}. It goes to the {e|revaluation surplus} (OCI)."},{"t":"A loss of $200,000","ok":true,"why":"{x|Depreciation} to 30 June 50,000 + {x|fair value loss} 150,000 = 200,000 charged to profit or loss."},{"t":"A loss of $150,000","why":"Leaves out the {x|depreciation} charged for January to June, while it was still {a|PPE}."},{"t":"A loss of $250,000","pit":"depreciate-fv","why":"Charges a full year’s {x|depreciation}, but depreciation stops at the date of transfer."}]},{"id":"x5","case":"kallang","lo":18,"type":"disposal","q":"How does Kallang account for the sale on 31 March 20X8?","options":[{"t":"Gain of $40,000 in profit or loss; the 750,000 revaluation surplus may be transferred directly to retained earnings","ok":true,"why":"Net proceeds 4,340,000 − {a|carrying amount} 4,300,000 = {i|40,000 gain}. The {e|surplus} never passes through P&L."},{"t":"Gain of $790,000 in profit or loss, including the revaluation surplus","pit":"recycle-surplus","why":"The {e|revaluation surplus} is not reclassified to profit or loss."},{"t":"Gain of $100,000 in profit or loss","why":"Ignores the agents’ fees. The {i|gain} uses {a|net proceeds}."},{"t":"Gain of $890,000 in profit or loss","why":"Uses the old {a|PPE carrying amount}. The building was carried at fair value since the transfer."}]},{"id":"x6","case":"tampines","lo":18,"type":"transfer-other","q":"Which journal entry records the transfer of Block A on 1 April 20X4?","options":[{"je":[{"side":"Dr","account":"Investment property","amount":3050000,"el":"a"},{"side":"Cr","account":"Inventory","amount":2600000,"el":"a"},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":450000,"el":"e"}],"pit":"inv-ip-to-oci","why":"The {e|revaluation surplus} (OCI) is for transfers from PPE. From {a|inventory}, the difference goes to profit or loss."},{"je":[{"side":"Dr","account":"Investment property","amount":3050000,"el":"a"},{"side":"Cr","account":"Inventory","amount":2600000,"el":"a"},{"side":"Cr","account":"Gain on transfer (P&L)","amount":450000,"el":"i"}],"ok":true,"why":"Fair value 3,050,000 − {a|carrying amount} 2,600,000 = {i|450,000 gain} to profit or loss."},{"je":[{"side":"Dr","account":"Investment property","amount":2600000,"el":"a"},{"side":"Cr","account":"Inventory","amount":2600000,"el":"a"}],"why":"Transfer at {a|carrying amount} is the cost-model treatment. Tampines uses the fair value model."},{"je":[{"side":"Dr","account":"Investment property","amount":3050000,"el":"a"},{"side":"Cr","account":"Revenue","amount":3050000,"el":"i"},{"side":"Dr","account":"Cost of sales","amount":2600000,"el":"x"},{"side":"Cr","account":"Inventory","amount":2600000,"el":"a"}],"why":"Nothing has been sold, so there is no {i|revenue}. The flats were leased, not sold."}]},{"id":"x7","case":"tampines","lo":17,"type":"model-effect","q":"Ignoring {i|rental income}, how much does Block A add to Tampines’ profit or loss for 20X4?","options":[{"t":"$130,000","pit":"inv-ip-to-oci","why":"Leaves out the {i|transfer gain}, which goes to profit or loss for a transfer from {a|inventory}."},{"t":"$450,000","pit":"stale-ca","why":"Leaves out the year-end remeasurement to fair value."},{"t":"$580,000","ok":true,"why":"{i|Transfer gain} 450,000 + year-end {i|fair value gain} 130,000 (3,180,000 − 3,050,000) = 580,000."},{"t":"$534,250","pit":"depreciate-fv","why":"Deducts {x|depreciation} of 45,750, but {a|investment property} under the fair value model is not depreciated. The useful life is a red herring."}]},{"id":"x8","case":"tampines","lo":18,"type":"transfer-other","q":"Which journal entry records the office tower’s change in use on 1 July 20X4?","options":[{"je":[{"side":"Dr","account":"Building (PPE)","amount":5240000,"el":"a"},{"side":"Cr","account":"Investment property","amount":5000000,"el":"a"},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":240000,"el":"e"}],"pit":"fv-to-oci","why":"Up to the date of change it is {a|investment property}, so its {i|fair value gain} goes to profit or loss."},{"je":[{"side":"Dr","account":"Building (PPE)","amount":5000000,"el":"a"},{"side":"Cr","account":"Investment property","amount":5000000,"el":"a"}],"pit":"deemed-cost-old","why":"Uses last year’s fair value. Remeasure to fair value at the date of change first."},{"je":[{"side":"Dr","account":"Building (PPE)","amount":5240000,"el":"a"},{"side":"Cr","account":"Investment property","amount":5000000,"el":"a"},{"side":"Cr","account":"Fair value gain (P&L)","amount":240000,"el":"i"}],"ok":true,"why":"Remeasure to 5,240,000 ({i|gain} 240,000 to P&L), then transfer at that amount as the {a|PPE’s deemed cost}."},{"je":[{"side":"Dr","account":"Building (PPE)","amount":5240000,"el":"a"},{"side":"Cr","account":"Investment property","amount":5000000,"el":"a"},{"side":"Cr","account":"Retained earnings","amount":240000,"el":"e"}],"pit":"fv-to-re","why":"The {i|gain} goes through profit or loss, not straight to {e|retained earnings}."}]},{"id":"x9","case":"tampines","lo":18,"type":"transfer-other","q":"At what amount is the office tower carried at 31 December 20X4?","options":[{"t":"$5,300,000","why":"It is {a|PPE} now, measured from its {a|deemed cost} and depreciated. It is no longer remeasured to fair value under SFRS(I) 1-40."},{"t":"$5,174,500","ok":true,"why":"{a|Deemed cost} 5,240,000 − 6 months’ {x|depreciation} (5,240,000 ÷ 40 × 6/12 = 65,500) = {a|5,174,500}."},{"t":"$4,937,500","pit":"deemed-cost-old","why":"Uses last year’s fair value as {a|deemed cost}. {a|Deemed cost} is fair value at the date of change."},{"t":"$5,240,000","why":"Forgets to depreciate the {a|PPE} from 1 July."}]},{"id":"x10","case":"tampines","lo":18,"type":"transfer-other","q":"How should Tampines account for the land at 31 December 20X4?","options":[{"t":"Transfer it to inventory at fair value on 1 October 20X4","pit":"intention-transfer","why":"A decision to sell without development is not a change in use. It stays {a|investment property}."},{"t":"Transfer it to inventory at its {a|carrying amount}","pit":"intention-transfer","why":"No transfer happens, at any amount."},{"t":"Keep it as investment property, remeasured to fair value at 31 December 20X4","ok":true,"why":"Land to be sold without development stays {a|investment property} until it is derecognised, still under the fair value model."},{"t":"Stop remeasuring it and freeze it at its 1 October 20X4 fair value","why":"It is still {a|investment property} under the fair value model, so it is remeasured at the reporting date."}]},{"id":"x11","lo":19,"type":"disclosure","q":"On 1 January 20X2 an entity bought an investment property for $6,000,000, of which $1,500,000 relates to land. The building has a useful life of 30 years, no residual value. It uses the **cost model**. Fair value at 31 December 20X4 is $7,200,000. Which is correct for 31 December 20X4?","options":[{"t":"{a|Carrying amount} $5,550,000; fair value $7,200,000 disclosed in the notes","ok":true,"why":"Building {x|depreciation} (6,000,000 − 1,500,000) ÷ 30 = 150,000 a year × 3 = 450,000. Land is not depreciated. Fair value must be disclosed."},{"t":"{a|Carrying amount} $7,200,000","why":"The cost model doesn’t remeasure to fair value."},{"t":"{a|Carrying amount} $5,400,000; fair value $7,200,000 disclosed","why":"Depreciates the land as well as the building."},{"t":"{a|Carrying amount} $5,550,000; no fair value disclosure needed","pit":"cost-model-no-fv","why":"Fair value is still disclosed under the cost model."}]},{"id":"x12","lo":17,"type":"model-effect","q":"On 1 January 20X5 an entity buys a building to lease out for $8,000,000, paying stamp duty of $240,000 and legal fees of $60,000. Useful life 50 years, no residual value (ignore land). Fair value at 31 December 20X5 is $8,500,000. By how much is 20X5 profit higher under the fair value model than under the cost model?","options":[{"t":"$200,000","why":"That is only the {i|fair value gain}. Under the cost model, profit is also reduced by {x|depreciation}."},{"t":"$366,000","ok":true,"why":"Fair value model: {i|gain} 8,500,000 − 8,300,000 = +200,000. Cost model: {x|depreciation} 8,300,000 ÷ 50 = −166,000. Difference 366,000."},{"t":"$660,000","pit":"expense-tc","why":"Leaves the transaction costs out of {a|cost} (they would then be {x|expensed} under both models, which cancels out but inflates the {i|gain} and cuts {x|depreciation})."},{"t":"$34,000","pit":"depreciate-fv","why":"Nets {x|depreciation} against the {i|gain}, as if the fair value model also depreciated."}]},{"id":"x13","lo":17,"type":"classify-ip","q":"P Ltd owns an office building that it leases, at market rent, to S Ltd, its wholly owned subsidiary, which uses it as S Ltd’s head office. How is the building classified?","options":[{"t":"Investment property in both P Ltd’s own financial statements and the group’s consolidated statements","why":"From the group’s point of view the building is used by the group itself: owner-occupied."},{"t":"PPE in both P Ltd’s own financial statements and the consolidated statements","why":"For P Ltd alone, the building is leased to another entity to earn rent."},{"t":"Investment property in P Ltd’s own financial statements; PPE in the consolidated statements","ok":true,"why":"P Ltd earns {i|rent} from it; the group occupies it."},{"t":"Inventory in P Ltd’s own financial statements, because it could be sold to S Ltd","why":"It is not held for sale in the ordinary course of business."}]},{"id":"x14","lo":17,"type":"classify-ip","q":"Which of the following should be classified as investment property by the reporting entity?","options":[{"t":"A dormitory the entity owns and lets to its own factory workers at market rent","pit":"misclassify-ppe","why":"Property occupied by employees is owner-occupied, whatever the rent."},{"t":"A building the entity is constructing for a customer under a construction contract","why":"Built for a customer: {i|revenue} under SFRS(I) 15, not investment property."},{"t":"A building under construction that the entity will lease out under operating leases when complete","ok":true,"why":"Property being built for future use as investment property is {a|investment property}."},{"t":"Serviced apartments where the entity provides daily housekeeping, meals and a concierge","pit":"misclassify-ppe","why":"Significant services, like a hotel: owner-occupied {a|PPE}."}]},{"id":"x15","lo":18,"type":"transfer-ppe","q":"An entity measures its buildings under the PPE revaluation model. One building has a {e|revaluation surplus} of $100,000. The entity moves out and leases it to a tenant. {a|Carrying amount} at the date of change is $2,000,000; fair value is $1,850,000. It uses the fair value model for investment property. How is the fall in value treated?","options":[{"t":"$150,000 loss in profit or loss","why":"A decrease first uses up that building’s existing {e|revaluation surplus} in OCI."},{"t":"$100,000 debited to the revaluation surplus (OCI) and $50,000 to profit or loss","ok":true,"why":"Treated as a PPE revaluation decrease: the fall of 150,000 first reduces the 100,000 {e|surplus} on this building; the remaining 50,000 is a {x|loss} in P&L."},{"t":"$150,000 debited to the revaluation surplus (OCI)","why":"OCI can only absorb the decrease up to the {e|surplus} on that building; the rest is a {x|loss} in P&L."},{"t":"No loss: the building is transferred at its {a|carrying amount}","why":"Under the fair value model the building comes in at fair value."}]}]},"prepared":true},{"id":"financial-assets","code":"B1.4","title":"Basic Financial Assets","subtitle":"SFRS(I) 9 · classification and measurement","los":{"20":"Recognition and measurement of different financial assets","21":"Financial statement effects of the measurement methods"},"accounts":[{"name":"Investment in bonds","el":"a"},{"name":"Investment in shares","el":"a"},{"name":"Cash","el":"a"},{"name":"Trade receivables","el":"a"},{"name":"Loss allowance","el":"a"},{"name":"Accruals","el":"l"},{"name":"Fair value reserve (OCI)","el":"e"},{"name":"Retained earnings","el":"e"},{"name":"Interest income","el":"i"},{"name":"Dividend income","el":"i"},{"name":"Fair value gain (P&L)","el":"i"},{"name":"Gain on disposal (P&L)","el":"i"},{"name":"Fair value loss (P&L)","el":"x"},{"name":"Transaction costs expense","el":"x"}],"map":{"classify":{"label":"Debt or equity · SPPI · business model","star":"Business model + SPPI decide AC, FVOCI or FVTPL"},"recognise":{"label":"When party to the contract"},"initial":{"label":"FV + transaction costs (FVTPL: expensed)"},"subsequent":{"label":"AC, FVOCI or FVTPL","star":"Splits three ways: P&L, OCI, or neither"},"derecognise":{"label":"Sale: recycle debt OCI, never equity"},"present":{"label":"Same TCI, different P&L/OCI split"}},"preamble":["Welcome to the money cupboard: the bonds, loans, receivables and shares a company holds as an investor (SFRS(I) 9). With PPE and investment property you got a menu (cost or fair value, your pick). Not here. Two tests sort each asset into a category, and the category calls every shot after that.","Here’s the route:","1. **Classify** it with two tests: **SPPI** (what cash does it pay?) and the **business model** (why do you hold it?). ★ The special part: get this wrong and everything downstream is wrong too.","2. **Recognise** it when you become a party to the contract. A quick pit stop.","3. **Measure it on day one** at **fair value + transaction costs**. Mostly vanilla, except FVTPL expenses the costs.","4. **Measure it afterwards** one of three ways: amortised cost, FVOCI or FVTPL. ★ The main event: the same asset’s gains land in P&L, in OCI, or nowhere.","5. **Derecognise** it on sale. ★ FVOCI debt gains are recycled to P&L; equity gains never are.","6. **Present** the three categories side by side and see what really changes (spoiler: not the cash).","+ Pack two things for the trip: the effective interest roll-forward ({a|opening} + {i|interest} − {a|cash} = {a|closing}) and one mantra, *collect → AC, collect + sell → FVOCI, anything else → FVTPL*."],"intros":{"classify":"First stop, and the big one. Before we can measure anything we need to know what we’re holding and why, so SFRS(I) 9 asks two questions: **SPPI** (is the cash just principal plus interest?) and the **business model** (collect, collect and sell, or trade?). ★ Special: unlike PPE or investment property there’s no policy menu. The tests sort the asset into a category, and the category decides everything that follows.","recognise":"Classified and labelled. So when does the thing actually land on the balance sheet? This is a quick, vanilla pit stop: you recognise it when you sign up to the contract, not when the board daydreams about buying it. The only wrinkle: a regular-way trade can use trade date or settlement date, as long as you pick one and stick with it.","initial":"Now that we know what it is and when it arrives, time to put a number on it. Mostly vanilla: fair value plus transaction costs, same as PPE or investment property. ★ Except FVTPL, which treats {x|brokerage} like a bad first date: expensed and forgotten. Then we price a bond bought at a discount, the number every later step builds on.","subsequent":"The asset’s on the books at its day-one number; now we follow it through the years. ★ This is the main event, where the category we picked at the start pays off. Amortised cost grinds out {i|effective interest} and ignores the market; FVOCI books the same {i|interest} but shows fair value, with the gap parked in OCI; FVTPL throws everything at P&L. Same bond, three very different-looking statements.","derecognise":"We’ve held it, earned on it and marked it to market; now we sell. The routine bit: {i|gain} or {x|loss} = {a|proceeds} − {a|carrying amount} (the last fair value, not what you paid). ★ The special bit is the gain parked in OCI: FVOCI debt gains get **recycled** to P&L, FVOCI equity gains **never** do. That was the deal you signed when you made the election.","present":"Last stop: step back and look at the whole trip. Nothing new to learn here, just the three categories side by side on one bond. The punchline: FVOCI ties with FVTPL on total comprehensive income and with amortised cost on profit. The category moves the numbers between P&L, OCI and the balance sheet; it never changes the cash."},"pitfalls":{"bm-collect-sell":"Putting “collect and sell” debt at amortised cost (it is FVOCI).","historical-cost":"Choosing “historical cost”, which is not an SFRS(I) 9 category.","shares-at-ac":"Putting shares at amortised cost (shares fail SPPI).","tc-fvtpl-capitalised":"Capitalising transaction costs on FVTPL assets (they are expensed).","tc-expensed-ac":"Expensing transaction costs on amortised cost or FVOCI assets (they are added to the asset).","coupon-not-effective":"Using the coupon, or face value, for {i|interest income} instead of {a|carrying amount} × effective rate.","fvtpl-to-oci":"Sending FVTPL fair value changes (or interest) to OCI.","fvoci-to-pl":"Sending FVOCI equity fair value changes to profit or loss.","fvoci-interest":"Thinking FVOCI debt interest differs from amortised cost (it is the same).","oci-vs-cost":"Measuring the FVOCI debt {e|OCI balance} against original cost instead of amortised cost.","cost-not-last-fv":"Using original cost instead of the last fair value as the {a|carrying amount}.","all-shares":"Remeasuring all the shares bought instead of only those still held.","recycle-equity":"Recycling FVOCI equity gains to profit or loss on sale.","no-recycle-debt":"Forgetting to recycle FVOCI debt gains to profit or loss on sale.","dividend-to-oci":"Putting {i|dividends} on FVOCI equity in OCI (they go to profit or loss)."},"examTypes":[{"id":"classify-bm","title":"Debt held to collect but willing to sell: how is it measured? (practice Q4)","pitfall":"Choosing amortised cost, or “historical cost”","see":"classify"},{"id":"purchase-je","title":"Which entry records the purchase of shares with brokerage? (practice Q31)","pitfall":"Capitalising brokerage on FVTPL shares","see":"initial"},{"id":"fv-movement","title":"Which entry records the year-end fair value movement? (practice Q32)","pitfall":"Sending an FVTPL gain to OCI","see":"subsequent"},{"id":"partial-sale","title":"Which entry records the (partial) sale? (practice Q33)","pitfall":"Using original cost instead of the last fair value","see":"derecognise"},{"id":"remeasure-left","title":"What loss at the next year end, and where? (practice Q34)","pitfall":"Using all the shares instead of those still held; putting it in OCI","see":"subsequent"},{"id":"eir-interest","title":"Interest income or carrying amount on a bond bought at a discount","pitfall":"Using the coupon rate, or face value","see":"subsequent"},{"id":"recycling","title":"What happens to the OCI balance when an FVOCI asset is sold?","pitfall":"Recycling equity gains; not recycling debt gains","see":"derecognise"},{"id":"fs-effects","title":"Profit, OCI and carrying amount under each category","pitfall":"Forgetting FVOCI debt interest is the same as amortised cost","see":"present"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":20,"title":"Financial assets, the Socratic way","body":["Bonds, loans, receivables and shares are all **{a|financial assets}**. SFRS(I) 9 does not measure them all the same way. It asks two questions first, and the answers decide where every later gain or loss lands: **profit or loss, OCI, or nowhere until the asset is sold**.","You will work bucket by bucket: classify, recognise, initial measurement, subsequent measurement (the big one, which splits three ways), derecognition, then presentation.","Each idea starts with a question. Think it through, then reveal the answer. Account names are coloured by element; tap **Legend** any time.","This chapter is worth 5 of the 50 practice-paper questions (Q4 and a four-question case), and both appear in the quizzes at the end."],"id":"intro-imoqej","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-classify","bucket":"classify","sect":1,"part":"Classify"},{"type":"think","bucket":"classify","lo":20,"scenario":"Mei Ling’s company has spare cash. It buys (1) a 3-year Singapore Government Security paying a fixed 5% coupon, and (2) 10,000 shares in a listed bank. It also has (3) trade receivables from customers.","prompt":"All three are financial assets. What would you want to know about each before deciding how to measure it?","answer":["1. **What cash it pays.** The {a|bond} and the {a|receivables} give a contractual right to fixed amounts of cash. The shares give no right to any cash at all: {i|dividends} are at the bank’s discretion, and you only get a residual share if it is wound up.","2. **Why you hold it.** Will you keep the bond to maturity, or sell it when prices are good? Holding for the cash and holding to trade call for different measures.","Those are exactly SFRS(I) 9’s two tests: the **cash flow characteristics** (SPPI) and the **business model**."],"id":"think-uoa97j","sect":1,"part":"Classify"},{"type":"rule","bucket":"classify","lo":20,"title":"What is a financial asset? Debt vs equity","body":["A {a|financial asset} is {a|cash}, an equity instrument of another entity, or a **contractual right to receive cash** or another financial asset (plus some contracts settled in the entity’s own equity).","1. **Debt instruments:** a contractual right to cash, e.g. bonds, loans, deposits, {a|Trade receivables}.","2. **Equity instruments:** a residual interest in another entity, e.g. {a|ordinary shares}.","+ The holder classifies what it holds. A bond is a {a|financial asset} for the investor and a {l|financial liability} for the issuer."],"id":"rule-xot969","sect":1,"part":"Classify"},{"type":"diagram","bucket":"classify","lo":20,"title":"Classify a financial asset: the whole tree","intro":"This is the decision tree from your notes. Take the walkthrough once now; the next pages unpack each question in turn.","notes":{"fa":"Any **contractual right to receive cash** (or another financial asset), or shares in another entity. The holder classifies it on the day it is first recognised.","debt":"A contractual right to cash: bonds, loans, deposits, {a|Trade receivables}. Debt is the only kind that can pass SPPI, so it is the only kind that can reach amortised cost.","eq":"Ordinary shares in another entity: a residual interest with **no right to any cash**. Shares skip the SPPI and business model tests completely.","sppi":"Test 1, **cash flow characteristics**: are the cash flows *solely payments of principal and interest*? Interest = time value of money + credit risk. Returns linked to share prices, commodities or profits fail.","bm":"Test 2, **business model**, set by key management for a whole portfolio: how does the entity turn these assets into cash? By collecting, by collecting and selling, or some other way (trading).","el":"An **irrevocable** election made on day one, share by share, and only for shares **not held for trading**. Without it, shares are FVTPL.","ac":"**Hold to collect** + SPPI. Measured at cost plus effective interest, less a {a|loss allowance}. Fair value changes are ignored. Occasional sales on credit downgrade do not break this model.","fvoci":"**Collect and sell** + SPPI. {i|Interest} to P&L exactly as under amortised cost; the {a|asset} sits at fair value and the gap goes to {e|Fair value reserve (OCI)}. **Recycled** to P&L on sale.","fvtpl":"The **catch-all**: debt failing SPPI, debt in a trading model, shares with no election. Everything (fair value changes, {i|interest}, {i|dividends}) goes to P&L, and {x|transaction costs} are expensed. Debt can also be *designated* here on day one to remove an accounting mismatch.","fvoce":"Elected shares. Fair value changes go to OCI and are **never** recycled, even on sale. {i|Dividend income} still goes to P&L. No impairment test."},"walk":[{"nodes":["fa","debt","eq"],"text":"Start at the top. First split: is it **debt** (a right to cash) or **equity** (shares)? The two go down different paths."},{"nodes":["debt","sppi"],"text":"Debt meets **test 1, SPPI**: is the cash just principal plus interest? If **no**, it drops straight to FVTPL."},{"nodes":["sppi","bm"],"text":"If SPPI is met, apply **test 2, the business model** of the portfolio."},{"nodes":["bm","ac","fvoci","fvtpl"],"text":"**Collect** → amortised cost. **Collect and sell** → FVOCI (debt). **Anything else** → FVTPL."},{"nodes":["eq","el","fvoce","fvtpl"],"text":"Shares never pass SPPI, so the only question is the **day-one election**. Elected (and not for trading) → FVOCI (equity). Otherwise → FVTPL, the default."},{"nodes":["fvoci","fvoce"],"text":"Two different FVOCIs. **Debt**: OCI is recycled to P&L on sale. **Equity**: OCI is never recycled. Keep them apart."}],"caption":"Collect → amortised cost · collect + sell → FVOCI · anything else → FVTPL.","id":"diagram-c8ab2e","sect":1,"part":"Classify","svg":"\u003csvg width=\"100%\" style=\"min-width:550px\" role=\"img\"\n viewBox=\"0.00 0.00 500.00 316.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 304.94)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-304.94 488.7,-304.94 488.7,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>fa\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M373.4,-294.14C373.4,-294.14 302.12,-294.14 302.12,-294.14 296.12,-294.14 290.12,-288.14 290.12,-282.14 290.12,-282.14 290.12,-270.14 290.12,-270.14 290.12,-264.14 296.12,-258.14 302.12,-258.14 302.12,-258.14 373.4,-258.14 373.4,-258.14 379.4,-258.14 385.4,-264.14 385.4,-270.14 385.4,-270.14 385.4,-282.14 385.4,-282.14 385.4,-288.14 379.4,-294.14 373.4,-294.14\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"298.76\" y=\"-272.69\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Financial asset\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>debt\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M309.76,-235.14C309.76,-235.14 279.76,-235.14 279.76,-235.14 273.76,-235.14 267.76,-229.14 267.76,-223.14 267.76,-223.14 267.76,-211.14 267.76,-211.14 267.76,-205.14 273.76,-199.14 279.76,-199.14 279.76,-199.14 309.76,-199.14 309.76,-199.14 315.76,-199.14 321.76,-205.14 321.76,-211.14 321.76,-211.14 321.76,-223.14 321.76,-