<style>
/* Layout: one narrow reading column (phone first), sticky header, bottom nav bar. Ledger-paper neutrals; colour is reserved for the element code. */
:root {
  --paper: #f5f6f2;
  --card: #ffffff;
  --ink: #1a222b;
  --muted: #5b6570;
  --rule: #d9ddd5;
  --think: #a8661a;
  --think-bg: #fbf1e3;
  --el-a: #1f7a44;
  --el-l: #b3261e;
  --el-x: #8a5a2b;
  --el-i: #1d5fb4;
  --el-e: #6e3ba8;
  --el-n: #6b7280;
  --font-display: "Literata", Georgia, "Times New Roman", serif;
  --font-body: "Public Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #12161b; --card: #1a2027; --ink: #e6e8e3; --muted: #9aa3ad; --rule: #2e3640;
    --think: #e2a35a; --think-bg: #2a2117;
    --el-a: #5cc488; --el-l: #f2786d; --el-x: #d29d63; --el-i: #74a9f2; --el-e: #b993ea; --el-n: #9aa3ae;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #12161b; --card: #1a2027; --ink: #e6e8e3; --muted: #9aa3ad; --rule: #2e3640;
  --think: #e2a35a; --think-bg: #2a2117;
  --el-a: #5cc488; --el-l: #f2786d; --el-x: #d29d63; --el-i: #74a9f2; --el-e: #b993ea; --el-n: #9aa3ae;
  color-scheme: dark;
}

* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  background: var(--paper); color: var(--ink);
  font: 16px/1.6 var(--font-body);
  -webkit-text-size-adjust: 100%;
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--paper); }
.wrap {
  max-width: 640px; margin: 0 auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
h1, h2, h3 { font-family: var(--font-display); line-height: 1.25; text-wrap: balance; margin: 0; }
h1 { font-size: 1.9rem; font-weight: 600; }
h2 { font-size: 1.4rem; font-weight: 600; }
h3 { font-size: 1.1rem; font-weight: 600; }
p { margin: 0; }
button { font: inherit; color: inherit; cursor: pointer; }
:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
.num, .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

/* Element colour code */
.el { font-weight: 600; }
.el-a { color: var(--el-a); } .el-l { color: var(--el-l); } .el-x { color: var(--el-x); }
.el-i { color: var(--el-i); } .el-e { color: var(--el-e); } .el-n { color: var(--el-n); }
.dot { display: inline-block; width: .6em; height: .6em; border-radius: 50%; background: currentColor; margin-right: .35em; vertical-align: .05em; }

/* Header */
.top {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5;
  background: var(--paper); border-bottom: 1px solid var(--rule);
}
.top .wrap { display: flex; align-items: center; gap: 12px; padding-block: 10px; }
.top .title { flex: 1; min-width: 0; font-size: .85rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.top .title b { color: var(--ink); font-weight: 600; }
.chipbtn { border: 1px solid var(--rule); background: var(--card); border-radius: 999px; padding: 4px 12px; font-size: .85rem; }
.progress { height: 3px; background: var(--rule); }
.progress i { display: block; height: 100%; background: var(--ink); transition: width .25s; }
.legend { border-top: 1px solid var(--rule); }
.legend .wrap { display: flex; flex-wrap: wrap; gap: 6px 16px; padding-block: 10px; font-size: .9rem; }

main { padding-block: 22px 120px; }
.stack { display: flex; flex-direction: column; gap: 14px; }
.eyebrow { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; color: var(--muted); }
.eyebrow.think { color: var(--think); }
.lead { font-size: 1.05rem; }
.muted { color: var(--muted); }

.card { background: var(--card); border: 1px solid var(--rule); border-radius: 10px; padding: 16px; }
.scenario { background: var(--think-bg); border-radius: 10px; padding: 14px 16px; }
.prompt { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; }
textarea, input, select {
  font: inherit; color: var(--ink); background: var(--card);
  border: 1px solid var(--rule); border-radius: 8px; padding: 8px 10px; width: 100%;
}
textarea { min-height: 84px; resize: vertical; }
.answer { border-left: 3px solid var(--ink); padding-left: 14px; display: flex; flex-direction: column; gap: 8px; }
ul.body { margin: 0; padding-left: 1.1em; display: flex; flex-direction: column; gap: 6px; }
.formula { font-family: var(--font-mono); font-size: .92rem; background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 12px; line-height: 1.7; }
.trap { border: 1.5px dashed var(--muted); border-radius: 8px; padding: 10px 12px; }
.trap::before { content: "Trap · "; font-weight: 700; }
.key { font-weight: 600; font-family: var(--font-display); font-size: 1.05rem; }

.btn { border: 1.5px solid var(--ink); background: var(--ink); color: var(--paper); border-radius: 8px; padding: 9px 16px; font-weight: 600; }
.btn.ghost { background: transparent; color: var(--ink); }
.btn:disabled { opacity: .35; cursor: default; }
.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

/* MCQ options: marking uses ink fill (✓) and dashed outline (✗), never red/green */
.opts { display: flex; flex-direction: column; gap: 8px; }
.opt { text-align: left; background: var(--card); border: 1.5px solid var(--rule); border-radius: 10px; padding: 12px 14px; display: flex; gap: 10px; }
.opt .mk { flex: none; width: 1.5em; height: 1.5em; border-radius: 50%; border: 1.5px solid var(--muted); display: grid; place-items: center; font-size: .8rem; font-weight: 700; }
.opt .tx { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
.opt.sel { border-color: var(--ink); }
.opt.sel .mk { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.opt.right { border-color: var(--ink); border-width: 2.5px; }
.opt.right .mk { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.opt.wrong { border-style: dashed; border-color: var(--ink); }
.opt.wrong .mk { border-style: dashed; border-color: var(--ink); }
.opt .why { font-size: .9rem; color: var(--muted); }
.opt[disabled] { cursor: default; }
.verdict { font-weight: 700; display: inline-flex; gap: 6px; align-items: center; }
.badge { display: inline-block; padding: 1px 8px; border-radius: 6px; font-size: .8rem; font-weight: 700; }
.badge.ok { background: var(--ink); color: var(--paper); }
.badge.no { border: 1.5px dashed var(--ink); }

/* Journal entries */
table.jet { width: 100%; border-collapse: collapse; font-size: .92rem; }
table.jet td { padding: 3px 0; vertical-align: top; }
table.jet td.amt { text-align: right; font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; padding-left: 10px; }
table.jet tr.cr td.acc { padding-left: 1.4em; }
.jeb { display: flex; flex-direction: column; gap: 8px; }
.jeline { display: grid; grid-template-columns: 4.2em minmax(0, 1fr) 6.5em 2em; gap: 6px; align-items: center; }
.jeline select, .jeline input { padding: 7px 6px; font-size: .9rem; }
.jeline input { font-family: var(--font-mono); text-align: right; }
.jeline .x { background: none; border: none; color: var(--muted); font-size: 1.2rem; }
.jeline.ok select, .jeline.ok input { border-color: var(--ink); border-width: 2px; }
.jeline.no select, .jeline.no input { border-style: dashed; border-color: var(--ink); }
.jeline .acc-el { grid-column: 2 / 4; font-size: .78rem; margin-top: -4px; }

/* Tables and visuals */
.tbl-wrap { overflow-x: auto; }
table.tbl { border-collapse: collapse; width: 100%; font-size: .88rem; }
table.tbl th, table.tbl td { border-bottom: 1px solid var(--rule); padding: 7px 8px; text-align: left; vertical-align: top; }
table.tbl th { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
table.tbl.num td:not(:first-child), table.tbl.num th:not(:first-child) { text-align: right; font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
table.tbl tr.hide { visibility: hidden; }
.cap { font-size: .9rem; color: var(--muted); }
ol.flow { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px; }
ol.flow li { position: relative; background: var(--card); border: 1px solid var(--rule); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; }
ol.flow li:not(:last-child)::after { content: "yes ↓"; position: absolute; left: 16px; bottom: -21px; font-size: .75rem; color: var(--muted); }
ol.flow li span { font-size: .85rem; color: var(--muted); }
ol.flow li i { font-style: normal; font-size: .8rem; color: var(--muted); align-self: flex-end; border: 1px dashed var(--rule); border-radius: 6px; padding: 0 6px; }
ol.flow li.end { border: 2px solid var(--ink); }
.timeline { display: flex; flex-direction: column; gap: 10px; overflow-x: auto; }
.tl-row { display: grid; grid-template-columns: 5em repeat(5, minmax(3.6em, 1fr)); gap: 4px; align-items: end; font-size: .78rem; }
.tl-row .tick { border-top: 2px solid var(--rule); padding-top: 4px; color: var(--muted); text-align: center; }
.tl-row .tick.pay { border-top-color: var(--ink); color: var(--ink); font-weight: 600; }

/* Home */
.hero { display: flex; flex-direction: column; gap: 8px; padding-block: 8px 6px; }
.topic { display: flex; flex-direction: column; gap: 14px; }
.topic .meta { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: .9rem; color: var(--muted); }
.bar { height: 6px; background: var(--rule); border-radius: 3px; overflow: hidden; }
.bar i { display: block; height: 100%; background: var(--ink); }

/* Quiz */
.case { background: var(--card); border: 1px solid var(--rule); border-radius: 10px; padding: 12px 14px; }
.case summary { cursor: pointer; font-weight: 600; }
.case .stack { margin-top: 10px; font-size: .95rem; }
.src { font-size: .78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
.qdots { display: flex; flex-wrap: wrap; gap: 6px; }
.qdots button { width: 2.1em; height: 2.1em; border-radius: 6px; border: 1px solid var(--rule); background: var(--card); font-size: .8rem; }
.qdots button.done { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.qdots button.cur { outline: 2px solid var(--ink); outline-offset: 1px; }
.score { font-family: var(--font-display); font-size: 3rem; font-weight: 600; line-height: 1; }
.lorow { display: grid; grid-template-columns: minmax(0, 1fr) 4em; gap: 4px 10px; align-items: center; font-size: .9rem; }
.lorow .bar { grid-column: 1 / -1; }
.confirm { border: 1.5px dashed var(--ink); border-radius: 10px; padding: 12px; }

/* Bottom nav */
.nav {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 5;
  background: var(--paper); border-top: 1px solid var(--rule);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
.nav .wrap { display: flex; justify-content: space-between; gap: 10px; padding-block: 10px; }
.nav .btn { min-width: 6.5em; }

@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }

</style>
