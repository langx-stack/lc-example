21.92 401.74,-17.72\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"421.28\" y=\"-21.57\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> ÷ 1.10 \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>scrap\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M584.31,-39.64C584.31,-39.64 537.78,-39.64 537.78,-39.64 531.78,-39.64 525.78,-33.64 525.78,-27.64 525.78,-27.64 525.78,-12 525.78,-12 525.78,-6 531.78,0 537.78,0 537.78,0 584.31,0 584.31,0 590.31,0 596.31,-6 596.31,-12 596.31,-12 596.31,-27.64 596.31,-27.64 596.31,-33.64 590.31,-39.64 584.31,-39.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"538.17\" y=\"-25.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Disposal\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"544.54\" y=\"-14.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">10,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"534.42\" y=\"-5.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">end of year 4\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>y4&#45;&gt;scrap\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M510.6,-19.82C515.46,-19.82 520.46,-19.82 525.34,-19.82\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"510.64,-17.72 504.64,-19.82 510.64,-21.92 510.64,-17.72\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"worked","bucket":"viu","lo":8,"title":"Worked example: value in use of the roaster","q":"Tiong Bahru Kopi expects its roaster to generate net cash of $20,000 at the end of each of the next 4 years, and to sell it for $10,000 at the end of year 4. Discount rate 10%. What is its value in use?","intro":["A typical exam question: you get the yearly cash flows, a disposal amount and a discount rate, and must give value in use. Remember two things:","- Value in use counts the cash from **use** *and* from **ultimate disposal**. Leaving out the scrap value is the usual slip.","- Everything is **discounted** to today: an annuity factor for the level yearly cash, a single discount factor for the one-off disposal.","Then follow these steps: annuity factor → PV of use → PV of disposal → add."],"steps":[{"h":"Find the annuity factor for the yearly cash.","t":"20,000 a year for 4 years, received at each year end, is an annuity in arrears. Annuity factor at 10% for 4 years = **3.1699**."},{"h":"Calculate the PV of the cash from use.","t":"{a|20,000} × 3.1699 = **{a|63,397}**."},{"h":"Calculate the PV of the ultimate disposal.","t":"{a|10,000} × 1 ÷ 1.10^4 (= 0.6830) = **{a|6,830}**."},{"h":"Add them to get value in use.","t":"{a|63,397} + {a|6,830} = **{a|$70,227}**.","after":"Sanity check: the undiscounted total is 90,000. Value in use is lower because future cash is worth less today. If you got 90,000, you forgot the \"present\" in present value."}],"id":"worked-yt2a20","sect":4,"part":"Value in use and current cost"},{"type":"visual","bucket":"viu","lo":8,"title":"Value in use: what discounting takes away","html":"\u003cp>The roaster’s cash in two layers, \u003cstrong>use\u003c/strong> and \u003cstrong>ultimate disposal\u003c/strong>, first as raw cash, then discounted at 10%. Both layers shrink, and the hatched piece is the time value of money: 90,000 later is worth only 70,227 today.\u003c/p>\u003cdiv class=\"cbars\">\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Undiscounted: 20,000 × 4 = 80,000 + disposal 10,000 = 90,000\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg a\" style=\"width:88.89%\">\u003c/span>\u003cspan class=\"seg n\" style=\"width:11.11%\">\u003c/span>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Discounted: 63,397 + 6,830 = \u003cstrong>\u003cspan class=\"el el-a\">value in use 70,227\u003c/span>\u003c/strong>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg a\" style=\"width:70.44%\">\u003c/span>\u003cspan class=\"seg n\" style=\"width:7.59%\">\u003c/span>\u003cspan class=\"seg out\" style=\"width:21.97%\">\u003c/span>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003ci class=\"seg a\">\u003c/i>cash from \u003cstrong>use\u003c/strong>\u003c/span>\u003cspan>\u003ci class=\"seg n\">\u003c/i>cash from \u003cstrong>ultimate disposal\u003c/strong>\u003c/span>\u003cspan>\u003ci class=\"seg out\">\u003c/i>time value lost by discounting: 19,773\u003c/span>\u003c/div>\n  \u003c/div>","id":"visual-zlv7kn","sect":4,"part":"Value in use and current cost"},{"type":"calc","bucket":"viu","lo":8,"given":2,"q":"Your turn, with the first two lines done. Bedok Bakes expects its industrial mixer to generate $30,000 at the end of each of the next 5 years, and to be sold for $8,000 at the end of year 5. Discount rate 8%. What is its value in use?","answer":125226,"unit":"$","working":["Annuity factor at 8% for 5 years = 3.9927.","PV of the cash from use = 30,000 × 3.9927 = 119,781.","PV of disposal = 8,000 × 0.6806 = 5,445.","Value in use = 119,781 + 5,445 = **$125,226**."],"id":"calc-1yt3ed","sect":4,"part":"Value in use and current cost"},{"type":"calc","bucket":"viu","lo":8,"q":"Now a blank one. Clementi Print expects its press to generate $12,000 at the end of each of the next 3 years, and to sell it for $20,000 at the end of year 3. Discount rate 6%. What is its value in use?","answer":48868,"unit":"$","working":["Annuity factor at 6% for 3 years = 2.6730; PV of the cash from use = 12,000 × 2.6730 = 32,076.","PV of disposal = 20,000 × 0.8396 = 16,792.","Value in use = 32,076 + 16,792 = **$48,868**."],"id":"calc-kvho3c","sect":4,"part":"Value in use and current cost"},{"id":"think-145u57","type":"think","bucket":"viu","lo":8,"scenario":"Tiong Bahru Kopi’s espresso machine (bought 1 Jan 20X1 for $18,000 plus $2,000 installation) is three years old at 31 Dec 20X3. A three-year-old machine of the same model would cost $8,500 today, plus $600 delivery.","prompt":"This sounds a bit like historical cost and a bit like fair value. Which is it closer to, and why?","answer":["It is **current cost**: 8,500 + 600 = **$9,100**. Like historical cost it is an **entry** price (what it costs to get the asset) and includes transaction costs. Unlike historical cost it uses **today’s** prices.","Fair value is the other way round: the price to **sell**, with no transaction costs deducted."],"sect":4,"part":"Value in use and current cost"},{"type":"rule","bucket":"viu","lo":8,"title":"Current cost","body":["The last item on the menu asks historical cost’s question (“what does it cost to get?”), but at **today’s** prices.","**Current cost** = the cost of an **equivalent asset** at the measurement date: the consideration that would be paid now **plus the transaction costs** that would be incurred now.","- An **entry** value, like historical cost, but at today’s prices.","- \"Equivalent\" means the same service potential: a machine of the same age and condition, not a shiny new one.","+ Transaction costs: **in** historical cost and current cost; **not deducted** in fair value."],"id":"rule-1cmaa3","sect":4,"part":"Value in use and current cost"},{"id":"visual-13h6bq","type":"visual","bucket":"viu","lo":8,"title":"The four bases side by side","html":"\u003cp>That completes the menu. Here are all four bases side by side, with the espresso machine’s number under each.\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl reveal-rows\">\u003cthead>\u003ctr>\u003cth>Basis\u003c/th>\u003cth>Entry or exit\u003c/th>\u003cth>Whose view\u003c/th>\u003cth>Transaction costs\u003c/th>\u003cth>Espresso machine\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cstrong>Historical cost\u003c/strong>\u003c/td>\u003ctd>Entry · past\u003c/td>\u003ctd>The actual deal\u003c/td>\u003ctd>Included\u003c/td>\u003ctd>8,000\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Fair value\u003c/strong>\u003c/td>\u003ctd>Exit\u003c/td>\u003ctd>Market participants\u003c/td>\u003ctd>Not deducted\u003c/td>\u003ctd>7,000\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Value in use\u003c/strong>\u003c/td>\u003ctd>Exit-type\u003c/td>\u003ctd>The entity\u003c/td>\u003ctd>n/a (cash-flow PV)\u003c/td>\u003ctd>9,500\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Current cost\u003c/strong>\u003c/td>\u003ctd>Entry · today\u003c/td>\u003ctd>Market prices today\u003c/td>\u003ctd>Included\u003c/td>\u003ctd>9,100\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">Same machine at 31 Dec 20X3, four numbers. \u003cspan class=\"el el-l\">Liabilities\u003c/span>: historical cost, fair value, and \u003cstrong>fulfilment value\u003c/strong> (the liability twin of value in use).\u003c/p>","sect":4,"part":"Value in use and current cost"},{"type":"mcq","bucket":"viu","lo":8,"q":"Which measurement basis reflects the entity’s **own** expectations about how it will use an asset, rather than market participants’ assumptions?","options":[{"t":"Fair value","why":"Fair value deliberately uses market participants’ assumptions, not the entity’s."},{"t":"Current cost","why":"Current cost is today’s market price to acquire an equivalent asset."},{"t":"Value in use","ok":true,"why":"Value in use is entity-specific: the PV of the cash flows **this entity** expects from use and disposal."},{"t":"Historical cost","why":"Historical cost is the price actually paid, not an expectation about use."}],"id":"mcq-i37fbh","sect":4,"part":"Value in use and current cost"},{"type":"map","id":"map-5-choose","bucket":"choose","sect":5,"part":"Which basis for which asset"},{"type":"think","bucket":"choose","lo":8,"scenario":"A standard setter could make life simple: \"every asset at historical cost\" or \"every asset at fair value\". Instead, inventory, machines, rental buildings and shares all get different rules.","prompt":"Why not pick one basis for everything? What would go wrong with \"all fair value\" for a bakery’s oven, or \"all historical cost\" for SGX shares?","answer":["Each basis is best for some assets. For {a|SGX shares}, a quoted price is right there and it is what users care about: historical cost would hide years of {i|gains} and {x|losses}.","For a bakery’s oven, there may be no active market, the oven earns its money by being **used**, and fair value would add estimates and noise without telling users much. Cost less {a|accumulated depreciation} shows the oven being used up.","So each standard picks the basis that gives the most **useful** information for that kind of asset: relevance, traded off against how reliably it can be measured."],"id":"think-qcrk30","sect":5,"part":"Which basis for which asset"},{"type":"rule","bucket":"choose","lo":8,"title":"Which basis for which asset (after initial recognition)","body":["Each basis suits some assets better than others. So instead of one rule for everything, each standard picks the most useful basis for its asset class. Here is the road ahead.","1. **{a|Inventory}** (SFRS(I) 1-2): **lower of cost and net realisable value**. NRV is entity-specific, not fair value. → B1.1","2. **{a|Property, plant and equipment}** (SFRS(I) 1-16): **cost model** or **revaluation model** (fair value), chosen per class. → B1.2","3. **{a|Investment property}** (SFRS(I) 1-40): **fair value model** (changes to P&L) or **cost model**. → B1.3","4. **{a|Financial assets}** (SFRS(I) 9): **amortised cost**, **FVOCI** or **FVTPL**. → B1.4","5. **{a|Intangible assets}** (SFRS(I) 1-38): cost model, or revaluation model only if there is an **active market**.","6. **Any asset that may be impaired** (SFRS(I) 1-36): carried no higher than **recoverable amount** = the **higher** of fair value less costs of disposal and value in use. → B3","+ Cost looks back, fair value looks out to the market, value in use looks at the entity’s own plans."],"id":"rule-7arbpm","sect":5,"part":"Which basis for which asset"},{"type":"diagram","bucket":"choose","lo":8,"title":"Which asset uses which basis: the road ahead","intro":"Your map for the asset chapters. Each asset class picks from the menu; impairment caps several of them at recoverable amount.","notes":{"root":"Day 1 is (almost) always cost. The bases diverge from the first reporting date.","inv":"Stock held for sale.","binv":"NRV = estimated selling price − costs to complete and sell. It is **entity-specific**, so it is not fair value.","ppe":"Assets used in the business.","bppe":"Pick per **class**. {i|Revaluation gains} go to OCI, into the {e|revaluation surplus}. The asset still carries {x|depreciation} either way.","ip":"Land and buildings held for rent or growth.","bip":"One model for all {a|investment property}. Fair value {i|gains} and {x|losses} go to **P&L**, with no {x|depreciation}.","fa":"{a|Shares}, {a|bonds}, {a|loans}, {a|receivables}.","bfa":"Decided by the business model and the contractual cash-flow (SPPI) test.","intan":"Software, licences, brands bought in.","bint":"Revaluation needs an **active market**, which most intangibles don’t have.","imp":"Recoverable amount = **higher** of fair value less costs of disposal and value in use. {a|Inventory}, {a|financial assets} and {a|investment property} at fair value have their own rules instead."},"walk":[{"nodes":["root"],"text":"Every asset starts at cost. After that, each standard picks from the menu."},{"nodes":["inv","binv"],"text":"**{a|Inventory}** (B1.1): lower of cost and NRV. Cost, with a prudent cap."},{"nodes":["ppe","bppe"],"text":"**{a|PPE}** (B1.2): cost or revaluation, chosen per class."},{"nodes":["ip","bip"],"text":"**{a|Investment property}** (B1.3): fair value through P&L, or cost."},{"nodes":["fa","bfa"],"text":"**{a|Financial assets}** (B1.4): amortised cost, FVOCI or FVTPL."},{"nodes":["intan","bint"],"text":"**{a|Intangibles}**: cost, unless there is an active market."},{"nodes":["imp"],"text":"**Impairment** (B3) caps cost-based assets at recoverable amount, where **value in use** comes back."}],"caption":"This chart is the table of contents for B1.1 to B1.4 and B3.","id":"diagram-19p4xm","sect":5,"part":"Which basis for which asset","svg":"\u003csvg width=\"100%\" style=\"min-width:640px\" role=\"img\"\n viewBox=\"0.00 0.00 691.00 258.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 246.8)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-246.8 680.42,-246.8 680.42,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>root\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M65.28,-136C65.28,-136 12,-136 12,-136 6,-136 0,-130 0,-124 0,-124 0,-112 0,-112 0,-106 6,-100 12,-100 12,-100 65.28,-100 65.28,-100 71.28,-100 77.28,-106 77.28,-112 77.28,-112 77.28,-124 77.28,-124 77.28,-130 71.28,-136 65.28,-136\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"9.76\" y=\"-119.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">After initial\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-108.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">recognition\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>inv\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M205.18,-236C205.18,-236 138.4,-236 138.4,-236 132.4,-236 126.4,-230 126.4,-224 126.4,-224 126.4,-212 126.4,-212 126.4,-206 132.4,-200 138.4,-200 138.4,-200 205.18,-200 205.18,-200 211.18,-200 217.18,-206 217.18,-212 217.18,-212 217.18,-224 217.18,-224 217.18,-230 211.18,-236 205.18,-236\"/>\n\u0