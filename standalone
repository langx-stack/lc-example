2.06,-215.82 326.06,-215.82 320.06,-209.82 320.06,-203.82 320.06,-203.82 320.06,-191.82 320.06,-191.82 320.06,-185.82 326.06,-179.82 332.06,-179.82 332.06,-179.82 371.09,-179.82 371.09,-179.82 377.09,-179.82 383.09,-185.82 383.09,-191.82 383.09,-191.82 383.09,-203.82 383.09,-203.82 383.09,-209.82 377.09,-215.82 371.09,-215.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"328.7\" y=\"-199.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Revenue\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"338.07\" y=\"-188.37\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">4,750\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>keep&#45;&gt;rev\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M236.96,-156.29C260.87,-165.03 289.93,-175.65 312.67,-183.96\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"311.74,-185.86 318.09,-185.95 313.18,-181.91 311.74,-185.86\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"269.18\" y=\"-174.04\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> × $50 \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>cogs\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M382.34,-157.82C382.34,-157.82 320.81,-157.82 320.81,-157.82 314.81,-157.82 308.81,-151.82 308.81,-145.82 308.81,-145.82 308.81,-133.82 308.81,-133.82 308.81,-127.82 314.81,-121.82 320.81,-121.82 320.81,-121.82 382.34,-121.82 382.34,-121.82 388.34,-121.82 394.34,-127.82 394.34,-133.82 394.34,-133.82 394.34,-145.82 394.34,-145.82 394.34,-151.82 388.34,-157.82 382.34,-157.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"317.45\" y=\"-141.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Cost of sales\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"338.07\" y=\"-130.37\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">2,850\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>keep&#45;&gt;cogs\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M236.96,-139.82C256.95,-139.82 280.54,-139.82 301.02,-139.82\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"300.91,-141.92 306.91,-139.82 300.91,-137.72 300.91,-141.92\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"269.18\" y=\"-141.57\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> × $30 \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>ref\u003c/title>\n\u003cpath fill=\"#ffe4e6\" stroke=\"#be123c\" stroke-width=\"1.2\" d=\"M387.59,-99.82C387.59,-99.82 315.56,-99.82 315.56,-99.82 309.56,-99.82 303.56,-93.82 303.56,-87.82 303.56,-87.82 303.56,-75.82 303.56,-75.82 303.56,-69.82 309.56,-63.82 315.56,-63.82 315.56,-63.82 387.59,-63.82 387.59,-63.82 393.59,-63.82 399.59,-69.82 399.59,-75.82 399.59,-75.82 399.59,-87.82 399.59,-87.82 399.59,-93.82 393.59,-99.82 387.59,-99.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"312.2\" y=\"-83.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Refund liability\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"342.57\" y=\"-72.37\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">250\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>back&#45;&gt;ref\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M238.24,-81.82C256.24,-81.82 277.01,-81.82 295.75,-81.82\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"295.59,-83.92 301.59,-81.82 295.59,-79.72 295.59,-83.92\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"269.18\" y=\"-83.57\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> × $50 \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>rec\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M390.59,-41.64C390.59,-41.64 312.56,-41.64 312.56,-41.64 306.56,-41.64 300.56,-35.64 300.56,-29.64 300.56,-29.64 300.56,-12 300.56,-12 300.56,-6 306.56,0 312.56,0 312.56,0 390.59,0 390.59,0 396.59,0 402.59,-6 402.59,-12 402.59,-12 402.59,-29.64 402.59,-29.64 402.59,-35.64 396.59,-41.64 390.59,-41.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"309.2\" y=\"-27.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Right to recover\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"311.07\" y=\"-16.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">returned goods\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"342.57\" y=\"-5.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">150\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>back&#45;&gt;rec\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M238.24,-64.01C255.51,-57.37 275.32,-49.76 293.44,-42.79\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"293.78,-44.91 298.63,-40.79 292.27,-40.99 293.78,-44.91\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"269.18\" y=\"-58.53\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> × $30 \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"je-w4rth9","type":"je","bucket":"price","lo":41,"q":"Clementi Craft sells 100 kettles for $50 each in cash (cost $30 each). Customers may return them within 30 days for a full refund, and from experience 5 will come back. Record the sale (the {i|revenue} side only; ignore the cost entry).","accounts":["Cash","Accounts receivable","Contract asset","Contract liability","Revenue","Refund liability","Right to recover returned goods","Inventory","Cost of sales","Provision for onerous contract","Loss on onerous contract","Warranty provision","Warranty expense","Interest income","Marketing expense"],"lines":[{"side":"Dr","account":"Cash","amount":5000,"el":"a"},{"side":"Cr","account":"Revenue","amount":4750,"el":"i"},{"side":"Cr","account":"Refund liability","amount":250,"el":"l"}],"why":"95 × $50 = 4,750 {i|revenue}; 5 × $50 = 250 {l|refund liability}. The matching cost entry: Dr {x|Cost of sales} 2,850, Dr {a|Right to recover returned goods} 150, Cr {a|Inventory} 3,000.","sect":3,"part":"Transaction price"},{"id":"think-1m7nis","type":"think","bucket":"price","lo":41,"scenario":"Pasir Snacks sells $500,000 of crisps to a supermarket chain this year. To get its crisps onto the shelves, Pasir pays the supermarket a $20,000 “listing fee”. The supermarket gives nothing distinct in return.","prompt":"Is the listing fee a {x|marketing expense}, or something else?","answer":["It is **consideration payable to a customer**. The supermarket provides no distinct good or service for it, so it is really a discount on the crisps.","It **reduces the transaction price**: {i|revenue} = 500,000 − 20,000 = $480,000, not $500,000 of {i|revenue} with a $20,000 {x|expense}."],"sect":3,"part":"Transaction price"},{"type":"rule","bucket":"price","lo":41,"title":"Other adjustments to the transaction price","body":["Pasir’s listing fee is one of three more tweaks to the transaction price. Each one corrects the headline price to what the entity really expects to get.","1. **Significant financing component:** if payment is much earlier or later than delivery, adjust for the time value of money: {i|revenue} at the cash price, with {i|interest} separately. Not needed if the gap is **one year or less** (practical expedient).","2. **Non-cash consideration** (shares, goods): measure at **fair value**.","3. **Consideration payable to the customer** (listing fees, vouchers, coupons): **reduce** the transaction price (so {i|revenue}), unless it pays for a distinct good or service the customer provides.","+ All four (variable, financing, non-cash, payable to customer) answer the same question: how much does the entity **really** expect to get for its goods?"],"id":"rule-1tzlj9","sect":3,"part":"Transaction price"},{"id":"mcq-1hsu6f","type":"mcq","bucket":"price","lo":41,"q":"Pasir Snacks sells $500,000 of crisps to a supermarket chain this year and pays the supermarket a $20,000 listing fee to get them onto the shelves. The supermarket provides no distinct good or service in return. How should Pasir present the listing fee?","options":[{"t":"As a {x|marketing expense} of $20,000, with {i|revenue} of $500,000","why":"The supermarket gives nothing distinct for it, so it isn’t a purchase of marketing services."},{"t":"As a reduction of {i|revenue}: revenue $480,000","ok":true,"why":"Consideration payable to a customer with nothing distinct in return reduces the transaction price."},{"t":"As an {a|asset}, amortised over the life of the supply agreement","why":"Not a cost to obtain a contract here; it reduces the price."},{"t":"Ignored, because it is netted off in the supermarket’s own books","why":"Pasir must account for it in its own financial statements."}],"sect":3,"part":"Transaction price"},{"type":"map","id":"map-4-allocate","bucket":"allocate","sect":4,"part":"Allocate the price"},{"type":"think","bucket":"allocate","lo":40,"scenario":"Marina Mobile sells a phone plus a 2-year plan for $1,000, paid up front. Sold separately, the phone is $750 and the plan $500.","prompt":"Bought separately they cost $1,250, so the bundle carries a $250 discount. How much of the $1,000 belongs to the phone?","answer":["Share the price out in proportion to the stand-alone prices. The phone is 750 / 1,250 of the total.","Phone = 1,000 × 750 ÷ 1,250 = **$600**; plan = 1,000 × 500 ÷ 1,250 = **$400**.","The discount is spread across both, in proportion. Neither item gets to hog it."],"id":"think-8mbg4o","sect":4,"part":"Allocate the price"},{"type":"rule","bucket":"allocate","lo":40,"title":"Step 4: allocate by relative stand-alone selling price","body":["Step 4 takes the price from step 3 and shares it out across the obligations from step 2. Marina’s bundle showed the discount must not land on one item alone.","> Price allocated to an obligation = Transaction price × its SSP ÷ total of all SSPs","The **stand-alone selling price (SSP)** is the price at which the entity would sell that good or service separately. Best evidence: an observable price.","No observable SSP? Estimate it:","1. **Adjusted market assessment** (what customers would pay; competitors’ prices)","2. **Expected cost plus a margin**","3. **Residual** approach: total price minus the other SSPs, only in limited cases (highly variable or uncertain prices)","- A **bundle discount** is spread across **all** obligations in proportion to SSP, unless there is evidence it belongs to only some of them.","! The answer is the **allocated** amount, not the SSP. Exam distractors love offering the SSP itself."],"id":"rule-1136im","sect":4,"part":"Allocate the price"},{"type":"visual","bucket":"allocate","lo":40,"title":"Where Marina’s discount goes","html":"\u003cp>Two bars on one scale. The top bar is what the phone and plan cost bought separately; the bottom bar is the 1,000 bundle price, split by SSP. The hatched end is the 250 discount: notice it comes off \u003cstrong>both\u003c/strong> items in proportion, not just one.\u003c/p>\u003cdiv class=\"cbars\">\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003cspan class=\"seg i\">\u003c/span>\u003cspan class=\"el el-i\">phone: revenue on day 1\u003c/span>\u003c/span>\u003cspan>\u003cspan class=\"seg l\">\u003c/span>\u003cspan class=\"el el-l\">plan: contract liability\u003c/span>\u003c/span>\u003cspan>\u003cspan class=\"seg n\">\u003c/span>\u003cspan class=\"el el-n\">stand-alone price\u003c/span>\u003c/span>\u003cspan>\u003cspan class=\"seg out-n\">\u003c/span>\u003cspan class=\"el el-n\">discount\u003c/span>\u003c/span>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Separately: phone \u003cspan class=\"el el-n\">750\u003c/span> + plan \u003cspan class=\"el el-n\">500\u003c/span> = \u003cspan class=\"el el-n\">1,250\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg n\" style=\"flex:none;width:60.00%\">\u003c/span>\u003cspan class=\"seg n\" style=\"flex:none;width:40.00%\">\u003c/span>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Bundle: phone \u003cspan class=\"el el-i\">600\u003c/span> (−150) + plan \u003cspan class=\"el el-l\">400\u003c/span> (−100) = 1,000\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg i\" style=\"flex:none;width:48.00%\">\u003c/span>\u003cspan class=\"seg l\" style=\"flex:none;width:32.00%\">\u003c/span>\u003cspan class=\"seg out-n\" style=\"flex:none;width:20.00%\">\u003c/span>\u003c/div>\u003c/div>\n  \u003c/div>\u003cp class=\"cap\">Each item keeps the same share: phone 60%, plan 40%. So the 250 discount splits 150 / 100 in the same ratio.\u003c/p>","id":"visual-ic5zto","sect":4,"part":"Allocate the price"},{"type":"diagram","bucket":"allocate","lo":40,"title":"Marina’s bundle: allocate, then recognise","intro":"The price splits by SSP share; each slice then follows its own timing at step 5.","notes":{"tp":"What the customer pays for the bundle: 1,000. Total SSP is 1,250, so there is a 250 discount.","ph":"60% of the SSP total, so 60% of the price.","pl":"40% of the SSP total.","now":"Control of the phone passes when the customer walks out with it.","cl":"{a|Cash received} before the service is performed: a {l|Contract liability}.","over":"400 × 12/24 = 200 each year, as the airtime is used."},"walk":[{"nodes":["tp","ph","pl"],"text":"Step 4: split the price by stand-alone selling price."},{"nodes":["ph","now"],"text":"The phone’s 600 is {i|revenue} on day 1."},{"nodes":["pl","cl"],"text":"The plan’s 400 waits as a {l|contract liability}."},{"nodes":["cl","over"],"text":"It becomes {i|revenue} as the service is delivered: 200 a year."}],"caption":"Allocate first, then each slice follows its own obligation’s timing.","id":"diagram-xq0lkr","sect":4,"part":"Allocate the price","svg":"\u003csvg width=\"100%\" style=\"min-width:330px\" role=\"img\"\n viewBox=\"0.00 0.00 300.00 280.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 269.22)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-269.22 289.69,-269.22 289.69,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>tp\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M165.16,-258.42C165.16,-258.42 81.12,-258.42 81.12,-258.42 75.12,-258.42 69.12,-252.42 69.12,-246.42 69.12,-246.42 69.12,-234.42 69.12,-234.42 69.12,-228.42 75.12,-222.42 81.12,-222.42 81.12,-222.42 165.16,-222.42 165.16,-222.42 171.16,-222.42 177.16,-228.42 177.16,-234.42 177.16,-234.42 177.16,-246.42 177.16,-246.42 177.16,-252.42 171.16,-258.42 165.16,-258.42\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"77.77\" y=\"-241.97\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Transaction price\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"109.64\" y=\"-230.97\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"white\">1,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>ph\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M96.66,-185.17C96.66,-185.17 15.63,-185.17 15.63,-185.17 9.62,-185.17 3.63,-179.17 3.63,-173.17 3.63,-173.17 3.63,-155.53 3.63,-155.53 3.63,-149.53 9.63,-143.53 15.63,-143.53 15.63,-143.53 