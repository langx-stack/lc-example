start\" x=\"212.38\" y=\"-93.3\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">FVOCI (debt)\u003c/text>\n\u003cpolygon fill=\"none\" stroke=\"#9ca3af\" points=\"164.12,-63.75 164.12,-85.75 243.88,-85.75 243.88,-63.75 164.12,-63.75\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"169.12\" y=\"-70.3\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">Interest\u003c/text>\n\u003cpolygon fill=\"#e8eef6\" stroke=\"none\" points=\"243.88,-63.75 243.88,-85.75 328.12,-85.75 328.12,-63.75 243.88,-63.75\"/>\n\u003cpolygon fill=\"none\" stroke=\"#9ca3af\" points=\"243.88,-63.75 243.88,-85.75 328.12,-85.75 328.12,-63.75 243.88,-63.75\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"259.75\" y=\"-71.3\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">P&amp;L 5,840\u003c/text>\n\u003cpolygon fill=\"none\" stroke=\"#9ca3af\" points=\"164.12,-41.75 164.12,-63.75 243.88,-63.75 243.88,-41.75 164.12,-41.75\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"169.12\" y=\"-48.3\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">FV − AC\u003c/text>\n\u003cpolygon fill=\"#f3eeff\" stroke=\"none\" points=\"243.88,-41.75 243.88,-63.75 328.12,-63.75 328.12,-41.75 243.88,-41.75\"/>\n\u003cpolygon fill=\"none\" stroke=\"#9ca3af\" points=\"243.88,-41.75 243.88,-63.75 328.12,-63.75 328.12,-41.75 243.88,-41.75\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"265.75\" y=\"-49.3\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">OCI 833\u003c/text>\n\u003cpolygon fill=\"none\" stroke=\"#9ca3af\" points=\"164.12,-19.75 164.12,-41.75 243.88,-41.75 243.88,-19.75 164.12,-19.75\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"169.12\" y=\"-26.3\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">Sale at 99,500\u003c/te