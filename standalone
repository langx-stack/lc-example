1.00\" fill=\"#111827\">122,783\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge1\" class=\"edge\">\n\u003ctitle>est&#45;&gt;pv\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M136.14,-269.21C136.14,-263.34 136.14,-256.66 136.14,-250.32\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"138.24,-250.62 136.14,-244.62 134.04,-250.62 138.24,-250.62\"/>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>asset\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M104.28,-169.28C104.28,-169.28 12,-169.28 12,-169.28 6,-169.28 0,-163.28 0,-157.28 0,-157.28 0,-145.28 0,-145.28 0,-139.28 6,-133.28 12,-133.28 12,-133.28 104.28,-133.28 104.28,-133.28 110.28,-133.28 116.28,-139.28 116.28,-145.28 116.28,-145.28 116.28,-157.28 116.28,-157.28 116.28,-163.28 110.28,-169.28 104.28,-169.28\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-152.83\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Added to PPE cost\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"22.52\" y=\"-141.83\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">total 1,082,783\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>pv&#45;&gt;asset\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M117.26,-206.28C106.87,-196.8 93.87,-184.92 82.7,-174.72\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"84.35,-173.38 78.51,-170.88 81.52,-176.48 84.35,-173.38\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"110.06\" y=\"-184.03\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> Dr \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>prov\u003c/title>\n\u003cpath fill=\"#f3eeff\" stroke=\"#6d28d9\" stroke-width=\"1.2\" d=\"M279.15,-169.28C279.15,-169.28 153.12,-169.28 153.12,-169.28 147.12,-169.28 141.12,-163.28 141.12,-157.28 141.12,-157.28 141.12,-145.28 141.12,-145.28 141.12,-139.28 147.12,-133.28 153.12,-133.28 153.12,-133.28 279.15,-133.28 279.15,-133.28 285.15,-133.28 291.15,-139.28 291.15,-145.28 291.15,-145.28 291.15,-157.28 291.15,-157.28 291.15,-163.28 285.15,-169.28 279.15,-169.28\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"149.76\" y=\"-152.83\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Provision for dismantling\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"196.64\" y=\"-141.83\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">122,783\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>pv&#45;&gt;prov\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M155.51,-206.28C166.16,-196.8 179.49,-184.92 190.95,-174.72\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"192.18,-176.43 195.27,-170.87 189.39,-173.29 192.18,-176.43\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"189.18\" y=\"-184.03\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> Cr \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>dep\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M90.78,-104.46C90.78,-104.46 25.5,-104.46 25.5,-104.46 19.5,-104.46 13.5,-98.46 13.5,-92.46 13.5,-92.46 13.5,-80.46 13.5,-80.46 13.5,-74.46 19.5,-68.46 25.5,-68.46 25.5,-68.46 90.78,-68.46 90.78,-68.46 96.78,-68.46 102.78,-74.46 102.78,-80.46 102.78,-80.46 102.78,-92.46 102.78,-92.46 102.78,-98.46 96.78,-104.46 90.78,-104.46\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"24.77\" y=\"-88.01\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Depreciation\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"22.14\" y=\"-77.01\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">108,278 a year\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>asset&#45;&gt;dep\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M58.14,-132.78C58.14,-126.38 58.14,-119.02 58.14,-112.11\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"60.24,-112.38 58.14,-106.38 56.04,-112.38 60.24,-112.38\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>unw\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M248.4,-106.28C248.4,-106.28 183.88,-106.28 183.88,-106.28 177.88,-106.28 171.88,-100.28 171.88,-94.28 171.88,-94.28 171.88,-78.64 171.88,-78.64 171.88,-72.64 177.88,-66.64 183.88,-66.64 183.88,-66.64 248.4,-66.64 248.4,-66.64 254.4,-66.64 260.4,-72.64 260.4,-78.64 260.4,-78.64 260.4,-94.28 260.4,-94.28 260.4,-100.28 254.4,-106.28 248.4,-106.28\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"188.01\" y=\"-92.51\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Unwinding\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"180.51\" y=\"-81.51\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">6,139 in year 1\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"191.76\" y=\"-72.41\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">finance cost\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>prov&#45;&gt;unw\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M216.14,-132.78C216.14,-126.94 216.14,-120.29 216.14,-113.91\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"218.24,-114.14 216.14,-108.14 214.04,-114.14 218.24,-114.14\"/>\n\u003c/g>\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>end\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M260.03,-39.64C260.03,-39.64 172.25,-39.64 172.25,-39.64 166.25,-39.64 160.25,-33.64 160.25,-27.64 160.25,-27.64 160.25,-12 160.25,-12 160.25,-6 166.25,0 172.25,0 172.25,0 260.03,0 260.03,0 266.03,0 272.03,-6 272.03,-12 272.03,-12 272.03,-27.64 272.03,-27.64 272.03,-33.64 266.03,-39.64 260.03,-39.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"197.01\" y=\"-25.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Year 10\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"168.89\" y=\"-14.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">provision = 200,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"199.64\" y=\"-5.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">paid out\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>unw&#45;&gt;end\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M216.14,-66.07C216.14,-60.19 216.14,-53.62 216.14,-47.36\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"218.24,-47.71 216.14,-41.71 214.04,-47.71 218.24,-47.71\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"think","bucket":"initial","lo":14,"scenario":"While testing a new bottling line, a drinks maker produces 2,000 bottles of juice, which it sells for $4,000. The line took 14 months to build, financed by a bank loan.","prompt":"Should the $4,000 reduce the cost of the line? And what about the interest on the loan?","answer":["**{i|Sales of test output}** go to **profit or loss** (with the {x|cost of making them}). They do **not** reduce the cost of the line. The testing cost itself stays in cost.","The line took a long time to build, so it is a **qualifying asset**: borrowing costs during construction are **capitalised** (SFRS(I) 1-23, covered in C2)."],"id":"think-1oh1e5","sect":3,"part":"Initial measurement"},{"type":"rule","bucket":"initial","lo":14,"title":"Three special cases","body":["The bottling line raised two awkward costs. With these three cases, initial measurement is complete. Each one has a rule that differs from what intuition suggests.","1. **{i|Proceeds from selling items produced while testing}** → profit or loss. Not deducted from cost.","2. **Borrowing costs** on an asset that takes a substantial time to get ready → capitalised (SFRS(I) 1-23).","3. **Exchanges:** an asset received in exchange for another is measured at **fair value** if the exchange has **commercial substance**; otherwise at the **{a|carrying amount}** of the asset given up.","! Deducting {i|test-output sales} from cost is the old rule. Today they go to P&L."],"id":"rule-1jgp6t","sect":3,"part":"Initial measurement"},{"type":"mcq","bucket":"initial","lo":14,"q":"Which of these costs is included in the cost of a new machine?","options":[{"t":"Recoverable GST paid on the purchase","why":"Recoverable GST is claimed back, so it is a {a|receivable}, not cost."},{"t":"Costs of testing whether the machine works properly","ok":true,"why":"Testing is needed to get it ready for use, so it is capitalised (any {i|test-output sales} go to P&L)."},{"t":"Costs of moving the machine to another factory two years later","why":"Relocation happens after it is ready for use: {x|expense}."},{"t":"An allocation of head office admin overheads","why":"General overheads are not directly attributable: {x|expense}."}],"id":"mcq-1oi0uf","sect":3,"part":"Initial measurement"},{"type":"compare","bucket":"initial","lo":14,"special":"PPE’s cost includes the **present value of dismantling and restoration**, a future cost capitalised on day one with a {l|provision}. {i|Test-output sales} go to P&L.","id":"compare-1kumyt","sect":3,"part":"Initial measurement"},{"type":"map","id":"map-4-subsequent","bucket":"subsequent","sect":4,"part":"Subsequent measurement"},{"id":"think-1x3awv","type":"think","bucket":"subsequent","lo":14,"scenario":"A company’s new machine cost $110,500. The company expects to use it for 5 years and then sell it for $10,500.","prompt":"How much of the cost is actually “used up” over the five years, and so should be spread as {x|depreciation}?","answer":["Not all of it. The company gets 10,500 back at the end, so only 110,500 − 10,500 = **100,000** is used up. That is the **depreciable amount**.","Straight-line {x|depreciation}: 100,000 ÷ 5 = **$20,000** a year.","Forget the residual value and you depreciate money you are going to get back."],"sect":4,"part":"Subsequent measurement"},{"type":"rule","bucket":"subsequent","lo":14,"title":"Depreciation: the basics","body":["The machine is on the books at cost; now it starts wearing out. The last page showed that only cost less residual value is used up. This rule says how and when to spread it.","> Depreciable amount = {a|Cost} − Residual value","- Allocate it on a **systematic basis** over the **useful life**.","- **Start** when the asset is **available for use**, even if it sits idle.","- **Stop** when it is derecognised or classified as held for sale.","- **{a|Land}** is usually not depreciated; {a|buildings} on it are.","- Review **residual value, useful life and method at least every year end**. A change is a **change in accounting estimate**, applied **prospectively** (E1).","! An idle machine is still depreciated. Not using it does not stop the clock."],"id":"rule-1e09s7","sect":4,"part":"Subsequent measurement"},{"id":"visual-16ssu3","type":"visual","bucket":"subsequent","lo":14,"title":"Three ways to depreciate the machine","html":"\u003cp>The same \u003cspan class=\"el el-a\">depreciable amount\u003c/span> (cost $110,500 − residual $10,500 = 100,000) can be spread in different patterns. Here are the three you meet in the exam, on the machine.\u003c/p>\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl reveal-rows\">\u003cthead>\u003ctr>\u003cth>Method\u003c/th>\u003cth>Working\u003c/th>\u003cth>Year 1\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cstrong>Straight-line\u003c/strong>\u003c/td>\u003ctd>(110,500 − 10,500) ÷ 5\u003c/td>\u003ctd>20,000\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Units of production\u003c/strong> (100,000 units in total; 25,000 in year 1)\u003c/td>\u003ctd>100,000 × 25,000 ÷ 100,000\u003c/td>\u003ctd>25,000\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Part year\u003c/strong> (bought 1 April, year end 31 Dec, straight-line)\u003c/td>\u003ctd>20,000 × 9/12\u003c/td>\u003ctd>15,000\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">Pick the method that matches how the benefits are used up. Diminishing balance is allowed too. \u003cstrong>Revenue-based\u003c/strong> methods are \u003cstrong>not\u003c/strong> allowed: \u003cspan class=\"el el-i\">revenue\u003c/span> reflects prices and volumes, not wear.\u003c/p>","sect":4,"part":"Subsequent measurement"},{"type":"calc","bucket":"subsequent","lo":14,"q":"A delivery truck is bought on 1 April 20X1 for $172,000. Residual value $16,000, useful life 6 years, straight-line, year end 31 December. What is the depreciation for 20X1?","answer":19500,"unit":"$","working":["Annual {x|depreciation} = (172,000 − 16,000) ÷ 6 = 26,000.","April to December is 9 months: 26,000 × 9/12 = **$19,500**."],"id":"calc-ko0fu5","sect":4,"part":"Subsequent measurement"},{"type":"think","bucket":"subsequent","lo":14,"scenario":"An airline buys a plane for $60,000,000. The airframe lasts 25 years, the engines 10 years and the cabin interior 5 years.","prompt":"Is depreciating the whole $60,000,000 over 25 years good enough? What goes wrong in year 10?","answer":["In year 10 the engines are worn out and replaced, but on a single 25-year life they would still be carried at a big chunk of their cost. Profit would have been flattered for a decade.","So depreciate each **significant part** separately, over its own life: these are **components**."],"id":"think-1hl2vq","sect":4,"part":"Subsequent measurement"},{"type":"rule","bucket":"subsequent","lo":14,"title":"Components and methods","body":["The plane showed that one life for the whole asset understates {x|depreciation} on parts that wear out fast. Two more choices shape the charge: the method, and what to do when an estimate changes.","- **Components:** depreciate each significant part with a different useful life separately (an aircraft’s engines vs its body).","- **Methods:** straight-line, diminishing balance, units of production. Use the one that reflects how the benefits are consumed.","- **Revenue-based** methods are **not** allowed.","- **Change in estimate** (life, residual value, method): depreciate the **{a|carrying amount} at the date of change** over the **remaining** life. No restatement of past years."],"id":"rule-1tx9b0","sect":4,"part":"Subsequent measurement"},{"type":"diagram","bucket":"subsequent","lo":14,"title":"One plane, three clocks","intro":"★ Component depreciation: each part runs on its own clock.","notes":{"plane":"One purchase, but three significant parts with different lives.","body":"42,000,000 ÷ 25 = 1,680,000 a year.","eng":"15,000,000 ÷ 10 = 1,500,000 a year. When replaced, derecognise their remaining {a|carrying amount} and capitalise the new engines.","cab":"3,000,000 ÷ 5 = 600,000 a year.","tot":"1,680,000 + 1,500,000 + 600,000 = 3,780,000. One 25-year life would give only 60,000,000 ÷ 25 = 2,400,000."},"walk":[{"nodes":["plane","body","eng","cab"],"text":"Split the cost into significant parts with different lives."},{"nodes":["body","db"],"text":"Airframe: 1,680,000 a year over 25 years."},{"nodes":["eng","de"],"text":"Engines: 1,500,000 a year over 10 years."},{"nodes":["cab","dc"],"text":"Cabin: 600,000 a year over 5 years."},{"nodes":["tot"],"text":"Total {x|depreciation} **3,780,000** a year, well above the 2,400,000 a single life would give."}],"caption":"Depreciation by components: shorter-lived parts are written off faster.","id":"diagram-2y1san","sect":4,"part":"Subsequent measurement","svg":"\u003csvg 