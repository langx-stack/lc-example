 stroke-width=\"1.2\" d=\"M138.23,-239.54C138.23,-239.54 22.88,-239.54 22.88,-239.54 16.88,-239.54 10.88,-233.54 10.88,-227.54 10.88,-227.54 10.88,-215.54 10.88,-215.54 10.88,-209.54 16.88,-203.54 22.88,-203.54 22.88,-203.54 138.23,-203.54 138.23,-203.54 144.23,-203.54 150.23,-209.54 150.23,-215.54 150.23,-215.54 150.23,-227.54 150.23,-227.54 150.23,-233.54 144.23,-239.54 138.23,-239.54\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"23.93\" y=\"-222.09\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Non&#45;monetary at cost\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"21.68\" y=\"-212.99\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">PPE, inventory, prepayments\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node8\" class=\"node\">\n\u003ctitle>none\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" d=\"M344.45,-239.54C344.45,-239.54 223.1,-239.54 223.1,-239.54 217.1,-239.54 211.1,-233.54 211.1,-227.54 211.1,-227.54 211.1,-215.54 211.1,-215.54 211.1,-209.54 217.1,-203.54 223.1,-203.54 223.1,-203.54 344.45,-203.54 344.45,-203.54 350.45,-203.54 356.45,-209.54 356.45,-215.54 356.45,-215.54 356.45,-227.54 356.45,-227.54 356.45,-233.54 350.45,-239.54 344.45,-239.54\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"221.9\" y=\"-222.09\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">No exchange difference\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"241.4\" y=\"-212.99\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">historical rate, frozen\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>cst&#45;&gt;none\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M150.8,-221.54C167.41,-221.54 185.28,-221.54 202.35,-221.54\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"202.14,-223.99 209.14,-221.54 202.14,-219.09 202.14,-223.99\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"calc-hz0hus","type":"calc","bucket":"where","lo":56,"unit":"$","q":"Orchid Trading (functional currency S$) owns {a|freehold land} in Johor under the revaluation model: bought for RM2,000,000 at RM1 = S$0.30; revalued at the year end to RM2,200,000, when RM1 = S$0.31. How much is credited to the {e|Revaluation surplus (OCI)} (in S$)?","answer":82000,"given":1,"working":["{a|Carrying amount before}: RM2,000,000 × 0.30 = S$600,000.","{a|Revalued amount} at the valuation-date rate: RM2,200,000 × 0.31 = S$682,000.","{i|Increase} = 682,000 − 600,000 = **S$82,000**, all to OCI.","Inside it: the {i|ringgit gain} RM200,000 × 0.31 = 62,000, plus the FX part 20,000. Both follow the revaluation into OCI."],"sect":5,"part":"Where differences go"},{"id":"mcq-15khxn","type":"mcq","bucket":"where","lo":56,"q":"A Singapore company holds an office building in Kuala Lumpur as {a|investment property} under the fair value model. At the year end both the RM fair value and the RM/S$ rate have moved. Where does the exchange part of the change go?","options":[{"t":"OCI, because it is an exchange difference","why":"Exchange differences on non-monetary items follow the item’s own gain. Investment property {i|fair value gains} go to P&L."},{"t":"Profit or loss, together with the {i|fair value gain} or {x|loss}","ok":true,"why":"Translate the fair value at the rate on the valuation date; the whole S$ change goes to P&L."},{"t":"Nowhere: non-monetary items are never retranslated","why":"That holds for items at cost. Items at fair value use the rate on the date fair value was measured."},{"t":"Directly to {e|retained earnings}","why":"Not a choice the standard offers here."}],"sect":5,"part":"Where differences go"},{"id":"visual-1ly33y","type":"visual","bucket":"where","lo":56,"title":"The whole chapter in one table","html":"\u003cp>Everything so far on one grid: which rate each item uses on day 1 and at the year end, and where any difference lands. Read it row by row and say the reason out loud.\u003c/p>\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl reveal-rows\">\u003cthead>\u003ctr>\u003cth>Item\u003c/th>\u003cth>Day 1\u003c/th>\u003cth>Year end\u003c/th>\u003cth>Difference to\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-l\">Trade payable\u003c/span>, \u003cspan class=\"el el-a\">Trade receivable\u003c/span>, \u003cspan class=\"el el-l\">Loan payable\u003c/span>, foreign \u003cspan class=\"el el-a\">Cash\u003c/span>\u003c/td>\u003ctd>Spot rate\u003c/td>\u003ctd>Closing rate\u003c/td>\u003ctd>P&amp;L\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Inventory\u003c/span>, \u003cspan class=\"el el-a\">PPE at cost\u003c/span>, \u003cspan class=\"el el-a\">Prepayment\u003c/span>, \u003cspan class=\"el el-l\">Contract liability\u003c/span>\u003c/td>\u003ctd>Spot rate\u003c/td>\u003ctd>Historical rate (no change)\u003c/td>\u003ctd>None\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Inventory\u003c/span> NRV for the LCNRV test\u003c/td>\u003ctd>n/a\u003c/td>\u003ctd>Rate when NRV measured\u003c/td>\u003ctd>\u003cspan class=\"el el-x\">Write-down\u003c/span> to P&amp;L\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Revalued PPE\u003c/span>\u003c/td>\u003ctd>Spot rate\u003c/td>\u003ctd>Rate on valuation date\u003c/td>\u003ctd>OCI, with the \u003cspan class=\"el el-e\">revaluation surplus\u003c/span>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-a\">Investment property\u003c/span> (FV model), \u003cspan class=\"el el-a\">shares\u003c/span> at FVTPL\u003c/td>\u003ctd>Spot rate\u003c/td>\u003ctd>Rate on valuation date\u003c/td>\u003ctd>P&amp;L, with the \u003cspan class=\"el el-i\">FV gain\u003c/span>\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cspan class=\"el el-i\">Revenue\u003c/span> and \u003cspan class=\"el el-x\">expenses\u003c/span>\u003c/td>\u003ctd>Spot (or average) rate\u003c/td>\u003ctd>Not retranslated\u003c/td>\u003ctd>None\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>","sect":5,"part":"Where differences go"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":6,"part":"Wrap-up"},{"type":"summary","lo":56,"title":"Foreign currency on one page","rows":[["Functional currency?","Currency of the primary economic environment. Primary indicators first: sales prices, market forces, costs. Then financing and retained receipts."],["Presentation currency?","The currency the statements are presented in; a choice."],["Initial recording?","Spot rate on the transaction date (average rate if rates are stable)."],["Monetary items at year end?","Closing rate; difference to P&L."],["Non-monetary at cost?","Historical rate; not retranslated."],["Non-monetary at fair value?","Rate when fair value was measured; FX follows the gain (OCI or P&L)."],["Settled in the same period?","S$ {a|cash} paid − S$ recorded → P&L. The {a|inventory} or {i|revenue} doesn’t change."],["{a|Prepayments}, {l|advances}, {a|shares}?","Non-monetary."]],"id":"summary-5jayse","bucket":"wrap","sect":6,"part":"Wrap-up"}],"quiz":{"cases":{"ruby":{"name":"Ruby Enterprises","source":"Official practice paper (Q16–20 case, emeralds paragraph only)","text":["Ruby Enterprises Pte Ltd (Ruby) is a jewellery wholesaler based in Orchard Towers. Ruby has a financial year ending 31 December 20X7.","On 1 November 20X7, Ruby purchased raw emeralds from a US supplier for US$75,000. The US$ amount was payable in 30 days. The exchange rate on 1 November 20X7 was 1 US$ = 1.35 S$ and on 30 November 20X7 was 1 US$ = 1.29 S$. Ruby paid for the invoice on 30 November 20X7."]},"spice":{"name":"Straits Spice","text":["Straits Spice Pte Ltd (Straits) imports and blends spices in Singapore. Its functional currency is S$ and its year ends on 31 December 20X4.","On 1 October 20X4, Straits bought pepper from a US supplier for US$30,000 on credit, when US$1 = S$1.30. The invoice was unpaid at the year end and was paid on 31 January 20X5, when US$1 = S$1.31. The pepper was still in {a|inventory} at 31 December 20X4, with an NRV well above cost.","On 15 December 20X4, Straits paid a {a|deposit} of US$8,000 to a US manufacturer for a blending machine to be delivered in February 20X5, when US$1 = S$1.32.","Straits keeps a {a|US$ bank account}. Its {a|balance} of US$15,000 arose from a customer receipt on 1 December 20X4, when US$1 = S$1.31.","At 31 December 20X4, US$1 = S$1.33."]}},"questions":[{"id":"q1","type":"settle","case":"ruby","lo":56,"source":"Official practice paper Q19","q":"Ruby’s functional currency is Singapore dollars (S$). With reference to SFRS(I) 1-21, The Effects of Changes in Foreign Exchange Rates, identify how Ruby should recognise the effects of the foreign exchange transaction in the financial statements?","options":[{"pit":"fx-sign","t":"Recognise a foreign exchange loss of S$4,500 in the Statement of profit or loss","why":"Right amount, wrong direction. Ruby owed US$ and the S$ strengthened (1.35 → 1.29), so it paid fewer S$: S$96,750 against S$101,250."},{"ok":true,"t":"Recognise a foreign exchange gain of S$4,500 in the Statement of profit or loss","why":"{l|Payable} recorded at US$75,000 × 1.35 = S$101,250; paid US$75,000 × 1.29 = S$96,750. {i|Gain} 4,500 on a monetary item → P&L."},{"pit":"fx-oci","t":"Recognise a foreign exchange gain in other comprehensive income","why":"Exchange differences on monetary items such as a {l|trade payable} go to profit or loss."},{"pit":"no-entry-within-terms","t":"No adjustment required to the financial statements as the invoice was settled within the 30 days credit terms offered by the supplier","why":"The credit term is irrelevant. The rate moved between recording and paying, so an exchange difference arises."}]},{"id":"q2","type":"initial-rate","case":"ruby","lo":56,"source":"Practice question based on the Ruby case","q":"Ruby’s functional currency is S$. Which journal entry should Ruby record on 1 November 20X7?","options":[{"pit":"no-translation","je":[{"side":"Dr","account":"Inventory","amount":75000,"el":"a"},{"side":"Cr","account":"Trade payable","amount":75000,"el":"l"}],"why":"Records the US$ number as if it were S$. Ruby’s books are in S$: translate at the spot rate."},{"pit":"closing-initial","je":[{"side":"Dr","account":"Inventory","amount":96750,"el":"a"},{"side":"Cr","account":"Trade payable","amount":96750,"el":"l"}],"why":"Uses the 30 November payment rate. The purchase is recorded at the spot rate on the transaction date."},{"je":[{"side":"Dr","account":"Inventory","amount":101250,"el":"a"},{"side":"Cr","account":"Trade payable","amount":101250,"el":"l"}],"ok":true,"why":"US$75,000 × 1.35 = S$101,250 on both sides."},{"je":[{"side":"Dr","account":"Inventory","amount":101250,"el":"a"},{"side":"Cr","account":"Cash","amount":101250,"el":"a"}],"why":"The emeralds were bought on 30-day credit, so the credit is a {l|trade payable}, not {a|cash}."}]},{"id":"q3","type":"settle","case":"ruby","lo":56,"source":"Practice question based on the Ruby case","q":"Ruby’s functional currency is S$. Which journal entry should Ruby record on 30 November 20X7 when it pays the invoice?","options":[{"pit":"fx-to-asset","je":[{"side":"Dr","account":"Trade payable","amount":101250,"el":"l"},{"side":"Cr","account":"Cash","amount":96750,"el":"a"},{"side":"Cr","account":"Inventory","amount":4500,"el":"a"}],"why":"The difference belongs to the {l|payable}, not the emeralds. {a|Inventory} stays at its transaction-date cost."},{"je":[{"side":"Dr","account":"Trade payable","amount":101250,"el":"l"},{"side":"Cr","account":"Cash","amount":96750,"el":"a"},{"side":"Cr","account":"Foreign exchange gain","amount":4500,"el":"i"}],"ok":true,"why":"Clear the {l|payable} at S$101,250, pay S$96,750, and the 4,500 difference is a {i|gain} in P&L."},{"pit":"fx-oci","je":[{"side":"Dr","account":"Trade payable","amount":101250,"el":"l"},{"side":"Cr","account":"Cash","amount":96750,"el":"a"},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":4500,"el":"e"}],"why":"Exchange differences on monetary items go to P&L, not OCI."},{"pit":"fx-sign","je":[{"side":"Dr","account":"Trade payable","amount":96750,"el":"l"},{"side":"Dr","account":"Foreign exchange loss","amount":4500,"el":"x"},{"side":"Cr","account":"Cash","amount":101250,"el":"a"}],"why":"Uses the rates the wrong way round. Ruby paid fewer S$ than it recorded, which is a {i|gain}."}]},{"id":"q4","type":"nonmon","case":"ruby","lo":56,"source":"Practice question based on the Ruby case","q":"Ruby’s functional currency is S$. The emeralds are still in {a|inventory} at 31 December 20X7, with an NRV well above cost. The closing rate is US$1 = S$1.32. At what amount are they carried?","options":[{"pit":"fx-to-asset","t":"S$96,750","why":"The {a|cash} paid. The {i|exchange gain} went to P&L; it doesn’t reduce the cost of the emeralds."},{"pit":"nonmon-retranslate","t":"S$99,000","why":"Retranslates {a|inventory} at the closing rate. Inventory is non-monetary at cost: historical rate."},{"t":"S$101,250","ok":true,"why":"{a|Cost} at the transaction-date rate: US$75,000 × 1.35. Not retranslated; NRV is higher, so no {x|write-down}."},{"pit":"no-translation","t":"S$75,000","why":"The US$ amount, untranslated."}]},{"id":"q5","type":"closing","case":"ruby","lo":56,"source":"Practice question based on the Ruby case","q":"Ruby’s functional currency is S$. Suppose instead Ruby had not paid by 31 December 20X7, when US$1 = S$1.32. What would the {l|payable} be, and what exchange difference would Ruby recognise in 20X7?","options":[{"pit":"mon-historical","t":"{l|Payable} S$101,250; no exchange difference until it is paid","why":"A {l|payable} is monetary: it must be retranslated at the closing rate at the year end."},{"t":"{l|Payable} S$99,000; {i|gain} of S$2,250 in profit or loss","ok":true,"why":"US$75,000 × 1.32 = S$99,000, down 2,250 from S$101,250. {i|Gain} in P&L."},{"pit":"fx-oci","t":"{l|Payable} S$99,000; {i|gain} of S$2,250 in OCI","why":"Right amounts, wrong home. Monetary items → P&L."},{"pit":"fx-sign","t":"{l|Payable} S$99,000; {x|loss} of S$2,250 in profit or loss","why":"The {l|payable} fell in S$ terms, so it is a {i|gain}, not a {x|loss}."}]},{"id":"q6","type":"initial-rate","case":"spice","lo":56,"q":"Which journal entry should Straits record on 1 October 20X4?","options":[{"pit":"closing-initial","je":[{"side":"Dr","account":"Inventory","amount":39900,"el":"a"},{"side":"Cr","account":"Trade payable","amount":39900,"el":"l"}],"why":"Uses the 31 December closing rate. Record at the spot rate on the transaction date."},{"je":[{"side":"Dr","account":"Inventory","amount":39000,"el":"a"},{"side":"Cr","account":"Trade payable","amount":39000,"el":"l"}],"ok":true,"why":"US$30,000 × 1.30 = S$39,000."},{"pit":"closing-initial","je":[{"side":"Dr","account":"Inventory","amount":39300,"el":"a"},{"side":"Cr","account":"Trade payable","amount":39300,"el":"l"}],"why":"Uses the payment-date rate, which isn’t even known on 1 October."},{"pit":"no-translation","je":[{"side":"Dr","account":"Inventory","amount":30000,"el":"a"},{"side":"Cr","account":"Trade payable","amount":30000,"el":"l"}],"why":"The US$ amount untranslated."}]},{"id":"q7","type":"closing","case":"spice","lo":56,"q":"At what amount is the {l|trade payable} to the pepper supplier carried at 31 December 20X4, and what is the exchange difference?","options":[{"pit":"mon-historical","t":"S$39,000; none","why":"A {l|payable} is monetary: retranslate at the closing rate."},{"pit":"fx-sign","t":"S$39,900; {i|gain} of S$900","why":"The {l|payable} went up in S$: Straits owes more. That is a {x|loss}."},{"t":"S$39,900; {x|loss} of S$900 in profit or loss","ok":true,"why":"US$30,000 × 1.33 = S$39,900, up 900. Owe foreign currency + S$ weakens = {x|loss}."},{"t":"S$39,300; {x|loss} of S$300","why":"Uses the January payment rate. At 31 December use the closing rate; the payment rate matters only on settlement."}]},{"id":"q8","type":"nonmon","case":"spice","lo":56,"q":"At what amount is the pepper carried in {a|inventory} at 31 December 20X4?","options":[{"t":"S$39,000","ok":true,"why":"Non-monetary at cost: the transaction-date amount, not retranslated. NRV is well above {a|cost}."},{"pit":"nonmon-retranslate","t":"S$39,900","why":"Retranslates {a|inventory} at the closing rate. Only monetary items move."},{"pit":"fx-to-asset","t":"S$39,900, by adding the {x|exchange loss} to cost","why":"The {x|exchange loss} on the {l|payable} goes to P&L, not into the cost of the pepper."},{"pit":"no-translation","t":"S$30,000","why":"The US$ amount, untranslated."}]},{"id":"q9","type":"monetary","case":"spice","lo":56,"q":"How is the {a|deposit} for the blending machine carried at 31 December 20X4?","options":[{"pit":"prepay-monetary","t":"As a {a|monetary receivable} of S$10,640, at the closing rate","why":"The deposit will be settled by receiving a machine, not {a|cash}. It is a non-monetary {a|prepayment}."},{"t":"As a {a|prepayment} of S$10,560, at the rate on the payment date","ok":true,"why":"US$8,000 × 1.32 = S$10,560. Non-monetary at cost: not retranslated."},{"t":"As an {x|expense} in 20X4","why":"Nothing has been received yet, so there is nothing to expense. It is an {a|asset} ({a|prepayment})."},{"t":"As {a|machinery} of S$10,560","why":"The machine hasn’t been delivered, so it isn’t {a|PPE} yet."}]},{"id":"q10","type":"closing","case":"spice","lo":56,"q":"How is the {a|US$ bank balance} reported at 31 December 20X4?","options":[{"pit":"mon-historical","t":"S$19,650; {a|cash} is never retranslated","why":"Foreign currency {a|cash} is the most monetary item there is: closing rate."},{"pit":"fx-oci","t":"S$19,950, with a {i|gain} of S$300 in OCI","why":"Exchange differences on monetary items go to P&L."},{"t":"S$19,950, with a {i|gain} of S$300 in profit or loss","ok":true,"why":"US$15,000 × 1.33 = S$19,950, up 300 from S$19,650. Holding US$ while the S$ weakens = {i|gain}."},{"pit":"fx-sign","t":"S$19,950, with a {x|loss} of S$300 in profit or loss","why":"Straits holds US$; the US$ now buys more S$. That is a {i|gain}."}]},{"id":"q11","type":"functional","lo":55,"source":"Official practice paper Q15","q":"With reference to SFRS(I) 1-21, ‘The Effects of Changes in Foreign Exchange Rates’, identify which of the following details how a company’s functional currency is determined?","options":[{"ok":true,"t":"The currency of the primary economic environment in which the entity operates","why":"The definition of functional currency."},{"pit":"presentation-functional","t":"The currency in which the financial statements are presented","why":"That is the presentation currency, which can be chosen."},{"pit":"incorporation","t":"The currency preferred by shareholders","why":"Shareholders’ preference is not an indicator of the economic environment."},{"pit":"incorporation","t":"The currency of the country where the company is incorporated","why":"A Singapore-incorporated company can have US$ as its functional currency. Incorporation doesn’t decide it."}]},{"id":"q12","type":"functional","lo":55,"q":"Pandan Tech Pte Ltd sells software licences in Singapore at S$ prices set by local competition, and its developers are paid in S$. It raised its {e|equity} from US investors in US$. What is its functional currency?","options":[{"pit":"secondary-first","t":"US$, because its {e|equity} was raised in US$","why":"Financing is a secondary indicator. It counts only when the primary indicators are mixed, and here they aren’t."},{"t":"S$, because sales prices and costs are mainly in S$","ok":true,"why":"Both primary indicators point to S$, so the secondary ones never get a vote."},{"pit":"presentation-functional","t":"Whichever currency Pandan chooses to present in","why":"Presentation currency is a choice; functional currency is a fact."},{"t":"Both S$ and US$, one for each type of transaction","why":"An entity has one functional currency."}]},{"id":"q13","type":"initial-rate","lo":56,"q":"A Singapore company (functional currency S$) buys {a|equipment} from Japan for ¥5,000,000 on 1 March, pays on 31 March and reports at 30 June. At which rate is the equipment first recorded?","options":[{"t":"The spot rate on 1 March","ok":true,"why":"Initial recognition is at the spot rate on the transaction date."},{"pit":"closing-initial","t":"The spot rate on 31 March, when it is paid","why":"Payment is a later event. Any difference on settlement is a {i|gain} or {x|loss}, not a change to cost."},{"pit":"closing-initial","t":"The closing rate on 30 June","why":"The closing rate is used for monetary items at the reporting date. {a|Equipment} is non-monetary."},{"t":"The average rate for the year to 30 June","why":"An average rate approximates the spot rate for a short period of stable rates, not a whole year, and it is a shortcut for many transactions, not one big purchase."}]},{"id":"q14","type":"monetary","lo":56,"q":"Which of these items is retranslated at the closing rate at the year end?","options":[{"pit":"prepay-monetary","t":"A US$ {l|advance received} from a customer for goods not yet delivered","why":"Settled by delivering goods: non-monetary, at the historical rate."},{"t":"A {l|provision} to be settled in US$ cash","ok":true,"why":"An obligation to pay a determinable number of US$: monetary."},{"pit":"prepay-monetary","t":"{a|Shares} in a US company held as an investment","why":"{a|Equity shares} are non-monetary. If at fair value, they use the rate on the valuation date."},{"pit":"nonmon-retranslate","t":"A {a|machine} bought in US$ and held at cost","why":"Non-monetary at cost: historical rate."}]},{"id":"q15","type":"where","lo":56,"q":"A Singapore company revalues a {a|factory} it owns in Vietnam (revaluation model). Part of the S$ increase arises because the dong strengthened against the S$. Where is that exchange part recognised?","options":[{"pit":"fx-pl-nonmon","t":"Profit or loss, because all exchange differences go to P&L","why":"True for monetary items only. For a non-monetary item, the FX part follows the item’s own gain."},{"t":"OCI, together with the revaluation gain","ok":true,"why":"The {i|revaluation gain} is in OCI, so its exchange component goes to OCI too."},{"pit":"nonmon-retranslate","t":"It is not recognised: non-monetary items are not retranslated","why":"That is for items at cost. At fair value, translate at the rate on the valuation date."},{"t":"Split: the FV part in OCI, the FX part in P&L","why":"Not split. The FX part goes wherever the revaluation gain goes."}]}]},"exam":{"cases":{"harbour":{"name":"Harbourfront Marine","text":["Harbourfront Marine Pte Ltd (Harbourfront) repairs ships in Singapore. Its functional currency is S$ and its financial year ends on 31 December 20X5.","On 1 July 20X5, Harbourfront borrowed US$500,000 from a US bank. {x|Interest} is 4% a year, payable in US$ each 30 June. On the same day it bought a {a|ship engine} for US$120,000 in cash, for its own use; useful life 8 years, straight-line, no residual value, cost model.","Exchange rates: 1 July 20X5, US$1 = S$1.36; 31 December 20X5, US$1 = S$1.34."]},"lotus":{"name":"Lotus Exports","text":["Lotus Exports Pte Ltd (Lotus) sells furniture overseas. Its functional currency is S$ and its financial year ends on 31 December 20X6.","On 1 December 20X6, Lotus sold furniture to a US retailer for US$60,000 on credit, when US$1 = S$1.33. It collected the full amount on 15 February 20X7, when US$1 = S$1.31.","On 20 December 20X6, Lotus received an {l|advance} of US$20,000 from another customer for furniture to be shipped in January 20X7, when US$1 = S$1.35.","Lotus holds {a|teak} bought for US$15,000 when US$1 = S$1.40. At 31 December 20X6 the teak’s NRV is US$15,500.","At 31 December 20X6, US$1 = S$1.36."]}},"questions":[{"id":"x1","type":"closing","case":"harbour","lo":56,"q":"At what amount is the {l|US$ loan} carried at 31 December 20X5 (excluding {l|accrued interest})?","options":[{"pit":"mon-historical","t":"S$680,000","why":"The transaction-date amount. A {l|loan} is monetary: closing rate."},{"t":"S$670,000","ok":true,"why":"US$500,000 × 1.34 = S$670,000."},{"pit":"no-translation","t":"S$500,000","why":"The US$ amount, untranslated."},{"t":"S$690,000","why":"Adds the exchange movement instead of deducting it. The S$ strengthened, so the {l|loan} fell."}]},{"id":"x2","type":"where","case":"harbour","lo":56,"q":"Which journal entry records the retranslation of the {l|loan principal} at 31 December 20X5?","options":[{"pit":"fx-sign","je":[{"side":"Dr","account":"Foreign exchange loss","amount":10000,"el":"x"},{"side":"Cr","account":"Loan payable","amount":10000,"el":"l"}],"why":"Wrong direction. The S$ strengthened (1.36 → 1.34), so the {l|loan} is worth fewer S$: a {i|gain}."},{"pit":"fx-oci","je":[{"side":"Dr","account":"Loan payable","amount":10000,"el":"l"},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":10000,"el":"e"}],"why":"Exchange differences on monetary items go to P&L, not OCI."},{"je":[{"side":"Dr","account":"Loan payable","amount":10000,"el":"l"},{"side":"Cr","account":"Foreign exchange gain","amount":10000,"el":"i"}],"ok":true,"why":"680,000 − 670,000 = 10,000 decrease in the {l|liability}: a {i|gain} in P&L."},{"pit":"fx-to-asset","je":[{"side":"Dr","account":"Loan payable","amount":10000,"el":"l"},{"side":"Cr","account":"Machinery","amount":10000,"el":"a"}],"why":"The {l|loan}’s exchange difference has nothing to do with the {a|engine}’s cost."}]},{"id":"x3","type":"closing","case":"harbour","lo":56,"q":"What is the {l|accrued interest payable} on the {l|loan} at 31 December 20X5?","options":[{"pit":"mon-historical","t":"S$13,600","why":"Six months of US$ {l|interest} at the 1 July rate. {l|Accrued interest} is monetary: retranslate at the closing rate."},{"t":"S$13,400","ok":true,"why":"US$500,000 × 4% × 6/12 = US$10,000, a fixed US$ amount owed, so closing rate: × 1.34 = S$13,400."},{"t":"S$26,800","why":"A full year of {l|interest}. Only 6 months (July–December) have accrued."},{"t":"Nil, because interest is not payable until 30 June 20X6","why":"{x|Interest} accrues over time. Six months’ {l|interest} is owed at the year end even though it is paid later."}]},{"id":"x4","type":"nonmon","case":"harbour","lo":56,"q":"At what amount is the {a|ship engine} carried at 31 December 20X5?","options":[{"pit":"nonmon-retranslate","t":"S$150,750","why":"Retranslates the {a|engine} at the closing rate. PPE at cost stays at the historical rate."},{"t":"S$142,800","why":"Takes a full year’s {x|depreciation}. The engine was bought on 1 July: 6 months."},{"t":"S$153,000","ok":true,"why":"{a|Cost} US$120,000 × 1.36 = S$163,200, less 6 months’ {x|depreciation} 163,200 ÷ 8 × 6/12 = 10,200."},{"t":"S$163,200","why":"{a|Cost} with no {x|depreciation}."}]},{"id":"x5","type":"monetary","case":"harbour","lo":56,"q":"Which of Harbourfront’s items give rise to an exchange difference in 20X5 profit or loss?","options":[{"t":"The {l|loan principal} and the {l|accrued interest} only","ok":true,"why":"Both are monetary (fixed US$ to pay) and are retranslated at the closing rate. The {a|engine} is non-monetary at cost."},{"pit":"nonmon-retranslate","t":"The {l|loan}, the {l|accrued interest} and the {a|engine}","why":"The {a|engine} is non-monetary at cost: no retranslation, so no exchange difference."},{"pit":"mon-historical","t":"None, because nothing was settled in 20X5","why":"Monetary items are retranslated at every reporting date, settled or not."},{"t":"The {l|loan principal} only","why":"{l|Accrued US$ interest} is monetary too, and is retranslated the same way."}]},{"id":"x6","type":"closing","case":"lotus","lo":56,"q":"What exchange difference on the US retailer’s {a|receivable} does Lotus recognise in 20X6?","options":[{"pit":"fx-sign","t":"A {x|loss} of S$1,800","why":"Lotus is owed US$, and the S$ weakened (1.33 → 1.36): a {i|gain}."},{"t":"A {i|gain} of S$1,800 in profit or loss","ok":true,"why":"{a|Receivable} 79,800 → US$60,000 × 1.36 = 81,600. Up 1,800: {i|gain} in P&L."},{"pit":"ignore-ye","t":"None until the {a|receivable} is collected","why":"Monetary items are retranslated at every reporting date."},{"t":"An increase in {i|revenue} of S$1,800","why":"{i|Revenue} stays at the transaction-date amount. The difference is an {i|exchange gain}."}]},{"id":"x7","type":"settle","case":"lotus","lo":56,"q":"Which journal entry records the collection on 15 February 20X7?","options":[{"je":[{"side":"Dr","account":"Cash","amount":78600,"el":"a"},{"side":"Dr","account":"Foreign exchange loss","amount":3000,"el":"x"},{"side":"Cr","account":"Trade receivable","amount":81600,"el":"a"}],"ok":true,"why":"{a|Receivable} is carried at 81,600 after the year-end retranslation. {a|Cash} US$60,000 × 1.31 = 78,600. {x|Loss} 3,000."},{"pit":"ignore-ye","je":[{"side":"Dr","account":"Cash","amount":78600,"el":"a"},{"side":"Dr","account":"Foreign exchange loss","amount":1200,"el":"x"},{"side":"Cr","account":"Trade receivable","amount":79800,"el":"a"}],"why":"Ignores the year-end retranslation. The {a|receivable} was moved to 81,600 at 31 December."},{"pit":"fx-to-asset","je":[{"side":"Dr","account":"Cash","amount":78600,"el":"a"},{"side":"Dr","account":"Revenue","amount":3000,"el":"i"},{"side":"Cr","account":"Trade receivable","amount":81600,"el":"a"}],"why":"{i|Revenue} is not adjusted for later rate changes. The difference is an {x|exchange loss}."},{"pit":"fx-oci","je":[{"side":"Dr","account":"Cash","amount":78600,"el":"a"},{"side":"Dr","account":"Revaluation surplus (OCI)","amount":3000,"el":"e"},{"side":"Cr","account":"Trade receivable","amount":81600,"el":"a"}],"why":"Exchange differences on monetary items go to P&L."}]},{"id":"x8","type":"settle","case":"lotus","lo":56,"q":"Across 20X6 and 20X7 together, what is the net effect of the rate changes on the US retailer’s sale?","options":[{"t":"{x|Net exchange loss} of S$1,200; {i|revenue} stays at S$79,800","ok":true,"why":"{i|Gain} 1,800 in 20X6, {x|loss} 3,000 in 20X7: {x|net loss} 1,200 (79,800 recorded, 78,600 collected)."},{"pit":"fx-to-asset","t":"{i|Revenue} reduced to S$78,600; no exchange difference","why":"{i|Revenue} is fixed at the transaction-date rate. The difference is an {x|exchange loss}."},{"t":"{x|Net exchange loss} of S$3,000","why":"Only the 20X7 {x|loss}. The 20X6 {i|gain} offsets part of it."},{"pit":"fx-sign","t":"{i|Net exchange gain} of S$1,200","why":"Lotus collected fewer S$ than it recorded as {i|revenue}: a {x|net loss}."}]},{"id":"x9","type":"monetary","case":"lotus","lo":56,"q":"At what amount is the customer’s {l|US$ advance} carried at 31 December 20X6?","options":[{"pit":"prepay-monetary","t":"S$27,200, a {l|monetary liability} at the closing rate","why":"An {l|advance} for goods is settled by delivering furniture, not cash. It is non-monetary."},{"t":"S$27,000, a {l|contract liability} at the rate on the date received","ok":true,"why":"US$20,000 × 1.35 = S$27,000. Non-monetary: not retranslated."},{"t":"S$27,000, recognised as {i|revenue} in 20X6","why":"The furniture ships in January 20X7: no {i|revenue} yet. It is a {l|contract liability}."},{"pit":"no-translation","t":"S$20,000","why":"The US$ amount, untranslated."}]},{"id":"x10","type":"nonmon","case":"lotus","lo":56,"q":"At what amount is the {a|teak} carried at 31 December 20X6?","options":[{"pit":"nrv-rate","t":"S$20,400","why":"{a|Cost} retranslated at the closing rate. {a|Cost} stays at the historical rate."},{"pit":"nrv-rate","t":"S$21,080","why":"NRV in S$, but NRV is higher than cost, and {a|inventory} is at the lower of the two."},{"t":"S$21,000","ok":true,"why":"{a|Cost} US$15,000 × 1.40 = S$21,000; NRV US$15,500 × 1.36 = S$21,080. Cost is lower: no {x|write-down}."},{"pit":"nrv-rate","t":"S$21,700","why":"NRV at the historical rate. NRV uses the rate on the date NRV is measured. (And it is above {a|cost} anyway.)"}]},{"id":"x11","type":"where","lo":56,"q":"A Singapore company (functional currency S$) holds a Kuala Lumpur office block as {a|investment property} under the fair value model. Fair value was RM3,000,000 at 1 January (RM1 = S$0.31) and RM3,100,000 at 31 December (RM1 = S$0.30). What is the effect on profit or loss for the year?","options":[{"pit":"fx-oci","t":"A {i|fair value gain} of S$30,000 in P&L and an {x|exchange loss} of S$30,000 in OCI","why":"The FX part follows the {i|fair value gain}, which goes to P&L for investment property. Nothing goes to OCI."},{"t":"Nil: the S$ {a|carrying amount} is unchanged","ok":true,"why":"RM3,000,000 × 0.31 = S$930,000; RM3,100,000 × 0.30 = S$930,000. The {i|ringgit gain} (30,000) and the {x|exchange loss} (30,000) both go to P&L and cancel out."},{"pit":"nonmon-retranslate","t":"A {i|fair value gain} of S$31,000 in P&L","why":"Translates the {i|RM gain} at the old rate and ignores the exchange effect. At fair value, use the rate on the valuation date for the whole amount."},{"t":"A {i|fair value gain} of S$30,000 in P&L only","why":"Misses the exchange effect on the {a|opening amount}. Translate the whole {a|fair value} at the 31 December rate."}]},{"id":"x12","type":"functional","lo":55,"q":"Over several years a Singapore company’s customers, suppliers and pricing all shift from S$ to US$, and management concludes its functional currency is now US$. How is the change applied?","options":[{"t":"Retrospectively, restating prior years as if US$ had always been the functional currency","why":"The previous functional currency was right for its time. Nothing is restated."},{"t":"Prospectively, from the date of the change","ok":true,"why":"A change in functional currency reflects a change in underlying conditions, so it applies from that date onwards."},{"pit":"presentation-functional","t":"It can’t change: the functional currency is chosen once at incorporation","why":"It is not chosen at all. It reflects the underlying transactions, and changes when they change."},{"pit":"presentation-functional","t":"By changing the presentation currency instead","why":"Presentation currency is a separate choice; it doesn’t replace the functional currency."}]}]},"prepared":true}],"shared":{"peers":{"B1.1":["B1.2","B1.3"],"B1.2":["B1.3","B1.1","B2.1"],"B1.3":["B1.2","B1.1"],"B1.4":["B2.4","B1.2","B1.3"],"B2.1":["B1.2","B2.4","B1.4"],"B2.2":["B2.3","B3"],"B2.3":["B2.4","B2.2"],"B2.4":["B1.4","B2.3","B2.1"],"B3":["B1.2","B1.1","B1.4"],"C2":["B1.2","B1.1","B1.3"]},"compare":{"classify":{"title":"Classify: which standard, which category?","question":"Before you look: what single question decides the standard (and the category) for each of these assets?","cols":["Deciding question","Categories"],"rows":[{"code":"B1.1","name":"Inventory","cells":["Is it held **for sale** in the ordinary course, or to be used up in producing goods for sale?","Raw materials, work in progress, finished goods"],"why":"It is held to be **sold** within the operating cycle, so its cost should meet the revenue it earns"},{"code":"B1.2","name":"PPE","cells":["Is it held **for use** in production, supply or admin, for more than one period?","Classes (land, buildings, machinery…); the measurement model is chosen per class"],"why":"It is **used up over years** to earn income, so its cost is spread over the periods that benefit"},{"code":"B1.3","name":"Investment property","cells":["Is the property held **to earn rent or capital appreciation**, not for use or sale?","IP vs owner-occupied PPE vs inventory; split mixed-use only if parts are separately saleable"],"why":"It earns cash **on its own** (rent or price gains), like an investment, not as part of operations"},{"code":"B1.4","name":"Financial assets","cells":["**Business model** + **SPPI** test (do the cash flows pay only principal and interest?)","Amortised cost, FVOCI, FVTPL; equity FVTPL unless FVOCI elected on day one"],"why":"It is a **contract for cash**: how the cash flows are managed and what they are decide whether cost or fair value tells the truer story"},{"code":"B2.1","name":"Leases (ROU asset / lessor)","cells":["Lessee: is it a lease at all? Lessor: are substantially all **risks and rewards** transferred?","Lessee: one model (except short-term / low-value). Lessor: finance vs operating"],"why":"The lessee controls the asset’s use and owes the payments either way; for the lessor the question is who really carries the asset"},{"code":"B2.2","name":"Deferred tax","cells":["n/a: tax balances aren't \"classified\" this way. Compare **carrying amount** with **tax base**","Taxable difference → {l|deferred tax liability}; deductible difference → {a|deferred tax asset}"],"why":"Tax rules and accounting rules time income differently; deferred tax matches the tax charge to the profit reported"},{"code":"B2.3","name":"Provisions & contingencies","cells":["How likely is the outflow, and is there a present obligation?","Provision (recognise), contingent liability (disclose unless remote), contingent asset (disclose if probable), nothing"],"why":"The amount or timing is **uncertain**, so likelihood decides book, disclose or ignore, keeping guesses off the balance sheet"},{"code":"B2.4","name":"Financial liabilities","cells":["Must the entity deliver cash under a contract? Then: held for trading or designated?","No SPPI or business model test: amortised cost by default, FVTPL only for trading or designated liabilities"],"why":"An obligation to pay cash is a {l|liability}, not {e|equity}; most are simply held to be repaid, so amortised cost fits"},{"code":"B3","name":"Impairment","cells":["PPE, intangibles, goodwill, IP at cost, ROU assets; test alone or as a **CGU** if no independent cash flows","Not inventory, financial assets or IP at fair value; goodwill always within a CGU"],"why":"Assets at cost can drift above what they will earn; fair-value assets already show the fall, and inventory and financial assets have their own tests"},{"code":"C2","name":"Borrowing costs","cells":["Does the asset necessarily take a substantial period to get ready?","Qualifying asset (build or mature) vs not (ready when bought, financial assets, mass-produced stock)."],"why":"Interest paid during a long build is part of what the asset really cost to get ready"}],"pattern":"The **purpose** for which the asset is held (or the contract terms) picks the standard; the standard then picks the measurement."},"recognise":{"title":"Recognise: when does it go on the balance sheet?","question":"Before you look: is there one test that sits behind all of these recognition points?","cols":["Recognise when…","Special point"],"rows":[{"code":"B1.1","name":"Inventory","cells":["Control of the goods passes to the entity","Shipping terms decide who holds goods in transit at year end"],"why":"Whoever controls the goods carries their risks and benefits, so that is who shows them"},{"code":"B1.2","name":"PPE","cells":["Future benefits are **probable** and cost can be **measured reliably**","Significant parts recognised as separate components"],"why":"Only something that will bring benefits, at a cost you can measure, belongs on the balance sheet"},{"code":"B1.3","name":"Investment property","cells":["Same test as PPE: probable benefits + reliable cost","Can be owned, or held by a lessee as a {a|right-of-use asset}"],"why":"Same kind of asset as PPE, so the same general test; only the purpose differs"},{"code":"B1.4","name":"Financial assets","cells":["The entity **becomes a party to the contract**","Not when cash moves: the contract triggers it"],"why":"Rights arise from the **contract**, not from cash moving, so the contract is the trigger"},{"code":"B2.1","name":"Leases (ROU asset / lessor)","cells":["Lessee: at **commencement**, an {a|ROU asset} and a {l|lease liability}","Optional exemptions: short-term (≤ 12 months, no purchase option) and low-value; expense those"],"why":"From commencement the lessee controls the asset and owes the payments, so both exist from day one"},{"code":"B2.2","name":"Deferred tax","cells":["{l|DTL}: all taxable temporary differences. {a|DTA}: only if future taxable profit is **probable**","Narrow exceptions, e.g. goodwill on initial recognition; recent losses count against a DTA"],"why":"A {l|DTL} is a near-certain future tax bill; a {a|DTA} is only worth something if there will be profits to use it against"},{"code":"B2.3","name":"Provisions & contingencies","cells":["Present obligation (legal or **constructive**) from a past event + probable outflow + reliable estimate","Never for intentions or future operating losses; yes for onerous contracts; restructuring needs plan + announcement"],"why":"An intention can be changed, an obligation cannot; only a past event that leaves no realistic escape creates a {l|liability}"},{"code":"B2.4","name":"Financial liabilities","cells":["When the entity **becomes a party to the contract** (bond issued, loan drawn)","Board plans create nothing; trade payables arise when the goods are received"],"why":"Like a financial asset, the **contract** creates the obligation; a plan or board decision does not"},{"code":"B3","name":"Impairment","cells":["Any **indication** of impairment at the reporting date (external or internal)?","Every year regardless for goodwill, indefinite-life intangibles and intangibles not yet in use"],"why":"Testing every asset every year would be costly, so test when there is a sign; goodwill and similar can’t be checked by use, so test yearly"},{"code":"C2","name":"Borrowing costs","cells":["Capitalise from when spending, borrowing costs and work have all begun.","Suspend for extended halts only, not normal or necessary delays."],"why":"Interest is a cost of the asset only while the asset is actually being built with borrowed money"}],"pattern":"Recognise when the entity controls a probable future benefit (or owes an obligation) that can be measured reliably."},"initial":{"title":"Initial measurement: what goes into the first number?","question":"Before you look: which costs get capitalised, and which one asset class treats transaction costs differently?","cols":["Starts at","Special point"],"rows":[{"code":"B1.1","name":"Inventory","cells":["**Cost**: purchase price + duties + transport − trade discounts + conversion costs","Abnormal waste, storage, unrelated admin and selling costs are **expensed**"],"why":"Cost includes everything to get the goods **ready to sell**; costs after that don’t add value to the goods"},{"code":"B1.2","name":"PPE","cells":["**Cost** to get it ready for use, + estimated **dismantling / restoration** costs","Training, relocation, admin overheads, recoverable GST never capitalised; test-output sales go to P&L"],"why":"Cost includes everything to get it **ready to use**, including the clean-up you are already committed to"},{"code":"B1.3","name":"Investment property","cells":["**Cost** incl. **transaction costs** (legal fees, stamp duty)","Same as PPE on day one, whichever model is used later"],"why":"On day one, cost is the best measure of what was paid, whatever model is chosen later"},{"code":"B1.4","name":"Financial assets","cells":["**Fair value + transaction costs**","FVTPL: transaction costs **expensed**. Trade receivables: transaction price"],"why":"Fair value is what the contract is worth; costs follow the measurement, so FVTPL expenses them because fair value would wipe them out the next day"},{"code":"B2.1","name":"Leases (ROU asset / lessor)","cells":["{l|Lease liability} = PV of unpaid payments; {a|ROU asset} = liability + prepaid + IDC + restoration − incentives","Discount at the rate implicit in the lease, else incremental borrowing rate"],"why":"The {a|ROU asset} is what you paid for the right of use: the PV of the payments you owe, plus costs to get it ready"},{"code":"B2.2","name":"Deferred tax","cells":["**Temporary difference × rate** enacted or substantively enacted for when it reverses","Never discounted; proposed rates are ignored"],"why":"It is the tax that will be paid or saved when the difference reverses, at the rate that will apply then"},{"code":"B2.3","name":"Provisions & contingencies","cells":["**Best estimate**: expected value (population) or most likely outcome (single obligation)","Discount if material; decommissioning PV is added to the asset's cost"],"why":"It is the amount the entity would rationally pay to settle today, so use the best estimate and the time value of money"},{"code":"B2.4","name":"Financial liabilities","cells":["**Fair value (cash received) − transaction costs**","Costs are **deducted** (an asset adds them), then spread via the effective rate; FVTPL expenses them"],"why":"The entity received less cash after paying costs, so the {l|liability} starts lower and the costs are charged as extra interest"},{"code":"B3","name":"Impairment","cells":["Recoverable amount = **higher of** FVLCOD and value in use","VIU excludes financing, tax, uncommitted restructurings and upgrades; either above carrying amount → no impairment"],"why":"An asset is worth the better of selling it or using it, so recoverable amount takes the higher one"},{"code":"C2","name":"Borrowing costs","cells":["Specific loan: actual interest less investment income. General: weighted rate × time-weighted spend.","Capped at actual borrowing costs; required, not a policy choice."],"why":"Only interest actually incurred on money spent on the asset is a real cost of it"}],"pattern":"Start at **cost**: everything directly needed to bring the asset to its intended use, nothing more."},"subsequent":{"title":"Subsequent measurement: what happens at each year end?","question":"Before you look: for each asset, where does a gain in value go, P&L, OCI or nowhere?","cols":["Model","Where changes go"],"rows":[{"code":"B1.1","name":"Inventory","cells":["**Lower of cost and NRV**, reassessed each reporting date","Write-down to {x|COGS} / P&L; reversal allowed, capped at original cost"],"why":"**Prudence**: never carry goods above what they will sell for, but no upward revaluation above cost"},{"code":"B1.2","name":"PPE","cells":["**Cost model** (cost − {a|accumulated depreciation} − impairment) or **revaluation model**, per class","Surplus → OCI ({e|revaluation surplus}); fall → P&L, each first reversing the other"],"why":"Its benefits are used up over time, so depreciate; a revaluation gain isn’t earned until the asset is used or sold, so it waits in OCI"},{"code":"B1.3","name":"Investment property","cells":["**Fair value model** (no depreciation) or **cost model**, one choice for all IP","Fair value gains and losses → **P&L** (not OCI, unlike PPE)"],"why":"It is held for its value, so changes in that value are part of its **performance** and go to P&L"},{"code":"B1.4","name":"Financial assets","cells":["**Amortised cost** (effective interest), **FVOCI** or **FVTPL**","AC: interest to P&L. FVOCI: fair value changes to OCI. FVTPL: everything to P&L"],"why":"The business model decides: holding for cash flows → interest; holding to collect and sell → fair value in OCI; trading → fair value in P&L"},{"code":"B2.1","name":"Leases (ROU asset / lessor)","cells":["{a|ROU asset} depreciated; {l|lease liability} + interest − payments","{x|Depreciation} and {x|interest expense} → P&L; ROU over shorter of lease term and useful life"],"why":"An asset you use (depreciate) plus a loan you repay (interest), like buying it with borrowed money"},{"code":"B2.2","name":"Deferred tax","cells":["**Remeasure** the balance each year end; apply enacted **rate changes**; reassess DTA","Movement → P&L, unless the item went to OCI or equity (then it follows)"],"why":"It is just the future tax effect of today’s differences, so recompute it each year; the tax follows the item it relates to"},{"code":"B2.3","name":"Provisions & contingencies","cells":["Reviewed every year end to the current best estimate; discount unwinds","Estimate changes to P&L; unwinding to {x|finance cost}"],"why":"Always show the current best estimate of what is owed; unwinding the discount is the cost of time"},{"code":"B2.4","name":"Financial liabilities","cells":["Carrying amount × **effective rate**; opening + interest − cash = closing","A premium cuts the expense and a discount adds to it, both ending at face; designated FVTPL sends own credit to OCI"],"why":"The effective rate spreads the full cost of borrowing (interest, premium or discount, fees) evenly over the life"},{"code":"B3","name":"Impairment","cells":["Loss = carrying amount − recoverable amount, to P&L at once","Revalued asset: its own surplus in OCI first; CGU: goodwill first, then pro rata with a floor; then depreciate the new amount"],"why":"Don’t carry an asset above what it can recover; goodwill absorbs the loss first because it is the least certain"},{"code":"C2","name":"Borrowing costs","cells":["n/a: the capitalised interest sits in the asset's cost.","Depreciated with the asset under its own standard (PPE, IP, intangibles, inventory)."],"why":"Once capitalised, the interest is part of the asset’s cost and follows the asset"}],"pattern":"Every asset is retested each year end so it is not carried above what it will recover; the standard decides whether the change hits P&L or OCI."},"derecognise":{"title":"Derecognise: how does it leave the balance sheet?","question":"Before you look: when each asset leaves, what happens to any gains parked in equity?","cols":["Leaves when…","What happens"],"rows":[{"code":"B1.1","name":"Inventory","cells":["It is **sold** (or written off)","Carrying amount → {x|cost of goods sold} in the period the revenue is recognised"],"why":"**Matching**: the cost of the goods sold is set against the revenue from selling them"},{"code":"B1.2","name":"PPE","cells":["**Disposal**, or no further benefits expected","Gain/loss = net proceeds − carrying amount → P&L; {e|revaluation surplus} → {e|retained earnings}, not P&L"],"why":"The surplus was already in OCI; recycling it would count the same gain twice, so it moves within equity"},{"code":"B1.3","name":"Investment property","cells":["**Disposal**, or a **transfer** on evidenced change in use","Disposal gain/loss → P&L. PPE → IP: increase to OCI; inventory → IP: difference to P&L"],"why":"A change in use changes what the asset is, so its accounting changes; gains follow the standard it came from"},{"code":"B1.4","name":"Financial assets","cells":["Rights to cash flows expire, or the asset is **sold / transferred**","FVOCI debt: OCI **recycled** to P&L. FVOCI equity: **never** recycled (may move to {e|retained earnings})"],"why":"FVOCI debt is a held-for-cash-flows asset, so the gain is realised on sale; equity FVOCI was an irrevocable choice to keep gains out of P&L for good"},{"code":"B2.1","name":"Leases (ROU asset / lessor)","cells":["**Lease ends** (or is terminated); lessor finance lease: asset derecognised at commencement","At term end ROU is fully depreciated and liability fully paid; lessor recognises a {a|lease receivable}"],"why":"A finance lease transfers the risks and rewards, so the lessor holds a receivable, not the asset"},{"code":"B2.2","name":"Deferred tax","cells":["The temporary difference **reverses**","DTL/DTA unwinds through tax expense; DTA written down if profit is no longer probable"],"why":"It only existed because of a timing difference, so it goes when the timing difference does"},{"code":"B2.3","name":"Provisions & contingencies","cells":["Used for the expenditure it was set up for, or outflow no longer probable","Use: Dr provision, Cr cash; unused amounts reversed to P&L; never used for other costs"],"why":"A {l|provision} is earmarked for one obligation; using it for anything else would hide other costs"},{"code":"B2.4","name":"Financial liabilities","cells":["When the obligation is **discharged, cancelled or expires**","Early repayment: carrying amount − cash paid, to P&L, never measured against face value"],"why":"The {l|liability} goes when the obligation does; any difference from the cash paid is a real gain or loss of settling early"},{"code":"B3","name":"Impairment","cells":["Nothing leaves; reverse the loss if the indicators reverse","Capped at the no-impairment carrying amount; goodwill never reversed"],"why":"An impairment is an estimate, so reverse it if the estimate improves, but not above the depreciated cost; goodwill reversal would be internally generated goodwill"},{"code":"C2","name":"Borrowing costs","cells":["Cease when substantially all the work is complete, not at first use or loan repayment.","Part by part if parts are usable alone; interest after that goes to P&L."],"why":"Once the asset is ready, interest is a cost of financing, not of the asset"}],"pattern":"On exit, the remaining carrying amount is compared with what was received; only some OCI gains are ever recycled to P&L."},"present":{"title":"Present and disclose: what the reader sees","question":"Before you look: what would a reader need to know to trust each of these numbers?","cols":["Presentation","Key disclosures"],"rows":[{"code":"B1.1","name":"Inventory","cells":["Current asset at lower of cost and NRV","Cost formula (FIFO / weighted average), amount expensed, write-downs and reversals"],"why":"It turns into cash within the operating cycle, so it is current"},{"code":"B1.2","name":"PPE","cells":["Non-current, by class, net of {a|accumulated depreciation}","Depreciation methods and lives, carrying amount reconciliation; if revalued: date, valuer, cost-model amount, surplus"],"why":"Users need the methods and estimates to judge the depreciation, and the cost-model amount to compare entities"},{"code":"B1.3","name":"Investment property","cells":["Separate line from PPE","Model used; **fair value disclosed even under the cost model**; rental income and direct expenses"],"why":"It earns income differently from PPE, so it is shown apart; fair value is the number users care about"},{"code":"B1.4","name":"Financial assets","cells":["By category; current or non-current","Gains split between P&L and OCI; {a|loss allowance} (expected credit losses) for AC and FVOCI debt"],"why":"Users need to see which gains are in P&L and which in OCI, and how much credit loss is expected"},{"code":"B2.1","name":"Leases (ROU asset / lessor)","cells":["{a|ROU asset} and {l|lease liability} shown separately or disclosed","Depreciation, interest, exempt-lease expense, total cash outflow, additions to ROU assets"],"why":"Leases are debt-like, so users need the cash outflow and the size of the commitment"},{"code":"B2.2","name":"Deferred tax","cells":["Always **non-current**; offset only with legal right + same tax authority","Components of tax expense; reconciliation of tax expense to accounting profit × rate"],"why":"It reverses over many years and is never discounted, so it is always non-current; the reconciliation explains an odd tax rate"},{"code":"B2.3","name":"Provisions & contingencies","cells":["Provision in liabilities; contingencies in the notes only","Reconciliation per class (no comparatives); contingent liabilities unless remote; contingent assets if probable"],"why":"Provisions are estimates, so users need to see the movements and the uncertainties behind them"},{"code":"B2.4","name":"Financial liabilities","cells":["Amortised cost (or fair value), split current / non-current","Interest goes in finance costs; OCI only for the own credit of designated FVTPL liabilities"],"why":"Users need the cost of borrowing (finance costs) and when the debt falls due"},{"code":"B3","name":"Impairment","cells":["Losses and reversals by class, in P&L (or OCI for revalued assets)","Material losses: the cause, and whether FVLCOD or VIU was used (with its discount rate)"],"why":"An impairment is a judgement, so users need the cause and the method used"},{"code":"C2","name":"Borrowing costs","cells":["Inside the asset's cost; interest not capitalised goes in finance costs.","Disclose the amount capitalised in the period and the capitalisation rate."],"why":"Capitalised interest raises the asset and cuts the expense, so users need the amount and the rate"}],"pattern":"Show the number, the basis it was measured on and what moved it, so a reader can judge the estimates behind it."}}},"legacy":{"leases":["intro-n6hhl4","think-xcq4aw","think-jmq1yk","rule-mcen13","visual-14lb40","mcq-i50pkx","think-q6ubkb","rule-1lcdxc","mcq-1ys9x6","think-1msvo8","rule-niodw9","calc-122zgt","think-dyls00","rule-4ans74","mcq-vw3bro","think-1s9nc3","rule-37e3oq","je-135h21","think-12epdj","visual-14mvhm","je-oouv30","think-h7iqte","calc-qn47ns","think-nnhkef","visual-oee94k","mcq-sj1gjp","think-hxh11z","rule-1rjfvh","mcq-1tewb0","visual-17stdj","je-178jah","think-11jdh6","calc-v0l94q","think-6q0cp0","rule-1i3b09","calc-9wvbid","mcq-1le65j","think-2uyovk","rule-10oyq2","mcq-1oqkl3","summary-bc09z6"],"income-tax":["intro-aagx29","think-1fq46d","think-19d99l","rule-1ldzxf","think-10vq03","rule-1ue2id","mcq-zlk2c3","think-1fgou8","rule-1gkqy3","think-1b3ch6","calc-1xk3tb","visual-13r6mf","mcq-1m04zk","think-16m9nu","visual-p2nmlv","calc-1qvxe3","je-1q8rw6","calc-uzh0z0","je-17mg5i","rule-16i10c","think-1u5fzw","je-1fquyk","visual-1uc7lp","think-15ipji","visual-337158","calc-rlvo1p","think-ppe9lz","mcq-116pln","think-46ie71","rule-feids1","je-196b12","mcq-16bht0","think-30re0n","visual-148hml","rule-7bdyl1","mcq-1giz1i","summary-odus2z"]},"schedule":{"exam":"Thu 3 Dec 2026","milestones":[[7,"Framework, assets, financial instruments, provisions, borrowing costs learned · Quiz 1"],[14,"Leases, tax, revenue learned · Quiz 2"],[21,"Equity, Section E, FS structure learned · Quiz 3"],[25,"Whole syllabus learned · Mock 1 (official practice paper) reviewed"],[28,"Cheat sheet v1 · Quiz 4"],[29,"Mock 2"],[35,"Revision of every section done · cheat sheet v2"],[36,"Mock 3"],[42,"Mock 4"],[44,"Cheat sheet final"]],"days":[{"date":"2026-10-18","kind":"learn","sec":"A","title":"Framework: objectives and qualitative characteristics","f