.73,-146 205.73,-152 199.73,-158 193.73,-158\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"105.68\" y=\"-140.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Valid expectation\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"116.93\" y=\"-131.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">in those affected\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge1\" class=\"edge\">\n\u003ctitle>constr&#45;&gt;valid\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M150.3,-182.62C150.3,-177.62 150.3,-172.06 150.3,-166.68\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"152.75,-166.98 150.3,-159.98 147.85,-166.98 152.75,-166.98\"/>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>valid&#45;&gt;event\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M133.51,-121.62C127.99,-115.91 121.76,-109.46 115.89,-103.38\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"117.85,-101.88 111.22,-98.55 114.32,-105.29 117.85,-101.88\"/>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>intent\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" stroke-dasharray=\"5,2\" d=\"M369.98,-219C369.98,-219 278.62,-219 278.62,-219 272.62,-219 266.62,-213 266.62,-207 266.62,-207 266.62,-195 266.62,-195 266.62,-189 272.62,-183 278.62,-183 278.62,-183 369.98,-183 369.98,-183 375.98,-183 381.98,-189 381.98,-195 381.98,-195 381.98,-207 381.98,-207 381.98,-213 375.98,-219 369.98,-219\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"281.18\" y=\"-201.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#374151\">Intention or plan\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"277.43\" y=\"-192.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#374151\">board decision, budget\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>none\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" stroke-dasharray=\"5,2\" d=\"M362.48,-158C362.48,-158 286.12,-158 286.12,-158 280.12,-158 274.12,-152 274.12,-146 274.12,-146 274.12,-134 274.12,-134 274.12,-128 280.12,-122 286.12,-122 286.12,-122 362.48,-122 362.48,-122 368.48,-122 374.48,-128 374.48,-134 374.48,-134 374.48,-146 374.48,-146 374.48,-152 368.48,-158 362.48,-158\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"289.05\" y=\"-140.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#374151\">No obligation\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"284.93\" y=\"-131.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#374151\">can still be avoided\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>intent&#45;&gt;none\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M324.3,-182.62C324.3,-177.62 324.3,-172.06 324.3,-166.68\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"326.75,-166.98 324.3,-159.98 321.85,-166.98 326.75,-166.98\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>pres\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M140.1,-36C140.1,-36 46.5,-36 46.5,-36 40.5,-36 34.5,-30 34.5,-24 34.5,-24 34.5,-12 34.5,-12 34.5,-6 40.5,0 46.5,0 46.5,0 140.1,0 140.1,0 146.1,0 152.1,-6 152.1,-12 152.1,-12 152.1,-24 152.1,-24 152.1,-30 146.1,-36 140.1,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"45.3\" y=\"-14.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Present obligation\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>event&#45;&gt;pres\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M93.3,-60.62C93.3,-55.62 93.3,-50.06 93.3,-44.68\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"95.75,-44.98 93.3,-37.98 90.85,-44.98 95.75,-44.98\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"think-ljs7nr","type":"think","bucket":"recognise","blabel":"the four tests","lo":32,"scenario":"A new law requires factories to fit smoke filters by 30 June 20X5. At 31 December 20X4 Woodlands Foundry hasn’t fitted them. The filters will cost about $150,000.","prompt":"Is there a {l|provision} for the $150,000 at 31 December 20X4?","answer":["**No.** There is no obligating past event: Woodlands could avoid the cost by its own future action, for example by closing or selling the factory, or changing how it operates.","The cost will be a capital outlay when it happens, not a {l|liability} now.","If June passes and the filters still aren’t fitted, a **fine** for breaking the law could become a present obligation, because then the breach (a past event) has happened."],"sect":4,"part":"Recognise · the four tests"},{"type":"mcq","bucket":"recognise","blabel":"the four tests","lo":32,"q":"Which of these gives rise to a **present obligation** at the year end?","options":[{"t":"The board has decided to repaint all stores next year","why":"A decision about the future. The company could still change its mind."},{"t":"A retailer has always refunded unhappy customers, and says so on its receipts","ok":true,"why":"Published policy and past practice create a valid expectation: a constructive obligation for sales already made."},{"t":"A law requires a safety upgrade by next year, and the work hasn’t been done","why":"The company can avoid the cost by its own future action. No past obligating event yet."},{"t":"The company expects to make operating losses next year","why":"Future losses come from future events. There is no obligation now."}],"id":"mcq-19fpt3","sect":4,"part":"Recognise · the four tests"},{"type":"map","id":"map-5-recognise","bucket":"recognise","blabel":"special cases","sect":5,"part":"Recognise · special cases"},{"type":"think","bucket":"recognise","blabel":"special cases","lo":33,"scenario":"Kallang’s commercial ovens division is expected to lose about $300,000 next year as competitors cut prices.","prompt":"The loss is probable and can be estimated. Is that enough to provide for it now?","answer":["**No.** Tests 3 and 4 pass, but test 1 fails: there is no present obligation. The losses will come from **future** trading, which Kallang could still change (cut costs, close the division).","Future operating losses are **never** provided for. They are a hint that the division’s {a|assets} might be **impaired**, so test them for impairment instead."],"id":"think-3ohf5z","sect":5,"part":"Recognise · special cases"},{"type":"rule","bucket":"recognise","blabel":"special cases","lo":33,"title":"Special cases","body":["The four tests sound tidy, but a few situations come up again and again in exams. Here is how each one fares against them.","- **Future operating losses: no.** No present obligation. Hint that {a|assets} may be impaired.","- **Onerous contract: yes.** The unavoidable costs of the contract exceed the benefits expected from it.","- **Restructuring: only with a constructive obligation**, which needs a **detailed formal plan** **and** a **valid expectation** in those affected (it has started, or it has been announced to them). A board decision alone isn’t enough. Only direct costs.","- **Decommissioning or restoration: yes**, when the damage is done. The present value of the cost is **added to the {a|asset}** under SFRS(I) 1-16, then unwound.","- **Warranties: yes.** The sale with a warranty is the obligating event; measure at expected value.","- **Self-insurance, future repairs, refurbishment: no.** They can be avoided (e.g. by selling the {a|asset}). Spread the cost through {x|depreciation} instead."],"id":"rule-b21rz9","sect":5,"part":"Recognise · special cases"},{"id":"think-sqdixa","type":"think","bucket":"recognise","blabel":"special cases","lo":33,"scenario":"On 1 December 20X4 the board of Bishan Biscuits approved a detailed plan to close its Tuas factory: which staff go, the costs and the timetable. On 20 December the plan was announced to the staff and the union. The year end is 31 December.","prompt":"Is there a {l|restructuring provision} at 31 December? Would the answer change if the announcement had been on 20 January?","answer":["Yes. On 20 December the **announcement** created a **valid expectation** in those affected. With the **detailed formal plan**, that gives a constructive obligation at year end.","If the announcement were on 20 January, at 31 December there would only be a board decision: **no {l|provision}**. (The January announcement might need disclosure as an event after the reporting period.)"],"sect":5,"part":"Recognise · special cases"},{"type":"diagram","bucket":"recognise","blabel":"special cases","lo":33,"title":"Restructuring: when, and how much?","intro":"Two gates before a restructuring provision, and a strict list of what goes in.","notes":{"board":"A board decision on its own is only an intention. The board could still reverse it.","plan":"Gate 1: a detailed formal plan identifying the business affected, the locations, the employees to be compensated, the costs and the timing.","exp":"Gate 2: a valid expectation in those affected, because the plan has started (e.g. dismantling plant) or its main features have been announced to them.","no":"Fail either gate: no {l|provision} at year end.","prov":"Both gates passed: a constructive obligation. Provide for the direct costs only.","inc":"Direct costs that are necessarily caused by the restructuring and not linked to ongoing activities, e.g. redundancy pay ($300,000) and penalties for ending contracts ($70,000).","out":"Excluded: retraining or relocating continuing staff, marketing, investment in new systems, and future operating losses. They relate to the future business."},"walk":[{"nodes":["board","plan"],"text":"A board decision first needs a detailed formal plan."},{"nodes":["exp"],"text":"Then a valid expectation: the plan has started or been announced to those affected."},{"nodes":["no"],"text":"Fail either test and there is no {l|provision} yet."},{"nodes":["prov","inc"],"text":"Pass both: provide for direct costs such as redundancies and contract exit penalties."},{"nodes":["out"],"text":"Costs of the continuing business stay out."}],"caption":"Plan + announcement = obligation. Direct costs only.","id":"diagram-90btpy","sect":5,"part":"Recognise · special cases","svg":"\u003csvg width=\"100%\" style=\"min-width:363px\" role=\"img\"\n viewBox=\"0.00 0.00 330.00 340.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 325.98)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-325.98 315.5,-325.98 315.5,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>board\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M225.73,-311.58C225.73,-311.58 148.62,-311.58 148.62,-311.58 142.62,-311.58 136.62,-305.58 136.62,-299.58 136.62,-299.58 136.62,-287.58 136.62,-287.58 136.62,-281.58 142.62,-275.58 148.62,-275.58 148.62,-275.58 225.73,-275.58 225.73,-275.58 231.73,-275.58 237.73,-281.58 237.73,-287.58 237.73,-287.58 237.73,-299.58 237.73,-299.58 237.73,-305.58 231.73,-311.58 225.73,-311.58\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"147.43\" y=\"-294.13\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Board decision\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"150.05\" y=\"-285.03\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">alone: not enough\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>plan\u003c/title>\n\u00