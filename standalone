3,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">20X2\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"34.14\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">: 98,167 × 6% = 5,890\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"9.77\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">… ends at face 100,000 in 20X3\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>close&#45;&gt;next\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M75.02,-73C75.02,-64.29 75.02,-53.57 75.02,-43.97\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"77.12,-44.1 75.02,-38.1 72.92,-44.1 77.12,-44.1\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"105.77\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> next opening \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"visual-1dxzlb","type":"visual","bucket":"subsequent","lo":21,"title":"The bond at amortised cost, year by year","html":"\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num reveal-rows\">\u003cthead>\u003ctr>\u003cth>Year\u003c/th>\u003cth>\u003cspan class=\"el el-a\">Opening\u003c/span>\u003c/th>\u003cth>\u003cspan class=\"el el-i\">Interest income\u003c/span> (6%)\u003c/th>\u003cth>\u003cspan class=\"el el-a\">Cash received\u003c/span> (5%)\u003c/th>\u003cth>Discount unwound\u003c/th>\u003cth>\u003cspan class=\"el el-a\">Closing\u003c/span>\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\u003ctr>\u003ctd>20X1\u003c/td>\u003ctd>97,327\u003c/td>\u003ctd>5,840\u003c/td>\u003ctd>5,000\u003c/td>\u003ctd>840\u003c/td>\u003ctd>98,167\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X2\u003c/td>\u003ctd>98,167\u003c/td>\u003ctd>5,890\u003c/td>\u003ctd>5,000\u003c/td>\u003ctd>890\u003c/td>\u003ctd>99,057\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X3\u003c/td>\u003ctd>99,057\u003c/td>\u003ctd>5,943\u003c/td>\u003ctd>5,000\u003c/td>\u003ctd>943\u003c/td>\u003ctd>100,000\u003c/td>\u003c/tr>\u003c/tbody>\u003c/table>\u003c/div>\u003cp class=\"cap\">\u003cspan class=\"el el-i\">Interest\u003c/span> totals $17,673: \u003cspan class=\"el el-a\">three coupons\u003c/span> of 5,000 plus the 2,673 discount. \u003cspan class=\"el el-i\">Interest\u003c/span> rises each year because the \u003cspan class=\"el el-a\">carrying amount\u003c/span> does. The final year is rounded so the bond ends at exactly 100,000.\u003c/p>","sect":4,"part":"Subsequent measurement"},{"id":"visual-l8f4fb","type":"visual","bucket":"subsequent","lo":21,"title":"Discount and premium bonds, step by step","html":"\u003cp>Two bonds bought on the same day: same face, same 3 years, same 6% market rate. One pays a 5% coupon (bought at a discount), the other 7% (bought at a premium). Step through the years and watch both get pulled to face value.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"par-b14\" data-cfg=\"{&quot;target&quot;:{&quot;v&quot;:100000,&quot;label&quot;:&quot;face 100,000&quot;},&quot;panels&quot;:[{&quot;title&quot;:&quot;Discount bond&quot;,&quot;sub&quot;:&quot;coupon 5% · market 6%&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:97327,&quot;startCap&quot;:&quot;Paid {a|97,327}: below face, a **discount** of 2,673, because the coupon is less than the market rate.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5840,&quot;cap&quot;:&quot;20X1: {i|interest} = {a|opening 97,327} × 6% = {i|5,840}.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 comes in, so {a|closing} = {a|98,167}. Interest beat the coupon by 840: the bond **climbs**.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5890,&quot;cap&quot;:&quot;20X2: {i|interest} = {a|opening 98,167} × 6% = {i|5,890}.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 comes in, so {a|closing} = {a|99,057}. Interest beat the coupon by 890: the bond **climbs**.&quot;}]},{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5943,&quot;cap&quot;:&quot;20X3: {i|interest} = {a|opening 99,057} × 6% = {i|5,943}.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 comes in, so {a|closing} = {a|100,000}. Interest beat the coupon by 943: the bond **climbs**. It lands on face value.&quot;}]}]},{&quot;title&quot;:&quot;Premium bond&quot;,&quot;sub&quot;:&quot;coupon 7% · market 6%&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:102673,&quot;startCap&quot;:&quot;Paid {a|102,673}: above face, a **premium** of 2,673, because the coupon is more than the market rate.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:6160,&quot;cap&quot;:&quot;20X1: {i|interest} = {a|opening 102,673} × 6% = {i|6,160}.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-7000,&quot;cap&quot;:&quot;{a|Coupon cash} 7,000 comes in, so {a|closing} = {a|101,833}. The coupon beat interest by 840: the bond **falls**.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:6110,&quot;cap&quot;:&quot;20X2: {i|interest} = {a|opening 101,833} × 6% = {i|6,110}.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-7000,&quot;cap&quot;:&quot;{a|Coupon cash} 7,000 comes in, so {a|closing} = {a|100,943}. The coupon beat interest by 890: the bond **falls**.&quot;}]},{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:6057,&quot;cap&quot;:&quot;20X3: {i|interest} = {a|opening 100,943} × 6% = {i|6,057}.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-7000,&quot;cap&quot;:&quot;{a|Coupon cash} 7,000 comes in, so {a|closing} = {a|100,000}. The coupon beat interest by 943: the bond **falls**. It lands on face value.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Same face, same 3 years, same 6% market rate. Only the coupon differs. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Step 1 each year: {i|interest income} is always the **effective rate × opening carrying amount**.&quot;,&quot;Step 2: the coupon is {a|cash} received, so it comes out of the bond. What is left is next year’s {a|opening}.&quot;],&quot;end&quot;:&quot;**Mirror images.** The discount bond climbs by 840, 890, 943; the premium bond falls by the same amounts. So {i|interest income} rises for one (5,840 → 5,943) and falls for the other (6,160 → 6,057). Both end at face value.&quot;}}\">\u003c/div>","sect":4,"part":"Subsequent measurement"},{"type":"rule","bucket":"subsequent","lo":21,"title":"Expected credit losses: the second layer of amortised cost","body":["{a|Amortised cost} has two separate layers. The effective interest roll-forward gives the **{a|gross carrying amount}**. A {a|loss allowance} for credit risk then sits underneath it.","> {a|Amortised cost (balance sheet)} = {a|gross carrying amount} − {a|loss allowance}","- The {a|loss allowance} is a **contra-asset** account: it sits against the asset and reduces it, which is why it is coloured green like the asset.","1. **{i|Interest income} is still worked out on the {a|gross carrying amount}**, so the {a|allowance} never enters the interest formula.","2. A change in the {a|allowance} goes to profit or loss as an {x|impairment loss} (or a reversal), separately from {i|interest income}.","- **12-month ECL** at first; **lifetime ECL** if credit risk has risen significantly. {a|Trade receivables} can use lifetime ECL from the start (simplified approach).","- Applies to **amortised cost and FVOCI debt** only, not FVTPL or shares.","+ Exam depth: know where ECL applies and the 12-month vs lifetime idea. You won’t be asked to calculate it."],"id":"rule-j7mbg1","sect":4,"part":"Subsequent measurement"},{"type":"worked","bucket":"subsequent","lo":21,"title":"Worked: years 1 and 2 at amortised cost","q":"Bond bought on 1 Jan 20X1 for $97,327; face $100,000; coupon 5% paid each 31 Dec; effective rate 6%. Record the entries for 20X1 and 20X2.","intro":["A typical exam question: you get the price paid, the coupon and the effective rate, and must give the entries or a carrying amount. Remember two things:","- {i|Interest income} = **effective rate × {a|opening carrying amount}**.","- The coupon is just the {a|cash received}. The gap between the two is added to (discount) or taken off (premium) the {a|bond}.","Then follow the same steps every year: interest → coupon → difference → entry → closing."],"steps":[{"h":"Calculate the 20X1 interest income.","t":"{i|Interest income} = {a|opening 97,327} × 6% = **{i|5,840}**"},{"h":"Work out the coupon cash received.","t":"{a|Cash} = face 100,000 × coupon 5% = **{a|5,000}**"},{"h":"Find the difference: the discount unwound.","t":"5,840 − 5,000 = **840**, added to the {a|bond}."},{"h":"Record the 31 Dec 20X1 entry.","je":[{"side":"Dr","account":"Cash","amount":5000},{"side":"Dr","account":"Investment in bonds","amount":840},{"side":"Cr","account":"Interest income","amount":5840}]},{"h":"Roll forward to the closing carrying amount.","t":"{a|Closing 20X1} = {a|97,327} + {i|5,840} − {a|5,000} = **{a|98,167}**. This is 20X2’s opening."},{"h":"Repeat steps 1–3 for 20X2, from the new opening.","t":["{i|Interest income} = {a|98,167} × 6% = **{i|5,890}**","{a|Cash} = **{a|5,000}** (the same every year)","Discount unwound = 5,890 − 5,000 = **890**"]},{"h":"Record the 31 Dec 20X2 entry and the closing amount.","je":[{"side":"Dr","account":"Cash","amount":5000},{"side":"Dr","account":"Investment in bonds","amount":890},{"side":"Cr","account":"Interest income","amount":5890}],"after":"{a|Closing 20X2} = {a|98,167} + {i|5,890} − {a|5,000} = **{a|99,057}**. Fair value changes are ignored under amortised cost."}],"id":"worked-fu1fg1","sect":4,"part":"Subsequent measurement"},{"id":"je-dk5e6f","type":"je","bucket":"subsequent","lo":21,"q":"Your turn, with the cash line filled in. A 3-year bond at amortised cost (face $100,000, coupon 5% paid each 31 Dec, effective rate 6%) enters its final year, 20X3. Record the 20X3 interest ({a|opening carrying amount} $99,057; {i|interest income} is rounded to $5,943 so the bond ends at face value).","accounts":["Investment in bonds","Cash","Interest income","Fair value reserve (OCI)","Fair value gain (P&L)","Gain on disposal (P&L)","Loss allowance","Trade receivables","Accruals"],"given":[0],"lines":[{"side":"Dr","account":"Cash","amount":5000},{"side":"Dr","account":"Investment in bonds","amount":943},{"side":"Cr","account":"Interest income","amount":5943}],"why":"{a|99,057} + {i|5,943} − {a|5,000} = {a|100,000}. On maturity: Dr {a|Cash} 100,000, Cr {a|Investment in bonds} 100,000.","sect":4,"part":"Subsequent measurement"},{"type":"je","bucket":"subsequent","lo":21,"q":"A new bond, on your own. On 1 Jan 20X1 a company pays $213,860 for a 4-year bond, face $200,000, coupon 8% paid each 31 Dec, effective rate 6%. It is held to collect. Record the 31 Dec 20X1 entry.","accounts":["Investment in bonds","Cash","Interest income","Fair value reserve (OCI)","Fair value gain (P&L)","Gain on disposal (P&L)","Loss allowance","Trade receivables","Accruals"],"lines":[{"side":"Dr","account":"Cash","amount":16000},{"side":"Cr","account":"Interest income","amount":12832},{"side":"Cr","account":"Investment in bonds","amount":3168}],"why":"A **premium** bond (coupon 8% above the 6% market rate). {i|Interest} = 213,860 × 6% = 12,832, less than the 16,000 {a|cash}, so 3,168 of the premium is amortised and the {a|bond} falls towards 200,000.","id":"je-1phn7c","sect":4,"part":"Subsequent measurement"},{"id":"think-111w2n","type":"think","bucket":"subsequent","lo":21,"scenario":"A bond (face $100,000, coupon 5% paid each 31 Dec, effective rate 6%) is bought on 1 Jan 20X1 for $97,327. At amortised cost its 20X1 {i|interest income} would be $5,840. Now suppose it sits in a **collect and sell** portfolio (FVOCI). At 31 Dec 20X1 its fair value is $99,000; its {a|amortised cost} is $98,167.","prompt":"Should {i|interest income} change because the bond is now at fair value? Where should the gap between fair value and amortised cost go?","answer":["{i|Interest} stays at **$5,840**, exactly as under amortised cost: the bond still earns 6% on what was paid.","The {a|bond} is shown at $99,000, and the 99,000 − 98,167 = **$833** gap goes to **OCI**, because the entity may never realise it by selling."],"sect":4,"part":"Subsequent measurement"},{"type":"rule","bucket":"subsequent","lo":21,"title":"FVOCI (debt): amortised cost in P&L, fair value on the balance sheet","body":["FVOCI debt is the “collect **and** sell” model, so both numbers matter: the effective-interest income you collect and the price you could sell at. The standard keeps both by stacking **two layers**: layer 1 is the bond at {a|amortised cost} (exactly as before), and layer 2 is a {e|fair value adjustment} on top that brings it to fair value.","1. {i|Interest income} (effective interest) and {x|expected credit losses} go to **P&L**, exactly as under amortised cost.","2. The {a|asset} is carried at **fair value**.","3. The difference between {a|fair value} and {a|amortised cost} is held in the {e|Fair value reserve (OCI)}.","> {e|OCI balance} = {a|fair value} − {a|amortised cost}","+ Profit under FVOCI debt equals profit under amortised cost. Only the balance sheet (and OCI) differ: it’s amortised cost wearing a fair value jacket."],"id":"rule-a9rqve","sect":4,"part":"Subsequent measurement"},{"type":"visual","bucket":"subsequent","lo":21,"title":"FVOCI debt as two layers","html":"\u003cp>The same 5% bond (face 100,000, bought for \u003cspan class=\"el el-a\">97,327\u003c/span>, effective rate 6%) held at FVOCI, with fair values of 99,000, 99,600, 100,000 at the three year ends. \u003cstrong>Layer 1\u003c/strong> is \u003cspan class=\"el el-a\">amortised cost\u003c/span>: interest in, coupon out, exactly as before. \u003cstrong>Layer 2\u003c/strong> is the \u003cspan class=\"el el-e\">fair value adjustment\u003c/span>: whatever it takes to reach fair value, parked in OCI. P&amp;L only sees layer 1.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"fvoci-layers-b14\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;Layer 1: amortised cost&quot;,&quot;sub&quot;:&quot;drives P&amp;L&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Amortised cost&quot;,&quot;start&quot;:97327,&quot;startCap&quot;:&quot;Bought for {a|97,327}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;hold&quot;:&quot;No fair value step here: P&amp;L only ever sees the {a|amortised cost} layer, {a|98,167}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5840,&quot;cap&quot;:&quot;{i|Interest} = {a|amortised cost 97,327} × 6% = {i|5,840}. Same in both panels.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 received. {a|Amortised cost} is now {a|98,167}.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;hold&quot;:&quot;No fair value step here: P&amp;L only ever sees the {a|amortised cost} layer, {a|99,057}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5890,&quot;cap&quot;:&quot;{i|Interest} = {a|amortised cost 98,167} × 6% = {i|5,890}. Same in both panels.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 received. {a|Amortised cost} is now {a|99,057}.&quot;}]},{&quot;label&quot;:&quot;20X3&quot;,&quot;hold&quot;:&quot;No fair value step here: P&amp;L only ever sees the {a|amortised cost} layer, {a|100,000}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5943,&quot;cap&quot;:&quot;{i|Interest} = {a|amortised cost 99,057} × 6% = {i|5,943}. Same in both panels.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 received. {a|Amortised cost} is now {a|100,000}.&quot;}]}]},{&quot;title&quot;:&quot;Layer 1 + layer 2 = fair value&quot;,&quot;sub&quot;:&quot;what the balance sheet shows&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:97327,&quot;startCap&quot;:&quot;Day 1: fair value = cost = {a|97,327}, so layer 2 is nil.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;hold&quot;:&quot;No fair value step here: P&amp;L only ever sees the {a|amortised cost} layer, {a|98,167}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5840,&quot;cap&quot;:&quot;{i|Interest} = {a|amortised cost 97,327} × 6% = {i|5,840}. Same in both panels.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 received. {a|Amortised cost} is now {a|98,167}.&quot;},{&quot;name&quot;:&quot;fair value adjustment&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:833,&quot;cap&quot;:&quot;Fair value is 99,000, so the layer on top = 99,000 − 98,167 = {e|833} in the {e|fair value reserve} (through OCI).&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;hold&quot;:&quot;No fair value step here: P&amp;L only ever sees the {a|amortised cost} layer, {a|99,057}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5890,&quot;cap&quot;:&quot;{i|Interest} = {a|amortised cost 98,167} × 6% = {i|5,890}. Same in both panels.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 received. {a|Amortised cost} is now {a|99,057}.&quot;},{&quot;name&quot;:&quot;fair value adjustment&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:-290,&quot;cap&quot;:&quot;Fair value is 99,600, so the layer on top = 99,600 − 99,057 = {e|543} in the {e|fair value reserve} (it moves by (290) through OCI).&quot;}]},{&quot;label&quot;:&quot;20X3&quot;,&quot;hold&quot;:&quot;No fair value step here: P&amp;L only ever sees the {a|amortised cost} layer, {a|100,000}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;interest&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:5943,&quot;cap&quot;:&quot;{i|Interest} = {a|amortised cost 99,057} × 6% = {i|5,943}. Same in both panels.&quot;},{&quot;name&quot;:&quot;coupon&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:-5000,&quot;cap&quot;:&quot;{a|Coupon cash} 5,000 received. {a|Amortised cost} is now {a|100,000}.&quot;},{&quot;name&quot;:&quot;fair value adjustment&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:-543,&quot;cap&quot;:&quot;Fair value is 100,000, so the layer on top = 100,000 − 100,000 = {e|0} in the {e|fair value reserve} (it moves by (543) through OCI).&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Same bond, two layers. Watch the left panel: it is exactly amortised cost. The right panel adds one extra step each year.&quot;,&quot;parts&quot;:[&quot;Layer 1, step 1: {i|interest income} at the effective rate goes to P&amp;L in both views.&quot;,&quot;Layer 1, step 2: the coupon is {a|cash} received.&quot;,&quot;Layer 2: top up (or down) to fair value. The adjustment goes to OCI, never P&amp;L.&quot;],&quot;end&quot;:&quot;**Two layers.** P&amp;L only ever sees layer 1, so profit is the same as amortised cost. Layer 2 (833 → 543 → 0) lives in the {e|fair value reserve} and shrinks to nil at maturity, when fair value = face.&quot;}}\">\u003c/div>","id":"visual-g4we98","sect":4,"part":"Subsequent measurement"},{"type":"visual","bucket":"subsequent","lo":21,"title":"Keep two numbers: amortised cost and fair value","html":"\u003cp>An FVOCI bond makes you carry \u003cstrong>two numbers side by side, every year\u003c/strong>. Lose track of either one and the interest, the OCI and the gain on sale all come out wrong.\u003c/p>\n    \u003col class=\"body\">\n      \u003cli>\u003cstrong>\u003cspan class=\"el el-a\">Amortised cost\u003c/span>: you calculate it.\u003c/strong> \u003cspan class=\"el el-a\">Opening amortised cost\u003c/span> + \u003cspan class=\"el el-i\">interest\u003c/span> (effective rate × \u003cspan class=\"el el-a\">opening amortised cost\u003c/span>) − \u003cspan class=\"el el-a\">coupon cash\u003c/span> = \u003cspan class=\"el el-a\">closing amortised cost\u003c/span>. This roll-forward never looks at fair value.\u003c/li>\n      \u003cli>\u003cstrong>\u003cspan class=\"el el-a\">Fair value\u003c/span>: you look it up.\u003c/strong> It's the market price on the date. It isn't rolled forward by any formula.\u003c/li>\n      \u003cli>\u003cstrong>\u003cspan class=\"el el-e\">OCI balance\u003c/span> = \u003cspan class=\"el el-a\">fair value\u003c/span> − \u003cspan class=\"el el-a\">amortised cost\u003c/span>.\u003c/strong> Work it out fresh at each year end, then post the \u003cem>movement\u003c/em>.\u003c/li>\n    \u003c/ol>\n    \u003cp>The 5% bond again (face 100,000, bought 1 Jan 20X1 for \u003cspan class=\"el el-a\">97,327\u003c/span>, effective rate 6%, coupon \u003cspan class=\"el el-a\">5,000\u003c/span> each 31 Dec), held at FVOCI:\u003c/p>\n    \u003cp>\u003cstrong>Number 1, calculated:\u003c/strong> the \u003cspan class=\"el el-a\">amortised cost\u003c/span> roll-forward.\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num reveal-rows\">\u003cthead>\u003ctr>\u003cth>Year\u003c/th>\u003cth>\u003cspan class=\"el el-a\">Opening AC\u003c/span>\u003c/th>\u003cth>+ \u003cspan class=\"el el-i\">Interest\u003c/span> 6%\u003c/th>\u003cth>− \u003cspan class=\"el el-a\">Coupon\u003c/span>\u003c/th>\u003cth>= \u003cspan class=\"el el-a\">Closing AC\u003c/span>\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>20X1\u003c/td>\u003ctd>97,327\u003c/td>\u003ctd>5,840\u003c/td>\u003ctd>(5,000)\u003c/td>\u003ctd>\u003cb>98,167\u003c/b>\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X2\u003c/td>\u003ctd>98,167\u003c/td>\u003ctd>5,890\u003c/td>\u003ctd>(5,000)\u003c/td>\u003ctd>\u003cb>99,057\u003c/b>\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X3\u003c/td>\u003ctd>99,057\u003c/td>\u003ctd>5,943\u003c/td>\u003ctd>(5,000)\u003c/td>\u003ctd>\u003cb>100,000\u003c/b>\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp>\u003cstrong>Number 2, looked up:\u003c/strong> \u003cspan class=\"el el-a\">fair value\u003c/span>. Set it against number 1 to get the \u003cspan class=\"el el-e\">OCI balance\u003c/span>.\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num reveal-rows\">\u003cthead>\u003ctr>\u003cth>31 Dec\u003c/th>\u003cth>\u003cspan class=\"el el-a\">AC\u003c/span>\u003c/th>\u003cth>\u003cspan class=\"el el-a\">Fair value\u003c/span>\u003c/th>\u003cth>\u003cspan class=\"el el-e\">OCI bal.\u003c/span>\u003c/th>\u003cth>\u003cspan class=\"el el-e\">OCI move\u003c/span>\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>20X1\u003c/td>\u003ctd>98,167\u003c/td>\u003ctd>\u003cb>99,000\u003c/b>\u003c/td>\u003ctd>833\u003c/td>\u003ctd>833\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X2\u003c/td>\u003ctd>99,057\u003c/td>\u003ctd>\u003cb>99,600\u003c/b>\u003c/td>\u003ctd>543\u003c/td>\u003ctd>(290)\u003c/td>\u003c/tr>\u003ctr>\u003ctd>20X3\u003c/td>\u003ctd>100,000\u003c/td>\u003ctd>\u003cb>100,000\u003c/b>\u003c/td>\u003ctd>0\u003c/td>\u003ctd>(543)\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">Each year's \u003cspan class=\"el el-a\">opening AC\u003c/span> is last year's \u003cspan class=\"el el-a\">closing AC\u003c/span>, \u003cstrong>not\u003c/strong> last year's fair value. Fair value never feeds back into the first table.\u003c/p>\n    \u003cp class=\"trap\">Starting 20X2 from the 20X1 fair value: 6% × 99,000 = 5,940, instead of 6% × 98,167 = \u003cspan class=\"el el-i\">5,890\u003c/span>. That sneaks part of the 833 fair value gain into P&amp;L early, and on sale the reserve gets recycled on top, so the gain is counted twice.\u003c/p>\n    \u003cp>\u003cstrong>Where amortised cost lives.\u003c/strong> It has no balance-sheet line of its own. Keep the effective-interest schedule above as a working (in practice the treasury system does this), or split the ledger into \u003cspan class=\"el el-a\">Bond – amortised cost\u003c/span> and \u003cspan class=\"el el-a\">Bond – fair value adjustment\u003c/span>. You can always get it back: \u003cspan class=\"el el-a\">amortised cost\u003c/span> = \u003cspan class=\"el el-a\">carrying amount\u003c/span> − \u003cspan class=\"el el-e\">OCI balance\u003c/span>.\u003c/p>\n    \u003cp class=\"key\">On sale: P&amp;L \u003cspan class=\"el el-i\">gain\u003c/span> = \u003cspan class=\"el el-a\">proceeds\u003c/span> − \u003cspan class=\"el el-a\">amortised cost\u003c/span>. Remeasure to the sale price (the \u003cspan class=\"el el-e\">OCI balance\u003c/span> moves to proceeds − AC), then recycle that whole balance.\u003c/p>","id":"visual-qnhtfk","sect":4,"part":"Subsequent measurement"},{"id":"je-154c1c","type":"je","bucket":"subsequent","lo":21,"q":"A bond (face $100,000, coupon 5%, effective rate 6%) was bought on 1 Jan 20X1 for {a|$97,327} and classified at FVOCI. At 31 Dec 20X1: {a|coupon cash} $5,000 received, {i|interest income} $5,840 (so {a|amortised cost} is now $98,167), fair value $99,000. Record the 31 Dec 20X1 entry as one entry.","accounts":["Investment in bonds","Cash","Interest income","Fair value reserve (OCI)","Fair value gain (P&L)","Gain on disposal (P&L)","Loss allowance","Trade receivables","Accruals"],"lines":[{"side":"Dr","account":"Cash","amount":5000},{"side":"Dr","account":"Investment in bonds","amount":1673},{"side":"Cr","account":"Interest income","amount":5840},{"side":"Cr","account":"Fair value reserve (OCI)","amount":833}],"alt":"Two entries are equally right: the amortised cost entry (Dr {a|Cash} 5,000, Dr {a|Investment} 840, Cr {i|Interest} 5,840), then Dr {a|Investment} 833, Cr {e|Fair value reserve} 833.","why":"The {a|bond} moves from 97,327 to 99,000 (+1,673): 840 is discount unwound (in {i|interest}), 833 is the fair value gain above amortised cost (in OCI). Why no separate \"OCI gain\" account? The 833 is shown as a gain in this year's OCI (statement of comprehensive income) and piles up in equity as the {e|Fair value reserve}. One line, Cr {e|Fair value reserve (OCI)}, does both. A fall is the mirror, Dr {e|Fair value reserve (OCI)} (an OCI loss). On sale the reserve is recycled: Dr {e|Fair value reserve}, Cr {i|gain in P&L}.","sect":4,"part":"Subsequent measurement"},{"type":"rule","bucket":"subsequent","lo":21,"title":"FVTPL, and FVOCI for equity","body":["1. **FVTPL:** remeasure to fair value at each reporting date. **All** changes, {i|interest} and {i|dividends} go to **P&L**.","2. **FVOCI (equity, elected):** remeasure to fair value; changes go to {e|Fair value reserve (OCI)}. {i|Dividend income} goes to **P&L**.","- Notes example (FVTPL): the 10,000 shares rise from $2.00 to $2.30: Dr {a|Investment in shares} 3,000, Cr {i|Fair value gain (P&L)} 3,000.","- **Impairment (ECL)** applies to amortised cost and FVOCI **debt** only, not to FVTPL or equity: fair value already reflects it.","! An FVTPL gain never goes to OCI. OCI is only for FVOCI assets."],"id":"rule-1qprbo","sect":4,"part":"Subsequent measurement"},{"id":"je-1j13c1","type":"je","bucket":"subsequent","lo":21,"q":"A company bought 10,000 shares at $2.00 on 1 Jan 20X1 (FVTPL) and remeasured them to $2.30 at 31 Dec 20X1. In 20X2 it sold 4,000 of them, so 6,000 shares are still held, carried at $2.30 each. At 31 Dec 20X2 the price is $1.90. Record the 31 Dec 20X2 entry.","accounts":["Investment in shares","Cash","Transaction costs expense","Fair value gain (P&L)","Fair value loss (P&L)","Fair value reserve (OCI)","Dividend income","Retained earnings","Accruals"],"lines":[{"side":"Dr","account":"Fair value loss (P&L)","amount":2400},{"side":"Cr","account":"Investment in shares","amount":2400}],"why":"6,000 × (2.30 − 1.90) = {x|2,400}, measured from the last fair value, on the shares still held, to P&L.","sect":4,"part":"Subsequent measurement"},{"type":"mcq","bucket":"subsequent","lo":21,"q":"A company elected FVOCI for a strategic shareholding. During the year the share price falls and the investee pays a cash dividend. Where do these go?","options":[{"t":"Both to profit or loss","why":"That is FVTPL. The election moves fair value changes to OCI."},{"t":"Fair value loss to OCI; dividend to profit or loss","ok":true,"why":"Under the equity election, fair value changes go to OCI but {i|dividends} are still income in P&L."},{"t":"Both to OCI","why":"Dividends on FVOCI equity go to profit or loss (unless they are clearly a return of the cost of the investment)."},{"t":"Fair value loss to P&L as an impairment; dividend to OCI","why":"Equity at FVOCI has no impairment test, and dividends go to P&L."}],"id":"mcq-1iumgl","sect":4,"part":"Subsequent measurement"},{"type":"diagram","bucket":"subsequent","lo":21,"title":"Same bond, three categories: where each amount goes","intro":"A 5% bond (face $100,000, effective rate 6%) bought on 1 Jan 20X1: cost $97,327, fair value $99,000 at 31 Dec 20X1. The bottom row then sells it on 1 Jan 20X2 for $99,500. Blue cells go to P&L, purple to OCI, grey nowhere.","notes":{"bond":"One bond, one set of cash flows. Only the category differs, and with it where the amounts land. Fair value rises by 1,673 in 20X1 (97,327 → 99,000).","ac":"{i|Interest} 5,840 (effective rate) to P&L; the {a|asset} is at {a|amortised cost} 98,167; fair value is ignored. Sold for {a|99,500}: {i|gain on sale} = 99,500 − 98,167 (the {a|amortised cost}) = 1,333, in P&L.","fvoci":"Same {i|interest} 5,840 in P&L. The {a|asset} goes to fair value 99,000, and the extra 99,000 − 98,167 = 833 sits in the {e|Fair value reserve (OCI)}. Sold for {a|99,500}: 99,500 − 99,000 = 500 is new gain, and the 833 parked in the reserve is **recycled** (Dr {e|Fair value reserve}, Cr P&L). {i|Gain in P&L} = 500 + 833 = 1,333, the same as amortised cost. OCI shows −833 that year, so it isn't counted twice.","fvtpl":"Everything to P&L: {i|coupon} 5,000 + whole {i|fair value change} 1,673 = 6,673. Sold for {a|99,500}: {i|gain on sale} = 99,500 − 99,000 (the {a|last fair value}) = 500. The rest of the rise was already in P&L in 20X1."},"walk":[{"nodes":["bond"],"text":"Same bond, three possible categories. Watch where the interest, the fair value change and a later sale gain go."},{"nodes":["ac"],"text":"**Amortised cost:** {i|interest} $5,840 in P&L; fair value changes ignored. Profit $5,840."},{"nodes":["fvoci"],"text":"**FVOCI:** same $5,840 {i|interest} in P&L, plus $833 in OCI so the {a|asset} shows fair value. Profit $5,840, TCI $6,673."},{"nodes":["fvtpl"],"text":"**FVTPL:** {i|coupon} $5,000 + the whole {i|$1,673 rise}, all in P&L. Profit $6,673."},{"nodes":["ac","fvoci"],"text":"**Profit:** amortised cost = FVOCI. The interest line is identical."},{"nodes":["fvoci","fvtpl"],"text":"**Total comprehensive income and the asset:** FVOCI = FVTPL ($6,673; {a|asset} $99,000). Only the P&L/OCI split differs."},{"nodes":["ac","fvoci","fvtpl"],"text":"**Now sell it for $99,500 on 1 Jan 20X2.** The {i|gain on sale} is always proceeds − carrying amount, but the carrying amount differs. **Amortised cost:** 99,500 − 98,167 = {i|$1,333}. **FVTPL:** 99,500 − 99,000 = {i|$500}. **FVOCI:** {i|$500} + the {e|$833 reserve} recycled = {i|$1,333}."},{"nodes":["ac","fvoci","fvtpl"],"text":"**Over the whole life, all three give the same profit: 7,173.** Amortised cost and FVOCI: 5,840 + 1,333. FVTPL: 6,673 + 500. That is just the cash: {a|coupon} 5,000 + {a|proceeds} 99,500 − {a|cost} 97,327. The category only moves profit **between years**, and between P&L and OCI."}],"id":"diagram-1u6pyq","sect":4,"part":"Subsequent measurement","svg":"\u003csvg width=\"100%\" style=\"min-width:573px\" role=\"img\"\n viewBox=\"0.00 0.00 521.00 198.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 183.15)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-183.15 506.65,-183.15 506.65,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>bond\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M290.76,-168.75C290.76,-168.75 201.49,-168.75 201.49,-168.75 195.49,-168.75 189.49,-162.75 189.49,-156.75 189.49,-156.75 189.49,-144.75 189.49,-144.75 189.49,-138.75 195.49,-132.75 201.49,-132.75 201.49,-132.75 290.76,-132.75 290.76,-132.75 296.76,-132.75 302.76,-138.75 302.76,-144.75 302.76,-144.75 302.76,-156.75 302.76,-156.75 302.76,-162.75 296.76,-168.75 290.76,-168.75\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"216.5\" y=\"-151.3\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Same bond