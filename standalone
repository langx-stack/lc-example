=\"#be123c\" stroke-width=\"1.2\" d=\"M442.78,-100.64C442.78,-100.64 346,-100.64 346,-100.64 340,-100.64 334,-94.64 334,-88.64 334,-88.64 334,-75 334,-75 334,-69 340,-63 346,-63 346,-63 442.78,-63 442.78,-63 448.78,-63 454.78,-69 454.78,-75 454.78,-75 454.78,-88.64 454.78,-88.64 454.78,-94.64 448.78,-100.64 442.78,-100.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"362.51\" y=\"-86.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Before 20X4\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"342.64\" y=\"-77.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">restate opening balances\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"366.26\" y=\"-68.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">at 1 Jan 20X4\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>q&#45;&gt;early\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M274.64,-137.44C296.5,-127.47 324.09,-114.88 347.28,-104.31\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"348.05,-106.27 352.63,-101.87 346.3,-102.45 348.05,-106.27\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"340.97\" y=\"-115.39\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> earlier \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>tax\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M288.78,-36C288.78,-36 192,-36 192,-36 186,-36 180,-30 180,-24 180,-24 180,-12 180,-12 180,-6 186,0 192,0 192,0 288.78,0 288.78,0 294.78,0 300.78,-6 300.78,-12 300.78,-12 300.78,-24 300.78,-24 300.78,-30 294.78,-36 288.78,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"195.76\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Always net of tax\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"188.64\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">never through 20X5 profit\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>cmp&#45;&gt;tax\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M237.57,-62.61C237.95,-56.67 238.39,-49.97 238.8,-43.64\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"240.87,-44.08 239.16,-37.96 236.68,-43.81 240.87,-44.08\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>sfp\u003c/title>\n\u003cpath fill=\"#f3eeff\" stroke=\"#6d28d9\" stroke-width=\"1.2\" d=\"M453.28,-36C453.28,-36 335.5,-36 335.5,-36 329.5,-36 323.5,-30 323.5,-24 323.5,-24 323.5,-12 323.5,-12 323.5,-6 329.5,0 335.5,0 335.5,0 453.28,0 453.28,0 459.28,0 465.28,-6 465.28,-12 465.28,-12 465.28,-24 465.28,-24 465.28,-30 459.28,-36 453.28,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"332.14\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Third SFP at 1 Jan 20X4\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"353.89\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">if materially affected\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>early&#45;&gt;sfp\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M394.39,-62.61C394.39,-56.67 394.39,-49.97 394.39,-43.64\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"396.49,-43.96 394.39,-37.96 392.29,-43.96 396.49,-43.96\"/>\n\u003c/g>\n\n\u003cg id=\"edge7\" class=\"edge\">\n\u003ctitle>early&#45;&gt;tax\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M348.6,-62.44C330.44,-55.15 309.49,-46.74 290.89,-39.27\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"291.91,-37.42 285.56,-37.13 290.34,-41.32 291.91,-37.42\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"think-uf3i79","type":"think","bucket":"error","lo":50,"scenario":"In 20X5 a company discovers that a $80,000 {x|repair} on 1 Jan 20X3 was capitalised as {a|equipment} and depreciated straight-line over 4 years. It should have been expensed. The 20X5 statements show 20X4 comparatives. Tax 17%.","prompt":"This error started before 20X4. What happens to the balances at 1 Jan 20X4?","answer":["In 20X3, profit was overstated: the {x|repair} (80,000) should have been expensed, but only 20,000 of {x|depreciation} was charged. Overstatement 60,000 before tax.","So {e|retained earnings} at 1 Jan 20X4, the start of the earliest period presented, is restated down by 60,000 − 10,200 tax = **49,800**.","Because the opening balances of 20X4 change, and the amount is material, a **third statement of financial position** at 1 Jan 20X4 is presented."],"sect":4,"part":"Prior period error: restate"},{"type":"visual","bucket":"error","lo":50,"title":"The repair error, step by step","html":"\u003cp>Two layers of the same mistake: on the left what sits wrongly in \u003cspan class=\"el el-a\">equipment\u003c/span> (before tax), on the right what sits wrongly in \u003cspan class=\"el el-e\">retained earnings\u003c/span> (after tax). The gap between them is the \u003cspan class=\"el el-l\">tax effect\u003c/span>.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"err-e1\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;Equipment overstated&quot;,&quot;sub&quot;:&quot;before tax&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Equipment overstated&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;1 Jan 20X3: nothing wrong yet.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;capitalised&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:80000,&quot;cap&quot;:&quot;The {x|repair} of 80,000 lands in {a|equipment} instead of the {x|P&amp;L}.&quot;},{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-20000,&quot;cap&quot;:&quot;{x|Depreciation} 80,000 ÷ 4 = {x|20,000} chips away at it: {a|60,000} overstated at 31 Dec 20X3.&quot;}]},{&quot;label&quot;:&quot;20X4&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-20000,&quot;cap&quot;:&quot;Another {x|20,000}: {a|40,000} overstated at 31 Dec 20X4.&quot;}]}]},{&quot;title&quot;:&quot;Retained earnings overstated&quot;,&quot;sub&quot;:&quot;after 17% tax&quot;,&quot;el&quot;:&quot;e&quot;,&quot;bal&quot;:&quot;Retained earnings overstated&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;Same story, after tax.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;capitalised&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:66400,&quot;cap&quot;:&quot;Profit too high by the {x|repair} net of tax: 80,000 × 83% = {e|66,400}.&quot;},{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:-16600,&quot;cap&quot;:&quot;Less the {x|depreciation} that was charged, net: {e|16,600}. So {e|opening 20X4 retained earnings} are {e|49,800} too high.&quot;}]},{&quot;label&quot;:&quot;20X4&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:-16600,&quot;cap&quot;:&quot;20X4 profit was **understated** by {e|16,600}, so the overstatement shrinks to {e|33,200}.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;A 80,000 {x|repair} on 1 Jan 20X3 was capitalised and depreciated over 4 years instead of expensed. Watch what it does to the books. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;The wrong {a|asset} appears, and both balances jump.&quot;,&quot;Each year’s {x|depreciation} on it unwinds part of the error.&quot;],&quot;end&quot;:&quot;**Errors unwind themselves, slowly.** At 31 Dec 20X4 {a|equipment} is 40,000 too high and {e|retained earnings} 33,200 too high. The gap, 6,800, is the {l|tax effect} (17% × 40,000). That is exactly what the correction reverses: {e|retained earnings} 33,200, {l|deferred tax} 6,800, {a|equipment} 40,000.&quot;}}\">\u003c/div>","id":"visual-6eiiio","sect":4,"part":"Prior period error: restate"},{"id":"calc-r8uejf","type":"calc","bucket":"error","lo":50,"q":"In 20X5 a company finds that a $80,000 {x|repair} made on 1 Jan 20X3 was capitalised as {a|equipment} and depreciated straight-line over 4 years (no residual), instead of being expensed. The 20X5 statements show 20X4 comparatives; tax 17%. In the restated 20X4 comparatives, by how much does profit after tax change? (Enter an increase as a positive number.)","answer":16600,"unit":"$","working":["In 20X4 the company charged 20,000 of {x|depreciation} on an “{a|asset}” that shouldn’t exist. Removing it **increases** 20X4 profit before tax by 20,000.","After tax at 17%: 20,000 − 3,400 = **16,600** increase.","Errors can push profit either way in different years. Here 20X3 was overstated, and 20X4 understated."],"sect":4,"part":"Prior period error: restate"},{"id":"tree-1jsssv","type":"tree","bucket":"error","lo":50,"title":"Which is it? A double-posted invoice","scenario":"Seletar Supplies’ year ends 31 Dec 20X5. On 12 Jan 20X6, before the 20X5 statements are authorised, it finds that a $24,000 {i|sales} invoice from November 20X5 was posted twice. Tap your way to the answer.","expect":"cur","start":"n1","nodes":{"n1":{"q":"Is it fixing a mistake: reliable information was available but was ignored or misused?","why":"Errors are the only change that is about getting it *wrong*. New information or a new choice is never an error.","opts":[{"t":"Yes, it is a mistake","to":"n1b"},{"t":"No: new information, or a new choice of method","to":"n2"}]},"n1b":{"q":"Which period’s statements contain the mistake?","why":"Only errors in statements already issued are prior period errors. A mistake caught before this year’s statements are authorised is simply corrected.","opts":[{"t":"A prior period whose statements have been issued","to":"err"},{"t":"This period, and the statements are not yet authorised","to":"cur"}]},"n2":{"q":"Does it change the principle, basis or rule (recognition, measurement basis, presentation, cost formula)? Or only an input or technique for an uncertain amount?","why":"A policy is the *rule*; an estimate is a *number* the rule needs. Useful life, residual value, depreciation method and bad debt rates are all inputs or techniques.","opts":[{"t":"The principle, basis or rule changes","to":"n3"},{"t":"Only an input or technique (life, residual, depreciation method, bad debt %)","to":"est"},{"t":"I honestly can’t tell","to":"est"}]},"n3":{"q":"Is the policy for transactions that are new, different in substance from before, or were immaterial before?","why":"Adopting a policy for something you never had to account for is not a *change*: there is nothing to restate.","opts":[{"t":"Yes","to":"notpol"},{"t":"No, the same transactions as before","to":"n4"}]},"n4":{"q":"Is it the first adoption of the revaluation model for {a|PPE} or {a|intangibles}?","why":"This is the one policy change with its own treatment: it is accounted for as a revaluation, not restated.","opts":[{"t":"Yes","to":"reval"},{"t":"No","to":"n5"}]},"n5":{"q":"Is the change required by an SFRS(I), or does it give reliable and more relevant information?","why":"Those are the only two allowed reasons. Consistency matters, so policies don’t change on a whim.","opts":[{"t":"Yes","to":"pol"},{"t":"No: it just gives a nicer profit, or the CFO prefers it","to":"bad"}]},"err":{"result":"Prior period error: retrospective restatement","body":["Restate the comparatives for the period(s) the error happened in. If it began before the earliest period presented, restate the **opening** balances of that earliest period.","- Net of tax. Never through this year’s profit."]},"cur":{"result":"Current-period error: just correct it","body":["Found before the statements are authorised, in the period it happened: correct it in this year’s statements. It is **not** a prior period error, so nothing is restated."]},"est":{"result":"Change in accounting estimate: prospective","body":["Recognise the effect in **profit or loss** of the period of change and future periods. No restatement, no {e|opening retained earnings} adjustment.","- If you can’t tell policy from estimate, the standard says treat it as an **estimate**."]},"notpol":{"result":"Not a change in accounting policy","body":["A policy for transactions that differ in substance from before, are new, or were immaterial before is simply **adopted** going forward. Nothing to restate."]},"reval":{"result":"Policy change, but treated as a revaluation","body":["Switching to the revaluation model for {a|PPE} or {a|intangibles} **is** a change in policy, but it is accounted for as a revaluation under SFRS(I) 1-16 / 1-38 from now on, **not** retrospectively under 1-8."]},"pol":{"result":"Change in accounting policy: retrospective application","body":["Use the standard’s transitional provisions if it has any. Otherwise apply it as if it had **always** applied:","1. adjust the {e|opening balance} of each affected {e|component of equity} for the **earliest prior period presented**","2. restate the comparatives"]},"bad":{"result":"Not allowed: keep the old policy","body":["A policy may change only if a standard requires it or it gives **reliable and more relevant** information. “Higher profit” and “management prefers it” fail both tests."]}},"sect":4,"part":"Prior period error: restate","svg":"\u003csvg width=\"100%\" style=\"min-width:640px\" role=\"img\"\n viewBox=\"0.00 0.00 638.00 707.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 695.89)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-695.89 627.46,-695.89 627