96.53,-102.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"136.51\" y=\"-88.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">2. Licence\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"141.39\" y=\"-77.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">− 30,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"125.64\" y=\"-68.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">200,000 / 800,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>rest&#45;&gt;lic\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M120.2,-129.14C126.29,-122.66 133.3,-115.19 139.86,-108.21\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"141.15,-109.9 143.73,-104.09 138.09,-107.03 141.15,-109.9\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>floor\u003c/title>\n\u003cpath fill=\"#f3eeff\" stroke=\"#6d28d9\" stroke-width=\"1.2\" d=\"M187.03,-36C187.03,-36 20.5,-36 20.5,-36 14.5,-36 8.5,-30 8.5,-24 8.5,-24 8.5,-12 8.5,-12 8.5,-6 14.5,0 20.5,0 20.5,0 187.03,0 187.03,0 193.03,0 199.03,-6 199.03,-12 199.03,-12 199.03,-24 199.03,-24 199.03,-30 193.03,-36 187.03,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"17.14\" y=\"-19.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Floor\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"44.89\" y=\"-19.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">: no asset below the highest of\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"31.39\" y=\"-8.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">its FVLCOD, its VIU, and zero\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>ppe&#45;&gt;floor\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M63.48,-62.63C69.64,-55.96 76.6,-48.42 82.99,-41.5\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"84.18,-43.31 86.71,-37.48 81.09,-40.46 84.18,-43.31\"/>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>lic&#45;&gt;floor\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M144.74,-62.63C138.48,-55.96 131.39,-48.42 124.9,-41.5\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"126.75,-40.4 121.11,-37.47 123.69,-43.28 126.75,-40.4\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"subsequent","lo":39,"title":"Changi Café: who takes the hit","html":"\u003cp>Each of the café’s assets as a bar, to scale. The solid part is what it is carried at after the impairment; the hatched part is its share of the \u003cspan class=\"el el-x\">240,000 loss\u003c/span>. \u003cspan class=\"el el-a\">Goodwill\u003c/span> goes first and is wiped out completely; the remaining 120,000 is shared by size, so \u003cspan class=\"el el-a\">PPE\u003c/span> (three times the \u003cspan class=\"el el-a\">licence\u003c/span>) takes three times the cut.\u003c/p>\u003cdiv class=\"cbars\">\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">\u003cspan class=\"el el-a\">Goodwill\u003c/span> 120,000: − 120,000 → \u003cspan class=\"el el-a\">0\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg a\" style=\"width:0.00%\">\u003c/i>\u003ci class=\"seg out-x\" style=\"width:13.04%\">\u003c/i>\u003c/div>\u003c/div>\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">\u003cspan class=\"el el-a\">PPE\u003c/span> 600,000: − 90,000 → \u003cspan class=\"el el-a\">510,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg a\" style=\"width:55.43%\">\u003c/i>\u003ci class=\"seg out-x\" style=\"width:9.78%\">\u003c/i>\u003c/div>\u003c/div>\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">\u003cspan class=\"el el-a\">Licence\u003c/span> 200,000: − 30,000 → \u003cspan class=\"el el-a\">170,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg a\" style=\"width:18.48%\">\u003c/i>\u003ci class=\"seg out-x\" style=\"width:3.26%\">\u003c/i>\u003c/div>\u003c/div>\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Whole CGU 920,000: − 240,000 → recoverable \u003cspan class=\"el el-a\">680,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003ci class=\"seg a\" style=\"width:73.91%\">\u003c/i>\u003ci class=\"seg out-x\" style=\"width:26.09%\">\u003c/i>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003ci class=\"seg a\">\u003c/i>\u003cspan class=\"el el-a\">carried after impairment\u003c/span>\u003c/span>\u003cspan>\u003ci class=\"seg out-x\">\u003c/i>\u003cspan class=\"el el-x\">share of the loss\u003c/span>\u003c/span>\u003c/div>\u003c/div>","id":"visual-140r8w","sect":4,"part":"Subsequent measurement"},{"id":"calc-1x0c1a","type":"calc","bucket":"subsequent","lo":39,"q":"Changi Café is a CGU holding {a|goodwill} $120,000, {a|PPE} $600,000 and a {a|food licence} $200,000. Its recoverable amount is $680,000, so the CGU has an {x|impairment loss} of $240,000. No asset hits its floor. How much of the loss is allocated to the {a|PPE}?","answer":90000,"unit":"$","working":["{a|Goodwill} first: 120,000. Remaining 240,000 − 120,000 = 120,000.","{a|PPE} share = 120,000 × 600,000 ÷ (600,000 + 200,000) = **$90,000**.","Spreading over all assets including {a|goodwill} would give 156,522: wrong order."],"sect":4,"part":"Subsequent measurement"},{"id":"mcq-116vm5","type":"mcq","bucket":"subsequent","lo":39,"q":"A CGU with no {a|goodwill} has an {x|impairment loss} of $100,000. It holds a {a|building} ({a|carrying amount} $500,000, FVLCOD $480,000) and {a|equipment} ({a|carrying amount} $500,000, no separate recoverable amount). How much of the loss is allocated to the building?","options":[{"t":"$50,000","why":"Pro rata would give 50,000, but that would take the building to 450,000, below its FVLCOD of 480,000."},{"t":"$20,000","ok":true,"why":"The floor: the building can’t go below 480,000, so it takes only 20,000. The other 30,000 moves to the equipment, which takes 80,000 in total."},{"t":"Nil: buildings are never impaired within a CGU","why":"Every asset in the CGU shares the loss, subject to the floor."},{"t":"$100,000","why":"The loss is shared across the CGU’s assets, not dumped on one."}],"sect":4,"part":"Subsequent measurement"},{"type":"compare","bucket":"subsequent","preamble":"Three write-down regimes side by side: impairment for PPE, NRV for inventory, expected credit losses for financial assets.","lo":39,"special":"The {x|loss} goes to **P&L**, except for a **revalued** asset, where it uses up that asset’s {e|surplus} in OCI first. In a CGU, **{a|goodwill}** absorbs it first. Then depreciate the {a|new carrying amount}.","id":"compare-1kumyt-3","sect":4,"part":"Subsequent measurement"},{"type":"map","id":"map-5-derecognise","bucket":"derecognise","sect":5,"part":"Derecognise / transfer"},{"id":"think-1wm1li","type":"think","bucket":"derecognise","lo":39,"scenario":"Tanjong Printing bought a {a|press} on 1 Jan 20X1 for $1,200,000 (10-year life, no residual value, straight-line, cost model). At 31 Dec 20X3 it was impaired down to $730,263 and then depreciated at $104,323 a year. Two years later, at 31 Dec 20X5, a wave of retro print magazines revives demand. The press’s recoverable amount is now $650,000. Its {a|carrying amount} is $521,617 (730,263 less two years at 104,323).","prompt":"Can Tanjong write the press back up to $650,000? Or is there a ceiling?","answer":["It can **reverse** the impairment, because the indicators have reversed. But there is a ceiling.","The ceiling is what the press would be carried at **if it had never been impaired**: 1,200,000 − 5 years × 120,000 = 600,000.","So the {i|reversal} is 600,000 − 521,617 = **78,383**, not 128,383. Anything above the ceiling would be a revaluation, which the cost model doesn’t allow."],"sect":5,"part":"Derecognise / transfer"},{"type":"rule","bucket":"derecognise","lo":39,"title":"Reversing an impairment loss","body":["Impairments aren’t always for ever. When things improve, the write-down can be undone, but only so far, as Tanjong’s press just showed.","1. At each reporting date, look for signs that a past impairment may have **decreased or gone** (the indicators in reverse).","2. If so, re-estimate recoverable amount.","3. Reverse the loss, but **only up to** the {a|carrying amount} the asset would have had with **no impairment** (after normal {x|depreciation}).","> {i|Reversal} = lower of (new recoverable amount, {a|no-impairment carrying amount}) − {a|current carrying amount}","- Cost model: credit {i|Reversal of impairment loss} in **profit or loss**.","- Then depreciate the {a|new carrying amount} over the remaining life.","- **{a|Goodwill}:** an {x|impairment loss} is **never** reversed.","! The ceiling is the {a|no-impairment carrying amount}, not the new recoverable amount, and not the original cost."],"id":"rule-11klqh","sect":5,"part":"Derecognise / transfer"},{"type":"diagram","bucket":"derecognise","lo":39,"title":"Tanjong’s press on a timeline","intro":"Two paths: what the press would have been carried at without the impairment, and what it actually was. The reversal can only close the gap, not overtake it.","notes":{"y0":"Bought for 1,200,000, 10-year life, 120,000 a year.","y3":"1,200,000 − 3 × 120,000 = 840,000.","imp":"Recoverable amount 730,263 (value in use). {x|Loss} 109,737 to P&L.","y5":"New {x|depreciation} 104,323 for 20X4 and 20X5: 730,263 − 208,646 = 521,617.","ceil":"Had there been no impairment: 1,200,000 − 5 × 120,000 = 600,000.","ra":"The new recoverable amount, 650,000, is above the ceiling, so it can’t be reached.","rev":"600,000 − 521,617 = 78,383, to P&L."},"walk":[{"nodes":["y0","y3"],"text":"Three years of normal {x|depreciation}."},{"nodes":["imp"],"text":"**Impairment** at the end of 20X3: down to 730,263."},{"nodes":["y5"],"text":"Two years of the **new**, lower {x|depreciation}: 521,617 at the end of 20X5."},{"nodes":["ra","ceil"],"text":"Recoverable amount recovers to 650,000, but the **ceiling** is the {a|no-impairment carrying amount}, 600,000."},{"nodes":["rev"],"text":"{i|Reversal} = **78,383**, credited to P&L."}],"caption":"A reversal can undo the impairment, never more.","id":"diagram-1w579a","sect":5,"part":"Derecognise / transfer","svg":"\u003csvg width=\"100%\" style=\"min-width:640px\" role=\"img\"\n viewBox=\"0.00 0.00 718.00 125.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 114.44)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-114.44 707.7,-114.44 707.7,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>y0\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M75.78,-101.82C75.78,-101.82 12,-101.82 12,-101.82 6,-101.82 0,-95.82 0,-89.82 0,-89.82 0,-77.82 0,-77.82 0,-71.82 6,-65.82 12,-65.82 12,-65.82 75.78,-65.82 75.78,-65.82 81.78,-65.82 87.78,-71.82 87.78,-77.82 87.78,-77.82 87.78,-89.82 87.78,-89.82 87.78,-95.82 81.78,-101.82 75.78,-101.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"15.76\" y=\"-85.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">1 Jan 20X1\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-74.37\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"white\">cost 1,200,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>y3\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M257.06,-101.82C257.06,-101.82 200.03,-101.82 200.03,-101.82 194.03,-101.82 188.03,-95.82 188.03,-