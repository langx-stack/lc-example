a,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">recent losses: need convincing evidence\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>ttd&#45;&gt;prof\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M145.97,-209.25C137.12,-200.11 126.12,-188.75 116.49,-178.81\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"118.39,-177.25 111.76,-173.92 114.87,-180.65 118.39,-177.25\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"156.68\" y=\"-187\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> none here \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>rec\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M280.73,-99C280.73,-99 182.62,-99 182.62,-99 176.62,-99 170.62,-93 170.62,-87 170.62,-87 170.62,-75 170.62,-75 170.62,-69 176.62,-63 182.62,-63 182.62,-63 280.73,-63 280.73,-63 286.73,-63 292.73,-69 292.73,-75 292.73,-75 292.73,-87 292.73,-87 292.73,-93 286.73,-99 280.73,-99\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"191.55\" y=\"-81.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Recognise DTA\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"181.43\" y=\"-72.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">200,000 × 17% = 34,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>ttd&#45;&gt;rec\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M176.79,-209.08C179.84,-205.04 182.97,-200.69 185.68,-196.5 203.96,-168.16 217.15,-131.37 224.6,-107.25\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"226.89,-108.13 226.56,-100.72 222.2,-106.72 226.89,-108.13\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"257.46\" y=\"-150.38\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> yes: to that extent \u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>prof&#45;&gt;rec\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M127.43,-135.82C146.4,-126.03 170.21,-113.73 190.29,-103.37\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"191.35,-105.58 196.44,-100.19 189.1,-101.23 191.35,-105.58\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"191.19\" y=\"-113.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> 200,000 \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>dis\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" stroke-dasharray=\"5,2\" d=\"M136.6,-99C136.6,-99 46.75,-99 46.75,-99 40.75,-99 34.75,-93 34.75,-87 34.75,-87 34.75,-75 34.75,-75 34.75,-69 40.75,-63 46.75,-63 46.75,-63 136.6,-63 136.6,-63 142.6,-63 148.6,-69 148.6,-75 148.6,-75 148.6,-87 148.6,-87 148.6,-93 142.6,-99 136.6,-99\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"47.05\" y=\"-81.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#374151\">Disclose, no DTA\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"45.55\" y=\"-72.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#374151\">100,000 unrecognised\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>prof&#45;&gt;dis\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M93.19,-136C92.95,-127.55 92.66,-117.2 92.4,-107.83\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"94.86,-108.03 92.21,-101.1 89.96,-108.16 94.86,-108.03\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"112.29\" y=\"-113.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> the rest \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>re\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M189.85,-36C189.85,-36 131.5,-36 131.5,-36 125.5,-36 119.5,-30 119.5,-24 119.5,-24 119.5,-12 119.5,-12 119.5,-6 125.5,0 131.5,0 131.5,0 189.85,0 189.85,0 195.85,0 201.85,-6 201.85,-12 201.85,-12 201.85,-24 201.85,-24 201.85,-30 195.85,-36 189.85,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"135.55\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Reassess\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"130.3\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"white\">every year end\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>rec&#45;&gt;re\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M211.52,-62.68C203.94,-56.17 195.2,-48.67 187.14,-41.73\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"189.18,-40.26 182.28,-37.56 185.99,-43.98 189.18,-40.26\"/>\n\u003c/g>\n\n\u003cg id=\"edge7\" class=\"edge\">\n\u003ctitle>dis&#45;&gt;re\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M111.26,-62.68C118.48,-56.3 126.79,-48.96 134.5,-42.14\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"136.04,-44.05 139.66,-37.57 132.8,-40.38 136.04,-44.05\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"je-196b12","type":"je","bucket":"recognise","blabel":"tax losses","lo":30,"q":"Tembusu Pte Ltd has $300,000 of unused tax losses, of which $200,000 is covered by probable future taxable profit. Its {a|deferred tax asset} at 17% is $34,000. Record it.","accounts":["Current tax expense","Current tax payable","Deferred tax expense","Deferred tax income","Deferred tax liability","Deferred tax asset","Revaluation surplus (OCI)","Property, plant and equipment","Cash","Retained earnings","Accruals"],"lines":[{"side":"Dr","account":"Deferred tax asset","amount":34000},{"side":"Cr","account":"Deferred tax income","amount":34000}],"why":"200,000 × 17% = 34,000. The {i|credit} reduces {x|tax expense} in P&L.","sect":10,"part":"Recognise · tax losses"},{"type":"mcq","bucket":"recognise","blabel":"tax losses","lo":30,"q":"A company has made losses for the last three years and has no taxable temporary differences. Management “hopes” to return to profit but has no firm plans. What should it do with its unused tax losses?","options":[{"t":"Recognise a {a|DTA} on all the losses, because they never expire","why":"Carry-forward doesn’t make recovery probable. Recent losses are strong evidence against recognition."},{"t":"Recognise a {a|DTA} on half the losses as a prudent estimate","why":"There is no “half” rule. The test is probable future taxable profit, and there is no convincing evidence here."},{"t":"Recognise no {a|DTA}, and disclose the unused losses","ok":true,"why":"Without convincing evidence of future taxable profit, no {a|DTA} is recognised. Unrecognised losses are disclosed."},{"t":"Recognise the losses as a {a|current tax asset}","why":"{a|Current tax assets} are for tax overpaid, not losses carried forward."}],"id":"mcq-16bht0","sect":10,"part":"Recognise · tax losses"},{"type":"compare","bucket":"recognise","preamble":"Like provisions, deferred tax is lopsided: liabilities are booked readily, assets only when the benefit is probable.","blabel":"tax losses","lo":30,"special":"A {l|DTL} is recognised for almost every taxable difference, but a {a|DTA} (including one on unused tax losses) only to the extent future taxable profit is probable, and that is reassessed every year.","id":"compare-1kumyt-3","sect":10,"part":"Recognise · tax losses"},{"type":"map","id":"map-11-present","bucket":"present","sect":11,"part":"Present & disclose"},{"id":"think-30re0n","type":"think","bucket":"present","lo":31,"scenario":"Lim’s profit was $200,000, but its {x|tax expense} is $35,020, not $34,000 (17% of profit). Its tax adjustments this year: $6,000 of non-deductible {x|entertainment}, and capital allowances of $50,000 against {x|depreciation} of $25,000 on a machine.","prompt":"What would a reader of the accounts want explained? And what explains this gap?","answer":["Readers want to know why the effective rate isn’t 17%. Here the only reason is the **non-deductible {x|entertainment}**: 6,000 × 17% = $1,020.","The machine’s timing difference does **not** explain any of the gap, because deferred tax already adds back the tax “saved” this year. Timing differences are innocent bystanders here."],"sect":11,"part":"Present & disclose"},{"id":"visual-148hml","type":"visual","bucket":"present","lo":31,"title":"The tax reconciliation","html":"\u003cp>Lim’s gap, laid out as the note in the accounts shows it: start from profit × 17% and add each reason the actual \u003cspan class=\"el el-x\">tax expense\u003c/span> differs.\u003c/p>\u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num\">\u003ctbody>\n      \u003ctr>\u003ctd>Accounting profit × 17% (200,000 × 17%)\u003c/td>\u003ctd>34,000\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Tax effect of non-deductible \u003cspan class=\"el el-x\">entertainment\u003c/span> (6,000 × 17%)\u003c/td>\u003ctd>1,020\u003c/td>\u003c/tr>\n      \u003ctr>\u003cth scope=\"row\">\u003cspan class=\"el el-x\">Tax expense\u003c/span> (current 30,770 + deferred 4,250)\u003c/th>\u003ctd>\u003cb>35,020\u003c/b>\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">Only permanent items and rate effects appear. Temporary differences don’t, because deferred tax balances them.\u003c/p>","sect":11,"part":"Present & disclose"},{"type":"visual","bucket":"present","lo":31,"title":"One tax expense, two ways to slice it","html":"\u003cp>Lim’s year-1 \u003cspan class=\"el el-x\">tax expense\u003c/span> of 35,020 as two bars of the same length. The top bar is how it is \u003cstrong>booked\u003c/strong> (current + deferred); the bottom is how the note \u003cstrong>explains\u003c/strong> it (profit × 17% + permanent items).\u003c/p>\u003cdiv class=\"cbars\">\u003cdiv class=\"cb-key\">\u003cspan>\u003cspan class=\"seg x\">\u003c/span>\u003cspan class=\"el el-x\">current tax\u003c/span>\u003c/span>\u003cspan>\u003cspan class=\"seg l\">\u003c/span>\u003cspan class=\"el el-x\">deferred tax\u003c/span> (builds the \u003cspan class=\"el el-l\">DTL\u003c/span>)\u003c/span>\u003cspan>\u003cspan class=\"seg n\">\u003c/span>profit × 17%\u003c/span>\u003cspan>\u003cspan class=\"seg out-x\">\u003c/span>\u003cspan class=\"el el-x\">permanent item\u003c/span>\u003c/span>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">How it is booked: \u003cspan class=\"el el-x\">30,770\u003c/span> + \u003cspan class=\"el el-x\">4,250\u003c/span> = \u003cspan class=\"el el-x\">35,020\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg x\" style=\"flex:none;width:87.86%\">\u003c/span>\u003cspan class=\"seg l\" style=\"flex:none;width:12.14%\">\u003c/span>\u003c/div>\u003c/div>\u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">How it is explained: 34,000 + \u003cspan class=\"el el-x\">1,020\u003c/span> = \u003cspan class=\"el el-x\">35,020\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg n\" style=\"flex:none;width:97.09%\">\u003c/span>\u003cspan class=\"seg out-x\" style=\"flex:none;width:2.91%\">\u003c/span>\u003c/div>\u003c/div>\n  \u003c/div>\u003cp class=\"cap\">Same length, cut differently. The timing difference lives only in the top bar (it moves tax from current to deferred); the reconciliation needs only the \u003cspan class=\"el el-x\">entertainment\u003c/span>.\u003c/p>","id":"visual-otq6yq","sect":11,"part":"Present & disclose"},{"type":"diagram","bucket":"present","lo":31,"title":"Building the tax reconciliation","intro":"From profit × 17% down to the tax expense in P&L. Lim’s year 1.","notes":{"start":"Start from accounting profit × the applicable rate: 200,000 × 17% = $34,000.","perm":"Permanent items move the {x|expense} away from 17%. {x|Entertainment}: 6,000 × 17% = +$1,020. A {x|fine} would add too; {i|exempt income} would reduce it.","rate":"Effect of a rate change on opening deferred tax balances. None for Lim this year.","loss":"Losses with no {a|DTA}, or a {a|DTA} recognised on losses from earlier years. None for Lim.","end":"{x|Tax expense} = 34,000 + 1,020 = $35,020, which equals {x|current} 30,770 + {x|deferred} 4,250.","temp":"Temporary items cancel: allowances cut {x|current tax} by 4,250, {x|deferred tax} adds 4,250 back. So they never appear in the reconciliation."},"walk":[{"nodes":["start"],"text":"Profit × 17% = $34,000: what tax would be if nothing were special."},{"nodes":["perm"],"text":"Add the permanent item: +$1,020."},{"nodes":["rate","loss"],"text":"Then rate effects and losses with no {a|DTA}. Zero here."},{"nodes":["temp"],"text":"Temporary items net to zero, so they are left out."},{"nodes":["end"],"text":"Total: $35,020, the {x|tax expense} in P&L."}],"caption":"Permanent items and rate effects explain the gap. Temporary differences never do.","id":"diagram-1pqwcl","sect":11,"part":"Present & disclose","svg":"\u003csvg width=\"100%\" style=\"min-width:386px\" role=\"img\"\n viewBox=\"0.00 0.00 351.00 327.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 312.65)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-312.65 336.12,-312.65 336.12,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>start\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M131.48,-298.25C131.48,-298.25 33.38,-298.25 33.38,-298.25 27.38,-298.25 21.38,-292.25 21.38,-286.25 21.38,-286.25 21.38,-274.25 21.38,-274.25 21.38,-268.25 27.38,-262.25 33.38,-262.25 33.38,-262.25 131.48,-262.25 131.48,-262.25 137.48,-262.25 143.48,-268.25 143.48,-274.25 143.48,-274.25 143.48,-286.25 143.48,-286.25 143.48,-292.25 137.48,-