7 403.69,-125.12 405.71,-128.8\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"427.89\" y=\"-155.5\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> Yes, very unlikely \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>prov\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M111.03,-36C111.03,-36 12,-36 12,-36 6,-36 0,-30 0,-24 0,-24 0,-12 0,-12 0,-6 6,0 12,0 12,0 111.03,0 111.03,0 117.03,0 123.03,-6 123.03,-12 123.03,-12 123.03,-24 123.03,-24 123.03,-30 117.03,-36 111.03,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"61.51\" y=\"-13.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">Recognise a provision\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge9\" class=\"edge\">\n\u003ctitle>n4&#45;&gt;prov\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M77.92,-88.48C71.86,-83.81 66.35,-78.16 62.76,-71.5 58.31,-63.22 57.24,-53.09 57.55,-43.95\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"59.64,-44.21 57.98,-38.07 55.45,-43.9 59.64,-44.21\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"90.14\" y=\"-62\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> Yes (almost\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"90.14\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\">always) \u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge10\" class=\"edge\">\n\u003ctitle>n4&#45;&gt;cl\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M117.51,-88.43C121.88,-75.93 129.37,-59.55 141.01,-49 146.29,-44.22 152.4,-40.18 158.83,-36.76\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"159.55,-38.75 164.01,-34.22 157.7,-34.98 159.55,-38.75\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"173.26\" y=\"-62\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> No (extremely\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"173.26\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\">rare) \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"map","id":"map-3-classify","bucket":"classify","blabel":"contingent assets","sect":3,"part":"Classify · contingent assets"},{"id":"think-9n2fb3","type":"think","bucket":"classify","blabel":"contingent assets","lo":33,"scenario":"Kallang Kitchens is suing a supplier for $120,000 over faulty gas valves. Its lawyers say Kallang will probably win (about 75%).","prompt":"If a 75% chance of **paying** gives a {l|provision}, does a 75% chance of **receiving** give an {a|asset}?","answer":["No. A probable inflow is only a **contingent asset**: Kallang **discloses** it, but books nothing.","It recognises an {a|asset} only when the inflow is **virtually certain** (say the court has ruled and the supplier has agreed to pay). At that point it isn’t contingent any more.","The standard is deliberately lopsided: bad news gets booked at “probable”, good news has to wait for “virtually certain”. Don’t count your chickens before the judge hatches them."],"sect":3,"part":"Classify · contingent assets"},{"type":"rule","bucket":"classify","blabel":"contingent assets","lo":33,"title":"Contingent assets: the thresholds are not symmetrical","body":["Now the mirror image: a possible inflow instead of an outflow. The ladder is the same, but {a|assets} need a higher rung before they are booked.","- A **contingent asset** is a **possible** asset from past events, whose existence depends on uncertain future events outside the entity’s control.","1. **Virtually certain** inflow: recognise the {a|asset}. It is no longer contingent.","2. **Probable** inflow: **disclose** the contingent asset. Don’t make the {i|income} sound certain.","3. **Possible** or **remote**: nothing.","! A contingent asset is **never** recognised. {l|Liabilities}: recognise at probable. {a|Assets}: recognise only at virtually certain."],"id":"rule-4cf8sz","sect":3,"part":"Classify · contingent assets"},{"type":"diagram","bucket":"classify","blabel":"contingent assets","lo":33,"title":"The same likelihood, two different answers","intro":"A plain table: one row per likelihood. Read across each row: the same likelihood leads to a different treatment for money going out and money coming in.","notes":{"hL":"Pick the likelihood of the outflow (or inflow), then read left for an obligation and right for an asset.","vc":"Virtually certain: so close to certain that the doubt is negligible.","pb":"Probable: more likely than not, i.e. above 50%.","ps":"Possible: a real chance, but not more likely than not.","rm":"Remote: very unlikely.","oVc":"A certain obligation is a normal {l|liability} (or a {l|provision} if the amount or timing is uncertain).","oPb":"Probable outflow: recognise a {l|provision} (with a present obligation and a reliable estimate).","oPs":"Possible outflow: a contingent liability. Disclosed, not recognised.","oRm":"Remote outflow: no disclosure needed.","iVc":"Only now is the {a|asset} recognised. It is no longer contingent.","iPb":"Probable inflow: a contingent asset. Disclosed, not recognised.","iPs":"Possible inflow: nothing, not even a note.","iRm":"Remote inflow: nothing."},"walk":[{"nodes":["hL","hO","hI"],"text":"Pick the likelihood on the left, then read across: the middle column is money going out, the right column money coming in."},{"nodes":["pb","oPb","iPb"],"text":"Probable: the {l|liability} is recognised, the asset only disclosed. This row is the exam favourite."},{"nodes":["ps","oPs","iPs"],"text":"Possible: the liability is disclosed, the asset ignored."},{"nodes":["vc","oVc","iVc"],"text":"Virtually certain: both are recognised."},{"nodes":["rm","oRm","iRm"],"text":"Remote: nothing on either side."}],"caption":"{l|Liabilities} move one step earlier than {a|assets}. Prudence in action, without calling it prudence.","id":"diagram-chkhwr","sect":3,"part":"Classify · contingent assets","svg":"\u003csvg width=\"100%\" style=\"min-width:391px\" role=\"img\"\n viewBox=\"0.00 0.00 355.00 245.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 230.4)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-230.4 340.8,-230.4 340.8,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>hO\u003c/title>\n\u003cpath fill=\"#ffe4e6\" stroke=\"#be123c\" stroke-width=\"1.2\" d=\"M203.4,-216C203.4,-216 123,-216 123,-216 117,-216 111,-210 111,-204 111,-204 111,-192 111,-192 111,-186 117,-180 123,-180 123,-180 203.4,-180 203.4,-180 209.4,-180 215.4,-186 215.4,-192 215.4,-192 215.4,-204 215.4,-204 215.4,-210 209.4,-216 203.4,-216\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"138.82\" y=\"-199\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.00\" fill=\"#111827\">Obligation\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"141.82\" y=\"-189.95\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">money out\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>hI\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M314.4,-216C314.4,-216 234,-216 234,-216 228,-216 222,-210 222,-204 222,-204 222,-192 222,-192 222,-186 228,-180 234,-180 234,-180 314.4,-180 314.4,-180 320.4,-180 326.4,-186 326.4,-192 326.4,-192 326.4,-204 326.4,-204 326.4,-210 320.4,-216 314.4,-216\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"261.07\" y=\"-199\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.00\" fill=\"#111827\">Asset\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"255.45\" y=\"-189.95\" font-family=\"Helvetica,sa