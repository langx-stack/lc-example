.18 359.56,-79.18 365.56,-79.18 365.56,-79.18 419.59,-79.18 419.59,-79.18 425.59,-79.18 431.59,-85.18 431.59,-91.18 431.59,-91.18 431.59,-106.82 431.59,-106.82 431.59,-112.82 425.59,-118.82 419.59,-118.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"365.2\" y=\"-105.05\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Year 2 end\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"362.95\" y=\"-94.05\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">NRV 11,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"362.2\" y=\"-84.95\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">carry at 10,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>y1&#45;&gt;y2\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M236.27,-99C267.26,-99 312.16,-99 345.72,-99\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"345.62,-101.1 351.62,-99 345.62,-96.9 345.62,-101.1\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"295.19\" y=\"-100.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> NRV recovers \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>wd\u003c/title>\n\u003cpath fill=\"#ffe4e6\" stroke=\"#be123c\" stroke-width=\"1.2\" d=\"M233.06,-36C233.06,-36 165.53,-36 165.53,-36 159.53,-36 153.53,-30 153.53,-24 153.53,-24 153.53,-12 153.53,-12 153.53,-6 159.53,0 165.53,0 165.53,0 233.06,0 233.06,0 239.06,0 245.06,-6 245.06,-12 245.06,-12 245.06,-24 245.06,-24 245.06,-30 239.06,-36 233.06,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"169.3\" y=\"-19.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Write&#45;down\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"162.17\" y=\"-8.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">1,500 to COGS\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>y1&#45;&gt;wd\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#be123c\" d=\"M199.3,-78.93C199.3,-67.18 199.3,-55.42 199.3,-43.67\"/>\n\u003cpolygon fill=\"#be123c\" stroke=\"#be123c\" points=\"201.4,-43.87 199.3,-37.87 197.2,-43.87 201.4,-43.87\"/>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>rev\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M427.84,-36C427.84,-36 357.31,-36 357.31,-36 351.31,-36 345.31,-30 345.31,-24 345.31,-24 345.31,-12 345.31,-12 345.31,-6 351.31,0 357.31,0 357.31,0 427.84,0 427.84,0 433.84,0 439.84,-6 439.84,-12 439.84,-12 439.84,-24 439.84,-24 439.84,-30 433.84,-36 427.84,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"369.7\" y=\"-19.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Reversal\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"353.95\" y=\"-8.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">1,500 off COGS\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>y2&#45;&gt;rev\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#166534\" d=\"M392.57,-78.93C392.57,-67.18 392.57,-55.42 392.57,-43.67\"/>\n\u003cpolygon fill=\"#166534\" stroke=\"#166534\" points=\"394.68,-43.87 392.58,-37.87 390.48,-43.87 394.68,-43.87\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>cap\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-width=\"1.2\" stroke-dasharray=\"5,2\" d=\"M564.37,-117C564.37,-117 484.84,-117 484.84,-117 478.84,-117 472.84,-111 472.84,-105 472.84,-105 472.84,-93 472.84,-93 472.84,-87 478.84,-81 484.84,-81 484.84,-81 564.37,-81 564.37,-81 570.37,-81 576.37,-87 576.37,-93 576.37,-93 576.37,-105 576.37,-105 576.37,-111 570.37,-117 564.37,-117\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"497.23\" y=\"-99.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#6b7280\">Not 11,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"481.48\" y=\"-90.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#6b7280\">ceiling = original cost\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>y2&#45;&gt;cap\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M431.89,-99C442.33,-99 453.89,-99 465.18,-99\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"465.04,-101.1 471.04,-99 465.04,-96.9 465.04,-101.1\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"subsequent","lo":10,"title":"Write-down and reversal, step by step","html":"\u003cp>The same goods (cost 10,000, written down to 8,500 in year 1), in two possible year 2s. On the left NRV bounces back to 11,000, above cost; on the right only to 9,600. Watch where the \u003cspan class=\"el el-a\">carrying amount\u003c/span> stops.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"wd-b11\" data-cfg=\"{&quot;target&quot;:{&quot;v&quot;:10000,&quot;label&quot;:&quot;original cost 10,000&quot;},&quot;panels&quot;:[{&quot;title&quot;:&quot;NRV recovers above cost&quot;,&quot;sub&quot;:&quot;year 2 NRV 11,000&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:10000,&quot;startCap&quot;:&quot;Bought at {a|cost 10,000}: the ceiling for the life of these goods.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;Year 1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;write-down&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-1500,&quot;cap&quot;:&quot;NRV = 9,500 − 600 − 400 = 8,500. {x|Write-down} 10,000 − 8,500 = {x|1,500} → {a|8,500}.&quot;}]},{&quot;label&quot;:&quot;Year 2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;reversal&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:1500,&quot;cap&quot;:&quot;NRV 11,000 is above cost, so reverse only {x|1,500}, back to {a|10,000}. Not to 11,000.&quot;}]}]},{&quot;title&quot;:&quot;NRV recovers partway&quot;,&quot;sub&quot;:&quot;year 2 NRV 9,600&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:10000,&quot;startCap&quot;:&quot;Bought at {a|cost 10,000}: the ceiling for the life of these goods.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;Year 1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;write-down&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-1500,&quot;cap&quot;:&quot;NRV = 9,500 − 600 − 400 = 8,500. {x|Write-down} 10,000 − 8,500 = {x|1,500} → {a|8,500}.&quot;}]},{&quot;label&quot;:&quot;Year 2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;reversal&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:1100,&quot;cap&quot;:&quot;NRV 9,600 is still below cost: reverse {x|1,100} to {a|9,600}, the new lower of cost and NRV.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Same goods, same year-1 write-down. In year 2 NRV recovers by different amounts. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Year 1: NRV drops below cost, so the {a|carrying amount} follows it down and the {x|loss} hits profit or loss.&quot;,&quot;Year 2: NRV recovers. The reversal (a credit to {x|COGS}) takes the {a|carrying amount} to the new lower of cost and NRV.&quot;],&quot;end&quot;:&quot;**The dashed line is a ceiling.** Recover past cost and you stop at 10,000 (reversal 1,500, not 2,500); recover partway and you follow NRV (reversal 1,100).&quot;}}\">\u003c/div>","id":"visual-1yfmdt","sect":4,"part":"Subsequent measurement"},{"id":"je-mj4err","type":"je","bucket":"subsequent","lo":10,"q":"Goods costing $10,000 were written down to NRV of $8,500 at the end of year 1. At the end of year 2 they are still on hand and their NRV has risen to $11,000. Record the year 2 reversal.","accounts":["Inventory","Accounts payable","Accounts receivable","Cash","GST receivable","Sales revenue","Cost of goods sold","Purchases","Freight-in","Purchase returns","Purchase discounts","Freight-out expense","Storage expense","Revaluation surplus (OCI)","Retained earnings"],"lines":[{"side":"Dr","account":"Inventory","amount":1500},{"side":"Cr","account":"Cost of goods sold","amount":1500}],"why":"Reverse only 1,500 (back to cost 10,000), not 2,500 (to NRV 11,000). The reversal reduces the year’s {x|inventory expense}.","sect":4,"part":"Subsequent measurement"},{"type":"mcq","bucket":"subsequent","lo":10,"q":"Goods costing $24,000 were written down to NRV of $18,000 last year. They are still on hand, and NRV is now $27,000. At what amount are they carried now?","options":[{"t":"$18,000","why":"SFRS(I) requires the write-down to be reversed when NRV recovers. (Leaving it is the US GAAP answer.)"},{"t":"$24,000","ok":true,"why":"Reverse 6,000, back to original cost. Lower of cost (24,000) and NRV (27,000)."},{"t":"$27,000","why":"Above original cost. The reversal is capped at the original write-down."},{"t":"$22,500","why":"There is no averaging: it is the lower of cost and current NRV."}],"id":"mcq-u4k0ch","sect":4,"part":"Subsequent measurement"},{"type":"compare","bucket":"subsequent","preamble":"Inventory is the only one of these cousins that can never be written **up** above cost: PPE can be revalued and investment property can follow fair value.","lo":9,"special":"{a|Inventory} has **no revaluation upward**: it is held at the lower of cost and NRV, item by item, and a write-down can be reversed only back to original cost.","id":"compare-1kumyt-3","sect":4,"part":"Subsequent measurement"},{"type":"map","id":"map-5-derecognise","bucket":"derecognise","sect":5,"part":"Derecognise / transfer"},{"type":"think","bucket":"derecognise","lo":11,"scenario":"Changi Gadgets (perpetual) sells 300 speakers to a retailer on credit at $120 each. Each speaker cost $78.6.","prompt":"One sale, but how many things just changed in the accounts?","answer":["Two. The business **earned {i|revenue}** of 36,000 (and a {a|receivable}), and it **gave up goods** that cost 23,580.","Under the perpetual system both are recorded at the sale: {i|revenue}, and the cost moved from {a|Inventory} to {x|Cost of goods sold}.","Under periodic, only the {i|revenue} is recorded now. {x|COGS} waits for the year-end count."],"id":"think-1offwu","sect":5,"part":"Derecognise / transfer"},{"id":"je-15tr7b","type":"je","bucket":"derecognise","lo":11,"q":"Changi Gadgets (perpetual system) sells 300 speakers to a retailer on credit at $120 each. Each speaker cost $78.6. Record the sale.","accounts":["Inventory","Accounts payable","Accounts receivable","Cash","GST receivable","Sales revenue","Cost of goods sold","Purchases","Freight-in","Purchase returns","Purchase discounts","Freight-out expense","Storage expense","Revaluation surplus (OCI)","Retained earnings"],"lines":[{"side":"Dr","account":"Accounts receivable","amount":36000},{"side":"Cr","account":"Sales revenue","amount":36000},{"side":"Dr","account":"Cost of goods sold","amount":23580},{"side":"Cr","account":"Inventory","amount":23580}],"why":"{i|Revenue} 300 × 120 = 36,000. Cost 300 × 78.6 = 23,580 leaves {a|inventory}. Two entries under perpetual.","sect":5,"part":"Derecognise / transfer"},{"type":"rule","bucket":"derecognise","lo":11,"title":"COGS under the periodic system","body":["Under perpetual, {x|COGS} is recorded sale by sale, as we just did. A periodic shop has no such running record, so it has to work {x|COGS} out backwards from the stock count. Here is how.","Under periodic, {x|cost of goods sold} is a **balancing figure**, worked out after the stock count:","> {x|COGS} = {a|Opening inventory} + {x|Net purchases} − {a|Closing inventory}","> {x|Net purchases} = {x|Purchases} + {x|Freight-in} − {x|Purchase returns} − {x|Purchase discounts}","One period-end entry then:","1. closes {x|Purchases}, {x|Freight-in}, {x|Purchase returns} and {x|Purchase discounts},","2. replaces {a|opening Inventory} with {a|closing inventory} from the count, and","3. records {x|Cost of goods sold} as the balancing figure.","- Under periodic, anything not on the shelf at the count is assumed sold, so theft and breakage hide inside {x|COGS}."],"id":"rule-3c051y","sect":5,"part":"Derecognise / transfer"},{"id":"calc-1e1au4","type":"calc","bucket":"derecognise","lo":11,"q":"A trader (periodic) has {a|opening inventory} $18,000, {x|purchases} $95,000, {x|freight-in} $2,500, {x|purchase returns} $3,000, {x|purchase discounts} $1,500. The year-end count shows {a|closing inventory} of $21,000. What is {x|cost of goods sold}?","answer":90000,"unit":"$","working":["{x|Net purchases} = 95,000 + 2,500 − 3,000 − 1,500 = 93,000.","{x|COGS} = 18,000 + 93,000 − 21,000 = **$90,000**."],"sect":5,"part":"Derecognise / transfer"},{"id":"je-1gj3ha","type":"je","bucket":"derecognise","lo":11,"q":"A business with no {a|opening stock} uses the **periodic** system. The year-end count shows 30 units at $21.6 = $648. Record the period-end entry that closes the temporary accounts ({x|purchases} 2,000, {x|returns} 400, {x|freight-in} 160, {x|discounts} 32).","accounts":["Inventory","Accounts payable","Accounts receivable","Cash","GST receivable","Sales revenue","Cost of goods sold","Purchases","Freight-in","Purchase returns","Purchase discounts","Freight-out expense","Storage expense","Revaluation surplus (OCI)","Retained earnings"],"lines":[{"side":"Dr","account":"Inventory","amount":648},{"side":"Dr","account":"Cost of goods sold","amount":1080},{"side":"Dr","account":"Purchase returns","amount":400},{"side":"Dr","account":"Purchase discounts","amount":32},{"side":"Cr","account":"Purchases","amount":2000},{"side":"Cr","account":"Freight-in","amount":160}],"why":"{x|COGS} = 0 + (2,000 + 160 − 400 − 32) − 648 = 1,080: the same as under perpetual. Credit-balance accounts ({x|returns}, {x|discounts}) are closed with a debit, debit-balance ones ({x|purchases}, {x|freight-in}) with a credit.","sect":5,"part":"Derecognise / transfer"},{"id":"think-rer3tg","type":"think","bucket":"derecognise","lo":12,"scenario":"Tiong Bahru Tea sells identical tins of tea. In January it started with 100 tins at $10, bought 200 at $13, then 100 at $18. It sold 270 tins. Nobody can tell which tin came from which delivery.","prompt":"Which cost goes to {x|COGS}: $10, $13, $18 or some mix? And does it matter?","answer":["It matters: the choice decides how much cost leaves as **{x|COGS}** and how much stays on the shelf as **{a|closing inventory}**.","Because the tins are **interchangeable**, the standard lets the entity assume a flow of costs: **first in, first out** (FIFO), or a **weighted average**.","For items that are **not** interchangeable (a car with a chassis number, a one-off diamond ring), you track the actual cost of each item: **specific identification**."],"sect":5,"part":"Derecognise / transfer"},{"type":"rule","bucket":"derecognise","lo":12,"title":"Three cost formulas, and one that is banned","body":["When identical tins arrive at different prices, someone has to decide which cost leaves with each sale. The standard gives a short menu, and the choice moves profit between this year and next.","1. **Specific identification:** **required** for items that are not ordinarily interchangeable, or goods made for specific projects (cars, jewellery). Track the actual cost of each item sold.","2. **FIFO:** for interchangeable items. Oldest costs go to {x|COGS} first, so {a|closing stock} carries the most recent costs.","3. **Weighted average:** for interchangeable items. Periodic: one average for the whole period. Perpetual: a **moving average**, recalculated after each purchase.","- **LIFO is not allowed** under SFRS(I). Skip the LIFO sections in FA.","- Use the **same formula** for all inventories of a similar nature and use. Different formulas only for inventories that differ in nature or use, not just location.","- FIFO gives the **same answer** under periodic and perpetual. Weighted average usually **doesn’t** (periodic average vs moving average).","+ Exam tip: draw a quick table, **Date | Units in | Units out | Balance (units × cost)**. It prevents most mistakes."],"id":"rule-y8sfq1","sect":5,"part":"Derecognise / transfer"},{"id":"visual-1m30mo","type":"visual","bucket":"derecognise","lo":12,"title":"Tiong Bahru Tea: three formulas, one month","html":"\u003cp>Now the numbers for Tiong Bahru Tea’s January (100 tins at $10 on hand, 200 bought at $13 on 5 Jan, 150 sold on 10 Jan, 100 bought at $18 on 20 Jan, 120 sold on 25 Jan). First the moving average worked line by line, then all three formulas side by side.\u003c/p>\n    \u003cp>\u003cstrong>Moving average (perpetual):\u003c/strong> the running-balance table.\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num reveal-rows\">\u003cthead>\u003ctr>\u003cth>Date\u003c/th>\u003cth>In\u003c/th>\u003cth>Out (cost)\u003c/th>\u003cth>Balance\u003c/th>\u003cth>Average\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>1 Jan\u003c/td>\u003ctd>100 = 1,000\u003c/td>\u003ctd>\u003c/td>\u003ctd>100 = 1,000\u003c/td>\u003ctd>10\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>5 Jan\u003c/td>\u003ctd>200 = 2,600\u003c/td>\u003ctd>\u003c/td>\u003ctd>300 = 3,600\u003c/td>\u003ctd>12\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>10 Jan\u003c/td>\u003ctd>\u003c/td>\u003ctd>150 = 1,800\u003c/td>\u003ctd>150 = 1,800\u003c/td>\u003ctd>12\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>20 Jan\u003c/td>\u003ctd>100 = 1,800\u003c/td>\u003ctd>\u003c/td>\u003ctd>250 = 3,600\u003c/td>\u003ctd>14.4\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>25 Jan\u003c/td>\u003ctd>\u003c/td>\u003ctd>120 = 1,728\u003c/td>\u003ctd>130 = 1,872\u003c/td>\u003ctd>14.4\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp>\u003cstrong>All three side by side:\u003c/strong>\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl num\">\u003cthead>\u003ctr>\u003cth>Formula\u003c/th>\u003cth>COGS\u003c/th>\u003cth>Closing inventory\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>FIFO\u003c/td>\u003ctd>3,210\u003c/td>\u003ctd>2,190\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Weighted average (periodic)\u003c/td>\u003ctd>3,645\u003c/td>\u003ctd>1,755\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Moving average (perpetual)\u003c/td>\u003ctd>3,528\u003c/td>\u003ctd>1,872\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">Goods available = 5,400 in every column; only the split changes. FIFO \u003cspan class=\"el el-a\">closing inventory\u003c/span> = the latest costs: 30 × 13 + 100 × 18 = 2,190. Periodic average = 5,400 ÷ 400 = 13.5, × 130 tins = 1,755.\u003c/p>","sect":5,"part":"Derecognise / transfer"},{"type":"diagram","bucket":"derecognise","lo":12,"title":"Goods available, split two ways","intro":"Every formula starts from the same pot of cost. The formula only decides how the pot is split between {x|COGS} (P&L) and {a|closing inventory} (balance sheet).","notes":{"open":"What was on the shelf at the start.","p1":"First purchase of the month.","p2":"Second purchase, at a higher price: prices are rising.","avail":"1,000 + 2,600 + 1,800 = 5,400. This total is the same whichever formula is used.","fifo":"Oldest costs out first.","wa":"5,400 ÷ 400 = 13.5 for every tin, sold or not.","fc":"The 270 tins sold carry the oldest (cheapest) costs: lowest {x|COGS}, highest profit.","fk":"130 tins on the most recent (dearest) costs.","wc":"270 × 13.5 = 3,645.","wk":"130 × 13.5 = 1,755."},"walk":[{"nodes":["open","p1","p2","avail"],"text":"Pool everything: goods available = **5,400**."},{"nodes":["fifo","fc","fk"],"text":"**FIFO** sends the oldest costs to {x|COGS} (3,210) and leaves the newest on the shelf (2,190)."},{"nodes":["wa","wc","wk"],"text":"**Weighted average** spreads one average over all tins: {x|COGS} 3,645, {a|closing} 1,755."},{"nodes":["fc","wc"],"text":"With prices **rising**, FIFO gives the lower {x|COGS}, higher {a|closing inventory} and higher profit."}],"caption":"Same pot, different split: {x|COGS} + {a|closing inventory} = goods available, every time.","id":"diagram-xo2izl","sect":5,"part":"Derecognise / transfer","svg":"\u003csvg width=\"100%\" style=\"min-width:402px\" role=\"img\"\n viewBox=\"0.00 0.00 365.00 241.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 229.8)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-229.8 354.58,-229.8 354.58,10.8 -10.8,10.8\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>open\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M87.78,-219C87.78,-219 12,-219 12,-219 6,-219 0,-213 0,-207 0,-207 0,-195 0,-195 0,-189 6,-183 12,-183 12,-183 87.78,-183 87.78,-183 93.78,-183 99.78,-189 99.78,-195 99.78,-195 99.78,-207 99.78,-207 99.78,-213 93.78,-219 87.78,-219\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"27.77\" y=\"-202.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Opening\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-191.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">100 × 10 = 1,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>avail\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M210.16,-158C210.16,-158 133.62,-158 133.62,-158 127.63,-158 121.63,-152 121.63,-146 121.63,-146 121.63,-134 121.63,-134 121.63,-128 127.63,-122 133.62,-122 133.62,-122 210.16,-122 210.16,-122 216.16,-122 222.16,-128 222.16,-134 222.16,-134 222.16,-146 222.16,-146 222.16,-152 216.16,-158 210.16,-158\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"