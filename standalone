 127.35,-136.25 133.35,-142.25 133.35,-148.25 133.35,-148.25 133.35,-160.25 133.35,-160.25 133.35,-166.25 127.35,-172.25 121.35,-172.25\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"42.3\" y=\"-154.8\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">± Rate changes\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"69.3\" y=\"-145.7\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">0 here\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>perm&#45;&gt;rate\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M82.43,-198.93C82.43,-193.44 82.43,-187.25 82.43,-181.28\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"84.88,-181.34 82.43,-174.34 79.98,-181.34 84.88,-181.34\"/>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>loss\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M137.48,-109.25C137.48,-109.25 27.38,-109.25 27.38,-109.25 21.38,-109.25 15.38,-103.25 15.38,-97.25 15.38,-97.25 15.38,-85.25 15.38,-85.25 15.38,-79.25 21.38,-73.25 27.38,-73.25 27.38,-73.25 137.48,-73.25 137.48,-73.25 143.48,-73.25 149.48,-79.25 149.48,-85.25 149.48,-85.25 149.48,-97.25 149.48,-97.25 149.48,-103.25 143.48,-109.25 137.48,-109.25\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"26.18\" y=\"-91.8\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">± Losses with no DTA\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"69.3\" y=\"-82.7\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">0 here\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>rate&#45;&gt;loss\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M82.43,-135.93C82.43,-130.44 82.43,-124.25 82.43,-118.28\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"84.88,-118.34 82.43,-111.34 79.98,-118.34 84.88,-118.34\"/>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>end\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M258.73,-36C258.73,-36 132.12,-36 132.12,-36 126.12,-36 120.13,-30 120.13,-24 120.13,-24 120.13,-12 120.13,-12 120.13,-6 126.13,0 132.12,0 132.12,0 258.73,0 258.73,0 264.73,0 270.73,-6 270.73,-12 270.73,-12 270.73,-24 270.73,-24 270.73,-30 264.73,-36 258.73,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"145.18\" y=\"-18.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"white\">Tax expense 35,020\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"130.93\" y=\"-9.45\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"white\">current 30,770 + deferred 4,250\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>loss&#45;&gt;end\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M110.07,-72.82C125.39,-63.16 144.58,-51.06 160.89,-40.78\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"161.78,-43.11 166.4,-37.3 159.17,-38.97 161.78,-43.11\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>temp\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" stroke-dasharray=\"5,2\" d=\"M309.73,-109.25C309.73,-109.25 183.12,-109.25 183.12,-109.25 177.12,-109.25 171.12,-103.25 171.12,-97.25 171.12,-97.25 171.12,-85.25 171.12,-85.25 171.12,-79.25 177.12,-73.25 183.12,-73.25 183.12,-73.25 309.73,-73.25 309.73,-73.25 315.73,-73.25 321.73,-79.25 321.73,-85.25 321.73,-85.25 321.73,-97.25 321.73,-97.25 321.73,-103.25 315.73,-109.25 309.73,-109.25\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"202.55\" y=\"-91.8\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#374151\">Temporary items\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"181.93\" y=\"-82.7\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#374151\">current −4,250, deferred +4,250\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>temp&#45;&gt;end\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M234.08,-73C227.72,-64.12 219.86,-53.14 212.89,-43.4\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"214.96,-42.08 208.89,-37.81 210.97,-44.93 214.96,-42.08\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"237.85\" y=\"-50.75\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> net 0 \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"rule","bucket":"present","lo":31,"title":"Presentation and disclosure","body":["The reconciliation was the headline disclosure. Here is the rest of the list, plus the two presentation rules (non-current, offset only with the same tax authority) that exam questions like to test.","- **Components of {x|tax expense}:** {x|current tax}, prior-year adjustments, {x|deferred tax} from temporary differences, from **rate changes**, and from previously unrecognised losses.","- Tax charged to **OCI** and directly to **equity**.","- **Tax reconciliation:** accounting profit × applicable rate → actual {x|tax expense}.","- Changes in the applicable rate compared with last year.","- Deductible differences and **unused tax losses with no {a|DTA}** recognised.","- For each type of temporary difference: the {a|DTA}/{l|DTL} and the amount in P&L.","- Evidence supporting a {a|DTA} when the entity has **recent losses**.","- **Presentation:** deferred tax is always **non-current**. **Offset** {a|DTAs} and {l|DTLs} only with a legal right to offset and the **same tax authority**."],"id":"rule-7bdyl1","sect":11,"part":"Present & disclose"},{"type":"mcq","bucket":"present","lo":31,"q":"Which item would appear as a reconciling item in the tax reconciliation (profit × rate → tax expense)?","options":[{"t":"Capital allowances claimed in excess of {x|depreciation}","why":"A temporary difference: the {x|deferred tax charge} already offsets it."},{"t":"Non-deductible {x|entertainment expenses}","ok":true,"why":"Permanent: it raises {x|tax expense} above profit × rate, so it must be explained."},{"t":"A {l|warranty provision} deductible when paid","why":"Temporary: offset by the {i|deferred tax credit}."},{"t":"The {l|current tax payable} at year end","why":"A balance, not a reconciling item between profit × rate and expense."}],"id":"mcq-1giz1i","sect":11,"part":"Present & disclose"},{"type":"compare","bucket":"present","lo":31,"special":"Deferred tax is always non-current and never discounted. Offset only with a legal right and the same tax authority. The tax reconciliation explains permanent items and rate effects, not temporary differences.","id":"compare-1kumyt-4","sect":11,"part":"Present & disclose"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":12,"part":"Wrap-up"},{"type":"summary","lo":31,"title":"Income tax on one page","rows":[["{x|Tax expense}?","{x|Current tax} + movement in deferred tax."],["Temporary difference?","Carrying amount − tax base, for each asset and liability."],["Permanent difference?","Never taxable or deductible: no deferred tax; it changes the effective rate."],["{a|Asset} CA > TB?","Taxable → {l|Deferred tax liability}. For liabilities, the reverse."],["{a|DTA} recognised when?","Only to the extent future taxable profit is probable, including for unused losses."],["Which rate?","Enacted or substantively enacted for the reversal period. No discounting."],["Revaluation?","{l|DTL} charged to OCI, not P&L."],["Key disclosure?","Tax reconciliation: profit × rate → {x|tax expense}."]],"id":"summary-odus2z","bucket":"wrap","sect":12,"part":"Wrap-up"}],"quiz":{"cases":{"merlion":{"name":"Merlion Foods","text":["Merlion Foods Pte Ltd (Merlion) has a financial year ending 31 December 20X6, its first year of trading. Accounting profit before tax is $500,000. The tax rate is 17%.","Merlion bought {a|machinery} for $300,000 on 1 January 20X6. {x|Depreciation} for 20X6 is $60,000; capital allowances claimed are $90,000.","Profit is after charging $10,000 of {x|entertainment}, which is not deductible for tax, and a {l|warranty provision} of $40,000. The warranty costs are deductible only when claims are paid; none were paid in 20X6. Future taxable profits are expected to be strong."]},"orchid":{"name":"Orchid Hotels","text":["Orchid Hotels Ltd (Orchid) has a financial year ending 31 December 20X8. At 1 January 20X8 it had a {l|deferred tax liability} of $51,000, arising on a $300,000 taxable temporary difference on {a|plant}, measured at 17%.","At 31 December 20X8 the taxable temporary difference on plant is $360,000. In November 20X8, a reduction in the tax rate to 15% for future years was substantively enacted.","On 31 December 20X8 Orchid revalued a {a|hotel building} upward by $200,000, recognised in OCI. The tax base is unchanged; assume the gain would be taxable when the building’s value is recovered."]}},"questions":[{"id":"mer-cur","type":"current-tax","case":"merlion","lo":28,"q":"What is Merlion’s {x|current tax} for 20X6?","options":[{"t":"$85,000","why":"Accounting profit × 17%. Current tax is based on taxable profit.","pit":"profit-x-rate"},{"t":"$88,400","ok":true,"why":"Taxable profit = 500,000 + {x|depreciation} 60,000 − allowances 90,000 + {x|entertainment} 10,000 + {x|warranty} 40,000 = 520,000; × 17% = 88,400."},{"t":"$81,600","why":"Forgets to add back the {l|warranty provision}, which isn’t deductible until paid."},{"t":"$86,700","why":"Forgets to add back the non-deductible {x|entertainment}."}]},{"id":"mer-dtl","type":"dt-balance","case":"merlion","lo":29,"q":"What deferred tax arises on the {a|machinery} at 31 December 20X6?","options":[{"t":"{l|Deferred tax liability} of $5,100","ok":true,"why":"{a|CA} 240,000 − TB 210,000 = 30,000 taxable; × 17% = 5,100."},{"t":"{a|Deferred tax asset} of $5,100","why":"Asset CA > TB is a taxable difference, so it is a {l|liability}.","pit":"wrong-direction"},{"t":"{l|Deferred tax liability} of $15,300","why":"Multiplies the allowances, not the temporary difference."},{"t":"None: capital allowances are a permanent difference","why":"Allowances and {x|depreciation} both total the cost over time. It is a timing difference.","pit":"temp-as-perm"}]},{"id":"mer-war","type":"perm-diff","case":"merlion","lo":27,"q":"How should Merlion treat the {l|warranty provision} for deferred tax?","options":[{"t":"Permanent difference: no deferred tax","why":"It will be deductible when paid, so it is temporary.","pit":"temp-as-perm"},{"t":"Taxable temporary difference: {l|DTL} of $6,800","why":"A {l|liability} with CA > TB is deductible, not taxable.","pit":"wrong-direction"},{"t":"Deductible temporary difference: {a|DTA} of $6,800","ok":true,"why":"Tax base 0, {l|carrying amount} 40,000: deductible. Profits are expected, so recognise a {a|DTA} of 6,800."},{"t":"Deductible temporary difference, but no {a|DTA} because it is Merlion’s first year","why":"The test is probable future taxable profit, which the case says is strong."}]},{"id":"mer-total","type":"tax-expense","case":"merlion","lo":28,"q":"What is Merlion’s {x|total tax expense} for 20X6?","options":[{"t":"$88,400","why":"{x|Current tax} only, leaving out {x|deferred tax}."},{"t":"$100,300","why":"Adds the {a|DTA}. A {a|deferred tax asset} reduces {x|tax expense}.","pit":"dta-sign"},{"t":"$86,700","ok":true,"why":"{x|Current} 88,400 + {l|DTL} 5,100 − {a|DTA} 6,800 = 86,700."},{"t":"$85,000","why":"Profit × 17%. The non-deductible {x|entertainment} adds to this."}]},{"id":"mer-recon","type":"recon","case":"merlion","lo":31,"q":"In Merlion’s tax reconciliation (profit × 17% → {x|tax expense}), what is the reconciling item?","options":[{"t":"Machinery timing difference of $5,100","why":"Temporary differences are balanced by deferred tax and don’t appear.","pit":"recon-temp"},{"t":"{l|Warranty provision} of $6,800","why":"Also temporary, so offset by the {a|DTA}.","pit":"recon-temp"},{"t":"Non-deductible {x|entertainment} of $1,700","ok":true,"why":"85,000 + 1,700 = 86,700. Only the permanent item is reconciling."},{"t":"There is no reconciling item","why":"{x|Tax expense} (86,700) differs from profit × 17% (85,000)."}]},{"id":"orc-close","type":"dt-balance","case":"orchid","lo":29,"q":"What {l|deferred tax liability} on {a|plant} should Orchid recognise at 31 December 20X8?","options":[{"t":"$61,200","why":"Uses the old 17% rate. The 15% rate was substantively enacted before year end.","pit":"old-rate"},{"t":"$54,000","ok":true,"why":"360,000 × 15% = 54,000."},{"t":"$9,000","why":"That is only the increase in the difference × 15%. The balance covers the whole difference."},{"t":"$51,000","why":"The {l|opening balance}. The difference and rate have both changed."}]},{"id":"orc-move","type":"tax-expense","case":"orchid","lo":29,"q":"What {x|deferred tax expense} on {a|plant} goes to profit or loss for 20X8?","options":[{"t":"$3,000","ok":true,"why":"{l|Closing} 54,000 − {l|opening} 51,000 = 3,000. The rate cut and the bigger difference partly offset."},{"t":"$10,200","why":"Increase in the difference × 17%, ignoring the rate change.","pit":"old-rate"},{"t":"$54,000","why":"That is the {l|closing balance}, not the movement.","pit":"closing-as-expense"},{"t":"$9,000","why":"Ignores remeasuring the {l|opening balance} at the new rate.","pit":"old-rate"}]},{"id":"orc-reval","type":"reval-oci","case":"orchid","lo":28,"q":"How should Orchid account for deferred tax on the hotel revaluation?","options":[{"t":"{l|DTL} of $30,000, charged to profit or loss","why":"Deferred tax follows the item. The revaluation went to OCI.","pit":"reval-to-pl"},{"t":"{l|DTL} of $30,000, charged to OCI","ok":true,"why":"200,000 × 15% (the enacted rate) = 30,000, in OCI."},{"t":"{l|DTL} of $34,000, charged to OCI","why":"Uses 17%, but 15% was enacted before year end.","pit":"old-rate"},{"t":"No deferred tax, because the gain is unrealised","why":"The revaluation still creates a taxable temporary difference."}]},{"id":"orc-pres","type":"present-offset","case":"orchid","lo":31,"q":"How should Orchid present its {l|deferred tax liability} in the statement of financial position?","options":[{"t":"As a {l|current liability}, because the rate changes next year","why":"Deferred tax is never classified as current.","pit":"dt-current"},{"t":"As a {l|non-current liability}","ok":true,"why":"Deferred tax balances are always presented as non-current."},{"t":"Split between current and non-current by reversal date","why":"This isn’t done for deferred tax.","pit":"dt-current"},{"t":"Netted against {l|current tax payable}","why":"Offsetting is only within current tax or within deferred tax, with a legal right and the same tax authority.","pit":"offset"}]},{"id":"orc-off","type":"present-offset","case":"orchid","lo":31,"q":"Orchid also has a {a|deferred tax asset}. When may it offset the {a|DTA} against its {l|DTL}?","options":[{"t":"Always, since both are deferred tax","why":"Offsetting needs specific conditions.","pit":"offset"},{"t":"When they relate to the same tax authority and Orchid has a legal right to offset","ok":true,"why":"Both conditions are required."},{"t":"Only if the {a|DTA} is larger than the {l|DTL}","why":"Size is irrelevant."},{"t":"Never","why":"Offsetting is required when the conditions are met."}]},{"id":"s-perm","type":"perm-diff","lo":27,"q":"Which of the following creates **no** deferred tax?","options":[{"t":"A {x|fine} paid to a regulator","ok":true,"why":"Never deductible: a permanent difference."},{"t":"{x|Depreciation} that is slower than capital allowances","why":"A taxable temporary difference → {l|DTL}.","pit":"temp-as-perm"},{"t":"A {l|provision} deductible when paid","why":"A deductible temporary difference → {a|DTA}.","pit":"temp-as-perm"},{"t":"A {e|revaluation surplus}","why":"A taxable temporary difference → {l|DTL} in OCI."}]},{"id":"s-base","type":"tax-base","lo":27,"q":"A machine cost $120,000. Capital allowances of $90,000 have been claimed, and its {a|carrying amount} is $80,000. What is its tax base?","options":[{"t":"$80,000","why":"That is the {a|carrying amount}.","pit":"tb-cost"},{"t":"$30,000","ok":true,"why":"Cost 120,000 − allowances 90,000 = 30,000 still deductible."},{"t":"$50,000","why":"That is the temporary difference."},{"t":"$120,000","why":"Ignores the allowances already claimed.","pit":"tb-cost"}]},{"id":"s-int","type":"dt-balance","lo":27,"q":"A company accrues {a|interest receivable} of $5,000. The interest is taxed only when received. What deferred tax arises (17%)?","options":[{"t":"{a|DTA} of $850","why":"Asset CA > TB is taxable, so it is a {l|liability}.","pit":"wrong-direction"},{"t":"{l|DTL} of $850","ok":true,"why":"CA 5,000, tax base 0: taxable difference; × 17% = 850."},{"t":"None: interest is a permanent difference","why":"It will be taxed when received, so it is temporary.","pit":"temp-as-perm"},{"t":"{x|Current tax} of $850","why":"Not taxable until received."}]},{"id":"s-adv","type":"dt-balance","lo":27,"q":"A company received $10,000 of {l|revenue in advance}, which was taxed on receipt. It is still a {l|liability} at year end. What deferred tax arises (17%)?","options":[{"t":"{l|DTL} of $1,700","why":"A {l|liability} with CA > TB is deductible, not taxable.","pit":"wrong-direction"},{"t":"{a|DTA} of $1,700","ok":true,"why":"Tax base = 10,000 − 10,000 not taxable in future = 0. {l|CA} > TB on a {l|liability} → deductible → {a|DTA} 1,700."},{"t":"None, because the tax has already been paid","why":"That is exactly why a {a|DTA} arises: tax has been paid ahead of the accounting income."},{"t":"{a|DTA} of $10,000","why":"The difference must be multiplied by the tax rate."}]},{"id":"s-rate","type":"dt-balance","lo":28,"q":"Which rate should be used to measure deferred tax?","options":[{"t":"The current year’s rate, always","why":"Use the rate expected when the difference reverses, if enacted."},{"t":"A rate announced in the Budget speech but not yet legislated","why":"Only enacted or substantively enacted rates are used.","pit":"old-rate"},{"t":"The enacted or substantively enacted rate for the reversal period, without discounting","ok":true,"why":"That is the measurement rule, and deferred tax is never discounted."},{"t":"The enacted rate, discounted to present value","why":"Deferred tax is never discounted.","pit":"discount"}]},{"id":"s-loss","type":"loss-dta","lo":30,"q":"A company has unused tax losses of $500,000. Future taxable profit of $300,000 is probable. What {a|DTA} should it recognise (17%)?","options":[{"t":"$85,000","why":"Recognises a {a|DTA} on the full loss. Only the part covered by probable profits is recognised.","pit":"full-loss-dta"},{"t":"$51,000","ok":true,"why":"300,000 × 17% = 51,000."},{"t":"$0","why":"Some profit is probable, so a {a|DTA} is recognised to that extent."},{"t":"$34,000","why":"That is the tax on the unrecognised part."}]},{"id":"s-reassess","type":"loss-dta","lo":30,"q":"Last year a company did not recognise a {a|DTA} on its tax losses. This year it has signed long-term contracts that make future taxable profit probable. What should it do?","options":[{"t":"Nothing: the earlier decision is final","why":"{a|DTAs} are reassessed at every reporting date."},{"t":"Recognise the {a|DTA} now, to the extent profit is probable","ok":true,"why":"A previously unrecognised {a|DTA} is recognised once recovery becomes probable."},{"t":"Restate last year’s accounts as a prior-period error","why":"Last year’s judgement was right on the evidence then. This is a change in estimate."},{"t":"Recognise the {a|DTA} directly in equity","why":"It goes to P&L, because the losses arose there."}]},{"id":"s-cur","type":"current-tax","lo":28,"q":"A company paid $50,000 of tax instalments during the year, but its final {x|current tax} for the year is $42,000. How is the difference presented?","options":[{"t":"{l|Current tax liability} of $8,000","why":"It overpaid, so IRAS owes the company."},{"t":"{a|Current tax asset} of $8,000","ok":true,"why":"Tax paid exceeds the amount due, so the excess is a {a|current tax asset}."},{"t":"{a|Deferred tax asset} of $8,000","why":"Overpaid current tax is current, not deferred."},{"t":"Reduction of next year’s {x|tax expense}","why":"This year’s {x|expense} is 42,000. The overpayment is an {a|asset}."}]},{"id":"s-disc","type":"recon","lo":31,"q":"Which of these must be disclosed?","options":[{"t":"Unused tax losses for which no {a|DTA} is recognised","ok":true,"why":"Required, so users can see potential tax benefits not on the balance sheet."},{"t":"The tax computation submitted to IRAS","why":"Not required."},{"t":"The present value of deferred tax balances","why":"Deferred tax isn’t discounted.","pit":"discount"},{"t":"Forecast tax rates for the next five years","why":"Only changes in the applicable rate vs last year are disclosed."}]}]},"exam":{"cases":{"changi":{"name":"Changi Logistics","text":["Changi Logistics Pte Ltd (Changi) has a 31 December year end. On 1 January 20X1 it bought {a|plant} for $600,000. It depreciates the plant straight-line over 5 years with no residual value. Capital allowances are claimed over three years at $200,000 a year.","At 31 December 20X1 Changi recognised a {l|deferred tax liability} on the plant at 17%. In June 20X2 a cut in the tax rate to 15%, effective from 20X3, was substantively enacted. Profits for 20X2 itself are still taxed at 17%.","Accounting profit before tax for 20X2 is $900,000, after charging a $20,000 {x|fine} for a regulatory breach. There are no other differences between accounting and taxable profit."]},"peranakan":{"name":"Peranakan Properties","text":["Peranakan Properties Ltd (Peranakan) has a 31 December 20X4 year end. The tax rate is 17% and no change has been enacted. Future taxable profits are expected to be strong.","{a|Equipment}: at 1 January 20X4 its {a|carrying amount} was $600,000 and its tax base $480,000. In 20X4 {x|depreciation} was $100,000 and capital allowances claimed were $160,000.","At 31 December 20X4 Peranakan accrued {l|unpaid staff leave} of $50,000 for the first time. It is deductible for tax only when paid.","On 31 December 20X4 Peranakan revalued its {a|office building} upward by $400,000, recognised in OCI. The tax base is unchanged; assume the gain would be taxable when the building’s value is recovered.","Accounting profit before tax is $1,000,000, after charging $30,000 of non-deductible {x|entertainment}. All of Peranakan’s tax balances are with IRAS, and it has a legal right to offset them."]}},"questions":[{"id":"x1","case":"changi","lo":29,"type":"dt-balance","q":"What {l|deferred tax liability} on the plant should Changi recognise at 31 December 20X2?","options":[{"t":"$27,200","why":"Uses 17%. The 15% rate was substantively enacted before year end and applies when the difference reverses.","pit":"old-rate"},{"t":"$24,000","ok":true,"why":"{a|Carrying amount} 360,000 − tax base 200,000 = 160,000; × 15% = 24,000."},{"t":"$12,000","why":"Only the 20X2 increase in the difference × 15%. The balance covers the whole difference."},{"t":"$10,400","why":"That is the movement for the year, not the closing balance."}]},{"id":"x2","case":"changi","lo":29,"type":"tax-expense","q":"What {x|deferred tax expense} does Changi recognise in profit or loss for 20X2?","options":[{"t":"$24,000","why":"That is the {l|closing balance}. The {x|expense} is the movement from the {l|opening balance}.","pit":"closing-as-expense"},{"t":"$13,600","why":"The increase in the difference × 17%. It ignores the rate change completely.","pit":"old-rate"},{"t":"$10,400","ok":true,"why":"{l|Closing} 24,000 − {l|opening} 13,600 (= 80,000 × 17%) = 10,400. It nets a 1,600 {i|credit} from remeasuring the {l|opening balance} against 12,000 on the new difference."},{"t":"$12,000","why":"Measures the increase at 15% but leaves the {l|opening balance} at 17%. The {l|opening DTL} must be remeasured too (a 1,600 {i|credit}).","pit":"old-rate"}]},{"id":"x3","case":"changi","lo":28,"type":"tax-expense","q":"What is Changi’s {x|total tax expense} for 20X2?","options":[{"t":"$153,000","why":"Accounting profit × 17%. It ignores the fine and the rate change.","pit":"profit-x-rate"},{"t":"$142,800","why":"{x|Current tax} only. The {x|deferred tax} movement is part of {x|tax expense}."},{"t":"$153,200","ok":true,"why":"Taxable profit = 900,000 + {x|depreciation} 120,000 − allowances 200,000 + {x|fine} 20,000 = 840,000; × 17% = 142,800. Add the {x|deferred tax} movement 10,400: 153,200."},{"t":"$166,800","why":"Adds the {l|closing DTL} instead of the movement in it.","pit":"closing-as-expense"}]},{"id":"x4","case":"changi","lo":28,"type":"tax-expense","q":"Which journal entry records Changi’s tax for 20X2? (The tax is unpaid at year end.)","options":[{"je":[{"side":"Dr","account":"Current tax expense","amount":142800},{"side":"Dr","account":"Deferred tax expense","amount":24000},{"side":"Cr","account":"Current tax payable","amount":142800},{"side":"Cr","account":"Deferred tax liability","amount":24000}],"why":"Books the whole {l|closing DTL} again. The {l|opening} 13,600 is already there, so only the movement is posted.","pit":"closing-as-expense"},{"je":[{"side":"Dr","account":"Current tax expense","amount":126000},{"side":"Dr","account":"Deferred tax expense","amount":10400},{"side":"Cr","account":"Current tax payable","amount":126000},{"side":"Cr","account":"Deferred tax liability","amount":10400}],"why":"20X2 profits are still taxed at 17%. The new 15% rate only affects deferred tax, which reverses from 20X3.","pit":"rate-wrong-year"},{"je":[{"side":"Dr","account":"Current tax expense","amount":142800},{"side":"Dr","account":"Deferred tax expense","amount":10400},{"side":"Cr","account":"Current tax payable","amount":142800},{"side":"Cr","account":"Deferred tax liability","amount":10400}],"ok":true,"why":"{x|Current tax} 142,800 at 17%, plus the {l|DTL} movement 10,400 ({l|closing} 24,000 − {l|opening} 13,600)."},{"je":[{"side":"Dr","account":"Current tax expense","amount":142800},{"side":"Dr","account":"Revaluation surplus (OCI)","amount":10400},{"side":"Cr","account":"Current tax payable","amount":142800},{"side":"Cr","account":"Deferred tax liability","amount":10400}],"why":"The difference comes from {x|depreciation} vs allowances, both in P&L, so its deferred tax goes to P&L. OCI is only for items that went to OCI."}]},{"id":"x5","case":"changi","lo":31,"type":"recon","q":"Changi’s tax reconciliation starts from accounting profit × 17% ($153,000). Which reconciling items take it to the {x|tax expense}?","options":[{"t":"{x|Fine} +3,400; capital allowances in excess of {x|depreciation} −13,600","why":"The allowances difference is temporary. Deferred tax already balances it, so it is not a reconciling item.","pit":"recon-temp"},{"t":"{x|Fine} +3,400 only","why":"Gives 156,400. It misses the effect of measuring deferred tax at 15% while the reconciliation starts at 17%.","pit":"old-rate"},{"t":"{x|Fine} +3,400; effect of the rate change on the {l|opening DTL} −1,600","why":"Gives 154,800. The 20X2 increase in the difference is also measured at 15%, so the rate effect is bigger."},{"t":"{x|Fine} +3,400; effect of the rate change −3,200","ok":true,"why":"153,000 + 3,400 − 3,200 = 153,200. The rate effect is the whole closing difference 160,000 × 2%: part from remeasuring the {l|opening balance}, part from measuring this year’s increase at 15%."}]},{"id":"x6","case":"peranakan","lo":27,"type":"perm-diff","q":"What deferred tax arises on the {l|accrued staff leave} at 31 December 20X4?","options":[{"t":"{l|Deferred tax liability} of $8,500","why":"A {l|liability} carried above its tax base gives a future deduction, so it is deductible, not taxable.","pit":"wrong-direction"},{"t":"None: it is a permanent difference","why":"The leave will be deductible when paid, so the difference reverses. It is temporary.","pit":"temp-as-perm"},{"t":"None until the leave is paid","why":"Deferred tax is recognised now, while the deduction is still to come. Strong future profits make the {a|DTA} recoverable."},{"t":"{a|Deferred tax asset} of $8,500","ok":true,"why":"{l|Carrying amount} 50,000, tax base 0: a deductible difference. × 17% = 8,500, recognised because profits are probable."}]},{"id":"x7","case":"peranakan","lo":29,"type":"tax-expense","q":"What {x|net deferred tax charge} goes to profit or loss for 20X4?","options":[{"t":"$1,700","ok":true,"why":"Equipment {l|DTL} rises from 20,400 to 30,600 (+10,200). Less the new leave {a|DTA} 8,500: net 1,700. The revaluation {l|DTL} goes to OCI."},{"t":"$69,700","why":"Includes the 68,000 revaluation {l|DTL}. That goes to OCI with the revaluation.","pit":"reval-to-pl"},{"t":"$10,200","why":"Equipment only. The new {a|DTA} on the staff leave reduces the {x|P&L charge}."},{"t":"$18,700","why":"Adds the {a|DTA}. A new {a|deferred tax asset} is a credit, so it reduces the {x|charge}.","pit":"dta-sign"}]},{"id":"x8","case":"peranakan","lo":28,"type":"tax-expense","q":"What is the {x|total tax expense} in Peranakan’s profit or loss for 20X4?","options":[{"t":"$173,400","why":"{x|Current tax} only. The {x|deferred tax charge} in P&L must be added."},{"t":"$243,100","why":"Includes the revaluation {l|DTL}, which belongs in OCI.","pit":"reval-to-pl"},{"t":"$175,100","ok":true,"why":"Taxable profit = 1,000,000 + {x|depreciation} 100,000 − allowances 160,000 + {x|leave} 50,000 + {x|entertainment} 30,000 = 1,020,000; × 17% = 173,400. Plus {x|deferred tax} 1,700 = 175,100. Check: 170,000 + {x|entertainment} 5,100."},{"t":"$170,000","why":"Profit × 17%. The non-deductible {x|entertainment} adds to this.","pit":"profit-x-rate"}]},{"id":"x9","case":"peranakan","lo":28,"type":"reval-oci","q":"Which journal entry records the deferred tax on the building revaluation?","options":[{"je":[{"side":"Dr","account":"Deferred tax expense","amount":68000},{"side":"Cr","account":"Deferred tax liability","amount":68000}],"why":"Deferred tax follows the item. The revaluation went to OCI, so its tax does too.","pit":"reval-to-pl"},{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":68000},{"side":"Cr","account":"Deferred tax liability","amount":68000}],"ok":true,"why":"400,000 × 17% = 68,000, charged against the {e|surplus} in OCI. {e|Net surplus} 332,000."},{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":68000},{"side":"Cr","account":"Current tax payable","amount":68000}],"why":"The gain isn’t taxed now, only when the value is recovered. So the {l|liability} is deferred, not current."},{"je":[{"side":"Dr","account":"Deferred tax asset","amount":68000},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":68000}],"why":"An {a|asset} carried above its tax base is a taxable difference, so it gives a {l|liability}.","pit":"wrong-direction"}]},{"id":"x10","case":"peranakan","lo":31,"type":"present-offset","q":"How should Peranakan present deferred tax in its statement of financial position at 31 December 20X4?","options":[{"t":"{l|Deferred tax liability} of $98,600 and {a|deferred tax asset} of $8,500, both non-current","why":"Same tax authority and a legal right to offset: the conditions are met, so they are offset.","pit":"offset"},{"t":"Net {l|deferred tax liability} of $90,100, non-current","ok":true,"why":"Equipment 30,600 + revaluation 68,000 − leave {a|DTA} 8,500 = 90,100. Offset (same authority, legal right) and always non-current."},{"t":"Net {l|deferred tax liability} of $90,100, split between current and non-current by reversal date","why":"Deferred tax is never classified as current.","pit":"dt-current"},{"t":"{l|Deferred tax liability} of $30,600 (non-current), the revaluation {l|DTL} deducted from the {e|surplus} in equity, and a current {a|DTA} of $8,500","why":"The revaluation {l|DTL} is a liability like any other; only its movement went through OCI. And a {a|DTA} is never current.","pit":"dt-current"}]},{"id":"x11","lo":30,"type":"loss-dta","q":"Tampines Biotech has made losses in each of the last three years and has unused tax losses of $800,000. It has taxable temporary differences of $300,000 with the same tax authority that will reverse while the losses can still be used. New signed supply contracts give convincing evidence of a further $200,000 of taxable profit; beyond that, nothing is probable. What {a|deferred tax asset} should it recognise on the losses (17%)?","options":[{"t":"$136,000","why":"A {a|DTA} on the whole loss. Only the part covered by probable taxable profit is recognised.","pit":"full-loss-dta"},{"t":"$85,000","ok":true,"why":"Reversing taxable differences 300,000 + convincing contracted profit 200,000 = 500,000; × 17% = 85,000. The other 300,000 of losses is disclosed as unrecognised."},{"t":"$51,000","why":"Counts only the reversing taxable differences. The contracted profit is convincing evidence too."},{"t":"$0","why":"Recent losses are strong evidence against, but here there is convincing other evidence: reversing taxable differences and signed contracts."}]},{"id":"x12","lo":30,"type":"loss-dta","q":"Last year Sentosa Leisure recognised a {a|DTA} of $68,000 on $400,000 of unused tax losses. None has been used. This year a key customer left, and only $150,000 of future taxable profit is now probable. Which entry is needed (17%)?","options":[{"je":[{"side":"Dr","account":"Retained earnings","amount":42500},{"side":"Cr","account":"Deferred tax asset","amount":42500}],"why":"Last year’s judgement was right on the evidence then. This is a change in estimate, so it goes through this year’s P&L, not a restatement."},{"je":[{"side":"Dr","account":"Deferred tax expense","amount":68000},{"side":"Cr","account":"Deferred tax asset","amount":68000}],"why":"Writes off the whole {a|DTA}, but 150,000 of profit is still probable, so 25,500 stays."},{"je":[{"side":"Dr","account":"Deferred tax expense","amount":42500},{"side":"Cr","account":"Deferred tax asset","amount":42500}],"ok":true,"why":"{a|DTA} should now be 150,000 × 17% = 25,500. Write down 68,000 − 25,500 = 42,500 through P&L."},{"t":"No entry: the {a|DTA} was properly recognised last year and stays until the losses are used","why":"{a|DTAs} are reassessed at every reporting date. If profit is no longer probable, the {a|DTA} is written down.","pit":"full-loss-dta"}]},{"id":"x13","lo":31,"type":"recon","q":"Jurong Precision’s accounting profit is $2,000,000. It includes non-deductible {x|entertainment} of $40,000, a $15,000 {x|fine}, and $100,000 of {i|tax-exempt one-tier dividend income}. Capital allowances exceed {x|depreciation} by $80,000. The rate is 17% and future profits are probable. What {x|tax expense} does its tax reconciliation arrive at?","options":[{"t":"$340,000","why":"Profit × 17% with no reconciling items. The three permanent items all change the expense.","pit":"profit-x-rate"},{"t":"$318,750","why":"That is {x|current tax} only. The 13,600 deferred charge on the allowances brings the expense back up; the temporary difference is not a reconciling item.","pit":"recon-temp"},{"t":"$366,350","why":"Adds the {i|exempt dividends}. {i|Exempt income} reduces tax below profit × 17%, so it is deducted."},{"t":"$332,350","ok":true,"why":"340,000 + {x|entertainment} 6,800 + {x|fine} 2,550 − {i|exempt dividends} 17,000 = 332,350. Check: {x|current} 318,750 + {x|deferred} 13,600."}]},{"id":"x14","lo":31,"type":"present-offset","q":"A group has two subsidiaries. Company A (taxed by IRAS) has a {l|DTL} of $50,000 and a {a|DTA} of $20,000, with a legal right to offset. Company B (taxed in Malaysia) has a {a|DTA} of $15,000. How are these presented in the consolidated statement of financial position?","options":[{"t":"Net {l|DTL} of $15,000, non-current","why":"Company B’s {a|DTA} is with a different tax authority, so it can’t be offset against Company A’s {l|DTL}.","pit":"offset"},{"t":"{l|DTL} of $30,000 and {a|DTA} of $15,000, both non-current","ok":true,"why":"Company A offsets (same authority, legal right): 50,000 − 20,000 = 30,000. Company B’s {a|DTA} stays separate. All deferred tax is non-current."},{"t":"{l|DTL} of $50,000 and {a|DTA} of $35,000, both non-current","why":"Company A meets both conditions, so its balances are offset.","pit":"offset"},{"t":"{l|DTL} of $30,000 and {a|DTA} of $15,000, both current","why":"Deferred tax is always non-current.","pit":"dt-current"}]},{"id":"x15","lo":29,"type":"tax-expense","q":"A machine cost $90,000 and is depreciated over 3 years. All its capital allowances were claimed in year 1. At the end of year 2 its {a|carrying amount} is $30,000 and the {l|DTL} on it is $5,100 (17%). Which deferred tax entry is needed in year 3, when the machine becomes fully depreciated?","options":[{"je":[{"side":"Dr","account":"Deferred tax liability","amount":5100},{"side":"Cr","account":"Current tax payable","amount":5100}],"why":"The {l|DTL} isn’t transferred to IRAS. {x|Current tax} is computed separately (and is higher this year); the {l|DTL} release offsets that in P&L."},{"je":[{"side":"Dr","account":"Deferred tax liability","amount":5100},{"side":"Cr","account":"Deferred tax income","amount":5100}],"ok":true,"why":"{a|Carrying amount} and tax base are both 0, so the {l|closing DTL} is 0. The 5,100 is released through P&L, where it was charged."},{"je":[{"side":"Dr","account":"Deferred tax liability","amount":5100},{"side":"Cr","account":"Retained earnings","amount":5100}],"why":"The original charge went through P&L, so the release does too."},{"t":"No entry: the {l|DTL} stays until the machine is sold","why":"The difference has fully reversed (both are 0), so the {l|balance} must be 0 now."}]}]},"prepared":true},{"id":"provisions","title":"Provisions and Contingencies","subtitle":"SFRS(I) 1-37 · provisions, contingent liabilities and contingent assets","code":"B2.3","los":{"32":"Recognition and measurement of provisions","33":"Provisions, contingent liabilities and contingent assets","34":"Disclosure of provisions and contingencies"},"accounts":[{"name":"Warranty expense","el":"x"},{"name":"Provision for warranties","el":"l"},{"name":"Legal claims expense","el":"x"},{"name":"Provision for legal claims","el":"l"},{"name":"Onerous contract expense","el":"x"},{"name":"Provision for onerous contract","el":"l"},{"name":"Restructuring expense","el":"x"},{"name":"Restructuring provision","el":"l"},{"name":"Decommissioning provision","el":"l"},{"name":"Property, plant and equipment","el":"a"},{"name":"Finance cost","el":"x"},{"name":"Reimbursement receivable","el":"a"},{"name":"Cash","el":"a"},{"name":"Trade payables","el":"l"},{"name":"Accruals","el":"l"},{"name":"Retained earnings","el":"e"},{"name":"Other income","el":"i"}],"map":{"classify":{"label":"Provision, contingent liability, contingent asset or nothing","star":"Likelihood sorts it: probable → recognise, possible → disclose, remote → nothing; assets need virtual certainty"},"recognise":{"label":"Present obligation + past event + probable + estimate","star":"Legal or constructive; never for intentions or future losses; yes for onerous contracts"},"initial":{"label":"Best estimate: expected value or most likely; PV","star":"Expected value for populations, most likely outcome for one obligation; discount if material"},"subsequent":{"label":"Review each year end; unwind to {x|finance cost}"},"derecognise":{"label":"Used for its own purpose, or reversed"},"present":{"label":"Reconciliation; contingents in the notes"}},"preamble":["Welcome to provisions: the chapter about money a company *probably* owes, but can’t yet pin down. Warranties, lawsuits, clean-ups, closures, contracts gone sour. You learn when these go on the balance sheet, when they only earn a footnote, and when they get ignored.","1. First, **classify**: is it a {l|provision} (recognise), a contingent liability (disclose), a contingent asset, or nothing? Likelihood does the sorting. ★ This is the heart of the chapter.","2. Then the **four recognition tests**: present obligation (legal or constructive), past event, probable outflow, reliable estimate, plus the special cases (restructuring, onerous contracts, future losses).","3. **Measure** at the best estimate: expected value for a crowd of warranties, the most likely outcome for one lawsuit, discounted when the cash is years away.","4. **Afterwards**: review it every year end, unwind the discount as a {x|finance cost}, use it only for its own purpose, and reverse what isn’t needed.","5. **Disclose**: a reconciliation of movements, and the contingencies in the notes.","★ What is special: unlike the asset chapters, the big question isn’t *how much* but *whether at all*. And the rules are deliberately lopsided: bad news is booked at “probable”, good news waits for “virtually certain”."],"intros":{"classify|what is a provision?":"First stop: what even is a provision? Short answer: a {l|liability} with a question mark over the amount or the date. We separate it from its tidier cousins ({l|payables} and {l|accruals}) before the fun begins.","classify|provision or contingent?":"Now the main event. ★ This is what makes the chapter special: the same lawsuit can be a provision, a footnote or nothing at all, depending only on how likely the payout is. Learn the ladder (virtually certain, probable, possible, remote) and half the exam questions answer themselves.","classify|contingent assets":"We’ve sorted the bad news; now flip the coin. ★ Good news plays by stricter rules: a probable inflow only gets a note, and an {a|asset} is booked only when it is virtually certain. Lopsided on purpose.","recognise|the four tests":"We know a provision when we see one; now we test it properly. ★ Four tests, all of which must pass. The tricky one is the first: an obligation can be legal or merely “constructive”, but a plan or intention never counts.","recognise|special cases":"Armed with the four tests, we take them for a spin on the exam’s favourite special cases. ★ Future losses: never. Restructuring: only once it is planned *and* announced. The theme is always the same: could the company still walk away?","recognise|onerous contracts":"One more special case, and it is in the official practice paper. A contract that will cost more than it brings in is “onerous”, and its unavoidable loss is booked now. ★ Net loss, not gross cost, and a cheaper exit penalty caps it.","initial|best estimate":"Recognition sorted, so time to put a number on it. ★ This is the other special part: a crowd of warranties uses expected value, one lawsuit uses the most likely outcome. Pick the wrong one and you’ll land on a distractor every time.","initial|discounting":"Still measuring, but now the cash is years away. When the time value of money is material, discount it. Decommissioning adds a twist borrowed from PPE: the {l|provision’s} other side is the {a|asset}, not an {x|expense}.","initial|reimbursements":"A quick detour for insurance money. Mostly a reminder that good news needs virtual certainty, and that it sits beside the {l|provision}, never inside it.","subsequent|unwinding":"The provision is on the books; what happens next year? Mostly vanilla: the discount unwinds as a {x|finance cost}, just like interest on a loan.","subsequent|review":"And every year end, the estimate gets a fresh look. Changes go through this year’s P&L, never back into last year’s accounts.","derecognise|use or reverse":"Last lap before the notes: how a provision leaves. Spend it on what it was meant for, release what isn’t needed, and don’t raid it for anything else. No cookie jars.","present":"Final stop: showing it all. A reconciliation for each class of {l|provision}, plus the contingencies in the notes. Routine, but the remote / probable thresholds sneak back in, so stay awake."},"pitfalls":{"cl-recognised":"Recognising a contingent liability (it is only disclosed).","probable-disclosed":"Only disclosing an outflow that is probable (more likely than not): it must be recognised.","remote-disclosed":"Disclosing a remote contingent liability.","ca-recognised":"Recognising a contingent asset that is only probable (an {a|asset} needs virtual certainty).","intent-obligation":"Treating a board decision, plan or intention as a present obligation.","future-losses":"Providing for future operating losses, future repairs or self-insurance.","onerous-gross":"Providing the full cost to fulfil an onerous contract instead of the net loss, or ignoring a cheaper exit penalty.","onerous-wait":"Waiting until an onerous contract ends to recognise the loss.","ev-single":"Using expected value for a single obligation, or the most likely outcome for a large population.","no-discount":"Providing the undiscounted amount for a long-dated obligation.","unwind-opex":"Charging the unwinding of the discount to {x|operating expenses} or to the {a|asset} instead of {x|finance cost}.","decom-expense":"Expensing a {l|decommissioning provision} on day 1 instead of adding it to the {a|asset’s cost}.","reimb-net":"Netting a reimbursement against the {l|provision}, or recognising it when only probable.","restructure-costs":"Including retraining, relocation, marketing or future losses in a {l|restructuring provision}.","wrong-use":"Using a {l|provision} for expenditure it wasn’t set up for, or restating prior years for a change in estimate."},"examTypes":[{"id":"prov-vs-cl","title":"Provision, contingent liability or nothing?","pitfall":"Disclosing a probable outflow instead of recognising it, or recognising a contingent liability","see":"classify"},{"id":"contingent-asset","title":"Recognise, disclose or ignore a possible inflow?","pitfall":"Recognising a contingent asset that is only probable","see":"classify"},{"id":"obligation","title":"Is there a present obligation from a past event?","pitfall":"Treating an intention or a future legal requirement as an obligation","see":"recognise"},{"id":"special-cases","title":"Restructuring, future losses, repairs: provide or not?","pitfall":"Providing on a board decision alone, or including retraining and relocation","see":"recognise"},{"id":"onerous","title":"How should the onerous contract be accounted for?","pitfall":"Providing the full cost to fulfil instead of the net loss","see":"recognise"},{"id":"measure","title":"What is the best estimate: expected value or most likely outcome?","pitfall":"Using the most likely outcome for a large population","see":"initial"},{"id":"discount","title":"Decommissioning: initial amount and unwinding","pitfall":"Expensing on day 1, or charging the unwinding to {x|operating expenses}","see":"subsequent"},{"id":"reimburse","title":"How is an insurance reimbursement treated?","pitfall":"Netting it against the {l|provision}","see":"initial"},{"id":"use-reverse","title":"Using, reversing and remeasuring a provision","pitfall":"Using it for something else, or restating last year","see":"derecognise"},{"id":"disclose","title":"Which of these must be disclosed?","pitfall":"Disclosing remote items; not disclosing a probable contingent asset","see":"present"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":32,"title":"Provisions, the Socratic way","body":["Each idea starts with a question for you. Think it through, then reveal the answer. The rule comes after.","Account names are coloured by element. Tap **Legend** any time.","At the end there is an exam-style quiz with the two official practice-paper questions on this topic (Q6 and Q39), then a harder exam."],"id":"intro-q9tapz","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-classify","bucket":"classify","blabel":"what is a provision?","sect":1,"part":"Classify · what is a provision?"},{"id":"think-4o9x7m","type":"think","bucket":"classify","blabel":"what is a provision?","lo":32,"scenario":"At 31 December, Kallang Kitchens has three things it may have to pay: (1) an electricity bill for December, invoiced and due in January; (2) the audit fee for this year, agreed but not yet billed; (3) repairs under a one-year warranty on ovens it sold this year.","prompt":"All three are {l|liabilities}. What makes the third one different from the first two?","answer":["The first two are certain in amount and timing: the bill is a {l|Trade payables} item, and the audit fee is an {l|Accruals} item (estimated, but with very little doubt).","The warranty is different: Kallang doesn’t know **how many** ovens will break, **how much** the repairs will cost, or **when**. That uncertainty is what makes it a **{l|provision}**."],"sect":1,"part":"Classify · what is a provision?"},{"type":"rule","bucket":"classify","blabel":"what is a provision?","lo":32,"title":"What a provision is","body":["So the warranty is a {l|liability} with a question mark over it. Here is the name for that, and how it differs from its neighbours.","+ A **{l|provision}** is a {l|liability} of **uncertain timing or amount**.","- It is still a real {l|liability}: a present obligation from a past event. The uncertainty is about the number or the date, not about whether you owe something.","- **{l|Payables} and {l|accruals}** are also {l|liabilities}, but with much less uncertainty. They are not provisions.","- A **contingent liability** is the uncertain cousin: either the obligation itself is only **possible**, or it is a present obligation that fails the recognition tests. It is **disclosed**, not recognised.","- Examples of provisions: {l|Provision for warranties}, {l|Provision for legal claims}, {l|Decommissioning provision}, {l|Restructuring provision}, {l|Provision for onerous contract}."],"id":"rule-1gdt75","sect":1,"part":"Classify · what is a provision?"},{"id":"mcq-2slvu7","type":"mcq","bucket":"classify","blabel":"what is a provision?","lo":32,"q":"Which of these is a **{l|provision}** rather than a {l|trade payable} or an {l|accrual}?","options":[{"t":"A supplier invoice for raw materials received in December, due in January","why":"Amount and timing are known. This is a {l|trade payable}."},{"t":"Staff salaries for the last week of December, paid on 5 January","why":"Known amount, known date: an {l|accrual}."},{"t":"The estimated cost of repairs under warranties on goods sold this year","ok":true,"why":"There is a present obligation (the sale with a warranty), but the amount and timing are uncertain. That is a {l|provision}."},{"t":"Interest on a bank loan for December, paid on 1 January","why":"Known amount and date: an {l|accrual}."}],"sect":1,"part":"Classify · what is a provision?"},{"type":"map","id":"map-2-classify","bucket":"classify","blabel":"provision or contingent?","sect":2,"part":"Classify · provision or contingent?"},{"id":"think-1j52wx","type":"think","bucket":"classify","blabel":"provision or contingent?","lo":33,"scenario":"A customer sues Kallang Kitchens for $200,000, claiming a faulty oven started a fire in March. Imagine three versions of the lawyers’ advice at year end: (a) “you will probably lose, about 70%”; (b) “maybe 30%”; (c) “about 2%, this claim is hopeless”.","prompt":"Should Kallang put a {l|liability} on its balance sheet in each case? If not, should it say anything at all?","answer":["(a) **Probable** (more likely than not): recognise a **{l|provision}**.","(b) **Possible** but not probable: no {l|liability} on the balance sheet, but **disclose** a **contingent liability** in the notes so readers know the risk is out there.","(c) **Remote**: do nothing, not even a note. Nobody needs a footnote about a 2% long shot.","Same event, three answers. The likelihood of the outflow does the sorting."],"sect":2,"part":"Classify · provision or contingent?"},{"type":"rule","bucket":"classify","blabel":"provision or contingent?","lo":33,"title":"The likelihood ladder","body":["The lawsuit gave three different answers for one event. This ladder is the rule behind them: how likely the outflow is decides what goes in the accounts.","1. **Virtually certain**: a {l|liability} (or {l|provision}).","2. **Probable** (more likely than not, > 50%): **{l|provision}**, recognised.","3. **Possible** (not probable, not remote): **contingent liability**, disclosed.","4. **Remote**: nothing.","- A **contingent liability** is (a) a **possible** obligation whose existence will be confirmed only by uncertain future events outside the entity’s control, **or** (b) a present obligation that isn’t recognised because the outflow is not probable or (very rarely) can’t be measured reliably.","! A contingent liability is **never** recognised. It is disclosed unless the outflow is remote."],"id":"rule-j2hcbm","sect":2,"part":"Classify · provision or contingent?"},{"id":"diagram-1ng3ug","type":"diagram","bucket":"classify","blabel":"provision or contingent?","lo":33,"title":"One likelihood scale, three bands","intro":"Probable, possible and remote aren’t three separate questions. They are bands on **one** scale, the likelihood of the outflow. Two cut lines split it into three, which is why the standard’s flowchart asks two yes/no questions (“probable?” then “remote?”). Tap a box, or walk through it.","notes":{"hL":"One question underneath it all: how likely is it that cash (or other resources) will go out?","hO":"What goes in the accounts for each band.","vc":"Virtually certain: so close to certain that the doubt is negligible.","pb":"Probable: more likely than not, i.e. above 50%. Crossing this line is cut 1.","ps":"Possible: a real chance, but not more likely than not.","rm":"Remote: very unlikely. Falling below this line is cut 2.","oVc":"A certain obligation is a normal {l|liability} (or a {l|provision} if the amount or timing is uncertain).","oPb":"Recognise a {l|provision}: Dr {x|expense} (or an {a|asset}, for decommissioning), Cr {l|provision}, at the best estimate. Needs a present obligation and a reliable estimate (almost always available).","oPs":"Contingent liability: nothing in the statement of financial position, but a note describing it, with an estimate of its effect where practicable.","oRm":"Nothing: no {l|liability}, no note."},"walk":[{"nodes":["hL","vc","pb","ps","rm"],"text":"One scale: how likely is the outflow? Virtually certain, probable, possible and remote are just points along it."},{"nodes":["pb","oPb"],"text":"Cut 1, “probable?”: above 50%, recognise a {l|provision} (as long as there is a present obligation and a reliable estimate, which there almost always is)."},{"nodes":["rm","oRm"],"text":"Cut 2, “remote?”: very unlikely, do nothing. No liability, no note."},{"nodes":["ps","oPs"],"text":"Whatever is left in the middle band is possible: a contingent liability, disclosed in the notes but never recognised."},{"nodes":["ps","oPs","rm","oRm"],"text":"The only different question is whether the obligation **exists** at all. That uses the same 50% test: if it is more likely than not to exist, it is a present obligation. If not, it is only a **possible obligation**, which can at most be disclosed (or ignored if remote)."}],"caption":"{l|Provision} = present obligation + past event + probable outflow + reliable estimate. Possible: disclose. Remote: nothing.","sect":2,"part":"Classify · provision or contingent?","svg":"\u003csvg width=\"100%\" style=\"min-width:443px\" role=\"img\"\n viewBox=\"0.00 0.00 403.00 339.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 324.9)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-324.9 389,-324.9 389,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>hL\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M153.6,-310.5C153.6,-310.5 12,-310.5 12,-310.5 6,-310.5 0,-304.5 0,-298.5 0,-298.5 0,-282.9 0,-282.9 0,-276.9 6,