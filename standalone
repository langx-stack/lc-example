<script>
// Pure logic shared by the browser app and the Node build/tests.
(function (root, factory) {
  if (typeof module === 'object' && module.exports) module.exports = factory();
  else root.StudyCore = factory();
})(typeof self !== 'undefined' ? self : this, function () {
  const ELEMENTS = {
    a: 'Asset', l: 'Liability', e: 'Equity', i: 'Income', x: 'Expense', n: 'Other term',
  };

  const escapeHtml = (s) => String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  // {a|ROU asset} → coloured account, **bold**, *em*. Escapes first so content can't inject markup.
  function renderInline(text) {
    return escapeHtml(text)
      .replace(/\{([a-z])\|([^}]+)\}/g, '<span class="el el-$1">$2</span>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*]+)\*/g, '<em>$1</em>');
  }

  function parseAmount(str) {
    if (str === null || str === undefined) return null;
    let s = String(str).trim();
    if (!s) return null;
    let neg = false;
    if (/^\(.*\)$/.test(s)) { neg = true; s = s.slice(1, -1); }
    s = s.replace(/[$,\s]/g, '');
    if (s.startsWith('-')) { neg = !neg; s = s.slice(1); }
    if (!/^\d+(\.\d+)?$/.test(s)) return null;
    const n = Number(s);
    return neg ? -n : n;
  }

  const lineKey = (l) => `${l.side}|${l.account}|${Number(l.amount)}`;

  // Order-insensitive: each given line is checked off against an unused expected line.
  function gradeJE(expected, given) {
    const pool = expected.map(lineKey);
    const rows = given.filter((l) => l.account || (l.amount !== null && l.amount !== undefined && l.amount !== ''));
    const lines = rows.map((l) => {
      const i = pool.indexOf(lineKey(l));
      if (i >= 0) { pool.splice(i, 1); return { ok: true }; }
      return { ok: false };
    });
    const extra = lines.filter((l) => !l.ok).length;
    const missing = pool.length;
    return { lines, missing, extra, correct: missing === 0 && extra === 0 };
  }

  function gradeNumber(expected, given, tol = 0) {
    const n = typeof given === 'number' ? given : parseAmount(given);
    return n !== null && Math.abs(n - expected) <= tol;
  }

  const correctIndex = (q) => q.options.findIndex((o) => o.ok);

  function scoreQuiz(questions, answers) {
    const byLO = {};
    const missed = [];
    let correct = 0;
    for (const q of questions) {
      byLO[q.lo] = byLO[q.lo] || { correct: 0, total: 0 };
      byLO[q.lo].total++;
      if (answers[q.id] === correctIndex(q)) { correct++; byLO[q.lo].correct++; } else missed.push(q.id);
    }
    return { correct, total: questions.length, byLO, missed };
  }

  function collectStrings(obj, out = []) {
    if (typeof obj === 'string') out.push(obj);
    else if (Array.isArray(obj)) obj.forEach((v) => collectStrings(v, out));
    else if (obj && typeof obj === 'object') Object.values(obj).forEach((v) => collectStrings(v, out));
    return out;
  }

  function validateTopic(t) {
    const errs = [];
    const where = (kind, i) => `${kind} ${i + 1}`;
    for (const s of collectStrings(t)) {
      for (const m of s.matchAll(/\{([a-z]?)\|/g)) {
        if (!ELEMENTS[m[1]]) errs.push(`unknown element "${m[1]}" in: ${s.slice(0, 60)}`);
      }
    }
    const accountNames = new Set((t.accounts || []).map((a) => a.name));
    const oneCorrect = (opts, label) => {
      if (opts.filter((o) => o.ok).length !== 1) errs.push(`${label}: needs exactly one correct option`);
      opts.forEach((o, j) => { if (!o.why) errs.push(`${label}: option ${j + 1} has no explanation`); });
    };
    const balanced = (lines, label) => {
      const dr = lines.filter((l) => l.side === 'Dr').reduce((s, l) => s + l.amount, 0);
      const cr = lines.filter((l) => l.side === 'Cr').reduce((s, l) => s + l.amount, 0);
      if (dr !== cr) errs.push(`${label}: journal entry does not balance (Dr ${dr}, Cr ${cr})`);
    };
    (t.pages || []).forEach((p, i) => {
      const label = where(`page (${p.type})`, i);
      if (p.type === 'mcq') oneCorrect(p.options, label);
      if (p.type === 'je') {
        balanced(p.lines, label);
        p.lines.forEach((l) => { if (!accountNames.has(l.account)) errs.push(`${label}: "${l.account}" not in accounts`); });
      }
      if (p.type === 'calc' && typeof p.answer !== 'number') errs.push(`${label}: answer must be a number`);
    });
    const cases = (t.quiz && t.quiz.cases) || {};
    const ids = new Set();
    ((t.quiz && t.quiz.questions) || []).forEach((q, i) => {
      const label = `quiz question ${q.id || i + 1}`;
      if (ids.has(q.id)) errs.push(`${label}: duplicate id`);
      ids.add(q.id);
      if (q.lo === undefined) errs.push(`${label}: no LO`);
      else if (t.los && !t.los[q.lo]) errs.push(`${label}: LO ${q.lo} not in topic`);
      if (q.case && !cases[q.case]) errs.push(`${label}: unknown case "${q.case}"`);
      if (q.options.length !== 4) errs.push(`${label}: needs four options`);
      oneCorrect(q.options, label);
      q.options.forEach((o, j) => { if (o.je) balanced(o.je, `${label} option ${j + 1}`); });
    });
    return errs;
  }

  function store(storage, key) {
    return {
      load() {
        try { const raw = storage && storage.getItem(key); return raw ? JSON.parse(raw) : {}; } catch (e) { return {}; }
      },
      save(obj) {
        try { storage && storage.setItem(key, JSON.stringify(obj)); } catch (e) { /* storage unavailable: progress is not kept */ }
      },
    };
  }

  return { ELEMENTS, escapeHtml, renderInline, parseAmount, gradeJE, gradeNumber, correctIndex, scoreQuiz, validateTopic, store };
});

</script>
