ily=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Lower of the two\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"142.8\" y=\"-75.53\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">both in S$\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge1\" class=\"edge\">\n\u003ctitle>cost&#45;&gt;cmp\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M100.62,-126.64C110.09,-120.37 120.6,-113.42 130.27,-107.02\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"131.39,-109.22 135.87,-103.31 128.68,-105.13 131.39,-109.22\"/>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>nrv\u003c/title>\n\u003cpath fill=\"#e6f4f1\" stroke=\"#0f766e\" stroke-width=\"1.2\" d=\"M338.1,-168.16C338.1,-168.16 174.75,-168.16 174.75,-168.16 168.75,-168.16 162.75,-162.16 162.75,-156.16 162.75,-156.16 162.75,-139.08 162.75,-139.08 162.75,-133.08 168.75,-127.08 174.75,-127.08 174.75,-127.08 338.1,-127.08 338.1,-127.08 344.1,-127.08 350.1,-133.08 350.1,-139.08 350.1,-139.08 350.1,-156.16 350.1,-156.16 350.1,-162.16 344.1,-168.16 338.1,-168.16\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"244.8\" y=\"-153.67\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">NRV\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"173.55\" y=\"-144.57\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">US$48,000 × 1.38 (date NRV measured)\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"233.18\" y=\"-133.67\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">S$66,240\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>nrv&#45;&gt;cmp\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M226.23,-126.64C216.76,-120.37 206.25,-113.42 196.58,-107.02\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"198.17,-105.13 190.98,-103.31 195.46,-109.22 198.17,-105.13\"/>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>ca\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"2\" d=\"M142.48,-38.54C142.48,-38.54 56.37,-38.54 56.37,-38.54 50.38,-38.54 44.38,-32.54 44.38,-26.54 44.38,-26.54 44.38,-14.54 44.38,-14.54 44.38,-8.54 50.38,-2.54 56.38,-2.54 56.38,-2.54 142.48,-2.54 142.48,-2.54 148.48,-2.54 154.48,-8.54 154.48,-14.54 154.48,-14.54 154.48,-26.54 154.48,-26.54 154.48,-32.54 148.48,-38.54 142.48,-38.54\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"55.18\" y=\"-22.09\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Carrying amount\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"76.18\" y=\"-11.09\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">S$66,240\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>cmp&#45;&gt;ca\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M145.26,-65.61C138.56,-59.17 130.86,-51.77 123.71,-44.89\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"125.7,-43.4 118.95,-40.32 122.3,-46.93 125.7,-43.4\"/>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>wd\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M266.35,-41.08C266.35,-41.08 188.5,-41.08 188.5,-41.08 182.5,-41.08 176.5,-35.08 176.5,-29.08 176.5,-29.08 176.5,-12 176.5,-12 176.5,-6 182.5,0 188.5,0 188.5,0 266.35,0 266.35,0 272.35,0 278.35,-6 278.35,-12 278.35,-12 278.35,-29.08 278.35,-29.08 278.35,-35.08 272.35,-41.08 266.35,-41.08\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"197.43\" y=\"-26.59\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Write&#45;down\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"194.05\" y=\"-17.49\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">67,500 − 66,240\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"187.3\" y=\"-6.59\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">S$1,260 → P&amp;L\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>cmp&#45;&gt;wd\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M181.59,-65.61C187.59,-59.84 194.39,-53.3 200.89,-47.06\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"202.29,-49.11 205.64,-42.49 198.89,-45.58 202.29,-49.11\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"id":"calc-1frseb","type":"calc","bucket":"yearend","lo":56,"unit":"$","q":"Orchid Trading (functional currency S$) holds {a|kitchenware} in inventory, bought for US$30,000 when US$1 = S$1.40. At the year end its NRV is US$31,000 and US$1 = S$1.33. What {x|write-down}, if any, is needed (in S$)?","answer":770,"working":["{a|Cost} at the historical rate: US$30,000 × 1.40 = S$42,000.","NRV at the rate on the date NRV is measured: US$31,000 × 1.33 = S$41,230.","NRV is lower, so write down **S$770** to profit or loss, even though NRV is *higher* in US$. The weaker dollar did it.","Comparing {a|cost} at the closing rate (S$39,900) or NRV at the historical rate (S$43,400) would get the wrong answer."],"sect":3,"part":"Year end: monetary or not?"},{"id":"mcq-1un9l0","type":"mcq","bucket":"yearend","lo":56,"q":"On 1 January 20X2 Orchid Trading (functional currency S$) buys a {a|forklift} for US$36,000 cash when US$1 = S$1.35. Cost model, useful life 6 years, straight-line, no residual value. At 31 December 20X2, US$1 = S$1.30. What is the forklift’s {a|carrying amount} at 31 December 20X2?","options":[{"t":"S$48,600","why":"That is the {a|cost} before {x|depreciation}."},{"t":"S$40,500","ok":true,"why":"{a|Cost} 48,600 at the historical rate, less one year’s {x|depreciation} of 8,100. Non-monetary items at cost are not retranslated."},{"t":"S$39,000","why":"This retranslates the {a|forklift} at the closing rate. {a|PPE} at cost stays at the historical rate."},{"t":"S$46,800","why":"The {a|cost} at the closing rate, with no {x|depreciation}. Wrong on both counts."}],"sect":3,"part":"Year end: monetary or not?"},{"type":"map","id":"map-4-settle","bucket":"settle","sect":4,"part":"Settlement differences"},{"id":"think-1g03ll","type":"think","bucket":"settle","lo":56,"scenario":"On 1 March Orchid Trading (functional currency S$) bought goods from a US supplier for US$10,000 on credit, recorded at US$1 = S$1.36, so the {a|inventory} and the {l|payable} are both S$13,600. On 30 April Orchid pays the US$10,000 when US$1 = S$1.34.","prompt":"How many S$ leave the bank? Is the difference good news or bad news, and does the {a|inventory} change?","answer":["{a|Cash paid} = US$10,000 × 1.34 = S$13,400. The {l|payable} says 13,600, so Orchid settled it for **200 less**.","Good news: the S$ **strengthened** (fewer S$ per US$), so the debt got cheaper. A {i|Foreign exchange gain} of 200 in profit or loss.","The {a|inventory} stays at S$13,600. The {i|gain} belongs to the {l|payable} (monetary), never to the goods."],"sect":4,"part":"Settlement differences"},{"type":"rule","bucket":"settle","lo":56,"title":"Exchange differences on settlement","body":["Orchid just paid fewer S$ than its {l|payable} said. That gap has to land somewhere, and the goods bought don’t absorb it. This rule says where it goes, and how to tell a {i|gain} from a {x|loss}.","> Exchange difference = S$ {a|cash} paid or received − S$ carrying amount of the monetary item","- It goes to **profit or loss**, whether the item is settled in the same period or retranslated at a year end first.","- The {a|asset}, {x|expense} or {i|revenue} recorded on day 1 is **not** adjusted.","- Settled in the same period: one difference, on settlement. Across a year end: one at the year end, and another on settlement.","+ **Owe foreign currency + S$ weakens = {x|loss}. Owed foreign currency + S$ weakens = {i|gain}.** Then check the sign with the numbers.","! Paying within the credit term doesn’t make the difference go away. If the rate moved, there is a {i|gain} or {x|loss}."],"id":"rule-1cst1s","sect":4,"part":"Settlement differences"},{"type":"visual","bucket":"settle","lo":56,"title":"Owe it or owed it: mirror images","html":"\u003cp>Same rates, opposite sides. Left: Orchid \u003cstrong>owes\u003c/strong> US$20,000 (a \u003cspan class=\"el el-l\">payable\u003c/span>). Right: Orchid is \u003cstrong>owed\u003c/strong> US$20,000 (a \u003cspan class=\"el el-a\">receivable\u003c/span>). Both arise at 1.35, meet a 1.38 year end, and settle at 1.37. Watch the same rate move give a \u003cspan class=\"el el-x\">loss\u003c/span> on one side and a \u003cspan class=\"el el-i\">gain\u003c/span> on the other.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"fx-mirror\" data-cfg=\"{&quot;target&quot;:{&quot;v&quot;:27000,&quot;label&quot;:&quot;day-1 amount 27,000&quot;},&quot;panels&quot;:[{&quot;title&quot;:&quot;Trade payable&quot;,&quot;sub&quot;:&quot;Orchid owes US$&quot;,&quot;el&quot;:&quot;l&quot;,&quot;bal&quot;:&quot;Payable (S$)&quot;,&quot;start&quot;:27000,&quot;startCap&quot;:&quot;1 Dec 20X1: US$20,000 × 1.35 = {l|S$27,000}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;31 Dec X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;exchange loss&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:600,&quot;cap&quot;:&quot;S$ weakens to 1.38: the {l|payable} rises to {l|27,600}, so Orchid must find more S$: a {x|loss} of 600.&quot;}]},{&quot;label&quot;:&quot;20 Jan X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;exchange gain&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:-200,&quot;cap&quot;:&quot;Settled at 1.37: {a|cash} 27,400. The {l|payable} drops by 200: a {i|gain}.&quot;}]}]},{&quot;title&quot;:&quot;Trade receivable&quot;,&quot;sub&quot;:&quot;Orchid is owed US$&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Receivable (S$)&quot;,&quot;start&quot;:27000,&quot;startCap&quot;:&quot;1 Dec 20X1: US$20,000 × 1.35 = {a|S$27,000}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;31 Dec X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;exchange gain&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:600,&quot;cap&quot;:&quot;S$ weakens to 1.38: the {a|receivable} rises to {a|27,600}, so the US$ will buy more S$: a {i|gain} of 600.&quot;}]},{&quot;label&quot;:&quot;20 Jan X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;exchange loss&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-200,&quot;cap&quot;:&quot;Settled at 1.37: {a|cash} 27,400. The {a|receivable} drops by 200: a {x|loss}.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Two balances, one rate path. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;The balance moves the same way on both sides; whether it is good or bad news depends on whether you owe it or are owed it.&quot;],&quot;end&quot;:&quot;**Owe foreign currency + S$ weakens = {x|loss}. Owed + S$ weakens = {i|gain}.** Net over both years: a {x|loss} of 400 on the {l|payable}, a {i|gain} of 400 on the {a|receivable}. All of it in P&amp;L.&quot;}}\">\u003c/div>","id":"visual-1oslip","sect":4,"part":"Settlement differences"},{"id":"je-19wm3y","type":"je","bucket":"settle","lo":56,"q":"On 1 March Orchid Trading (functional currency S$) bought goods for US$10,000 on credit when US$1 = S$1.36, so the {l|payable} stands at S$13,600. On 30 April it pays the US$10,000, when US$1 = S$1.34. Record the payment.","accounts":["Inventory","Trade payable","Cash","Foreign exchange gain","Foreign exchange loss","Revaluation surplus (OCI)","Cost of sales","Loan payable"],"lines":[{"side":"Dr","account":"Trade payable","amount":13600},{"side":"Cr","account":"Cash","amount":13400},{"side":"Cr","account":"Foreign exchange gain","amount":200}],"why":"Clear the {l|payable} at its {l|carrying amount} 13,600; {a|cash} is 13,400; the 200 balance is a {i|gain} in P&L. The {a|inventory} is untouched.","sect":4,"part":"Settlement differences"},{"id":"mcq-1i9ofs","type":"mcq","bucket":"settle","lo":56,"q":"Orchid Trading (functional currency S$) sells goods to a US customer for US$8,000 on credit when US$1 = S$1.34, and collects it a month later when US$1 = S$1.37. How is the effect of the rate change recognised?","options":[{"t":"{x|Foreign exchange loss} of S$240 in profit or loss","why":"Wrong direction. Orchid is owed US$, and the S$ weakened, so the US$ it receives buy more S$."},{"t":"Increase {i|revenue} by S$240","why":"{i|Revenue} stays at the transaction-date amount. The difference belongs to the {a|receivable}."},{"t":"{i|Foreign exchange gain} of S$240 in OCI","why":"Exchange differences on monetary items go to profit or loss, not OCI."},{"t":"{i|Foreign exchange gain} of S$240 in profit or loss","ok":true,"why":"{a|Receivable} S$10,720; {a|cash received} US$8,000 × 1.37 = S$10,960. Owed foreign currency + S$ weakens = {i|gain}."}],"sect":4,"part":"Settlement differences"},{"type":"diagram","bucket":"settle","lo":56,"title":"A payable across a year end: the chart","intro":"The chart from your notes: the {l|payable} moves twice; the {a|inventory} never moves.","notes":{"a":"US$20,000 × 1.35 = S$27,000. Dr {a|Inventory}, Cr {l|Trade payable}.","b":"Closing rate 1.38: {l|payable} = S$27,600. The S$ weakened, so the debt grew: {x|Foreign exchange loss} 600.","c":"Paid at 1.37: {a|cash} S$27,400 against a {l|payable} of S$27,600: {i|Foreign exchange gain} 200.","inv":"Non-monetary, at cost: it stays at the transaction-date amount whatever the rate does."},"walk":[{"nodes":["a"],"text":"1 Dec: record {a|inventory} and {l|payable} at S$27,000."},{"nodes":["b"],"text":"31 Dec: the {l|payable} is monetary, so it moves to the closing rate. {x|Loss} of 600 in 20X1."},{"nodes":["c"],"text":"20 Jan: pay. {i|Gain} of 200 in 20X2. Net over both years: a {x|loss} of 400."},{"nodes":["inv"],"text":"All the while, the {a|inventory} sits at its historical S$ amount."}],"id":"diagram-bgckzu","sect":4,"part":"Settlement differences","svg":"\u003csvg width=\"100%\" style=\"min-width:640px\" role=\"img\"\n viewBox=\"0.00 0.00 583.00 135.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 120.44)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-120.44 568.4,-120.44 568.4,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>a\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M124.8,-75.04C124.8,-75.04 12,-75.04 12,-75.04 6,-75.04 0,-69.04 0,-63.04 0,-63.04 0,-34.96 0,-34.96 0,-28.96 6,-22.96 12,-22.96 12,-22.96 124.8,-22.96 124.8,-22.96 130.8,-22.96 136.8,-28.96 136.8,-34.96 136.8,-34.96 136.8,-63.04 136.8,-63.04 136.8,-69.04 130.8,-75.04 124.8,-75.04\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"25.65\" y=\"-61.02\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.50\" fill=\"#111827\">1 Dec 20X1 · Buy\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"23.02\" y=\"-50.52\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.50\" fill=\"#111827\">US$20,000 @ 1.35\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"21.15\" y=\"-40.02\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.50\" fill=\"#111827\">Inventory &amp; payable\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"45.52\" y=\"-29.52\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.50\" fill=\"#111827\">S$27,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node2\" class=\"node\">\n\u003ctitle>b\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M333.4,-106.04C333.4,-106.04 220.6,-106.04 220.6,-106.04 214.6,-106.04 208.6,-100.04 208.6,-94.04 208.6,-94.04 208.6,-65.96 208.6,-65.96 208.6,-59.96 214.6,-53.96 220.6,-53.96 220.6,-53.96 333.4,-53.96 333.4,-53.96 339.4,-53.96 345.4,-59.96 345.4,-65.96 345.4,-65.96 345.4,-94.04 345.4,-94.04 345.4,-100.04 339.4,-106.04 333.4,-106.04\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"219.25\" y=\"-92.03\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.50\" fill=\"#111827\">31 Dec 20X1 · Year end\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"221.12\" y=\"-81.53\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.50\" fill=\"#111827\">Payable @ closing 1.38\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"249.62\" y=\"-71.03\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.50\" fill=\"#111827\">= \u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"258.62\" y=\"-71.03\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.50\" fill=\"#111827\">S$27,600\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"230.88\" y=\"-60.53\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.50\" fill=\"#be123c\">FX loss 600 → P&amp;L\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge1\" class=\"edge\">\n\u003ctitle>a&#45;&gt;b\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M137.33,-59.19C157.28,-62.19 179.24,-65.48 199.67,-68.55\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"199.24,-70.96 206.53,-69.58 199.97,-66.11 199.24,-70.96\"/>\n\u003c/g>\n\n\u003cg id=\"node4\" class=\"node\">\n\u003ctitle>inv\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" d=\"M380.2,-36C380.2,-36 173.8,-36 173.8,-36 167.8,-36 161.8,-30 161.8,-24 161.8,-24 161.8,-12 161.8,-12 161.8,-6 167.8,0 173.8,0 173.8,0 380.2,0 380.2,0 386.2,0 392.2,-6 392.2,-12 392.2,-12 392.2,-24 392.2,-24 392.2,-30 386.2,-36 380.2,-36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"206.5\" y=\"-18.77\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.50\" fill=\"#111827\">Inventory stays at S$27,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"184.75\" y=\"-9.7\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">non&#45;monetary: historical rate, no retranslation\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>a&#45;&gt;inv\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M137.33,-38.81C145.1,-37.64 153.16,-36.43 161.32,-35.21\"/>\n\u003c/g>\n\n\u003cg id=\"node3\" class=\"node\">\n\u003ctitle>c\u003c/title>\n\u003cpath fill=\"#dcfce7\" stroke=\"#166534\" stroke-width=\"1.2\" d=\"M542,-106.04C542,-106.04 429.2,-106.04 429.2,-106.04 423.2,-106.04 417.2,-100.04 417.2,-94.04 417.2,-94.04 417.2,-65.96 417.2,-65.96 417.2,-59.96 423.2,-53.96 429.2,-53.96 429.2,-53.96 542,-53.96 542,-53.96 548,-53.96 554,-59.96 554,-65.96 554,-65.96 554,-94.04 554,-94.04 554,-100.04 548,-106.04 542,-106.04\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"440.98\" y=\"-92.03\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.50\" fill=\"#111827\">20 Jan 20X2 · Pay\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"440.23\" y=\"-81.53\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.50\" fill=\"#111827\">US$20,000 @ 1.37\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"458.23\" y=\"-71.03\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.50\" fill=\"#111827\">= \u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"467.23\" y=\"-71.03\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"10.50\" fill=\"#111827\">S$27,400\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"438.73\" y=\"-60.53\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.50\" fill=\"#166534\">FX gain 200 → P&amp;L\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge2\" class=\"edge\">\n\u003ctitle>b&#45;&gt;c\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M345.93,-80C365.88,-80 387.84,-80 408.27,-80\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"408.11,-82.45 415.11,-80 408.11,-77.55 408.11,-82.45\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"settle","lo":56,"title":"The payable moves, the inventory doesn’t","html":"\u003cp>One purchase, two balances. Orchid buys goods for US$20,000 on credit at 1.35; the rate is 1.38 at the year end and 1.37 on the day it pays. Step through and watch which balance follows the rate.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"fx-pay-inv\" data-cfg=\"{&quot;target&quot;:{&quot;v&quot;:27000,&quot;label&quot;:&quot;day-1 amount 27,000&quot;},&quot;panels&quot;:[{&quot;title&quot;:&quot;Trade payable&quot;,&quot;sub&quot;:&quot;monetary · follows the rate&quot;,&quot;el&quot;:&quot;l&quot;,&quot;bal&quot;:&quot;Payable (S$)&quot;,&quot;start&quot;:27000,&quot;startCap&quot;:&quot;1 Dec 20X1: US$20,000 × 1.35 = {l|S$27,000}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;31 Dec X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;exchange difference&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:600,&quot;cap&quot;:&quot;Closing rate 1.38: US$20,000 × 1.38 = {l|27,600}. Up 600: a {x|loss} in 20X1.&quot;}]},{&quot;label&quot;:&quot;20 Jan X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;exchange difference&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:-200,&quot;cap&quot;:&quot;Paid at 1.37: {a|cash} US$20,000 × 1.37 = {a|27,400}, 200 below the {l|payable}: a {i|gain} in 20X2. The {l|payable} now equals the {a|cash} paid, which clears it.&quot;}]}]},{&quot;title&quot;:&quot;Inventory&quot;,&quot;sub&quot;:&quot;non-monetary at cost · frozen&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Inventory (S$)&quot;,&quot;start&quot;:27000,&quot;startCap&quot;:&quot;Same day, same rate: {a|S$27,000}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;31 Dec X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;exchange difference&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:0,&quot;cap&quot;:&quot;Non-monetary at cost: stays at the historical rate. {a|27,000}, no entry.&quot;}]},{&quot;label&quot;:&quot;20 Jan X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;exchange difference&quot;,&quot;el&quot;:&quot;a&quot;,&quot;v&quot;:0,&quot;cap&quot;:&quot;Paying the supplier doesn’t touch the goods. Still {a|27,000}.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Both start at the same S$ amount. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Each date: the monetary {l|payable} moves to the new rate, and the gap goes to P&amp;L. The {a|inventory} doesn’t move.&quot;],&quot;end&quot;:&quot;**Only the monetary item moves.** The {l|payable} went 27,000 → 27,600 → paid at 27,400: a {x|net loss} of 400 (600 {x|loss} in 20X1, 200 {i|gain} in 20X2). The {a|inventory} sat at 27,000 throughout.&quot;}}\">\u003c/div>","id":"visual-1vk2lx","sect":4,"part":"Settlement differences"},{"id":"worked-gxxpf0","type":"worked","bucket":"settle","lo":56,"title":"Worked: a payable across the year end","q":"Orchid Trading (functional currency S$, year end 31 December) buys inventory for US$20,000 on credit on 1 Dec 20X1, when US$1 = S$1.35. At 31 Dec 20X1, US$1 = S$1.38. Orchid pays on 20 Jan 20X2, when US$1 = S$1.37. Record all three dates.","intro":["A typical exam question: a purchase on credit in foreign currency, a year end before it is paid, and three rates to juggle. Remember two things:","- The {l|payable} is **monetary**: it moves to the closing rate at the year end, then to the spot rate on the day it is paid. Each move is an exchange difference in P&L.","- The {a|inventory} is **non-monetary at cost**: it stays at its day-1 amount, whatever the rate does.","Then follow these steps: record at spot → retranslate the payable → leave the inventory → settle → check."],"steps":[{"h":"Record the purchase at the spot rate.","t":"1 Dec 20X1: US$20,000 × 1.35 = **{l|S$27,000}**, on both sides.","je":[{"side":"Dr","account":"Inventory","amount":27000},{"side":"Cr","account":"Trade payable","amount":27000}]},{"h":"Retranslate the payable at the closing rate.","t":["31 Dec 20X1: {l|payable} = US$20,000 × 1.38 = **{l|S$27,600}**.","It went up by 600: the S$ weakened, so the debt costs more. {x|Foreign exchange loss} in 20X1 P&L."],"je":[{"side":"Dr","account":"Foreign exchange loss","amount":600},{"side":"Cr","account":"Trade payable","amount":600}]},{"h":"Leave the inventory alone.","t":"The {a|inventory} is non-monetary at cost: it stays at **{a|S$27,000}** at 31 Dec 20X1. No entry."},{"h":"Settle: compare the cash paid with the payable.","t":["20 Jan 20X2: {a|cash paid} = US$20,000 × 1.37 = **{a|S$27,400}**.","Against a {l|payable} of {l|S$27,600}, that is 200 less: a {i|Foreign exchange gain} in 20X2 P&L."],"je":[{"side":"Dr","account":"Trade payable","amount":27600},{"side":"Cr","account":"Cash","amount":27400},{"side":"Cr","account":"Foreign exchange gain","amount":200}]},{"h":"Check the net effect.","t":"Over both years: {a|cash paid} S$27,400 for goods recorded at {a|S$27,000}: a {x|net loss} of 400 (600 {x|loss} − 200 {i|gain}), split across two years."}],"sect":4,"part":"Settlement differences"},{"id":"je-19z652","type":"je","bucket":"settle","lo":56,"q":"Your turn, with help. On 1 Nov 20X2 Orchid Trading (functional currency S$, year end 31 December) buys goods for US$40,000 on credit (US$1 = S$1.32). At 31 Dec 20X2, US$1 = S$1.35, and the payable was retranslated then. Orchid pays on 31 Jan 20X3 when US$1 = S$1.31. The payable line is filled in. Complete the 31 Jan 20X3 entry.","accounts":["Inventory","Trade payable","Cash","Foreign exchange gain","Foreign exchange loss","Revaluation surplus (OCI)","Cost of sales","Loan payable"],"given":[0],"lines":[{"side":"Dr","account":"Trade payable","amount":54000},{"side":"Cr","account":"Cash","amount":52400},{"side":"Cr","account":"Foreign exchange gain","amount":1600}],"why":"The {l|payable} was 52,800 on day 1, and was retranslated to US$40,000 × 1.35 = 54,000 at the year end (a 1,200 {x|loss} in 20X2). {a|Cash} = US$40,000 × 1.31 = 52,400. {i|Gain} = 54,000 − 52,400 = 1,600.","sect":4,"part":"Settlement differences"},{"id":"je-eh6d0s","type":"je","bucket":"settle","lo":56,"q":"On your own. On 15 Dec 20X3 Orchid Trading (functional currency S$) buys goods for US$25,000 on credit (US$1 = S$1.36). At its 31 Dec 20X3 year end, US$1 = S$1.33. It pays on 15 Feb 20X4 when US$1 = S$1.38. Record the 15 Feb 20X4 payment.","accounts":["Inventory","Trade payable","Cash","Foreign exchange gain","Foreign exchange loss","Revaluation surplus (OCI)","Cost of sales","Loan payable"],"lines":[{"side":"Dr","account":"Trade payable","amount":33250},{"side":"Dr","account":"Foreign exchange loss","amount":1250},{"side":"Cr","account":"Cash","amount":34500}],"why":"{l|Payable} on day 1: 34,000. {l|Year-end payable}: US$25,000 × 1.33 = 33,250 (a 750 {i|gain} in 20X3). {a|Cash} paid: US$25,000 × 1.38 = 34,500, so a {x|loss} of 34,500 − 33,250 = 1,250 in 20X4. Net over both years: a 500 {x|net loss}.","alt":"Clearing the {l|day-1 payable} of 34,000 instead would ignore the year-end retranslation: the 750 {i|gain} already sits in 20X3, so only 1,250 belongs to 20X4.","sect":4,"part":"Settlement differences"},{"type":"map","id":"map-5-where","bucket":"where","sect":5,"part":"Where differences go"},{"id":"think-1g2in2","type":"think","bucket":"where","lo":56,"scenario":"Orchid Trading (functional currency S$) owns {a|freehold land} in Johor, bought for RM2,000,000 when RM1 = S$0.30, and uses the revaluation model. At the year end the land is valued at RM2,200,000 and RM1 = S$0.31.","prompt":"Part of the increase is the land going up in ringgit; part is the ringgit going up against the S$. Do the two parts go to different places?","answer":["No. The {a|land} is non-monetary at fair value, so translate the valuation at the rate on the valuation date: RM2,200,000 × 0.31 = S$682,000.","The whole increase, 682,000 − 600,000 = **S$82,000**, goes to {e|Revaluation surplus (OCI)}, FX part and all. The FX part follows the {i|revaluation gain}."],"sect":5,"part":"Where differences go"},{"type":"rule","bucket":"where","lo":56,"title":"Where exchange differences go","body":["So far every exchange difference went to P&L, because every one was on a monetary item. The Johor land is the exception: when a non-monetary item is carried at fair value, its FX part follows the item’s own gain.","1. **Monetary items** (settlement or retranslation) → **profit or loss**.","2. **Non-monetary items at fair value** → wherever the item’s **own** gain or loss goes:","- revaluation of {a|PPE} in OCI → the FX part in **OCI**","- {a|investment property} (FV model) or {a|shares} at FVTPL, gains in P&L → the FX part in **P&L**","3. **Non-monetary items at cost** → no exchange difference at all.","! The classic exam slip: putting an exchange difference on a {l|payable} or {a|receivable} in OCI. Monetary means P&L, always."],"id":"rule-1hwycl","sect":5,"part":"Where differences go"},{"type":"visual","bucket":"where","lo":56,"title":"The Johor land, in layers","html":"\u003cp>The revalued \u003cspan class=\"el el-a\">land\u003c/span> has three layers. The bottom one is the \u003cspan class=\"el el-a\">old carrying amount\u003c/span> at the old rate. On top sits the \u003cstrong>ringgit gain\u003c/strong>: the land went up RM200,000, translated at today’s rate. The last sliver is the \u003cstrong>FX part\u003c/strong>: the original RM2,000,000 is now worth more S$ because the ringgit strengthened. Both top layers go to the \u003cspan class=\"el el-e\">revaluation surplus\u003c/span> in OCI, because that is where the land’s own gain goes.\u003c/p>\u003cdiv class=\"cbars\">\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">Before: RM2,000,000 × 0.30 = \u003cspan class=\"el el-a\">S$600,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg a\" style=\"width:87.98%\">\u003c/span>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-year\">\u003cdiv class=\"cb-cap\">After: RM2,200,000 × 0.31 = \u003cspan class=\"el el-a\">S$682,000\u003c/span>\u003c/div>\u003cdiv class=\"cb-track\">\u003cspan class=\"seg a\" style=\"width:87.98%\">\u003c/span>\u003cspan class=\"seg e\" style=\"width:9.09%\">\u003c/span>\u003cspan class=\"seg n\" style=\"width:2.93%\">\u003c/span>\u003c/div>\u003c/div>\n    \u003cdiv class=\"cb-key\">\u003cspan>\u003ci class=\"seg a\">\u003c/i>\u003cspan class=\"el el-a\">old carrying amount\u003c/span> 600,000\u003c/span>\u003cspan>\u003ci class=\"seg e\">\u003c/i>ringgit gain RM200,000 × 0.31 = \u003cspan class=\"el el-e\">62,000\u003c/span>\u003c/span>\u003cspan>\u003ci class=\"seg n\">\u003c/i>FX part 2,000,000 × (0.31 − 0.30) = \u003cspan class=\"el el-n\">20,000\u003c/span>\u003c/span>\u003c/div>\n  \u003c/div>\n  \u003cp class=\"cap\">Increase 62,000 + 20,000 = \u003cstrong>\u003cspan class=\"el el-e\">S$82,000\u003c/span>\u003c/strong>, all credited to \u003cspan class=\"el el-e\">Revaluation surplus (OCI)\u003c/span>. No split is needed in the entry.\u003c/p>","id":"visual-etg6fr","sect":5,"part":"Where differences go"},{"type":"diagram","bucket":"where","lo":56,"title":"Where does the exchange difference go?","intro":"Five sources, three destinations. The rule of thumb: monetary → P&L; non-monetary → wherever its own gain goes.","notes":{"set":"{a|Cash} paid or received vs the S$ carrying amount. Always P&L, even if paid within the credit term.","ret":"{l|Payables}, {a|receivables}, {l|loans}, foreign {a|cash} and {l|accrued interest} moved to the closing rate. Always P&L.","fvp":"The {i|fair value gain} goes to P&L, so the FX part rides along to P&L.","fvo":"A {e|revaluation surplus} goes to OCI, so the FX part of the revaluation goes to OCI too.","cst":"Never retranslated, so no exchange difference arises. (An LCNRV {x|write-down} is a separate test.)","pl":"Most exchange differences in a single entity land here.","oci":"Only when the item’s own gain is in OCI.","none":"Nothing to book."},"walk":[{"nodes":["set","ret","pl"],"text":"Monetary items: every exchange difference, on settlement or at the year end, goes to profit or loss."},{"nodes":["fvp","pl"],"text":"Non-monetary at fair value with gains in P&L: the FX part goes to P&L too."},{"nodes":["fvo","oci"],"text":"Non-monetary at fair value with gains in OCI: the FX part goes to OCI."},{"nodes":["cst","none"],"text":"Non-monetary at cost: nothing moves, so there is nothing to book."}],"id":"diagram-9ooy62","sect":5,"part":"Where differences go","svg":"\u003csvg width=\"100%\" style=\"min-width:424px\" role=\"img\"\n viewBox=\"0.00 0.00 385.00 268.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(14.4 253.94)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-14.4,14.4 -14.4,-253.94 370.85,-253.94 370.85,14.4 -14.4,14.4\"/>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>set\u003c/title>\n\u003cpath fill=\"#ffe4e6\" stroke=\"#be123c\" stroke-width=\"1.2\" d=\"M149.1,-139.54C149.1,-139.54 12,-139.54 12,-139.54 6,-139.54 0,-133.54 0,-127.54 0,-127.54 0,-115.54 0,-115.54 0,-109.54 6,-103.54 12,-103.54 12,-103.54 149.1,-103.54 149.1,-103.54 155.1,-103.54 161.1,-109.54 161.1,-115.54 161.1,-115.54 161.1,-127.54 161.1,-127.54 161.1,-133.54 155.1,-139.54 149.1,-139.54\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"35.55\" y=\"-122.09\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Monetary, settled\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"10.8\" y=\"-112.99\" fon