-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Retained earnings\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"431.36\" y=\"-52.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">end 20X2: correct\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>p1&#45;&gt;re\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M383.76,-81.51C392.31,-79.64 401.33,-77.67 410.21,-75.73\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"410.41,-77.84 415.83,-74.51 409.52,-73.73 410.41,-77.84\"/>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>c2\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M239.56,-52C239.56,-52 185.53,-52 185.53,-52 179.53,-52 173.53,-46 173.53,-40 173.53,-40 173.53,-28 173.53,-28 173.53,-22 179.53,-16 185.53,-16 185.53,-16 239.56,-16 239.56,-16 245.56,-16 251.56,-22 251.56,-28 251.56,-28 251.56,-40 251.56,-40 251.56,-46 245.56,-52 239.56,-52\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"182.17\" y=\"-35.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">20X2 COGS\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"187.42\" y=\"-24.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">overstated\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>o2&#45;&gt;c2\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M143.13,-26.14C150.89,-27.03 158.63,-27.92 165.97,-28.76\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"165.45,-30.82 171.65,-29.42 165.93,-26.65 165.45,-30.82\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>p2\u003c/title>\n\u003cpath fill=\"#ffe4e6\" stroke=\"#be123c\" stroke-width=\"1.2\" d=\"M374.84,-52C374.84,-52 294.56,-52 294.56,-52 288.56,-52 282.56,-46 282.56,-40 282.56,-40 282.56,-28 282.56,-28 282.56,-22 288.56,-16 294.56,-16 294.56,-16 374.84,-16 374.84,-16 380.84,-16 386.84,-22 386.84,-28 386.84,-28 386.84,-40 386.84,-40 386.84,-46 380.84,-52 374.84,-52\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"306.2\" y=\"-35.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">20X2 profit\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"291.2\" y=\"-24.55\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">understated 5,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>c2&#45;&gt;p2\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M251.89,-34C259.25,-34 267.12,-34 274.95,-34\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"274.61,-36.1 280.61,-34 274.61,-31.9 274.61,-36.1\"/>\n\u003c/g>\n\n\u003cg id=\"edge7\" class=\"edge\">\n\u003ctitle>p2&#45;&gt;re\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M387.26,-44.51C394.83,-46.05 402.71,-47.66 410.48,-49.24\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"409.8,-51.24 416.1,-50.38 410.64,-47.13 409.8,-51.24\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"derecognise","lo":11,"title":"The error, year by year","html":"\u003cp>The pallet counted twice, as two roll-forwards of \u003cspan class=\"el el-e\">retained earnings\u003c/span>: what was reported against what should have been. Step through and watch the two lines split in 20X1 and meet again at the end of 20X2.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"err-b11\" data-cfg=\"{&quot;panels&quot;:[{&quot;title&quot;:&quot;As reported&quot;,&quot;sub&quot;:&quot;pallet counted twice&quot;,&quot;el&quot;:&quot;e&quot;,&quot;bal&quot;:&quot;Retained earnings since 1 Jan 20X1&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;Start from zero: we only track the {e|profit added to retained earnings} from 20X1.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;profit&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:80000,&quot;cap&quot;:&quot;{a|Closing inventory} 5,000 too high → {x|COGS} too low → profit {e|80,000}, overstated.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;profit&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:70000,&quot;cap&quot;:&quot;The same error is now {a|opening inventory} → {x|COGS} too high → profit {e|70,000}, understated. Total {e|150,000}.&quot;}]}]},{&quot;title&quot;:&quot;Corrected&quot;,&quot;sub&quot;:&quot;pallet counted once&quot;,&quot;el&quot;:&quot;e&quot;,&quot;bal&quot;:&quot;Retained earnings since 1 Jan 20X1&quot;,&quot;start&quot;:0,&quot;startCap&quot;:&quot;Start from zero: we only track the {e|profit added to retained earnings} from 20X1.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X1&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;profit&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:75000,&quot;cap&quot;:&quot;True profit = 80,000 − 5,000 = {e|75,000}.&quot;}]},{&quot;label&quot;:&quot;20X2&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;profit&quot;,&quot;el&quot;:&quot;e&quot;,&quot;v&quot;:75000,&quot;cap&quot;:&quot;True profit = 70,000 + 5,000 = {e|75,000}. Total {e|150,000}.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;One pallet worth 5,000 counted twice at 31 Dec 20X1. Left: what was reported. Right: the truth.&quot;,&quot;parts&quot;:[&quot;Each year’s profit is added to {e|retained earnings}.&quot;],&quot;end&quot;:&quot;**Different path, same destination.** 20X1 is 5,000 too high, 20X2 5,000 too low, and {e|retained earnings} at the end of 20X2 is 150,000 either way.&quot;}}\">\u003c/div>","id":"visual-mq7uu9","sect":5,"part":"Derecognise / transfer"},{"id":"mcq-8p8as6","type":"mcq","bucket":"derecognise","lo":11,"q":"{a|Closing inventory} at the end of 20X5 was **understated** by $3,000 and the error was never found. What is the effect?","options":[{"t":"20X5 profit understated; 20X6 profit overstated; {e|retained earnings} correct at the end of 20X6","ok":true,"why":"Low {a|closing stock} → high {x|COGS} → low 20X5 profit. Next year the low {a|opening stock} reverses it."},{"t":"20X5 profit overstated; 20X6 profit understated","why":"That is the effect of an **overstated** {a|closing figure}."},{"t":"20X5 profit understated; no effect on 20X6","why":"{a|Closing inventory} becomes next year’s {a|opening inventory}, so the error reverses in 20X6."},{"t":"No effect on profit, only on the balance sheet","why":"{a|Closing inventory} feeds directly into {x|COGS}, so profit is affected."}],"sect":5,"part":"Derecognise / transfer"},{"type":"compare","bucket":"derecognise","lo":12,"special":"{a|Inventory} leaves through **{x|COGS}**, and a **cost formula** (FIFO, weighted average, or specific identification) decides which costs leave and which stay on the shelf.","id":"compare-1kumyt-4","sect":5,"part":"Derecognise / transfer"},{"type":"map","id":"map-6-present","bucket":"present","sect":6,"part":"Present & disclose"},{"id":"think-12laoz","type":"think","bucket":"present","lo":13,"scenario":"You are comparing two retailers. One uses FIFO, the other weighted average. One wrote down $2m of {a|stock} this year; the other reversed an old write-down.","prompt":"What would you want each one’s notes to tell you?","answer":["The **cost formula**, so you can compare margins fairly.","How much {a|inventory} there is, and what kind ({a|raw materials}, {a|WIP}, {a|finished goods}).","How much was **expensed** ({x|COGS}), how much was **written down**, how much was **reversed**, and **why** it was reversed.","Whether any {a|stock} is **pledged** to a bank: it may not be free to sell."],"sect":6,"part":"Present & disclose"},{"type":"rule","bucket":"present","lo":13,"title":"Presentation and the eight disclosures","body":["Last stop: what readers see. Because the cost formula and write-downs change the numbers so much, the standard makes the entity show its choices and its write-downs, so two retailers can be compared fairly.","- {a|Inventory} is a {a|**current asset**}, at the lower of cost and NRV.","Disclose:","1. accounting policies, including the **cost formula** used","2. the **{a|total carrying amount}**, and by classification ({a|merchandise}, {a|raw materials}, {a|WIP}, {a|finished goods})","3. the {a|carrying amount} of inventory carried at **fair value less costs to sell**","4. the amount of inventory recognised as an **{x|expense}** in the period (usually {x|COGS})","5. the amount of any **{x|write-down}** recognised as an {x|expense}","6. the amount of any **reversal** of a write-down","7. the **circumstances or events** that led to the reversal","8. the {a|carrying amount} of inventory **pledged** as security for {l|liabilities}","+ Group them: **Policy** (1) → **Amounts** (2, 3) → **Expense** (4–7) → **Security** (8)."],"id":"rule-1ic86w","sect":6,"part":"Present & disclose"},{"type":"mcq","bucket":"present","lo":13,"q":"Which of the following is **not** a required inventory disclosure?","options":[{"t":"The cost formula used","why":"Required as part of the accounting policies."},{"t":"The amount of any {x|write-down} recognised as an {x|expense}","why":"Required."},{"t":"The replacement cost of inventory at the reporting date","ok":true,"why":"Not on the list. Inventory is measured at the lower of cost and NRV; replacement cost is not disclosed."},{"t":"The {a|carrying amount} of inventory pledged as security for {l|liabilities}","why":"Required."}],"id":"mcq-xicqmx","sect":6,"part":"Present & disclose"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":7,"part":"Wrap-up"},{"type":"summary","lo":13,"title":"Inventory on one page","rows":[["What is inventory?","Held for sale, in production for sale, or materials to be used up in production or services."],["Whose is it in transit?","Whoever controls it: FOB shipping point → buyer; FOB destination → seller. Consigned goods stay with the consignor."],["What goes into cost?","Purchase price − trade discounts + duties and non-recoverable taxes + freight-in + conversion costs."],["What stays out?","Recoverable GST (a {a|receivable}), {x|abnormal waste}, {x|storage} (unless needed in production), {x|admin}, {x|selling costs}, {x|freight-out}."],["Perpetual vs periodic?","Perpetual: {a|Inventory} and {x|COGS} updated at every sale. Periodic: {x|Purchases} accounts; {x|COGS} = {a|opening} + {x|net purchases} − {a|closing}."],["How is inventory measured?","Lower of cost and NRV, item by item."],["What is NRV?","Selling price − costs to complete − costs to sell."],["Raw materials?","Not written down if the finished goods still sell at or above cost."],["Can a write-down be reversed?","Yes, but only back up to original cost."],["Which cost formulas?","Specific ID (required for unique items), FIFO, weighted average. No LIFO."],["Overstated {a|closing inventory}?","{x|COGS} understated, profit overstated this year; reverses next year."],["Disclosures?","Eight: policy and cost formula, amounts by class, amount expensed, write-downs, reversals and why, inventory pledged."]],"id":"summary-19hth6","bucket":"wrap","sect":7,"part":"Wrap-up"}],"quiz":{"cases":{"sembawang":{"name":"Sembawang Sound","text":["Sembawang Sound Pte Ltd (Sembawang) imports and sells portable speakers. It uses the perpetual inventory system and has a 31 December year end. It is GST-registered.","On 1 November 20X6 it bought 400 speakers on credit at a list price of $150 each, less an 8% trade discount. It also paid import duty of $2,760, GST of $5,216 (recoverable as input tax), freight from the port to its warehouse of $1,590 and insurance in transit of $450.","During November and December it paid $1,200 to store the speakers in its warehouse until sold, and $950 to deliver speakers to customers.","At 31 December 20X6, 100 speakers were unsold. A new model was launched in December, and the remaining speakers are now expected to sell for $130 each, with selling costs of $6 per unit."]},"tea":{"name":"Tiong Bahru Tea","text":["Tiong Bahru Tea Pte Ltd sells identical tins of tea. Its records for January 20X7 show:","- 1 January: {a|opening inventory} of 100 tins at $10 each","- 5 January: bought 200 tins at $13 each","- 10 January: sold 150 tins","- 20 January: bought 100 tins at $18 each","- 25 January: sold 120 tins"]}},"questions":[{"id":"q1","case":"sembawang","lo":11,"type":"cost-components","q":"With reference to SFRS(I) 1-2, at what amount should Sembawang initially recognise the speakers bought on 1 November 20X6?","options":[{"t":"$65,216","pit":"recoverable-tax","why":"Includes the GST, which Sembawang recovers as input tax: it is a {a|receivable}, not cost."},{"t":"$60,000","ok":true,"why":"Price 60,000 less 8% trade discount = 55,200, + duty 2,760 + freight-in 1,590 + insurance 450 = 60,000."},{"t":"$62,150","pit":"storage-freight-out","why":"Storage of goods ready for sale and delivery to customers are {x|selling costs}, not part of cost."},{"t":"$64,800","why":"Trade discounts reduce the cost of purchase."}]},{"id":"q2","case":"sembawang","lo":11,"type":"system-entry","q":"Which journal entry records the freight from the port to the warehouse, paid in cash?","options":[{"je":[{"side":"Dr","account":"Freight-out expense","amount":1590,"el":"x"},{"side":"Cr","account":"Cash","amount":1590,"el":"a"}],"pit":"storage-freight-out","why":"This is freight **in**, bringing the goods to the warehouse. It is part of {a|inventory} cost."},{"je":[{"side":"Dr","account":"Freight-in","amount":1590,"el":"x"},{"side":"Cr","account":"Cash","amount":1590,"el":"a"}],"pit":"system-mixup","why":"A separate {x|Freight-in} account is the periodic system. Sembawang is perpetual."},{"je":[{"side":"Dr","account":"Inventory","amount":1590,"el":"a"},{"side":"Cr","account":"Cash","amount":1590,"el":"a"}],"ok":true,"why":"Perpetual: freight-in is added straight to the cost of {a|inventory}."},{"je":[{"side":"Dr","account":"Inventory","amount":1590,"el":"a"},{"side":"Cr","account":"Accounts payable","amount":1590,"el":"l"}],"why":"The freight was paid in cash, so {a|Cash} is credited."}]},{"id":"q3","case":"sembawang","lo":9,"type":"lcnrv-amount","q":"At what amount should the unsold speakers be carried at 31 December 20X6?","options":[{"t":"$15,000","pit":"ignore-writedown","why":"That is cost (100 × 150). NRV is now lower."},{"t":"$13,000","pit":"nrv-miss-costs","why":"Uses the selling price without deducting the selling costs."},{"t":"$12,400","ok":true,"why":"NRV = 130 − 6 = 124, below cost 150. 100 × 124 = 12,400."},{"t":"$14,400","pit":"cost-minus-sell","why":"Deducts selling costs from **cost**. Selling costs come off the selling price to give NRV."}]},{"id":"q4","case":"sembawang","lo":10,"type":"nrv-writedown","q":"Which journal entry records the adjustment at 31 December 20X6?","options":[{"je":[{"side":"Dr","account":"Cost of goods sold","amount":2600,"el":"x"},{"side":"Cr","account":"Inventory","amount":2600,"el":"a"}],"ok":true,"why":"100 × (150 − 124) = 2,600, expensed in the period."},{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":2600,"el":"e"},{"side":"Cr","account":"Inventory","amount":2600,"el":"a"}],"pit":"writedown-oci","why":"{a|Inventory} write-downs go to profit or loss. There is no {e|revaluation surplus} for inventory."},{"je":[{"side":"Dr","account":"Inventory","amount":2600,"el":"a"},{"side":"Cr","account":"Cost of goods sold","amount":2600,"el":"x"}],"why":"That is a reversal. The speakers have lost value, so {a|inventory} is credited."},{"je":[{"side":"Dr","account":"Retained earnings","amount":2600,"el":"e"},{"side":"Cr","account":"Inventory","amount":2600,"el":"a"}],"why":"A write-down is an {x|expense} of the period, not a direct charge to {e|retained earnings}."}]},{"id":"q5","case":"sembawang","lo":10,"type":"reversal","q":"At 31 December 20X7, 40 of the 100 speakers left unsold (and written down to NRV) at 31 December 20X6 are still unsold. A competitor has left the market and their NRV is now $170 each. At what amount are they carried?","options":[{"t":"$4,960","pit":"no-reversal","why":"SFRS(I) requires the write-down to be reversed when NRV recovers."},{"t":"$6,000","ok":true,"why":"Lower of cost (150) and NRV (170) = cost. 40 × 150 = 6,000: the reversal stops at original cost."},{"t":"$6,800","pit":"write-up","why":"Above original cost. Reversals are capped at the original write-down."},{"t":"$6,560","pit":"write-up","why":"NRV is already net of selling costs, and it is above cost anyway: carry at cost."}]},{"id":"q6","case":"tea","lo":12,"type":"cost-formula","q":"What is {a|closing inventory} at 31 January under FIFO?","options":[{"t":"$1,755","pit":"wrong-average","why":"That is the periodic weighted average."},{"t":"$1,390","pit":"lifo","why":"Values the {a|closing tins} at the oldest costs: that is LIFO, which is not allowed."},{"t":"$2,190","ok":true,"why":"The 130 tins left carry the latest costs: 30 × 13 + 100 × 18 = 2,190."},{"t":"$1,872","why":"That is the perpetual moving average."}]},{"id":"q7","case":"tea","lo":12,"type":"cost-formula","q":"Tiong Bahru Tea uses the **periodic** system with the weighted average formula. What is {x|cost of goods sold} for January?","options":[{"t":"$3,210","why":"That is FIFO {x|COGS}."},{"t":"$3,528","pit":"wrong-average","why":"That is the moving average (perpetual). Periodic uses one average for the whole period."},{"t":"$3,645","ok":true,"why":"Average = 5,400 ÷ 400 = 13.5. {x|COGS} = 270 × 13.5 = 3,645."},{"t":"$4,010","pit":"lifo","why":"Sends the newest costs to {x|COGS} first: LIFO, which is not allowed."}]},{"id":"q8","case":"tea","lo":12,"type":"cost-formula","q":"If Tiong Bahru Tea used the **perpetual** system with the weighted average formula instead, what would {a|closing inventory} be?","options":[{"t":"$1,755","pit":"wrong-average","why":"That is the periodic average. Perpetual recalculates a moving average after each purchase."},{"t":"$1,872","ok":true,"why":"Average 12 after 5 Jan; 150 tins left at 1,800; after 20 Jan 250 tins = 3,600, average 14.4; 130 × 14.4 = 1,872."},{"t":"$2,190","why":"That is FIFO."},{"t":"$1,560","why":"Uses the 5 January average without updating it after the 20 January purchase."}]},{"id":"q9","case":"tea","lo":12,"type":"cost-formula","q":"Prices rose during January. Which formula gives Tiong Bahru Tea the highest gross profit?","options":[{"t":"FIFO","ok":true,"why":"Lowest {x|COGS} (3,210) because the oldest, cheapest costs are expensed first."},{"t":"Weighted average (periodic)","why":"{x|COGS} 3,645: higher than FIFO when prices rise."},{"t":"Weighted average (perpetual)","why":"{x|COGS} 3,528: higher than FIFO when prices rise."},{"t":"All formulas give the same gross profit","why":"Goods available are the same, but the split between {x|COGS} and {a|closing inventory} differs."}]},{"id":"q10","case":"tea","lo":12,"type":"cost-formula","q":"The finance manager suggests switching to LIFO to reduce reported profit. Which statement is correct under SFRS(I) 1-2?","options":[{"t":"LIFO is allowed if it is applied consistently","pit":"lifo","why":"LIFO is not permitted under SFRS(I) at all."},{"t":"LIFO is not permitted; the entity may use FIFO or weighted average for these interchangeable tins","ok":true,"why":"Interchangeable items use FIFO or weighted average; specific identification is for items that are not interchangeable."},{"t":"LIFO is required when prices are rising","pit":"lifo","why":"There is no such rule, and LIFO is not permitted."},{"t":"The entity must use specific identification for all inventory","why":"Specific identification is required only for items that are not ordinarily interchangeable."}]},{"id":"q11","lo":9,"type":"lcnrv-amount","source":"Official practice paper Q5","q":"Sonic Supplies Pte Ltd (Sonic) sells several wireless electronic products. At the end of the financial year, Sonic has the following inventory record for wireless earbuds: cost per unit $28; number of units in stock 2,575; estimated sales price per unit $45; estimated selling costs per unit $3. With reference to SFRS(I) 1-2, Inventories, identify which of the following is the correct value for this inventory item in the financial statements?","options":[{"t":"$64,375","pit":"cost-minus-sell","why":"2,575 × 25: deducts the selling costs from cost. Selling costs reduce the selling price to give NRV, not cost."},{"t":"$72,100","ok":true,"why":"NRV = 45 − 3 = 42, above cost 28. Carry at cost: 2,575 × 28 = 72,100."},{"t":"$108,150","pit":"write-up","why":"2,575 × 42 = NRV. Inventory is never carried above cost."},{"t":"$15,875","why":"This doesn’t follow from cost or NRV. The 2,575 earbuds are valued at the lower of $28 and $42 a unit."}]},{"id":"q12","lo":9,"type":"lcnrv-amount","q":"A company holds three items: X (cost $5,000, NRV $4,000), Y (cost $7,000, NRV $9,000) and Z (cost $3,000, NRV $2,600). At what amount should {a|inventory} be reported?","options":[{"t":"$15,000","pit":"total-not-item","why":"Total NRV 15,600 is above total cost, but the test is item by item."},{"t":"$13,600","ok":true,"why":"4,000 + 7,000 + 2,600 = 13,600. X and Z are written down; Y stays at cost."},{"t":"$15,600","pit":"write-up","why":"Writes Y up to NRV. Never above cost."},{"t":"$14,000","why":"Z’s NRV is also below its cost: write it down too."}]},{"id":"q13","lo":9,"type":"nrv-writedown","q":"A boat builder has 50 part-built boats in {a|work in progress}, each with costs to date of $9,000. Each will cost a further $2,500 to complete and will sell for $12,000, with selling costs of $800. What write-down is required?","options":[{"t":"$0","pit":"nrv-miss-costs","why":"Forgets the costs to complete: 12,000 − 800 looks comfortably above cost."},{"t":"$15,000","ok":true,"why":"NRV = 12,000 − 2,500 − 800 = 8,700. (9,000 − 8,700) × 50 = 15,000."},{"t":"$140,000","why":"Compares cost to date **plus** costs to complete with NRV, so the costs to complete are deducted twice."},{"t":"$435,000","why":"That is the {a|carrying amount} after the write-down, not the write-down."}]},{"id":"q14","lo":9,"type":"raw-materials","q":"A bakery holds flour that cost $20,000. Its replacement cost has fallen to $16,000. The bread made from it still sells well above cost. At what amount is the flour carried?","options":[{"t":"$16,000","pit":"rm-writedown","why":"Raw materials are not written down when the finished goods will sell at or above cost."},{"t":"$20,000","ok":true,"why":"The bread recovers the full cost of the flour, so the flour stays at cost."},{"t":"$18,000","why":"There is no averaging of cost and replacement cost."},{"t":"$4,000","why":"That is the fall in replacement cost, not a {a|carrying amount}."}]},{"id":"q15","lo":11,"type":"system-entry","q":"A trader using the **periodic** system sells 30 units on credit at $90 each. The units cost $55 each. Which entry is recorded at the date of sale?","options":[{"je":[{"side":"Dr","account":"Accounts receivable","amount":2700,"el":"a"},{"side":"Cr","account":"Sales revenue","amount":2700,"el":"i"},{"side":"Dr","account":"Cost of goods sold","amount":1650,"el":"x"},{"side":"Cr","account":"Inventory","amount":1650,"el":"a"}],"pit":"periodic-cogs-entry","why":"The {x|COGS} entry at each sale is the perpetual system. Periodic works out {x|COGS} at the period end."},{"je":[{"side":"Dr","account":"Accounts receivable","amount":2700,"el":"a"},{"side":"Cr","account":"Sales revenue","amount":2700,"el":"i"}],"ok":true,"why":"Periodic: {i|revenue} only. {x|COGS} comes from the year-end count."},{"je":[{"side":"Dr","account":"Accounts receivable","amount":2700,"el":"a"},{"side":"Cr","account":"Inventory","amount":2700,"el":"a"}],"why":"Sales are {i|revenue}; {a|inventory} is not credited at selling price."},{"je":[{"side":"Dr","account":"Accounts receivable","amount":2700,"el":"a"},{"side":"Cr","account":"Purchases","amount":1650,"el":"x"},{"side":"Cr","account":"Sales revenue","amount":1050,"el":"i"}],"why":"{x|Purchases} are never credited on a sale, and {i|revenue} is the full selling price."}]},{"id":"q16","lo":11,"type":"inv-error","q":"A company’s {a|closing inventory} at 31 December 20X3 was overstated by $4,000. The error was never corrected. What is the effect?","options":[{"t":"20X3 profit overstated by $4,000; 20X4 profit understated by $4,000","ok":true,"why":"High {a|closing stock} → low 20X3 {x|COGS}. As 20X4 {a|opening stock} it raises 20X4 {x|COGS}. {e|Retained earnings} is correct by the end of 20X4."},{"t":"20X3 profit understated by $4,000; 20X4 profit overstated by $4,000","why":"The wrong way round: overstated {a|closing stock} understates {x|COGS}, so profit is overstated."},{"t":"20X3 profit overstated by $4,000; no effect on 20X4","pit":"error-no-reverse","why":"{a|Closing inventory} becomes next year’s {a|opening inventory}, so the error reverses in 20X4."},{"t":"{e|Retained earnings} overstated by $4,000 at the end of 20X4","pit":"error-no-reverse","why":"By the end of 20X4 the two errors have cancelled."}]},{"id":"q17","lo":13,"type":"disclosure","q":"Which of the following must an entity disclose about its inventories under SFRS(I) 1-2?","options":[{"t":"The NRV of every item held at the reporting date","why":"Not required. Only write-downs and reversals are disclosed."},{"t":"The {a|carrying amount} of inventories pledged as security for {l|liabilities}","ok":true,"why":"One of the eight required disclosures."},{"t":"The expected selling prices for the next year","why":"Not required."},{"t":"The names of its main suppliers","why":"Not required."}]},{"id":"q18","lo":11,"type":"what-is-inventory","q":"Which of the following is inventory of a car dealer?","options":[{"t":"The showroom building it owns","why":"Used to run the business: {a|PPE}."},{"t":"New cars on the showroom floor waiting for buyers","ok":true,"why":"Held for sale in the ordinary course of business."},{"t":"The tow truck it uses to collect broken-down cars","why":"Used over many periods: {a|PPE}."},{"t":"Office computers used by the sales team","why":"{a|PPE}."}]},{"id":"q19","lo":11,"type":"goods-transit","q":"On 30 December a wholesaler (year end 31 December) ships goods costing $6,000 to a customer on **FOB destination** terms. They arrive on 3 January. How should the wholesaler treat the goods at 31 December?","options":[{"t":"Exclude them from inventory and record the sale on 30 December","pit":"transit-terms","why":"Under FOB destination, control passes on delivery, which is in January."},{"t":"Include them in its {a|inventory} at $6,000","ok":true,"why":"The wholesaler keeps control until the goods reach the customer."},{"t":"Include them at their selling price","why":"{a|Inventory} is at cost (or NRV if lower), never at selling price."},{"t":"Exclude them; goods in transit belong to no one until they arrive","pit":"transit-terms","why":"Goods in transit always belong to someone: here the seller."}]}]},"exam":{"cases":{"lcv":{"name":"Lion City Venture","source":"Official practice paper (Q21–25 case, inventory and revenue lines only)","text":["The following balances are extracted from the trial balance of Lion City Venture (LCV) on 31 December 20X5, the date of the financial year end, before adjustments. All figures are in $’000.","- Inventory (debit) 31,250","- Sales (credit) 125,000","- Purchases (debit) 100,000","- Deferred revenue (credit) 3,500","Inventory on 31 December 20X5 was $39,850 before write-down. Inventory is accounted for using the periodic method. Write-down was $6,800.","Deferred revenue on 31 December 20X5 is $2,750."]},"kranji":{"name":"Kranji Kitchens","text":["Kranji Kitchens Pte Ltd (Kranji) manufactures kitchen equipment and has a 31 December year end. At 31 December 20X4 it holds:","**{a|Raw materials}:** stainless steel that cost $60,000. Its replacement cost has fallen to $51,000. The sinks made from this steel are expected to sell at a healthy margin above their cost.","**{a|Work in progress}:** 400 part-built ovens with costs to date of $300 each. Each needs a further $80 to complete. Because of a price war, they are now expected to sell for $400 each. Kranji pays its sales agents a 5% commission on the selling price, and delivery to customers costs $10 per oven.","**{a|Finished goods}:** 1,000 range hoods costing $150 each, with an NRV of $190 each."]}},"questions":[{"id":"x1","case":"lcv","lo":11,"type":"gp-cogs","source":"Official practice paper Q21","q":"Identify which of the following is the correct gross profit amount to be shown in the Statement of profit or loss for LCV on 31 December 20X5? All figures are in $’000.","options":[{"t":"$23,950","why":"This doesn’t follow from a consistent working. {i|Revenue} 125,000 + 750 = 125,750; {x|COGS} 31,250 + 100,000 − 33,050 = 98,200."},{"t":"$26,050","pit":"deferred-rev","why":"Deducts the 750 of {l|deferred revenue} released from sales. {l|Deferred revenue} fell from 3,500 to 2,750, so 750 has been **earned** and is added to {i|revenue}."},{"t":"$27,550","ok":true,"why":"{i|Revenue} 125,000 + 750 = 125,750. {a|Closing inventory} 39,850 − 6,800 = 33,050. {x|COGS} = 31,250 + 100,000 − 33,050 = 98,200. Gross profit = 27,550."},{"t":"$34,350","pit":"ignore-writedown","why":"Uses {a|closing inventory} before the write-down (39,850). The 6,800 write-down is part of the {x|inventory expense}, so it increases {x|COGS}."}]},{"id":"x2","case":"lcv","lo":9,"type":"gp-cogs","q":"At what amount should {a|inventory} be shown in current assets in LCV’s statement of financial position at 31 December 20X5? All figures are in $’000.","options":[{"t":"$39,850","pit":"ignore-writedown","why":"Before the write-down. {a|Inventory} is at the lower of cost and NRV."},{"t":"$31,250","pit":"tb-opening","why":"Under the periodic method the trial-balance {a|inventory} is the {a|**opening** balance}. It is replaced by {a|closing inventory} from the count."},{"t":"$33,050","ok":true,"why":"39,850 − 6,800 = 33,050."},{"t":"$46,650","why":"Adds the write-down instead of deducting it."}]},{"id":"x3","case":"lcv","lo":11,"type":"gp-cogs","q":"What is LCV’s {x|cost of goods sold} for 20X5 (including the write-down)? All figures are in $’000.","options":[{"t":"$91,400","pit":"ignore-writedown","why":"Leaves out the write-down."},{"t":"$100,000","pit":"tb-opening","why":"Under periodic, {x|COGS} is not just {x|purchases}: adjust for {a|opening} and {a|closing inventory}."},{"t":"$98,200","ok":true,"why":"31,250 + 100,000 − 33,050 = 98,200."},{"t":"$105,000","why":"Counts the write-down twice: deducting it from {a|closing inventory} already puts the 6,800 into {x|COGS}."}]},{"id":"x4","case":"lcv","lo":10,"type":"reversal","q":"LCV’s 20X5 write-down of $6,800 related to goods costing $15,000 (carried at $8,200 after the write-down). They are still unsold at 31 December 20X6, when their NRV has recovered to $16,500. What reversal does LCV recognise in 20X6? All figures in $’000.","options":[{"t":"$8,300","pit":"write-up","why":"Takes the goods to 16,500, above their original cost of 15,000."},{"t":"$0","pit":"no-reversal","why":"SFRS(I) requires a reversal when NRV recovers. (US GAAP forbids it.)"},{"t":"$6,800","ok":true,"why":"Lower of cost 15,000 and NRV 16,500 = 15,000. Reversal = 15,000 − 8,200 = 6,800, the whole original write-down, credited to {x|COGS}."},{"t":"$1,500","why":"That is the excess of NRV over cost, which is never recognised."}]},{"id":"x5","case":"lcv","lo":11,"type":"inv-error","q":"In January 20X6 LCV discovers that goods costing $1,200 were counted twice at 31 December 20X5 (their NRV is above cost). The 20X5 statements have not yet been issued. What is the correct 20X5 gross profit, and what would have happened in 20X6 had the error not been found? All figures in $’000.","options":[{"t":"$26,350; 20X6 gross profit would have been understated by $1,200","ok":true,"why":"{a|Closing inventory} falls by 1,200, so {x|COGS} rises: 27,550 − 1,200 = 26,350. Left uncorrected, the overstated {a|opening stock} would have inflated 20X6 {x|COGS}."},{"t":"$28,750; 20X6 gross profit would have been overstated by $1,200","why":"The wrong direction. Overstated {a|closing inventory} overstates profit, so correcting it reduces profit."},{"t":"$26,350; no effect on 20X6","pit":"error-no-reverse","why":"{a|Closing inventory} is next year’s {a|opening inventory}, so the error would have reversed in 20X6."},{"t":"$27,550; the error only affects the balance sheet","why":"{a|Closing inventory} drives {x|COGS}, so gross profit changes."}]},{"id":"x6","case":"kranji","lo":9,"type":"raw-materials","q":"At what amount should Kranji carry the stainless steel at 31 December 20X4?","options":[{"t":"$51,000","pit":"rm-writedown","why":"Raw materials are not written down when the finished goods will sell above cost."},{"t":"$60,000","ok":true,"why":"The sinks will sell above cost, so the steel’s cost will be recovered: keep it at cost."},{"t":"$9,000","why":"That is the fall in replacement cost, not a {a|carrying amount}."},{"t":"$42,000","why":"Double counts the fall in replacement cost."}]},{"id":"x7","case":"kranji","lo":9,"type":"nrv-writedown","q":"What write-down is required on the ovens in {a|work in progress}?","options":[{"t":"$0","pit":"nrv-miss-costs","why":"Leaves out the costs to complete (or to sell): 400 − 20 − 10 = 370, which looks above cost."},{"t":"$4,000","ok":true,"why":"Commission 400 × 5% = 20. NRV = 400 − 80 − 20 − 10 = 290. (300 − 290) × 400 = 4,000."},{"t":"$36,000","why":"Compares cost to date plus costs to complete with NRV, deducting the costs to complete twice."},{"t":"$120,000","why":"Writes the {a|WIP} off entirely. It still has an NRV, just a lower one."}]},{"id":"x8","case":"kranji","lo":9,"type":"lcnrv-amount","q":"What is the total {a|carrying amount} of Kranji’s inventories at 31 December 20X4?","options":[{"t":"$317,000","pit":"rm-writedown","why":"Writes the steel down to replacement cost, though the sinks still sell above cost."},{"t":"$326,000","ok":true,"why":"Steel 60,000 + ovens 120,000 − 4,000 + hoods 150,000 = 326,000."},{"t":"$330,000","pit":"ignore-writedown","why":"Leaves out the write-down on the ovens."},{"t":"$366,000","pit":"write-up","why":"Carries the range hoods at NRV, above cost."}]},{"id":"x9","case":"kranji","lo":10,"type":"nrv-writedown","q":"Which journal entry records the adjustment to the ovens?","options":[{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":4000,"el":"e"},{"side":"Cr","account":"Inventory","amount":4000,"el":"a"}],"pit":"writedown-oci","why":"{a|Inventory} write-downs are expensed in profit or loss."},{"je":[{"side":"Dr","account":"Cost of goods sold","amount":4000,"el":"x"},{"side":"Cr","account":"Inventory","amount":4000,"el":"a"}],"ok":true,"why":"{x|Write-down} 4,000 expensed in the period."},{"je":[{"side":"Dr","account":"Inventory","amount":4000,"el":"a"},{"side":"Cr","account":"Cost of goods sold","amount":4000,"el":"x"}],"why":"That entry is a reversal; the ovens have lost value."},{"je":[{"side":"Dr","account":"Cost of goods sold","amount":36000,"el":"x"},{"side":"Cr","account":"Inventory","amount":36000,"el":"a"}],"why":"Wrong amount: the costs to complete are deducted twice."}]},{"id":"x10","case":"kranji","lo":9,"type":"raw-materials","q":"In 20X5 steel prices keep falling and competitors cut sink prices, so the sinks made from Kranji’s steel will now sell **below** cost. The steel (cost $60,000) is still on hand at 31 December 20X5; its replacement cost is $48,000, the best available measure of its NRV. What write-down is recognised in 20X5?","options":[{"t":"$0","pit":"rm-writedown","why":"Once the finished goods will sell below cost, the materials are written down."},{"t":"$3,000","why":"Treats the steel as if it had been written down to its 20X4 replacement cost. It was rightly kept at cost in 20X4."},{"t":"$12,000","ok":true,"why":"60,000 − 48,000 = 12,000. Replacement cost may be the best measure of NRV for raw materials."},{"t":"$60,000","why":"Writes the steel off entirely. It still has an NRV."}]},{"id":"x11","lo":12,"type":"cost-formula","q":"A company uses the perpetual system and weighted average. 1 Mar: 200 units at $5. 4 Mar: bought 300 at $6. 12 Mar: sold 250. 18 Mar: bought 250 at $7.2. 28 Mar: sold 300. What is {a|closing inventory} on 31 March?","options":[{"t":"$1,227","pit":"wrong-average","why":"Uses one periodic average (4,600 ÷ 750). Perpetual uses a moving average."},{"t":"$1,280","ok":true,"why":"Average 5.6 after 4 Mar; after 18 Mar: 500 units = 3,200, average 6.4. 200 × 6.4 = 1,280."},{"t":"$1,440","why":"That is FIFO: the latest costs."},{"t":"$1,000","pit":"lifo","why":"Values {a|closing stock} at the oldest costs: LIFO, which is not allowed."}]},{"id":"x12","lo":11,"type":"inv-error","q":"{a|Closing inventory} at 31 December 20X1 was **understated** by $8,000. Reported profits were $50,000 for 20X1 and $60,000 for 20X2. What are the correct profits?","options":[{"t":"20X1 $58,000; 20X2 $52,000","ok":true,"why":"Understated {a|closing stock} overstated 20X1 {x|COGS}: profit +8,000. As understated {a|opening stock} it understated 20X2 {x|COGS}: profit −8,000."},{"t":"20X1 $58,000; 20X2 $60,000","pit":"error-no-reverse","why":"The error reverses in 20X2 through {a|opening inventory}."},{"t":"20X1 $42,000; 20X2 $68,000","why":"The wrong direction: understated {a|closing stock} understates profit, so correcting it increases 20X1 profit."},{"t":"20X1 $58,000; 20X2 $68,000","why":"Both years cannot rise: the error reverses in 20X2."}]},{"id":"x13","lo":11,"type":"cost-components","q":"A manufacturer incurs: materials $40,000, direct labour $25,000, production overheads $15,000, abnormal wastage $3,000, head-office admin $6,000, selling costs $4,000, and storage of finished goods awaiting sale $2,000. All goods made are still on hand. What is the cost of {a|inventory}?","options":[{"t":"$83,000","pit":"storage-freight-out","why":"Abnormal wastage is expensed, never part of cost."},{"t":"$80,000","ok":true,"why":"40,000 + 25,000 + 15,000 = 80,000. Abnormal waste, admin, selling and storage of finished goods are expensed."},{"t":"$91,000","pit":"storage-freight-out","why":"Includes abnormal waste, unrelated admin and storage of finished goods."},{"t":"$65,000","why":"Leaves out production overheads, which are part of conversion costs."}]},{"id":"x14","lo":11,"type":"goods-transit","q":"A trader’s 31 December count of its own warehouse shows {a|inventory} costing $90,000. Not included: (1) goods costing $12,000 bought **FOB shipping point**, shipped on 29 December, arriving 3 January; (2) goods costing $7,000 sold to a customer **FOB destination**, shipped 30 December, arriving 4 January. The count does include goods costing $5,000 held on consignment for another company. What is the correct {a|inventory}?","options":[{"t":"$90,000","pit":"transit-terms","why":"Both lots in transit belong to the trader at 31 December, and the consigned goods do not."},{"t":"$104,000","ok":true,"why":"90,000 + 12,000 (control passed on shipment) + 7,000 (control passes on delivery) − 5,000 (the consignor’s goods) = 104,000."},{"t":"$109,000","why":"The consigned goods belong to the consignor and must be removed."},{"t":"$97,000","pit":"transit-terms","why":"Goods sold FOB destination are still the seller’s until delivered."}]},{"id":"x15","lo":11,"type":"system-entry","q":"A trader uses the periodic system. Opening {a|inventory} $5,000, {x|purchases} $30,000, {x|purchase returns} $1,000, {x|freight-in} $500. The year-end count shows closing {a|inventory} of $6,500. Which period-end entry is correct? ({a|Inventory} shows the net change from opening to closing.)","options":[{"je":[{"side":"Dr","account":"Inventory","amount":6500,"el":"a"},{"side":"Dr","account":"Cost of goods sold","amount":23000,"el":"x"},{"side":"Dr","account":"Purchase returns","amount":1000,"el":"x"},{"side":"Cr","account":"Purchases","amount":30000,"el":"x"},{"side":"Cr","account":"Freight-in","amount":500,"el":"x"}],"why":"Ignores the {a|opening inventory}, which must be removed and charged to {x|COGS}."},{"je":[{"side":"Dr","account":"Inventory","amount":1500,"el":"a"},{"side":"Dr","account":"Cost of goods sold","amount":28000,"el":"x"},{"side":"Dr","account":"Purchase returns","amount":1000,"el":"x"},{"side":"Cr","account":"Purchases","amount":30000,"el":"x"},{"side":"Cr","account":"Freight-in","amount":500,"el":"x"}],"ok":true,"why":"{x|COGS} = 5,000 + 30,000 − 1,000 + 500 − 6,500 = 28,000. {a|Inventory} rises 1,500 from opening to closing."},{"je":[{"side":"Dr","account":"Inventory","amount":1500,"el":"a"},{"side":"Dr","account":"Cost of goods sold","amount":30000,"el":"x"},{"side":"Cr","account":"Purchase returns","amount":1000,"el":"x"},{"side":"Cr","account":"Purchases","amount":30000,"el":"x"},{"side":"Cr","account":"Freight-in","amount":500,"el":"x"}],"why":"Adds {x|purchase returns} to {x|COGS} instead of deducting them. Returns have a credit balance and are closed with a debit."},{"je":[{"side":"Dr","account":"Inventory","amount":1500,"el":"a"},{"side":"Dr","account":"Cost of goods sold","amount":27500,"el":"x"},{"side":"Dr","account":"Purchase returns","amount":1000,"el":"x"},{"side":"Cr","account":"Purchases","amount":30000,"el":"x"}],"pit":"storage-freight-out","why":"Leaves {x|freight-in} out of {x|COGS} as if it were a {x|selling expense}. {x|Freight-in} is part of the cost of {x|purchases}."}]}]},"prepared":true},{"id":"ppe","code":"B1.2","title":"Property, Plant and Equipment","subtitle":"SFRS(I) 1-16 · cost, depreciation, revaluation","los":{"14":"Acquisition, depreciation and disposal of PPE","15":"Cost model and revaluation model","16":"PPE disclosures"},"accounts":[{"name":"Machine (PPE)","el":"a"},{"name":"Building (PPE)","el":"a"},{"name":"Land (PPE)","el":"a"},{"name":"Accumulated depreciation: machine","el":"a"},{"name":"Accumulated depreciation: building","el":"a"},{"name":"Cash","el":"a"},{"name":"GST receivable","el":"a"},{"name":"Provision for dismantling","el":"l"},{"name":"Revaluation surplus (OCI)","el":"e"},{"name":"Retained earnings","el":"e"},{"name":"Depreciation expense","el":"x"},{"name":"Revaluation loss (P&L)","el":"x"},{"name":"Loss on disposal","el":"x"},{"name":"Gain on disposal","el":"i"},{"name":"Revenue","el":"i"},{"name":"Training expense","el":"x"}],"map":{"classify":{"label":"Held for use; land vs improvements"},"recognise":{"label":"Probable benefits + reliable cost; parts"},"initial":{"label":"Cost to get it ready, incl. dismantling","star":"Cost includes the PV of dismantling and restoration"},"subsequent":{"label":"Cost or revaluation model, per class","star":"Depreciation by components; revaluation gains to OCI"},"derecognise":{"label":"{a|Proceeds} − {a|carrying amount} to P&L"},"present":{"label":"Per class; revalued: cost-model amount"}},"preamble":["Welcome to the engine room. **Property, plant and equipment** is the stuff a business **uses** to make money: factories, machines, vans, servers, the office chair you are slouching in. It is the template for every other asset in this module, so a lot of what you learn here you will see again in investment property and leases.","Here is the route, with ★ on the bits that make PPE special:","1. First we **classify**: is it held for use? And on a building site, which costs are **{a|land}** (never depreciated) and which are **{a|land improvements}**?","2. Then we **recognise** it: the usual two tests, plus replacing parts.","3. Next, the first number: **cost**, everything needed to get it ready for use, including the **present value of dismantling** it one day. ★ special","4. Then every year end: **depreciation** by components, and the choice of **cost** or **revaluation** model per class, with revaluation gains going to **OCI**. ★ special","5. Then it leaves: **disposal**, {a|proceeds} minus {a|carrying amount}.","6. Last stop: the **disclosures**, which the exam loves to ask about for revalued PPE.","+ The big idea: capitalise everything that gets the asset **ready for use**, spread it over its **useful life**, and if you revalue, **up goes to OCI, down goes to P&L**, each first cancelling the other on the same asset."],"intros":{"classify":"First stop: what counts as PPE? It is held **for use**, for **more than one period**, not for sale. Then a practical sorting job that the exam loves: on a building site, what belongs to **{a|land}** (never depreciated), what are **{a|land improvements}** (roads, fences, sprinklers, which do wear out), and what is the **{a|building}**.","recognise":"Now that we know what PPE is, when does it (or money spent on it later) get onto the balance sheet? Pretty vanilla: probable benefits and a reliable cost. The one idea to carry forward: replacing a **significant part** is a new asset, while day-to-day servicing is an expense. Keep a short stop here.","initial":"It’s on the books, so time to put a first number on it. ★ This is one of PPE’s special parts: cost is **everything needed to get it ready for use**, and it even includes the **present value of dismantling** it one day, with a {l|provision} on the other side. Training, admin and recoverable GST stay out, however hard the exam tries to sneak them in.","subsequent":"We have a cost, so now the asset has to earn its keep and wear out. ★ Special: **depreciation by components**, so an aircraft’s engines run on a different clock from its body. Residual value comes off first, the clock starts when the asset is available for use, and changes in estimate are prospective.","subsequent|revaluation":"Depreciation done; now the big choice. ★ This is PPE’s other special part: the **revaluation model**, chosen per class. Gains go to **OCI** (a {e|revaluation surplus}), falls use up that asset’s surplus before hitting P&L, and the surplus drains to {e|retained earnings} without ever touching profit. The exam tests this every single time.","derecognise":"The machine has served its time. Leaving is vanilla: **{a|net proceeds}** minus **{a|carrying amount}**, to P&L. The only twist is for revalued assets: any {e|surplus} left goes straight to {e|retained earnings}, never through profit.","present":"Last stop: telling the reader what you did. Per class: basis, methods, lives, and a reconciliation of the {a|carrying amount}. If you revalue, the reader also wants the date, the valuer and what the asset would be at cost. Mostly a checklist; learn it once."},"pitfalls":{"no-salvage":"Forgetting to deduct salvage proceeds from the cost of {a|land}.","li-as-land":"Capitalising roads, fences or sprinklers as {a|land}, which is never depreciated.","expense-li":"Expensing {a|land improvements} instead of capitalising and depreciating them.","capitalise-training":"Including training, admin overheads, relocation, abnormal waste or recoverable GST in cost.","no-dismantle":"Leaving the present value of dismantling and restoration out of cost.","test-proceeds-cost":"Deducting {i|sales of test output} from cost (they go to P&L).","ignore-residual":"Forgetting the residual value when working out depreciation.","wrong-years":"Getting the number of years or months of depreciation wrong.","retro-estimate":"Restating past years for a change in useful life or residual value (it is prospective).","cost-not-ca":"Using {a|cost} instead of {a|carrying amount} (for a disposal or a revaluation).","surplus-to-pl":"Taking a revaluation increase to P&L (it goes to OCI unless it reverses an earlier {x|P&L loss}).","surplus-to-re":"Crediting a revaluation increase straight to {e|retained earnings} instead of OCI.","all-to-pl-down":"Taking a revaluation decrease all to P&L, ignoring the {e|surplus} on that asset.","all-to-oci-down":"Taking a revaluation decrease all to OCI, beyond the {e|surplus} on that asset.","recycle-surplus":"Recycling the {e|revaluation surplus} (or the excess-depreciation transfer) through P&L."},"examTypes":[{"id":"land-cost","title":"What is the cost of land? (practice Q26)","pitfall":"Not deducting salvage proceeds, or adding {a|land improvements}.","see":"classify"},{"id":"land-improvements","title":"How are the road, fence and sprinklers treated? (practice Q27)","pitfall":"Capitalising them as {a|land} (never depreciated) or expensing them.","see":"classify"},{"id":"asset-cost","title":"What is the cost of the machine or building?","pitfall":"Including training, admin or recoverable GST; leaving out dismantling.","see":"initial"},{"id":"subsequent-cost","title":"Capitalise or expense a later cost? Replace a component?","pitfall":"Expensing a replaced significant part, or keeping the old part in cost.","see":"recognise"},{"id":"depreciation","title":"What is the depreciation charge for the year? (LCV Q22)","pitfall":"Forgetting residual value or the months in the first year.","see":"subsequent"},{"id":"estimate-change","title":"Useful life revised: what is the new charge?","pitfall":"Restating past years instead of going prospective from the {a|carrying amount}.","see":"subsequent"},{"id":"reval-entry","title":"Which journal entry records the revaluation? (practice Q10)","pitfall":"Ignoring residual value; {e|surplus} to P&L.","see":"subsequent"},{"id":"reval-surplus","title":"How much goes to the revaluation surplus, and where? (practice Q28–29)","pitfall":"Crediting {e|retained earnings} or P&L instead of OCI.","see":"subsequent"},{"id":"reval-decrease","title":"A revalued asset falls in value: how much to P&L?","pitfall":"Putting it all in P&L, ignoring the {e|surplus} on that asset.","see":"subsequent"},{"id":"disposal","title":"What is the gain or loss on disposal?","pitfall":"Using {a|cost} instead of {a|carrying amount}; recycling the {e|surplus}.","see":"derecognise"},{"id":"disclosure","title":"Which disclosure is NOT required? (practice Q30)","pitfall":"Not knowing the revalued-PPE disclosure list.","see":"present"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":14,"title":"PPE, the Socratic way","body":["PPE is the workhorse of the balance sheet: the machines, buildings, vans and servers a business **uses** to make its money. Most of this chapter is three questions: what goes into its cost, how fast it wears out, and what happens if you revalue it.","Each idea starts with a question. Think it through, then reveal the answer. The rule comes after, once you have half-worked it out.","Account names are coloured by element. Tap **Legend** at the top any time. At the end: a chapter quiz in exam style (including a whole case from the official practice paper), then a harder exam."],"id":"intro-9cnzem","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-classify","bucket":"classify","sect":1,"part":"Classify"},{"type":"think","bucket":"classify","lo":14,"scenario":"A car dealer owns: (1) 40 new cars in its showroom waiting for buyers, (2) a tow truck it uses to collect broken-down cars, (3) a stock of oil filters it fits during services, and (4) the showroom building itself.","prompt":"Which of these are property, plant and equipment, and what single question did you ask to decide?","answer":["The question: is it held **for use** in the business, for **more than one period**? Or is it held to sell, or used up straight away?","The **tow truck** and the **showroom** are used in the business year after year: {a|PPE}.","The **cars** are held for sale: {a|Inventory}. The **oil filters** are consumed within the period: {a|inventory} too, expensed as they are fitted.","Same car can be {a|PPE} at one company and {a|inventory} at another. The tow truck has a job; the showroom cars are just waiting for a date."],"id":"think-10gpxv","sect":1,"part":"Classify"},{"type":"rule","bucket":"classify","lo":14,"title":"What is PPE?","body":["The car dealer’s answer, as a rule. One definition decides whether an item enters this chapter at all; anything that fails it is {a|inventory}, {a|investment property} or an {x|expense}.","Property, plant and equipment are tangible items that are:","1. held **for use** in the production or supply of goods or services, for rental to others, or for administrative purposes, and","2. expected to be used during **more than one period**.","PPE is grouped into **classes** of similar assets: land, buildings, machinery, vehicles, furniture, IT equipment and so on.","+ The measurement model (cost or revaluation) is chosen **per class**, so the class matters later.","- Land or buildings held to earn rent or for capital growth are **{a|investment property}** (B1.3), not PPE."],"id":"rule-1lo2vg","sect":1,"part":"Classify"},{"type":"think","bucket":"classify","lo":14,"scenario":"Punggol Robotics buys a plot for a new factory. It pays $4,200,000 for the land, stamp duty $126,000, legal fees $60,000, and $180,000 to clear the site and knock down an old shed, whose scrap sells for $40,000. It then builds a private road ($300,000), a fence ($50,000), a sprinkler system ($90,000) and the factory ($9,000,000).","prompt":"Land is never depreciated. So which of these costs belong to the land, and which belong somewhere that wears out?","answer":["**{a|Land}:** everything it took to get a clear plot ready to build on: price, stamp duty, legal fees, clearing and demolition, **less** the scrap proceeds. 4,200,000 + 126,000 + 60,000 + 180,000 − 40,000 = **$4,526,000**.","**{a|Land improvements}:** the road, fence and sprinklers. They wear out, so they are a separate asset that **is** depreciated: 300,000 + 50,000 + 90,000 = **$440,000**.","**{a|Building}:** the factory, $9,000,000, depreciated over its own life.","Land lasts for ever; fences fall over. Lumping them together would hide {x|depreciation} for decades."],"id":"think-1j8aj4","sect":1,"part":"Classify"},{"type":"rule","bucket":"classify","lo":14,"title":"Land, land improvements, buildings","body":["Punggol Robotics showed the problem: {a|land} is never depreciated, so anything wrongly parked there escapes {x|depreciation} for ever. The fix is to split site costs three ways.","The approach your textbooks use (and the practice paper tests):","1. **{a|Land}** (not depreciated): purchase price, legal fees, stamp duty, and clearing the site or demolishing an old building **less salvage proceeds**.","2. **{a|Land improvements}** (depreciated): private roads, fences, car parks, sprinkler and lighting systems.","3. **{a|Buildings}** (depreciated): the new structure, as a separate asset.","! Two classic traps: forgetting to **deduct salvage proceeds** from the land cost, and putting roads and fences into **{a|land}**, where they would never be depreciated."],"id":"rule-1y1al1","sect":1,"part":"Classify"},{"type":"diagram","bucket":"classify","lo":14,"title":"Punggol Robotics: three homes for site costs","intro":"Every site cost lands in one of three assets. Only one of them is never depreciated.","notes":{"price":"The purchase price of the plot.","stamp":"Stamp duty is part of **acquiring** the {a|land}.","legal":"Legal fees on the purchase: also part of acquiring the {a|land}.","demo":"Clearing the site and knocking down the old shed get the {a|land} ready for its intended use.","salv":"Scrap proceeds **reduce** the {a|land} cost. Forget this and you overstate {a|land}.","land":"4,200,000 + 126,000 + 60,000 + 180,000 − 40,000 = 4,526,000. {a|Land} has an unlimited life, so no {x|depreciation}.","li":"{a|Land improvements}: road + fence + sprinklers = 440,000. A separate asset, depreciated over their own useful lives.","bldg":"The factory is its own {a|building} asset, depreciated over its life.","road":"A private road wears out: {a|land improvement}.","fence":"Fences wear out: {a|land improvement}.","spr":"A sprinkler system wears out: {a|land improvement} (not “landscaping” to expense).","bcost":"Construction cost of the new factory."},"walk":[{"nodes":["pric