s-Serif\" font-size=\"10.00\" fill=\"#374151\"> 2 yrs \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>rev\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M684.9,-71.64C684.9,-71.64 645.87,-71.64 645.87,-71.64 639.87,-71.64 633.87,-65.64 633.87,-59.64 633.87,-59.64 633.87,-44 633.87,-44 633.87,-38 639.87,-32 645.87,-32 645.87,-32 684.9,-32 684.9,-32 690.9,-32 696.9,-38 696.9,-44 696.9,-44 696.9,-59.64 696.9,-59.64 696.9,-65.64 690.9,-71.64 684.9,-71.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"642.51\" y=\"-57.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Reversal\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"648.88\" y=\"-46.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">78,383\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"651.13\" y=\"-37.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">→ P&amp;L\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>y5&#45;&gt;rev\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M547.57,-75.66C571.74,-70.73 602.39,-64.47 626.23,-59.61\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"626.45,-61.71 631.91,-58.45 625.61,-57.59 626.45,-61.71\"/>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>ceil\u003c/title>\n\u003cpath fill=\"#f3eeff\" stroke=\"#6d28d9\" stroke-width=\"1.2\" d=\"M547.12,-41.64C547.12,-41.64 466.09,-41.64 466.09,-41.64 460.09,-41.64 454.09,-35.64 454.09,-29.64 454.09,-29.64 454.09,-12 454.09,-12 454.09,-6 460.09,0 466.09,0 466.09,0 547.12,0 547.12,0 553.12,0 559.12,-6 559.12,-12 559.12,-12 559.12,-29.64 559.12,-29.64 559.12,-35.64 553.12,-41.64 547.12,-41.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"488.23\" y=\"-27.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Ceiling\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"462.73\" y=\"-16.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">no&#45;impairment CA\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"487.1\" y=\"-5.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">600,000\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>ceil&#45;&gt;rev\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M559.38,-31.06C581.3,-35.39 606.38,-40.35 626.53,-44.33\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"625.93,-46.36 632.23,-45.46 626.75,-42.24 625.93,-46.36\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"596.5\" y=\"-44.41\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> capped at \u003c/text>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>ra\u003c/title>\n\u003cpath fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1.2\" d=\"M388.34,-40.64C388.34,-40.64 308.06,-40.64 308.06,-40.64 302.06,-40.64 296.06,-34.64 296.06,-28.64 296.06,-28.64 296.06,-13 296.06,-13 296.06,-7 302.06,-1 308.06,-1 308.06,-1 388.34,-1 388.34,-1 394.34,-1 400.34,-7 400.34,-13 400.34,-13 400.34,-28.64 400.34,-28.64 400.34,-34.64 394.34,-40.64 388.34,-40.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"304.7\" y=\"-26.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">New recoverable\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"328.7\" y=\"-15.87\" font-family=\"Helvetica,sans-Serif\" font-size=\"11.00\" fill=\"#111827\">650,000\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"313.32\" y=\"-6.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">above the ceiling\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>ra&#45;&gt;ceil\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M400.85,-20.82C415.45,-20.82 431.46,-20.82 446.47,-20.82\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"446.23,-22.92 452.23,-20.82 446.23,-18.72 446.23,-22.92\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"middle\" x=\"427.21\" y=\"-24.07\" font-family=\"Helvetica,sans-Serif\" font-size=\"10.00\" fill=\"#374151\"> ✗ \u003c/text>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"visual","bucket":"derecognise","lo":39,"title":"Tanjong’s press, year by year","html":"\u003cp>The same press as a moving picture. On the left, the real \u003cspan class=\"el el-a\">carrying amount\u003c/span>: the third year of normal \u003cspan class=\"el el-x\">depreciation\u003c/span>, the \u003cspan class=\"el el-x\">impairment\u003c/span>, two years of the smaller charge, then the \u003cspan class=\"el el-i\">reversal\u003c/span>. On the right, the path with no impairment at all: that path is the ceiling. Watch where the reversal stops.\u003c/p>\u003cdiv class=\"wg\" data-wg=\"roll\" data-key=\"press-b3\" data-cfg=\"{&quot;target&quot;:{&quot;v&quot;:600000,&quot;label&quot;:&quot;ceiling 600,000&quot;},&quot;panels&quot;:[{&quot;title&quot;:&quot;Impaired in 20X3&quot;,&quot;sub&quot;:&quot;what actually happened&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:960000,&quot;startCap&quot;:&quot;Bought on 1 Jan 20X1 for {a|1,200,000}; after 2 years at {x|120,000} it starts 20X3 at {a|960,000}.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X3&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-120000,&quot;cap&quot;:&quot;20X3: {a|960,000} − {x|depreciation 120,000} = {a|840,000}.&quot;},{&quot;name&quot;:&quot;impairment&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-109737,&quot;cap&quot;:&quot;Demand collapses. Recoverable amount = higher of FVLCOD 595,000 and VIU 730,263 = 730,263, so {x|impairment loss} = {a|840,000} − 730,263 = {x|109,737} → P&amp;L.&quot;}]},{&quot;label&quot;:&quot;20X4&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-104323,&quot;cap&quot;:&quot;20X4: {a|730,263} − {x|depreciation 104,323} = {a|625,940}. The **new, lower** charge: {a|730,263} ÷ 7 years.&quot;}]},{&quot;label&quot;:&quot;20X5&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-104323,&quot;cap&quot;:&quot;20X5: {a|625,940} − {x|depreciation 104,323} = {a|521,617}.&quot;},{&quot;name&quot;:&quot;reversal&quot;,&quot;el&quot;:&quot;i&quot;,&quot;v&quot;:78383,&quot;cap&quot;:&quot;Demand revives: recoverable amount 650,000, but the ceiling is the {a|no-impairment carrying amount} 600,000. {i|Reversal} = 600,000 − {a|521,617} = {i|78,383} → P&amp;L.&quot;}]}]},{&quot;title&quot;:&quot;Never impaired&quot;,&quot;sub&quot;:&quot;the ceiling path&quot;,&quot;el&quot;:&quot;a&quot;,&quot;bal&quot;:&quot;Carrying amount&quot;,&quot;start&quot;:960000,&quot;startCap&quot;:&quot;Same press, same {a|960,000} on 1 Jan 20X3, but no impairment ever: just {x|120,000} a year.&quot;,&quot;years&quot;:[{&quot;label&quot;:&quot;20X3&quot;,&quot;hold&quot;:&quot;No impairment here, so nothing else moves.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-120000,&quot;cap&quot;:&quot;20X3: {a|960,000} − {x|120,000} = {a|840,000}.&quot;}]},{&quot;label&quot;:&quot;20X4&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-120000,&quot;cap&quot;:&quot;20X4: {a|840,000} − {x|120,000} = {a|720,000}.&quot;}]},{&quot;label&quot;:&quot;20X5&quot;,&quot;hold&quot;:&quot;Nothing to reverse: this path **is** the ceiling, {a|600,000}.&quot;,&quot;parts&quot;:[{&quot;name&quot;:&quot;depreciation&quot;,&quot;el&quot;:&quot;x&quot;,&quot;v&quot;:-120000,&quot;cap&quot;:&quot;20X5: {a|720,000} − {x|120,000} = {a|600,000}.&quot;}]}]}],&quot;notes&quot;:{&quot;start&quot;:&quot;Both paths start on 1 Jan 20X3 at {a|960,000} (cost 1,200,000 less two years at 120,000). Left: what happened. Right: what would have happened with no impairment. Press Play or Next.&quot;,&quot;parts&quot;:[&quot;Every year: {x|depreciation} comes out of the {a|carrying amount}.&quot;,&quot;Event years only: an {x|impairment} drops it to recoverable amount; a {i|reversal} lifts it back, never above the dashed ceiling.&quot;],&quot;end&quot;:&quot;**The reversal lands exactly on the right-hand path.** Recoverable amount (650,000) is higher, but the press can only go back to where it would have been with no impairment: 1,200,000 − 5 × 120,000 = 600,000. Reversing up to 650,000 would be a revaluation in disguise.&quot;}}\">\u003c/div>","id":"visual-a3v5d5","sect":5,"part":"Derecognise / transfer"},{"id":"calc-66g66a","type":"calc","bucket":"derecognise","lo":39,"q":"Tanjong Printing’s {a|press} cost $1,200,000 on 1 Jan 20X1 (10-year life, no residual value, straight-line, cost model). At 31 Dec 20X3 it was impaired to its recoverable amount of $730,263, then depreciated at $104,323 a year for 20X4 and 20X5. At 31 Dec 20X5 its recoverable amount has risen to $650,000. What reversal of impairment does Tanjong recognise?","answer":78383,"unit":"$","working":["{a|Current carrying amount}: 730,263 − 2 × 104,323 = 521,617.","Ceiling ({a|no-impairment carrying amount}): 1,200,000 − 5 × 120,000 = 600,000. Lower of that and 650,000 = 600,000.","{i|Reversal} = 600,000 − 521,617 = **$78,383**: Dr {a|Accumulated depreciation and impairment} / Cr {i|Reversal of impairment loss}."],"sect":5,"part":"Derecognise / transfer"},{"id":"mcq-4o1tz4","type":"mcq","bucket":"derecognise","lo":39,"q":"Two years ago a CGU’s {x|impairment loss} wiped out its {a|goodwill} and reduced its {a|equipment}. This year the CGU’s recoverable amount has risen well above its {a|carrying amount}. What may be reversed?","options":[{"t":"The {a|goodwill} and {a|equipment} losses in full","why":"{a|Goodwill} impairment is never reversed."},{"t":"The {a|goodwill} first, then the {a|equipment}","why":"{a|Goodwill} impairment is never reversed, so it isn’t first in line on the way back up."},{"t":"The {a|equipment} loss only, up to its {a|no-impairment carrying amount}","ok":true,"why":"{a|Goodwill} stays written down. Other assets may be reversed, capped at what they would have been with no impairment."},{"t":"Nothing: impairment losses are never reversed","why":"Losses on assets other than {a|goodwill} can be reversed when the indicators reverse."}],"sect":5,"part":"Derecognise / transfer"},{"type":"compare","bucket":"derecognise","lo":39,"special":"Nothing is derecognised: the “way back” is a **reversal**, capped at the {a|carrying amount} with no impairment, and **never for {a|goodwill}**.","id":"compare-1kumyt-4","sect":5,"part":"Derecognise / transfer"},{"type":"map","id":"map-6-present","bucket":"present","sect":6,"part":"Present & disclose"},{"id":"think-kuqf84","type":"think","bucket":"present","lo":39,"scenario":"An analyst reads that a shipping company booked a $40m {x|impairment} this year.","prompt":"What would the analyst want to find in the notes before trusting that number?","answer":["Where it went (which line in P&L, or OCI), which assets or segments it hit, and **why**: what events caused it.","And how recoverable amount was measured: **FVLCOD or value in use**, and for value in use, the **discount rate**. A 1% change in the rate can move the answer a lot."],"sect":6,"part":"Present & disclose"},{"type":"rule","bucket":"present","lo":39,"title":"Presentation and disclosure","body":["Last stop: the numbers are booked, so how do readers find them? The disclosures answer the analyst’s questions from the previous page.","- {x|Impairment losses} (and {i|reversals}) on cost-model assets are presented in **profit or loss**; on revalued assets, the part against the {e|surplus} is in **OCI**.","- In the {a|PPE} reconciliation, {x|impairment losses} and {i|reversals} are shown as separate movements.","For each **class** of assets, disclose:","1. {x|impairment losses} and {i|reversals} recognised in **P&L** (and the line items)","2. {x|impairment losses} and {i|reversals} recognised in **OCI** on revalued assets","For a material impairment or reversal, also disclose:","- the **events and circumstances** that led to it","- the asset or CGU and the amount","- whether recoverable amount is **FVLCOD or value in use**, and the **discount rate** used for value in use"],"id":"rule-7bdyl1","sect":6,"part":"Present & disclose"},{"id":"mcq-1ur0li","type":"mcq","bucket":"present","lo":39,"q":"An entity recognises a material {x|impairment loss} measured using value in use. Which of the following must it disclose?","options":[{"t":"The discount rate used to measure value in use","ok":true,"why":"Recoverable amount, how it was measured (VIU here) and the discount rate are all disclosed."},{"t":"The value in use of every asset that was not impaired","why":"Not required. Disclosures focus on the losses and reversals recognised."},{"t":"Nothing, as long as the loss is shown in profit or loss","why":"Material impairments need disclosure of what caused them and how recoverable amount was measured."},{"t":"The original cost of goodwill on every acquisition ever made","why":"Not required."}],"sect":6,"part":"Present & disclose"},{"type":"examtypes","id":"examtypes","bucket":"wrap","sect":7,"part":"Wrap-up"},{"type":"summary","lo":39,"title":"Impairment on one page","rows":[["When is an asset impaired?","{a|Carrying amount} > recoverable amount."],["Which assets?","{a|PPE}, {a|intangibles}, {a|goodwill}, {a|IP at cost}, {a|ROU assets}. Not {a|inventory}, {a|financial assets} or {a|IP at fair value}."],["When must you test?","When there is an indication; every year for **G-I-N**: {a|goodwill}, indefinite-life intangibles, intangibles not yet in use."],["Indicators?","External: market value, adverse changes, interest rates up, net assets > market cap. Internal: damage or obsolescence, change in use, poor performance."],["Recoverable amount?","The **higher** of FVLCOD and value in use."],["Value in use?","PV of cash flows from use and final disposal; no financing, tax, uncommitted restructuring or upgrades."],["Where does the loss go?","Cost model: {x|Impairment loss} in P&L. Revalued: this asset’s {e|Revaluation surplus (OCI)} first, then P&L."],["CGU loss?","{a|Goodwill} first, then pro rata; no asset below the highest of FVLCOD, VIU and zero."],["After the loss?","Depreciate the {a|new carrying amount} over the remaining life."],["Reversal?","Up to the {a|no-impairment carrying amount}; never for {a|goodwill}."]],"id":"summary-ihfs53","bucket":"wrap","sect":7,"part":"Wrap-up"}],"quiz":{"cases":{"marina":{"name":"Marina Precision","text":["Marina Precision Pte Ltd (Marina) makes machined parts. Its year ends on 31 December. On 1 January 20X2 it bought a {a|CNC machine} for $900,000, with a useful life of 9 years and no residual value. It uses the cost model and straight-line depreciation.","During 20X4, a competitor launched a faster machine and several of Marina’s customers moved their orders.","At 31 December 20X4, the machine could be sold for $470,000, with costs of disposal of $20,000. Marina expects net cash inflows from using it of $105,000 at the end of each of its remaining 6 years. The pre-tax discount rate is 10%."]},"serangoon":{"name":"Serangoon Heritage Hotel","text":["Serangoon Heritage Hotel Pte Ltd (Serangoon) owns its hotel building and measures it under the revaluation model. Its year ends on 31 December 20X5.","At 31 December 20X5, after depreciation for the year, the building’s {a|carrying amount} is $2,400,000. The {e|revaluation surplus} relating to this building is $150,000.","A collapse in tourist arrivals is an indication of impairment. The building’s fair value less costs of disposal is $2,100,000 and its value in use is $2,180,000. Its remaining useful life is 20 years, with no residual value."]}},"questions":[{"id":"q1","case":"marina","lo":38,"type":"indicator","q":"Which of the following is the indicator of impairment in Marina’s case?","options":[{"t":"The machine is now three years old","pit":"normal-decline","why":"Age alone is normal use, which depreciation already covers."},{"t":"A competitor’s new technology and the loss of customer orders","ok":true,"why":"A significant adverse change in technology and the market: an external indicator."},{"t":"Marina uses straight-line depreciation","why":"A depreciation method is not a sign of impairment."},{"t":"The machine’s fair value is lower than its original cost","pit":"normal-decline","why":"Fair value below **cost** is normal for a used asset. The test compares with {a|carrying amount}, and only an unexpected fall is an indicator."}]},{"id":"q2","case":"marina","lo":39,"type":"recoverable","q":"What is the machine’s recoverable amount at 31 December 20X4?","options":[{"t":"$450,000","pit":"lower-of","why":"That is FVLCOD, the lower of the two measures. Recoverable amount is the higher."},{"t":"$470,000","pit":"gross-fv","why":"Fair value before costs of disposal. FVLCOD deducts them."},{"t":"$457,302","ok":true,"why":"FVLCOD 470,000 − 20,000 = 450,000; VIU 105,000 × 4.3553 = 457,302. The higher is 457,302."},{"t":"$630,000","pit":"undiscounted","why":"Undiscounted cash flows. Value in use is a present value."}]},{"id":"q3","case":"marina","lo":39,"type":"recoverable","q":"What {x|impairment loss} should Marina recognise for 20X4?","options":[{"t":"$150,000","pit":"lower-of","why":"Uses FVLCOD, the lower measure."},{"t":"$142,698","ok":true,"why":"{a|Carrying amount} 900,000 − 3 × 100,000 = 600,000; less recoverable amount 457,302 = 142,698."},{"t":"$130,000","pit":"gross-fv","why":"Compares with gross fair value, ignoring costs of disposal (and it is above VIU only because the costs were left out)."},{"t":"$442,698","why":"Compares recoverable amount with **{a|cost}**, not {a|carrying amount}."}]},{"id":"q4","case":"marina","lo":39,"type":"loss-entry","q":"Which journal entry records the impairment?","options":[{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":142698,"el":"e"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":142698,"el":"a"}],"pit":"reval-all-oci","why":"Marina uses the cost model: there is no {e|revaluation surplus}. The {x|loss} goes to P&L."},{"je":[{"side":"Dr","account":"Impairment loss","amount":142698,"el":"x"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":142698,"el":"a"}],"ok":true,"why":"Cost model: the 142,698 {x|loss} goes straight to profit or loss."},{"je":[{"side":"Dr","account":"Impairment loss","amount":142698,"el":"x"},{"side":"Cr","account":"Provision for impairment","amount":142698,"el":"l"}],"why":"An impairment reduces the asset; it is not a {l|liability}."},{"je":[{"side":"Dr","account":"Retained earnings","amount":142698,"el":"e"},{"side":"Cr","account":"Machine","amount":142698,"el":"a"}],"why":"The {x|loss} goes through profit or loss, not directly to {e|retained earnings}."}]},{"id":"q5","case":"marina","lo":39,"type":"dep-after","q":"What is the {x|depreciation charge} on the machine for 20X5?","options":[{"t":"$100,000","pit":"old-dep","why":"The {x|old charge}. After an impairment, the {a|new carrying amount} is spread over the remaining life."},{"t":"$76,217","ok":true,"why":"457,302 ÷ 6 remaining years = 76,217."},{"t":"$50,811","why":"Divides by the original life. Use the remaining life."},{"t":"$75,000","pit":"lower-of","why":"Starts from FVLCOD, but the machine is carried at the higher VIU."}]},{"id":"q6","case":"serangoon","lo":39,"type":"recoverable","q":"What is the hotel building’s recoverable amount at 31 December 20X5?","options":[{"t":"$2,100,000","pit":"lower-of","why":"The lower of the two. Recoverable amount is the higher."},{"t":"$2,180,000","ok":true,"why":"Higher of FVLCOD 2,100,000 and VIU 2,180,000."},{"t":"$2,400,000","why":"That is the {a|carrying amount} being tested."},{"t":"$2,250,000","why":"Deducting the {e|surplus} doesn’t give a recoverable amount; it is not a measure of the building’s value."}]},{"id":"q7","case":"serangoon","lo":39,"type":"revalued-loss","q":"How should Serangoon recognise the {x|impairment loss}?","options":[{"t":"$220,000 in profit or loss","pit":"reval-all-pl","why":"A revalued asset first uses up its own {e|revaluation surplus}."},{"t":"$220,000 against the {e|revaluation surplus} in OCI","pit":"reval-all-oci","why":"The {e|surplus} is only 150,000; the excess must go to P&L."},{"t":"$150,000 against the {e|revaluation surplus} (OCI) and $70,000 in profit or loss","ok":true,"why":"{x|Loss} 2,400,000 − 2,180,000 = 220,000. {e|Surplus} first (150,000), the remaining 70,000 to P&L."},{"t":"$70,000 in profit or loss only; the {e|surplus} is left intact","why":"The {e|surplus} is used first, not skipped."}]},{"id":"q8","case":"serangoon","lo":39,"type":"revalued-loss","q":"Which journal entry records the impairment?","options":[{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":150000,"el":"e"},{"side":"Dr","account":"Impairment loss","amount":70000,"el":"x"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":220000,"el":"a"}],"ok":true,"why":"{e|Surplus} 150,000 first, then 70,000 to P&L; the {a|building} comes down by 220,000."},{"je":[{"side":"Dr","account":"Impairment loss","amount":220000,"el":"x"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":220000,"el":"a"}],"pit":"reval-all-pl","why":"Ignores the {e|revaluation surplus} on this building."},{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":150000,"el":"e"},{"side":"Dr","account":"Retained earnings","amount":70000,"el":"e"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":220000,"el":"a"}],"why":"The excess goes through profit or loss, not straight to {e|retained earnings}."},{"je":[{"side":"Dr","account":"Impairment loss","amount":220000,"el":"x"},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":150000,"el":"e"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":70000,"el":"a"}],"why":"Back to front: this credits the {e|surplus} and only partly reduces the building."}]},{"id":"q9","case":"serangoon","lo":39,"type":"dep-after","q":"What is the {x|depreciation charge} on the building for 20X6?","options":[{"t":"$120,000","pit":"old-dep","why":"Uses the {a|carrying amount} before the impairment."},{"t":"$109,000","ok":true,"why":"2,180,000 ÷ 20 = 109,000."},{"t":"$105,000","pit":"lower-of","why":"Starts from FVLCOD, but the building is now carried at the higher VIU."},{"t":"Nil: an impaired asset is no longer depreciated","why":"It is still used, so it is still depreciated, from its {a|new carrying amount}."}]},{"id":"q10","case":"serangoon","lo":39,"type":"revalued-loss","q":"Suppose instead that the {e|revaluation surplus} on the building had been $300,000. What would the effect be?","options":[{"t":"{e|Revaluation surplus} reduced by $220,000 to $80,000; nothing in profit or loss","ok":true,"why":"The {e|surplus} covers the whole loss, so P&L is untouched."},{"t":"$220,000 in profit or loss; {e|surplus} unchanged at $300,000","pit":"reval-all-pl","why":"The {e|surplus} is used first."},{"t":"{e|Surplus} reduced to nil; $80,000 {i|gain} in profit or loss","why":"Only the loss amount is taken from the {e|surplus}. There is no gain."},{"t":"$150,000 against the {e|surplus} and $70,000 in profit or loss, as before","why":"With a 300,000 {e|surplus}, all of the 220,000 is absorbed."}]},{"id":"q11","lo":37,"type":"scope","q":"Which of the following is NOT within the scope of SFRS(I) 1-36, Impairment of Assets?","options":[{"t":"Goodwill acquired in a business combination","why":"In scope, and tested every year."},{"t":"A right-of-use asset held by a lessee","why":"In scope, like PPE."},{"t":"Inventories of finished goods","ok":true,"why":"{a|Inventory} is written down to net realisable value under SFRS(I) 1-2."},{"t":"Plant carried under the revaluation model","why":"In scope: a revalued asset can still be impaired."}]},{"id":"q12","lo":37,"type":"annual-test","q":"With reference to SFRS(I) 1-36, which of the following must be tested for impairment annually, whether or not there is any indication of impairment?","options":[{"t":"All property, plant and equipment","pit":"test-all","why":"{a|PPE} is tested only when there is an indication."},{"t":"Intangible assets with finite useful lives","why":"Finite-life intangibles are amortised and tested only on an indication."},{"t":"Intangible assets with indefinite useful lives","ok":true,"why":"The I in G-I-N: tested every year."},{"t":"Investment property under the fair value model","why":"Not in scope at all: already at fair value."}]},{"id":"q13","lo":38,"type":"indicator","q":"Which of the following is NOT an indicator of impairment?","options":[{"t":"The carrying amount of the entity’s net assets is more than its market capitalisation","why":"That is an external indicator."},{"t":"Market interest rates have increased significantly during the period","why":"Higher rates lower value in use: an external indicator."},{"t":"A machine’s market value has fallen in line with its expected wear and tear","ok":true,"why":"An expected fall is what {x|depreciation} captures. Only a fall significantly more than expected is an indicator."},{"t":"Management plans to dispose of an asset before the end of its expected life","why":"A significant adverse change in use: an internal indicator."}]},{"id":"q14","lo":39,"type":"viu-cashflows","q":"Which of the following should be included in the cash flow projections used to measure value in use?","options":[{"t":"Cash outflows for maintenance needed to keep the asset in its current condition","ok":true,"why":"Outflows needed to generate the asset’s inflows are included."},{"t":"Cash inflows from a planned upgrade that will increase the asset’s output","pit":"viu-future","why":"Enhancements beyond the asset’s current condition are excluded."},{"t":"Interest payable on the loan that financed the asset","pit":"viu-finance","why":"Financing cash flows are excluded."},{"t":"Income tax payable on profits from using the asset","pit":"viu-finance","why":"Income tax cash flows are excluded."}]},{"id":"q15","lo":39,"type":"recoverable","q":"With reference to SFRS(I) 1-36, how is the recoverable amount of an asset defined?","options":[{"t":"The lower of its fair value less costs of disposal and its value in use","pit":"lower-of","why":"It is the higher, not the lower."},{"t":"The higher of its fair value less costs of disposal and its value in use","ok":true,"why":"A rational owner would sell or keep using it, whichever gives more."},{"t":"Its fair value at the reporting date","pit":"gross-fv","why":"Fair value alone ignores costs of disposal and value in use."},{"t":"The undiscounted future cash flows from its use","pit":"undiscounted","why":"Value in use is a present value, and it is only one of the two measures."}]},{"id":"q16","lo":39,"type":"reversal","q":"Which of the following impairment losses may NEVER be reversed?","options":[{"t":"An impairment loss on a building under the cost model","why":"May be reversed, up to the {a|no-impairment carrying amount}."},{"t":"An impairment loss on goodwill","ok":true,"why":"{a|Goodwill} impairment is never reversed."},{"t":"An impairment loss on a revalued machine","why":"May be reversed."},{"t":"An impairment loss on a licence with a finite life","why":"May be reversed, subject to the ceiling."}]},{"id":"q17","lo":37,"type":"scope","q":"Which of the following best describes a cash-generating unit?","options":[{"t":"Every asset that is expected to generate cash in the future","why":"Many assets don’t generate cash independently; that’s why CGUs exist."},{"t":"The whole entity, which is always tested as one unit","why":"The CGU is the **smallest** group with largely independent cash inflows, usually far smaller than the entity."},{"t":"The smallest identifiable group of assets that generates cash inflows largely independent of other assets or groups","ok":true,"why":"That is the definition."},{"t":"A group of assets that is about to be sold","why":"That describes a disposal group, a different idea."}]},{"id":"q18","lo":39,"type":"reversal","q":"A machine cost $500,000 and has a 10-year life with no residual value (straight-line, cost model). At the end of year 2 it was impaired to its recoverable amount of $320,000. At the end of year 4 the indicators have reversed and its recoverable amount is $330,000. What {i|reversal} is recognised?","options":[{"t":"$90,000","pit":"reverse-cap","why":"Writes it up to the new recoverable amount, above the 300,000 it would have been carried at with no impairment."},{"t":"$80,000","pit":"reverse-cap","why":"The original {x|loss}. The ceiling is the {a|no-impairment carrying amount} now, after two more years of {x|depreciation}."},{"t":"$60,000","ok":true,"why":"{a|Carrying amount} 320,000 − 2 × 40,000 = 240,000. Ceiling 500,000 − 4 × 50,000 = 300,000. {i|Reversal} 300,000 − 240,000 = 60,000."},{"t":"Nil: impairment losses cannot be reversed","pit":"reverse-gw","why":"Only {a|goodwill} impairment can never be reversed."}]},{"id":"q19","lo":39,"type":"disclosure","q":"An entity recognises a material impairment loss on a CGU, measured at value in use. Which disclosure is required?","options":[{"t":"The events and circumstances that led to the loss, and the discount rate used","ok":true,"why":"Required for a material impairment, along with the amount and the basis of recoverable amount."},{"t":"Only the total of all impairment losses, with no further detail","why":"Material losses need the cause and the measurement basis too."},{"t":"The value in use of every CGU in the group, impaired or not","why":"Not required for this LO."},{"t":"Nothing, because the loss is already in profit or loss","why":"Recognising it doesn’t remove the need to explain it."}]}]},"exam":{"cases":{"pasir":{"name":"Pasir Panjang Ferries","text":["Pasir Panjang Ferries Pte Ltd (PPF) runs a ferry division, acquired in a business combination in 20X3. The division is a cash-generating unit. PPF’s year ends on 31 December and it uses the cost model for all assets.","At 31 December 20X6 the division’s {a|carrying amounts} are: {a|goodwill} $300,000, {a|vessels} $1,500,000, {a|terminal building} $1,000,000 and an {a|operating licence} $500,000.","There is no indication of impairment for the individual assets. The division’s recoverable amount at 31 December 20X6 is $2,700,000. The terminal building’s fair value less costs of disposal is $940,000; no separate recoverable amount can be determined for the vessels or the licence.","The vessels have a remaining useful life of 12 years from 1 January 20X7, with no residual value."]},"bukit":{"name":"Bukit Timah Labs","text":["Bukit Timah Labs Pte Ltd (BTL) owns a research building measured under the revaluation model. Its year ends on 31 December.","On 31 December 20X3 the building was revalued to $3,000,000, its remaining useful life was 25 years with no residual value, and the {e|revaluation surplus} on the building was $250,000. BTL does not transfer any {e|surplus} to {e|retained earnings} as the building is used.","In late 20X4 BTL’s largest research client ended its contract. At 31 December 20X4 the building’s fair value is $2,450,000 and costs of disposal would be $50,000.","Management forecasts net cash inflows from using the building of $260,000 at the end of each of its remaining 24 years, using a pre-tax discount rate of 9%. This forecast excludes {x|interest} of $45,000 a year on the building’s {l|mortgage}, {x|income tax} of about $30,000 a year, and savings of $40,000 a year from a reorganisation the board has not yet approved."]}},"questions":[{"id":"x1","case":"pasir","lo":37,"type":"annual-test","q":"There is no indication of impairment for any individual asset. Why must PPF test the ferry division at 31 December 20X6?","options":[{"t":"Because vessels are specialised assets","pit":"test-all","why":"Specialised PPE is tested only on an indication."},{"t":"Because a CGU to which goodwill has been allocated is tested every year","ok":true,"why":"{a|Goodwill} is tested annually, and since it has no cash flows of its own, it is tested with its CGU."},{"t":"Because all CGUs must be tested every year","pit":"test-all","why":"Only CGUs carrying goodwill (or the other G-I-N assets) need an annual test."},{"t":"It need not: with no indication, no test is required","pit":"miss-gin","why":"{a|Goodwill} must be tested every year, indication or not."}]},{"id":"x2","case":"pasir","lo":39,"type":"cgu","q":"How much of the division’s {x|impairment loss} is allocated to {a|goodwill}?","options":[{"t":"$54,545","pit":"cgu-prorata-gw","why":"Spreads the loss pro rata over all assets, {a|goodwill} included. {a|Goodwill} goes first."},{"t":"$300,000","ok":true,"why":"CGU {x|loss} = 3,300,000 − 2,700,000 = 600,000. {a|Goodwill} absorbs the first 300,000, writing it off entirely."},{"t":"$600,000","why":"{a|Goodwill} can only be reduced to nil. The rest of the loss goes to the other assets."},{"t":"Nil: goodwill is only written off if the business is sold","why":"{a|Goodwill} is the first asset to absorb a CGU’s impairment loss."}]},{"id":"x3","case":"pasir","lo":39,"type":"cgu","q":"How much of the {x|impairment loss} is allocated to the {a|vessels}?","options":[{"t":"$150,000","why":"Correct pro rata share before the floor. But the terminal can’t go below its FVLCOD of 940,000, so 40,000 of its share is re-spread to the vessels and licence."},{"t":"$180,000","ok":true,"why":"After {a|goodwill}, 300,000 is spread pro rata: {a|vessels} 150,000, {a|terminal} 100,000, {a|licence} 50,000. The terminal is capped at 60,000 (floor 940,000); the excess 40,000 goes to vessels and licence 3:1, so vessels take 150,000 + 30,000 = 180,000."},{"t":"$272,727","pit":"cgu-prorata-gw","why":"Spreads the whole loss pro rata over all assets including {a|goodwill}."},{"t":"$300,000","why":"Puts all of the post-goodwill loss on one asset instead of sharing it."}]},{"id":"x4","case":"pasir","lo":39,"type":"dep-after","q":"What is the {x|depreciation charge} on the {a|vessels} for 20X7?","options":[{"t":"$125,000","pit":"old-dep","why":"Uses the {a|carrying amount} before the impairment."},{"t":"$112,500","why":"Uses the pro rata allocation before the terminal’s floor pushed more loss onto the vessels."},{"t":"$110,000","ok":true,"why":"(1,500,000 − 180,000) ÷ 12 = 110,000."},{"t":"$102,273","pit":"cgu-prorata-gw","why":"Based on an allocation that spread the loss over {a|goodwill} pro rata too."}]},{"id":"x5","case":"pasir","lo":39,"type":"reversal","q":"At 31 December 20X8, a new port contract lifts the division’s recoverable amount well above its {a|carrying amount}. How should PPF account for this?","options":[{"t":"Reinstate {a|goodwill} of $300,000 first, then the other assets","pit":"reverse-gw","why":"{a|Goodwill} impairment is never reversed."},{"t":"Reverse the losses on the vessels, terminal and licence, each capped at its {a|no-impairment carrying amount}; {a|goodwill} stays written off","ok":true,"why":"{i|Reversals} are allowed for assets other than {a|goodwill}, up to what each would have been carried at with no impairment."},{"t":"Write the division’s assets up to the new recoverable amount","pit":"reverse-cap","why":"Reversals are capped at the {a|no-impairment carrying amounts}. The cost model doesn’t allow a write-up beyond that."},{"t":"No entry: impairment losses are never reversed","why":"Only {a|goodwill} losses are never reversed."}]},{"id":"x6","case":"bukit","lo":39,"type":"recoverable","q":"What is the building’s recoverable amount at 31 December 20X4?","options":[{"t":"$2,400,000","pit":"lower-of","why":"FVLCOD is the lower of the two measures here."},{"t":"$2,523,719","ok":true,"why":"VIU = 260,000 × 9.7066 (24-year annuity factor at 9%) = 2,523,719; FVLCOD 2,450,000 − 50,000 = 2,400,000. The higher is VIU."},{"t":"$6,240,000","pit":"undiscounted","why":"Undiscounted cash flows. VIU discounts them."},{"t":"$2,880,000","why":"That is the {a|carrying amount} being tested, not the recoverable amount."}]},{"id":"x7","case":"bukit","lo":39,"type":"revalued-loss","q":"How much of the {x|impairment loss} is recognised in profit or loss for 20X4?","options":[{"t":"$356,281","pit":"reval-all-pl","why":"Ignores the {e|revaluation surplus} on the building, which absorbs the first part."},{"t":"$106,281","ok":true,"why":"{a|Carrying amount} 3,000,000 − 120,000 = 2,880,000; {x|loss} 2,880,000 − 2,523,719 = 356,281. {e|Surplus} 250,000 first; 106,281 to P&L."},{"t":"Nil: the whole loss goes to OCI","pit":"reval-all-oci","why":"OCI can absorb only the 250,000 {e|surplus} on this building."},{"t":"$226,281","why":"Compares with the 20X3 revalued amount, ignoring 20X4 {x|depreciation}."}]},{"id":"x8","case":"bukit","lo":39,"type":"revalued-loss","q":"Which journal entry records the impairment at 31 December 20X4?","options":[{"je":[{"side":"Dr","account":"Impairment loss","amount":356281,"el":"x"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":356281,"el":"a"}],"pit":"reval-all-pl","why":"The {e|surplus} on the building is used first."},{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":356281,"el":"e"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":356281,"el":"a"}],"pit":"reval-all-oci","why":"Takes more than the {e|surplus} out of OCI; the {e|surplus} would go negative."},{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":250000,"el":"e"},{"side":"Dr","account":"Impairment loss","amount":106281,"el":"x"},{"side":"Cr","account":"Accumulated depreciation and impairment","amount":356281,"el":"a"}],"ok":true,"why":"250,000 against the {e|surplus}, 106,281 to P&L, building down by 356,281."},{"je":[{"side":"Dr","account":"Revaluation surplus (OCI)","amount":250000,"el":"e"},{"side":"Dr","account":"Impairment loss","amount":106281,"el":"x"},{"side":"Cr","account":"Provision for impairment","amount":356281,"el":"l"}],"why":"An impairment reduces the asset, not a {l|liability}."}]},{"id":"x9","case":"bukit","lo":39,"type":"dep-after","q":"What is the {x|depreciation charge} on the building for 20X5?","options":[{"t":"$120,000","pit":"old-dep","why":"The pre-impairment charge. {x|Depreciation} restarts from the {a|new carrying amount}."},{"t":"$105,155","ok":true,"why":"2,523,719 ÷ 24 remaining years = 105,155."},{"t":"$100,000","pit":"lower-of","why":"Starts from FVLCOD, the lower measure."},{"t":"$100,949","why":"Divides by the original life, not the remaining life."}]},{"id":"x10","case":"bukit","lo":39,"type":"viu-cashflows","q":"BTL’s finance director proposes adding the {l|mortgage} {x|interest}, the {x|income tax} and the $40,000 reorganisation savings to the value in use forecast. Which is correct?","options":[{"t":"Deduct the interest and tax, and add the savings","pit":"viu-finance","why":"Financing and tax cash flows are excluded, and so are savings from a reorganisation not yet committed."},{"t":"Add the savings only, as the reorganisation is likely","pit":"viu-future","why":"Until the entity is committed, the reorganisation’s effects are excluded."},{"t":"Deduct the interest only, as the building is financed by the mortgage","pit":"viu-finance","why":"How the building is financed doesn’t affect its value in use."},{"t":"None of them: the forecast already correctly excludes all three","ok":true,"why":"VIU excludes financing, income tax and uncommitted restructurings. The forecast is right as it stands."}]},{"id":"x11","lo":39,"type":"reversal","q":"A machine cost $2,000,000 on 1 January 20X1: 10-year life, no residual value, straight-line, cost model. At 31 December 20X3 it was impaired to $980,000. At 31 December 20X5, its recoverable amount has risen to $1,150,000. Which entry records the {i|reversal}?","options":[{"je":[{"side":"Dr","account":"Accumulated depreciation and impairment","amount":450000,"el":"a"},{"side":"Cr","account":"Reversal of impairment loss","amount":450000,"el":"i"}],"pit":"reverse-cap","why":"Writes up to the new recoverable amount. The ceiling is the {a|no-impairment carrying amount}, 1,000,000."},{"je":[{"side":"Dr","account":"Accumulated depreciation and impairment","amount":420000,"el":"a"},{"side":"Cr","account":"Reversal of impairment loss","amount":420000,"el":"i"}],"pit":"reverse-cap","why":"Reverses the original loss in full, ignoring two years of lower {x|depreciation} since."},{"je":[{"side":"Dr","account":"Accumulated depreciation and impairment","amount":300000,"el":"a"},{"side":"Cr","account":"Reversal of impairment loss","amount":300000,"el":"i"}],"ok":true,"why":"{a|Carrying amount} 980,000 − 2 × 140,000 = 700,000. Ceiling 2,000,000 − 5 × 200,000 = 1,000,000. {i|Reversal} 300,000 to P&L."},{"je":[{"side":"Dr","account":"Accumulated depreciation and impairment","amount":300000,"el":"a"},{"side":"Cr","account":"Revaluation surplus (OCI)","amount":300000,"el":"e"}],"why":"Under the cost model, the {i|reversal} goes to profit or loss, where the {x|loss} went."}]},{"id":"x12","lo":37,"type":"scope","q":"Which of the following assets is within the scope of SFRS(I) 1-36?","options":[{"t":"A rented-out office block under the fair value model","pit":"out-of-scope","why":"Fair-value investment property is remeasured every year under SFRS(I) 1-40."},{"t":"Debt securities measured at FVOCI","pit":"out-of-scope","why":"{a|Financial assets}: SFRS(I) 9."},{"t":"A rented-out office block under the cost model","ok":true,"why":"{a|Investment property} under the cost model is in scope."},{"t":"Work in progress in a factory","pit":"out-of-scope","why":"{a|Inventory}: lower of cost and NRV."}]},{"id":"x13","lo":37,"type":"annual-test","q":"At year end an entity holds: (1) goodwill; (2) a brand with an indefinite useful life; (3) a development project not yet available for use; (4) a machine that was damaged in a fire during the year. Which must be tested for impairment this year?","options":[{"t":"(1) only","pit":"miss-gin","why":"Indefinite-life intangibles and intangibles not yet in use are also tested every year."},{"t":"(1) and (2) only","pit":"miss-gin","why":"Leaves out the intangible not yet available for use, and the damaged machine."},{"t":"(1), (2) and (3) only","why":"Those three are tested every year, but the fire is an indication for the machine too."},{"t":"(1), (2), (3) and (4)","ok":true,"why":"G-I-N are tested annually; the machine has an indicator (physical damage)."}]},{"id":"x14","lo":38,"type":"indicator","q":"At 31 December, a listed company’s market capitalisation is 30% below the {a|carrying amount} of its net assets. Its machines are working normally. What should it do?","options":[{"t":"Nothing: share prices are outside management’s control","why":"Net assets above market capitalisation is an external indicator."},{"t":"Write its assets down by 30%","pit":"indicator-is-loss","why":"An indicator triggers a test, not an automatic write-down."},{"t":"Treat it as an indication of impairment and estimate the recoverable amount of the assets or CGUs concerned","ok":true,"why":"It is an indicator. The loss, if any, depends on the recoverable amounts."},{"t":"Revalue all PPE to fair value","why":"Impairment testing is not a revaluation."}]},{"id":"x15","lo":39,"type":"recoverable","q":"An asset has a {a|carrying amount} of $1,000,000. It could be sold for $900,000, with legal costs of $12,000 and removal costs of $8,000. A sale would also force repayment of a {l|loan}, with a $30,000 {x|break fee}, and trigger {x|income tax} of $20,000. Its value in use is $820,000. What is the {x|impairment loss}?","options":[{"t":"$100,000","pit":"gross-fv","why":"Uses fair value without deducting the costs of disposal."},{"t":"$120,000","ok":true,"why":"FVLCOD = 900,000 − 12,000 − 8,000 = 880,000 ({x|finance costs} and {x|tax} are not costs of disposal). Higher than VIU 820,000, so {x|loss} = 1,000,000 − 880,000 = 120,000."},{"t":"$170,000","pit":"viu-finance","why":"Deducts the break fee and tax as costs of disposal. They are finance and tax costs, which are excluded."},{"t":"$180,000","pit":"lower-of","why":"Uses the lower of the two measures."}]}]},"prepared":true},{"id":"revenue","code":"C1","title":"Revenue Recognition","subtitle":"SFRS(I) 15 · the five-step model","los":{"40":"Revenue: the five-step process","41":"Variable consideration","42":"Long-term construction contracts"},"accounts":[{"name":"Cash","el":"a"},{"name":"Accounts receivable","el":"a"},{"name":"Contract asset","el":"a"},{"name":"Contract liability","el":"l"},{"name":"Revenue","el":"i"},{"name":"Refund liability","el":"l"},{"name":"Right to recover returned goods","el":"a"},{"name":"Inventory","el":"a"},{"name":"Cost of sales","el":"x"},{"name":"Provision for onerous contract","el":"l"},{"name":"Loss on onerous contract","el":"x"},{"name":"Warranty provision","el":"l"},{"name":"Warranty expense","el":"x"},{"name":"Interest income","el":"i"},{"name":"Marketing expense","el":"x"}],"steps":[{"id":"contract","name":"Identify the contract","short":"Contract"},{"id":"pos","name":"Performance obligations","short":"Obligations"},{"id":"price","name":"Transaction price","short":"Price"},{"id":"allocate","name":"Allocate the price","short":"Allocate"},{"id":"recognise","name":"Recognise revenue","short":"Recognise"},{"id":"balances","name":"Contract balances and costs","short":"Balances"}],"map":{"contract":{"label":"Five criteria; length doesn’t matter"},"pos":{"label":"Distinct promises; principal or agent"},"price":{"label":"Expected entitlement, bonuses constrained","star":"Estimate variable consideration now, within the constraint"},"allocate":{"label":"Relative stand-alone selling prices"},"recognise":{"label":"Over time or at a point in time","star":"Control passing sets the timing; onerous {x|losses} hit at once"},"balances":{"label":"{a|Contract asset}, {a|receivable}, {l|contract liability}"}},"preamble":["Welcome to the chapter that decides the top line. **{i|Revenue}** is the first number anyone reads, so SFRS(I) 15 gives it one big idea: recognise it when (or as) the customer gets **control** of what they paid for, at the amount you **expect to be entitled to**. Not when the {a|cash} lands. {a|Cash} is a fan; {i|revenue} is a performance.","This chapter isn’t an asset or a liability, so it has its own route: the famous five steps, plus a last stop on the balance sheet.","1. **Contract:** is there a deal that counts? Five criteria.","2. **Obligations:** what separate things have we promised? Plus warranties and principal vs agent.","3. **Price:** how much do we expect to get, bonuses, returns and rebates included? ★ special","4. **Allocate:** share the price out by stand-alone selling price.","5. **Recognise:** over time or at a point in time, and long construction contracts. ★ special","6. **Balances:** {a|contract asset}, {a|receivable} or {l|contract liability}.","+ Memory hook: **COPAR** (Contract, Obligations, Price, Allocate, Recognise). This is one of the biggest topics on the paper: 4 of the 50 practice questions, all in the quizzes at the end."],"intros":{"contract":"Our first stop is the gatekeeper. Before any {i|revenue}, we check there is a real contract: approved, rights and payment terms clear, commercial substance, and collection probable. It’s short and mostly common sense. The trap is the things that **aren’t** on the list, like the contract’s length.","pos":"We have a contract, so what exactly did we promise? Here we cut it into **distinct** performance obligations, each with its own {i|revenue} timing later. Along the way: when a warranty is a separate service, and whether we sell the goods ourselves (principal, gross) or just arrange them (agent, commission).","price":"Now we know *what* we promised, time to put a number on it. ★ This is a special part: the price includes our best estimate of bonuses, returns and rebates **now**, using expected value or the most likely amount, held back only by the constraint. Plus three quick adjustments: financing, non-cash and payments to the customer.","allocate":"We have one price and several promises, so who gets what? Pretty mechanical: share the price out by **stand-alone selling price**, discount spread across everything. The only trick the exam plays is offering you the SSP instead of the allocated amount.","recognise":"Everything so far was set-up; this is where {i|revenue} finally hits P&L. ★ The special part: each obligation is satisfied **over time** (three tests) or **at a point in time** when control passes.","recognise|construction":"Over-time obligations need a progress measure, and construction contracts are the exam’s favourite. Cost-to-cost with the latest estimates, {i|revenue this year} = {i|to date} minus {i|last year}. ★ And the twist: if the contract turns loss-making, the **whole** {x|loss} hits now.","balances":"Last stop: the balance sheet. {i|Revenue} and {a|cash} rarely arrive together, and the gap has a name: **{l|contract liability}** if the customer paid first, **{a|contract asset}** if we performed first but still have work to do before we can bill, **{a|receivable}** once only time stands in the way. Plus a quick word on contract costs."},"pitfalls":{"length-criterion":"Treating the contract’s length or completion within 12 months as a contract criterion.","wait-for-cash":"Waiting for the {a|cash} (or “prudence”) before recognising {i|revenue} or variable consideration.","full-bonus-ev":"Mixing up the methods: the full bonus with expected value, or expected value when there are only two outcomes.","ssp-not-allocated":"Using the stand-alone selling price instead of the allocated share of the transaction price.","discount-one-item":"Putting the whole bundle discount on one item instead of spreading it by SSP.","upfront-all":"Recognising an over-time obligation (subscription, support) in full upfront.","cash-is-revenue":"Treating {a|cash received} or amounts billed as {i|revenue}.","gross-agent":"An agent reporting {i|revenue} gross instead of its commission.","returns-full":"Recognising full {i|revenue} (or full {x|cost of sales}) and ignoring expected returns or rebates.","original-estimate":"Measuring progress against the original cost estimate instead of the latest one.","spread-loss":"Spreading an {x|expected loss} on an onerous contract instead of recognising it in full now.","conditional-receivable":"Calling a conditional right to payment a {a|receivable} (it is a {a|contract asset}).","assurance-po":"Mixing up assurance warranties ({l|provision}) and service warranties (separate obligation).","ignore-financing":"Ignoring a significant financing component when payment is long after delivery.","payable-expense":"Treating consideration payable to a customer as an {x|expense} instead of reducing {i|revenue}."},"examTypes":[{"id":"contract-criteria","title":"Which is NOT a criterion for identifying a contract? (practice Q36)","pitfall":"Thinking contract length or finishing within 12 months is a criterion.","see":"contract"},{"id":"distinct-po","title":"Is this promise a separate performance obligation?","pitfall":"Splitting inputs to a combined output, or combining genuinely distinct items.","see":"pos"},{"id":"warranty","title":"Assurance or service warranty?","pitfall":"Allocating {i|revenue} to a standard warranty, or providing for an extended one.","see":"pos"},{"id":"principal-agent","title":"Principal or agent: gross or net revenue?","pitfall":"An agent reporting the full sale as {i|revenue}.","see":"pos"},{"id":"variable","title":"What is the transaction price including the bonus? (practice Q8)","pitfall":"Waiting for the {a|cash}, or using the wrong estimation method.","see":"price"},{"id":"returns-rebates","title":"How much revenue with a right of return or a volume rebate?","pitfall":"Recognising full {i|revenue} and waiting for the returns.","see":"price"},{"id":"price-other","title":"Financing component or payments to the customer?","pitfall":"Booking the face amount as {i|revenue}, or a listing fee as an {x|expense}.","see":"price"},{"id":"allocate","title":"How much of the price goes to obligation X? (practice Q37)","pitfall":"Answering with the SSP instead of the allocated amount.","see":"allocate"},{"id":"timing","title":"Over time or at a point in time?","pitfall":"Following the payment schedule instead of the transfer of control.","see":"recognise"},{"id":"revenue-to-date","title":"How much revenue to date? (practice Q38)","pitfall":"Recognising a subscription in full upfront, or {a|cash received} as {i|revenue}.","see":"recognise"},{"id":"construction","title":"Revenue for the year on a construction contract","pitfall":"Using the original cost estimate, or forgetting to deduct last year’s {i|revenue}.","see":"recognise"},{"id":"onerous","title":"The contract turns loss-making: what hits P&L?","pitfall":"Spreading the {x|expected loss} over the remaining years.","see":"recognise"},{"id":"balances","title":"Contract asset, receivable or contract liability?","pitfall":"Calling a conditional right a {a|receivable}, or upfront {a|cash} {i|revenue}.","see":"balances"}],"pages":[{"type":"map","id":"map-overview","bucket":null,"sect":0,"part":"Overview"},{"type":"intro","lo":40,"title":"Revenue, the Socratic way","body":["One question runs through this whole chapter: **when has the customer got what they paid for?** {i|Revenue} follows that moment, not the {a|cash}.","Each idea starts with a question. Think it through, then reveal the answer. The rule comes after, once you have half-worked it out.","Account names are coloured by element. Tap **Legend** at the top any time. At the end: a chapter quiz in exam style, then a harder exam."],"id":"intro-iyw5p9","bucket":null,"sect":0,"part":"Overview"},{"type":"map","id":"map-1-contract","bucket":"contract","sect":1,"part":"Identify the contract"},{"id":"think-ul0fcl","type":"think","bucket":"contract","lo":40,"scenario":"Kopi Club sells a 12-month coffee subscription for $120, paid in full on 1 January. The customer collects one bag of beans each month.","prompt":"Kopi Club has the $120 in the bank on 1 January. Has it earned $120 of {i|revenue} that day?","answer":["No. On 1 January it has the {a|cash} but has given the customer **nothing yet**. It owes 12 bags of beans.","It earns the {i|revenue} as it hands over the beans: $10 a month. Until then the $120 is an obligation to deliver, a {l|Contract liability}.","That is the whole standard in one line: {i|revenue} when (or as) **control** of goods or services passes to the customer, at the amount you **expect to be entitled to**. {a|Cash} in the bank is nice, but it is not a performance review."],"sect":1,"part":"Identify the contract"},{"type":"rule","bucket":"contract","lo":40,"title":"The core principle and the five steps","body":["Kopi Club showed the problem: the {a|cash} arrives on day 1, but the customer hasn’t got anything yet. SFRS(I) 15 fixes the timing with one principle and a five-step recipe.","Recognise {i|Revenue} when (or as) you **transfer control** of goods or services to a customer, at the amount you **expect to be entitled to** in exchange.","Five steps get you there:","1. **Contract**: identify the contract with the customer.","2. **Obligations**: identify the separate performance obligations in it.","3. **Price**: determine the transaction price.","4. **Allocate** the price to the performance obligations.","5. **Recognise** {i|revenue} when (or as) each obligation is satisfied.","+ Memory hook: **C**ontract → **O**bligations → **P**rice → **A**llocate → **R**ecognise, “**COPAR**”."],"id":"rule-1utyjr","sect":1,"part":"Identify the contract"},{"type":"diagram","bucket":"contract","lo":40,"title":"The five-step model","intro":"This is the chart from your notes. Each box is a step, with the one test that matters at that step.","notes":{"s1":"Is there an enforceable contract? Five criteria, all needed. Contract length is **not** one of them.","s2":"Split the contract into **distinct** promises: each one the customer can benefit from on its own and that is separately identifiable.","s3":"How much do you expect to get? Fixed price plus an estimate of variable consideration, adjusted for financing, non-cash and amounts payable to the customer.","s4":"Share the price out in proportion to **stand-alone selling prices**. A bundle discount is spread across everything.","s5":"For each obligation: over time (one of three tests met) or at the point control passes."},"walk":[{"nodes":["s1"],"text":"**Step 1:** is there a contract that counts? Check the five criteria."},{"nodes":["s2"],"text":"**Step 2:** what separate things have you promised? Each distinct one is a performance obligation."},{"nodes":["s3"],"text":"**Step 3:** what is the total price, including your best estimate of any bonus or rebate?"},{"nodes":["s4"],"text":"**Step 4:** split that price across the obligations by stand-alone selling price."},{"nodes":["s5"],"text":"**Step 5:** recognise each obligation’s share when or as it is satisfied. This is where {i|revenue} actually hits P&L."}],"caption":"C-O-P-A-R: steps 1–4 set it up; only step 5 books {i|revenue}.","id":"diagram-1okt49","sect":1,"part":"Identify the contract","svg":"\u003csvg width=\"100%\" style=\"min-width:640px\" role=\"img\"\n viewBox=\"0.00 0.00 620.00 95.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0)