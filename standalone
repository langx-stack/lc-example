<body>
<div id="app"></div>
<script>
// Pure logic shared by the browser app and the Node build/tests.
(function (root, factory) {
  if (typeof module === 'object' && module.exports) module.exports = factory();
  else root.StudyCore = factory();
})(typeof self !== 'undefined' ? self : this, function () {
  const ELEMENTS = {
    a: 'Asset', l: 'Liability', e: 'Equity', i: 'Income', x: 'Expense', n: 'Other term',
  };

  const escapeHtml = (s) => String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  // {a|ROU asset} → coloured account, **bold**, *em*. Escapes first so content can't inject markup.
  function renderInline(text) {
    return escapeHtml(text)
      .replace(/\{([a-z])\|([^}]+)\}/g, '<span class="el el-$1">$2</span>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*]+)\*/g, '<em>$1</em>')
      .replace(/★/g, '<span class="gold">★</span>');
  }

  function parseAmount(str) {
    if (str === null || str === undefined) return null;
    let s = String(str).trim();
    if (!s) return null;
    let neg = false;
    if (/^\(.*\)$/.test(s)) { neg = true; s = s.slice(1, -1); }
    s = s.replace(/[$,\s]/g, '');
    if (s.startsWith('-')) { neg = !neg; s = s.slice(1); }
    if (!/^\d+(\.\d+)?$/.test(s)) return null;
    const n = Number(s);
    return neg ? -n : n;
  }

  const lineKey = (l) => `${l.side}|${l.account}|${Number(l.amount)}`;

  // Order-insensitive: each given line is checked off against an unused expected line.
  function gradeJE(expected, given) {
    const pool = expected.map(lineKey);
    const rows = given.filter((l) => l.account || (l.amount !== null && l.amount !== undefined && l.amount !== ''));
    const lines = rows.map((l) => {
      const i = pool.indexOf(lineKey(l));
      if (i >= 0) { pool.splice(i, 1); return { ok: true }; }
      return { ok: false };
    });
    const extra = lines.filter((l) => !l.ok).length;
    const missing = pool.length;
    return { lines, missing, extra, correct: missing === 0 && extra === 0 };
  }

  function gradeNumber(expected, given, tol = 0) {
    const n = typeof given === 'number' ? given : parseAmount(given);
    return n !== null && Math.abs(n - expected) <= tol;
  }

  const correctIndex = (q) => q.options.findIndex((o) => o.ok);

  function scoreQuiz(questions, answers) {
    const byLO = {};
    const missed = [];
    let correct = 0;
    for (const q of questions) {
      byLO[q.lo] = byLO[q.lo] || { correct: 0, total: 0 };
      byLO[q.lo].total++;
      if (answers[q.id] === correctIndex(q)) { correct++; byLO[q.lo].correct++; } else missed.push(q.id);
    }
    return { correct, total: questions.length, byLO, missed };
  }

  function collectStrings(obj, out = []) {
    if (typeof obj === 'string') out.push(obj);
    else if (Array.isArray(obj)) obj.forEach((v) => collectStrings(v, out));
    else if (obj && typeof obj === 'object') Object.values(obj).forEach((v) => collectStrings(v, out));
    return out;
  }

  function validateTopic(t) {
    const errs = [];
    const where = (kind, i) => `${kind} ${i + 1}`;
    for (const s of collectStrings(t)) {
      for (const m of s.matchAll(/\{([a-z]?)\|/g)) {
        if (!ELEMENTS[m[1]]) errs.push(`unknown element "${m[1]}" in: ${s.slice(0, 60)}`);
      }
    }
    const accountNames = new Set((t.accounts || []).map((a) => a.name));
    const oneCorrect = (opts, label) => {
      if (opts.filter((o) => o.ok).length !== 1) errs.push(`${label}: needs exactly one correct option`);
      opts.forEach((o, j) => { if (!o.why) errs.push(`${label}: option ${j + 1} has no explanation`); });
    };
    const balanced = (lines, label) => {
      const dr = lines.filter((l) => l.side === 'Dr').reduce((s, l) => s + l.amount, 0);
      const cr = lines.filter((l) => l.side === 'Cr').reduce((s, l) => s + l.amount, 0);
      if (dr !== cr) errs.push(`${label}: journal entry does not balance (Dr ${dr}, Cr ${cr})`);
    };
    (t.pages || []).forEach((p, i) => {
      const label = where(`page (${p.type})`, i);
      if (p.type === 'mcq') oneCorrect(p.options, label);
      if (p.type === 'je') {
        balanced(p.lines, label);
        p.lines.forEach((l) => { if (!accountNames.has(l.account)) errs.push(`${label}: "${l.account}" not in accounts`); });
      }
      if (p.type === 'calc' && typeof p.answer !== 'number') errs.push(`${label}: answer must be a number`);
    });
    const steps = stepsOf(t);
    const bucketIds = new Set(steps.map((b) => b.id));
    if (t.steps) {
      if (bucketIds.size !== t.steps.length) errs.push('steps: duplicate step id');
      t.steps.forEach((b, j) => { if (!b.id || !b.name) errs.push(`steps: step ${j + 1} needs id and name`); if (b.id === 'wrap') errs.push('steps: "wrap" is reserved'); });
    }
    (t.pages || []).forEach((p, i) => {
      const label = where(`page (${p.type})`, i);
      if (p.bucket && !bucketIds.has(p.bucket)) errs.push(`${label}: unknown bucket "${p.bucket}"`);
      if (p.type === 'compare' && !p.bucket) errs.push(`${label}: compare page needs a bucket`);
      if (p.type === 'compare' && t.steps) errs.push(`${label}: compare pages only work on the common backbone (no custom steps)`);
      if (p.type === 'diagram') {
        if (!p.dot) errs.push(`${label}: diagram needs dot (a file name in notes/_build/diagrams or dot source)`);
        (p.walk || []).forEach((w, j) => { if (!w.text || !(w.nodes && w.nodes.length)) errs.push(`${label}: walk step ${j + 1} needs nodes and text`); });
      }
      if (p.type === 'worked' && !(p.steps && p.steps.length)) errs.push(`${label}: worked example needs steps`);
      if (p.type === 'je' && p.given) p.given.forEach((g) => { if (!p.lines[g]) errs.push(`${label}: given line ${g} out of range`); });
      if (p.type === 'calc' && p.given && p.given > (p.working || []).length) errs.push(`${label}: given ${p.given} is more than the working`);
      if (p.type === 'tree') {
        const nodes = p.nodes || {};
        if (!nodes[p.start]) errs.push(`${label}: start "${p.start}" is not a node`);
        for (const [id, n] of Object.entries(nodes)) {
          if (n.result === undefined && !(n.opts && n.opts.length)) errs.push(`${label}: node "${id}" has no options or result`);
          (n.opts || []).forEach((o) => { if (!nodes[o.to]) errs.push(`${label}: "${o.to}" is not a node`); });
        }
        if (p.expect && (!nodes[p.expect] || nodes[p.expect].result === undefined)) errs.push(`${label}: expect "${p.expect}" is not a leaf`);
      }
    });
    for (const k of Object.keys(t.map || {})) if (!bucketIds.has(k)) errs.push(`map: unknown bucket "${k}"`);
    for (const k of Object.keys(t.intros || {})) if (!bucketIds.has(k.split('|')[0])) errs.push(`intros: unknown bucket "${k}"`);
    const types = new Set();
    (t.examTypes || []).forEach((x) => {
      if (types.has(x.id)) errs.push(`duplicate exam type "${x.id}"`);
      types.add(x.id);
      if (x.see && !bucketIds.has(x.see)) errs.push(`exam type ${x.id}: unknown bucket "${x.see}"`);
    });
    const pits = t.pitfalls || {};
    const ids = new Set();
    for (const set of ['quiz', 'exam']) {
      const qz = t[set];
      if (!qz) continue;
      const cases = qz.cases || {};
      (qz.questions || []).forEach((q, i) => {
        const label = `${set} question ${q.id || i + 1}`;
        if (ids.has(q.id)) errs.push(`${label}: duplicate id`);
        ids.add(q.id);
        if (q.lo === undefined) errs.push(`${label}: no LO`);
        else if (t.los && !t.los[q.lo]) errs.push(`${label}: LO ${q.lo} not in topic`);
        if (q.case && !cases[q.case]) errs.push(`${label}: unknown case "${q.case}"`);
        if (t.examTypes && q.type === undefined) errs.push(`${label}: no exam type`);
        if (q.type !== undefined && !types.has(q.type)) errs.push(`${label}: unknown exam type "${q.type}"`);
        if (q.options.length !== 4) errs.push(`${label}: needs four options`);
        oneCorrect(q.options, label);
        q.options.forEach((o, j) => {
          if (o.je) balanced(o.je, `${label} option ${j + 1}`);
          if (o.pit && !pits[o.pit]) errs.push(`${label} option ${j + 1}: unknown pitfall "${o.pit}"`);
        });
      });
    }
    return errs;
  }

  // ── v2: backbone, page ids, sections
  const BACKBONE = [
    { id: 'classify', name: 'Classify' },
    { id: 'recognise', name: 'Recognise' },
    { id: 'initial', name: 'Initial measurement' },
    { id: 'subsequent', name: 'Subsequent measurement' },
    { id: 'derecognise', name: 'Derecognise / transfer' },
    { id: 'present', name: 'Present & disclose' },
  ];
  // A chapter that doesn't fit the backbone (framework, revenue, FS prep…) defines its own map steps.
  const stepsOf = (topic) => (topic && topic.steps) || BACKBONE;
  const bucketName = (id, topic) => (stepsOf(topic).find((b) => b.id === id) || {}).name || '';

  function hash6(str) {
    let h = 0x811c9dc5;
    for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; }
    return (h.toString(36) + '000000').slice(0, 6);
  }
  // Ids come from the page text, not its position, so inserting pages never moves saved answers.
  function pageId(p) {
    if (p.id) return p.id;
    const key = [p.type, p.title, p.q, p.prompt, p.scenario, (p.html || '').slice(0, 300)].map((x) => x || '').join('|');
    return `${p.type}-${hash6(key)}`;
  }
  function assignIds(pages) {
    const seen = {};
    return pages.map((p) => {
      const base = pageId(p);
      seen[base] = (seen[base] || 0) + 1;
      return seen[base] === 1 ? base : `${base}-${seen[base]}`;
    });
  }

  // Adds the generated pages: an overview map first, a map at the start of every section
  // (a run of pages with the same bucket + label) and the exam-types page before the summary.
  function prepareTopic(topic) {
    if (topic.prepared) return topic;
    const ids = assignIds(topic.pages);
    const out = [{ type: 'map', id: 'map-overview', bucket: null }];
    let prev = null;
    let n = 0;
    topic.pages.forEach((p, i) => {
      if (p.type === 'summary') {
        out.push({ type: 'examtypes', id: 'examtypes', bucket: 'wrap' });
        out.push({ ...p, id: ids[i], bucket: 'wrap' });
        return;
      }
      if (!p.bucket) { out.push({ ...p, id: ids[i], bucket: prev ? prev.bucket : null, blabel: prev ? prev.blabel : undefined }); return; }
      const k = `${p.bucket}|${p.blabel || ''}`;
      if (!prev || prev.k !== k) {
        n++;
        out.push({ type: 'map', id: `map-${n}-${p.bucket}`, bucket: p.bucket, blabel: p.blabel });
        prev = { k, bucket: p.bucket, blabel: p.blabel };
      }
      out.push({ ...p, id: ids[i] });
    });
    let s = -1;
    let lk;
    out.forEach((p) => {
      const k = `${p.bucket}|${p.blabel || ''}`;
      if (k !== lk) { s++; lk = k; }
      p.sect = s;
      if (!p.part) {
        if (p.bucket === 'wrap') p.part = 'Wrap-up';
        else if (p.bucket) p.part = bucketName(p.bucket, topic) + (p.blabel ? ` · ${p.blabel}` : '');
        else p.part = 'Overview';
      }
    });
    return { ...topic, pages: out, prepared: true };
  }

  function sections(topic) {
    const out = [];
    topic.pages.forEach((p, i) => {
      const cur = out[out.length - 1];
      if (cur && cur.sect === p.sect) cur.end = i;
      else out.push({ sect: p.sect, bucket: p.bucket, blabel: p.blabel, start: i, end: i });
    });
    return out.map(({ sect, ...r }) => r);
  }

  // ── v2: saved-progress migration (v1 stored lesson state by page index)
  const qkey = (topic, set, id) => `${topic}:${set}:${id}`;
  function parseKey(k) { const [topic, set, ...rest] = String(k).split(':'); return { topic, set, id: rest.join(':') }; }

  function migrate(prog, legacy, topicId) {
    if (prog && prog.v === 2) return prog;
    const p = { ...(prog || {}) };
    const L = legacy || [];
    for (const f of ['revealed', 'mcq', 'think', 'calc', 'je']) {
      if (!p[f]) continue;
      const m = {};
      for (const [k, v] of Object.entries(p[f])) if (L[k] !== undefined) m[L[k]] = v;
      p[f] = m;
    }
    if (p.page !== undefined && L[p.page]) p.pageId = L[p.page];
    const seen = new Set(Array.isArray(p.seen) ? p.seen : []);
    if (p.maxPage !== undefined) L.slice(0, p.maxPage + 1).forEach((id) => seen.add(id));
    if (p.pageId) seen.add(p.pageId);
    p.seen = [...seen];
    delete p.page;
    delete p.maxPage;
    p.attempts = p.attempts || {};
    if (p.attempt) {
      const a = p.attempt;
      const answers = {};
      for (const [k, v] of Object.entries(a.answers || {})) answers[qkey(topicId, 'quiz', k)] = v;
      p.attempts.quiz = { mode: 'quiz', refs: (a.ids || []).map((id) => qkey(topicId, 'quiz', id)), answers, conf: {}, seed: a.seed || 1, submitted: !!a.submitted };
      delete p.attempt;
    }
    p.v = 2;
    return p;
  }

  // ── v2: dates, spaced review, drill, pitfalls
  const pad = (n) => String(n).padStart(2, '0');
  const dayKey = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  function addDays(key, n) { const [y, m, d] = key.split('-').map(Number); return dayKey(new Date(y, m - 1, d + n)); }
  const INTERVALS = [1, 3, 7];
  function reviewUpdate(queue, key, { correct, conf }, today) {
    const q = { ...queue };
    if (!correct || conf === 'guess') q[key] = { step: 0, due: addDays(today, INTERVALS[0]) };
    else if (q[key]) {
      const next = q[key].step + 1;
      if (next >= INTERVALS.length) delete q[key];
      else q[key] = { step: next, due: addDays(today, INTERVALS[next]) };
    }
    return q;
  }
  const dueReviews = (queue, today, exists) => Object.entries(queue || {})
    .filter(([k, v]) => v.due <= today && exists(k))
    .sort((a, b) => (a[1].due < b[1].due ? -1 : 1))
    .map(([k]) => k);
  function pickDrill(pool, n, rand = Math.random) {
    const a = [...pool];
    for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(rand() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
    return a.slice(0, n);
  }
  const topPitfalls = (counts, n = 3) => Object.entries(counts || {}).filter(([, c]) => c > 0)
    .sort((a, b) => b[1] - a[1]).slice(0, n).map(([id, count]) => ({ id, count }));

  function store(storage, key) {
    return {
      load() {
        try { const raw = storage && storage.getItem(key); return raw ? JSON.parse(raw) : {}; } catch (e) { return {}; }
      },
      save(obj) {
        try { storage && storage.setItem(key, JSON.stringify(obj)); } catch (e) { /* storage unavailable: progress is not kept */ }
      },
    };
  }

  return {
    ELEMENTS, escapeHtml, renderInline, parseAmount, gradeJE, gradeNumber, correctIndex, scoreQuiz, validateTopic, store,
    BACKBONE, stepsOf, bucketName, pageId, assignIds, prepareTopic, sections, qkey, parseKey, migrate, dayKey, addDays, reviewUpdate, dueReviews, pickDrill, topPitfalls,
  };
});

