.64 83.28,-98.64 77.28,-98.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"8.64\" y=\"-81.19\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Lend or settle\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"12.02\" y=\"-72.09\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">loans and credit\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge3\" class=\"edge\">\n\u003ctitle>users&#45;&gt;d2\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M122.43,-123.19C110.27,-116.69 96.48,-109.33 83.93,-102.62\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"85.11,-100.87 78.83,-99.9 83.13,-104.58 85.11,-100.87\"/>\n\u003c/g>\n\n\u003cg id=\"node5\" class=\"node\">\n\u003ctitle>d3\u003c/title>\n\u003cpath fill=\"#e8eef6\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M306.53,-98.64C306.53,-98.64 236.75,-98.64 236.75,-98.64 230.75,-98.64 224.75,-92.64 224.75,-86.64 224.75,-86.64 224.75,-74.64 224.75,-74.64 224.75,-68.64 230.75,-62.64 236.75,-62.64 236.75,-62.64 306.53,-62.64 306.53,-62.64 312.53,-62.64 318.53,-68.64 318.53,-74.64 318.53,-74.64 318.53,-86.64 318.53,-86.64 318.53,-92.64 312.53,-98.64 306.53,-98.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"233.39\" y=\"-81.19\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Vote, influence\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"244.64\" y=\"-72.09\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">management\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge4\" class=\"edge\">\n\u003ctitle>users&#45;&gt;d3\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M191.77,-123.19C204.26,-116.69 218.41,-109.33 231.3,-102.62\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"232.21,-104.52 236.57,-99.88 230.27,-100.79 232.21,-104.52\"/>\n\u003c/g>\n\n\u003cg id=\"node6\" class=\"node\">\n\u003ctitle>cash\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M127.91,-36.82C127.91,-36.82 69.38,-36.82 69.38,-36.82 63.37,-36.82 57.38,-30.82 57.38,-24.82 57.38,-24.82 57.38,-12.82 57.38,-12.82 57.38,-6.82 63.38,-0.82 69.38,-0.82 69.38,-0.82 127.91,-0.82 127.91,-0.82 133.91,-0.82 139.91,-6.82 139.91,-12.82 139.91,-12.82 139.91,-24.82 139.91,-24.82 139.91,-30.82 133.91,-36.82 127.91,-36.82\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"71.64\" y=\"-20.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Future net\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"66.02\" y=\"-9.37\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">cash inflows\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge5\" class=\"edge\">\n\u003ctitle>d1&#45;&gt;cash\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M139.86,-62.34C133.9,-56.19 127.1,-49.18 120.76,-42.64\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"122.32,-41.22 116.63,-38.38 119.3,-44.15 122.32,-41.22\"/>\n\u003c/g>\n\n\u003cg id=\"node7\" class=\"node\">\n\u003ctitle>stew\u003c/title>\n\u003cpath fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1.2\" d=\"M286.4,-37.64C286.4,-37.64 200.87,-37.64 200.87,-37.64 194.87,-37.64 188.87,-31.64 188.87,-25.64 188.87,-25.64 188.87,-12 188.87,-12 188.87,-6 194.87,0 200.87,0 200.87,0 286.4,0 286.4,0 292.4,0 298.4,-6 298.4,-12 298.4,-12 298.4,-25.64 298.4,-25.64 298.4,-31.64 292.4,-37.64 286.4,-37.64\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"211.01\" y=\"-23.87\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#111827\">Stewardship\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"197.51\" y=\"-14.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">how well management\u003c/text>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"204.64\" y=\"-5.77\" font-family=\"Helvetica,sans-Serif\" font-size=\"9.00\" fill=\"#111827\">used the resources\u003c/text>\n\u003c/g>\n\n\u003cg id=\"edge8\" class=\"edge\">\n\u003ctitle>d1&#45;&gt;stew\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M181.8,-62.34C190.86,-56.11 201.22,-48.99 210.83,-42.38\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"212.01,-44.11 215.77,-38.98 209.64,-40.65 212.01,-44.11\"/>\n\u003c/g>\n\n\u003cg id=\"edge6\" class=\"edge\">\n\u003ctitle>d2&#45;&gt;cash\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M60.26,-62.34C65.81,-56.19 72.14,-49.18 78.04,-42.64\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"79.39,-44.28 81.85,-38.41 76.28,-41.46 79.39,-44.28\"/>\n\u003c/g>\n\n\u003cg id=\"edge7\" class=\"edge\">\n\u003ctitle>d3&#45;&gt;stew\u003c/title>\n\u003cpath fill=\"none\" stroke=\"#6b7280\" d=\"M263.54,-62.34C260.99,-56.88 258.11,-50.74 255.36,-44.86\"/>\n\u003cpolygon fill=\"#6b7280\" stroke=\"#6b7280\" points=\"257.3,-44.04 252.85,-39.5 253.49,-45.82 257.3,-44.04\"/>\n\u003c/g>\n\u003c/g>\n\u003c/svg>\n"},{"type":"mcq","bucket":"purpose","lo":1,"q":"According to the Conceptual Framework, who are the primary users of general purpose financial reports?","options":[{"t":"Management, the board of directors and the external auditors","why":"Management prepares the reports and has internal information. Auditors check them. Neither is a primary user."},{"t":"Existing and potential investors, lenders and other creditors","ok":true,"why":"The people who provide, or might provide, resources to the entity."},{"t":"Regulators such as ACRA, MAS and IRAS","why":"Regulators may find the reports useful, but the reports are not directed at them."},{"t":"Only the entity’s existing shareholders","why":"Too narrow: potential investors, lenders and other creditors are primary users too."}],"id":"mcq-nuszt0","sect":1,"part":"Why report at all"},{"id":"think-1djiqq","type":"think","bucket":"purpose","lo":1,"scenario":"A friend reads Kopi Kakis’ statement of financial position, sees {e|equity} of S$1.2m, and says: “Great, so the business is worth S$1.2m. I’ll offer that for it.”","prompt":"What’s wrong with that reasoning?","answer":["Financial statements are **not designed to show what the entity is worth**. Many {a|assets} are at cost, some valuable things (the brand, the loyal customers) aren’t on the balance sheet at all.","They give users information to **help them estimate** the value. The estimating is the user’s job.","They also rely on **estimates and judgement**, and they don’t give users **all** the information they need: users look at other sources too (the economy, the industry, the café down the road)."],"sect":1,"part":"Why report at all"},{"type":"rule","bucket":"purpose","lo":1,"title":"The limits of financial reports","body":["The friend’s mistake is common: reading the balance sheet as a price tag. The Framework is upfront about what financial reports can’t do.","General purpose financial reports:","1. **don’t give users everything** they need: users also consider the economy, the industry and other sources","2. **don’t show what the entity is worth**: they help users estimate its value","3. rely heavily on **estimates and judgement**","! “{e|Equity} = what the company is worth” is a trap. {e|Equity} is just {a|assets} minus {l|liabilities} as measured under the standards."],"id":"rule-4c3jol","sect":1,"part":"Why report at all"},{"type":"map","id":"map-2-users","bucket":"users","sect":2,"part":"Users and their decisions"},{"type":"think","bucket":"users","lo":1,"scenario":"Four people read the same set of Kopi Kakis financial statements: a bank loan officer, the coffee-bean supplier, a barista, and a corporate customer with a 3-year catering contract.","prompt":"What decision is each of them making, and what will each look at first?","answer":["**Bank:** whether to lend, at what rate and on what terms, and later whether loan covenants are met. Looks at liquidity, solvency, cash flows and security.","**Supplier:** whether to sell on credit, and how much. Looks at whether Kopi Kakis can pay on time (liquidity).","**Barista:** job security and pay. Looks at profitability and stability.","**Customer:** will the business still be there for the whole contract? Looks at going concern and stability.","Same document, four very different reading lists."],"id":"think-ovi0v1","sect":2,"part":"Users and their decisions"},{"id":"visual-1kpaw7","type":"visual","bucket":"users","lo":1,"title":"Who uses financial statements, and for what","html":"\u003cp>Different readers, different decisions. The table pairs each user with what they decide and what they look at first.\u003c/p>\n    \u003cdiv class=\"tbl-wrap\">\u003ctable class=\"tbl reveal-rows\">\u003cthead>\u003ctr>\u003cth>User\u003c/th>\u003cth>Decision\u003c/th>\u003cth>Looks at\u003c/th>\u003c/tr>\u003c/thead>\u003ctbody>\n      \u003ctr>\u003ctd>\u003cstrong>Investors\u003c/strong> (shareholders)\u003c/td>\u003ctd>Buy, hold or sell shares; vote on directors\u003c/td>\u003ctd>Profit, returns, dividends, future cash flows\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Lenders\u003c/strong> (banks, bondholders)\u003c/td>\u003ctd>Whether to lend, at what rate and terms; monitor covenants\u003c/td>\u003ctd>Liquidity, solvency, cash flows, security\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>\u003cstrong>Suppliers\u003c/strong> (trade creditors)\u003c/td>\u003ctd>Whether to sell on credit, and how much\u003c/td>\u003ctd>Liquidity, ability to pay on time\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Customers\u003c/td>\u003ctd>Will the business still be there (warranties, long-term supply)?\u003c/td>\u003ctd>Going concern, stability\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Employees\u003c/td>\u003ctd>Job security, pay negotiations\u003c/td>\u003ctd>Profitability, stability\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Government and regulators (IRAS, ACRA, MAS)\u003c/td>\u003ctd>Tax, regulation, statistics\u003c/td>\u003ctd>Compliance, profit for tax\u003c/td>\u003c/tr>\n      \u003ctr>\u003ctd>Management (internal)\u003c/td>\u003ctd>Running the business\u003c/td>\u003ctd>Internal reports, \u003cstrong>not\u003c/strong> general purpose FS\u003c/td>\u003c/tr>\n    \u003c/tbody>\u003c/table>\u003c/div>\n    \u003cp class=\"cap\">The first three rows are the \u003cstrong>primary users\u003c/strong>. The exam matches a user to its decision: creditors → \u003cstrong>whether to lend\u003c/strong>.\u003c/p>","sect":2,"part":"Users and their decisions"},{"type":"diagram","bucket":"users","lo":1,"title":"Primary users, other users, and the insider","intro":"The reports are aimed at the teal group. The grey group reads them too, but isn’t who they are written for. Management sits outside: it has its own reports.","notes":{"fs":"Written for users who can’t demand their own tailored reports.","inv":"Shareholders, existing and potential: buy, hold or sell shares, and vote on directors.","lend":"Banks and bondholders: whether to lend, at what rate and on what terms, and whether covenants are met.","cred":"Suppliers and other trade creditors: whether to sell on credit, and how much.","cust":"Want to know the business will still be around (warranties, long-term supply).","emp":"Job security and pay negotiations.","gov":"Tax, regulation and statistics. May find the reports useful, but they are not written for them.","mgmt":"Prepares the FS and runs the business on **internal** reports. Not a primary user."},"walk":[{"nodes":["fs","inv","lend","cred"],"text":"The **primary users**: investors, lenders and other creditors. They give the entity money and can’t demand tailored reports."},{"nodes":["cust","emp","gov"],"text":"Customers, employees and regulators **may** find the reports useful, but they are not who the reports are written for."},{"nodes":["mgmt"],"text":"**Management** prepares the reports and has internal information, so it is never a primary user."}],"caption":"Match the user to the decision: creditors decide whether to lend.","id":"diagram-cq2zvy","sect":2,"part":"Users and their decisions","svg":"\u003csvg width=\"100%\" style=\"min-width:640px\" role=\"img\"\n viewBox=\"0.00 0.00 692.00 239.00\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n\u003cg id=\"graph0\" class=\"graph\" transform=\"scale(1 1) rotate(0) translate(10.8 228.05)\">\n\u003ctitle>G\u003c/title>\n\u003cpolygon fill=\"white\" stroke=\"none\" points=\"-10.8,10.8 -10.8,-228.05 680.8,-228.05 680.8,10.8 -10.8,10.8\"/>\n\u003cg id=\"clust1\" class=\"cluster\">\n\u003ctitle>cluster_p\u003c/title>\n\u003cpath fill=\"white\" stroke=\"#0f766e\" stroke-dasharray=\"5,2\" d=\"M20,-8C20,-8 338,-8 338,-8 344,-8 350,-14 350,-20 350,-20 350,-68 350,-68 350,-74 344,-80 338,-80 338,-80 20,-80 20,-80 14,-80 8,-74 8,-68 8,-68 8,-20 8,-20 8,-14 14,-8 20,-8\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"142.25\" y=\"-66.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#0f766e\">Primary users\u003c/text>\n\u003c/g>\n\u003cg id=\"clust2\" class=\"cluster\">\n\u003ctitle>cluster_o\u003c/title>\n\u003cpath fill=\"white\" stroke=\"#6b7280\" stroke-dasharray=\"5,2\" d=\"M370,-8C370,-8 650,-8 650,-8 656,-8 662,-14 662,-20 662,-20 662,-68 662,-68 662,-74 656,-80 650,-80 650,-80 370,-80 370,-80 364,-80 358,-74 358,-68 358,-68 358,-20 358,-20 358,-14 364,-8 370,-8\"/>\n\u003ctext xml:space=\"preserve\" text-anchor=\"start\" x=\"463.88\" y=\"-66.55\" font-family=\"Helvetica,sans-Serif\" font-weight=\"bold\" font-size=\"11.00\" fill=\"#6b7280\">Also find it useful\u003c/text>\n\u003c/g>\n\n\u003cg id=\"node1\" class=\"node\">\n\u003ctitle>fs\u003c/title>\n\u003cpath fill=\"#1f3a5f\" stroke=\"#1f3a5f\" stroke-width=\"1.2\" d=\"M396.76,-140C