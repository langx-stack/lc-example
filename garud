#!/usr/bin/env python3
import os, base64

DIRS = ['backend', 'backend/data', 'backend/prompts', 'backend/script', 'backend/src', 'frontend']

FILES = {
    'README.md': '',
    'backend/data/sample.csv': '',
    'backend/prompts/columns.md': '',
    'backend/prompts/main.md': '',
    'backend/script/data_generator.py': '',
    'backend/script/evaluate_llm.py': '',
    'backend/src/prompt_builder.py': '',
    'frontend/streamlit_app.py': '',
}

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
