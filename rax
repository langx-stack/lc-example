#!/usr/bin/env python3
import os, base64

DIRS = ['backend', 'backend/prompts', 'backend/scripts', 'data', 'data/images', 'data/images/ADK_pptx', 'data/images/Gen_C_pptx', 'data/preprocessed', 'frontend_streamlit']

