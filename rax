    'README.md': '',
    'backend/prompts/slide_context.md': '',
    'backend/prompts/slide_tags.md': '',
    'backend/scripts/__init__.py': '',
    'backend/scripts/deck_preprocessing_pipeline.py': '',
    'backend/scripts/deck_preprocessing_utils.py': '',
    'backend/scripts/deck_to_PNGs.py': '',
