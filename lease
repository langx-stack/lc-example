    if (n.h > 60) { // big box: top-aligned title and subs, then the entry centred in the space under the rule
      let y = n.je || n.k === 'chart' ? n.y + 16 : n.y + n.h / 2 - (12 + subs.length * 11) / 2 + 9; // no entry: centre the text
