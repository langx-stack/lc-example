<body>
<main>
  <div class="topbar">
    <div class="eyebrow">B2.1 Leases · lessee <a class="xlink" href="lease-lessor.html">lessor, sale and leaseback →</a></div>
    <div class="mode" id="mode" role="group" aria-label="When the payments are made">Payments made
      <button data-m="arrears">in arrears (year end)</button><button data-m="advance">in advance (year start)</button></div>
    <div class="mode" id="start" role="group" aria-label="When the lease starts">Lease starts
      <button data-s="year">at the start of the financial year</button><button data-s="part">part-way: 1 October (year end 31 December)</button></div>
  </div>
  <div class="fl-box" id="chart"></div>
  <div class="note" id="note" aria-live="polite"></div>
</main>
<script>
// Worked examples behind every number, chart and year note. The switch above the chart picks one.
// Both are the study app's Kopi Co roaster; only the timing of the payments differs. Whole dollars, as in an exam.
const EX = {
  arrears: { what: 'Kopi Co leases a coffee roaster for 4 years: $10,000 a year paid at each year end, rate implicit in the lease 8%, legal fees $1,000.', pay: 10000, rate: 0.08, n: 4, idc: 1000 },
  advance: { what: 'Kopi Co leases a coffee roaster for 4 years: $10,000 a year paid at the start of each year (the first on day 1), rate implicit in the lease 8%, legal fees $1,000.', pay: 10000, rate: 0.08, n: 4, idc: 1000 },
};
const f1 = (n) => `${n < -0.5 ? '−' : ''}$${Math.abs(Math.round(n)).toLocaleString('en-US')}`; // money, whole dollars
const nb = (s) => s.replace(/ /g, ' '); // keeps spacing in SVG text
const pct = (r) => `${+(r * 100).toFixed(2)}%`;
// Lease years run from the start date; the accounts run on financial years (year end 31 December). When the lease starts
// part-way through a year (1 October), each financial year takes a share of two lease years: 3/12 of one, 9/12 of the other.
function schedule(mode, start = 'year') {
  const adv = mode === 'advance';
  const { pay, rate, n, idc } = EX[mode];
  const r0 = Math.round;
  const unpaid = adv ? n - 1 : n; // in advance the first payment is made on day 1
  const L0 = r0(Array.from({ length: unpaid }, (_, k) => pay / (1 + rate) ** (k + 1)).reduce((a, b) => a + b, 0)); // PV of the payments not yet paid
  const cost = L0 + (adv ? pay : 0) + idc; // ROU cost: liability + prepaid + initial direct costs
  // lease years: interest on the balance for that lease year
  const ly = { opens: [], INT: [], ends: [] };
  let b = L0;
  for (let k = 0; k < n; k++) {
    if (adv && k > 0) b -= pay; // advance: the payment comes off first
    ly.opens.push(b);
    let i = r0(b * rate);
    if (!adv && k === n - 1) i = pay - b; // last year: interest clears the rounding
    if (adv && k === n - 2) i = pay - b; // advance: the balance must equal the final payment
    if (adv && k === n - 1) i = 0;
    ly.INT.push(i);
    b += i;
    if (!adv) b -= pay; // arrears: interest first, then the payment
    ly.ends.push(b);
  }
  const DEP = cost / n; // a full lease year
  // financial years: FY j covers lease time (j − 2 + p, j − 1 + p], where p = share of the first FY after the start
  const p = start === 'part' ? 0.25 : 1, months = Math.round(12 * p), fyN = n + (p < 1 ? 1 : 0);
  const fy = [];
  b = L0;
  for (let j = 1; j <= fyN; j++) {
    const lo = j - 2 + p, hi = j - 1 + p, ev = [];
    for (let k = 1; k <= n; k++) {
      const ov = Math.min(hi, k) - Math.max(lo, k - 1);
      if (ov <= 1e-9 || !ly.INT[k - 1]) continue;
      const atStart = Math.max(lo, k - 1) === k - 1; // the piece at the start of the lease year is rounded; the later piece takes the rest
      const amt = ov > 1 - 1e-9 ? ly.INT[k - 1] : atStart ? r0(ly.INT[k - 1] * ov) : ly.INT[k - 1] - r0(ly.INT[k - 1] * (1 - ov));
      ev.push({ kind: 'int', key: Math.max(lo, k - 1), amt, ly: k, base: ly.opens[k - 1], m: Math.round(12 * ov) });
    }
    for (let k = 1; k <= n; k++) { // payments: arrears at the end of lease year k; advance at the start (the day-1 one is in the cost)
      const t = adv ? k - 1 : k;
      if (adv && k === 1) continue;
      const inside = adv ? t >= lo - 1e-9 && t < hi - 1e-9 : t > lo + 1e-9 && t <= hi + 1e-9;
      if (inside) ev.push({ kind: 'pay', key: t - 1e-6, amt: pay, ly: k, intPart: adv ? ly.INT[k - 2] : ly.INT[k - 1] });
    }
    ev.sort((x, y) => x.key - y.key);
    const startBal = b;
    ev.forEach((e) => { b += e.kind === 'int' ? e.amt : -e.amt; e.bal = b; });
    const depShare = Math.max(0, Math.min(hi, n) - Math.max(lo, 0));
    fy.push({ ev, start: startBal, end: b, int: ev.filter((e) => e.kind === 'int').reduce((a, e) => a + e.amt, 0), dep: DEP * depShare, depM: Math.round(12 * depShare) });
  }
  const INT = fy.map((f) => f.int), DEPS = fy.map((f) => f.dep), ends = fy.map((f) => f.end);
  const ROU = [cost];
  DEPS.forEach((d) => ROU.push(Math.max(0, ROU[ROU.length - 1] - d)));
  // non-current at the end of financial year 1 = the balance just after the next payment (what is still owed after the next 12 months)
  const next = (fy[1] && fy[1].ev.find((e) => e.kind === 'pay')) || null;
  const nc = next ? next.bal : 0;
  return { adv, mode, start, part: p < 1, p, months, pay, rate, n, fyN, idc, L0, cost, ly, fy, opens: fy.map((f) => f.start), ends, INT, DEP, DEPS, ROU, nc, cur: ends[0] - nc };
}

// Section 1 is drawn at LEFT.scale, so its type comes out smaller. Boxes: x, y, w, h; arrows: SVG paths ending at the tip.
const LEFT = {
  at: [6, 40], scale: 0.86,
  nodes: [
    { id: 't1', x: 8, y: 8, w: 160, h: 36, k: 'q', t: 'Test 1: identified asset?', sub: ['specified, no real right to swap it'] },
    { id: 't2', x: 8, y: 58, w: 160, h: 36, k: 'q', t: 'Test 2: economic benefits?', sub: ['substantially all, whole period'] },
    { id: 't3', x: 8, y: 108, w: 160, h: 36, k: 'q', t: 'Test 3: right to direct use?', sub: ['how and for what purpose'] },
    { id: 'svc', x: 186, y: 44, w: 118, h: 52, k: 'no', t: 'Service contract', sub: ['not a lease:', '{x|expense} as incurred'] },
    { id: 'lease', x: 8, y: 196, w: 160, h: 36, k: 'yes', t: 'It is a lease', sub: ['default: on the balance sheet'] },
