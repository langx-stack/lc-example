      what: `Interest is always the rate × the balance owed during the lease year, so it falls as the liability is paid down; depreciation stays the same every full year.${S.part ? ' The lease starts on 1 October, so this financial year takes its months from the lease years it overlaps.' : ''}${k ? ` Compare year 1: interest ${f1(S.INT[0])}.` : ''}`,
      ex: ['**{l|Lease liability}**', { calc: rows },
        '**{a|ROU asset}**', { calc: [{ t: 'carrying amount, start of the year', v: S.ROU[k] }, { op: '−', t: `{x|depreciation}: ${f1(S.cost)} ÷ ${n} years${f.depM < 12 ? ` × ${f.depM}/12` : ''}`, v: DEPk, link: gDep }, { op: '=', t: 'carrying amount, year end', v: S.ROU[k + 1] }] },
        '**Profit or loss**', { calc: [{ t: '{x|depreciation}', v: DEPk }, { op: '+', t: '{x|interest}', v: intK }, { op: '=', t: 'expense for the year', v: DEPk + intK }] },
        '**Cash flow**', cash ? { calc: [{ t: 'interest → operating or financing', v: cashI }, { op: '+', t: 'principal → financing', v: cash - cashI }, { op: '=', t: 'cash paid', v: cash }] } : 'No payment falls in this year.'],
      je };
  };

  const sec = (s) => `<g class="sec ${s.cls}"><rect x="${s.x}" y="0" width="${s.w}" height="${H}" rx="10"/><text x="${s.x + 12}" y="19">${esc(s.t)}</text></g>`;
  let cur = '';
  const render = () => { S = schedule(mode, start); RIGHT = stretch(right(S)); document.getElementById('chart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" style="width:${Math.round(W * 1.34)}px" role="img" aria-label="Lease test, day 1, each year and year end for the lessee">
    <defs><marker id="fa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 1.2 L10 5 L0 8.8 L2.2 5 Z" class="fl-ah"/></marker></defs>
    ${SECTIONS.map(sec).join('')}
    <g transform="translate(${LEFT.at[0]},${LEFT.at[1]}) scale(${LEFT.scale})">${draw(LEFT)}</g>
    ${draw(RIGHT)}<g class="mc">${balChart()}${plChart()}${cashChart()}</g></svg>`; show(cur); };

  // Journal entries in the note: one green box per entry. A '…' line labels the next entry; a Dr after a Cr starts a new one.
  const jeHtml = (lines) => {
    const groups = [];
    let g = null, label = '';
    lines.forEach((l) => {
      if (l.startsWith('…')) { label = l.slice(1).trim(); g = null; return; }
      if (!g || (l.startsWith('Dr') && g.lines.length && g.lines[g.lines.length - 1].startsWith('Cr'))) { g = { label, lines: [] }; groups.push(g); label = ''; }
      g.lines.push(l);
    });
    const line = (l) => { const [acc, amt] = l.split(' :: '); return `<span class="jl${l.startsWith('Cr') ? ' cr' : ''}"><span>${md(acc)}</span>${amt ? `<span class="amt">${amt}</span>` : ''}</span>`; };
    return `<div class="jes">${groups.map((x, gi) => `<div class="je" data-g="${gi}">${x.label ? `<span class="jn">${md(x.label)}</span>` : ''}${x.lines.map(line).join('')}</div>`).join('')}</div>`;
  };
  // Note text: lines starting "- " become a bulleted list.
  const blocks = (t) => {
    const out = [];
    let ul = null;
    t.split('\n').forEach((line) => {
      if (line.startsWith('- ')) { if (!ul) out.push((ul = [])); ul.push(line.slice(2)); } else { ul = null; out.push(line); }
    });
    const lines = (p) => p.split(/(?<=[.!?:])\s+(?=[A-Z(])/).map(md).join('<br>'); // one sentence per line
    // a list of + / − / = steps is a sum: the signs already act as bullets, so no dots
    const sum = (b) => b.length > 1 && b.slice(1).every((i) => /^[+−=-] /.test(i));
    return out.map((b) => (Array.isArray(b) ? `<ul${sum(b) ? ' class="ops"' : ''}>${b.map((i) => `<li>${md(i)}</li>`).join('')}</ul>` : `<p>${lines(b)}</p>`)).join('');
  };
  // Example box: lines of text and calc tables (one named step per row). Amounts with a link get a dotted curve to their entry.
  const exHtml = (items) => `<div class="ex"><b><em>Example</em></b>${items.map((it) => (typeof it === 'string' ? `<p>${md(it)}</p>`
    : `<table class="calc">${it.calc.map((r) => `<tr class="${r.op === '=' ? 'tot' : ''}"><td class="op">${r.op || ''}</td><td>${md(r.t)}</td><td class="amt"${r.link != null ? ` data-link="${r.link}"` : ''}>${r.vt || f1(r.v)}</td></tr>`).join('')}</table>`)).join('')}</div>`;
  // Dotted curves from an amount in the example to the entry box that uses it (drawn over the note).
  const drawLinks = () => {
    note.querySelectorAll('svg.links').forEach((x) => x.remove());
    const box = note.getBoundingClientRect();
    let paths = '';
    note.querySelectorAll('[data-link]').forEach((el) => {
      const [gi, li] = String(el.dataset.link).split('.'); // 'entry' or 'entry.line'
      const g = note.querySelector(`.je[data-g="${gi}"]`);
      if (!g) return;
      const a = el.getBoundingClientRect(), t = (g.querySelectorAll('.jl')[+li || 0] || g).getBoundingClientRect();
      const x1 = a.right - box.left + 6, y1 = a.top + a.height / 2 - box.top, x2 = t.left - box.left - 8, y2 = t.top + t.height / 2 - box.top;
      if (x2 < x1 + 30) return; // entries stacked below the text: no room for a curve
      const dx = Math.min(140, (x2 - x1) / 2);
      paths += `<path d="M${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}"/><circle cx="${x2}" cy="${y2}" r="2"/>`;
    });
    if (paths) note.insertAdjacentHTML('beforeend', `<svg class="links" width="${box.width}" height="${box.height}">${paths}</svg>`);
  };
  window.addEventListener('resize', () => drawLinks());
  const note = document.getElementById('note');
  function show(id) {
    cur = id;
    document.querySelectorAll('.fl-n').forEach((g) => g.classList.toggle('tapped', g.dataset.id === id));
    document.querySelectorAll('.mc-bar').forEach((g) => g.classList.toggle('sel', id === g.dataset.note));
    let n = id && id.startsWith('yr:') ? yearNote(+id.slice(3)) : (id && NOTES[id]) || ALL;
    if (typeof n === 'function') n = n(S);
    note.classList.toggle('has-je', !!n.je);
    note.innerHTML = `<div class="txt"><h3>${md(n.h)}</h3>${blocks(n.what)}${n.ex ? exHtml(n.ex) : ''}${n.why ? `<div class="why"><b>Why</b>${blocks(n.why)}</div>` : ''}${n.traps ? `<div class="traps"><b>Traps</b><ul>${n.traps.map((t) => `<li>${md(t)}</li>`).join('')}</ul></div>` : ''}</div>${n.je ? jeHtml(n.je) : ''}`;
    drawLinks();
  }
  const chart = document.getElementById('chart');
  chart.addEventListener('click', (e) => {
    const bar = e.target.closest('[data-note]');
    if (bar) return show(bar.dataset.note);
    const n = e.target.closest('.fl-n');
    if (n) show(n.dataset.id);
  });
  chart.addEventListener('keydown', (e) => { const n = e.target.closest('.fl-n'); if (n && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); show(n.dataset.id); } });
  // Arrears / advance switch: everything that depends on the timing redraws.
  const modeBar = document.getElementById('mode');
  const setMode = (m) => { mode = m; modeBar.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.m === m)); render(); };
  modeBar.addEventListener('click', (e) => { const b = e.target.closest('[data-m]'); if (b) setMode(b.dataset.m); });
  const startBar = document.getElementById('start');
  const setStart = (v) => { start = v; startBar.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.s === v)); if (cur.startsWith('yr:') && +cur.slice(3) >= schedule(mode, v).fyN) cur = ''; render(); };
  startBar.addEventListener('click', (e) => { const b = e.target.closest('[data-s]'); if (b) setStart(b.dataset.s); });
  startBar.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.s === start));
  setMode('arrears');
  if (document.fonts) document.fonts.ready.then(render);
})();
</script>
</body>
</html>
