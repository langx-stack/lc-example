const ALL = { h: 'Tap any box', what: 'Each box opens here with what it is and why, and its journal entries. Tap a bar in the charts for any year in full.' };

(function () {
  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
