#!/usr/bin/env python3
import os, base64

DIRS = ['config', 'frontend_streamlit', 'input', 'scripts', 'src']

FILES = {
    'README.md': '',
    'config/clauses.yaml': '',
    'config/clauses_mock.yaml': '',
    'config/prompt.md': '',
    'frontend_streamlit/app.py': '',
    'input/mock_legal_terms.docx': '',
    'requirements.txt': 'bGFuZ2NoYWluCmxhbmdjaGFpbi1vcGVuYWkKbGFuZ2NoYWluLWNvcmUKcHl0aG9uLWRvdGVudgpweXRob24tZG9jeApweWRhbnRpYwpwYW5kYXMKcHl5YW1sCnN0cmVhbWxpdAo=',
    'scripts/create_mock_docx.py': '',
    'src/__init__.py': '',
    'src/schemas.py': '',
    'src/setup.py': '',
    'src/utils.py': '',
    'src/workflow.py': '',
}

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
