const STRETCH = 1.18, SPLIT_X = 440;
const SX = (x) => (x <= SPLIT_X ? x : SPLIT_X + (x - SPLIT_X) * STRETCH);
const stretchPath = (d) => { // x values in M/L/C/S/Q/T pairs and H; y values untouched
  let cmd = '', i = 0;
  return d.replace(/[A-Za-z]|-?\d*\.?\d+/g, (t) => {
    if (/[A-Za-z]/.test(t)) { cmd = t.toUpperCase(); i = 0; return t; }
    const v = +t, isX = cmd === 'H' || (cmd !== 'V' && i % 2 === 0);
    i++;
    return String(+(isX ? SX(v) : v).toFixed(1));
  });
};
