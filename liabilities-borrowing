<script>
// Worked example behind every number, chart and year note: the study app's notes bond (3 years, face $1,000,000, market 6%).
// Switch 1 changes only the coupon (8% premium, 6% at face, 4% discount); switch 2 changes only what the money buys and when it is ready.
const EX = { face: 1000000, mkt: 0.06, n: 3, spend: 1000000, life: 20, buyRate: 0.05,
  coupon: { premium: 0.08, par: 0.06, discount: 0.04 },
  build: { dec: 12, sep: 9, equip: 0 } };
const f1 = (n) => `${n < -0.5 ? '−' : ''}$${Math.abs(Math.round(n)).toLocaleString('en-US')}`; // money, whole dollars
const nb = (s) => s.replace(/ /g, ' '); // keeps spacing in SVG text
const pct = (r) => `${+(r * 100).toFixed(2)}%`;
const AF = (r, k) => (1 - (1 + r) ** -k) / r, DF = (r, k) => (1 + r) ** -k; // annuity and single-sum PV factors
function schedule(kind, build) {
  const { face, mkt, n, spend, life, buyRate } = EX, c = EX.coupon[kind], months = EX.build[build], r0 = Math.round;
  const cpn = r0(face * c);
  const price = r0(cpn * AF(mkt, n) + face * DF(mkt, n)); // PV of the coupons + PV of the face, at the market rate
  const pvF = r0(face * DF(mkt, n)), pvC = price - pvF;
  const rows = [];
  let b = price;
  for (let k = 1; k <= n; k++) { // effective interest: opening × market rate; the last year clears the rounding so it lands on face
    const i = k === n ? face + cpn - b : r0(b * mkt);
    rows.push({ open: b, int: i, close: b + i - cpn, amort: cpn - i });
    b += i - cpn;
  }
  const INT = rows.map((x) => x.int);
  const CAP = INT.map((i, k) => (k === 0 ? r0((i * months) / 12) : 0)); // only year 1 falls inside the window
  const EXP = INT.map((i, k) => i - CAP[k]);
  const buy = r0(cpn * AF(buyRate, n - 1) + face * DF(buyRate, n - 1)); // buy-back price at the end of year 1, market rate 5%
  return { kind, build, prem: kind === 'premium', disc: kind === 'discount', c, cpn, face, mkt, n, spend, life, months, qual: months > 0,
    price, pvC, pvF, diff: price - face, rows, INT, CAP, EXP, totInt: INT.reduce((a, x) => a + x, 0), cost: spend + CAP[0],
    buyRate, buy, buyGL: rows[0].close - buy, asset: months ? 'Warehouse' : 'Equipment', assetUC: months ? 'Warehouse under construction' : 'Equipment',
    ready: months === 12 ? '31 December' : '30 September' };
}
const what = (S) => `Kopi Co issues a ${S.n}-year bond on 1 January 20X1: face ${f1(S.face)}, coupon ${pct(S.c)} paid each 31 December, market rate ${pct(S.mkt)}. ` +
  (S.qual ? `The money builds a warehouse (spend ${f1(S.spend)}): work runs from 1 January and it is ready on ${S.ready} 20X1.` : `The money buys ready-to-use equipment for ${f1(S.spend)} on 1 January 20X1.`);
const kindWord = (S) => (S.prem ? 'premium' : S.disc ? 'discount' : 'at face');
// Practice paper Q46–47 (Helix): $6,000,000 of 12% bonds, half-yearly, 4 years, market 10% → 8 periods at 5%.
const HX = (() => { const r0 = Math.round, cp = 360000, p = r0(cp * AF(0.05, 8) + 6000000 * DF(0.05, 8)), pf = r0(6000000 * DF(0.05, 8));
  const i1 = r0(p * 0.05), c1 = p + i1 - cp, i2 = r0(c1 * 0.05);
  return { cp, p, pf, pc: p - pf, prem: p - 6000000, i1, c1, i2, am2: cp - i2 }; })();
// The notes' loan with arrangement fees: $500,000, 2 years, 5%, fees $10,000. Effective rate by bisection.
const LN = (() => { const r0 = Math.round, net = 490000, pv = (r) => 25000 * AF(r, 2) + 500000 * DF(r, 2);
  let lo = 0.0001, hi = 1; for (let k = 0; k < 200; k++) { const m = (lo + hi) / 2; if (pv(m) > net) lo = m; else hi = m; }
  const r = (lo + hi) / 2, i1 = r0(net * r), i2 = 500000 + 25000 - (net + i1 - 25000);
  return { net, r, i1, i2 }; })();

// Section 1 is drawn at LEFT.scale, so its type comes out smaller. Boxes: x, y, w, h; arrows: SVG paths ending at the tip.
const LEFT = {
  at: [6, 52], scale: 0.86,
  nodes: [
    { id: 't1', x: 8, y: 8, w: 160, h: 40, k: 'q', t: 'Test: an obligation to pay?', sub: ['contract to deliver cash', 'or another financial asset'] },
    { id: 'eq', x: 186, y: 4, w: 128, h: 50, k: 'no', t: 'Not a financial liability', sub: ['equity, or a provision,', 'tax, deferred revenue'] },
    { id: 'fl', x: 8, y: 140, w: 160, h: 36, k: 'yes', t: 'A financial liability', sub: ['default: amortised cost'] },
    { id: 'exa', x: 186, y: 76, w: 128, h: 46, k: 'exit', t: 'Exit A: for trading?', sub: ['held for trading, e.g.', 'derivatives, short sales'] },
    { id: 'fv', x: 186, y: 136, w: 128, h: 44, k: 'gold', dash: true, t: 'At FVTPL', sub: ['fair value, changes', 'in {x|P&L}'] },
    { id: 'exb', x: 186, y: 194, w: 128, h: 46, k: 'exit', t: 'Exit B: designated?', sub: ['at the start, e.g. to', 'cut a mismatch'] },
    { id: 'ac', x: 362, y: 136, w: 124, h: 44, k: 'gold', t: 'At amortised cost', sub: ['loans, bonds, payables'] },
    { id: 'kinds', x: 8, y: 270, w: 478, h: 92, k: 'info1', t: 'Which is which?', list: true,
      sub: ['**loan, bond, trade payable** → financial liability', '**preference shares the issuer must redeem** → financial liability', '**ordinary shares** → equity', '**provision, income tax, deferred revenue** → a liability, but not financial'] },
  ],
  joins: [{ id: 'and', cx: 338, cy: 158, t: 'and' }],
  edges: [
