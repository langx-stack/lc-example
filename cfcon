#!/usr/bin/env python3
import os, base64

DIRS = ['processes', 'processes/dq-checks']

FILES = {
    'processes/dq-checks/CFO Conference Slide.pptx': '',
    'processes/dq-checks/dq-checks-high-level.bpmn': '',
    'processes/dq-checks/dq-checks-high-level.png': '',
    'processes/dq-checks/gaps.md': '',
    'processes/dq-checks/summary.md': '',
}

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
