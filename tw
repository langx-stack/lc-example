#!/usr/bin/env python3
import os, base64

DIRS = ['backend', 'backend/app', 'backend/app/api', 'backend/app/api/routers', 'backend/app/core', 'backend/app/db', 'backend/app/orm_models', 'backend/app/pydantic_schemas', 'backend/app/services', 'backend/config', 'backend/data', 'backend/data/csv', 'backend/data/scripts', 'backend/langx', 'backend/langx/database', 'backend/langx/graph', 'backend/langx/nodes', 'backend/langx/tools', 'frontend', 'frontend/streamlit', 'frontend/streamlit/utils', 'images']

FILES = {
    'INT.md': '',
    }

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
