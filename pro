#!/usr/bin/env python3
import os, base64

DIRS = ['frontend_streamlit', 'prompt_repository', 'prompt_repository/prompt_config', 'prompt_repository/prompt_texts', 'prompt_repository/prompt_texts/coding', 'prompt_repository/prompt_texts/fedspeak']

FILES = {
    'README.md': '',
    'frontend_streamlit/app.py': '',
    'frontend_streamlit/utils.py': '',
    'prompt_repository/prompt_config/master_config.yaml': '',
    'prompt_repository/prompt_texts/coding/bug_report_triage.md': '',
    'prompt_repository/prompt_texts/fedspeak/press_release_summarizer.md': '',
    'requirements_old.txt': 'c3RyZWFtbGl0PT0xLjQ4LjAKcHl0aG9uLWRvdGVudj09MS4xLjEKbGFuZ2NoYWluPT0wLjMuMjcKbGFuZ2dyYXBoPT0wLjYuNApsYW5nZ3JhcGgtY2hlY2twb2ludC1zcWxpdGU9PTIuMC4xMQpsYW5nY2hhaW4tYW50aHJvcGljPT0wLjMuMTgKcHlkYW50aWM9PTIuMTEuNwpweXlhbWwKcHl0aG9uLWRvdGVudg==',
}

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
