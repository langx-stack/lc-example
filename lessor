  const nc = next ? next.bal : 0;
  return { adv, mode, start, part: p < 1, p, months, pay, rate, n, fyN, idc, L0, cost, ly, fy, opens: fy.map((f) => f.start), ends, INT, DEP, DEPS, ROU, nc, cur: ends[0] - nc };
}

