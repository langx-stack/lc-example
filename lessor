const ALL = { h: 'Tap any box', what: 'Each box opens here with what it is and why, and its journal entries. Tap a bar in the charts for any year in full. The lessee side is in the lessee one-pager (lease.html).' };

(function () {
  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  // {a|ROU asset} → coloured term, **bold**
  const md = (t) => esc(t).replace(/\{([a-z])\|([^}]+)\}/g, '<span class="el el-$1">$2</span>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\bExample\b/g, '<em>Example</em>'); // the word Example is always italic
  const tsp = (s) => esc(s).replace(/\{([a-z])\|([^}]+)\}/g, '<tspan class="el-$1">$2</tspan>').replace(/\*\*([^*]+)\*\*/g, '<tspan font-weight="700">$1</tspan>');

  // Text is measured with the real fonts, so lines wrap to their box and entries can be centred.
  const ctx = document.createElement('canvas').getContext('2d');
  const FONTS = { 'fl-t': '650 10px Inter', 'fl-s': '400 8.2px Inter', 'fl-je': '500 7.8px "IBM Plex Mono"' };
  const plain = (s) => s.replace(/\{[a-z]\|([^}]+)\}/g, '$1').replace(/\*\*/g, '');
  const width = (s, c) => { ctx.font = FONTS[c]; return ctx.measureText(plain(s)).width; };
  const wrap = (s, c, max) => {
    const words = s.match(/\{[a-z]\|[^}]+\}\S*|\S+/g) || [];
    const out = [];
    let cur = '';
    words.forEach((w) => { const t = cur ? `${cur} ${w}` : w; if (cur && width(t, c) > max) { out.push(cur); cur = w; } else cur = t; });
    if (cur) out.push(cur);
    return out;
  };
  const node = (n) => {
    const cx = n.x + n.w / 2, max = n.w - 14;
    let o = `<g class="fl-n fl-${n.k}${n.dash ? ' fl-dash' : ''}" data-id="${n.id}" tabindex="0" role="button"><rect x="${n.x}" y="${n.y}" width="${n.w}" height="${n.h}" rx="8"/>`;
    if (n.list) { // left-aligned bullets, centred as a block
      const items = n.sub.map((s) => wrap(s, 'fl-s', max - 22));
      const rows = items.reduce((a, l) => a + l.length, 0);
      let y = n.top ? n.y + 16 : n.y + n.h / 2 - (14 + rows * 11.5) / 2 + 9;
      o += `<text class="fl-t" x="${cx}" y="${y}" text-anchor="middle">${tsp(n.t)}</text>`;
      y += 5;
      items.forEach((lines) => lines.forEach((l, i) => { y += 11.5; o += `${i ? '' : `<text class="fl-s" x="${n.x + 12}" y="${y}">•</text>`}<text class="fl-s fl-li" x="${n.x + 21}" y="${y}">${tsp(l)}</text>`; }));
      if (n.chartAt) o += `<line class="fl-hr" x1="${n.x + 10}" x2="${n.x + n.w - 10}" y1="${n.y + n.chartAt}" y2="${n.y + n.chartAt}"/>`;
      return o + '</g>';
    }
    const subs = (n.sub || []).flatMap((s) => wrap(s, 'fl-s', max));
    if (n.h > 60) { // big box: top-aligned title and subs, then the entry centred in the space under the rule
      let y = n.je || n.k === 'chart' ? n.y + 16 : n.y + n.h / 2 - (12 + subs.length * 11) / 2 + 9; // no entry: centre the text
      o += `<text class="fl-t" x="${cx}" y="${y}" text-anchor="middle">${tsp(n.t)}</text>`;
      if (n.bullets) n.sub.forEach((s) => wrap(s, 'fl-s', max - 22).forEach((l, i) => { y += 11; o += `${i ? '' : `<text class="fl-s" x="${n.x + 12}" y="${y}">•</text>`}<text class="fl-s fl-li" x="${n.x + 21}" y="${y}">${tsp(l)}</text>`; }));
      else subs.forEach((s) => { y += 11; o += `<text class="fl-s" x="${cx}" y="${y}" text-anchor="middle">${tsp(s)}</text>`; });
      if (n.je) {
        y += 9; o += `<line class="fl-hr" x1="${n.x + 10}" x2="${n.x + n.w - 10}" y1="${y}" y2="${y}"/>`;
        const ind = (l) => (l.startsWith('Cr') ? 13 : 0);
        const lw = Math.max(...n.je.filter(Boolean).map((l) => ind(l) + width(l, 'fl-je')));
        // tags: several entries in one box get a number on the left and a label on the right
        const numW = n.tags ? 13 : 0, tagW = n.tags ? 8 + Math.max(...n.tags.map((t) => width(t, 'fl-s'))) : 0;
        const bw = numW + lw + tagW;
        const bh = n.je.reduce((a, l) => a + (l ? 10.5 : 4), 0);
        const x0 = cx - bw / 2;
        const after = (n.after || []).flatMap((s) => wrap(s, 'fl-s', max));
        const bottom = n.y + n.h - (after.length ? after.length * 11 + 10 : 0);
        if (after.length) o += `<line class="fl-hr" x1="${n.x + 10}" x2="${n.x + n.w - 10}" y1="${bottom}" y2="${bottom}"/>`; // closing lines get their own rule
        after.forEach((s, i) => { o += `<text class="fl-s" x="${cx}" y="${bottom + (i + 1) * 11 + 1}" text-anchor="middle">${tsp(s)}</text>`; });
        let ly = y + (bottom - y - bh) / 2 + 8; // baseline of the first line
        let gi = 0, first = true;
        n.je.forEach((l) => {
          if (!l) { ly += 4; first = true; return; }
          if (n.tags && first) {
            o += `<circle class="fl-num" cx="${x0 + 4.5}" cy="${ly - 2.8}" r="4.6"/><text class="fl-numt" x="${x0 + 4.5}" y="${ly - 0.4}" text-anchor="middle">${gi + 1}</text>
              <text class="fl-tag" x="${x0 + numW + lw + 8}" y="${ly}">${esc(n.tags[gi])}</text>`;
            gi++;
          }
          first = false;
          o += `<text class="fl-je" x="${x0 + numW + ind(l)}" y="${ly}">${tsp(l)}</text>`; ly += 10.5;
        });
      }
    } else {
      const lines = [...wrap(n.t, 'fl-t', max).map((t) => ({ t, c: 'fl-t', h: 12 })), ...subs.map((t) => ({ t, c: 'fl-s', h: 10.5 }))];
      let y = n.y + n.h / 2 - lines.reduce((a, l) => a + l.h, 0) / 2 + 8.5;
      lines.forEach((l) => { o += `<text class="${l.c}" x="${cx}" y="${y}" text-anchor="middle">${tsp(l.t)}</text>`; y += l.h; });
    }
    return o + '</g>';
  };
  const edge = (e) => `<g class="fl-e ${e.cls || ''}"><path d="${e.d}" marker-end="url(#fa)"/>${e.lab ? `<text x="${e.lx}" y="${e.ly}" text-anchor="${e.anchor || 'start'}">${esc(e.lab)}</text>` : ''}</g>`;
  const join = (j) => `<g class="fl-j"><circle cx="${j.cx}" cy="${j.cy}" r="11"/><text x="${j.cx}" y="${j.cy + 3.5}" text-anchor="middle">${esc(j.t)}</text></g>`;
  const draw = (part) => `${part.edges.map(edge).join('')}${(part.joins || []).map(join).join('')}${part.nodes.map(node).join('')}`;
  let mode = 'arrears', start = 'year';
  let S = schedule(mode, start), RIGHT = stretch(right(S));
  const box = (id) => RIGHT.nodes.find((n) => n.id === id);

  // Mini chart 1: the finance lease receivable at day 1 and through each year, one bar per entry (+ income, − receipt), so its
  // dotted line is a sawtooth. True scale. Tap a group for that year.
  const recvChart = () => {
    const b = box('recv'), m = S.fyN + 1, x0 = b.x + 10, x1 = b.x + b.w - 10, gw = (x1 - x0) / m, bw = Math.min(8, (gw - 6) / 2);
    const yb = b.y + b.h - 16, yt = b.y + 40;
    const steps = [[{ v: S.L0 }], ...S.fy.map((f) => f.ev.map((e) => ({ v: e.bal, s: e.kind === 'int' ? '+' : '−' })))];
    const top = Math.max(...steps.flat().map((x) => x.v)), sy = (v) => yb - (v / top) * (yb - yt);
    let o = `<line class="mc-ax" x1="${x0}" x2="${x1}" y1="${yb}" y2="${yb}"/>`;
    const pts = [];
    for (let k = 0; k < m; k++) {
      const id = k ? `yr:${k - 1}` : 'f1', gx = x0 + k * gw, bars = steps[k], w = bars.length * (bw + 1) - 1, st = gx + (gw - w) / 2;
      let g = `<rect class="mc-hit" x="${gx + 1}" y="${yt - 6}" width="${gw - 2}" height="${yb - yt + 18}" rx="4"/>`;
      bars.forEach((x, j) => {
        const bx = st + j * (bw + 1);
        g += `<rect class="mc-ab${x.s === '+' ? ' up' : ''}" x="${bx}" width="${bw}" y="${sy(x.v)}" height="${yb - sy(x.v)}"/>`;
        if (x.s) g += `<text class="mc-sg a" x="${bx + bw / 2}" y="${sy(x.v) - 2}" text-anchor="middle">${x.s}</text>`;
        pts.push(`${(bx + bw / 2).toFixed(1)},${sy(x.v).toFixed(1)}`);
      });
      g += `<text class="mc-lbl m" x="${gx + gw / 2}" y="${yb + 10}" text-anchor="middle">yr ${k}</text>`;
      o += `<g class="mc-bar${cur === id ? ' sel' : ''}" data-note="${id}">${g}</g>`;
    }
    return o + `<polyline class="mc-da" points="${pts.join(' ')}"/>
      <rect class="mc-ab" x="${b.x + 12}" y="${b.y + 23}" width="8" height="8" rx="1.5"/><text class="mc-lbl a" x="${b.x + 24}" y="${b.y + 30}">receivable: ${S.adv ? '− receipt, then + income' : '+ income, then − receipt'}</text>`;
  };
  const region = (id) => { const n = box(id); return { x: n.x, y: n.y + n.chartAt, w: n.w, h: n.h - n.chartAt }; };
  // Bars are tappable: each year group opens that year in full in the note panel.
  const bars = (b, draw) => {
    const m = S.fyN, gap = m > 4 ? 12 : 16, bw = m > 4 ? 18 : 22, x0 = b.x + (b.w - (m * bw + (m - 1) * gap)) / 2, xe = x0 + m * (bw + gap) - gap;
    let o = '';
    for (let k = 0; k < m; k++) {
      const x = x0 + k * (bw + gap);
      o += `<g class="mc-bar${cur === `yr:${k}` ? ' sel' : ''}" data-note="yr:${k}"><rect class="mc-hit" x="${x - 6}" y="${b.y + 60}" width="${bw + 12}" height="${b.h - 62}" rx="4"/>${draw(k, x, bw)}</g>`;
    }
    return { o, x0, xe };
  };
  const head = (b, t1, t2) => `<text class="mc-h" x="${b.x + b.w / 2}" y="${b.y + 17}" text-anchor="middle">${t1}</text><text class="mc-h2" x="${b.x + b.w / 2}" y="${b.y + 28}" text-anchor="middle">${t2}</text>`;
  const cashLine = (x1, x2, y) => `<line class="mc-rent" x1="${x1}" x2="${x2}" y1="${y}" y2="${y}"/>`;
  const key = (kx, ky, rows) => rows.map(([cls, label, lcls], i) => (cls === 'dash'
    ? `<line class="mc-rent" x1="${kx}" x2="${kx + 8}" y1="${ky + i * 10 - 3}" y2="${ky + i * 10 - 3}"/>`
    : `<rect class="${cls}" x="${kx}" y="${ky + i * 10 - 7}" width="8" height="8" rx="1.5"/>`) + `<text class="mc-lbl ${lcls}" x="${kx + 12}" y="${ky + i * 10}">${label}</text>`).join('');

  // Mini chart 2: the operating lease with a rent-free year: cash received vs straight-line lease income. Tap a pair for that year.
  const opChart = () => {
    const b = region('plcol'), m = OPL.years, bw = 16, gap = 22, x0 = b.x + (b.w - (m * (2 * bw + 2) + (m - 1) * gap)) / 2;
    const yb = b.y + b.h - 16, top = b.y + 84, s = (v) => (v / (OPL.rent * 1.08)) * (yb - top);
    let o = head(b, 'Operating lease: rent-free year 1', 'income stays level; the cash does not') + `<line class="mc-ax" x1="${x0 - 6}" x2="${x0 + m * (2 * bw + 2 + gap) - gap + 6}" y1="${yb}" y2="${yb}"/>`;
    for (let k = 0; k < m; k++) {
      const x = x0 + k * (2 * bw + 2 + gap), id = `op:${k}`;
      o += `<g class="mc-bar${cur === id ? ' sel' : ''}" data-note="${id}"><rect class="mc-hit" x="${x - 6}" y="${top - 6}" width="${2 * bw + 14}" height="${yb - top + 20}" rx="4"/>
        <rect class="mc-cash" x="${x}" width="${bw}" y="${yb - s(OPL.cash[k])}" height="${s(OPL.cash[k])}"/><rect class="mc-inc" x="${x + bw + 2}" width="${bw}" y="${yb - s(OPL.inc)}" height="${s(OPL.inc)}"/>
        <text class="mc-lbl m" x="${x + bw + 1}" y="${yb + 11}" text-anchor="middle">yr ${k + 1}</text></g>`;
    }
    return o + key(b.x + 12, b.y + 46, [['mc-cash', 'cash received: 0, then rent', 'm'], ['mc-inc', `lease income: ${f1(OPL.inc)} every year`, 'i']]);
  };

  // Mini chart 3: the sale and leaseback split, three bars on one zero-based scale (fair value, carrying amount, gain).
  const slChart = () => {
    const b = box('slc'), x0 = b.x + 150, x1 = b.x + b.w - 12, s = (v) => (v / SLB.fv) * (x1 - x0), kept = SLB.pv / SLB.fv;
    // each row: the kept share, then the sold share; each figure sits inside its own segment (white on dark, ink on light)
    const row = (y, label, total, darkKept) => {
      const k = total * kept, o = total - k, mid = x0 + s(k);
      const seg = (x, w, dark, v) => `<rect class="${dark ? 'mc-dark' : 'mc-light'}${label.includes('gain') ? ' i' : ''}" x="${x}" y="${y}" width="${w}" height="10" rx="1.5"/><text class="mc-lbl" x="${x + 4}" y="${y + 7.5}" style="fill:${dark ? '#fff' : 'var(--ink)'}">${f1(v)}</text>`;
      if (s(k) < 48 || s(o) < 48) { // too narrow for figures inside: plain bars, figures to the right
        const bar = (x, w, dark) => `<rect class="${dark ? 'mc-dark' : 'mc-light'}${label.includes('gain') ? ' i' : ''}" x="${x}" y="${y}" width="${w}" height="10" rx="1.5"/>`;
        return `<text class="mc-lbl m" x="${b.x + 12}" y="${y + 7.5}">${label}</text>` + bar(x0, s(k), darkKept) + bar(mid + 1, s(o) - 1, !darkKept)
          + `<text class="mc-lbl m" x="${x0 + s(total) + 6}" y="${y + 7.5}">${f1(k)} never | <tspan class="el-i" style="fill:var(--el-i)">${f1(o)} recognised</tspan></text>`;
      }
      return `<text class="mc-lbl m" x="${b.x + 12}" y="${y + 7.5}">${label}</text>` + seg(x0, s(k), darkKept, k) + seg(mid + 1, s(o) - 1, !darkKept, o);
    };
    return row(b.y + 26, `fair value ${f1(SLB.fv)}: kept | sold`, SLB.fv, true)
      + row(b.y + 44, 'carrying amount: ROU | gone', SLB.ca, true)
      + row(b.y + 62, `gain ${f1(SLB.gainAll)}: never | recognised`, SLB.gainAll, false);
  };

  // A year in full, for a tapped bar: the liability roll-forward with the interest sum, depreciation, P&L, cash and the entries.
  const yearNote = (k) => {
    const { pay, adv, rate } = S, f = S.fy[k], r = pct(rate);
    const je = [];
    const add = (...lines) => { je.push(...lines); return je.filter((l) => l.startsWith('Dr')).length - 1; };
    if (adv && !k) add('… day 1: the first receipt (part of the net investment)', `Dr {a|Cash} :: ${f1(pay)}`, `Cr {a|Equipment} :: ${f1(pay)}`);
    const rows = [{ t: k ? 'opening (last year end)' : 'day 1: lease receivable', v: f.start }];
    let cash = 0, cashI = 0;
    f.ev.forEach((e) => {
      if (e.kind === 'int') {
        const g = add('… finance income', `Dr {a|Lease receivable} :: ${f1(e.amt)}`, `Cr {i|Finance income} :: ${f1(e.amt)}`);
        rows.push({ op: '+', t: `finance income: ${f1(e.base)} × ${r}`, v: e.amt, link: g });
      } else {
        const g = add(`… receipt${adv ? ', start' : ', end'} of lease year ${e.ly}`, `Dr {a|Cash} :: ${f1(e.amt)}`, `Cr {a|Lease receivable} :: ${f1(e.amt)}`);
        rows.push({ op: '−', t: `receipt${adv ? ', start' : ', end'} of lease year ${e.ly}`, v: e.amt, link: g });
        cash += e.amt; cashI += e.intPart;
      }
      rows.push({ op: '=', t: 'balance', v: e.bal });
    });
    rows[rows.length - 1].t = 'year end';
    return { h: `Year ${k + 1} in full (finance lease, **${S.mode}**)`,
      what: `Finance income is always the rate × the receivable during the year, so it falls as the receivable is collected. These are Kopi Co’s numbers seen from the other side.${k ? ` Compare year 1: income ${f1(S.INT[0])}.` : ''}`,
      ex: ['**{a|Lease receivable}**', { calc: rows }, '**Profit or loss**', { calc: [{ t: '{i|finance income}', v: S.INT[k] }] },
        '**Cash received**', cash ? { calc: [{ t: 'finance income part', v: cashI }, { op: '+', t: 'repayment of the receivable', v: cash - cashI }, { op: '=', t: 'cash received', v: cash }] } : 'No receipt falls in this year.'],
      je };
  };
  const opNote = (k) => ({ h: `Operating lease, year ${k + 1}`, what: 'Income is the same every year; the cash is not. The difference builds up (or runs down) accrued income on the balance sheet.',
    ex: [OPL.what, { calc: [{ t: '{i|lease income} (straight-line)', v: OPL.inc, link: '0.1' }, { op: '−', t: 'cash received', v: OPL.cash[k], link: OPL.cash[k] ? '0.0' : null }, { op: '=', t: 'change in {a|accrued income}', v: OPL.inc - OPL.cash[k] }, { t: '{a|accrued income}, year end', v: OPL.accrued[k] }] }],
    je: OPL.cash[k] ? [`… year ${k + 1}`, `Dr {a|Cash} :: ${f1(OPL.cash[k])}`, `Cr {i|Lease income} :: ${f1(OPL.inc)}`, `Cr {a|Accrued lease income} :: ${f1(OPL.cash[k] - OPL.inc)}`]
      : [`… year ${k + 1} (rent-free)`, `Dr {a|Accrued lease income} :: ${f1(OPL.inc)}`, `Cr {i|Lease income} :: ${f1(OPL.inc)}`] });

  const sec = (s) => `<g class="sec ${s.cls}"><rect x="${s.x}" y="0" width="${s.w}" height="${H}" rx="10"/><text x="${s.x + 12}" y="19">${esc(s.t)}</text></g>`;
  let cur = '';
  const render = () => { S = schedule(mode, start); RIGHT = stretch(right(S)); document.getElementById('chart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" style="width:${Math.round(W * 1.34)}px" role="img" aria-label="Lessor: finance or operating, day 1, each year, year end, and sale and leaseback">
    <defs><marker id="fa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6.5" markerHeight="6.5" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 1.2 L10 5 L0 8.8 L2.2 5 Z" class="fl-ah"/></marker></defs>
    ${SECTIONS.map(sec).join('')}
    <g transform="translate(${LEFT.at[0]},${LEFT.at[1]}) scale(${LEFT.scale})">${draw(LEFT)}</g>
    ${draw(RIGHT)}<g class="mc">${recvChart()}${opChart()}${slChart()}</g></svg>`; show(cur); };

  // Journal entries in the note: one green box per entry. A '…' line labels the next entry; a Dr after a Cr starts a new one.
  const jeHtml = (lines) => {
    const groups = [];
    let g = null, label = '';
    lines.forEach((l) => {
      if (l.startsWith('…')) { label = l.slice(1).trim(); g = null; return; }
      if (!g || (l.startsWith('Dr') && g.lines.length && g.lines[g.lines.length - 1].startsWith('Cr'))) { g = { label, lines: [] }; groups.push(g); label = ''; }
      g.lines.push(l);
    });
    const line = (l) => { const [acc, amt] = l.split(' :: '); return `<span class="jl${l.startsWith('Cr') ? ' cr' : ''}"><span>${md(acc)}</span>${amt ? `<span class="amt">${amt}</span>` : ''}</span>`; };
    return `<div class="jes">${groups.map((x, gi) => `<div class="je" data-g="${gi}">${x.label ? `<span class="jn">${md(x.label)}</span>` : ''}${x.lines.map(line).join('')}</div>`).join('')}</div>`;
  };
  // Note text: lines starting "- " become a bulleted list.
  const blocks = (t) => {
    const out = [];
    let ul = null;
    t.split('\n').forEach((line) => {
      if (line.startsWith('- ')) { if (!ul) out.push((ul = [])); ul.push(line.slice(2)); } else { ul = null; out.push(line); }
    });
    const lines = (p) => p.split(/(?<=[.!?:])\s+(?=[A-Z(])/).map(md).join('<br>'); // one sentence per line
    // a list of + / − / = steps is a sum: the signs already act as bullets, so no dots
    const sum = (b) => b.length > 1 && b.slice(1).every((i) => /^[+−=-] /.test(i));
    return out.map((b) => (Array.isArray(b) ? `<ul${sum(b) ? ' class="ops"' : ''}>${b.map((i) => `<li>${md(i)}</li>`).join('')}</ul>` : `<p>${lines(b)}</p>`)).join('');
  };
  // Example box: lines of text and calc tables (one named step per row). Amounts with a link get a dotted curve to their entry.
  const exHtml = (items) => `<div class="ex"><b><em>Example</em></b>${items.map((it) => (typeof it === 'string' ? `<p>${md(it)}</p>`
    : `<table class="calc">${it.calc.map((r) => `<tr class="${r.op === '=' ? 'tot' : ''}"><td class="op">${r.op || ''}</td><td>${md(r.t)}</td><td class="amt"${r.link != null ? ` data-link="${r.link}"` : ''}>${r.vt || f1(r.v)}</td></tr>`).join('')}</table>`)).join('')}</div>`;
  // Dotted curves from an amount in the example to the entry box that uses it (drawn over the note).
  const drawLinks = () => {
    note.querySelectorAll('svg.links').forEach((x) => x.remove());
    const box = note.getBoundingClientRect();
    let paths = '';
    note.querySelectorAll('[data-link]').forEach((el) => {
      const [gi, li] = String(el.dataset.link).split('.'); // 'entry' or 'entry.line'
      const g = note.querySelector(`.je[data-g="${gi}"]`);
      if (!g) return;
      const a = el.getBoundingClientRect(), t = (g.querySelectorAll('.jl')[+li || 0] || g).getBoundingClientRect();
      const x1 = a.right - box.left + 6, y1 = a.top + a.height / 2 - box.top, x2 = t.left - box.left - 8, y2 = t.top + t.height / 2 - box.top;
      if (x2 < x1 + 30) return; // entries stacked below the text: no room for a curve
      const dx = Math.min(140, (x2 - x1) / 2);
      paths += `<path d="M${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}"/><circle cx="${x2}" cy="${y2}" r="2"/>`;
    });
    if (paths) note.insertAdjacentHTML('beforeend', `<svg class="links" width="${box.width}" height="${box.height}">${paths}</svg>`);
  };
  window.addEventListener('resize', () => drawLinks());
  const note = document.getElementById('note');
  function show(id) {
    cur = id;
    document.querySelectorAll('.fl-n').forEach((g) => g.classList.toggle('tapped', g.dataset.id === id));
    document.querySelectorAll('.mc-bar').forEach((g) => g.classList.toggle('sel', id === g.dataset.note));
    let n = id && id.startsWith('yr:') ? yearNote(+id.slice(3)) : id && id.startsWith('op:') ? opNote(+id.slice(3)) : (id && NOTES[id]) || ALL;
    if (typeof n === 'function') n = n(S);
    note.classList.toggle('has-je', !!n.je);
    note.innerHTML = `<div class="txt"><h3>${md(n.h)}</h3>${blocks(n.what)}${n.ex ? exHtml(n.ex) : ''}${n.why ? `<div class="why"><b>Why</b>${blocks(n.why)}</div>` : ''}${n.traps ? `<div class="traps"><b>Traps</b><ul>${n.traps.map((t) => `<li>${md(t)}</li>`).join('')}</ul></div>` : ''}</div>${n.je ? jeHtml(n.je) : ''}`;
    drawLinks();
  }
  const chart = document.getElementById('chart');
  chart.addEventListener('click', (e) => {
    const bar = e.target.closest('[data-note]');
    if (bar) return show(bar.dataset.note);
    const n = e.target.closest('.fl-n');
    if (n) show(n.dataset.id);
  });
  chart.addEventListener('keydown', (e) => { const n = e.target.closest('.fl-n'); if (n && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); show(n.dataset.id); } });
  // Arrears / advance switch: everything that depends on the timing redraws.
  const modeBar = document.getElementById('mode');
  const setMode = (m) => { mode = m; modeBar.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.m === m)); render(); };
  modeBar.addEventListener('click', (e) => { const b = e.target.closest('[data-m]'); if (b) setMode(b.dataset.m); });
  setMode('arrears');
  if (document.fonts) document.fonts.ready.then(render);
})();
</script>
</body>
</html>
