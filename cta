#!/usr/bin/env python3
import os, base64

DIRS = ['backend', 'backend/api', 'backend/config', 'backend/data', 'backend/langx', 'backend/langx/database', 'backend/langx/nodes']

FILES = {
    'README.md': '',
    'backend/__init__.py': 'Cgo=',
    'backend/api/__init__.py': 'Cgo=',
    'backend/api/app.py': '',
    'backend/config/__init__.py': 'Cgo=',
    'backend/config/llm_setup.py': '',
    'backend/data/placeholder.txt': '',
    'backend/langx/__init__.py': 'Cgo=',
    'backend/langx/database/__init__.py': 'Cgo=',
    'backend/langx/database/messages.py': '',
    'backend/langx/graph.py': '',
    'backend/langx/nodes/__init__.py': 'Cgo=',
    'backend/langx/nodes/assistant_node.py': '',
    'requirements.txt': '',
}

def main():
    # Create directories
    for d in DIRS:
        os.makedirs(d, exist_ok=True)

    # Write files
    for path, b64 in FILES.items():
        data = base64.b64decode(b64)
        full_path = os.path.abspath(path)
        dirpath = os.path.dirname(full_path)
        os.makedirs(dirpath, exist_ok=True)
        with open(full_path, "wb") as f:
            f.write(data)

if __name__ == "__main__":
    main()
